                {testiData.map((t, i) => (<button type="button" data-plh-testi={i} style={`flex:1;font:inherit;color:inherit;text-align:left;cursor:pointer;border:none;background:${i === 0 ? 'var(--pl-surface)' : 'var(--pl-cream)'};padding:22px 22px;position:relative;display:flex;align-items:center;gap:14px;box-shadow:0 1px 0 var(--pl-line);min-width:0`}><span data-plh-testibar style={`position:absolute;left:0;top:0;bottom:0;width:3px;background:${i === 0 ? 'var(--pl-accent)' : 'transparent'}`}></span><span data-plh-testiav style={`width:44px;height:44px;flex:none;border-radius:12px;background:${i === 0 ? 'var(--pl-accent)' : 'var(--pl-surface)'};border:1px solid ${i === 0 ? 'var(--pl-accent)' : 'var(--pl-line)'};color:${i === 0 ? 'var(--pl-ink-deep)' : 'var(--pl-faint)'};font-family:'Geist Mono',ui-monospace,monospace;font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center;transition:all .3s`}>{t[0]}</span><span style="min-width:0;display:flex;flex-direction:column;gap:3px"><span data-plh-testirole style={`font-size:14px;font-weight:600;color:${i === 0 ? 'var(--pl-ink)' : 'var(--pl-muted)'}`}>{t[1]}</span><span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.1em;color:var(--pl-faint)">{t[2].toUpperCase()}</span></span></button>))}
              </div>
              <div style="background:var(--pl-surface);padding:clamp(28px,4vw,40px) clamp(22px,4vw,44px);position:relative;overflow:hidden;min-height:360px;display:flex;flex-direction:column">
                <div style="position:absolute;inset:0;background-image:linear-gradient(#f1efea 1px,transparent 1px),linear-gradient(90deg,#f1efea 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:linear-gradient(135deg,transparent 45%,#000);mask-image:linear-gradient(135deg,transparent 45%,#000);pointer-events:none"></div>
                <div style="position:relative;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><span style="font-size:64px;line-height:.6;color:var(--pl-accent);font-weight:600;height:30px">“</span><span style="display:flex;align-items:center;gap:10px"><span style="color:var(--pl-accent);letter-spacing:2px">★★★★★</span><span data-plh-tqno style="font-family:'Geist Mono',ui-monospace,monospace;font-size:11px;color:var(--pl-faint-2)">01 / 03</span></span></div>
                <blockquote data-plh-tq style="position:relative;margin:22px 0 0;font-size:clamp(17px,2vw,22px);line-height:1.5;letter-spacing:-.01em;font-weight:500;color:var(--pl-ink);text-wrap:pretty;flex:1">“{testiData[0][5]}”</blockquote>
                <div style="position:relative;margin-top:28px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding-top:20px;border-top:1px dashed var(--pl-line)"><div><div data-plh-tqrole style="font-size:15px;font-weight:600">Head of Marketplace Pricing</div><div data-plh-tqind style="font-size:13px;color:var(--pl-faint)">Consumer Electronics</div></div><div style="display:flex;gap:8px"><button type="button" data-plh-tqprev style="width:38px;height:38px;border-radius:11px;border:1px solid var(--pl-line);background:var(--pl-surface);cursor:pointer;font-size:14px;color:var(--pl-ink-2)">←</button><button type="button" data-plh-tqnext style="width:38px;height:38px;border-radius:11px;border:none;background:var(--pl-ink);cursor:pointer;font-size:14px;color:var(--pl-surface)">→</button></div></div>
              </div>
            </div>
            <div class="plh-tsgrid" style="display:grid;gap:1px">
              {testiData.map((t, i) => (<button type="button" data-plh-testistat={i} style={`cursor:pointer;border:none;text-align:left;font:inherit;background:${i === 0 ? 'var(--pl-accent-tint)' : 'var(--pl-surface)'};padding:22px 24px;display:flex;align-items:baseline;justify-content:space-between;gap:12px;transition:background .3s`}><div><div data-plh-testistatv style={`font-size:30px;font-weight:600;letter-spacing:-.03em;color:${i === 0 ? 'var(--pl-accent-ink)' : 'var(--pl-ink)'}`}>{t[3]}</div><div style="font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.12em;color:var(--pl-faint);margin-top:4px">{t[4]}</div></div><span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:11px;color:var(--pl-faint-2)">{t[0]}</span></button>))}
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section id="demo" style="padding:28px;border-bottom:1px solid var(--pl-line)">
        <div style="position:relative;overflow:hidden;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:24px;padding:110px 32px;text-align:center;color:var(--pl-ink)">
          <div style="position:absolute;inset:0;background-image:linear-gradient(#efede8 1px,transparent 1px),linear-gradient(90deg,#efede8 1px,transparent 1px);background-size:40px 40px;background-position:center;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 20%,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 20%,transparent 75%);pointer-events:none"></div>
          <div style="position:absolute;left:50%;top:50%;width:min(72%,760px);height:62%;transform:translate(-50%,-50%);border:1px solid var(--pl-line);border-radius:4px;pointer-events:none"><span style="position:absolute;left:-1px;top:-1px;width:14px;height:14px;border-top:1.5px solid var(--pl-accent-line);border-left:1.5px solid var(--pl-accent-line)"></span><span style="position:absolute;right:-1px;top:-1px;width:14px;height:14px;border-top:1.5px solid var(--pl-accent-line);border-right:1.5px solid var(--pl-accent-line)"></span><span style="position:absolute;left:-1px;bottom:-1px;width:14px;height:14px;border-bottom:1.5px solid var(--pl-accent-line);border-left:1.5px solid var(--pl-accent-line)"></span><span style="position:absolute;right:-1px;bottom:-1px;width:14px;height:14px;border-bottom:1.5px solid var(--pl-accent-line);border-right:1.5px solid var(--pl-accent-line)"></span></div>
          <div style="position:absolute;left:50%;bottom:-160px;width:620px;height:320px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.14),transparent);pointer-events:none"></div>
          <div style="position:relative"><h2 style="margin:0;font-size:clamp(36px,5vw,60px);line-height:1.04;letter-spacing:-.035em;font-weight:500;text-wrap:balance">Price with confidence on data you can <span style="color:var(--pl-ink);">actually trust.</span></h2><div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:36px"><a href="/book-a-demo" style="background:var(--pl-gradient);color:var(--pl-surface);font-weight:500;font-size:16px;padding:15px 26px;border-radius:14px;box-shadow:0 14px 30px -12px rgba(247,99,30,.9)">Book a demo</a><a href="#product" style="background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink);font-weight:500;font-size:16px;padding:15px 22px;border-radius:14px">See a sample of your competitor data →</a></div></div>
        </div>
      </section>
    </div>
  </div>
</PriceLeapLayout>

<style>
  .plh { font-family: 'Geist', system-ui, sans-serif; color: var(--pl-ink); background: var(--pl-surface); }
  .plh a { color: var(--pl-ink); text-decoration: none; }
  .plh a:hover { color: var(--pl-accent); }
  @keyframes plpulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 8px rgba(247,99,30,0); } }
  @keyframes plblink { 50% { opacity: 0; } }
  @keyframes plring { 0% { transform: translate(-50%,-50%) scale(1); opacity: .55; } 100% { transform: translate(-50%,-50%) scale(2.6); opacity: 0; } }
  @keyframes plmarquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes pldash { to { stroke-dashoffset: -18; } }
  @keyframes plspin { to { transform: rotate(360deg); } }
  @keyframes pltourin { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes pltspin { to { transform: rotate(360deg); } }
  @keyframes pltblink { 50% { opacity: 0; } }

  .plh-frameline { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--pl-line); pointer-events: none; z-index: 2; }
  .plh-hero { padding: 88px 28px 44px; }
  .plh-tour { padding: 4px 28px 64px; }
  .plh-sec { padding: 96px 28px; }
  @media (max-width: 639px) { .plh-hero { padding: 64px 16px 28px; } .plh-tour { padding: 4px 12px 40px; } .plh-sec { padding: 56px 16px; } }

  .plh-tbody { height: 430px; }
  @media (max-width: 639px) { .plh-tbody { height: auto; min-height: 440px; } }
  .plh-tside { display: flex; }
  @media (max-width: 759px) { .plh-tside { display: none; } }
  @media (max-width: 859px) { .plh-twide { display: none !important; } }

  .plh-tadd { grid-template-columns: 1fr; }
  @media (min-width: 760px) { .plh-tadd { grid-template-columns: minmax(0,1.25fr) minmax(0,1fr); } }
  .plh-topt { grid-template-columns: 1fr; }
  @media (min-width: 520px) { .plh-topt { grid-template-columns: 1fr 1fr; } }
  .plh-tkpi { grid-template-columns: repeat(2,minmax(0,1fr)); }
  @media (min-width: 760px) { .plh-tkpi { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .plh-trule { grid-template-columns: 1fr; }
  @media (min-width: 760px) { .plh-trule { grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); } }
  .plh-trow { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 12px; }
  @media (min-width: 860px) { .plh-trow { grid-template-columns: minmax(0,1.6fr) minmax(0,.9fr) minmax(0,1fr) minmax(0,.9fr) minmax(0,1.3fr); } }
  .plh-tprice { text-align: right; }
  @media (min-width: 860px) { .plh-tprice { text-align: left; } }

  .plh-chapbar { grid-template-columns: 48px repeat(4,minmax(0,1fr)); }
  .plh-chapbar [data-plh-chaptab] { padding: 10px 8px; }
  .plh-chapt { font-size: 12px; }
  .plh-chapnum { display: none; }
  .plh-chapd { display: none; }
  @media (min-width: 640px) { .plh-chapbar { grid-template-columns: 64px repeat(4,minmax(0,1fr)); } .plh-chapbar [data-plh-chaptab] { padding: 12px 16px; } .plh-chapt { font-size: 14px; } .plh-chapnum { display: flex; } }
  @media (min-width: 960px) { .plh-chapd { display: block; } }

  .plh-trust { grid-template-columns: 1fr; }
  .plh-trustlabel { border-bottom: 1px solid var(--pl-line); }
  @media (min-width: 860px) { .plh-trust { grid-template-columns: 300px minmax(0,1fr); } .plh-trustlabel { border-bottom: none; } }
  .plh-pain { grid-template-columns: 1fr; }
  @media (min-width: 600px) { .plh-pain { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1100px) { .plh-pain { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .plh-ipt { grid-template-columns: 1fr; }
  @media (min-width: 560px) { .plh-ipt { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 900px) { .plh-ipt { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .plh-feedrow { display: grid; grid-template-columns: 1fr auto; gap: 16px; }
  @media (min-width: 700px) { .plh-feedrow { grid-template-columns: 70px 130px 1fr auto; } }
  .plh-pipebody { grid-template-columns: 1fr; }
  @media (min-width: 960px) { .plh-pipebody { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); } }
  .plh-pipekpi { grid-template-columns: repeat(2,minmax(0,1fr)); }
  @media (min-width: 860px) { .plh-pipekpi { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .plh-hwgrid { grid-template-columns: 1fr; }
  @media (min-width: 600px) { .plh-hwgrid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1000px) { .plh-hwgrid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .plh-tqgrid { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .plh-tqgrid { grid-template-columns: 340px minmax(0,1fr); } }
  .plh-tsgrid { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .plh-tsgrid { grid-template-columns: repeat(3,minmax(0,1fr)); } }

  @media (prefers-reduced-motion: reduce) { .plh *, .plh *::before, .plh *::after { animation: none !important; transition: none !important; } }
</style>

<script>
  const root = document.querySelector('.plh') as HTMLElement | null;
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const clamp = (v: number) => Math.max(0, Math.min(1, v));

    // ---------- hero count + clock (100ms) ----------
    let count = 3526158;
    const fmtIN = (n: number) => n.toLocaleString('en-IN');
    const countEl = q('[data-plh-count]'), clockEl = q('[data-plh-clock]');

    // ---------- Inside-PriceLeap tabs ----------
    const ipMeta = [['Add Products', 'AI tracks pricing, finds competitors and monitors their prices.', '01'], ['Market Monitor', 'Live feed of competitor changes across every tracked SKU.', '02'], ['Dynamic Pricing', 'Set guardrails once; PriceLeap recommends inside them.', '03'], ['PriceLeap Agent', 'Ask anything about your catalog and the market.', '04']];
    const ipTabs = qa('[data-plh-iptab]'), ipPanels = qa('[data-plh-ippanel]'), ipProgs = qa('[data-plh-iptprog]'), ipCarets = qa('[data-plh-iptcaret]');
    const panelT = q('[data-plh-panelt]'), panelS = q('[data-plh-panels]'), panelN = q('[data-plh-paneln]');
    let ipTab = 0, ipProg = 0, ipAuto = true;
    function paintIp() {
      ipTabs.forEach((b, i) => { const on = i === ipTab; b.style.background = on ? 'var(--pl-surface)' : 'var(--pl-cream)'; b.setAttribute('aria-selected', String(on)); const num = b.querySelector('.plh-iptnum') as HTMLElement | null; if (num) { num.style.background = on ? 'var(--pl-ink)' : 'var(--pl-surface)'; num.style.color = on ? 'var(--pl-surface)' : 'var(--pl-faint)'; num.style.borderColor = on ? 'var(--pl-ink)' : 'var(--pl-line)'; } const txt = b.querySelector('div span:last-child') as HTMLElement | null; if (txt) txt.style.color = on ? 'var(--pl-ink)' : 'var(--pl-muted)'; (b.querySelector('span[aria-hidden]') as HTMLElement).style.opacity = on ? '1' : '0'; });
      ipCarets.forEach((c, i) => (c.style.display = i === ipTab ? 'block' : 'none'));
      ipPanels.forEach((p) => (p.hidden = Number(p.getAttribute('data-plh-ippanel')) !== ipTab));
      if (panelT) panelT.textContent = ipMeta[ipTab][0];
      if (panelS) panelS.textContent = ipMeta[ipTab][1];
      if (panelN) panelN.textContent = ipMeta[ipTab][2] + ' / 04';
    }
    ipTabs.forEach((b, i) => b.addEventListener('click', () => { ipTab = i; ipProg = 0; ipAuto = false; paintIp(); ipProgs.forEach((pr) => (pr.style.width = '0%')); }));
    paintIp();

    setInterval(() => {
      count += Math.floor(Math.random() * 30 + 4);
      if (countEl) countEl.textContent = fmtIN(count);
      const d = new Date();
      if (clockEl) clockEl.textContent = [d.getHours(), d.getMinutes(), d.getSeconds()].map((v) => String(v).padStart(2, '0')).join(':');
      if (ipAuto) { let p = ipProg + 0.7; if (p >= 100) { if (ipTab >= 3) { ipAuto = false; p = 100; } else { p = 0; ipTab = ipTab + 1; paintIp(); } } ipProg = p; const bar = ipProgs[ipTab]; if (bar) bar.style.width = ipProg + '%'; }
    }, 100);

    // ---------- Accuracy pipeline (1400ms) ----------
    const pItems = [
      { you: 'Wireless ANC Headphones', sku: 'WH-ANC-700', src: 'RETAILER B', match: 'Sonix ANC 700 Over-Ear', price: '₹24,790', kind: 'Exact match', conf: 99.1 },
      { you: 'Smart Fitness Watch 46mm', sku: 'SFW-46-BLK', src: 'D2C STORE C', match: 'FitPro 46 mm Smartwatch — Midnight', price: '₹9,990', kind: 'Similar product', conf: 97.8 },
      { you: 'Portable Bluetooth Speaker', sku: 'PBS-MINI-4', src: 'MARKETPLACE D', match: 'Mini Boom 4 Wireless Speaker', price: '₹6,290', kind: 'White-label', conf: 95.4 },
    ];
    const stageLabels = ['AI matching', 'Human QC review', 'Anomaly check', 'SLA check'];
    const stageEls = qa('[data-plh-stage]');
    let stage = 1, item = 1;
    function paintAcc() {
      const pit = pItems[item], verified = stage >= 4;
      q('[data-plh-itemno]')!.textContent = String(item + 1);
      qa('[data-plh-psku], [data-plh-psku2]').forEach((e) => (e.textContent = pit.sku));
      q('[data-plh-pyou]')!.textContent = pit.you;
      q('[data-plh-pkind]')!.textContent = '⇅ ' + pit.kind;
      q('[data-plh-psrc]')!.textContent = pit.src;
      q('[data-plh-pprice]')!.textContent = pit.price;
      q('[data-plh-pmatch]')!.textContent = pit.match;
      const insp = q('[data-plh-insplabel]')!, box = q('[data-plh-pmatchbox]')!;
      if (verified) { insp.textContent = 'Verified ✓'; insp.style.background = '#e3fbec'; insp.style.color = 'var(--pl-accent-ink)'; box.style.borderColor = 'var(--pl-accent)'; }
      else { insp.textContent = '◌ ' + stageLabels[stage]; insp.style.background = 'var(--pl-sand)'; insp.style.color = 'var(--pl-ink-2)'; box.style.borderColor = 'var(--pl-line-soft)'; }
      const confW = verified ? pit.conf : Math.min(pit.conf, stage * 24 + 8);
      q('[data-plh-conflabel]')!.textContent = confW.toFixed(1) + '%';
      q('[data-plh-confbar]')!.style.width = confW + '%';
      q('[data-plh-verified]')!.textContent = fmtIN(1204877 + item + (verified ? 1 : 0));
      stageEls.forEach((el, i) => {
        const done = i < stage, act = i === stage;
        const node = el.querySelector('[data-plh-stagenode]') as HTMLElement, mk = el.querySelector('[data-plh-stagemk]') as HTMLElement, pill = el.querySelector('[data-plh-stagepill]') as HTMLElement, pdot = el.querySelector('[data-plh-stagepilldot]') as HTMLElement, ptext = el.querySelector('[data-plh-stagepilltext]') as HTMLElement, title = el.querySelector('[data-plh-staget]') as HTMLElement, line = el.querySelector('[data-plh-stageline]') as HTMLElement;
        node.style.background = done ? 'var(--pl-ink)' : act ? 'var(--pl-accent-tint)' : 'var(--pl-cream)';
        node.style.borderColor = done ? 'var(--pl-ink)' : act ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)';
        node.style.color = done ? 'var(--pl-surface)' : act ? 'var(--pl-accent-ink)' : '#B5A59A';
        node.style.boxShadow = act ? '0 0 0 5px rgba(247,99,30,.10)' : done ? '0 10px 20px -12px rgba(28,19,14,.6)' : 'none';
        mk.style.background = done ? 'var(--pl-accent)' : act ? 'var(--pl-ink)' : 'var(--pl-line-strong)';
        mk.textContent = done ? '✓' : act ? '•' : '';
        title.style.color = done || act ? 'var(--pl-ink)' : 'var(--pl-faint)';
        pill.style.background = done ? 'var(--pl-accent-tint)' : act ? 'var(--pl-ink)' : 'var(--pl-cream)';
        pill.style.borderColor = done ? 'var(--pl-accent-line)' : act ? 'var(--pl-ink)' : 'var(--pl-line-soft)';
        (pill.style as any).color = done ? 'var(--pl-accent-ink)' : act ? 'var(--pl-surface)' : 'var(--pl-faint-2)';
        pdot.style.background = done ? 'var(--pl-accent)' : act ? 'var(--pl-accent-end)' : 'var(--pl-line-xstrong)';
        ptext.textContent = done ? 'PASSED' : act ? 'RUNNING' : 'QUEUED';
        if (line) line.style.background = i < stage ? 'var(--pl-accent)' : 'var(--pl-line)';
      });
    }
    paintAcc();
    setInterval(() => { if (stage < 4) stage++; else { stage = 0; item = (item + 1) % 3; } paintAcc(); }, 1400);

    // ---------- How it works (2600ms) ----------
    const hwPills = ['DAY 1', 'DAY 2–3', 'DAY 4', 'DAY 5'];
    const hwCards = qa('[data-plh-hwcard]');
    let step = 1;
    function paintHw() {
      q('[data-plh-hwno]')!.textContent = '0' + (step + 1);
      q('[data-plh-hwfill]')!.style.width = (step + 1) * 25 + '%';
      hwCards.forEach((el, i) => {
        const done = i < step, act = i === step;
        el.style.background = act ? 'var(--pl-surface)' : '#fdfcfa';
        (el.querySelector('[data-plh-hwbar]') as HTMLElement).style.background = done || act ? 'var(--pl-accent)' : 'transparent';
        const node = el.querySelector('[data-plh-hwnode]') as HTMLElement;
        node.style.background = done ? 'var(--pl-accent)' : 'var(--pl-surface)';
        node.style.borderColor = done || act ? 'var(--pl-accent)' : 'var(--pl-line)';
        node.style.color = done ? 'var(--pl-ink-deep)' : act ? 'var(--pl-accent-ink)' : 'var(--pl-faint-2)';
        node.style.boxShadow = act ? '0 0 0 5px rgba(247,99,30,.16)' : 'none';
        node.textContent = done ? '✓' : '0' + (i + 1);
        const pill = el.querySelector('[data-plh-hwpill]') as HTMLElement;
        pill.style.background = act ? 'var(--pl-accent)' : done ? 'var(--pl-accent-tint)' : 'var(--pl-sand)';
        pill.style.color = act ? 'var(--pl-ink-deep)' : done ? 'var(--pl-accent-ink)' : 'var(--pl-faint)';
        pill.textContent = hwPills[i];
        (el.querySelector('[data-plh-hwtitle]') as HTMLElement).style.color = done || act ? 'var(--pl-ink)' : 'var(--pl-muted)';
        (el.querySelector('[data-plh-hwdemo]') as HTMLElement).style.opacity = act ? '1' : '.55';
      });
    }
    hwCards.forEach((el, i) => el.addEventListener('click', () => { step = i; paintHw(); }));
    paintHw();
    setInterval(() => { step = (step + 1) % 4; paintHw(); }, 2600);

    // ---------- Testimonials ----------
    const T = [['HM', 'Head of Marketplace Pricing', 'Consumer Electronics', "We were losing the Buy Box on over 60% of our top 200 SKUs and had no idea until the damage was done. PriceLeap's decision engine started catching competitor undercuts within minutes and responding automatically inside our margin floor. Our Buy Box win rate went from 28% to over 90% in six weeks — without a single manual price change."], ['VP', 'VP of Trading & Pricing', 'Home & Appliances', "With 8,000 SKUs across appliances, kitchenware, and furniture, we couldn't monitor pricing manually. We were reacting to price changes 4–6 hours after they happened — by which time we'd already lost sales. PriceLeap monitors the entire catalog simultaneously. The margin protection system alone saved us from three separate price wars that would have cost us six figures combined."], ['EP', 'eCommerce & Parts Pricing Manager', 'Automotive Parts · Online Parts Retailer', "Automotive parts pricing is complex — the same part has 40 different competitor listings, varying by fitment, brand, and condition. We were systematically underpricing because our team couldn't keep up with how competitors were moving. PriceLeap mapped our parts catalog to competitor listings automatically and immediately found pricing gaps we had no idea existed. We recovered nearly 19% gross margin on parts in the first quarter by simply pricing correctly rather than conservatively."]];
    const testiBtns = qa('[data-plh-testi]'), testiStats = qa('[data-plh-testistat]');
    let tq = 0;
    function paintTesti() {
      testiBtns.forEach((b, i) => { const on = i === tq; b.style.background = on ? 'var(--pl-surface)' : 'var(--pl-cream)'; (b.querySelector('[data-plh-testibar]') as HTMLElement).style.background = on ? 'var(--pl-accent)' : 'transparent'; const av = b.querySelector('[data-plh-testiav]') as HTMLElement; av.style.background = on ? 'var(--pl-accent)' : 'var(--pl-surface)'; av.style.borderColor = on ? 'var(--pl-accent)' : 'var(--pl-line)'; av.style.color = on ? 'var(--pl-ink-deep)' : 'var(--pl-faint)'; (b.querySelector('[data-plh-testirole]') as HTMLElement).style.color = on ? 'var(--pl-ink)' : 'var(--pl-muted)'; });
      testiStats.forEach((b, i) => { const on = i === tq; b.style.background = on ? 'var(--pl-accent-tint)' : 'var(--pl-surface)'; (b.querySelector('[data-plh-testistatv]') as HTMLElement).style.color = on ? 'var(--pl-accent-ink)' : 'var(--pl-ink)'; });
      q('[data-plh-tq]')!.textContent = '“' + T[tq][3] + '”';
      q('[data-plh-tqrole]')!.textContent = T[tq][1];
      q('[data-plh-tqind]')!.textContent = T[tq][2];
      q('[data-plh-tqno]')!.textContent = '0' + (tq + 1) + ' / 03';
    }
    testiBtns.forEach((b, i) => b.addEventListener('click', () => { tq = i; paintTesti(); }));
    testiStats.forEach((b, i) => b.addEventListener('click', () => { tq = i; paintTesti(); }));
    q('[data-plh-tqprev]')?.addEventListener('click', () => { tq = (tq + 2) % 3; paintTesti(); });
    q('[data-plh-tqnext]')?.addEventListener('click', () => { tq = (tq + 1) % 3; paintTesti(); });

    // ---------- Product tour (100ms scrubbing) ----------
    const chapMeta = [['01'], ['02'], ['03'], ['04']];
    const chapUrl = ['add-products', 'price-intelligence', 'products/macbook-neo', 'dynamic-pricing'];
    const chapTitle = ['ADD PRODUCTS', 'MONITOR', 'ANALYZE', 'AUTOMATE'];
    const U = ['https://amazon.com/dp/B07KQ1-canon-eos-rp', 'https://walmart.com/ip/canon-eos-r100', 'https://bestbuy.com/site/sony-a7-iv'];
    const Ltot = U.reduce((a, u) => a + u.length, 0);
    const chaps = qa('[data-plh-chap]'), chapTabs = qa('[data-plh-chaptab]'), chapProgs = qa('[data-plh-chapprog]'), tnavs = qa('[data-plh-tnav]');
    const foundEls = qa('[data-plh-found]'), rowEls = qa('[data-plh-row]'), comp2Els = qa('[data-plh-comp2]'), alertEls = qa('[data-plh-alert]');
    let sc = 0, sp = 0, tPlay = true;
    const r = (a: number, b: number) => clamp((sp - a) / (b - a)), op = (a: number) => r(a, a + 0.08);

    function paintChrome() {
      q('[data-plh-turl]')!.textContent = 'app.priceleap.ai/' + chapUrl[sc];
      q('[data-plh-tchap]')!.textContent = chapMeta[sc][0] + ' / 04 · ' + chapTitle[sc];
      tnavs.forEach((el, i) => { const on = i === sc; el.style.borderColor = on ? 'var(--pl-accent-line)' : 'transparent'; el.style.background = on ? 'var(--pl-accent-tint)' : 'transparent'; el.style.color = on ? 'var(--pl-accent-ink)' : 'var(--pl-faint-2)'; });
      chapTabs.forEach((b, i) => { const on = i === sc; b.style.background = on ? 'var(--pl-surface)' : 'var(--pl-cream)'; b.setAttribute('aria-selected', String(on)); const num = b.querySelector('.plh-chapnum') as HTMLElement; num.style.background = on ? 'var(--pl-ink)' : 'var(--pl-surface)'; num.style.color = on ? 'var(--pl-surface)' : 'var(--pl-faint)'; num.style.borderColor = on ? 'var(--pl-ink)' : 'var(--pl-line)'; (b.querySelector('.plh-chapt') as HTMLElement).style.color = on ? 'var(--pl-ink)' : 'var(--pl-muted)'; });
    }
    function showChap() { chaps.forEach((el) => { const on = Number(el.getAttribute('data-plh-chap')) === sc; el.hidden = !on; if (on) { el.style.animation = 'none'; void el.offsetWidth; el.style.animation = 'pltourin .45s ease'; } }); paintChrome(); }

    function paintTour() {
      chapProgs.forEach((el, i) => (el.style.width = (i === sc ? sp * 100 : i < sc ? 100 : 0) + '%'));
      if (sc === 0) {
        let n = Math.floor(r(0.04, 0.42) * Ltot), caretAt = -1, items = 0;
        U.forEach((u, i) => { const take = Math.max(0, Math.min(u.length, n)); n -= u.length; if (take === u.length) items++; if (caretAt < 0 && take < u.length) caretAt = i; const t = q(`[data-plh-url="${i}"]`); if (t) t.textContent = u.slice(0, take); });
        if (caretAt < 0) caretAt = 2;
        U.forEach((_, i) => { const c = q(`[data-plh-urlcaret="${i}"]`); if (c) c.style.display = (i === caretAt && sp < 0.5) ? 'inline-block' : 'none'; });
        q('[data-plh-titems]')!.textContent = String(items);
        const sel = sp > 0.48, opt = q('[data-plh-opt]')!, optdot = q('[data-plh-optdot]')!;
        opt.style.borderColor = sel ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)'; opt.style.background = sel ? 'var(--pl-cream-2)' : 'var(--pl-surface)';
        optdot.style.border = sel ? '4px solid var(--pl-accent)' : '1.5px solid var(--pl-line-xstrong)';
        const bp = sp > 0.57 && sp < 0.63, fb = q('[data-plh-findbtn]')!; fb.style.transform = 'scale(' + (bp ? 0.95 : 1) + ')'; fb.style.boxShadow = bp ? '0 0 0 4px rgba(247,99,30,.2)' : 'none';
        const finding = sp > 0.62, done = sp > 0.92;
        q('[data-plh-tstatus]')!.textContent = !finding ? 'Waiting for URLs' : done ? '3 matched · 1 no match · monitoring started' : 'Finding competitors…';
        q('[data-plh-tspin]')!.style.display = finding && !done ? 'block' : 'none';
        q('[data-plh-tdone]')!.style.display = done ? 'flex' : 'none';
        q('[data-plh-twait]')!.style.display = finding ? 'none' : 'flex';
        foundEls.forEach((el, i) => { const o = op(0.66 + i * 0.06); el.style.display = finding ? 'flex' : 'none'; el.style.opacity = String(o); el.style.transform = `translateY(${((1 - o) * 6).toFixed(1)}px)`; });
      } else if (sc === 1) {
        const cu = r(0, 0.25), KP = [45, 14, 11, 82];
        KP.forEach((v, i) => { const k = q(`[data-plh-kpi="${i}"]`); if (k) k.textContent = String(Math.round(v * cu)); });
        rowEls.forEach((el, i) => { const o = op(0.08 + i * 0.08); el.style.opacity = String(o); el.style.transform = `translateY(${((1 - o) * 8).toFixed(1)}px)`; });
        const flash = sp > 0.6, fc = q('[data-plh-comp="flash"]'); if (fc) { fc.style.background = flash ? 'var(--pl-danger-tint)' : 'transparent'; const fp = fc.querySelector('[data-plh-compp]') as HTMLElement; fp.textContent = flash ? '$1,049.00' : '$1,099.00'; fp.style.color = flash ? 'var(--pl-danger-ink)' : 'var(--pl-ink)'; }
        const toast = r(0.68, 0.76), tt = q('[data-plh-ttoast]')!; tt.style.opacity = String(toast); tt.style.transform = `translateY(${((1 - toast) * 12).toFixed(1)}px)`;
      } else if (sc === 2) {
        q('[data-plh-smart]')!.textContent = '$' + (799 - 113.93 * r(0.1, 0.4)).toFixed(2);
        q('[data-plh-drawa]')!.setAttribute('stroke-dashoffset', (1 - r(0.08, 0.5)).toFixed(3));
        q('[data-plh-drawb]')!.setAttribute('stroke-dashoffset', (1 - r(0.15, 0.6)).toFixed(3));
        comp2Els.forEach((el, i) => (el.style.opacity = String(op(0.42 + i * 0.08))));
        q('[data-plh-sum]')!.style.opacity = String(r(0.72, 0.8));
      } else {
        const saved = sp > 0.82;
        q('[data-plh-draft]')!.textContent = saved ? 'Saved just now' : 'Unsaved draft';
        const sv = q('[data-plh-save]')!; sv.textContent = saved ? 'Saved ✓' : 'Save rule'; sv.style.background = saved ? 'var(--pl-accent-tint)' : 'var(--pl-ink)'; sv.style.color = saved ? 'var(--pl-accent-ink)' : 'var(--pl-surface)'; sv.style.transform = 'scale(' + (sp > 0.8 && sp < 0.84 ? 0.94 : 1) + ')';
        const name = 'Cameras · beat cheapest by 5%', nm = Math.floor(r(0.04, 0.24) * name.length);
        q('[data-plh-rulename]')!.textContent = name.slice(0, nm);
        q('[data-plh-namecaret]')!.style.display = sp < 0.3 ? 'inline-block' : 'none';
        q('[data-plh-namebox]')!.style.borderColor = sp < 0.3 ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)';
        const posOn = sp > 0.27 && sp < 0.45, pos = q('[data-plh-pos]')!; pos.style.borderColor = posOn ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)'; pos.style.background = posOn ? 'var(--pl-cream-2)' : 'var(--pl-surface)';
        const marOn = sp > 0.42 && sp < 0.58, mar = q('[data-plh-mar]')!; mar.style.borderColor = marOn ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)'; mar.style.background = marOn ? 'var(--pl-cream-2)' : 'var(--pl-surface)';
        const th = [0.5, 0.58, 0.66, 0.74];
        alertEls.forEach((el, i) => { const on = sp > th[i], fresh = on && sp < th[i] + 0.08; el.style.background = fresh ? 'var(--pl-cream-2)' : 'var(--pl-surface)'; (el.querySelector('[data-plh-alerttrack]') as HTMLElement).style.background = on ? 'var(--pl-accent)' : 'var(--pl-line-strong)'; (el.querySelector('[data-plh-alertknob]') as HTMLElement).style.left = on ? '16px' : '2px'; });
        const sv2 = r(0.85, 0.91), st = q('[data-plh-savedtoast]')!; st.style.opacity = String(sv2); st.style.transform = `translate(-50%,${((1 - sv2) * 10).toFixed(1)}px)`;
      }
    }
    showChap(); paintTour();
    chapTabs.forEach((b, i) => b.addEventListener('click', () => { sc = i; sp = 0; showChap(); paintTour(); }));
    const playBtn = q('[data-plh-play]'), playIcon = q('[data-plh-playicon]');
    playBtn?.addEventListener('click', () => {
      tPlay = !tPlay; if (sp >= 1) sp = 0;
      playBtn.setAttribute('aria-label', tPlay ? 'Pause tour' : 'Play tour');
      if (playIcon) { playIcon.innerHTML = tPlay ? '<span style="width:3px;height:11px;border-radius:1px;background:var(--pl-surface)"></span><span style="width:3px;height:11px;border-radius:1px;background:var(--pl-surface)"></span>' : '<span style="width:0;height:0;border-left:9px solid var(--pl-surface);border-top:6px solid transparent;border-bottom:6px solid transparent;margin-left:3px"></span>'; playIcon.style.cssText = tPlay ? 'display:flex;gap:3px' : 'display:flex'; }
    });
    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { tPlay = false; sp = 1; paintTour(); }
    setInterval(() => {
      if (!tPlay || document.hidden) return;
      sp += 100 / 7500;
      if (sp >= 1) { sc = (sc + 1) % 4; sp = 0; showChap(); }
      paintTour();
    }, 100);
  }
</script>

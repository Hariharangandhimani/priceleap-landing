<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('mk-in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  const toggle = (tabSel: string, panelSel: string, attr: string) => {
    const tabs = Array.from(document.querySelectorAll(tabSel)) as HTMLElement[];
    const panels = Array.from(document.querySelectorAll(panelSel)) as HTMLElement[];
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const v = tab.dataset[attr];
      tabs.forEach((t) => { t.classList.toggle('is-on', t === tab); t.setAttribute('aria-selected', String(t === tab)); });
      panels.forEach((p) => { p.hidden = p.dataset[attr] !== v; });
    }));
  };
  toggle('[data-hm-tab]', '[data-hm-panel]', 'hmTab');
  toggle('[data-hm-testi]', '[data-hm-testi-panel]', 'hmTesti');

  // Integration category filter
  const catBtns = Array.from(document.querySelectorAll('[data-hm-cat]')) as HTMLElement[];
  const conns = Array.from(document.querySelectorAll('[data-hm-conn-cat]')) as HTMLElement[];
  catBtns.forEach((b) => b.addEventListener('click', () => {
    const cat = b.dataset.hmCat;
    catBtns.forEach((o) => { o.classList.toggle('is-on', o === b); o.setAttribute('aria-selected', String(o === b)); });
    conns.forEach((c) => { c.style.display = (cat === 'All' || c.dataset.hmConnCat === cat) ? '' : 'none'; });
  }));
</script>

---
// Native Astro port of the design package's homepage.
// Static initial render + the five dc timers and the scrubbing product tour
// reimplemented in vanilla JS: hero refreshed-count ticker; auto-playing 4-chapter
// product tour (Add products / Monitor / Analyze / Automate) with chapter tabs +
// play-pause; "Inside PriceLeap" auto-advancing tabs; accuracy match-pipeline
// (stage + item cycling); how-it-works stepper; integrations orbit (CSS/SMIL);
// testimonial switcher. Uses PriceLeapLayout's one shared header + footer.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];

// CH 0 initial urls (sp=0 → empty, caret on first)
const tourNavIco = ['M12 5v14M5 12h14', 'M3 3v18h18M7 15l4-4 3 3 5-6', 'M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10', 'M3 17l6-6 4 4 8-8M15 7h6v6'];
const chapMeta = [['01', 'Add products', 'Paste URLs · AI finds rivals'], ['02', 'Monitor', 'Live prices & market position'], ['03', 'Analyze', 'Price history & competitors'], ['04', 'Automate', 'Rules, margins & alerts']];

// Inside-PriceLeap tabs
const tabDefs = [
  ['01', 'Add products', 'Paste URLs, upload a file, or connect your catalog.', 'Add Products', 'AI tracks pricing, finds competitors and monitors their prices.'],
  ['02', 'Monitor the market', 'Every price move, stock-out and promo, as it happens.', 'Market Monitor', 'Live feed of competitor changes across every tracked SKU.'],
  ['03', 'Dynamic pricing', 'Rules with floors, ceilings and MAP built in.', 'Dynamic Pricing', 'Set guardrails once; PriceLeap recommends inside them.'],
  ['04', 'Ask the Agent', 'Plain-English answers on prices, rivals and alerts.', 'PriceLeap Agent', 'Ask anything about your catalog and the market.'],
];
const feed = [
  { time: '23:14', type: 'PRICE DROP', text: 'Retailer B cut True Wireless Earbuds Pro', delta: '-2.4%', c: '#e5484d' },
  { time: '23:09', type: 'STOCK-OUT', text: 'Marketplace A is out of stock on Smart Fitness Watch 46mm', delta: '0 units', c: '#e08a00' },
  { time: '22:57', type: 'PROMO', text: 'D2C store C launched 20% off on Portable Bluetooth Speaker', delta: '20% off', c: 'var(--pl-accent-end)' },
  { time: '22:41', type: 'PRICE RISE', text: 'Marketplace D raised 4K Action Camera Pro', delta: '+3.1%', c: 'var(--pl-accent-ink)' },
  { time: '22:30', type: 'NEW LISTING', text: 'New model detected: Mechanical Keyboard TKL v2', delta: '+1 SKU', c: 'var(--pl-muted-2)' },
];
const tracking = [
  { n: 'Marketplace A · Headphones', w: 28, p: '₹25,490' }, { n: 'Retailer B · Headphones', w: 96, p: '₹24,790' },
  { n: 'D2C store C · Earbuds', w: 74, p: '₹18,990' }, { n: 'Marketplace D · Speakers', w: 50, p: '₹6,290' },
];
// Accuracy pipeline items
const pItems = [
  { you: 'Wireless ANC Headphones', sku: 'WH-ANC-700', src: 'RETAILER B', match: 'Sonix ANC 700 Over-Ear', price: '₹24,790', kind: 'Exact match', conf: 99.1 },
  { you: 'Smart Fitness Watch 46mm', sku: 'SFW-46-BLK', src: 'D2C STORE C', match: 'FitPro 46 mm Smartwatch — Midnight', price: '₹9,990', kind: 'Similar product', conf: 97.8 },
  { you: 'Portable Bluetooth Speaker', sku: 'PBS-MINI-4', src: 'MARKETPLACE D', match: 'Mini Boom 4 Wireless Speaker', price: '₹6,290', kind: 'White-label', conf: 95.4 },
];
const sd = [
  ['01', 'MATCH', 'AI matching', 'Exact, similar, and white-label products — even without barcodes.', '1,204,860 matched', 'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z'],
  ['02', 'QC', 'Human quality control', 'Every match reviewed by a trained QC analyst before it counts.', '100% reviewed', 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6'],
  ['03', 'ANOMALY', 'Anomaly detection', 'Automated checks flag price and match outliers in real time.', '312 outliers held', 'M3 12h4l3-8 4 16 3-8h4'],
  ['04', 'SLA', 'Accuracy SLA in writing', 'A contractual guarantee — not a marketing number.', '[PLACEHOLDER]% guaranteed', 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM9 12l2 2 4-4'],
];
const hwDefs = [
  ['Connect your catalog', 'Upload your products or sync from Shopify, marketplaces, or a feed in minutes.', 'DAY 1'],
  ['We match & monitor', 'AI matches every product and human QC verifies it — then we track prices in real time.', 'DAY 2–3'],
  ['Get pricing intelligence', 'See your price index, competitive gaps, and the biggest pricing opportunities.', 'DAY 4'],
  ['Optimize & act', 'Push dynamic pricing rules or apply AI recommendations to win on margin.', 'DAY 5'],
];
const testiData = [
  ['HM', 'Head of Marketplace Pricing', 'Consumer Electronics', '28% → 90%+', 'BUY BOX WIN RATE', "We were losing the Buy Box on over 60% of our top 200 SKUs and had no idea until the damage was done. PriceLeap's decision engine started catching competitor undercuts within minutes and responding automatically inside our margin floor. Our Buy Box win rate went from 28% to over 90% in six weeks — without a single manual price change."],
  ['VP', 'VP of Trading & Pricing', 'Home & Appliances', '8,000 SKUs', 'MONITORED SIMULTANEOUSLY', "With 8,000 SKUs across appliances, kitchenware, and furniture, we couldn't monitor pricing manually. We were reacting to price changes 4–6 hours after they happened — by which time we'd already lost sales. PriceLeap monitors the entire catalog simultaneously. The margin protection system alone saved us from three separate price wars that would have cost us six figures combined."],
  ['EP', 'eCommerce & Parts Pricing Manager', 'Automotive Parts · Online Parts Retailer', '~19%', 'GROSS MARGIN RECOVERED', "Automotive parts pricing is complex — the same part has 40 different competitor listings, varying by fitment, brand, and condition. We were systematically underpricing because our team couldn't keep up with how competitors were moving. PriceLeap mapped our parts catalog to competitor listings automatically and immediately found pricing gaps we had no idea existed. We recovered nearly 19% gross margin on parts in the first quarter by simply pricing correctly rather than conservatively."],
];
const inLogos = [['shopify', 'Shopify', '15.91'], ['amazon', 'Amazon', '38.64'], ['flipkart', 'Flipkart', '61.36'], ['magento', 'Magento', '84.09']];
const outLogos = [['slack', 'Slack', '15.91'], ['snowflake', 'Snowflake', '38.64'], ['salesforce', 'Salesforce', '61.36'], ['googlesheets', 'Sheets', '84.09']];
---
<PriceLeapLayout
  title="PriceLeap · Competitor Price Tracking & Dynamic Pricing Intelligence"
  description="PriceLeap gives e-commerce and marketplace teams real-time competitor price tracking, verified data accuracy and dynamic pricing that protects every point of margin — in one workspace."
>
  <div class="plh">
    <!-- ANNOUNCEMENT -->
    <div style="padding:12px 12px 0">
      <div style="background:var(--pl-ink-deep);color:var(--pl-surface);border-radius:10px;padding:10px 16px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;font-size:14px;text-align:center">
        <span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.08em;background:var(--pl-ink);color:var(--pl-surface);padding:2px 7px;border-radius:5px;font-weight:500">NEW</span>
        <span>PriceLeap Agent answers pricing questions in plain English, right inside your dashboard.</span>
        <a href="#agent" style="color:var(--pl-surface);text-decoration:underline;text-underline-offset:3px;font-weight:500">See it in action →</a>
      </div>
    </div>

    <div class="plh-frame" style="max-width:1240px;margin:0 auto;position:relative">
      <span aria-hidden="true" class="plh-frameline" style="left:0"></span>
      <span aria-hidden="true" class="plh-frameline" style="right:0"></span>

      <!-- HERO -->
      <section class="plh-hero" style="position:relative;text-align:center;overflow:hidden">
        <div style="position:absolute;inset:0;background-image:radial-gradient(var(--pl-line-strong) 1px,transparent 1px);background-size:22px 22px;-webkit-mask-image:radial-gradient(ellipse at 50% 40%,#000 0%,transparent 70%);mask-image:radial-gradient(ellipse at 50% 40%,#000 0%,transparent 70%);opacity:.7"></div>
        <div style="position:absolute;left:50%;top:-180px;width:720px;height:420px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.12),rgba(251,138,46,.08),transparent);pointer-events:none"></div>
        <div style="position:relative;display:flex;flex-direction:column;align-items:center">
          <div style="display:inline-flex;align-items:center;gap:10px;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:999px;padding:6px 8px 6px 14px;font-size:13px;color:var(--pl-ink-2);box-shadow:0 1px 2px rgba(0,0,0,.04)">Pricing intelligence for e-commerce &amp; marketplaces<span style="width:20px;height:20px;border-radius:50%;background:var(--pl-ink);color:var(--pl-surface);display:flex;align-items:center;justify-content:center;font-size:11px">›</span></div>
          <h1 style="margin:28px 0 0;font-size:clamp(40px,5.6vw,68px);line-height:1.04;letter-spacing:-.035em;font-weight:500;max-width:1060px;text-wrap:balance">Price with confidence on data<br />you can <span style="background:var(--pl-gradient-text);-webkit-background-clip:text;background-clip:text;color:transparent">actually trust.</span></h1>
          <p style="margin:26px 0 0;font-size:19px;line-height:1.6;color:var(--pl-muted-2);max-width:680px;text-wrap:pretty">PriceLeap gives e-commerce and marketplace teams real-time competitor price tracking, verified data accuracy, and dynamic pricing that protects <span style="background:#FBEFE6;color:var(--pl-ink);padding:1px 8px;border-radius:6px">every point of margin.</span></p>
          <div style="display:flex;gap:12px;margin-top:36px;flex-wrap:wrap;justify-content:center">
            <a href="/book-a-demo" style="background:var(--pl-gradient);color:var(--pl-surface);font-weight:500;font-size:16px;padding:15px 26px;border-radius:14px;box-shadow:0 14px 30px -12px rgba(247,99,30,.75)">Book a demo</a>
            <a href="#product" style="display:flex;align-items:center;gap:12px;background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink);font-weight:500;font-size:16px;padding:8px 18px 8px 8px;border-radius:14px"><span style="display:flex"><span style="width:30px;height:30px;border-radius:50%;background:var(--pl-accent);color:var(--pl-surface);font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;display:flex;align-items:center;justify-content:center;border:2px solid var(--pl-surface)">₹</span><span style="width:30px;height:30px;border-radius:50%;background:var(--pl-accent-end);color:var(--pl-surface);font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;display:flex;align-items:center;justify-content:center;border:2px solid var(--pl-surface);margin-left:-8px">%</span><span style="width:30px;height:30px;border-radius:50%;background:var(--pl-ink);color:var(--pl-surface);font-family:'Geist Mono',ui-monospace,monospace;font-size:10px;display:flex;align-items:center;justify-content:center;border:2px solid var(--pl-surface);margin-left:-8px">↗</span></span>See a sample of your competitor data <span style="color:var(--pl-faint-2)">›</span></a>
          </div>
          <div style="margin-top:28px;display:flex;align-items:center;gap:10px;font-size:14px;color:var(--pl-muted)"><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-accent);animation:plpulse 1.6s infinite"></span><span data-plh-count style="font-family:'Geist Mono',ui-monospace,monospace;color:var(--pl-ink)">35,26,158</span> prices refreshed today</div>
        </div>
      </section>

      <!-- PRODUCT TOUR -->
      <section id="product" class="plh-tour" style="position:relative;border-bottom:1px solid var(--pl-line);background:linear-gradient(var(--pl-canvas),var(--pl-sand))">
        <div style="max-width:1120px;margin:0 auto">
          <div role="region" aria-label="PriceLeap product tour" style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;box-shadow:0 40px 80px -48px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
            <div style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)">
              <div style="display:flex;gap:6px;flex:none"><span style="width:10px;height:10px;border-radius:50%;background:var(--pl-line)"></span><span style="width:10px;height:10px;border-radius:50%;background:var(--pl-line)"></span><span style="width:10px;height:10px;border-radius:50%;background:var(--pl-line)"></span></div>
              <div style="flex:1;min-width:0;display:flex;justify-content:center"><div style="max-width:380px;width:100%;min-width:0;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--pl-surface);border:1px solid var(--pl-line-soft);border-radius:8px;padding:4px 12px;font-family:'Geist Mono',ui-monospace,monospace;font-size:11.5px;color:var(--pl-muted-2)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-accent);flex:none"></span><span data-plh-turl style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">app.priceleap.ai/add-products</span></div></div>
              <span data-plh-tchap class="plh-twide" style="flex:none;font-family:'Geist Mono',ui-monospace,monospace;font-size:10.5px;letter-spacing:.08em;color:var(--pl-faint)">01 / 04 · ADD PRODUCTS</span>
            </div>
            <div class="plh-tbody" style="display:flex">
              <aside aria-hidden="true" class="plh-tside" style="width:58px;flex:none;border-right:1px solid var(--pl-line-soft);background:var(--pl-cream);flex-direction:column;align-items:center;gap:8px;padding:14px 0">
                <img src="/assets/pl-mark.png" alt="" width="28" height="28" style="display:block;width:28px;height:28px;object-fit:contain;margin-bottom:8px" />
                {tourNavIco.map((ico, i) => (<span data-plh-tnav={i} style={`width:36px;height:36px;border-radius:10px;border:1px solid ${i === 0 ? 'var(--pl-accent-line)' : 'transparent'};background:${i === 0 ? 'var(--pl-accent-tint)' : 'transparent'};color:${i === 0 ? 'var(--pl-accent-ink)' : 'var(--pl-faint-2)'};display:flex;align-items:center;justify-content:center;transition:all .3s`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={ico}></path></svg></span>))}
                <span style="margin-top:auto;width:30px;height:30px;border-radius:50%;background:var(--pl-ink);color:var(--pl-surface);font-family:'Geist Mono',ui-monospace,monospace;font-size:9.5px;display:flex;align-items:center;justify-content:center">SK</span>
              </aside>
              <div style="flex:1;min-width:0;position:relative;overflow:hidden">

                <!-- CHAPTER 0 -->
                <div data-plh-chap="0" style="height:100%;animation:pltourin .45s ease"><div style="height:100%;display:flex;flex-direction:column">
                  <div style="display:flex;align-items:center;gap:12px;padding:11px 18px;border-bottom:1px solid var(--pl-line-soft);min-height:46px"><span style="font-size:14px;font-weight:600;color:var(--pl-ink);white-space:nowrap">Add Products</span><span class="plh-twide" style="font-size:12.5px;color:var(--pl-faint);border-left:1px solid var(--pl-line-soft);padding-left:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0">AI tracks pricing, finds competitors and monitors their prices.</span><span style="margin-left:auto;flex:none"><span style="background:var(--pl-ink);color:var(--pl-surface);border-radius:8px;padding:6px 11px;font-size:12px;font-weight:500">+ Add products</span></span></div>
                  <div class="plh-tadd" style="flex:1;min-height:0;display:grid;gap:14px;padding:14px 18px">
                    <div style="display:flex;flex-direction:column;gap:10px;min-width:0">
                      <div style="display:flex;gap:18px;border-bottom:1px solid var(--pl-line-soft);font-size:12.5px"><span style="padding:0 0 8px;border-bottom:2px solid var(--pl-accent);color:var(--pl-ink);font-weight:600">Paste URLs</span><span style="padding:0 0 8px;color:var(--pl-faint)">Upload file</span><span style="padding:0 0 8px;color:var(--pl-faint)">Connect catalog</span></div>
                      <div style="background:var(--pl-surface);border:1px solid var(--pl-line-soft);border-radius:12px;padding:12px 14px;font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;line-height:1.75;min-height:108px">
                        <div style="color:var(--pl-faint-2)">Paste multiple URLs (one per line):</div>
                        {[0, 1, 2].map((i) => (<div style="color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:21px"><span data-plh-url={i}></span><span data-plh-urlcaret={i} style={`display:${i === 0 ? 'inline-block' : 'none'};width:7px;height:14px;margin-left:1px;vertical-align:-2px;background:var(--pl-accent);animation:plblink 1s steps(1) infinite`}></span></div>))}
                      </div>
                      <div class="plh-topt" style="display:grid;gap:8px">
                        <div data-plh-opt style="border:1px solid var(--pl-line-soft);background:var(--pl-surface);border-radius:12px;padding:11px 12px;transition:all .35s"><div style="display:flex;align-items:center;gap:8px"><span data-plh-optdot style="width:14px;height:14px;border-radius:50%;border:1.5px solid var(--pl-line-xstrong);background:var(--pl-surface);flex:none;transition:all .3s"></span><span style="font-size:13px;font-weight:600;color:var(--pl-ink)">Find &amp; monitor competitors</span></div><div style="margin:6px 0 0 22px;font-size:11.5px;line-height:1.45;color:var(--pl-muted)">AI discovers competing products and tracks their prices.</div></div>
                        <div style="border:1px solid var(--pl-line-soft);background:var(--pl-surface);border-radius:12px;padding:11px 12px"><div style="display:flex;align-items:center;gap:8px"><span style="width:14px;height:14px;border-radius:50%;border:1.5px solid var(--pl-line-xstrong);flex:none"></span><span style="font-size:13px;font-weight:600;color:var(--pl-ink)">Track my product URLs</span></div><div style="margin:6px 0 0 22px;font-size:11.5px;line-height:1.45;color:var(--pl-muted)">Assign competitor URLs yourself, whenever you're ready.</div></div>
                      </div>
                      <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap"><span style="font-size:12.5px;color:var(--pl-ink-2)">Adding <b data-plh-titems style="font-family:'Geist Mono',ui-monospace,monospace">0</b> items to <span style="font-family:'Geist Mono',ui-monospace,monospace;font-size:11.5px;border:1px solid var(--pl-line-soft);border-radius:6px;padding:2px 7px">Mirrorless Cameras ▾</span></span><span data-plh-findbtn style="background:var(--pl-ink);color:var(--pl-surface);border-radius:9px;padding:8px 14px;font-size:12.5px;font-weight:500;transition:all .2s">Find competitors →</span></div>
                    </div>
                    <div style="background:var(--pl-surface);border:1px solid var(--pl-line-soft);border-radius:12px;display:flex;flex-direction:column;overflow:hidden;min-height:200px">
                      <div style="display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)"><span style="width:26px;height:26px;border-radius:8px;background:var(--pl-ink);color:var(--pl-surface);display:flex;align-items:center;justify-content:center;font-size:12px">✦</span><div style="min-width:0"><div style="font-size:13px;font-weight:600;color:var(--pl-ink)">AI competitor discovery</div><div data-plh-tstatus style="font-size:11.5px;color:var(--pl-muted)">Waiting for URLs</div></div><span data-plh-tspin style="margin-left:auto;display:none;width:14px;height:14px;border-radius:50%;border:2px solid var(--pl-line-soft);border-top-color:var(--pl-accent);animation:pltspin .8s linear infinite"></span><span data-plh-tdone style="margin-left:auto;display:none;width:20px;height:20px;border-radius:50%;background:var(--pl-ink);color:var(--pl-surface);font-size:10px;align-items:center;justify-content:center">✓</span></div>
                      <div style="padding:8px 14px;display:flex;flex-direction:column;flex:1">
                        <div data-plh-twait style="display:flex;flex:1;align-items:center;justify-content:center;text-align:center;font-size:12.5px;color:var(--pl-faint-2);padding:20px 0">Competitors appear here as soon as you add URLs.</div>
                        {[['Amazon', '$1,099.00', 'var(--pl-accent)', 1], ['Target', '$1,099.00', '#E5484D', 1], ['Newegg', '$1,099.00', '#2F9E6B', 1], ['Best Buy', 'No match', '#3B6FD8', 0]].map((f, i) => (<div data-plh-found={i} style={`display:none;align-items:center;gap:10px;padding:9px 0;border-bottom:1px dashed var(--pl-line-soft);opacity:0;transform:translateY(6px);transition:opacity .3s,transform .3s`}><span style={`width:8px;height:8px;border-radius:50%;background:${f[2]};flex:none`}></span><span style="font-size:13px;font-weight:500;color:var(--pl-ink)">{f[0]}</span><span style={`margin-left:auto;font-family:'Geist Mono',ui-monospace,monospace;font-size:12px;color:${f[3] ? 'var(--pl-ink)' : 'var(--pl-faint-2)'}`}>{f[1]}</span><span style={`font-family:'Geist Mono',ui-monospace,monospace;font-size:9.5px;letter-spacing:.06em;border-radius:5px;padding:2px 6px;background:${f[3] ? 'var(--pl-accent-tint)' : 'var(--pl-sand)'};color:${f[3] ? 'var(--pl-accent-ink)' : 'var(--pl-faint)'}`}>{f[3] ? 'MATCHED' : 'NO MATCH'}</span></div>))}
                      </div>
                    </div>
                  </div>
                </div></div>

                <!-- CHAPTER 1 -->
                <div data-plh-chap="1" hidden style="height:100%"><div style="height:100%;display:flex;flex-direction:column">
                  <div style="display:flex;align-items:center;gap:12px;padding:11px 18px;border-bottom:1px solid var(--pl-line-soft);min-height:46px"><span style="font-size:14px;font-weight:600;color:var(--pl-ink);white-space:nowrap">Price Intelligence</span><span class="plh-twide" style="font-size:12.5px;color:var(--pl-faint);border-left:1px solid var(--pl-line-soft);padding-left:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0">Monitor competitor prices and track your market position.</span><span style="margin-left:auto;flex:none"><span style="display:flex;align-items:center;gap:6px;font-family:'Geist Mono',ui-monospace,monospace;font-size:10.5px;color:var(--pl-faint)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-accent);animation:plpulse 1.6s infinite"></span>LIVE · <span data-plh-clock>00:00:00</span></span></span></div>

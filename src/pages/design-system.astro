---
/**
 * PriceLeap Design System — complete component library page
 * All 54 components displayed with live examples and props documentation
 */
import SiteLayout from '@/layouts/SiteLayout.astro';

// ── Design system components ──
// UI primitives
import Button         from '@/components/ds/ui/Button.astro';
import Badge          from '@/components/ds/ui/Badge.astro';

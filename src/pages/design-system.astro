const sampleBlogPost = {
  title: 'How to Win the Buy Box Without Sacrificing Margin',
  href: '#', category: 'Strategy', date: 'Oct 28, 2026', readTime: '6 min',
  excerpt: 'Most sellers race to the bottom on price. Here is the data-driven approach that keeps you competitive while protecting every point of margin.',
  author: { name: 'Priya Sharma', initials: 'PS' },
};

const sampleAuthor = {
  name: 'Priya Sharma',
  role: 'Head of Pricing Strategy',
  bio: 'Priya has spent 10+ years helping e-commerce and marketplace teams price with confidence. She writes about MAP compliance, Buy Box strategy and margin-safe automation.',
  href: '#', linkedin: '#',
};

const samplePosts = [
  { ...sampleBlogPost, title:'How to Win the Buy Box Without Sacrificing Margin', category:'Strategy' },
  { ...sampleBlogPost, title:'What Is a Price Index and Why Does It Matter?', category:'Fundamentals' },
  { ...sampleBlogPost, title:'MAP Monitoring: A Practical Compliance Playbook', category:'MAP' },
  { ...sampleBlogPost, title:'Dynamic Pricing Rules Every Seller Should Know', category:'Strategy' },
  { ...sampleBlogPost, title:'Matching Products Without Barcodes — the AI + QC Approach', category:'Fundamentals' },
  { ...sampleBlogPost, title:'Marketplace Repricing Without the Race to the Bottom', category:'MAP' },
];

const sampleIntegrations = [
  { name:'Shopify',  logo:'/assets/logos/shopify.svg',  api:'ADMIN API',  connected:true },
  { name:'Amazon',   logo:'/assets/logos/amazon.svg',   api:'SP-API',     connected:false },
  { name:'Slack',    logo:'/assets/logos/slack.svg',    api:'OAUTH 2.0',  connected:true },
  { name:'Snowflake',logo:'/assets/logos/snowflake.svg',api:'DATA SHARE', connected:false },
];

const tokens: Record<string, { name: string; hex: string; role: string; border?: string }[]> = {
  brand: [
    { name:'Velocity Green',  hex:'#FF3131', role:'CTAs, live states, accent' },
    { name:'Green Hover',     hex:'#EC2B2B', role:'Button hover' },
    { name:'Green Ink',       hex:'#C81E1E', role:'Gradient text, links' },
    { name:'Green Tint',      hex:'#FFF1EC', role:'Accent backgrounds' },
    { name:'On Accent',       hex:'#ffffff', role:'Text on accent' },
    { name:'Green Line',      hex:'#FFCDBE', role:'Accent borders' },
  ],
  neutrals: [
    { name:'Ink',        hex:'#17161a', role:'Headings, primary text' },
    { name:'Ink 2',      hex:'#3a3940', role:'Body text' },
    { name:'Muted',      hex:'#6b6a70', role:'Secondary text' },
    { name:'Faint',      hex:'#8a8990', role:'Placeholder' },
    { name:'Canvas',     hex:'#f6f5f2', role:'Page background', border:'1px solid #e4e2dc' },
    { name:'Surface',    hex:'#ffffff', role:'Cards', border:'1px solid #e4e2dc' },
    { name:'Surface 2',  hex:'#fbfaf8', role:'Sidebar, header', border:'1px solid #e4e2dc' },
    { name:'Line',       hex:'#e4e2dc', role:'Borders, dividers', border:'1px solid #d6d3cb' },
  ],
  semantic: [
    { name:'Danger',     hex:'#e5484d', role:'Error, MAP alerts' },
    { name:'Danger Tint',hex:'#fff5f5', role:'Error backgrounds', border:'1px solid #f5c2c4' },
    { name:'Warn',       hex:'#e08a00', role:'OOS, caution' },
    { name:'Warn Tint',  hex:'#fff8ec', role:'Warning backgrounds', border:'1px solid #f5dcb0' },
  ],
};
---

<SiteLayout title="PriceLeap Design System v2 — All 54 Components">

  <!-- ── Hero ── -->
  <section class="ds-hero">
    <div class="ds-hero-dots" aria-hidden="true"></div>
    <div class="ds-hero-copy">
      <span class="ds-live-pill"><span class="ds-live-dot"></span>PriceLeap Design System v2</span>
      <h1>One system for every <br /><b class="ds-grad">PriceLeap page.</b></h1>
      <p>54 reusable Astro components, 7 CSS token files, vanilla JS helpers. Every block on this page is a real, importable component — no stubs, no placeholders.</p>
      <div class="ds-hero-chips">
        <span><span class="ds-chip-sq"></span>#FF3131 · Velocity Green</span>
        <span>Geist · Inter · Geist Mono</span>
        <span>54 components</span>
        <span>7 style files</span>
        <span>Radius 6–24px</span>
        <span>Motion 150–700ms</span>
      </div>
      <div class="ds-hero-btns">
        <a href="#ui" class="ds-btn-primary">Browse components</a>
        <a href="/light" class="ds-btn-secondary">See homepage →</a>
      </div>
    </div>
  </section>

  <div class="ds-layout">

    <!-- Sticky sidebar -->
    <nav class="ds-sidebar" aria-label="Jump to section">
      {navSections.map(s => (
        <a href={`#${s.id}`} class="ds-sidebar-link">
          <span class="ds-sidebar-n mono">{s.n}</span>{s.label}
        </a>
      ))}
      <div class="ds-sidebar-meta mono">54 components · v2</div>
    </nav>

    <main class="ds-main">

      <!-- ════════════════════════════════════════
           01 DESIGN TOKENS
           ════════════════════════════════════════ -->
      <section id="tokens" class="ds-sec">
        <div class="ds-sec-head">
          <span class="ds-sec-n mono">01</span>
          <h2>Design Tokens</h2>
        </div>
        <p class="ds-sec-desc">Single source of truth in <code>src/styles/tokens.css</code>. Import once in <code>SiteLayout</code> — every component inherits <code>--pl-*</code> variables automatically.</p>

        {[
          { label: 'Brand', swatches: tokens.brand },
          { label: 'Neutrals', swatches: tokens.neutrals },
          { label: 'Semantic', swatches: tokens.semantic },
        ].map(group => (
          <div class="ds-token-group">
            <div class="ds-token-label mono">{group.label}</div>
            <div class="ds-swatches">
              {group.swatches.map(s => (
                <div class="ds-swatch">
                  <span class="ds-swatch-color" style={`background:${s.hex};${s.border?`border:${s.border}`:''}`}></span>
                  <div class="ds-swatch-name">{s.name}</div>
                  <div class="mono ds-swatch-hex">{s.hex}</div>
                  <div class="ds-swatch-role">{s.role}</div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <div class="ds-token-files">
          {['app.css','tokens.css','animations.css','primitives.css','dialog.css','toast.css'].map(f => (
            <div class="ds-token-file">
              <span class="ds-file-dot"></span>
              <code>{f}</code>
            </div>
          ))}
        </div>
      </section>

      <div class="ds-divider"></div>

      <!-- ════════════════════════════════════════
           02 UI PRIMITIVES
           ════════════════════════════════════════ -->
      <section id="ui" class="ds-sec">
        <div class="ds-sec-head"><span class="ds-sec-n mono">02</span><h2>UI Primitives</h2></div>
        <p class="ds-sec-desc">10 foundational components — buttons, inputs, badges, toggles. Import from <code>@/components/ds/ui/</code>.</p>

        <!-- Button -->
        <div class="ds-block">
          <div class="ds-block-head">
            <h3>Button</h3>
            <code>&lt;Button variant size href loading disabled /&gt;</code>
          </div>
          <div class="ds-card">
            <div class="ds-row"><h4>Variants</h4></div>
            <div class="ds-flex-wrap">
              <Button href="/book-a-demo">Book a demo</Button>
              <Button variant="secondary">Secondary</Button>
              <Button variant="ghost">Ghost</Button>
              <Button variant="link" href="/price-intelligence-engine">Learn more</Button>
              <Button variant="danger">Delete</Button>
            </div>
            <div class="ds-row" style="margin-top:20px"><h4>Sizes</h4></div>
            <div class="ds-flex-wrap">
              <Button size="sm">Small</Button>
              <Button>Medium</Button>
              <Button size="lg">Large</Button>
              <Button loading>Loading</Button>
              <Button disabled>Disabled</Button>
            </div>
          </div>
        </div>

        <!-- Badge -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Badge</h3><code>&lt;Badge tone live /&gt;</code></div>
          <div class="ds-card">
            <div class="ds-flex-wrap">
              <Badge tone="accent">Verified</Badge>
              <Badge tone="solid">NEW</Badge>
              <Badge tone="neutral">Neutral</Badge>
              <Badge tone="danger">Above MAP</Badge>
              <Badge tone="warn">Pending QC</Badge>
              <Badge tone="accent" live>LIVE</Badge>
            </div>
          </div>
        </div>

        <!-- Input + Select -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Input / Select</h3><code>&lt;Input label name type error /&gt; · &lt;Select label name options /&gt;</code></div>
          <div class="ds-card">
            <div class="ds-grid2">
              <Input label="Work email" name="email" type="email" placeholder="you@company.com" required />
              <Input label="Message" name="message" textarea placeholder="Tell us about your catalog…" />
              <Input label="Error state" name="err" placeholder="priya@" error="Enter a valid work email" />
              <Select label="Number of SKUs" name="skus" options={['Under 1,000','1,000–10,000','10,000–100,000','100,000+']} />
            </div>
          </div>
        </div>

        <!-- Toggle + Checkbox + IconButton + CopyButton + Divider + PlayButton -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Controls</h3></div>
          <div class="ds-card">
            <div class="ds-flex-wrap" style="gap:24px;align-items:center">
              <Toggle name="reprice" label="Auto-reprice" checked />
              <Toggle name="alerts" label="Slack alerts" />
              <Checkbox name="agree" label="I accept the terms" checked />
              <Checkbox name="news" label="Pricing insights newsletter" />
            </div>
            <div class="ds-divider" style="margin:20px 0"></div>
            <div class="ds-flex-wrap">
              <IconButton label="Arrow right"><svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></IconButton>
              <IconButton label="Share" variant="accent"><svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg></IconButton>
              <IconButton label="Edit" variant="round"><svg slot="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></IconButton>
              <CopyButton text="npm i @priceleap/sdk" label="Copy install" />
              <PlayButton label="Watch demo" size={52} />
            </div>
            <div class="ds-divider" style="margin:20px 0"></div>
            <div style="display:flex;flex-direction:column;gap:12px">
              <Divider />
              <Divider variant="dashed" />
              <Divider variant="label" label="or continue with" />
            </div>
          </div>
        </div>
      </section>

      <div class="ds-divider"></div>

      <!-- ════════════════════════════════════════
           03 NAVIGATION
           ════════════════════════════════════════ -->
      <section id="nav" class="ds-sec">
        <div class="ds-sec-head"><span class="ds-sec-n mono">03</span><h2>Navigation</h2></div>
        <p class="ds-sec-desc">Logo, announcement bar, breadcrumbs, tabs, filter bar, section header, dropdown, pagination. Import from <code>@/components/ds/nav/</code>.</p>

        <!-- Logo -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Logo</h3><code>&lt;Logo size href /&gt;</code></div>
          <div class="ds-card">
            <div class="ds-flex-wrap" style="align-items:center;gap:32px">
              <Logo size={18} />
              <Logo size={21} />
              <Logo size={28} />
            </div>
          </div>
        </div>

        <!-- AnnouncementBar -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>AnnouncementBar</h3><code>&lt;AnnouncementBar tag text href cta variant /&gt;</code></div>
          <div class="ds-card" style="padding:0;overflow:hidden">
            <AnnouncementBar text="PriceLeap Agent answers pricing questions in plain English." href="/book-a-demo" cta="See it in action →" variant="dark" />
            <AnnouncementBar tag="UPDATE" text="ISO 27001 certification renewed for 2026–2027." href="/about" cta="Read more →" variant="tint" />
          </div>
        </div>

        <!-- Breadcrumbs -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Breadcrumbs</h3><code>&lt;Breadcrumbs items variant /&gt;</code></div>
          <div class="ds-card" style="display:flex;flex-direction:column;gap:16px">
              <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Product',href:'/price-intelligence-engine'},{label:'Price Intelligence'}]} variant="text" />
              <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Design system',href:'/design-system'},{label:'How to Win the Buy Box'}]} variant="chips" />
          </div>
        </div>

        <!-- Tabs -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Tabs</h3><code>&lt;Tabs tabs variant id /&gt;</code></div>
          <div class="ds-card" style="display:flex;flex-direction:column;gap:28px">
            <div>
              <p class="ds-variant-label mono">underline (default)</p>
              <Tabs tabs={['Overview','Features','Pricing','Changelog']} id="tabs-under" variant="underline">
                <div slot="panel-0"><div class="ds-panel-content">Overview panel content goes here.</div></div>
                <div slot="panel-1"><div class="ds-panel-content">Features panel content.</div></div>
                <div slot="panel-2"><div class="ds-panel-content">Pricing panel content.</div></div>
                <div slot="panel-3"><div class="ds-panel-content">Changelog panel content.</div></div>
              </Tabs>
            </div>
            <div>
              <p class="ds-variant-label mono">segmented</p>
              <Tabs tabs={['Monthly','Annual']} id="tabs-seg" variant="segmented">
                <div slot="panel-0"><div class="ds-panel-content">Monthly pricing.</div></div>
                <div slot="panel-1"><div class="ds-panel-content">Annual pricing (save 20%).</div></div>
              </Tabs>
            </div>
          </div>
        </div>

        <!-- FilterBar -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>FilterBar</h3><code>&lt;FilterBar items active variant multi /&gt;</code></div>
          <div class="ds-card" style="display:flex;flex-direction:column;gap:16px">
            <FilterBar items={['All','Ecommerce','ERP & CRM','Data & BI','Alerts']} variant="pills" />
            <FilterBar items={['Strategy','Marketplaces','MAP','Pricing Rules']} variant="tags" />
          </div>
        </div>

        <!-- SectionHeader -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>SectionHeader</h3><code>&lt;SectionHeader eyebrow title accent lead align /&gt;</code></div>
          <div class="ds-card" style="display:flex;flex-direction:column;gap:32px">
            <SectionHeader eyebrow="Core capabilities" title="Everything you need to monitor, decide, and" accent="win on price." lead="Six capabilities in one workspace — from real-time data to margin-safe automation." align="center" />
            <SectionHeader eyebrow="How it works" title="Live in days," accent="not months." align="left" />
          </div>
        </div>

        <!-- Dropdown + Pagination -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Dropdown · Pagination</h3></div>
          <div class="ds-card" style="display:flex;flex-direction:column;gap:24px">
            <div class="ds-flex-wrap">
              <Dropdown label="Resources" options={['How it works','Data accuracy','Integrations','API docs']} name="dd1" />
              <Dropdown label="Sort by" options={['Newest first','Most popular','Alphabetical']} name="dd2" />
            </div>
            <Pagination current={3} total={12} base="/design-system#blog" variant="numbered" />
            <Pagination current={3} total={12} base="/design-system#blog" variant="prev-next" />
          </div>
        </div>

        <!-- Header (full mega-nav) -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>Header</h3><code>&lt;Header /&gt; · data from src/data/nav.ts</code></div>
          <p class="ds-variant-label mono" style="margin-bottom:10px">Production mega-nav — hover or tap a menu to open. Same component used at the top of every marketing page.</p>
          <div class="ds-header-preview">
            <Header />
          </div>
        </div>

        <!-- SearchOverlay -->
        <div class="ds-block">
          <div class="ds-block-head"><h3>SearchOverlay</h3><code>&lt;SearchOverlay id placeholder items /&gt;</code></div>
          <div class="ds-card">
            <p class="ds-variant-label mono" style="margin-bottom:14px">Click the trigger or press ⌘K / Ctrl-K — then type to filter.</p>
            <SearchOverlay
              id="ds-search"
              items={[
                { t:'How to Win the Buy Box', cat:'STRATEGY', href:'#' },
                { t:'What is a Price Index?', cat:'FUNDAMENTALS', href:'#' },
                { t:'MAP Compliance Playbook', cat:'MAP', href:'#' },
                { t:'Integrating with Shopify', cat:'DOCS', href:'#' },
                { t:'Dynamic Pricing Rules', cat:'STRATEGY', href:'#' },
              ]}
            />

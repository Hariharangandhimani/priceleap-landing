import CaseStudyCard  from '@/components/ds/social/CaseStudyCard.astro';
import ReviewCard     from '@/components/ds/social/ReviewCard.astro';
// CTA
import CTA            from '@/components/ds/cta/CTA.astro';
import NewsletterCTA  from '@/components/ds/cta/NewsletterCTA.astro';
import FloatingCTA    from '@/components/ds/cta/FloatingCTA.astro';
// FAQ
import FAQ            from '@/components/ds/faq/FAQ.astro';
// Forms
import LeadForm       from '@/components/ds/forms/LeadForm.astro';
import MultiStepForm  from '@/components/ds/forms/MultiStepForm.astro';
import ContactForm    from '@/components/ds/forms/ContactForm.astro';
// Blog
import BlogCard       from '@/components/ds/blog/BlogCard.astro';
import ShareBar       from '@/components/ds/blog/ShareBar.astro';
import RelatedResources from '@/components/ds/blog/RelatedResources.astro';
import ArticleMeta    from '@/components/ds/blog/ArticleMeta.astro';
import AuthorCard     from '@/components/ds/blog/AuthorCard.astro';
import BlogGrid       from '@/components/ds/blog/BlogGrid.astro';
import ReadingProgress from '@/components/ds/blog/ReadingProgress.astro';
// Overlays
import Modal          from '@/components/ds/overlay/Modal.astro';
import Drawer         from '@/components/ds/overlay/Drawer.astro';
import CookieConsent  from '@/components/ds/overlay/CookieConsent.astro';
import ExitIntent     from '@/components/ds/overlay/ExitIntent.astro';
// Carousel
import Carousel       from '@/components/ds/carousel/Carousel.astro';

// ── Sample data ──
const navSections = [
  { id:'tokens',       n:'01', label:'Design Tokens' },
  { id:'ui',           n:'02', label:'UI Primitives' },
  { id:'nav',          n:'03', label:'Navigation' },
  { id:'content',      n:'04', label:'Content Blocks' },
  { id:'social',       n:'05', label:'Social & Proof' },
  { id:'cta',          n:'06', label:'CTAs' },
  { id:'faq',          n:'07', label:'FAQ' },
  { id:'forms',        n:'08', label:'Forms' },
  { id:'blog',         n:'09', label:'Blog' },
  { id:'overlays',     n:'10', label:'Overlays' },
  { id:'carousel',     n:'11', label:'Carousel' },
  { id:'typography',   n:'12', label:'Typography' },
  { id:'motion',       n:'13', label:'Motion' },
];

const sampleTestimonials = [
  { initials:'DM', role:'Head of Pricing', industry:'Consumer Electronics', stat:'+28%', statLabel:'REVENUE LIFT · Q1',
    quote:'PriceLeap gave us competitor data we finally trust. We stopped guessing and started winning on margin.' },
  { initials:'SR', role:'Category Manager', industry:'Marketplace Seller', stat:'90%+', statLabel:'BUY BOX WIN RATE',
    quote:'The accuracy is genuinely different. Human QC on every match means we can automate without fear.' },
  { initials:'AK', role:'VP Commerce', industry:'D2C Brand', stat:'80%', statLabel:'TIME SAVED ON CHECKS',
    quote:'Setup took a week. Our pricing team now acts on live data instead of spreadsheets.' },
];

const sampleLogos = [
  { src:'/assets/logos/shopify.svg', alt:'Shopify' },
  { src:'/assets/logos/amazon.svg',  alt:'Amazon' },
  { src:'/assets/logos/flipkart.svg',alt:'Flipkart' },
  { src:'/assets/logos/slack.svg',   alt:'Slack' },
  { src:'/assets/logos/snowflake.svg',alt:'Snowflake' },
  { src:'/assets/logos/salesforce.svg',alt:'Salesforce' },
  { src:'/assets/logos/databricks.svg',alt:'Databricks' },
  { src:'/assets/logos/googlesheets.svg',alt:'Google Sheets' },
];

const sampleFaqs = [
  { q:'How accurate is the competitor price data?', a:'Every match passes four verification steps: AI matching, human QC review, anomaly detection, and a contractual SLA. Less than [PLACEHOLDER] matches is a false positive.' },
  { q:'How quickly can I go live?', a:'Most customers are live within 5 days. Step 1: upload your catalog. Step 2: we match and verify competitors. Step 3: you set pricing rules. Step 4: act on live intelligence.' },
  { q:'Which marketplaces do you support?', a:'Amazon, Flipkart, Walmart, Shopify, WooCommerce, BigCommerce, Magento, eBay, Etsy, Target Plus and 20+ more. Custom sources available on Enterprise plans.' },
  { q:'Is there a free trial?', a:'Yes — 14-day free trial, no credit card required. You get 300 products/month, 3 competitors per SKU, and daily refresh.', cat:'Pricing' },
  { q:'What does the Enterprise plan include?', a:'Up to 30,000 products/month, 10x daily refresh, dedicated success manager, 99.95% uptime SLA, SSO, and custom rule logic.', cat:'Pricing' },

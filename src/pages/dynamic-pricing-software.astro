---
// Native Astro port of the design package's Dynamic Pricing Software page.
// Static initial render + two animation loops and interactions reimplemented in
// vanilla JS: hero "why this price" signal cycle + decision approve/override, CTA
// stack cycle (1600ms); auto-advancing How-it-works step tabs (240ms) with three
// swapping panels (elasticity table, scenario forecast toggle, guardrails + threshold
// slider → auto/review); FAQ. Uses design tokens + real brand-logo marquee.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const sigData = [['Competitor moved', '−4.0%', 'var(--pl-danger-ink)'], ['Demand elasticity', 'Low', 'var(--pl-ink)'], ['Stock on hand', '142u', 'var(--pl-ink)'], ['Margin floor', '32% ✓', 'var(--pl-accent-ink)']].map(([k, v, c]) => ({ k, v, c }));
const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logoLoop = [...brandLogos, ...brandLogos];
const latency = [['Competitor moves', 'OVERNIGHT'], ['Exported', 'DAY 1'], ['Modeled', 'DAY 2'], ['Debated', 'DAY 3'], ['Signed off', 'TOO LATE']].map(([t, d], i) => ({ t, d, n: '0' + (i + 1), bc: i === 4 ? 'var(--pl-danger)' : i === 0 ? 'var(--pl-ink)' : 'var(--pl-line-xstrong)', c: i === 4 ? 'var(--pl-danger-ink)' : 'var(--pl-ink-2)' }));
const problems = [
  { n: '01', tag: 'TOO SLOW', t: "A competitor repositions a category overnight. By the time it's exported, modeled, debated, and signed off, the window has closed — on revenue or on margin." },
  { n: '02', tag: 'NO JUDGMENT', t: "Rules-based repricing buys speed but not judgment. It matches a rival blindly, even when matching gives away margin you didn't need to lose." },
  { n: '03', tag: "DOESN'T SCALE", t: "Across tens of thousands of SKUs and multiple channels, the manual route doesn't scale — and the rules route can't be defended to finance." },
];
const stepData = [
  { t: 'Decision modeling', short: 'Model', b1: 'Models demand and price elasticity across the full catalog, not just competitor-match rules.', b2: "Flags where you're underpricing winners and leaving margin on slow movers." },
  { t: 'Impact forecasting', short: 'Forecast', b1: 'Projects the effect on revenue and margin before a price goes live.', b2: 'Compares scenarios side by side — match the competitor versus hold and protect margin.' },
  { t: 'Guardrails and control', short: 'Control', b1: 'Set margin floors, MAP limits, and rounding rules once; the engine honors them on every decision.', b2: 'Auto-approve safe moves, route risky ones to a human — you set the threshold.' },
];
const elastic = [['Aeris Headphones', 'Low', 'Underpriced', '+ Raise'], ['Volt Charger 65W', 'High', 'At market', 'Hold'], ['Lumen Desk Lamp', 'Med', 'Slow mover', '− Trim'], ['Nimbus Speaker', 'Low', 'Underpriced', '+ Raise']].map(([n, el, pos, flag], i) => {
  const lvl = el === 'Low' ? 1 : el === 'Med' ? 2 : 3;
  const f = flag.startsWith('+') ? ['var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)'] : flag.startsWith('−') ? ['var(--pl-warn-tint)', 'var(--pl-warn-line)', 'var(--pl-warn-ink)'] : ['var(--pl-sand)', 'var(--pl-line)', 'var(--pl-ink-2)'];
  return { n, el, pos, flag, dl: (i * 0.1).toFixed(1), b1: 'var(--pl-accent)', b2: lvl >= 2 ? 'var(--pl-accent)' : 'var(--pl-line)', b3: lvl >= 3 ? 'var(--pl-accent)' : 'var(--pl-line)', fbg: f[0], fbc: f[1], fc: f[2] };
});
const mkBar = (k: string, v: number) => { const w = Math.min(48, Math.abs(v) * 9); return { k, v: (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%', w, l: v < 0 ? 50 - w : 50, o: v < 0 ? 'right' : 'left', c: v < 0 ? 'var(--pl-danger)' : 'var(--pl-accent)', tc: v < 0 ? 'var(--pl-danger-ink)' : 'var(--pl-accent-ink)' }; };
const scenarios = {
  hold: { price: '$27.49', tag: '★ Recommended', tagBg: 'var(--pl-accent)', tagBc: 'var(--pl-accent)', tagC: 'var(--pl-ink)', bars: [mkBar('Revenue', 1.1), mkBar('Margin', 4.2), mkBar('Units', -0.5)], note: 'Demand here is inelastic — holding keeps margin with negligible volume loss. The defensible call.', noteBg: 'var(--pl-accent-tint)' },
  match: { price: '$28.79', tag: 'Matches rival', tagBg: 'var(--pl-sand)', tagBc: 'var(--pl-line)', tagC: 'var(--pl-ink-2)', bars: [mkBar('Revenue', -0.6), mkBar('Margin', -3.1), mkBar('Units', 0.8)], note: 'Sample scenario: matching buys a little volume but gives away margin that inelastic demand did not require.', noteBg: 'var(--pl-danger-tint)' },
};
const moveData = [['Aeris Headphones', -2.1], ['Volt Charger 65W', 3.4], ['Lumen Desk Lamp', -7.5], ['Nimbus Speaker', 11.2]] as [string, number][];
const ctaD = [['Aeris Wireless Headphones', 'Online · US', '$27.49', 'Hold'], ['Volt Charger 65W', 'Marketplace', '$34.99', 'Auto'], ['Lumen Desk Lamp', 'Store · North', '$41.49', 'Review'], ['Nimbus Speaker', 'Online · EU', '€59.99', 'Raise']].map(([n, ch, p, st]) => ({ n, ch, p, s: st, tbg: st === 'Review' ? 'var(--pl-warn-tint)' : 'var(--pl-accent-tint)', tc: st === 'Review' ? 'var(--pl-warn-ink)' : 'var(--pl-accent-ink)' }));
const faqData = [
  ['What is dynamic pricing software?', 'Software that adjusts prices automatically based on demand, competition, stock, and cost — and, here, forecasts the impact before any change is applied.'],
  ['Is this just a repricer?', 'No. A repricer reacts to a rule; the Price Decision Engine recommends a priced decision with predicted outcomes and keeps a human in the loop.'],
  ['Will it replace my pricing team?', 'It removes the manual grind, not the judgment. Your team sets strategy and guardrails; the engine does the heavy lifting at scale.'],
  ['How does it handle MAP and margin floors?', 'As hard guardrails — the engine never recommends a price that breaks them.'],
  ['How is it priced?', "Pricing depends on catalog size, channels, and rollout scope. Book a demo and we'll scope it with you."],
].map(([q, a], i) => ({ q, a, n: '0' + (i + 1) }));
const fiveSig = ['demand', 'rivals', 'stock', 'cost', 'floor'];
---
<PriceLeapLayout
  title="Dynamic Pricing Software · Price Decision Engine · PriceLeap"
  description="Set the right price for every SKU across every channel automatically — with the reasoning visible before anything changes. The Price Decision Engine turns market signals into priced decisions."
>
  <div class="dp">
    <!-- HERO -->
    <section id="top" style="position:relative;border-bottom:1px solid var(--pl-line);overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px);background-size:48px 48px;-webkit-mask-image:radial-gradient(ellipse 60% 80% at 78% 40%,#000 10%,transparent 70%);mask-image:radial-gradient(ellipse 60% 80% at 78% 40%,#000 10%,transparent 70%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-4%;top:6%;width:700px;height:640px;background:radial-gradient(closest-side,rgba(247,99,30,.15),transparent);pointer-events:none"></div>
      <div class="dp-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,40px) clamp(56px,6vw,88px);gap:clamp(40px,5vw,64px);align-items:center">
        <div style="min-width:0">
          <span style="height:30px;padding:0 12px;display:inline-flex;align-items:center;gap:8px;border-radius:999px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient);transform:rotate(45deg)"></span>Price Decision Engine</span>
          <h1 style="margin:22px 0 0;font-family:Geist,sans-serif;font-size:clamp(42px,6vw,80px);line-height:.98;letter-spacing:-.05em;color:var(--pl-ink)"><span style="font-weight:400">Dynamic</span><br><span style="font-weight:700">Pricing Software</span></h1>
          <p style="margin:24px 0 0;max-width:560px;font-size:18px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">Set the right price for every SKU, across every store and channel — automatically, and with the reasoning visible before anything changes. The Price Decision Engine turns market signals into priced decisions your team can stand behind.</p>
          <div style="margin-top:30px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Get a Demo</a>
            <a href="/contact" style="height:48px;padding:0 18px;display:inline-flex;align-items:center;gap:10px;border-radius:12px;color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">Talk to a pricing expert<span style="color:var(--pl-accent-ink)">→</span></a>
          </div>
        </div>

        <div style="position:relative;min-width:0">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:22px;box-shadow:0 40px 80px -40px rgba(60,30,15,.3),0 0 0 6px rgba(255,255,255,.7);overflow:hidden">
            <div style="display:flex;align-items:center;gap:10px;padding:12px 18px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)">
              <span style="width:22px;height:22px;border-radius:6px;background:var(--pl-ink);display:flex;align-items:center;justify-content:center"><span style="width:8px;height:8px;border-radius:2px;background:var(--pl-gradient);transform:rotate(45deg)"></span></span>
              <span style="font-size:13px;font-weight:600;color:var(--pl-ink)">Price Decision Engine</span>
              <span style="margin-left:auto;display:flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:999px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span>LIVE</span>
            </div>
            <div style="padding:18px;display:flex;align-items:center;gap:14px;border-bottom:1px solid var(--pl-line-soft)">
              <span style="width:48px;height:48px;flex:none;border-radius:12px;border:1px dashed var(--pl-line-xstrong);background:repeating-linear-gradient(135deg,var(--pl-sand) 0 5px,var(--pl-cream) 5px 10px)"></span>
              <div style="min-width:0;flex:1"><div style="font-size:15px;font-weight:600;color:var(--pl-ink)">Aeris Wireless Headphones</div><div style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-faint)">SKU 48201 · Audio</div></div>
              <div style="position:relative;width:58px;height:58px;flex:none">
                <svg viewBox="0 0 58 58" style="width:100%;height:100%;transform:rotate(-90deg)"><circle cx="29" cy="29" r="24" fill="none" stroke="#F5ECE5" stroke-width="5"></circle><circle cx="29" cy="29" r="24" fill="none" stroke="#F7631E" stroke-width="5" stroke-linecap="round" stroke-dasharray="150.8" stroke-dashoffset="12.1" style="--c:150.8;animation:pi-ring 1.6s cubic-bezier(.2,.7,.2,1) both"></circle></svg>
                <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:12px;font-weight:500;color:var(--pl-ink)">92%</span>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:minmax(0,1fr) 40px minmax(0,1.2fr);align-items:center;padding:18px;gap:6px">
              <div><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">LIST PRICE</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:24px;font-weight:500;letter-spacing:-.03em;color:var(--pl-faint);text-decoration:line-through">$29.99</div></div>
              <span style="height:2px;background:repeating-linear-gradient(90deg,var(--pl-accent) 0 5px,transparent 5px 10px);background-size:20px 2px;animation:pi-dashx .8s linear infinite"></span>
              <div style="background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);border-radius:14px;padding:10px 14px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)">RECOMMENDED PRICE</div><div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap"><span data-dp-price style="font-family:Geist,sans-serif;font-size:34px;font-weight:600;letter-spacing:-.04em;color:var(--pl-ink)">$27.49</span><span style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-accent-ink)">92% confidence</span></div></div>
            </div>
            <div style="padding:0 18px 16px">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px"><span style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;background:var(--pl-ink);color:var(--pl-surface);font-family:'Geist Mono',monospace;font-size:10.5px">Hold &amp; protect margin</span><span style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-faint)">90-DAY FORECAST</span></div>
              <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px">
                <div style="border:1px solid var(--pl-line-soft);border-radius:11px;padding:10px 12px"><div style="font-size:11.5px;color:var(--pl-muted)">Revenue</div><div style="font-family:'Geist Mono',monospace;font-size:16px;color:var(--pl-accent-ink)">+1.1%</div></div>
                <div style="border:1px solid var(--pl-accent-line);background:var(--pl-cream);border-radius:11px;padding:10px 12px"><div style="font-size:11.5px;color:var(--pl-muted)">Margin</div><div style="font-family:'Geist Mono',monospace;font-size:16px;color:var(--pl-accent-ink)">+4.2%</div></div>
                <div style="border:1px solid var(--pl-line-soft);border-radius:11px;padding:10px 12px"><div style="font-size:11.5px;color:var(--pl-muted)">Units</div><div style="font-family:'Geist Mono',monospace;font-size:16px;color:var(--pl-danger-ink)">−0.5%</div></div>
              </div>
            </div>
            <div style="border-top:1px solid var(--pl-line-soft);padding:14px 18px;background:var(--pl-cream)">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><span style="font-size:13px;font-weight:600;color:var(--pl-ink)">Why this price</span><span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-muted)">4 signals weighed</span></div>
              <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px">
                {sigData.map((g, i) => (
                  <div class="dp-sig" data-dp-sig={i} style="display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 10px;border-radius:9px;background:var(--pl-surface);border:1px solid var(--pl-line-soft);transition:border-color .3s,box-shadow .3s"><span style="font-size:12px;color:var(--pl-ink-2)">{g.k}</span><span style={`font-family:'Geist Mono',monospace;font-size:11.5px;color:${g.c}`}>{g.v}</span></div>
                ))}
              </div>
            </div>
            <div style="border-top:1px solid var(--pl-line-soft);padding:12px 18px;display:flex;gap:8px;align-items:center">
              <div data-dp-decide style="display:flex;gap:8px;align-items:center;width:100%">
                <button type="button" data-dp-approve style="flex:1;height:42px;border:none;border-radius:11px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:14px;cursor:pointer">Approve</button>
                <button type="button" data-dp-override style="flex:1;height:42px;border:1px solid var(--pl-line);border-radius:11px;background:var(--pl-surface);color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:14px;cursor:pointer">Override</button>
              </div>
              <div data-dp-approved hidden style="gap:8px;align-items:center;width:100%">
                <div style="flex:1;height:42px;border-radius:11px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);display:flex;align-items:center;justify-content:center;gap:8px;font-size:14px;color:var(--pl-accent-ink);animation:pi-pop .35s ease"><span style="width:18px;height:18px;border-radius:50%;background:var(--pl-gradient);color:var(--pl-surface);font-size:10px;display:flex;align-items:center;justify-content:center">✓</span><span data-dp-msg>Approved · $27.49 goes live</span></div>
                <button type="button" data-dp-reset aria-label="Reset" style="width:42px;height:42px;border:1px solid var(--pl-line);border-radius:11px;background:var(--pl-surface);cursor:pointer;color:var(--pl-muted)">↺</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGOS -->
    <section style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div class="dp-logo" style="max-width:1280px;margin:0 auto">
        <div class="dp-logolabel" style="padding:22px clamp(20px,4vw,40px);display:flex;align-items:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-muted)">Trusted by teams at</div>
        <div style="overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)">
          <div style="display:flex;width:max-content;animation:pi-marquee 32s linear infinite">
            {logoLoop.map((n) => (<div style="flex:none;width:188px;height:104px;display:flex;align-items:center;justify-content:center;border-right:1px solid var(--pl-line-soft)"><img src={`/assets/logos/${n}.svg`} alt={n} loading="lazy" style="height:50px;max-width:168px;width:auto;object-fit:contain"></div>))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section id="problem" style="border-bottom:1px solid var(--pl-line)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="max-width:900px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-danger-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-danger)"></span>The problem</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">At enterprise scale, </span><span style="font-weight:700">prices move faster than your team can decide</span></h2>
        </div>
        <div data-reveal style="margin-top:44px;background:var(--pl-cream);border:1px solid var(--pl-line);border-radius:22px;padding:clamp(20px,3vw,32px)">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:22px"><span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:var(--pl-muted)">THE MANUAL ROUTE · ONE CATEGORY MOVE</span><span style="display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-danger-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-danger);animation:pi-blink 1s steps(1) infinite"></span>WINDOW CLOSING</span></div>
          <div style="position:relative">
            <div style="height:34px;border-radius:9px;background:var(--pl-surface);border:1px solid var(--pl-line);overflow:hidden;position:relative">
              <span style="position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,var(--pl-accent-line),var(--pl-accent-tint));animation:pi-close 7s linear infinite"></span>
              <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-accent-ink)">REVENUE &amp; MARGIN WINDOW</span>
            </div>
            <div style="position:relative;margin-top:22px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px">
              <span aria-hidden="true" style="position:absolute;left:10%;right:10%;top:15px;height:2px;background:var(--pl-line)"></span>
              <span aria-hidden="true" style="position:absolute;left:10%;right:10%;top:11px;height:10px;pointer-events:none"><span style="position:absolute;top:0;width:10px;height:10px;margin-left:-5px;border-radius:50%;background:var(--pl-danger);box-shadow:0 0 0 4px rgba(229,72,63,.18);animation:pi-walk 7s linear infinite"></span></span>
              {latency.map((l) => (
                <div style="position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center">
                  <span style={`width:32px;height:32px;border-radius:50%;background:var(--pl-surface);border:1.5px solid ${l.bc};font-family:'Geist Mono',monospace;font-size:10px;color:${l.c};display:flex;align-items:center;justify-content:center`}>{l.n}</span>
                  <span style="font-size:13px;font-weight:500;color:var(--pl-ink)">{l.t}</span>
                  <span style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-faint)">{l.d}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div data-reveal style="margin-top:16px;border:1px solid var(--pl-line);border-radius:22px;overflow:hidden;background:var(--pl-line);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1px">
          {problems.map((p) => (
            <div style="background:var(--pl-surface);padding:28px;display:flex;flex-direction:column;gap:14px">
              <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-danger-ink)">{p.n}</span><span style="height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;border:1px dashed var(--pl-danger-line);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.06em;color:var(--pl-danger-ink)">{p.tag}</span></div>
              <p style="margin:0;font-size:16px;line-height:1.6;color:var(--pl-ink);text-wrap:pretty">{p.t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section id="approach" style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div class="dp-split" style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:center">
        <div data-reveal>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>The approach</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:700">A priced decision,</span><span style="font-weight:400"> not just a price change</span></h2>
          <div style="margin-top:24px;display:flex;flex-direction:column;gap:16px;font-size:16px;line-height:1.65;color:var(--pl-ink-2)">
            <p style="margin:0">The Price Decision Engine weighs demand, competitor moves, stock, cost, and your margin floor — then recommends a price and its expected effect on revenue and margin.</p>
            <p style="margin:0">It's a decision you can see, challenge, and override before it goes live — not a rule firing in the dark.</p>
            <p style="margin:0;padding:14px 16px;border-radius:12px;background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink)">Control stays with your team: auto-approve inside the guardrails you set, or review only the edge cases.</p>
          </div>
        </div>
        <div data-reveal class="dp-appr" style="display:grid;gap:12px;align-items:stretch">
          <div style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column">
            <div style="padding:14px 16px;border-bottom:1px solid var(--pl-line-soft);display:flex;justify-content:space-between;align-items:center"><span style="font-size:14px;font-weight:600;color:var(--pl-muted)">Rules-based repricing</span><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-line-xstrong)"></span></div>
            <div style="padding:16px;font-family:'Geist Mono',monospace;font-size:12.5px;line-height:1.9;color:var(--pl-ink-2);background:var(--pl-cream);flex:1">
              <div><span style="color:var(--pl-faint)">IF</span> rival &lt; us <span style="color:var(--pl-faint)">→</span> match</div>
              <div>price = rival − $0.01</div>
              <div style="margin-top:14px;display:flex;align-items:flex-end;gap:5px;height:70px">
                <span style="flex:1;height:90%;border-radius:3px 3px 0 0;background:var(--pl-line-alt)"></span><span style="flex:1;height:78%;border-radius:3px 3px 0 0;background:var(--pl-line-alt)"></span><span style="flex:1;height:64%;border-radius:3px 3px 0 0;background:var(--pl-danger-line)"></span><span style="flex:1;height:50%;border-radius:3px 3px 0 0;background:var(--pl-danger-line)"></span><span style="flex:1;height:34%;border-radius:3px 3px 0 0;background:var(--pl-danger)"></span>
              </div>
            </div>
            <div style="padding:12px 16px;border-top:1px solid var(--pl-danger-line);background:var(--pl-danger-tint);display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--pl-danger-ink);animation:pi-shake 2.6s ease infinite">▼ Margin given away</div>
          </div>
          <div style="position:relative;background:var(--pl-surface);border:1.5px solid var(--pl-accent);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 0 0 6px rgba(247,99,30,.08),0 30px 60px -36px rgba(194,65,12,.5)">
            <div style="padding:14px 16px;border-bottom:1px solid var(--pl-accent-line);background:var(--pl-accent-tint);display:flex;justify-content:space-between;align-items:center"><span style="font-size:14px;font-weight:600;color:var(--pl-ink)">Decision-led pricing</span><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span></div>
            <div style="position:relative;padding:14px 16px 10px;flex:1">
              <div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">WEIGHS 5 SIGNALS</div>
              <div style="position:relative;margin-top:8px;height:96px">
                <svg viewBox="0 0 240 96" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%">
                  <path d="M0,10 C90,10 110,48 200,48" fill="none" stroke="#FFD8BE" stroke-width="1.5"></path><path d="M0,29 C90,29 110,48 200,48" fill="none" stroke="#FFD8BE" stroke-width="1.5"></path><path d="M0,48 L200,48" fill="none" stroke="#FFD8BE" stroke-width="1.5"></path><path d="M0,67 C90,67 110,48 200,48" fill="none" stroke="#FFD8BE" stroke-width="1.5"></path><path d="M0,86 C90,86 110,48 200,48" fill="none" stroke="#FFD8BE" stroke-width="1.5"></path>
                  <path d="M0,10 C90,10 110,48 200,48" fill="none" stroke="#F7631E" stroke-width="1.5" stroke-dasharray="4 16" style="animation:pi-dash 1s linear infinite"></path><path d="M0,48 L200,48" fill="none" stroke="#F7631E" stroke-width="1.5" stroke-dasharray="4 16" style="animation:pi-dash 1s linear infinite"></path><path d="M0,86 C90,86 110,48 200,48" fill="none" stroke="#F7631E" stroke-width="1.5" stroke-dasharray="4 16" style="animation:pi-dash 1s linear infinite"></path>
                </svg>
                <div style="position:absolute;left:0;top:0;bottom:0;display:flex;flex-direction:column;justify-content:space-between">
                  {fiveSig.map((f) => (<span style="height:16px;padding:0 6px;display:flex;align-items:center;border-radius:4px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:9px;color:var(--pl-ink-2)">{f}</span>))}
                </div>
                <span style="position:absolute;right:0;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:10px;background:var(--pl-gradient);display:flex;align-items:center;justify-content:center"><span style="width:10px;height:10px;border-radius:2px;background:var(--pl-ink);transform:rotate(45deg)"></span></span>
              </div>
              <div style="margin-top:10px;font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-muted)">demand · cost · stock</div>
              <div style="margin-top:12px;display:flex;align-items:baseline;justify-content:space-between;gap:8px"><span style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">RECOMMENDS</span><span style="font-family:Geist,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.03em;color:var(--pl-ink)">$27.49</span></div>
              <div style="text-align:right;font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--pl-accent-ink)">+4.2% margin</div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--pl-accent-line);border-top:1px solid var(--pl-accent-line)">
              <div style="background:var(--pl-cream);padding:10px 14px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-accent-ink)">FORECAST</div><div style="font-size:13px;font-weight:500;color:var(--pl-ink)">visible</div></div>
              <div style="background:var(--pl-cream);padding:10px 14px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-accent-ink)">OVERRIDE</div><div style="font-size:13px;font-weight:500;color:var(--pl-ink)">on demand</div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY A DECISION ENGINE -->
    <section id="why" style="border-bottom:1px solid var(--pl-line)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>Why a decision engine</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);max-width:860px;text-wrap:balance"><span style="font-weight:400">Why pricing teams choose a </span><span style="font-weight:700">decision engine over a repricer</span></h2>
        </div>
        <div data-reveal class="dp-quote" style="margin:40px auto 0;max-width:900px;border:1px solid var(--pl-line);border-radius:18px;overflow:hidden">
          <div style="padding:22px 26px;background:var(--pl-cream);display:flex;flex-direction:column;gap:6px"><span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:var(--pl-faint)">REPRICING</span><span style="font-family:Geist,sans-serif;font-size:20px;font-weight:500;color:var(--pl-muted)">tells you what changed.</span></div>
          <div class="dp-quote-r" style="padding:22px 26px;background:var(--pl-accent-tint);display:flex;flex-direction:column;gap:6px"><span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:var(--pl-accent-ink)">A DECISION ENGINE</span><span style="font-family:Geist,sans-serif;font-size:20px;font-weight:600;color:var(--pl-ink)">tells you what to do about it — and what happens if you do.</span></div>
        </div>
        <div data-reveal style="margin-top:40px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:16px">
          <div class="dp-whycard" style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s">
            <div style="height:150px;background:var(--pl-cream);border-bottom:1px solid var(--pl-line-soft);display:flex;align-items:center;justify-content:center;padding:18px">
              <svg viewBox="0 0 220 100" style="width:100%;max-width:240px;height:auto;overflow:visible"><line x1="0" y1="70" x2="110" y2="70" stroke="#1C130E" stroke-width="2.5"></line><path d="M110,70 C150,62 180,40 220,30" fill="none" stroke="#F7631E" stroke-width="2.5" stroke-dasharray="5 5" style="animation:pi-dash 1.2s linear infinite"></path><rect x="110" y="10" width="110" height="80" fill="#FFF4EC" opacity=".6"></rect><line x1="110" y1="6" x2="110" y2="94" stroke="#D7C6BA" stroke-dasharray="3 3"></line><text x="114" y="22" font-family="Geist Mono" font-size="9" fill="#C2410C">FORECAST</text><circle cx="220" cy="30" r="5" fill="#F7631E" stroke="#FFFFFF" stroke-width="2"></circle><text x="0" y="88" font-family="Geist Mono" font-size="9" fill="#7F7066">TODAY</text></svg>
            </div>
            <div style="padding:24px;display:flex;flex-direction:column;gap:8px"><h3 style="margin:0;font-family:Geist,sans-serif;font-size:19px;font-weight:600;color:var(--pl-ink)">It forecasts before it acts</h3><p style="margin:0;font-size:15px;line-height:1.6;color:var(--pl-muted)">Every recommendation carries a predicted revenue and margin outcome, so no change is a guess.</p></div>
          </div>
          <div class="dp-whycard" style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s">
            <div style="height:150px;background:var(--pl-cream);border-bottom:1px solid var(--pl-line-soft);display:flex;align-items:center;justify-content:center;padding:18px">
              <div style="position:relative;width:130px;height:110px">
                <span style="position:absolute;left:50%;top:50%;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:13px;background:var(--pl-gradient);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-surface)">$</span>
                <div style="position:absolute;inset:0;animation:pi-orbit 14s linear infinite">
                  <span style="position:absolute;left:50%;top:-4px;transform:translateX(-50%);height:20px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:9px;color:var(--pl-ink-2)">demand</span>
                  <span style="position:absolute;right:-18px;top:50%;transform:translateY(-50%);height:20px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:9px;color:var(--pl-ink-2)">stock</span>
                  <span style="position:absolute;left:50%;bottom:-4px;transform:translateX(-50%);height:20px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:9px;color:var(--pl-ink-2)">cost</span>
                  <span style="position:absolute;left:-22px;top:50%;transform:translateY(-50%);height:20px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:var(--pl-surface);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:9px;color:var(--pl-accent-ink)">rivals</span>
                </div>
              </div>
            </div>
            <div style="padding:24px;display:flex;flex-direction:column;gap:8px"><h3 style="margin:0;font-family:Geist,sans-serif;font-size:19px;font-weight:600;color:var(--pl-ink)">It weighs more than one rival</h3><p style="margin:0;font-size:15px;line-height:1.6;color:var(--pl-muted)">Price reflects demand, elasticity, stock, and cost together — not a single competitor's tag.</p></div>
          </div>
          <div class="dp-whycard" style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s">
            <div style="height:150px;background:var(--pl-cream);border-bottom:1px solid var(--pl-line-soft);display:flex;align-items:center;justify-content:center;padding:18px">
              <div style="width:100%;max-width:230px;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:12px;padding:10px 12px;box-shadow:0 14px 28px -20px rgba(60,30,15,.4)">
                <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-faint)"><span>TO: FINANCE</span><span style="color:var(--pl-accent-ink)">✓ EXPLAINED</span></div>
                <div style="margin-top:8px;display:flex;flex-direction:column;gap:5px">
                  <span style="height:6px;width:92%;border-radius:3px;background:var(--pl-line-soft)"></span><span style="height:6px;width:76%;border-radius:3px;background:var(--pl-line-soft)"></span>
                  <span style="margin-top:4px;height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:var(--pl-accent-tint);font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-accent-ink)">Inelastic · hold · +4.2% margin</span>
                </div>
              </div>
            </div>
            <div style="padding:24px;display:flex;flex-direction:column;gap:8px"><h3 style="margin:0;font-family:Geist,sans-serif;font-size:19px;font-weight:600;color:var(--pl-ink)">It's defensible</h3><p style="margin:0;font-size:15px;line-height:1.6;color:var(--pl-muted)">Each price shows its reasoning, so pricing managers can justify it to finance and merchandising on the spot.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (tabs + 3 panels) -->
    <section id="how" style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px 64px;align-items:end">
          <div>
            <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>How it works</span>
            <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">How the </span><span style="font-weight:700">Price Decision Engine</span><span style="font-weight:400"> works</span></h2>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:5px;border:1px solid var(--pl-line);border-radius:14px;background:var(--pl-surface)">
            {stepData.map((d, i) => (
              <button type="button" class="dp-tab" class:list={[{ 'is-on': i === 0 }]} data-dp-tab={i} style="position:relative;overflow:hidden;height:48px;border:none;border-radius:10px;cursor:pointer;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;transition:background .3s">
                <span class="dp-tab-n" style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:var(--pl-faint)">STEP 0{i + 1}</span>
                <span class="dp-tab-t" style="font-size:13px;font-weight:600;color:var(--pl-ink)"><span class="dp-tab-full">{d.t}</span><span class="dp-tab-short">{d.short}</span></span>
                <span class="dp-tab-bar" style="position:absolute;left:0;bottom:0;height:2px;width:0%;background:var(--pl-ink);opacity:.25"></span>
              </button>
            ))}
          </div>
        </div>

        <div data-reveal class="dp-how" style="margin-top:32px;border:1px solid var(--pl-line);border-radius:24px;overflow:hidden;background:var(--pl-line);gap:1px">
          <div style="background:var(--pl-surface);padding:clamp(24px,3.4vw,40px);display:flex;flex-direction:column;gap:18px">
            <span style="font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:var(--pl-accent-ink)">STEP <span data-dp-curn>01</span></span>
            <h3 data-dp-curt style="margin:0;font-family:Geist,sans-serif;font-size:clamp(28px,3.2vw,40px);font-weight:600;letter-spacing:-.03em;color:var(--pl-ink)">{stepData[0].t}</h3>
            <div style="display:flex;flex-direction:column;gap:12px">
              <span style="display:flex;gap:12px;font-size:16px;line-height:1.6;color:var(--pl-ink-2)"><span style="flex:none;margin-top:4px;width:18px;height:18px;border-radius:50%;background:var(--pl-gradient);color:var(--pl-surface);font-size:10px;display:flex;align-items:center;justify-content:center">✓</span><span data-dp-curb1>{stepData[0].b1}</span></span>
              <span style="display:flex;gap:12px;font-size:16px;line-height:1.6;color:var(--pl-ink-2)"><span style="flex:none;margin-top:4px;width:18px;height:18px;border-radius:50%;background:var(--pl-gradient);color:var(--pl-surface);font-size:10px;display:flex;align-items:center;justify-content:center">✓</span><span data-dp-curb2>{stepData[0].b2}</span></span>
            </div>
            <span data-dp-hint1 hidden style="font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--pl-muted)">↑ Toggle the scenarios in the panel.</span>
            <div data-dp-hint2 hidden style="margin-top:auto;padding:14px 16px;border-radius:12px;background:var(--pl-cream);border:1px solid var(--pl-line-soft);font-size:14px;line-height:1.55;color:var(--pl-ink-2)">Feeds in from <a href="/ecommerce-price-tracking" style="color:var(--pl-accent-ink);text-decoration:underline;text-underline-offset:3px">Competitor Price Tracking</a> and <a href="/real-time-price-monitoring" style="color:var(--pl-accent-ink);text-decoration:underline;text-underline-offset:3px">Real-Time Price Monitoring</a>.</div>
          </div>
          <div style="position:relative;background:var(--pl-cream);min-height:460px;display:flex;align-items:center;justify-content:center;padding:clamp(18px,3vw,36px);overflow:hidden">
            <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(var(--pl-line-alt) 1px,transparent 1px);background-size:18px 18px;-webkit-mask-image:radial-gradient(ellipse at 50% 50%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse at 50% 50%,#000 30%,transparent 80%)"></div>

            <!-- panel 0: elasticity -->
            <div class="dp-panel" data-dp-panel={0} style="position:relative;width:min(100%,560px);background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:18px;box-shadow:0 30px 60px -36px rgba(60,30,15,.35);overflow:hidden">
              <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--pl-line-soft)"><span style="font-size:14px;font-weight:600;color:var(--pl-ink)">Elasticity &amp; opportunity</span><span style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-muted)">12,480 SKUs</span></div>
              <div style="display:grid;grid-template-columns:minmax(0,1.5fr) 80px minmax(0,1fr) 84px;gap:10px;padding:10px 18px;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint);border-bottom:1px solid var(--pl-line-soft)"><span>SKU</span><span>ELASTICITY</span><span>POSITION</span><span style="text-align:right">FLAG</span></div>
              {elastic.map((e) => (
                <div style={`display:grid;grid-template-columns:minmax(0,1.5fr) 80px minmax(0,1fr) 84px;gap:10px;align-items:center;padding:13px 18px;border-bottom:1px solid var(--pl-sand);animation:pi-in .45s ease ${e.dl}s both`}>
                  <span style="font-size:13.5px;font-weight:500;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{e.n}</span>
                  <span style="display:flex;align-items:center;gap:6px"><span style="display:flex;gap:2px"><span style={`width:5px;height:12px;border-radius:2px;background:${e.b1}`}></span><span style={`width:5px;height:12px;border-radius:2px;background:${e.b2}`}></span><span style={`width:5px;height:12px;border-radius:2px;background:${e.b3}`}></span></span><span style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-ink-2)">{e.el}</span></span>
                  <span style="font-size:13px;color:var(--pl-muted)">{e.pos}</span>
                  <span style={`justify-self:end;height:24px;padding:0 9px;display:inline-flex;align-items:center;border-radius:6px;background:${e.fbg};border:1px solid ${e.fbc};font-family:'Geist Mono',monospace;font-size:10.5px;color:${e.fc};white-space:nowrap`}>{e.flag}</span>
                </div>
              ))}
            </div>

            <!-- panel 1: scenario forecast -->
            <div class="dp-panel" data-dp-panel={1} style="display:none;position:relative;width:min(100%,520px);background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:18px;box-shadow:0 30px 60px -36px rgba(60,30,15,.35);overflow:hidden">
              <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--pl-line-soft);flex-wrap:wrap;gap:8px"><span style="font-size:14px;font-weight:600;color:var(--pl-ink)">Forecast · before it goes live</span><span style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-muted)">90-day projection</span></div>
              <div style="padding:16px 18px 0">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;border:1px solid var(--pl-line);border-radius:12px;background:var(--pl-cream)">
                  <button type="button" class="dp-sc" data-dp-sc="match" style="height:40px;border:none;border-radius:9px;cursor:pointer;font-size:13.5px;font-weight:500;background:transparent;color:var(--pl-ink);transition:all .25s">Match competitor</button>
                  <button type="button" class="dp-sc is-on" data-dp-sc="hold" style="height:40px;border:none;border-radius:9px;cursor:pointer;font-size:13.5px;font-weight:500;background:var(--pl-accent);color:var(--pl-ink);transition:all .25s">Hold &amp; protect margin</button>
                </div>
              </div>
              <div data-dp-scbody style="padding:18px;display:flex;flex-direction:column;gap:14px;animation:pi-in .35s ease">
                <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:10px">
                  <div><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">RESULTING PRICE</div><div data-dp-scprice style="font-family:Geist,sans-serif;font-size:36px;font-weight:600;letter-spacing:-.04em;color:var(--pl-ink)">{scenarios.hold.price}</div></div>
                  <span data-dp-sctag style={`height:26px;padding:0 10px;display:flex;align-items:center;border-radius:7px;background:${scenarios.hold.tagBg};border:1px solid ${scenarios.hold.tagBc};font-family:'Geist Mono',monospace;font-size:11px;color:${scenarios.hold.tagC}`}>{scenarios.hold.tag}</span>
                </div>
                <div data-dp-scbars style="display:flex;flex-direction:column;gap:14px">
                  {scenarios.hold.bars.map((b) => (
                    <div style="display:grid;grid-template-columns:70px minmax(0,1fr) 60px;gap:10px;align-items:center">
                      <span style="font-size:13px;color:var(--pl-ink-2)">{b.k}</span>
                      <span style="position:relative;height:12px;border-radius:6px;background:var(--pl-sand)"><span style="position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--pl-line-xstrong)"></span><span style={`position:absolute;top:0;bottom:0;left:${b.l}%;width:${b.w}%;border-radius:6px;background:${b.c};transform-origin:${b.o};animation:pi-grow .7s cubic-bezier(.2,.7,.2,1) both`}></span></span>
                      <span style={`text-align:right;font-family:'Geist Mono',monospace;font-size:13px;color:${b.tc}`}>{b.v}</span>
                    </div>
                  ))}
                </div>
                <p data-dp-scnote style={`margin:0;padding:12px 14px;border-radius:11px;background:${scenarios.hold.noteBg};font-size:13.5px;line-height:1.55;color:var(--pl-ink)`}>{scenarios.hold.note}</p>
              </div>
            </div>

            <!-- panel 2: guardrails + threshold -->
            <div class="dp-panel" data-dp-panel={2} style="display:none;position:relative;width:min(100%,520px);flex-direction:column;gap:12px">
              <div style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:18px;box-shadow:0 30px 60px -36px rgba(60,30,15,.35);overflow:hidden">
                <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--pl-line-soft)"><span style="font-size:14px;font-weight:600;color:var(--pl-ink)">Guardrails</span><span style="height:22px;padding:0 8px;display:flex;align-items:center;gap:6px;border-radius:6px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-accent-ink)">✓ Saved</span></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--pl-line-soft)">
                  <div style="background:var(--pl-surface);padding:14px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">MARGIN FLOOR</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:22px;font-weight:600;color:var(--pl-ink)">32%</div></div>
                  <div style="background:var(--pl-surface);padding:14px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">MAP LIMIT</div><div style="margin-top:4px;display:flex;align-items:center;gap:6px;font-family:Geist,sans-serif;font-size:18px;font-weight:600;color:var(--pl-accent-ink)"><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-gradient)"></span>Enforced</div></div>
                  <div style="background:var(--pl-surface);padding:14px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">ROUNDING RULE</div><div style="margin-top:4px;font-family:'Geist Mono',monospace;font-size:18px;color:var(--pl-ink)">.49 / .99</div></div>
                  <div style="background:var(--pl-surface);padding:14px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">AUTO-APPROVE THRESHOLD</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:22px;font-weight:600;color:var(--pl-ink)">±<span data-dp-thr>5</span>%</div></div>
                </div>
                <div style="padding:14px 18px;border-top:1px solid var(--pl-line-soft)"><input type="range" min="1" max="15" value="5" data-dp-thrrange aria-label="Auto-approve threshold" style="width:100%"></div>
              </div>
              <div style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:18px;padding:14px 16px;display:flex;flex-direction:column;gap:8px">
                {moveData.map(([n, d], i) => (
                  <div class="dp-move" data-dp-move={i} data-d={d} style="display:grid;grid-template-columns:minmax(0,1fr) 64px auto;gap:10px;align-items:center;padding:8px 10px;border-radius:10px;background:var(--pl-cream);transition:background .3s">
                    <span style="font-size:12.5px;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{n}</span>
                    <span style="font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink-2);text-align:right">{(d > 0 ? '+' : '−') + Math.abs(d).toFixed(1) + '%'}</span>
                    <span class="dp-move-tag" style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;border:1px solid;font-family:'Geist Mono',monospace;font-size:10.5px;white-space:nowrap;transition:all .3s"></span>
                  </div>
                ))}
                <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-muted);padding:4px 2px 0"><span style="color:var(--pl-accent-ink)">Safe → auto</span><span style="color:var(--pl-warn-ink)">Risky → review</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- OUTCOME -->
    <section id="outcome" style="border-bottom:1px solid var(--pl-line)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>The outcome</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);max-width:820px;text-wrap:balance"><span style="font-weight:400">What changes when pricing </span><span style="font-weight:700">becomes a decision</span></h2>
        </div>
        <div data-reveal class="dp-out" style="margin-top:48px;border:1px solid var(--pl-line);border-radius:24px;overflow:hidden;background:var(--pl-line);gap:1px">
          <div style="background:var(--pl-surface);padding:clamp(28px,4vw,44px);display:flex;flex-direction:column;gap:10px">
            <span style="font-family:Geist,sans-serif;font-size:clamp(56px,7vw,96px);font-weight:600;letter-spacing:-.06em;line-height:.95;color:var(--pl-ink)">2–5<span style="color:var(--pl-accent)">%</span></span>
            <span style="font-size:17px;color:var(--pl-ink-2)">sales growth</span>
            <span style="height:6px;border-radius:6px;background:var(--pl-line-soft);overflow:hidden"><span style="display:block;height:100%;width:50%;border-radius:6px;background:var(--pl-gradient);transform-origin:left;animation:pi-grow 1.4s cubic-bezier(.2,.7,.2,1) both"></span></span>
          </div>
          <div style="background:var(--pl-surface);padding:clamp(28px,4vw,44px);display:flex;flex-direction:column;gap:10px">
            <span style="font-family:Geist,sans-serif;font-size:clamp(56px,7vw,96px);font-weight:600;letter-spacing:-.06em;line-height:.95;color:var(--pl-ink)">5–10<span style="color:var(--pl-accent)">%</span></span>
            <span style="font-size:17px;color:var(--pl-ink-2)">margin improvement</span>
            <span style="height:6px;border-radius:6px;background:var(--pl-line-soft);overflow:hidden"><span style="display:block;height:100%;width:100%;border-radius:6px;background:var(--pl-gradient);transform-origin:left;animation:pi-grow 1.6s cubic-bezier(.2,.7,.2,1) .15s both"></span></span>
          </div>
          <div style="background:var(--pl-cream);padding:clamp(28px,4vw,44px);display:flex;flex-direction:column;gap:10px">
            <span style="align-self:flex-start;height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;border:1px dashed var(--pl-warn-line);background:var(--pl-warn-tint);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.06em;color:var(--pl-warn-ink)">[ VERIFY STAT ]</span>
            <span style="font-family:Geist,sans-serif;font-size:clamp(48px,6vw,80px);font-weight:600;letter-spacing:-.06em;line-height:.95;color:var(--pl-line-xstrong)">~X%</span>
            <span style="font-size:15px;color:var(--pl-muted)">e.g. manual pricing effort reduced by ~X%.</span>
            <span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-warn-ink)">— confirm before publish</span>
          </div>
        </div>
        <div style="margin-top:12px;font-size:13px;color:var(--pl-muted)">Retailers using dynamic pricing typically see these gains. <span style="font-family:'Geist Mono',monospace;font-size:11.5px;color:var(--pl-faint)">(McKinsey &amp; Company)</span></div>

        <div data-reveal class="dp-proof" style="margin-top:40px;gap:16px">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:22px;padding:clamp(24px,3.6vw,40px);display:flex;flex-direction:column;gap:18px;overflow:hidden">
            <span aria-hidden="true" style="position:absolute;right:-10px;top:-50px;font-family:Geist,sans-serif;font-size:220px;font-weight:700;line-height:1;color:var(--pl-accent-tint)">“</span>
            <span style="position:relative;align-self:flex-start;height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;border:1px dashed var(--pl-line-xstrong);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.06em;color:var(--pl-muted)">[ TESTIMONIAL ]</span>
            <p style="position:relative;margin:0;font-family:Geist,sans-serif;font-size:clamp(20px,2.2vw,26px);font-weight:500;line-height:1.4;letter-spacing:-.015em;color:var(--pl-ink);text-wrap:pretty">“ Quote goes here — the pricing team's words on what changed once decisions, not rules, drove price. ”</p>
            <div style="position:relative;margin-top:auto;display:flex;align-items:center;gap:12px">
              <span style="width:44px;height:44px;border-radius:50%;border:1px dashed var(--pl-line-xstrong);background:repeating-linear-gradient(135deg,var(--pl-sand) 0 5px,var(--pl-cream) 5px 10px)"></span>
              <span><span style="display:block;font-size:14px;font-weight:600;color:var(--pl-ink)">Name</span><span style="font-size:13px;color:var(--pl-muted)">Role · Company</span></span>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:16px">
            <a href="#" style="flex:1;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;color:var(--pl-ink)">
              <div style="height:120px;border-bottom:1px dashed var(--pl-line-xstrong);background:repeating-linear-gradient(135deg,var(--pl-sand) 0 8px,var(--pl-cream) 8px 16px);display:flex;align-items:center;justify-content:center;gap:8px"><span style="height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-muted)">[ CASE STUDY ]</span><span style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-faint)">thumbnail</span></div>
              <div style="padding:20px;display:flex;flex-direction:column;gap:10px"><span style="font-family:Geist,sans-serif;font-size:17px;font-weight:600;line-height:1.35">How [retailer] recovered X margin points across Y SKUs in 90 days</span><span style="font-size:14px;font-weight:500;color:var(--pl-accent-ink)">Read the case study →</span></div>
            </a>
            <div style="height:96px;border-radius:18px;border:1px dashed var(--pl-line-xstrong);background:var(--pl-cream);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:var(--pl-muted)">[ LOGO WALL ]</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA (stack cycle) -->
    <section id="demo" style="padding:clamp(20px,3vw,28px);border-bottom:1px solid var(--pl-line)">
      <div class="dp-cta" style="position:relative;max-width:1280px;margin:0 auto;overflow:hidden;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:28px;padding:clamp(56px,8vw,96px) clamp(20px,4vw,48px);gap:clamp(32px,5vw,64px);align-items:center">
        <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(ellipse 60% 80% at 80% 50%,#000 10%,transparent 75%);mask-image:radial-gradient(ellipse 60% 80% at 80% 50%,#000 10%,transparent 75%)"></div>
        <div aria-hidden="true" style="position:absolute;right:-120px;bottom:-200px;width:620px;height:420px;background:radial-gradient(closest-side,rgba(247,99,30,.18),transparent)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;gap:20px">
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(32px,4.4vw,56px);line-height:1.04;letter-spacing:-.045em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">See the Price Decision Engine </span><span style="font-weight:700">on your catalog</span></h2>
          <p style="margin:0;max-width:540px;font-size:17px;line-height:1.6;color:var(--pl-ink-2)">Bring your SKUs and channels — we'll show how the engine prices them and what it forecasts.</p>
          <p style="margin:0;font-size:14px;color:var(--pl-muted)">Enterprise rollouts and custom requirements scoped with our team.</p>
          <div style="display:flex;flex-wrap:wrap;gap:10px">
            <a href="/book-a-demo" style="height:50px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Get a Demo</a>
            <a href="/contact" style="height:50px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">Talk to sales</a>
          </div>
        </div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;gap:8px">
          {ctaD.map((c, i) => (
            <div class="dp-ctarow" data-dp-cta={i} style="display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:12px;align-items:center;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:14px;padding:12px 16px;box-shadow:0 16px 30px -24px rgba(60,30,15,.4);transform:translateX(0);transition:all .5s">
              <span style="min-width:0"><span style="display:block;font-size:13.5px;font-weight:500;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{c.n}</span><span style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-faint)">{c.ch}</span></span>
              <span style="font-family:'Geist Mono',monospace;font-size:13px;color:var(--pl-ink)">{c.p}</span>
              <span style={`height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:${c.tbg};font-family:'Geist Mono',monospace;font-size:10px;color:${c.tc}`}>{c.s}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div class="dp-split" style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);gap:clamp(32px,5vw,72px);align-items:start">
        <div data-reveal class="dp-sticky" style="top:96px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>FAQ</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink)"><span style="font-weight:400">Dynamic pricing software </span><span style="font-weight:700">FAQ</span></h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          {faqData.map((qq, i) => (
            <div class="dp-faq" class:list={[{ 'is-open': i === 0 }]} data-dp-faq style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:16px;overflow:hidden;transition:border-color .25s,box-shadow .25s">
              <button type="button" data-dp-faq-btn aria-expanded={i === 0 ? 'true' : 'false'} style="width:100%;border:none;background:transparent;cursor:pointer;display:flex;align-items:center;gap:16px;padding:20px 22px;text-align:left">
                <span class="dp-faq-n" style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-faint)">{qq.n}</span>
                <span style="flex:1;font-family:Geist,sans-serif;font-size:17px;font-weight:500;color:var(--pl-ink)">{qq.q}</span>
                <span class="dp-faq-plus" style="flex:none;width:30px;height:30px;border-radius:9px;background:var(--pl-sand);color:var(--pl-ink);display:flex;align-items:center;justify-content:center;transition:transform .3s,background .3s"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg></span>
              </button>
              <div class="dp-faq-panel"><div style="overflow:hidden"><p style="margin:0;padding:0 22px 22px 58px;font-size:15px;line-height:1.65;color:var(--pl-ink-2)">{qq.a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .dp { background: var(--pl-surface); overflow-x: clip; }
  @keyframes pi-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 8px rgba(247,99,30,0); } }
  @keyframes pi-ring { from { stroke-dashoffset: var(--c,150.8); } to { stroke-dashoffset: 12.1; } }
  @keyframes pi-dashx { to { background-position: 20px 0; } }
  @keyframes pi-dash { to { stroke-dashoffset: -20; } }
  @keyframes pi-pop { 0% { opacity: 0; transform: scale(.92); } 100% { opacity: 1; transform: none; } }
  @keyframes pi-marquee { to { transform: translateX(-50%); } }
  @keyframes pi-blink { 50% { opacity: 0; } }
  @keyframes pi-close { from { width: 0; } to { width: 100%; } }
  @keyframes pi-walk { from { left: 0%; } to { left: 100%; } }
  @keyframes pi-shake { 0%,100% { transform: none; } 25% { transform: translateX(-2px); } 75% { transform: translateX(2px); } }
  @keyframes pi-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes pi-grow { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes pi-orbit { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .dp *, .dp *::before, .dp *::after { animation: none !important; transition: none !important; } }

  .dp-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .dp-hero { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }
  .dp-logo { display: grid; grid-template-columns: 1fr; }
  .dp-logolabel { border-bottom: 1px solid var(--pl-line); }
  @media (min-width: 760px) { .dp-logo { grid-template-columns: 260px minmax(0,1fr); } .dp-logolabel { border-right: 1px solid var(--pl-line); border-bottom: none; } }
  .dp-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .dp-split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }
  .dp-sticky { position: relative; }
  @media (min-width: 1000px) { .dp-sticky { position: sticky; } }
  .dp-appr { grid-template-columns: 1fr; }
  @media (min-width: 760px) { .dp-appr { grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); } }
  .dp-quote { display: grid; grid-template-columns: 1fr; }
  .dp-quote-r { border-top: 1px solid var(--pl-accent-line); }
  @media (min-width: 760px) { .dp-quote { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); } .dp-quote-r { border-top: none; border-left: 1px solid var(--pl-accent-line); } }
  .dp-how { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .dp-how { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); } }
  .dp-out { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .dp-out { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  .dp-proof { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .dp-proof { grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); } }
  .dp-cta { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .dp-cta { grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); } }
  .dp-tab-short { display: none; }
  @media (max-width: 759px) { .dp-tab-full { display: none; } .dp-tab-short { display: inline; } }

  .dp-tab.is-on { background: var(--pl-accent); }
  .dp-tab.is-on .dp-tab-n { color: var(--pl-ink); }
  .dp-whycard:hover { transform: translateY(-4px); box-shadow: 0 24px 44px -28px rgba(60,30,15,.35); }
  .dp-sc.is-on[data-dp-sc="match"] { background: var(--pl-surface); box-shadow: 0 2px 8px -4px rgba(60,30,15,.3); }
  .dp-sc.is-on[data-dp-sc="hold"] { background: var(--pl-accent); }
  .dp-faq.is-open { border-color: var(--pl-accent-line); box-shadow: 0 18px 36px -28px rgba(194,65,12,.5); }
  .dp-faq.is-open .dp-faq-plus { background: var(--pl-accent); transform: rotate(45deg); }
  .dp-faq.is-open .dp-faq-n { color: var(--pl-accent-ink); }
  .dp-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .dp-faq.is-open .dp-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.dp');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---- 1600ms loop: hero signals + CTA stack ----
    const sigs = qa('[data-dp-sig]'), ctas = qa('[data-dp-cta]');
    let tick = 0;
    const paintTick = () => {
      const hot = tick % 4;
      sigs.forEach((el, i) => { el.style.borderColor = i === hot ? 'var(--pl-accent)' : 'var(--pl-line-soft)'; el.style.boxShadow = i === hot ? '0 0 0 3px rgba(247,99,30,.15)' : 'none'; });
      ctas.forEach((el, i) => { const on = i === hot; el.style.transform = `translateX(${on ? -12 : 0}px)`; el.style.borderColor = on ? 'var(--pl-accent)' : 'var(--pl-line)'; });
    };
    paintTick();
    setInterval(() => { tick++; paintTick(); }, 1600);

    // ---- 240ms loop: step tab auto-advance ----
    const tabs = qa('[data-dp-tab]'), panels = qa('[data-dp-panel]');
    const stepData = [
      { t: 'Decision modeling', b1: 'Models demand and price elasticity across the full catalog, not just competitor-match rules.', b2: "Flags where you're underpricing winners and leaving margin on slow movers." },
      { t: 'Impact forecasting', b1: 'Projects the effect on revenue and margin before a price goes live.', b2: 'Compares scenarios side by side — match the competitor versus hold and protect margin.' },
      { t: 'Guardrails and control', b1: 'Set margin floors, MAP limits, and rounding rules once; the engine honors them on every decision.', b2: 'Auto-approve safe moves, route risky ones to a human — you set the threshold.' },
    ];
    let step = 0, stepP = 0;
    const paintStep = () => {
      tabs.forEach((el, i) => el.classList.toggle('is-on', i === step));
      panels.forEach((el, i) => (el.style.display = i === step ? (i === 2 ? 'flex' : 'block') : 'none'));
      qa('.dp-tab-bar').forEach((bar, i) => (bar.style.width = (i === step ? Math.round(stepP * 100) : 0) + '%'));
      const d = stepData[step];
      const set = (sel: string, v: string) => { const el = q(sel); if (el) el.textContent = v; };
      set('[data-dp-curn]', '0' + (step + 1)); set('[data-dp-curt]', d.t); set('[data-dp-curb1]', d.b1); set('[data-dp-curb2]', d.b2);
      const h1 = q('[data-dp-hint1]'), h2 = q('[data-dp-hint2]');
      if (h1) h1.hidden = step !== 1; if (h2) h2.hidden = step !== 2;
    };
    tabs.forEach((el, i) => el.addEventListener('click', () => { step = i; stepP = 0; paintStep(); }));
    paintStep();
    setInterval(() => {
      stepP += 0.025;
      if (stepP >= 1) { step = (step + 1) % 3; stepP = 0; paintStep(); }
      else qa('.dp-tab-bar').forEach((bar, i) => { if (i === step) bar.style.width = Math.round(stepP * 100) + '%'; });
    }, 240);

    // ---- hero decision ----
    const decide = q('[data-dp-decide]'), approved = q('[data-dp-approved]'), price = q('[data-dp-price]'), msg = q('[data-dp-msg]');
    const setDecision = (kind: string | null) => {
      if (!decide || !approved) return;
      if (kind) {
        decide.style.display = 'none'; approved.hidden = false; approved.style.display = 'flex';
        if (price) price.textContent = kind === 'override' ? '$28.49' : '$27.49';
        if (msg) msg.textContent = kind === 'override' ? 'Override saved · $28.49 · logged' : 'Approved · $27.49 goes live';
      } else {
        decide.style.display = 'flex'; approved.hidden = true; approved.style.display = 'none';
        if (price) price.textContent = '$27.49';
      }
    };
    q('[data-dp-approve]')?.addEventListener('click', () => setDecision('approve'));
    q('[data-dp-override]')?.addEventListener('click', () => setDecision('override'));
    q('[data-dp-reset]')?.addEventListener('click', () => setDecision(null));

    // ---- scenario toggle ----
    const SC: Record<string, any> = {
      hold: { price: '$27.49', tag: '★ Recommended', tagBg: 'var(--pl-accent)', tagBc: 'var(--pl-accent)', tagC: 'var(--pl-ink)', bars: [['Revenue', 1.1], ['Margin', 4.2], ['Units', -0.5]], note: 'Demand here is inelastic — holding keeps margin with negligible volume loss. The defensible call.', noteBg: 'var(--pl-accent-tint)' },
      match: { price: '$28.79', tag: 'Matches rival', tagBg: 'var(--pl-sand)', tagBc: 'var(--pl-line)', tagC: 'var(--pl-ink-2)', bars: [['Revenue', -0.6], ['Margin', -3.1], ['Units', 0.8]], note: 'Sample scenario: matching buys a little volume but gives away margin that inelastic demand did not require.', noteBg: 'var(--pl-danger-tint)' },
    };
    const renderSc = (key: string) => {
      const sc = SC[key];
      const p = q('[data-dp-scprice]'); if (p) p.textContent = sc.price;
      const tag = q('[data-dp-sctag]'); if (tag) { tag.textContent = sc.tag; tag.style.background = sc.tagBg; tag.style.borderColor = sc.tagBc; tag.style.color = sc.tagC; }
      const bars = q('[data-dp-scbars]');
      if (bars) bars.innerHTML = sc.bars.map(([k, v]: [string, number]) => {
        const w = Math.min(48, Math.abs(v) * 9), l = v < 0 ? 50 - w : 50, o = v < 0 ? 'right' : 'left';
        const c = v < 0 ? 'var(--pl-danger)' : 'var(--pl-accent)', tc = v < 0 ? 'var(--pl-danger-ink)' : 'var(--pl-accent-ink)';
        const vs = (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(1) + '%';
        return `<div style="display:grid;grid-template-columns:70px minmax(0,1fr) 60px;gap:10px;align-items:center"><span style="font-size:13px;color:var(--pl-ink-2)">${k}</span><span style="position:relative;height:12px;border-radius:6px;background:var(--pl-sand)"><span style="position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--pl-line-xstrong)"></span><span style="position:absolute;top:0;bottom:0;left:${l}%;width:${w}%;border-radius:6px;background:${c};transform-origin:${o};animation:pi-grow .7s cubic-bezier(.2,.7,.2,1) both"></span></span><span style="text-align:right;font-family:'Geist Mono',monospace;font-size:13px;color:${tc}">${vs}</span></div>`;
      }).join('');
      const note = q('[data-dp-scnote]'); if (note) { note.textContent = sc.note; note.style.background = sc.noteBg; }
      const body = q('[data-dp-scbody]'); if (body) { body.style.animation = 'none'; void body.offsetWidth; body.style.animation = 'pi-in .35s ease'; }
    };
    qa('[data-dp-sc]').forEach((b) => b.addEventListener('click', () => {
      const key = b.getAttribute('data-dp-sc')!;
      qa('[data-dp-sc]').forEach((x) => x.classList.toggle('is-on', x === b));
      renderSc(key);
    }));

    // ---- threshold slider -> moves auto/review ----
    const thrLabel = q('[data-dp-thr]'), thrRange = q('[data-dp-thrrange]') as HTMLInputElement | null;
    const paintMoves = (thr: number) => {
      if (thrLabel) thrLabel.textContent = String(thr);
      qa('[data-dp-move]').forEach((row) => {
        const d = Math.abs(Number(row.getAttribute('data-d'))); const safe = d <= thr;
        row.style.background = safe ? 'var(--pl-cream)' : '#FFFDF7';
        const tag = row.querySelector('.dp-move-tag') as HTMLElement;
        if (tag) { tag.textContent = safe ? 'Auto' : 'Review'; tag.style.background = safe ? 'var(--pl-accent-tint)' : 'var(--pl-warn-tint)'; tag.style.borderColor = safe ? 'var(--pl-accent-line)' : 'var(--pl-warn-line)'; tag.style.color = safe ? 'var(--pl-accent-ink)' : 'var(--pl-warn-ink)'; }
      });
    };
    thrRange?.addEventListener('input', () => paintMoves(Number(thrRange.value)));
    paintMoves(5);

    // ---- faq ----
    qa('[data-dp-faq-btn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-dp-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-dp-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-dp-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('mk-in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  const tabs = Array.from(document.querySelectorAll('[data-dp-tab]')) as HTMLElement[];
  const panels = Array.from(document.querySelectorAll('[data-dp-panel]')) as HTMLElement[];
  const texts = Array.from(document.querySelectorAll('[data-dp-panel-text]')) as HTMLElement[];
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const i = tab.dataset.dpTab;
    tabs.forEach((t) => { t.classList.toggle('is-on', t === tab); t.setAttribute('aria-selected', String(t === tab)); });
    panels.forEach((p) => { p.hidden = p.dataset.dpPanel !== i; });
    texts.forEach((t) => { t.hidden = t.dataset.dpPanelText !== i; });
  }));
</script>

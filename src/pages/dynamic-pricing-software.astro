---
/**
 * Dynamic Pricing Software / Price Decision Engine — native rebuild on the
 * shared light design system. Content ported 1:1 from dynamic-pricing-software.html.
 * [retailer] / X / Y placeholders kept verbatim.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHeader from '@/components/ds/nav/SectionHeader.astro';
import Tabs from '@/components/ds/nav/Tabs.astro';
import FAQ from '@/components/ds/faq/FAQ.astro';
import CTA from '@/components/ds/cta/CTA.astro';

const logos = ['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank'];

const signals = [
  { k: 'Competitor moved', v: '−4.0%', c: '#C9372E' },
  { k: 'Demand elasticity', v: 'Low', c: '#0A0A0A' },
  { k: 'Stock on hand', v: '142u', c: '#0A0A0A' },
  { k: 'Margin floor', v: '32% ✓', c: '#B01C1C' },
];

const latency = [
  { n: '01', t: 'Competitor moves', d: 'OVERNIGHT', late: false },
  { n: '02', t: 'Exported', d: 'DAY 1', late: false },
  { n: '03', t: 'Modeled', d: 'DAY 2', late: false },
  { n: '04', t: 'Debated', d: 'DAY 3', late: false },
  { n: '05', t: 'Signed off', d: 'TOO LATE', late: true },
];

const problems = [
  { n: '01', tag: 'TOO SLOW', t: "A competitor repositions a category overnight. By the time it's exported, modeled, debated, and signed off, the window has closed — on revenue or on margin." },
  { n: '02', tag: 'NO JUDGMENT', t: "Rules-based repricing buys speed but not judgment. It matches a rival blindly, even when matching gives away margin you didn't need to lose." },
  { n: '03', tag: "DOESN'T SCALE", t: "Across tens of thousands of SKUs and multiple channels, the manual route doesn't scale — and the rules route can't be defended to finance." },
];

const pillars = [
  { t: 'It weighs more than one rival', d: "Price reflects demand, elasticity, stock, and cost together — not a single competitor's tag." },
  { t: 'It forecasts before it acts', d: 'Every recommendation carries a predicted revenue and margin outcome, so no change is a guess.' },
  { t: 'Control stays with your team', d: 'Auto-approve inside the guardrails you set, or review only the edge cases.' },
];

const repricer = ['Reacts to a rule', 'Matches one rival blindly', 'No forecast — the change is a guess', "Hard to defend to finance"];
const engine = ['Recommends a priced decision', 'Weighs demand, elasticity, stock, and cost', 'Carries a predicted revenue & margin outcome', 'Each price shows its reasoning — justify it on the spot'];

const steps = [
  { t: 'Decision modeling', b1: 'Models demand and price elasticity across the full catalog, not just competitor-match rules.', b2: "Flags where you're underpricing winners and leaving margin on slow movers." },
  { t: 'Impact forecasting', b1: 'Projects the effect on revenue and margin before a price goes live.', b2: 'Compares scenarios side by side — match the competitor versus hold and protect margin.' },
  { t: 'Guardrails and control', b1: 'Set margin floors, MAP limits, and rounding rules once; the engine honors them on every decision.', b2: 'Auto-approve safe moves, route risky ones to a human — you set the threshold.' },
];

const elastic = [
  { n: 'Aeris Headphones', el: 'Low', pos: 'Underpriced', flag: '+ Raise', lvl: 1 },
  { n: 'Volt Charger 65W', el: 'High', pos: 'At market', flag: 'Hold', lvl: 3 },
  { n: 'Lumen Desk Lamp', el: 'Med', pos: 'Slow mover', flag: '− Trim', lvl: 2 },
  { n: 'Nimbus Speaker', el: 'Low', pos: 'Underpriced', flag: '+ Raise', lvl: 1 },
];
const flagStyle = (f: string) => f.startsWith('+') ? { bg: '#E8FCEF', bc: '#FFD6C8', c: '#B01C1C' } : f.startsWith('−') ? { bg: '#FFF8EB', bc: '#F4DDAE', c: '#8A5A00' } : { bg: '#F4F5F4', bc: '#E6E8E6', c: '#3A414C' };

const scenarioBars = [
  { k: 'Revenue', v: '+1.1%', pct: 20, c: '#FF3131', tc: '#B01C1C' },
  { k: 'Margin', v: '+4.2%', pct: 48, c: '#FF3131', tc: '#B01C1C' },
  { k: 'Units', v: '−0.5%', pct: 8, c: '#E5483F', tc: '#C9372E' },
];

const moves = [
  { n: 'Aeris Headphones', d: '−2.1%', safe: true },
  { n: 'Volt Charger 65W', d: '+3.4%', safe: true },
  { n: 'Lumen Desk Lamp', d: '−7.5%', safe: false },
  { n: 'Nimbus Speaker', d: '+11.2%', safe: false },
];

const ctaStack = [
  { n: 'Aeris Wireless Headphones', ch: 'Online · US', p: '$27.49', s: 'Hold' },
  { n: 'Volt Charger 65W', ch: 'Marketplace', p: '$34.99', s: 'Auto' },
  { n: 'Lumen Desk Lamp', ch: 'Store · North', p: '$41.49', s: 'Review' },
  { n: 'Nimbus Speaker', ch: 'Online · EU', p: '€59.99', s: 'Raise' },
];

const faqs = [
  { q: 'What is dynamic pricing software?', a: 'Software that adjusts prices automatically based on demand, competition, stock, and cost — and, here, forecasts the impact before any change is applied.' },
  { q: 'Is this just a repricer?', a: 'No. A repricer reacts to a rule; the Price Decision Engine recommends a priced decision with predicted outcomes and keeps a human in the loop.' },
  { q: 'Will it replace my pricing team?', a: 'It removes the manual grind, not the judgment. Your team sets strategy and guardrails; the engine does the heavy lifting at scale.' },
  { q: 'How does it handle MAP and margin floors?', a: 'As hard guardrails — the engine never recommends a price that breaks them.' },
  { q: 'How is it priced?', a: "Pricing depends on catalog size, channels, and rollout scope. Book a demo and we'll scope it with you." },
];
---

<SiteLayout
  title="Dynamic Pricing Software · Price Decision Engine · PriceLeap"
  description="Set the right price for every SKU, across every store and channel — automatically, and with the reasoning visible before anything changes."
>

  <!-- ══ HERO ══ -->
  <section class="dp-hero">
    <div class="dp-hero__grid" aria-hidden="true"></div>
    <div class="dp-hero__glow" aria-hidden="true"></div>
    <div class="dp-wrap dp-hero__inner">
      <div class="dp-hero__copy">
        <nav class="dp-crumb"><a href="/light">Product</a><span>/</span><span>Dynamic Pricing Software</span></nav>
        <span class="dp-eyebrow"><span class="dp-eyebrow__dot"></span>Dynamic Pricing Software · Price Decision Engine</span>
        <h1 class="dp-h1"><span class="w4">A priced decision, </span><b>not just a price change.</b></h1>
        <p class="dp-lead">Set the right price for every SKU, across every store and channel — automatically, and with the reasoning visible before anything changes. The Price Decision Engine turns market signals into priced decisions your team can stand behind.</p>
        <div class="dp-hero__btns">
          <a href="/book-a-demo" class="dp-btn dp-btn--primary">Get a demo</a>
          <a href="#how" class="dp-btn dp-btn--secondary">How it works <span>→</span></a>
        </div>
        <div class="dp-hero__ticks">
          {['Forecasts before it acts', 'Weighs more than one rival', 'Guardrails you set'].map(t => (
            <span class="dp-tick"><span class="dp-tick__ic">✓</span>{t}</span>
          ))}
        </div>
      </div>

      <!-- Decision card -->
      <div class="dp-hero__card-wrap">
        <div class="dp-card">
          <div class="dp-card__head">
            <span class="dp-dots"><i></i><i></i><i></i></span>
            <span class="dp-card__title">Price decision · Aeris Headphones</span>
            <span class="dp-live"><span class="dp-live__dot"></span>LIVE</span>
          </div>
          <div class="dp-card__signals">
            {signals.map(s => (
              <div class="dp-signal"><span class="dp-signal__k">{s.k}</span><span class="dp-signal__v" style={`color:${s.c}`}>{s.v}</span></div>
            ))}
          </div>
          <div class="dp-card__rec">
            <div class="dp-rec__left"><span class="dp-rec__lbl">RECOMMENDED PRICE</span><span class="dp-rec__price">$27.49</span><span class="dp-rec__note">Inelastic · hold · +4.2% margin</span></div>
            <div class="dp-rec__actions">
              <span class="dp-rec__btn dp-rec__btn--primary">Approve</span>
              <span class="dp-rec__btn">Override</span>
            </div>
          </div>
          <div class="dp-card__foot">— confirm before publish</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ LOGOS ══ -->
  <section class="dp-logos">
    <div class="dp-wrap dp-logos__inner">
      <div class="dp-logos__label">Trusted by enterprise pricing teams</div>
      <div class="dp-logos__track"><div class="dp-logos__marquee">{[...logos, ...logos].map(l => <span class="dp-logo">{l}</span>)}</div></div>
    </div>
  </section>

  <!-- ══ PROBLEM ══ -->
  <section id="problem" class="dp-sec dp-sec--tint">
    <div class="dp-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="The problem" title="At enterprise scale, prices move faster than" accent="your team can decide." align="center" />
      </div>
      <div class="dp-latency" data-reveal>
        <div class="dp-latency__lbl">THE MANUAL ROUTE · ONE CATEGORY MOVE</div>
        <div class="dp-latency__row">
          {latency.map((l, i) => (
            <>
              <div class="dp-lat" style={l.late ? 'border-color:#F5C6C3;background:#FFF7F6' : ''}>
                <span class="dp-lat__n" style={l.late ? 'color:#C9372E' : ''}>{l.n}</span>
                <span class="dp-lat__t" style={l.late ? 'color:#C9372E' : ''}>{l.t}</span>
                <span class="dp-lat__d" style={l.late ? 'color:#C9372E' : ''}>{l.d}</span>
              </div>
              {i < latency.length - 1 && <span class="dp-lat__arrow">→</span>}
            </>
          ))}
        </div>
      </div>
      <div class="dp-problems" data-reveal>
        {problems.map(p => (
          <div class="dp-prob">
            <div class="dp-prob__top"><span class="dp-prob__n">{p.n}</span><span class="dp-prob__tag">{p.tag}</span></div>
            <p class="dp-prob__t">{p.t}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ APPROACH ══ -->
  <section id="approach" class="dp-sec">
    <div class="dp-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="The approach" title="A priced decision," accent="not just a price change." lead="Repricing tells you what changed. A decision engine tells you what to do about it — and what happens if you do. It's a decision you can see, challenge, and override before it goes live — not a rule firing in the dark." align="center" />
      </div>
      <div class="dp-pillars" data-reveal>
        {pillars.map((p, i) => (
          <div class="dp-pillar">
            <span class="dp-pillar__n">0{i + 1}</span>
            <h3 class="dp-pillar__t">{p.t}</h3>
            <p class="dp-pillar__d">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHY A DECISION ENGINE ══ -->
  <section id="why" class="dp-sec dp-sec--tint">
    <div class="dp-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Why a decision engine" title="Why pricing teams choose a decision engine" accent="over a repricer." align="center" />
      </div>
      <div class="dp-vs" data-reveal>
        <div class="dp-vs__col dp-vs__col--old">
          <div class="dp-vs__tag">RULES-BASED REPRICER</div>
          <ul>{repricer.map(t => <li><span class="dp-vs__x">✕</span>{t}</li>)}</ul>
        </div>
        <div class="dp-vs__col dp-vs__col--new">
          <div class="dp-vs__tag dp-vs__tag--on">PRICE DECISION ENGINE</div>
          <ul>{engine.map(t => <li><span class="dp-vs__check">✓</span>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ HOW IT WORKS ══ -->
  <section id="how" class="dp-sec">
    <div class="dp-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="How it works" title="How the Price Decision Engine" accent="works." lead="The Price Decision Engine weighs demand, competitor moves, stock, cost, and your margin floor — then recommends a price and its expected effect on revenue and margin." align="center" />
      </div>
      <div class="dp-how" data-reveal>
        <Tabs tabs={steps.map((s, i) => `0${i + 1} ${s.t}`)} id="dp-how" variant="underline">
          <div slot="panel-0"><div class="dp-step"><p>{steps[0].b1}</p><p>{steps[0].b2}</p></div></div>
          <div slot="panel-1"><div class="dp-step"><p>{steps[1].b1}</p><p>{steps[1].b2}</p></div></div>
          <div slot="panel-2"><div class="dp-step"><p>{steps[2].b1}</p><p>{steps[2].b2}</p></div></div>
        </Tabs>
      </div>

      <div class="dp-work" data-reveal>
        <!-- Elasticity & opportunity -->
        <div class="dp-panel">
          <div class="dp-panel__t">Elasticity &amp; opportunity</div>
          <div class="dp-elastic">
            <div class="dp-elastic__head"><span>PRODUCT</span><span>ELASTICITY</span><span>POSITION</span><span style="text-align:right">MOVE</span></div>
            {elastic.map(e => {
              const f = flagStyle(e.flag);
              return (
                <div class="dp-elastic__row">
                  <span class="dp-elastic__n">{e.n}</span>
                  <span class="dp-elastic__bars">
                    <i style={`background:${e.lvl >= 1 ? '#FF3131' : '#E6E8E6'}`}></i>
                    <i style={`background:${e.lvl >= 2 ? '#FF3131' : '#E6E8E6'}`}></i>
                    <i style={`background:${e.lvl >= 3 ? '#FF3131' : '#E6E8E6'}`}></i>
                  </span>
                  <span class="dp-elastic__pos">{e.pos}</span>
                  <span class="dp-elastic__flag" style={`background:${f.bg};border-color:${f.bc};color:${f.c}`}>{e.flag}</span>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Forecast scenario -->
        <div class="dp-panel">
          <div class="dp-panel__t">Forecast · before it goes live</div>
          <div class="dp-scen">
            <div class="dp-scen__tabs"><span class="dp-scen__tab dp-scen__tab--on">Hold &amp; protect margin</span><span class="dp-scen__tab">Match rival</span></div>
            <div class="dp-scen__price">$27.49 <span class="dp-scen__rec">★ Recommended</span></div>
            <div class="dp-scen__bars">
              {scenarioBars.map(b => (
                <div class="dp-scen__bar">
                  <span class="dp-scen__k">{b.k}</span>
                  <span class="dp-scen__track"><i style={`width:${b.pct}%;background:${b.c}`}></i></span>
                  <span class="dp-scen__v" style={`color:${b.tc}`}>{b.v}</span>
                </div>
              ))}
            </div>
            <p class="dp-scen__note">Demand here is inelastic — holding keeps margin with negligible volume loss. The defensible call.</p>
          </div>
        </div>
      </div>

      <!-- Approval routing -->
      <div class="dp-route" data-reveal>
        <div class="dp-route__head">
          <div class="dp-panel__t">Guardrails · auto-approve vs review</div>
          <span class="dp-route__thr">Threshold ±5%</span>
        </div>
        <div class="dp-route__rows">
          {moves.map(m => (
            <div class="dp-route__row" style={m.safe ? '' : 'background:#FFFDF7'}>
              <span class="dp-route__n">{m.n}</span>
              <span class="dp-route__d">{m.d}</span>
              <span class="dp-route__tag" style={`background:${m.safe ? '#E8FCEF' : '#FFF8EB'};border-color:${m.safe ? '#FFD6C8' : '#F4DDAE'};color:${m.safe ? '#B01C1C' : '#8A5A00'}`}>{m.safe ? 'Auto' : 'Review'}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ OUTCOME ══ -->
  <section id="outcome" class="dp-sec dp-sec--tint">
    <div class="dp-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="The outcome" title="What changes when pricing becomes" accent="a decision." align="center" />
      </div>
      <div class="dp-outcome" data-reveal>
        <div class="dp-outcome__quote">
          <blockquote>" Quote goes here — the pricing team's words on what changed once decisions, not rules, drove price. "</blockquote>
          <p class="dp-outcome__sub">How [retailer] recovered X margin points across Y SKUs in 90 days. Retailers using dynamic pricing typically see these gains <span>(McKinsey &amp; Company)</span>.</p>
          <p class="dp-outcome__hint">e.g. manual pricing effort reduced by ~X%.</p>
        </div>
        <div class="dp-outcome__stack">
          <div class="dp-stack__t">Decisions, across channels</div>
          {ctaStack.map(c => (
            <div class="dp-stack__row">
              <div class="dp-stack__meta"><b>{c.n}</b><small>{c.ch}</small></div>
              <span class="dp-stack__p">{c.p}</span>
              <span class="dp-stack__s" style={`background:${c.s === 'Review' ? '#FFF8EB' : '#E8FCEF'};color:${c.s === 'Review' ? '#8A5A00' : '#B01C1C'}`}>{c.s}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <div class="dp-wrap" style="padding:clamp(64px,8vw,112px) var(--pl-gutter)">
    <CTA
      variant="primary"
      title="See the Price Decision Engine on"
      accent="your catalog."
      body="Bring your SKUs and channels — we'll show how the engine prices them and what it forecasts, before anything goes live."
      primary={{ label: 'Talk to a pricing expert', href: '/book-a-demo' }}
      secondary={{ label: 'Read the FAQ', href: '#faq' }}
    />
  </div>

  <!-- ══ FAQ ══ -->
  <section id="faq" class="dp-sec" style="border-top:1px solid var(--pl-line)">
    <div class="dp-wrap dp-faq">
      <div data-reveal>
        <SectionHeader eyebrow="FAQ" title="Dynamic pricing software" accent="FAQ" align="center" />
      </div>
      <div data-reveal style="margin-top:36px">
        <FAQ items={faqs} variant="list" />
      </div>
    </div>
  </section>

</SiteLayout>

<style>
.dp-wrap { max-width: var(--pl-container); margin: 0 auto; padding-left: var(--pl-gutter); padding-right: var(--pl-gutter); }
.dp-sec { padding: clamp(64px,8vw,112px) 0; border-bottom: 1px solid var(--pl-line); }
.dp-sec--tint { background: #FBFBFA; }
.dp-h1 { margin: 24px 0 0; font-family: var(--pl-font); font-size: clamp(38px,5.4vw,68px); line-height: 1.02; letter-spacing: -.045em; color: #0A0A0A; text-wrap: balance; font-weight: 700; }
.dp-h1 .w4 { font-weight: 400; }
.dp-lead { margin: 22px 0 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: #3A414C; }
.dp-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--pl-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #B01C1C; }
.dp-eyebrow__dot { width: 7px; height: 7px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.8s ease-out infinite; }

.dp-btn { height: 48px; padding: 0 22px; display: inline-flex; align-items: center; gap: 10px; border-radius: 12px; font-family: var(--pl-font); font-weight: 500; font-size: 15px; transition: all .2s; }
.dp-btn--primary { background: #FF3131; color: #0A0A0A; box-shadow: 0 12px 26px -12px rgba(255, 49, 49,.9); }
.dp-btn--primary:hover { background: #F23830; color: #0A0A0A; }
.dp-btn--secondary { background: #fff; border: 1px solid var(--pl-line); color: #0A0A0A; }
.dp-btn--secondary:hover { border-color: #C4CAC4; }
.dp-btn--secondary span { color: #B01C1C; }

/* hero */
.dp-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
.dp-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(#EEF0EE 1px,transparent 1px),linear-gradient(90deg,#EEF0EE 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%); pointer-events: none; }
.dp-hero__glow { position: absolute; right: -10%; top: -20%; width: 720px; height: 620px; background: radial-gradient(closest-side,rgba(255, 49, 49,.14),transparent); pointer-events: none; }
.dp-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(40px,5vw,64px); align-items: center; padding-top: clamp(48px,7vw,96px); padding-bottom: clamp(48px,6vw,80px); }
.dp-crumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #5A6373; margin-bottom: 24px; }
.dp-crumb a { color: #5A6373; }
.dp-crumb span:last-child { color: #0A0A0A; }
.dp-hero__btns { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; }
.dp-hero__ticks { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 8px 20px; }
.dp-tick { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #3A414C; }
.dp-tick__ic { flex: none; width: 18px; height: 18px; border-radius: 50%; background: #E8FCEF; border: 1px solid #FFD6C8; color: #B01C1C; font-size: 10px; display: flex; align-items: center; justify-content: center; }

.dp-hero__card-wrap { position: relative; min-width: 0; }
.dp-card { background: #fff; border: 1px solid var(--pl-line); border-radius: 20px; box-shadow: 0 40px 80px -40px rgba(10,10,10,.28); overflow: hidden; }
.dp-card__head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid #EEF0EE; background: #FBFBFA; }
.dp-dots { display: flex; gap: 5px; }
.dp-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--pl-line); }
.dp-card__title { font-size: 13px; font-weight: 500; color: #0A0A0A; }
.dp-live { margin-left: auto; display: flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 999px; background: #E8FCEF; border: 1px solid #FFD6C8; font-family: var(--pl-mono); font-size: 10px; color: #B01C1C; }
.dp-live__dot { width: 6px; height: 6px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.6s infinite; }
.dp-card__signals { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: #EEF0EE; border-bottom: 1px solid #EEF0EE; }
.dp-signal { background: #fff; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; }
.dp-signal__k { font-size: 13px; color: #5A6373; }
.dp-signal__v { font-family: var(--pl-font); font-size: 15px; font-weight: 600; }
.dp-card__rec { padding: 18px 16px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.dp-rec__lbl { display: block; font-family: var(--pl-mono); font-size: 10px; letter-spacing: .06em; color: #6E7684; }

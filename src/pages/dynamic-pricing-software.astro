---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';
import Faq from '../components/pl/Faq.astro';
import '../styles/pl-marketing.css';

const logos = [...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank'], ...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank']];
const signals = [
  { k: 'Demand', v: '↑ strong', c: 'var(--pl-accent-ink)' },
  { k: 'Rivals', v: '2 moved', c: 'var(--pl-ink-2)' },
  { k: 'Stock', v: 'healthy', c: 'var(--pl-ink-2)' },
  { k: 'Margin floor', v: '32% ok', c: 'var(--pl-accent-ink)' },
];
const latency = [
  { n: '01', t: 'Detect', d: 'hours' }, { n: '02', t: 'Analyze', d: 'a day' }, { n: '03', t: 'Decide', d: 'meetings' }, { n: '04', t: 'Approve', d: 'sign-off' }, { n: '05', t: 'Apply', d: 'too late' },
];
const problems = [
  { n: '01', tag: 'SCALE', t: 'Thousands of SKUs move at once; a team can only review a handful before the window closes.' },
  { n: '02', tag: 'LATENCY', t: 'By the time a price is agreed and pushed, the market has already moved on.' },
  { n: '03', tag: 'BLIND SPOTS', t: 'Rules fire without forecasting the effect, so margin leaks quietly across the catalog.' },
];
const fiveSig = ['demand', 'rivals', 'stock', 'cost', 'floor'];
const elastic = [
  { n: 'Aeris Wireless Headphones', el: 'Low', pos: 'At market', flag: '+ hold', b: [1, 0, 0] },
  { n: 'Volt Charger 65W', el: 'High', pos: 'Above', flag: '− cut', b: [1, 1, 1] },
  { n: 'Lumen Desk Lamp', el: 'Med', pos: 'Below', flag: '+ raise', b: [1, 1, 0] },
  { n: 'Nimbus Speaker', el: 'Low', pos: 'At market', flag: '+ hold', b: [1, 0, 0] },
];
const moveData = [['Aeris Headphones', '−2.1%', 'Auto', true], ['Volt Charger 65W', '+3.4%', 'Auto', true], ['Lumen Desk Lamp', '−7.5%', 'Review', false], ['Nimbus Speaker', '+11.2%', 'Review', false]];
const ctaStack = [
  { n: 'Aeris Wireless Headphones', ch: 'Online · US', p: '$27.49', s: 'Hold', tbg: 'var(--pl-ink)', tc: 'var(--pl-surface)' },
  { n: 'Volt Charger 65W', ch: 'Marketplace', p: '$34.99', s: 'Auto', tbg: 'var(--pl-accent-tint)', tc: 'var(--pl-accent-ink)' },
  { n: 'Lumen Desk Lamp', ch: 'Store · North', p: '$41.49', s: 'Review', tbg: 'var(--pl-warn-tint)', tc: 'var(--pl-warn-ink)' },
  { n: 'Nimbus Speaker', ch: 'Online · EU', p: '€59.99', s: 'Raise', tbg: 'var(--pl-accent-tint)', tc: 'var(--pl-accent-ink)' },
];
const faqs = [
  { q: 'What is dynamic pricing software?', a: 'Software that adjusts prices automatically based on demand, competition, stock, and cost — and, here, forecasts the impact before any change is applied.' },
  { q: 'Is this just a repricer?', a: 'No. A repricer reacts to a rule; the Price Decision Engine recommends a priced decision with predicted outcomes and keeps a human in the loop.' },
  { q: 'Will it replace my pricing team?', a: 'It removes the manual grind, not the judgment. Your team sets strategy and guardrails; the engine does the heavy lifting at scale.' },
  { q: 'How does it handle MAP and margin floors?', a: 'As hard guardrails — the engine never recommends a price that breaks them.' },
  { q: 'How is it priced?', a: "Pricing depends on catalog size, channels, and rollout scope. Book a demo and we'll scope it with you." },
];
const steps = [
  { n: '1', t: 'Find the opportunity', b1: 'Score every SKU by elasticity and competitive position.', b2: 'Surface where a move protects margin or wins volume.' },
  { n: '2', t: 'Forecast the move', b1: 'See the predicted revenue, margin and units before it goes live.', b2: 'Compare scenarios — match the competitor or hold and protect margin.' },
  { n: '3', t: 'Automate inside guardrails', b1: 'Auto-approve safe moves; route risky ones to review.', b2: 'Margin floors, MAP and rounding rules are enforced automatically.' },
];
const scBars: [string, number, string, string][] = [['Revenue', 54, 'var(--pl-accent)', '+1.1%'], ['Margin', 70, 'var(--pl-accent)', '+4.2%'], ['Units', 44, 'var(--pl-danger)', '−0.5%']];
const guards: [string, string, string][] = [['MARGIN FLOOR', '32%', ''], ['MAP LIMIT', 'Enforced', 'accent'], ['ROUNDING RULE', '.49 / .99', 'mono'], ['AUTO-APPROVE', '±5%', '']];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Dynamic Pricing Software', provider: { '@type': 'Organization', name: 'PriceLeap' }, url: 'https://priceleap.ai/dynamic-pricing-software' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PriceLeapLayout title="Dynamic Pricing Software · PriceLeap" description="Set the right price for every SKU, across every channel — automatically, with the reasoning visible before anything changes. The Price Decision Engine." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="mk-hero">
    <div aria-hidden="true" class="mk-hero-lines"></div>
    <div aria-hidden="true" class="mk-hero-glow"></div>
    <div class="mk-hero-inner">
      <div style="min-width:0">
        <span class="dp-badge"><span class="dp-badge-sq"></span>Price Decision Engine</span>
        <h1 class="mk-h1"><span style="font-weight:400">Dynamic</span><br><span style="font-weight:700">Pricing Software</span></h1>
        <p class="mk-sub">Set the right price for every SKU, across every store and channel — automatically, and with the reasoning visible before anything changes. The Price Decision Engine turns market signals into priced decisions your team can stand behind.</p>
        <div class="mk-hero-cta">
          <a href="/contact" class="mk-btn-primary">Get a Demo</a>
          <a href="/contact" class="mk-btn-text">Talk to a pricing expert<span style="color:var(--pl-accent-ink)">→</span></a>
        </div>
      </div>
      <div style="position:relative;min-width:0">
        <div class="dp-card">
          <div class="dp-card-head"><span class="dp-card-ico"><span class="dp-card-diamond"></span></span><span class="dp-card-title">Price Decision Engine</span><span class="dp-card-live"><span class="mk-live-dot"></span>LIVE</span></div>
          <div class="dp-card-prod"><span class="dp-card-thumb"></span><div style="min-width:0;flex:1"><div class="dp-card-pn">Aeris Wireless Headphones</div><div class="dp-card-sku">SKU 48201 · Audio</div></div><div class="dp-conf"><svg viewBox="0 0 58 58" style="width:100%;height:100%;transform:rotate(-90deg)"><circle cx="29" cy="29" r="24" fill="none" stroke="#F5ECE5" stroke-width="5"></circle><circle cx="29" cy="29" r="24" fill="none" stroke="#F7631E" stroke-width="5" stroke-linecap="round" stroke-dasharray="150.8" stroke-dashoffset="12.1"></circle></svg><span class="dp-conf-v">92%</span></div></div>
          <div class="dp-card-price">
            <div><div class="dp-k">LIST PRICE</div><div class="dp-list">$29.99</div></div>
            <span class="dp-price-dash"></span>
            <div class="dp-rec"><div class="dp-k" style="color:var(--pl-accent-ink)">RECOMMENDED PRICE</div><div class="dp-rec-row"><span class="dp-rec-v">$27.49</span><span class="dp-rec-conf">92% confidence</span></div></div>
          </div>
          <div class="dp-forecast">
            <div class="dp-forecast-head"><span class="dp-chip-dark">Hold &amp; protect margin</span><span class="dp-forecast-label">90-DAY FORECAST</span></div>
            <div class="dp-forecast-grid">
              <div class="dp-fc"><div class="dp-fc-k">Revenue</div><div class="dp-fc-v">+1.1%</div></div>
              <div class="dp-fc dp-fc--hl"><div class="dp-fc-k">Margin</div><div class="dp-fc-v">+4.2%</div></div>
              <div class="dp-fc"><div class="dp-fc-k">Units</div><div class="dp-fc-v" style="color:var(--pl-danger-ink)">−0.5%</div></div>
            </div>
          </div>
          <div class="dp-why">
            <div class="dp-why-head"><span>Why this price</span><span class="dp-why-sub">4 signals weighed</span></div>
            <div class="dp-why-grid">{signals.map((g) => (<div class="dp-sig"><span>{g.k}</span><span style={`color:${g.c}`}>{g.v}</span></div>))}</div>
          </div>
          <div class="dp-actions"><span class="dp-approved"><span class="dp-approved-check">✓</span>Approved · live on 3 channels</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="mk-logos mk-cream">
    <div class="mk-logos-wrap">
      <div class="mk-logos-label">Trusted by teams at</div>
      <div class="mk-logos-marq-wrap"><div class="mk-logos-marq">{logos.map((l) => (<div class="mk-logo">{l}</div>))}</div></div>
    </div>
  </section>

  <!-- Problem -->
  <section id="problem" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal style="max-width:900px">
        <span class="mk-eyebrow mk-eyebrow--danger"><span class="mk-sq mk-sq--danger"></span>The problem</span>
        <h2 class="mk-h2"><span style="font-weight:400">At enterprise scale, </span><span style="font-weight:700">prices move faster than your team can decide</span></h2>
      </div>
      <div data-reveal class="dp-manual">
        <div class="dp-manual-head"><span>THE MANUAL ROUTE · ONE CATEGORY MOVE</span><span class="dp-manual-warn"><span class="mk-blink"></span>WINDOW CLOSING</span></div>
        <div class="dp-window"><span class="dp-window-fill"></span><span class="dp-window-label">REVENUE &amp; MARGIN WINDOW</span></div>
        <div class="dp-latency">
          <span aria-hidden="true" class="dp-latency-line"></span>
          {latency.map((l) => (<div class="dp-lat"><span class="dp-lat-n">{l.n}</span><span class="dp-lat-t">{l.t}</span><span class="dp-lat-d">{l.d}</span></div>))}
        </div>
      </div>
      <div data-reveal class="dp-probs">
        {problems.map((p) => (<div class="dp-prob"><div class="dp-prob-top"><span class="dp-prob-n">{p.n}</span><span class="dp-prob-tag">{p.tag}</span></div><p>{p.t}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="mk-sec mk-cream">
    <div class="mk-split mk-split--center">
      <div data-reveal>
        <span class="mk-eyebrow"><span class="mk-sq"></span>The approach</span>
        <h2 class="mk-h2"><span style="font-weight:700">A priced decision,</span><span style="font-weight:400"> not just a price change</span></h2>
        <div class="dp-appr-paras">
          <p>The Price Decision Engine weighs demand, competitor moves, stock, cost, and your margin floor — then recommends a price and its expected effect on revenue and margin.</p>
          <p>It's a decision you can see, challenge, and override before it goes live — not a rule firing in the dark.</p>
          <p class="dp-appr-note">Control stays with your team: auto-approve inside the guardrails you set, or review only the edge cases.</p>
        </div>
      </div>
      <div data-reveal class="dp-compare">
        <div class="dp-cmp dp-cmp--rules">
          <div class="dp-cmp-head"><span>Rules-based repricing</span><span class="dp-cmp-dot"></span></div>
          <div class="dp-cmp-code"><div><span style="color:var(--pl-faint)">IF</span> rival &lt; us <span style="color:var(--pl-faint)">→</span> match</div><div>price = rival − $0.01</div>
            <div class="dp-cmp-bars"><span style="height:90%;background:var(--pl-line-alt)"></span><span style="height:78%;background:var(--pl-line-alt)"></span><span style="height:64%;background:var(--pl-danger-line)"></span><span style="height:50%;background:var(--pl-danger-line)"></span><span style="height:34%;background:var(--pl-danger)"></span></div>
          </div>
          <div class="dp-cmp-foot dp-cmp-foot--bad">▼ Margin given away</div>
        </div>
        <div class="dp-cmp dp-cmp--engine">
          <div class="dp-cmp-head dp-cmp-head--on"><span>Decision-led pricing</span><span class="dp-cmp-dot dp-cmp-dot--on"></span></div>
          <div class="dp-cmp-body">
            <div class="dp-cmp-k">WEIGHS 5 SIGNALS</div>
            <div class="dp-cmp-sigs">{fiveSig.map((f) => (<span class="dp-cmp-sig">{f}</span>))}</div>
            <div class="dp-cmp-rec"><span class="dp-k">RECOMMENDS</span><span class="dp-cmp-rec-v">$27.49</span></div>
            <div class="dp-cmp-margin">+4.2% margin</div>
          </div>
          <div class="dp-cmp-foot2"><div><div class="dp-fc-k" style="color:var(--pl-accent-ink)">FORECAST</div><div class="dp-cmp-foot2-v">visible</div></div><div><div class="dp-fc-k" style="color:var(--pl-accent-ink)">OVERRIDE</div><div class="dp-cmp-foot2-v">on demand</div></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section id="why" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Why a decision engine</span>
        <h2 class="mk-h2" style="max-width:860px"><span style="font-weight:400">Why pricing teams choose a </span><span style="font-weight:700">decision engine over a repricer</span></h2>
      </div>
      <div data-reveal class="dp-quote">
        <div class="dp-quote-a"><span class="dp-quote-k">REPRICING</span><span>tells you what changed.</span></div>
        <div class="dp-quote-b"><span class="dp-quote-k" style="color:var(--pl-accent-ink)">A DECISION ENGINE</span><span style="font-weight:600;color:var(--pl-ink)">tells you what to do about it — and what happens if you do.</span></div>
      </div>
      <div data-reveal class="dp-why3">
        {[
          { t: 'It forecasts before it acts', d: 'Every recommendation carries a predicted revenue and margin outcome, so no change is a guess.' },
          { t: 'It weighs more than one rival', d: "Price reflects demand, elasticity, stock, and cost together — not a single competitor's tag." },
          { t: "It's defensible", d: 'Each price shows its reasoning, so pricing managers can justify it to finance and merchandising on the spot.' },
        ].map((c) => (
          <div class="dp-why3-card"><div class="dp-why3-viz"><span class="mk-why-ico"><span class="mk-why-ico-dot"></span></span></div><div class="dp-why3-body"><h3>{c.t}</h3><p>{c.d}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="dp-how-head">
        <div>
          <span class="mk-eyebrow"><span class="mk-sq"></span>How it works</span>
          <h2 class="mk-h2"><span style="font-weight:400">How the </span><span style="font-weight:700">Price Decision Engine</span><span style="font-weight:400"> works</span></h2>
        </div>
        <div class="dp-tabs" role="tablist">
          {steps.map((t, i) => (
            <button type="button" role="tab" class={`dp-tab${i === 0 ? ' is-on' : ''}`} data-dp-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="dp-tab-n">STEP {t.n}</span><span class="dp-tab-t">{t.t.split(' ')[0]}</span>
            </button>
          ))}
        </div>
      </div>
      <div data-reveal class="dp-how">
        <div class="dp-how-left">
          {steps.map((st, i) => (
            <div class="dp-step" data-dp-panel-text={i} hidden={i !== 0}>
              <span class="dp-step-n">STEP {st.n}</span>
              <h3 class="dp-step-t">{st.t}</h3>
              <div class="dp-step-bullets">
                <span><span class="dp-step-check">✓</span>{st.b1}</span>
                <span><span class="dp-step-check">✓</span>{st.b2}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="dp-how-right">
          <div aria-hidden="true" class="dp-how-dots"></div>
          <div class="dp-panel" data-dp-panel={0}>
            <div class="dp-panel-card">
              <div class="dp-panel-head"><span>Elasticity &amp; opportunity</span><span class="dp-panel-sub">12,480 SKUs</span></div>
              <div class="dp-elastic-head"><span>SKU</span><span>ELASTICITY</span><span>POSITION</span><span style="text-align:right">FLAG</span></div>
              {elastic.map((e) => (
                <div class="dp-elastic-row">
                  <span class="dp-el-n">{e.n}</span>
                  <span class="dp-el-el"><span class="dp-el-bars">{e.b.map((on) => (<span style={`background:${on ? 'var(--pl-accent)' : 'var(--pl-line-strong)'}`}></span>))}</span>{e.el}</span>
                  <span class="dp-el-pos">{e.pos}</span>
                  <span class="dp-el-flag">{e.flag}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="dp-panel" data-dp-panel={1} hidden>
            <div class="dp-panel-card">
              <div class="dp-panel-head"><span>Forecast · before it goes live</span><span class="dp-panel-sub">90-day projection</span></div>
              <div class="dp-sc-tabs"><span class="dp-sc-tab">Match competitor</span><span class="dp-sc-tab is-on">Hold &amp; protect margin</span></div>
              <div class="dp-sc-body">
                <div class="dp-sc-top"><div><div class="dp-fc-k">RESULTING PRICE</div><div class="dp-sc-price">$27.49</div></div><span class="dp-sc-tag">+4.2% margin</span></div>
                {scBars.map(([k, w, c, v]) => (
                  <div class="dp-sc-bar"><span>{k}</span><span class="dp-sc-track"><span class="dp-sc-mid"></span><span class="dp-sc-fill" style={`width:${w}%;background:${c}`}></span></span><span class="dp-sc-v">{v}</span></div>
                ))}
                <p class="dp-sc-note">Inelastic demand — holding price protects margin with minimal volume loss.</p>
              </div>
            </div>
          </div>
          <div class="dp-panel" data-dp-panel={2} hidden>
            <div class="dp-panel-card">
              <div class="dp-panel-head"><span>Guardrails</span><span class="dp-saved">✓ Saved</span></div>
              <div class="dp-guard-grid">
                {guards.map(([k, v, kind]) => (
                  <div class="dp-guard"><div class="dp-fc-k">{k}</div><div class="dp-guard-v" style={kind === 'accent' ? 'color:var(--pl-accent-ink)' : kind === 'mono' ? 'font-family:var(--pl-font-mono);font-size:18px' : ''}>{kind === 'accent' && (<span class="dp-guard-dot"></span>)}{v}</div></div>
                ))}
              </div>
            </div>
            <div class="dp-moves">
              {moveData.map(([n, d, r, safe]) => (
                <div class="dp-move"><span class="dp-move-n">{n}</span><span class="dp-move-d">{d}</span><span class="dp-move-r" style={safe ? 'background:var(--pl-accent-tint);border-color:var(--pl-accent-line);color:var(--pl-accent-ink)' : 'background:var(--pl-warn-tint);border-color:var(--pl-warn-line);color:var(--pl-warn-ink)'}>{r}</span></div>
              ))}
              <div class="dp-moves-foot"><span style="color:var(--pl-accent-ink)">Safe → auto</span><span style="color:var(--pl-warn-ink)">Risky → review</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Outcome -->
  <section id="outcome" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>The outcome</span>
        <h2 class="mk-h2" style="max-width:820px"><span style="font-weight:400">What changes when pricing </span><span style="font-weight:700">becomes a decision</span></h2>
      </div>
      <div data-reveal class="dp-outcome">
        <div class="dp-out"><span class="dp-out-n">2–5<span style="color:var(--pl-accent)">%</span></span><span class="dp-out-l">sales growth</span><span class="dp-out-bar"><span style="width:50%"></span></span></div>
        <div class="dp-out"><span class="dp-out-n">5–10<span style="color:var(--pl-accent)">%</span></span><span class="dp-out-l">margin improvement</span><span class="dp-out-bar"><span style="width:100%"></span></span></div>
        <div class="dp-out dp-out--muted"><span class="dp-out-chip">[ VERIFY STAT ]</span><span class="dp-out-n dp-out-n--muted">~X%</span><span class="dp-out-l">e.g. manual pricing effort reduced by ~X%.</span></div>
      </div>
      <div class="dp-outcome-src">Retailers using dynamic pricing typically see these gains. <span style="font-family:var(--pl-font-mono);font-size:11.5px;color:var(--pl-faint)">(McKinsey &amp; Company)</span></div>
    </div>
  </section>

  <!-- CTA -->
  <section id="demo" class="mk-sec" style="padding:clamp(20px,3vw,28px) 0">
    <div class="dp-cta">
      <div aria-hidden="true" class="dp-cta-grid"></div>
      <div aria-hidden="true" class="dp-cta-glow"></div>
      <div data-reveal class="dp-cta-left">
        <h2 class="mk-h2" style="margin:0"><span style="font-weight:400">See the Price Decision Engine </span><span style="font-weight:700">on your catalog</span></h2>
        <p class="dp-cta-p">Bring your SKUs and channels — we'll show how the engine prices them and what it forecasts.</p>
        <p class="dp-cta-note">Enterprise rollouts and custom requirements scoped with our team.</p>
        <div class="mk-hero-cta"><a href="/contact" class="mk-btn-primary">Get a Demo</a><a href="/contact" class="mk-btn-ghost">Talk to sales</a></div>
      </div>
      <div data-reveal class="dp-cta-stack">
        {ctaStack.map((c) => (
          <div class="dp-cta-row"><span style="min-width:0"><span class="dp-cta-row-n">{c.n}</span><span class="dp-cta-row-ch">{c.ch}</span></span><span class="dp-cta-row-p">{c.p}</span><span class="dp-cta-row-s" style={`background:${c.tbg};color:${c.tc}`}>{c.s}</span></div>
        ))}
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Dynamic pricing software " titleBold="FAQ." />
</PriceLeapLayout>

<style>
  .dp-badge { height: 30px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-accent-ink); }
  .dp-badge-sq { width: 7px; height: 7px; border-radius: 2px; background: var(--pl-gradient); transform: rotate(45deg); }
  .dp-k { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-faint); }
  .dp-card { position: relative; background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 22px; box-shadow: 0 40px 80px -40px rgba(60,30,15,.3),0 0 0 6px rgba(255,255,255,.7); overflow: hidden; }
  .dp-card-head { display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-bottom: 1px solid var(--pl-line-soft); background: var(--pl-cream); }
  .dp-card-ico { width: 22px; height: 22px; border-radius: 6px; background: var(--pl-ink); display: flex; align-items: center; justify-content: center; }

        <div data-reveal class="ps-sticky" style="top:96px;display:flex;flex-direction:column;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>FAQ</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E"><span style="font-weight:400">Frequently asked </span><span style="font-weight:700">questions</span></h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          {fq.map((q, i) => (
            <div class="ps-faq" class:list={[{ 'is-open': i === 0 }]} data-ps-faq style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:16px;overflow:hidden;transition:border-color .25s">
              <button type="button" data-ps-faq-btn aria-expanded={i === 0 ? 'true' : 'false'} style="width:100%;border:none;background:transparent;cursor:pointer;display:flex;align-items:center;gap:14px;padding:18px 20px;text-align:left">
                <span class="ps-faq-n" style="font-family:'Geist Mono',monospace;font-size:11px;color:#B9A99C">{q.n}</span>
                <span style="flex:1;font-family:Geist,sans-serif;font-size:16.5px;font-weight:500;color:#1C130E">{q.q}</span>
                <span class="ps-faq-plus" style="flex:none;width:28px;height:28px;border-radius:8px;background:#FBF3EC;color:#1C130E;display:flex;align-items:center;justify-content:center;transition:all .3s"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"></path></svg></span>
              </button>
              <div class="ps-faq-panel"><div style="overflow:hidden"><p style="margin:0;padding:0 20px 20px 52px;font-size:15px;line-height:1.65;color:#3A302A">{q.a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 13 FINAL CTA -->
    <section style="padding:clamp(16px,3vw,28px)">
      <div style="position:relative;max-width:1280px;margin:0 auto;overflow:hidden;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:28px;padding:clamp(56px,8vw,96px) clamp(20px,4vw,48px);text-align:center">
        <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 10%,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 10%,transparent 75%)"></div>
        <div aria-hidden="true" style="position:absolute;left:50%;bottom:-220px;width:640px;height:400px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.14),transparent)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;align-items:center;gap:20px">
          <h2 style="margin:0;max-width:820px;font-family:Geist,sans-serif;font-size:clamp(30px,4.4vw,54px);line-height:1.05;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">See price scraping run on </span><span style="font-weight:700">your own competitor URLs</span></h2>
          <p style="margin:0;max-width:560px;font-size:17px;line-height:1.6;color:#3A302A">Bring a few product URLs to the demo. We'll walk through the setup and the data that comes back.</p>
          <a href="/book-a-demo" style="height:50px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .ps { background: #FFFCF9; overflow-x: clip; }
  @keyframes ps-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 9px rgba(247,99,30,0); } }
  @keyframes ps-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes ps-pop { 0% { opacity: 0; transform: scale(.92); } 100% { opacity: 1; transform: none; } }
  @keyframes ps-spin { to { transform: rotate(360deg); } }
  @keyframes ps-blink { 50% { opacity: 0; } }
  @keyframes ps-dash { to { stroke-dashoffset: -20; } }
  @keyframes ps-shimmer { 0% { background-position: -400px 0; } 100% { background-position: 400px 0; } }
  @media (prefers-reduced-motion: reduce) { .ps *, .ps *::before, .ps *::after { animation: none !important; transition: none !important; } }

  .ps-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .ps-hero { grid-template-columns: minmax(0,1fr) minmax(0,1.02fr); } }
  .ps-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .ps-split { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); } }
  .ps-sticky { position: static; }
  @media (min-width: 1024px) { .ps-sticky { position: sticky; } }
  .ps-radio { grid-template-columns: 1fr; }
  @media (min-width: 520px) { .ps-radio { grid-template-columns: 1fr 1fr; } }
  .ps-prob { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .ps-prob { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1100px) { .ps-prob { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .ps-how { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .ps-how { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); } }
  .ps-proof { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .ps-proof { grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); } }
  .ps-plans { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .ps-plans { grid-template-columns: repeat(3,minmax(0,1fr)); } }

  .ps-def { display: grid; grid-template-columns: 1fr; gap: 0; }
  .ps-def .ps-arrow-h { display: none; }
  .ps-def .ps-arrow { padding: 6px 0; }
  @media (min-width: 640px) { .ps-def { grid-template-columns: minmax(0,1fr) 64px minmax(0,1fr); } .ps-def .ps-arrow-h { display: block; } .ps-def .ps-arrow-v { display: none; } .ps-def .ps-arrow { padding: 0; } }

  .ps-cad-row { display: grid; grid-template-columns: 110px minmax(0,1fr); gap: 12px; }
  .ps-cad-wide { display: none; }
  @media (min-width: 720px) { .ps-cad-row { grid-template-columns: 150px minmax(0,1fr) 150px 130px; } .ps-cad-wide { display: block; } .ps-cad-narrow { display: none; } }

  .ps-bv-row { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
  .ps-bv-k { display: none; }
  @media (min-width: 720px) { .ps-bv-row { grid-template-columns: 170px minmax(0,1fr) minmax(0,1.15fr); } .ps-bv-k { display: block; } .ps-bv-kinline { display: none; } }
  .ps-bv-kinline { display: block; }

  /* stepper states */
  .ps-step.is-on { background: #FFF9F4; }
  .ps-step .ps-step-n { background: #FFFFFF; border: 1.5px solid #EFE3DA; color: #7F7066; }
  .ps-step.is-on .ps-step-n, .ps-step.is-done .ps-step-n { background: #1C130E; border-color: #1C130E; color: #FFFFFF; }
  .ps-step .ps-step-t { color: #3A302A; }
  .ps-step.is-on .ps-step-t { color: #1C130E; }
  .ps-step.is-done .ps-step-line { background: #1C130E; }
  .ps-step.is-on .ps-step-bar { display: block !important; }

  /* delivery tabs */
  .ps-dv.is-on { border-color: #FFD8BE; background: #FFFFFF; }
  .ps-dv.is-on .ps-dv-ic { background: #1C130E; color: #FFFFFF; }

  /* billing */
  .ps-bill.is-on { background: #1C130E; color: #FFFFFF; }

  /* faq */
  .ps-faq.is-open { border-color: #FFD8BE; }
  .ps-faq.is-open .ps-faq-plus { background: #1C130E; color: #FFFFFF; transform: rotate(45deg); }
  .ps-faq.is-open .ps-faq-n { color: #C2410C; }
  .ps-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .ps-faq.is-open .ps-faq-panel { grid-template-rows: 1fr; }

  /* scroll reveal */
  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.ps');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const stepsKey = ['prod', 'comp', 'sched', 'fetch', 'use'];
    const stepNotes = [
      'Products added to the group by URL, file or catalog.',
      'AI finds competitors, or you add your own domains and URLs.',
      'Schedule, timezone and ZIP code set per group.',
      'Runs on schedule. Fetch now re-runs a group on demand.',
      'Compare in the dashboard, set alerts and rules, or export.',
    ];
    const groupFetch = ['Today 9:02', 'Today 8:01', 'Today 15:03', 'Today 12:00'];

    // ---- hero demo ----
    const urlRows = qa('[data-ps-url]');
    const caret = q('[data-ps-caret]'), ta = q('[data-ps-ta]'), count = q('[data-ps-count]');
    const btn = q('[data-ps-btn]'), btnSpin = q('[data-ps-btn-spin]'), btnLabel = q('[data-ps-btn-label]'), found = q('[data-ps-found]');
    const paintHero = (phase: number) => {
      const nUrls = Math.min(4, phase + 1), finding = phase >= 5 && phase < 7, isFound = phase >= 7;
      urlRows.forEach((el, i) => { el.style.display = i < nUrls ? 'flex' : 'none'; });
      if (caret) caret.style.display = (!finding && !isFound) ? 'inline-block' : 'none';
      if (ta) { ta.style.borderColor = nUrls < 4 ? '#FFD8BE' : '#EFE3DA'; ta.style.boxShadow = nUrls < 4 ? '0 0 0 4px rgba(247,99,30,.08)' : 'none'; }
      if (count) count.textContent = String(nUrls);
      if (btnSpin) btnSpin.hidden = !finding;
      if (btn) btn.style.background = finding ? '#3A2C24' : '#1C130E';
      if (btnLabel) btnLabel.textContent = finding ? 'Finding competitors…' : isFound ? '✓ 3 competitors found' : 'Find competitors →';
      if (found) found.style.display = isFound ? 'flex' : 'none';
    };

    // ---- stepper + scheduler table ----
    const steps = qa('[data-ps-step]');
    const fills = qa('.ps-step-fill');
    const grows = qa('[data-ps-grow]');
    const menuEl = q('[data-ps-menu]');
    let step = 0, sp = 0, stepAuto = true;

    const paintTable = () => {
      const key = stepsKey[step];
      const hi = '#FFF4EC';
      qa('[data-hc]').forEach((el) => { el.style.color = el.getAttribute('data-hc') === key || (el.getAttribute('data-hc') === 'loc' && key === 'sched') ? '#C2410C' : '#7F7066'; });
      grows.forEach((row, i) => {
        row.style.background = (key === 'use' && i === 0) ? '#FFF9F4' : 'transparent';
        const sch = row.querySelector('[data-g="sch"]') as HTMLElement, prod = row.querySelector('[data-g="prod"]') as HTMLElement;
        const comp = row.querySelector('[data-g="comp"]') as HTMLElement, loc = row.querySelector('[data-g="loc"]') as HTMLElement;
        if (sch) { sch.style.borderColor = key === 'sched' ? '#FFD8BE' : '#EFE3DA'; sch.style.background = key === 'sched' ? hi : '#FFFFFF'; }
        if (prod) prod.style.background = key === 'prod' ? hi : 'transparent';
        if (comp) { comp.style.borderColor = key === 'comp' ? '#FFD8BE' : '#EFE3DA'; comp.style.background = key === 'comp' ? hi : '#FFFFFF'; }
        if (loc) { loc.style.borderColor = key === 'sched' ? '#FFD8BE' : '#EFE3DA'; loc.style.background = key === 'sched' ? hi : '#FFFFFF'; }
        const fetchCell = row.querySelector('[data-g="fetch"]') as HTMLElement;
        const spin = row.querySelector('[data-g-spin]') as HTMLElement, ftext = row.querySelector('[data-g-ftext]') as HTMLElement;
        const fetching = key === 'fetch' && i === 1, failed = key === 'fetch' && i === 3;
        if (spin) spin.hidden = !fetching;
        if (ftext) ftext.textContent = fetching ? 'Fetching…' : failed ? '1 failed fetch' : groupFetch[i];
        if (fetchCell) fetchCell.style.color = failed ? '#B42318' : fetching ? '#C2410C' : '#665A51';
      });
      if (menuEl) menuEl.hidden = !(key === 'sched' || key === 'fetch');
      qa('[data-ps-menu-i]').forEach((el, k) => {
        const on = (key === 'fetch' && k === 1) || (key === 'sched' && k === 3);
        el.style.background = on ? '#FFF4EC' : 'transparent';
        el.style.color = on ? '#C2410C' : '#1C130E';
      });
      const sn = q('[data-ps-stepno]'); if (sn) sn.textContent = String(step + 1);
      const nt = q('[data-ps-notetext]'); if (nt) nt.textContent = stepNotes[step];
    };
    const paintSteps = () => {
      steps.forEach((el, i) => {
        el.classList.toggle('is-on', i === step);
        el.classList.toggle('is-done', i < step);
        el.setAttribute('aria-pressed', String(i === step));
        const nEl = el.querySelector('.ps-step-n') as HTMLElement;
        if (nEl) nEl.textContent = i < step ? '✓' : String(i + 1);
      });
      fills.forEach((f, i) => { f.style.width = (i === step ? (stepAuto ? sp : 100) : 0) + '%'; });
      paintTable();
    };
    steps.forEach((el, i) => el.addEventListener('click', () => { step = i; sp = 0; stepAuto = false; paintSteps(); }));

    // ---- cadence clock ----
    const clockBars = qa('[data-ps-clockbar]'), clockMarks = qa('[data-ps-clockmark]'), runs = qa('[data-ps-run]');
    const clockLabel = q('[data-ps-clocklabel]');
    runs.forEach((r) => { r.style.left = r.getAttribute('data-ps-run') + '%'; });
    const paintClock = (now: number) => {
      const pct = now.toFixed(1) + '%';
      clockBars.forEach((b) => b.style.width = pct);
      clockMarks.forEach((m) => m.style.left = pct);
      runs.forEach((r) => { const ran = now >= Number(r.getAttribute('data-ps-run')); r.style.background = ran ? '#1C130E' : '#FFFFFF'; r.style.boxShadow = ran ? '0 0 0 1.5px #1C130E' : '0 0 0 1.5px #E2D3C8'; });
      const hrs = Math.floor(now / 100 * 24), mins = Math.floor((now / 100 * 24 - hrs) * 60);
      if (clockLabel) clockLabel.textContent = String(hrs).padStart(2, '0') + ':' + String(mins).padStart(2, '0');
    };

    // ---- the 280ms loop ----
    let tick = 0, now = 0;
    paintHero(0); paintSteps(); paintClock(0);
    setInterval(() => {
      tick++; now = (now + 0.35) % 100;
      paintHero(Math.floor(tick / 4) % 10);
      if (stepAuto) { sp += 4; if (sp >= 100) { sp = 0; step = (step + 1) % 5; paintSteps(); } else { fills.forEach((f, i) => { if (i === step) f.style.width = sp + '%'; }); } }
      paintClock(now);
    }, 280);

    // ---- delivery tabs ----
    const dvTitle = q('[data-ps-dvtitle]'), dvSub = q('[data-ps-dvsub]');
    const dvMeta = [['Price Intelligence', 'Every product, every competitor'], ['Exports', 'By product group or by product'], ['REST API', 'JSON · prices, groups, competitors, runs'], ['Analytics & BI', 'Send data out for analysis'], ['Alerts & collaboration', 'Where your team gets notified']];
    qa('[data-ps-dv]').forEach((el, i) => {
      const go = () => {
        qa('[data-ps-dv]').forEach((b, k) => b.classList.toggle('is-on', k === i));
        qa('[data-ps-dvpanel]').forEach((pnl, k) => (pnl as HTMLElement).style.display = k === i ? 'flex' : 'none');
        if (dvTitle) dvTitle.textContent = dvMeta[i][0];
        if (dvSub) dvSub.textContent = dvMeta[i][1];
      };
      el.addEventListener('mouseenter', go); el.addEventListener('click', go);
    });

    // ---- billing toggle ----
    qa('[data-ps-bill]').forEach((btn2) => btn2.addEventListener('click', () => {
      const annual = btn2.getAttribute('data-ps-bill') === 'annual';
      qa('[data-ps-bill]').forEach((b) => b.classList.toggle('is-on', b === btn2));
      qa('.ps-price').forEach((el) => el.textContent = el.getAttribute(annual ? 'data-annual' : 'data-monthly') || '');
      qa('.ps-note').forEach((el) => el.textContent = el.getAttribute(annual ? 'data-annual' : 'data-monthly') || '');
    }));

    // ---- faq ----
    qa('[data-ps-faq-btn]').forEach((btn3) => btn3.addEventListener('click', () => {
      const item = btn3.closest('[data-ps-faq]');
      const wasOpen = item?.classList.contains('is-open');
      qa('[data-ps-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-ps-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!wasOpen && item) { item.classList.add('is-open'); btn3.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- scroll reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

---
// Native Astro port of the design package's Price Scraping page.
// Static initial render + the full 280ms animation loop and interactions
// reimplemented in vanilla JS: hero "Add Products" typing/find-competitors demo,
// auto-advancing "How it works" stepper synced to the scheduler table (highlights,
// fetch spinners, context menu), animated cadence clock, delivery tabs, billing
// toggle and FAQ accordion. Same layout, colors and animations. Responsive via CSS.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const URLS = ['https://amazon.com/dp/B09XS7JWHH', 'https://walmart.com/ip/sony-wh1000xm5/62513', 'https://target.com/p/sony-wh-1000xm5/-/A-86523', 'https://bestbuy.com/site/sony-wh1000xm5/6505727.p'];
const urls = URLS.map((t, i) => ({ t, n: String(i + 1).padStart(2, '0') }));
const foundComps = [['Amazon', '#F59E0B'], ['Best Buy', '#3B82F6'], ['Target', '#EF4444']].map(([t, c], i) => ({ t, c, dl: (i * 0.12).toFixed(2) }));
const record = [['product', 'Sony WH-1000XM5'], ['retailer', 'bestbuy.com'], ['price', '329.99'], ['currency', 'USD'], ['stock', 'in_stock'], ['fetched_at', '2026-11-19 09:02']].map(([k, v]) => ({ k, v }));
const I: Record<string, string> = {
  tag: 'M3 12V3h9l9 9-9 9-9-9zM7.5 7.5h.01', box: 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10', chart: 'M3 3v18h18M7 15l4-4 3 3 5-6',
  clock: 'M12 22a10 10 0 1 0 0-20a10 10 0 1 0 0 20M12 6v6l4 2', link: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1', pos: 'M4 20V10M10 20V4M16 20v-8M22 20H2',
  grid: 'M3 3h18v18H3zM3 9h18M9 3v18', file: 'M6 2h9l5 5v15H6zM14 2v6h6M9 13h6M9 17h6', code: 'M8 6l-6 6 6 6M16 6l6 6-6 6', sheet: 'M4 3h16v18H4zM4 9h16M4 15h16M10 3v18', bell: 'M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21a2 2 0 0 0 4 0',
};
const stepsData = [
  ['Add products.', 'Paste product URLs, upload a file or connect your catalog.', 'prod', 'Products added to the group by URL, file or catalog.'],
  ['Choose competitors.', 'Let AI find competing products for the group, or add the competitor domains and URLs you already track.', 'comp', 'AI finds competitors, or you add your own domains and URLs.'],
  ['Set schedule and location.', 'Each product group gets its own refresh schedule, timezone and location: Auto, or a specific ZIP code.', 'sched', 'Schedule, timezone and ZIP code set per group.'],
  ['Collection runs in the background.', "Prices are fetched on schedule. Failed Fetches shows any product whose last check didn't return a price, and Fetch now re-runs a group on demand.", 'fetch', 'Runs on schedule. Fetch now re-runs a group on demand.'],
  ['Use the data.', 'Compare prices in the dashboard, set alerts and pricing rules, or export.', 'use', 'Compare in the dashboard, set alerts and rules, or export.'],
].map(([t, d, key, note]) => ({ t, d, key, note }));
const gData = [
  { ab: 'HP', n: 'Headphones_Monitor', av: '#7C5CDB', freq: 'EVERY DAY', time: '9:00 am New York', p: 48, c: '3 competitors', loc: 'Auto', f: 'Today 9:02' },
  { ab: 'TV', n: 'TV_Weekly_Promo', av: '#0E8FA3', freq: '2× DAILY', time: '8:00 · 20:00 PT', p: 22, c: '5 competitors', loc: '94105', f: 'Today 8:01' },
  { ab: 'KA', n: 'Kitchen_Appliances', av: '#D97706', freq: 'EVERY DAY', time: '3:00 pm London', p: 61, c: '4 competitors', loc: 'Auto', f: 'Today 15:03' },
  { ab: 'LP', n: 'Laptops_BackToSchool', av: '#E04A3A', freq: '3× DAILY', time: '6 · 12 · 18 CST', p: 35, c: '5 competitors', loc: '60601', f: 'Today 12:00' },
];
const menu = [['◉', 'View in Price Intelligence', false], ['↻', 'Re-run / Fetch now', false], ['⌁', 'Manage competitors', true], ['⌖', 'Set ZIP code', false], ['✎', 'Edit rules & alerts', false]].map(([i, t, ai], k) => ({ i, t, ai, bt: k === 1 ? '1px solid #F5ECE5' : 'none' }));
const fields = [
  ["your current price and each competitor's price, in the listing's currency", 'tag'],
  ['stock status, for your store and for competitors', 'box'],
  ['price history over 14 days, 30 days, 90 days, a year, or the full record', 'chart'],
  ['when each product was last fetched, and when each competitor listing was last seen', 'clock'],
  ['the source URL, with a link back to the page', 'link'],
  ['position vs market: cheapest, or how far above or below the market you sit', 'pos'],
].map(([t, k], i, a) => ({ t, ico: I[k], last: i === a.length - 1 }));
const ownFields = ['SKU', 'UPC', 'GTIN', 'MPN', 'product cost', 'MAP', 'MSRP'];
const sample = [
  ['Sony WH-1000XM5', 'Amazon', '#F59E0B', '$328.00', 'IN STOCK', 'Today 9:02'],
  ['Sony WH-1000XM5', 'Best Buy', '#3B82F6', '$349.99', 'IN STOCK', 'Today 9:02'],
  ['Bose QC Ultra', 'Target', '#EF4444', '$399.99', 'OOS', 'Today 9:03'],
  ['AirPods Max', 'Walmart', '#2563EB', '$549.00', 'IN STOCK', 'Today 9:03'],
].map(([p, c, dc, pr, st, t], i) => ({ p, c, dc, pr, s: st, t, sb: st === 'OOS' ? '#FDECEB' : '#E9F6EE', sc: st === 'OOS' ? '#B42318' : '#1E7A3D', dl: (i * 0.08).toFixed(2) }));
const cad: [string, string, string, string, number[]][] = [['Starter', '1x daily', '1,500', '50', [37.5]], ['Growth', '2x daily', '3,000', '100', [33.3, 83.3]], ['Scale', '3x daily', '6,000', '200', [25, 50, 75]]];
const cadence = cad.map(([plan, refresh, month, day, xs], i) => ({ plan, refresh, month, day, last: i === 2, xs }));
const deliveryData = [
  ['The Price Intelligence dashboard shows every product with your price, competitor prices, position and last fetch.', 'grid'],
  ['Download CSV exports by product group or by product.', 'file'],
  ['Pull prices, groups, competitors and runs as JSON through the REST API.', 'code'],
  ['Connect Google Sheets or Excel and push price data to a workbook. Workspaces with Power BI enabled get embedded reports.', 'sheet'],
  ['Price change and competitor stock-out alerts go out by email, Slack or in-app. Webhook alerts are on Growth and Scale.', 'bell'],
].map(([t, k]) => ({ t, ico: I[k] }));
const DV = [
  { title: 'Price Intelligence', sub: 'Every product, every competitor', rows: [['SN', 'Sony WH-1000XM5', '', 'Your $329.99 · Amazon $328.00 · Best Buy $349.99', 'Competitive', '#1C130E', '#FFFFFF'], ['BO', 'Bose QC Ultra', '', 'Your $429.00 · Target $399.99', 'Premium', '#FBF3EC', '#3A302A'], ['AP', 'AirPods Max', '', 'Your $549.00 · Walmart $549.00', 'At market', '#FBF3EC', '#3A302A']] },
  { title: 'Exports', sub: 'By product group or by product', rows: [['CSV', 'headphones_monitor.csv', 'GROUP', '48 products · 3 competitors each', '↓ Download', '#FBF3EC', '#3A302A'], ['CSV', 'sony-wh-1000xm5.csv', 'PRODUCT', 'Full price history · 90 days', '↓ Download', '#FBF3EC', '#3A302A']] },
  { title: 'REST API', sub: 'JSON · prices, groups, competitors, runs', rows: [['GET', '/v1/prices', 'JSON', 'Latest price per product and competitor', '200 OK', '#1C130E', '#FFFFFF'], ['GET', '/v1/groups', 'JSON', 'Groups, schedules and locations', '200 OK', '#1C130E', '#FFFFFF'], ['GET', '/v1/runs', 'JSON', 'Fetch runs and failed fetches', '200 OK', '#1C130E', '#FFFFFF']] },
  { title: 'Analytics & BI', sub: 'Send data out for analysis', rows: [['GS', 'Google Sheets', 'OAUTH 2.0', 'Export price data and reports automatically', 'Connect', '#E7F6EC', '#1E7A3D'], ['XL', 'Microsoft Excel', 'GRAPH API', 'Push pricing data to Excel workbooks', 'Connect', '#E6F0EA', '#185C37'], ['BI', 'Power BI', 'EMBEDDED', 'Embedded reports for enabled workspaces', 'Enabled', '#FDF5E1', '#8A6100']] },
  { title: 'Alerts & collaboration', sub: 'Where your team gets notified', rows: [['@', 'Email', 'CONNECTED', 'Price alerts and digest reports to any team inbox', 'Settings', '#F3EEFB', '#6B3FA0'], ['#', 'Slack', '', 'Price and competitor stock-out alerts to a channel', 'Connect', '#F6EEF4', '#7A3E6B'], ['⇢', 'Webhooks', 'GROWTH · SCALE', 'Send alerts to your own endpoint', 'Connect', '#FBF3EC', '#3A302A']] },
];
const bv = [
  ['Setup', 'A scraper per site', 'Paste URLs, upload a file or connect a catalog'],
  ['Competitors', 'You find and list them', 'AI discovery, or your own list'],
  ['Schedule', 'Cron jobs you maintain', 'Per-group schedule, up to 3x daily'],
  ['Location', 'Proxies per region', 'ZIP code per product group'],
  ['Failures', 'Found when the data looks wrong', 'Failed Fetches on the dashboard, Fetch now to re-run'],
  ['Output', 'Raw HTML to clean', 'Dashboard, CSV, REST API'],
  ['Cost', '[engineer hours + proxies + hosting]', 'Plans from $89/month'],
].map(([k, a, b], i, arr) => ({ k, a, b, last: i === arr.length - 1 }));
const plans = [
  ['Starter', '$89', '$71', ['1,500 products a month', 'Refreshed once a day'], false],
  ['Growth', '$159', '$127', ['3,000 products a month', 'Refreshed twice a day', 'Webhook alerts'], true],
  ['Scale', '$299', '$239', ['6,000 products a month', 'Refreshed three times a day', 'Webhook alerts'], false],
].map(([n, m, a, f, pop]) => ({ n, f: f as string[], pop: pop as boolean, m: m as string, a: a as string }));
const fq = [
  ['What is price scraping software?', 'Price scraping software collects prices from competitor product pages automatically and stores them as structured data. In priceleap.ai, you add product URLs, then let AI find competitors or add your own, and set a schedule. Collection runs in the background. Every product then shows price, stock status and when it was last checked.'],
  ['Is price scraping legal?', "Collecting publicly listed prices is common practice in retail. The rules still depend on the country, the site's terms and how the data is collected, so check with your legal team for your markets. priceleap.ai collects prices from the public product pages you add."],
  ['How often does priceleap.ai check competitor prices?', 'It depends on your plan. Starter refreshes once a day, Growth twice a day and Scale three times a day. Each product group has its own schedule and timezone. You can run Fetch now for a fresh check before a pricing decision, and every product shows its last fetch time.'],
  ['Should we build our own price scraper or buy software?', 'Building can work for a handful of stable sites, if an engineer has time to maintain the code. Once you track many retailers, most of the effort goes into broken selectors, blocks and cleanup. Price scraping software moves that work out of your sprint, so analysts spend their time on prices instead of scripts.'],
  ['How do I get scraped price data out of priceleap.ai?', 'Most teams start in the Price Intelligence dashboard. You can also download CSV exports by product group or product, or pull prices, groups, competitors and runs as JSON through the REST API. Other options: connect Google Sheets or Excel, or view embedded Power BI reports if your workspace has Power BI enabled.'],
  ['How is Price Scraping different from Competitive Data?', 'Price Scraping is the collection setup: the URLs, competitors, schedules and locations you configure, and the prices that come back. Competitive Data [confirm scope, e.g. competitor listings matched to your SKUs]. A demo will show which fits your catalog.'],
].map(([q, a], i) => ({ q, a, n: String(i + 1).padStart(2, '0') }));
---
<PriceLeapLayout
  title="Price Scraping Software for Competitor Prices · PriceLeap"
  description="priceleap.ai is price scraping software for pricing and ecommerce teams. Add product pages, choose competitors and locations, and prices are collected on your schedule."
>
  <div class="ps">
    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.09),transparent);pointer-events:none"></div>
      <div class="ps-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(44px,6vw,88px) clamp(16px,4vw,40px) clamp(48px,6vw,88px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:50%;background:#F7631E;animation:ps-pulse 1.8s ease-out infinite"></span>Price scraping</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,5vw,64px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Price scraping software</span><span style="font-weight:400"> for competitor prices</span></h1>
          <p style="margin:0;max-width:580px;font-size:18px;line-height:1.6;color:#3A302A;text-wrap:pretty">priceleap.ai is price scraping software for pricing and ecommerce teams. Add the product pages you want to watch, choose competitors and locations, and the platform collects prices on the schedule you set.</p>
          <p style="margin:0;max-width:580px;font-size:16px;line-height:1.6;color:#665A51">No scraper code to write, and nothing to maintain on your side.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {['Up to 3x daily refresh', 'ZIP code checks per product group', 'CSV export and REST API'].map((t) => (
              <span style="height:32px;padding:0 12px;display:inline-flex;align-items:center;gap:8px;border-radius:9px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:13px;color:#1C130E"><span style="width:6px;height:6px;border-radius:50%;background:#F7631E"></span>{t}</span>
            ))}
          </div>
        </div>

        <figure style="margin:0;min-width:0;display:flex;flex-direction:column;gap:12px">
          <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:20px;overflow:hidden;box-shadow:0 44px 84px -50px rgba(60,30,15,.4),0 0 0 6px rgba(255,255,255,.7)">
            <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
              <span style="font-size:13.5px;font-weight:600;color:#1C130E">Add Products</span>
              <span style="width:1px;height:14px;background:#EFE3DA"></span>
              <span style="font-size:12px;color:#7F7066;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">AI tracks pricing, finds competitors and monitors their prices.</span>
            </div>
            <div style="padding:14px 16px 0;display:flex;gap:18px;border-bottom:1px solid #F5ECE5">
              <span style="padding-bottom:10px;border-bottom:2px solid #1C130E;font-size:13px;font-weight:500;color:#1C130E">Paste URLs</span>
              <span style="padding-bottom:10px;font-size:13px;color:#7F7066">Upload file</span>
              <span style="padding-bottom:10px;font-size:13px;color:#7F7066">Connect catalog</span>
            </div>
            <div style="padding:14px 16px;display:flex;flex-direction:column;gap:12px">
              <div data-ps-ta style="min-height:118px;border:1px solid #FFD8BE;border-radius:12px;padding:12px 14px;font-family:'Geist Mono',monospace;font-size:12px;line-height:1.75;color:#1C130E;transition:border-color .3s;box-shadow:0 0 0 4px rgba(247,99,30,.08)">
                {urls.map((u, i) => (
                  <div data-ps-url={i} style={`display:${i === 0 ? 'flex' : 'none'};align-items:center;gap:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;animation:ps-in .35s ease`}><span style="color:#B9A99C">{u.n}</span>{u.t}</div>
                ))}
                <span data-ps-caret style="display:inline-block;width:7px;height:14px;background:#F7631E;vertical-align:-2px;animation:ps-blink 1s steps(1) infinite"></span>
              </div>
              <div class="ps-radio" style="display:grid;gap:8px">
                <div style="border:1.5px solid #FFD8BE;background:#FFF9F4;border-radius:12px;padding:11px 12px;display:flex;flex-direction:column;gap:4px">
                  <div style="display:flex;align-items:center;gap:8px"><span style="width:14px;height:14px;border-radius:50%;border:4px solid #1C130E;background:#FFFFFF"></span><span style="font-size:13px;font-weight:600;color:#1C130E">Find &amp; monitor competitors</span><span style="margin-left:auto;height:18px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:#FFFFFF;border:1px solid #FFD8BE;font-family:'Geist Mono',monospace;font-size:9px;color:#C2410C">AI</span></div>
                  <span style="font-size:11.5px;line-height:1.45;color:#665A51">AI discovers competing products for the group.</span>
                </div>
                <div style="border:1px solid #EFE3DA;border-radius:12px;padding:11px 12px;display:flex;flex-direction:column;gap:4px">
                  <div style="display:flex;align-items:center;gap:8px"><span style="width:14px;height:14px;border-radius:50%;border:1.5px solid #D7C6BA"></span><span style="font-size:13px;font-weight:600;color:#1C130E">Track your product URLs</span></div>
                  <span style="font-size:11.5px;line-height:1.45;color:#665A51">Assign competitor domains or URLs later.</span>
                </div>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 16px;border-top:1px solid #F5ECE5;background:#FFF9F4">
              <span style="font-size:12px;color:#665A51">Adding <b data-ps-count style="color:#1C130E">1</b> items to</span>
              <span style="height:28px;padding:0 10px;display:flex;align-items:center;border-radius:8px;border:1px solid #EFE3DA;background:#FFFFFF;font-family:'Geist Mono',monospace;font-size:11px;color:#1C130E">Headphones_Monitor</span>
              <span data-ps-btn style="margin-left:auto;height:34px;padding:0 14px;display:flex;align-items:center;gap:8px;border-radius:10px;background:#1C130E;color:#FFFFFF;font-size:12.5px;font-weight:500;transition:background .3s"><span data-ps-btn-spin hidden style="width:12px;height:12px;border-radius:50%;border:2px solid rgba(255,255,255,.35);border-top-color:#FFFFFF;animation:ps-spin .8s linear infinite"></span><span data-ps-btn-label>Find competitors →</span></span>
            </div>
            <div data-ps-found hidden style="align-items:center;gap:8px;flex-wrap:wrap;padding:12px 16px;border-top:1px solid #F5ECE5;animation:ps-in .4s ease">
              <span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.06em;color:#7F7066">COMPETITORS FOUND</span>
              {foundComps.map((c) => (
                <span style={`height:24px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:999px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:12px;color:#1C130E;animation:ps-pop .3s ease ${c.dl}s both`}><span style={`width:6px;height:6px;border-radius:50%;background:${c.c}`}></span>{c.t}</span>
              ))}
            </div>
          </div>
          <figcaption style="font-size:13px;color:#7F7066;text-align:center">Add products by URL, file or catalog, then let AI find the competitors to track.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 DEFINITION -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div class="ps-split" style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:center">
        <div data-reveal style="display:flex;flex-direction:column;gap:18px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The basics</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">What is </span><span style="font-weight:700">price scraping software?</span></h2>
          <p style="margin:0;font-size:17px;line-height:1.7;color:#3A302A;text-wrap:pretty">Price scraping software collects prices from retailer and marketplace product pages on a schedule. It turns them into structured records you can sort, compare and export.</p>
          <p style="margin:0;font-size:17px;line-height:1.7;color:#3A302A;text-wrap:pretty">It replaces manual checks and in-house scripts for competitor price scraping. Scraping is the collection step; price monitoring is what you do with the data afterwards.</p>
          <p style="margin:0;font-size:17px;line-height:1.7;color:#3A302A;text-wrap:pretty">In priceleap.ai, both live in one workspace. Collected prices go into the <a href="/price-intelligence-engine" style="font-weight:500;text-decoration:underline;text-underline-offset:3px">Price Intelligence dashboard</a>, <a href="#" style="font-weight:500;text-decoration:underline;text-underline-offset:3px">price alerts</a> and <a href="/dynamic-pricing-software" style="font-weight:500;text-decoration:underline;text-underline-offset:3px">pricing rules</a>.</p>
        </div>
        <div data-reveal class="ps-def" style="position:relative;align-items:center">
          <div style="background:#FFF9F4;border:1px solid #EFE3DA;border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:10px">
            <span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:#7F7066">PRODUCT PAGE · RETAILER</span>
            <div style="height:76px;border-radius:10px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 7px,#FFFCF9 7px 14px)"></div>
            <span style="font-size:13px;font-weight:600;color:#1C130E">Sony WH-1000XM5 Wireless</span>
            <div style="display:flex;align-items:center;gap:8px"><span style="padding:2px 6px;border-radius:6px;outline:1.5px dashed #F7631E;font-family:Geist,sans-serif;font-size:18px;font-weight:600;color:#1C130E">$329.99</span><span style="font-size:11px;color:#2E7D4F">In stock</span></div>
            <span style="height:8px;width:70%;border-radius:4px;background:#F5ECE5"></span>
            <span style="height:8px;width:50%;border-radius:4px;background:#F5ECE5"></span>
          </div>
          <div aria-hidden="true" class="ps-arrow" style="display:flex;align-items:center;justify-content:center">
            <svg class="ps-arrow-h" width="64" height="20" viewBox="0 0 64 20" style="overflow:visible"><path d="M0,10 L64,10" fill="none" stroke="#E2D3C8" stroke-width="1.5"></path><path d="M0,10 L64,10" fill="none" stroke="#F7631E" stroke-width="1.5" stroke-dasharray="4 8" style="animation:ps-dash 1s linear infinite"></path></svg>

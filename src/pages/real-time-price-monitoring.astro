---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';
import Faq from '../components/pl/Faq.astro';
import '../styles/pl-marketing.css';

const heroRows = [
  { ab: 'AM', n: 'Amazon · Buy Box', type: 'JS-RENDER', price: '$179.00', matched: true },
  { ab: 'WM', n: 'Walmart Marketplace', type: 'API', price: '$182.50', matched: true },
  { ab: 'BB', n: 'Best Buy', type: 'HTML', price: '$184.99', matched: true },
  { ab: 'TG', n: 'Target', type: 'JS-RENDER', price: 'Rendering', matched: false },
  { ab: 'NE', n: 'Newegg', type: 'HTML', price: '$176.40', matched: true },
];
const customers = [...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank', 'Shopify', 'Flipkart', 'eBay', 'Target'], ...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank']];
const retailRows = [
  { n: 'You', p: '$129.00', tag: 'YOU', on: true }, { n: 'Rival A', p: '$124.90', tag: '', on: false },
  { n: 'Rival B', p: '$133.00', tag: '', on: false }, { n: 'Marketplace', p: '$119.99', tag: 'LOWEST', on: false },
];
const brandRows = [
  { n: 'Authorized · North', p: '$179.00', tag: 'OK', ok: true }, { n: 'Reseller X', p: '$164.00', tag: 'MAP −8%', ok: false },
  { n: 'Marketplace seller', p: '$171.50', tag: 'MAP −4%', ok: false }, { n: 'Authorized · EU', p: '€179.00', tag: 'OK', ok: true },
];
const engine = [
  { n: '01', t: 'Collect through bot defenses', d: 'Rotating proxies and managed fingerprints make requests look like ordinary shopper traffic — no blocks, no footprint tied to you.' },
  { n: '02', t: 'Render JavaScript-heavy pages', d: 'Headless rendering reads prices that only load via JavaScript or after a click, including Buy Box and dynamic listings.' },
  { n: '03', t: 'Match to your catalog', d: 'Every price is matched to the right product — by EAN/UPC, attributes or image — down to the variant, with human review on the rest.' },
  { n: '04', t: 'Validate and self-heal', d: 'The extractor self-heals when a page is redesigned, and anomaly checks stop broken or implausible values from ever reaching you.' },
  { n: '05', t: 'Deliver decision-ready', d: 'Clean, timestamped data lands however you work — API, export, S3, Snowflake or webhook — ready to price against.' },
];
const monday = [
  'Priority SKUs already refreshed before the team logs in.',
  'Overnight competitor moves and promotions flagged and waiting.',
  'MAP violations recorded with seller, price and timestamp.',
  'Price-position dashboard current, not a day old.',
];
const baList = [
  'Every competitor price matched and timestamped automatically.',
  'Promotions and out-of-stocks caught as they happen.',
  'Bot-protected and JS-heavy sites covered, not skipped.',
  'Clean data pushed straight into your stack.',
];
const faqs = [
  { q: "Can competitors tell we're monitoring them?", a: 'No. Collection runs through rotating proxies and managed fingerprints, so requests look like ordinary shopper traffic and are not tied back to your company.' },
  { q: 'How fresh is the data, really?', a: 'Refresh is guaranteed by tier: priority SKUs every [X], standard catalog every [Y]. Every data point carries a timestamp so you can see exactly how old it is.' },
  { q: 'Can you match products with no EAN or UPC?', a: 'Yes. We match by EAN/UPC, attributes and image, handle pack-size and variant differences, and send every uncertain match to human review.' },
  { q: 'Do you handle bot-protected and JavaScript-heavy sites?', a: 'Yes. Headless rendering reads prices that load via JavaScript or after a click, and rotating proxies clear bot defenses on sites including Amazon and Cloudflare-protected stores.' },
  { q: 'What happens when a competitor changes their site?', a: 'The extractor self-heals when a page is redesigned, and anomaly checks stop broken or implausible values from reaching you. You never receive silent blanks.' },
  { q: 'Can we get the data into our own stack?', a: 'Yes. Take the data however you work: API, export, S3, Snowflake or webhook.' },
  { q: 'Will it scale from hundreds to millions of SKUs?', a: 'Yes. Coverage scales with your catalog, with billions of SKUs already under coverage and refresh tiers that keep priority SKUs fast as volume grows.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Real-Time Price Monitoring', provider: { '@type': 'Organization', name: 'PriceLeap' }, url: 'https://priceleap.ai/real-time-price-monitoring' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PriceLeapLayout title="Real-Time Price Monitoring · PriceLeap" description="PriceLeap pulls live e-commerce prices from the sites you compete on, refreshing priority SKUs continuously. Clean, matched, decision-ready data." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="mk-hero">
    <div aria-hidden="true" class="mk-hero-lines"></div>
    <div aria-hidden="true" class="mk-hero-glow"></div>
    <div class="mk-hero-inner">
      <div style="min-width:0">
        <nav class="rt-crumbs"><a href="/">Product</a><span>/</span><span class="rt-crumb-cur">Real-Time Price Monitoring</span></nav>
        <span class="mk-eyebrow" style="margin-top:28px"><span class="rt-eye-dot"></span>Real-Time Price Monitoring</span>
        <h1 class="mk-h1"><span style="font-weight:400">The data engine behind </span><span style="font-weight:700">every price decision you trust</span></h1>
        <p class="mk-sub">PriceLeap pulls live e-commerce prices from the sites you actually compete on, refreshing priority SKUs every [X minutes]. You get clean, matched, decision-ready data — not a scrape that breaks the moment a competitor changes their page.</p>
        <div class="mk-hero-cta"><a href="/contact" class="mk-btn-primary">Book a demo</a><a href="#engine" class="mk-btn-text">How the engine works<span style="color:var(--pl-accent-ink)">→</span></a></div>
      </div>
      <div style="position:relative;min-width:0">
        <div class="rt-card">
          <div class="rt-card-head"><span class="fr-dots3"><span></span><span></span><span></span></span><span class="rt-card-title">Live collection</span><span class="rt-card-sku">· Sonix ANC 700</span><span class="rt-card-live"><span class="mk-live-dot"></span>LIVE</span></div>
          <div class="rt-table">
            <div class="rt-table-head"><span>SOURCE</span><span>TYPE</span><span style="text-align:right">STATUS</span></div>
            {heroRows.map((r) => (
              <div class="rt-row">
                <span class="rt-src"><span class="rt-ab">{r.ab}</span><span class="rt-n">{r.n}</span></span>
                <span class="rt-type">{r.type}</span>
                <span class="rt-status">{r.matched ? (<><span class="rt-price">{r.price}</span><span class="rt-matched">✓ MATCHED</span></>) : (<span class="rt-rendering"><span class="rt-spin"></span>Rendering</span>)}</span>
              </div>
            ))}
          </div>
          <div class="rt-kpis">
            <div class="rt-kpi"><div class="rt-kpi-k">PAGES TODAY</div><div class="rt-kpi-v">48,210</div></div>
            <div class="rt-kpi"><div class="rt-kpi-k">LAST CHANGE</div><div class="rt-kpi-v">2m ago</div></div>
            <div class="rt-kpi"><div class="rt-kpi-k">PRIORITY TIER</div><div class="rt-kpi-v" style="color:var(--pl-accent-ink)">every [X]</div></div>
          </div>
        </div>
        <div class="rt-float rt-float--bl"><span class="rt-float-ico">◈</span><div><div class="rt-float-t">Bot defense cleared</div><div class="rt-float-d">Headless render · rotating proxy</div></div></div>
        <div class="rt-float-tr"><span class="mk-blink"></span>Self-healed · page layout changed</div>
      </div>
    </div>
  </section>

  <!-- Basics -->
  <section id="basics" class="mk-sec">
    <div class="mk-split mk-split--center">
      <div data-reveal>
        <span class="mk-eyebrow"><span class="mk-sq"></span>The basics</span>
        <h2 class="mk-h2"><span style="font-weight:400">What is </span><span style="font-weight:700">real-time price monitoring?</span></h2>
        <p class="rt-basics-p">Real-time price monitoring is the continuous collection of competitor prices, promotions and stock status from the sites where your products are sold. Instead of checking a handful of pages by hand, software captures every change as it happens, matches it to your catalogue, and shows where you stand on each SKU.</p>
      </div>
      <div data-reveal class="rt-basics-card">
        <div class="rt-basics-head"><div><div class="rt-basics-t">One competitor, one day</div><div class="rt-basics-s">08:00 – 20:00 · EARBUDS PRO 2</div></div><div class="rt-basics-legend"><span><span class="rt-dot" style="background:var(--pl-faint)"></span>Manual check</span><span><span class="rt-dot" style="background:var(--pl-gradient)"></span>Continuous</span></div></div>
        <div class="rt-basics-chart">
          <svg viewBox="0 0 560 220" style="display:block;width:100%;height:auto;overflow:visible">
            <line x1="0" y1="60" x2="560" y2="60" stroke="#F5ECE5"></line><line x1="0" y1="120" x2="560" y2="120" stroke="#F5ECE5"></line><line x1="0" y1="180" x2="560" y2="180" stroke="#F5ECE5"></line>
            <path d="M0,70 L120,70 L120,130 L200,130 L200,70 L320,70 L320,150 L380,150 L380,100 L470,100 L470,70 L560,70" fill="none" stroke="#1C130E" stroke-width="2.5"></path>
            <g><circle cx="160" cy="130" r="7" fill="#F7631E" stroke="#FFFFFF" stroke-width="2"></circle><rect x="122" y="144" width="76" height="20" rx="5" fill="#FFF4EC" stroke="#FFD8BE"></rect><text x="160" y="158" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#C2410C">PROMO −12%</text></g>
            <g><circle cx="350" cy="150" r="7" fill="#F7631E" stroke="#FFFFFF" stroke-width="2"></circle><rect x="306" y="164" width="88" height="20" rx="5" fill="#FFF4EC" stroke="#FFD8BE"></rect><text x="350" y="178" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#C2410C">PRICE CUT −18%</text></g>
            <g><circle cx="425" cy="100" r="7" fill="#F7631E" stroke="#FFFFFF" stroke-width="2"></circle><rect x="384" y="72" width="82" height="20" rx="5" fill="#FFF4EC" stroke="#FFD8BE"></rect><text x="425" y="86" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#C2410C">OUT OF STOCK</text></g>
          </svg>
          <div class="rt-chart-x"><span>08:00</span><span>12:00</span><span>16:00</span><span>20:00</span></div>
        </div>
        <div class="rt-basics-foot"><div class="rt-basics-cell"><div class="rt-basics-cell-k">MANUAL</div><div>1 check · <span style="color:var(--pl-danger-ink)">3 changes missed</span></div></div><div class="rt-basics-cell rt-basics-cell--on"><div class="rt-basics-cell-k" style="color:var(--pl-accent-ink)">PRICELEAP</div><div>Continuous · <span style="color:var(--pl-accent-ink)">3 of 3 caught</span></div></div></div>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section id="who" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Who it's for</span>
        <h2 class="mk-h2"><span style="font-weight:400">Who should be </span><span style="font-weight:700">using it?</span></h2>
        <p class="mk-center-p">Any business that sells online against competitors or through resellers. Whether you set your own prices or protect how others price your products, the same live data drives the decision.</p>
      </div>
      <div data-reveal class="rt-who">
        <div class="rt-who-card">
          <div class="rt-who-viz">
            <div class="rt-who-mini"><div class="rt-who-mini-head"><span>SHARED SKU · EARBUDS PRO 2</span><span style="color:var(--pl-accent-ink)">UPDATED 3M AGO</span></div>
              {retailRows.map((r) => (<div class="rt-who-row" style={r.on ? 'background:var(--pl-accent-tint)' : ''}><span style={`font-weight:${r.on ? 600 : 400}`}>{r.n}</span>{r.tag && (<span class="rt-who-tag" style={r.tag === 'LOWEST' ? 'background:var(--pl-cream);color:var(--pl-ink-2)' : 'background:var(--pl-ink);color:var(--pl-surface)'}>{r.tag}</span>)}<span class="rt-who-p">{r.p}</span></div>))}
            </div>
          </div>
          <div class="rt-who-body"><span class="rt-who-k">For retailers</span><h3>Price monitoring for Retailers</h3>
            <div class="rt-who-list">{['See every competitor price on the SKUs you share, updated through the day.', 'Catch promotions and out-of-stocks early enough to respond.', 'Reprice with confidence instead of guessing where the market is.'].map((t) => (<span><span class="rt-who-check">✓</span>{t}</span>))}</div>
          </div>
        </div>
        <div class="rt-who-card">
          <div class="rt-who-viz">
            <div class="rt-who-mini"><div class="rt-who-mini-head"><span>RESELLERS · SONIX ANC 700</span><span style="color:var(--pl-ink)">MAP $179.00</span></div>
              {brandRows.map((r) => (<div class="rt-who-row"><span style="min-width:0">{r.n}</span><span class="rt-who-tag" style={r.ok ? 'background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);color:var(--pl-accent-ink)' : 'background:var(--pl-danger-tint);border:1px solid var(--pl-danger-line);color:var(--pl-danger-ink)'}>{r.tag}</span><span class="rt-who-p" style={r.ok ? '' : 'color:var(--pl-danger-ink)'}>{r.p}</span></div>))}
            </div>
          </div>
          <div class="rt-who-body"><span class="rt-who-k">For brands &amp; manufacturers</span><h3>Price monitoring for Brands</h3>
            <div class="rt-who-list">{['Track how every reseller and marketplace seller prices your products.', 'Detect MAP violations with the seller, price and timestamp recorded.', 'Protect price positioning and channel relationships across regions.'].map((t) => (<span><span class="rt-who-check">✓</span>{t}</span>))}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customers -->
  <section class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="rt-cust-head">
        <h2 class="rt-cust-h2"><span style="font-weight:400">Who is </span><span style="font-weight:700">already using it?</span></h2>
        <span class="rt-cust-note"><span class="rt-eye-dot"></span>MONITORING LIVE FOR THESE TEAMS</span>
      </div>
      <div data-reveal class="rt-cust-grid">{customers.slice(0, 10).map((l) => (<div class="rt-cust-cell">{l}</div>))}</div>
    </div>
  </section>

  <!-- Problem -->
  <section id="problem" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal style="max-width:760px">
        <span class="mk-eyebrow mk-eyebrow--danger"><span class="mk-sq mk-sq--danger"></span>The problem</span>
        <h2 class="mk-h2"><span style="font-weight:400">Wrong data costs </span><span style="font-weight:700">more than no data.</span></h2>
        <p class="rt-basics-p">A scrape that silently breaks, a match that's slightly off, a price that's a day stale — each one quietly sends your team the wrong signal. Decisions made on bad data are worse than decisions made on none, because nobody knows to double-check them.</p>
      </div>
      <div data-reveal class="rt-prob-grid">
        {[['Silent blanks', 'A broken extractor returns nothing, and nobody notices until a decision is already wrong.'], ['Stale prices', "Yesterday's price looks live, so you reprice against a number the market has already left behind."], ['Bad matches', 'A lookalike product gets matched to yours, and your whole price index drifts.'], ['Patchy coverage', 'Bot-protected and JS-heavy sites get skipped, so your biggest competitors are invisible.']].map(([t, d]) => (
          <div class="rt-prob-card"><span class="rt-prob-x">✕</span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engine -->
  <section id="engine" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>How the engine works</span>
        <h2 class="mk-h2" style="max-width:860px"><span style="font-weight:400">Five things go right </span><span style="font-weight:700">before a price reaches you.</span></h2>
      </div>
      <div data-reveal class="rt-engine">
        {engine.map((e) => (
          <div class="rt-engine-step"><span class="rt-engine-n">{e.n}</span><div class="rt-engine-body"><h3>{e.t}</h3><p>{e.d}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Monday morning -->
  <section id="monday" class="mk-sec mk-cream">
    <div class="mk-split mk-split--center">
      <div data-reveal>
        <span class="mk-eyebrow"><span class="mk-sq"></span>Monday morning</span>
        <h2 class="mk-h2"><span style="font-weight:400">What changes on </span><span style="font-weight:700">Monday morning.</span></h2>
        <p class="rt-basics-p">The work happens overnight, so your team starts the week ahead of the market instead of catching up to it.</p>
      </div>
      <div data-reveal class="rt-monday">
        {monday.map((t, i) => (<div class="rt-monday-row"><span class="rt-monday-n">{String(i + 1).padStart(2, '0')}</span><span>{t}</span></div>))}
      </div>
    </div>
  </section>

  <!-- Before / After -->
  <section id="compare" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Before and after</span>
        <h2 class="mk-h2"><span style="font-weight:400">Pricing without PriceLeap, </span><span style="font-weight:700">and with it.</span></h2>
      </div>
      <div data-reveal class="fr-ba">
        <div class="fr-ba-left">
          <span class="fr-ba-tag">WITH PRICELEAP</span>
          <h3 class="fr-ba-title">Decision-ready data, refreshed for you.</h3>
          <div class="fr-ba-meter"><span class="fr-ba-cov">100%</span><span class="fr-ba-cov-l">priority SKUs<br>refreshed</span></div>
          <div class="fr-ba-track"><span style="width:100%"></span></div>
        </div>
        <div class="fr-ba-list">{baList.map((t) => (<div class="fr-ba-row"><span class="fr-ba-check">✓</span><span>{t}</span></div>))}</div>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section id="proof" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="rt-proof">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Enterprise-grade</span>
        <h2 class="mk-h2"><span style="font-weight:700">Enterprise-grade,</span><span style="font-weight:400"> not best-effort.</span></h2>
        <div class="rt-proof-grid">
          {[['Refresh SLA', 'Guaranteed by tier, with every point timestamped.'], ['Accuracy SLA', 'Matching accuracy committed in writing, not marketing.'], ['Self-healing', 'Extractors recover from site redesigns automatically.'], ['SOC 2 / ISO 27001', 'Certified security with full access controls.']].map(([t, d]) => (
            <div class="rt-proof-card"><span class="rt-proof-check">✓</span><div><div class="rt-proof-t">{t}</div><div class="rt-proof-d">{d}</div></div></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Real-time monitoring " titleBold="FAQ." />

  <!-- CTA -->
  <section id="demo" class="mk-cta-sec">
    <div class="mk-cta">
      <div aria-hidden="true" class="mk-cta-glow"></div>
      <div data-reveal class="mk-cta-inner">
        <h2 class="mk-cta-h2"><span style="font-weight:400">See live prices on </span><span style="font-weight:700">your own competitive set.</span></h2>
        <a href="/contact" class="mk-btn-primary mk-btn-lg">Book a demo</a>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .rt-crumbs { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--pl-muted); }
  .rt-crumbs a { color: var(--pl-muted); }
  .rt-crumbs span:nth-child(even) { color: var(--pl-line-xstrong); }
  .rt-crumb-cur { color: var(--pl-ink) !important; }
  .rt-eye-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pl-gradient); animation: plpulse 1.8s infinite; }

  .rt-card { position: relative; background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 20px; box-shadow: 0 40px 80px -40px rgba(60,30,15,.28),0 0 0 6px rgba(255,255,255,.7); overflow: hidden; }
  .rt-card-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--pl-line-soft); background: var(--pl-cream); }
  .rt-card-title { font-size: 13px; font-weight: 500; color: var(--pl-ink); }
  .rt-card-sku { font-size: 12px; color: var(--pl-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rt-card-live { margin-left: auto; flex: none; display: flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--pl-accent-tint); border: 1px solid var(--pl-accent-line); font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-accent-ink); }
  .rt-table { padding: 4px 16px 8px; }
  .rt-table-head { display: grid; grid-template-columns: minmax(0,1.3fr) 92px minmax(0,1fr); gap: 12px; padding: 9px 0; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-faint); }
  .rt-row { display: grid; grid-template-columns: minmax(0,1.3fr) 92px minmax(0,1fr); gap: 12px; align-items: center; padding: 11px 0; border-top: 1px solid var(--pl-line-soft); }
  .rt-src { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .rt-ab { width: 28px; height: 28px; flex: none; border-radius: 8px; background: var(--pl-sand); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--pl-ink-2); display: flex; align-items: center; justify-content: center; }
  .rt-n { font-size: 13px; font-weight: 500; color: var(--pl-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rt-type { font-family: 'Geist Mono', monospace; font-size: 10px; color: var(--pl-muted); }
  .rt-status { justify-self: end; display: flex; align-items: center; gap: 8px; }
  .rt-price { font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--pl-ink); }
  .rt-matched { height: 20px; padding: 0 7px; display: flex; align-items: center; border-radius: 5px; background: var(--pl-accent-tint); border: 1px solid var(--pl-accent-line); font-family: 'Geist Mono', monospace; font-size: 9.5px; color: var(--pl-accent-ink); }
  .rt-rendering { display: flex; align-items: center; gap: 6px; font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-faint); }
  .rt-spin { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--pl-line); border-top-color: var(--pl-accent); animation: mk-spin .8s linear infinite; }
  .rt-kpis { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1px; background: var(--pl-line-soft); border-top: 1px solid var(--pl-line-soft); }
  .rt-kpi { background: var(--pl-cream); padding: 12px 16px; }
  .rt-kpi-k { font-family: 'Geist Mono', monospace; font-size: 9.5px; letter-spacing: .08em; color: var(--pl-faint); }

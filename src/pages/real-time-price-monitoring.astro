---
// Native Astro port of the design package's Real-Time Price Monitoring page.
// Static initial render + the two animation loops and interactions reimplemented in
// vanilla JS: sticky scrollspy subnav + scroll-progress bar; hero live-collection
// source rows cycling render→price→matched + pages-today counter + freshness timers
// (1300ms); auto-advancing 5-step engine (260ms) with prev/next and five swapping
// self-animating panels; FAQ. Uses design tokens + real brand-logo marquees.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const src = [
  ['Marketplace A', 'MA', 'MARKETPLACE', '$184.99'], ['Retailer B', 'RB', 'RETAILER', '$189.00'],
  ['PriceCompare', 'PC', 'COMPARISON', '$179.90'], ['Reseller 0871', 'R7', 'RESELLER', '$176.50'], ['Regional store', 'RS', 'REGIONAL', '€172.00'],
].map(([n, ab, type, price]) => ({ n, ab, type, price }));
const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logoLoop = [...brandLogos, ...brandLogos];
const clientGrid = ['amazon', 'walmart', 'shopify', 'ebay', 'target', 'flipkart', 'etsy', 'bigcommerce', 'magento', 'woocommerce'];
const subItems = [['basics', 'Basics'], ['who', "Who it's for"], ['problem', 'Problem'], ['engine', 'How it works'], ['monday', 'Monday'], ['compare', 'Before & after'], ['proof', 'Proof'], ['faq', 'FAQ']];
const steps5 = [
  { t: 'Collect', b1: 'We monitor [marketplaces, retailer sites, comparison engines] across [X countries, X currencies, X languages].', b2: 'Owned extraction captures the sellers who never show up in a data feed.', mv: '[X]', ml: 'sources monitored' },
  { t: 'Render & unblock', b1: 'Headless rendering reads JavaScript-heavy pages — variants, infinite scroll, prices that load only after a click.', b2: 'Rotating proxies and managed fingerprints clear bot defenses on the hardest sites, including [Amazon & Cloudflare-protected stores].', mv: '[X]%', ml: 'pages rendered' },
  { t: 'Match', b1: 'We match by [EAN/UPC, attributes, image] — including items with no barcode and across pack-size or variant differences.', b2: 'Human review on every match our models flag as uncertain.', mv: '[X]%', ml: 'match accuracy' },
  { t: 'Validate', b1: 'Each data point clears anomaly checks before you see it — a price that drops 90% overnight gets caught, not shipped.', b2: 'When a competitor redesigns a page, the extractor self-heals instead of feeding you silent blanks.', mv: '[X]%', ml: 'anomalies caught' },
  { t: 'Deliver', b1: 'Guaranteed refresh by tier: priority SKUs every [X], standard catalog every [Y] — stated, not implied.', b2: 'Take the data however you work: [API, export, S3, Snowflake, webhook].', mv: '[X] min', ml: 'refresh, top tier' },
];
const stepLabels = ['Collect', 'Render & Unblock', 'Match', 'Validate', 'Deliver'];
const retailRows = [
  { n: 'You', p: '$159.00', fw: 600, bg: 'var(--pl-accent-tint)', tag: '', tagD: 'none', tbg: 'transparent', tc: 'var(--pl-muted)', td: 'none' },
  { n: 'Retailer B', p: '$149.00', fw: 400, bg: 'transparent', tag: 'PROMO −6%', tagD: 'flex', tbg: 'var(--pl-danger-tint)', tc: 'var(--pl-danger-ink)', td: 'none' },
  { n: 'Marketplace A', p: '$157.50', fw: 400, bg: 'transparent', tag: '', tagD: 'none', tbg: 'transparent', tc: 'var(--pl-muted)', td: 'none' },
  { n: 'D2C store C', p: '$162.00', fw: 400, bg: 'transparent', tag: 'OUT OF STOCK', tagD: 'flex', tbg: 'var(--pl-sand)', tc: 'var(--pl-muted)', td: 'line-through' },
].map((r, i) => ({ ...r, dl: (i * 0.1).toFixed(1) }));
const brandRows = [
  { n: 'Authorized retailer', p: '$179.00', tag: 'AT MAP', tbg: 'var(--pl-accent-tint)', tbc: 'var(--pl-accent-line)', tc: 'var(--pl-accent-ink)', pc: 'var(--pl-ink)', ts: '', bg: 'transparent' },
  { n: 'Seller 2841 · Marketplace', p: '$164.70', tag: '−8% MAP', tbg: 'var(--pl-danger-tint)', tbc: 'var(--pl-danger-line)', tc: 'var(--pl-danger-ink)', pc: 'var(--pl-danger-ink)', ts: 'Seller 2841 · $164.70 · 14:32:07', bg: '#FFF7F6' },
  { n: 'Regional reseller · DE', p: '€179.00', tag: 'AT MAP', tbg: 'var(--pl-accent-tint)', tbc: 'var(--pl-accent-line)', tc: 'var(--pl-accent-ink)', pc: 'var(--pl-ink)', ts: '', bg: 'transparent' },
  { n: 'Marketplace seller 0098', p: '$181.00', tag: 'ABOVE', tbg: 'var(--pl-sand)', tbc: 'var(--pl-line)', tc: 'var(--pl-ink-2)', pc: 'var(--pl-ink)', ts: '', bg: 'transparent' },
].map((r, i) => ({ ...r, tsD: r.ts ? 'block' : 'none', dl: (i * 0.1).toFixed(1) }));
const delivers = ['API', 'Export', 'S3', 'Snowflake', 'Webhook'].map((t, i) => ({ t, y: [11.8, 30.9, 50, 69.1, 88.2][i] }));
const monday = [
  { n: '01', ts: 'MON 09:00 · FRESHNESS', t: "You price against data that's [minutes/hours] old, not days old — so you stop reacting late." },
  { n: '02', ts: 'MON 09:15 · COVERAGE', t: 'You see the full competitive set, long-tail sellers included, not just the obvious players.' },
  { n: '03', ts: 'MON 09:30 · TIME BACK', t: 'You stop burning analyst hours cleaning broken scrapes and chasing missing SKUs.' },
];
const baRows = [
  { k: 'Data freshness', b: 'Prices pulled once a day, stale by lunch.', a: "Continuous collection, so you price against what's live on site now." },
  { k: 'Coverage', b: 'Top SKUs and obvious competitors only. Resellers and regional sites go unseen.', a: 'The full competitive set across your whole catalogue, long-tail sellers included.' },
  { k: 'Analyst time', b: 'Hours spent cleaning broken scrapes and chasing missing SKUs.', a: 'Matched, cleaned data arrives ready to use. Your team works on decisions.' },
  { k: 'Response', b: "You find out about a competitor's price cut after it has cost you sales.", a: 'Price, promo and stock changes reach you as they happen.' },
];
const uptime = Array.from({ length: 60 }, (_, i) => ({ c: i === 23 ? 'var(--pl-warn-line)' : 'var(--pl-accent)', dl: (i * 0.012).toFixed(3) }));
const faqData = [
  ["Can competitors tell we're monitoring them?", 'No. Collection runs through rotating proxies and managed fingerprints, so requests look like ordinary shopper traffic and are not tied back to your company.'],
  ['How fresh is the data, really?', 'Refresh is guaranteed by tier: priority SKUs every [X], standard catalog every [Y]. Every data point carries a timestamp so you can see exactly how old it is.'],
  ['Can you match products with no EAN or UPC?', 'Yes. We match by [EAN/UPC, attributes, image], handle pack-size and variant differences, and send every uncertain match to human review.'],
  ['Do you handle bot-protected and JavaScript-heavy sites?', 'Yes. Headless rendering reads prices that load via JavaScript or after a click, and rotating proxies clear bot defenses on sites including [Amazon & Cloudflare-protected stores].'],
  ['What happens when a competitor changes their site?', 'The extractor self-heals when a page is redesigned, and anomaly checks stop broken or implausible values from reaching you. You never receive silent blanks.'],
  ['Can we get the data into our own stack?', 'Yes. Take the data however you work: [API, export, S3, Snowflake, webhook].'],
  ['Will it scale from hundreds to millions of SKUs?', 'Yes. Coverage scales with your catalog, with [X] B SKUs already under coverage and refresh tiers that keep priority SKUs fast as volume grows.'],
].map(([q, a], i) => ({ q, a, n: '0' + (i + 1) }));
---
<PriceLeapLayout
  title="Real-Time Price Monitoring · PriceLeap"
  description="PriceLeap pulls live e-commerce prices from the sites you compete on, refreshing priority SKUs in minutes — clean, matched, decision-ready data that doesn't break when a competitor changes their page."
>
  <div class="rt">
    <!-- SUBNAV (scrollspy + progress) -->
    <div class="rt-subnav" style="position:sticky;top:64px;z-index:55;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--pl-line-soft)">
      <div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,40px);height:46px;display:flex;align-items:center;gap:20px">
        <span style="flex:none;display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--pl-ink)"><span style="width:7px;height:7px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.8s infinite"></span>Price Monitoring</span>
        <nav style="display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0">
          {subItems.map(([id, t]) => (
            <a href={`#${id}`} class="rt-sub" data-rt-sub={id} style={`flex:none;height:30px;padding:0 10px;display:flex;align-items:center;border-radius:8px;font-size:13px;color:${id === 'basics' ? 'var(--pl-ink)' : 'var(--pl-muted)'};background:${id === 'basics' ? 'var(--pl-sand)' : 'transparent'};transition:background .2s,color .2s`}>{t}</a>
          ))}
        </nav>
      </div>
      <div data-rt-progress style="height:2px;background:var(--pl-gradient);width:0%;transition:width .15s linear"></div>
    </div>

    <!-- HERO -->
    <section id="top" style="position:relative;border-bottom:1px solid var(--pl-line);overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%);mask-image:radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-8%;top:-20%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.14),transparent);pointer-events:none"></div>
      <div class="rt-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,40px) clamp(56px,6vw,88px);gap:clamp(40px,5vw,64px);align-items:center">
        <div style="min-width:0">
          <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--pl-muted)"><a href="/" style="color:var(--pl-muted)">Product</a><span style="color:var(--pl-line-xstrong)">/</span><span style="color:var(--pl-ink)">Real-Time Price Monitoring</span></div>
          <span style="margin-top:28px;display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.8s ease-out infinite"></span>Real-Time Price Monitoring</span>
          <h1 style="margin:18px 0 0;font-family:Geist,sans-serif;font-size:clamp(38px,5.4vw,68px);line-height:1.02;letter-spacing:-.045em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">The data engine behind </span><span style="font-weight:700">every price decision you trust</span></h1>
          <p style="margin:22px 0 0;max-width:580px;font-size:18px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">PriceLeap pulls live e-commerce prices from the sites you actually compete on, refreshing priority SKUs every [X minutes]. You get clean, matched, decision-ready data — not a scrape that breaks the moment a competitor changes their page.</p>
          <div style="margin-top:30px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Book a demo</a>
            <a href="#engine" style="height:48px;padding:0 18px;display:inline-flex;align-items:center;gap:10px;border-radius:12px;color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">How the engine works<span style="color:var(--pl-accent-ink)">→</span></a>
          </div>
        </div>
        <div style="position:relative;min-width:0">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;box-shadow:0 40px 80px -40px rgba(60,30,15,.28),0 0 0 6px rgba(255,255,255,.7);overflow:hidden">
            <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)">
              <span style="display:flex;gap:5px"><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span></span>
              <span style="font-size:13px;font-weight:500;color:var(--pl-ink)">Live collection</span>
              <span style="font-size:12px;color:var(--pl-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">· Sonix ANC 700 Headphones</span>
              <span style="margin-left:auto;flex:none;display:flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:999px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span>LIVE</span>
            </div>
            <div style="position:relative;padding:4px 16px 8px">
              <span aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:40px;background:linear-gradient(180deg,transparent,rgba(247,99,30,.10),transparent);animation:pi-scan 3.6s linear infinite;pointer-events:none"></span>
              <div style="display:grid;grid-template-columns:minmax(0,1.3fr) 92px minmax(0,1fr);gap:12px;padding:9px 0;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)"><span>SOURCE</span><span>TYPE</span><span style="text-align:right">STATUS</span></div>
              {src.map((r, i) => (
                <div style="display:grid;grid-template-columns:minmax(0,1.3fr) 92px minmax(0,1fr);gap:12px;align-items:center;padding:11px 0;border-top:1px solid var(--pl-line-soft)">
                  <div style="display:flex;align-items:center;gap:10px;min-width:0"><span style="width:28px;height:28px;flex:none;border-radius:8px;background:var(--pl-sand);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-ink-2);display:flex;align-items:center;justify-content:center">{r.ab}</span><span style="font-size:13px;font-weight:500;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{r.n}</span></div>
                  <span style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-muted)">{r.type}</span>
                  <div class="rt-status" data-rt-status={i} data-price={r.price} style="justify-self:end;display:flex;align-items:center;gap:8px">
                    <span class="rt-p0" style="display:flex;align-items:center;gap:6px;font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-faint)"><span style="width:12px;height:12px;border-radius:50%;border:2px solid var(--pl-line);border-top-color:var(--pl-accent);animation:pi-spin .8s linear infinite"></span>Rendering</span>
                    <span class="rt-p1" style="display:none;padding:2px 6px;border-radius:5px;font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink)">{r.price}</span>
                    <span class="rt-p2" style="display:none;align-items:center;gap:8px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink)">{r.price}</span><span style="height:20px;padding:0 7px;display:flex;align-items:center;border-radius:5px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-accent-ink)">✓ MATCHED</span></span>
                  </div>
                </div>
              ))}
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--pl-line-soft);border-top:1px solid var(--pl-line-soft)">
              <div style="background:var(--pl-cream);padding:12px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:var(--pl-faint)">PAGES TODAY</div><div data-rt-pages style="margin-top:3px;font-family:Geist,sans-serif;font-size:18px;font-weight:600;letter-spacing:-.02em;color:var(--pl-ink)">1,284,512</div></div>
              <div style="background:var(--pl-cream);padding:12px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:var(--pl-faint)">LAST CHANGE</div><div data-rt-last style="margin-top:3px;font-family:Geist,sans-serif;font-size:18px;font-weight:600;letter-spacing:-.02em;color:var(--pl-ink)">3s ago</div></div>
              <div style="background:var(--pl-cream);padding:12px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:var(--pl-faint)">PRIORITY TIER</div><div style="margin-top:3px;font-family:Geist,sans-serif;font-size:18px;font-weight:600;letter-spacing:-.02em;color:var(--pl-accent-ink)">every [X]</div></div>
            </div>
          </div>
          <div class="rt-badge" style="position:absolute;left:-28px;bottom:-22px;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:14px;padding:10px 14px;box-shadow:0 20px 40px -24px rgba(60,30,15,.35);display:flex;align-items:center;gap:10px">
            <span style="width:28px;height:28px;border-radius:8px;background:var(--pl-ink);color:var(--pl-accent);display:flex;align-items:center;justify-content:center;font-size:13px">◈</span>
            <div><div style="font-size:12px;font-weight:600;color:var(--pl-ink)">Bot defense cleared</div><div style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-muted)">Headless render · rotating proxy</div></div>
          </div>
          <div class="rt-badge" style="position:absolute;right:-18px;top:-18px;background:var(--pl-surface);border:1px solid var(--pl-accent-line);border-radius:12px;padding:8px 12px;box-shadow:0 20px 40px -24px rgba(194,65,12,.45);display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-accent-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient);animation:pi-blink 1s steps(1) infinite"></span>Self-healed · page layout changed</div>
        </div>
      </div>
    </section>

    <!-- BASICS -->
    <section id="basics" style="border-bottom:1px solid var(--pl-line)">
      <div class="rt-split" style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:center">
        <div data-reveal>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>The basics</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">What is </span><span style="font-weight:700">real-time price monitoring?</span></h2>
          <p style="margin:20px 0 0;font-size:17px;line-height:1.7;color:var(--pl-ink-2);text-wrap:pretty">Real-time price monitoring is the continuous collection of competitor prices, promotions and stock status from the sites where your products are sold. Instead of checking a handful of pages by hand, software captures every change as it happens, matches it to your catalogue, and shows where you stand on each SKU.</p>
        </div>
        <div data-reveal style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:22px;overflow:hidden;box-shadow:0 30px 60px -40px rgba(60,30,15,.3)">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--pl-line-soft);flex-wrap:wrap">
            <div><div style="font-size:14px;font-weight:600;color:var(--pl-ink)">One competitor, one day</div><div style="font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-faint)">08:00 – 20:00 · EARBUDS PRO 2</div></div>
            <div style="display:flex;gap:12px;font-size:12px;color:var(--pl-ink-2)"><span style="display:flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-faint)"></span>Manual check</span><span style="display:flex;align-items:center;gap:6px"><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-gradient)"></span>Continuous</span></div>
          </div>
          <div style="padding:20px 20px 16px;background:var(--pl-cream)">
            <svg viewBox="0 0 560 220" style="display:block;width:100%;height:auto;overflow:visible">
              <line x1="0" y1="60" x2="560" y2="60" stroke="#F5ECE5"></line><line x1="0" y1="120" x2="560" y2="120" stroke="#F5ECE5"></line><line x1="0" y1="180" x2="560" y2="180" stroke="#F5ECE5"></line>
              <path d="M0,70 L120,70 L120,130 L200,130 L200,70 L320,70 L320,150 L380,150 L380,100 L470,100 L470,70 L560,70" fill="none" stroke="#1C130E" stroke-width="2.5" pathLength="1" style="stroke-dasharray:1;animation:pi-draw 2.4s ease both"></path>
              <line x1="47" y1="40" x2="47" y2="196" stroke="#7F7066" stroke-dasharray="3 4"></line>
              <circle cx="47" cy="70" r="6" fill="#FFFFFF" stroke="#7F7066" stroke-width="2"></circle>
              <rect x="10" y="16" width="76" height="20" rx="5" fill="#FBF3EC" stroke="#EFE3DA"></rect><text x="48" y="30" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#665A51">09:00 CHECK</text>
              <g style="animation:pi-pop .5s ease 1.2s both;transform-origin:160px 130px"><circle cx="160" cy="130" r="7" fill="#F7631E" stroke="#FFFFFF" stroke-width="2"></circle><rect x="122" y="144" width="76" height="20" rx="5" fill="#FFF4EC" stroke="#FFD8BE"></rect><text x="160" y="158" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#C2410C">PROMO −12%</text></g>
              <g style="animation:pi-pop .5s ease 1.7s both;transform-origin:350px 150px"><circle cx="350" cy="150" r="7" fill="#F7631E" stroke="#FFFFFF" stroke-width="2"></circle><rect x="306" y="164" width="88" height="20" rx="5" fill="#FFF4EC" stroke="#FFD8BE"></rect><text x="350" y="178" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#C2410C">PRICE CUT −18%</text></g>

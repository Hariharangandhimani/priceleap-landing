<script>
  const root = document.querySelector('.rt');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---- subnav scrollspy + progress ----
    const ids = ['basics', 'who', 'problem', 'engine', 'monday', 'compare', 'proof', 'faq'];
    const subs = qa('[data-rt-sub]'), progress = q('[data-rt-progress]');
    const onScroll = () => {
      let a = ids[0];
      ids.forEach((id) => { const el = document.getElementById(id); if (el && el.getBoundingClientRect().top < 160) a = id; });
      subs.forEach((s) => { const on = s.getAttribute('data-rt-sub') === a; s.style.color = on ? 'var(--pl-ink)' : 'var(--pl-muted)'; s.style.background = on ? 'var(--pl-sand)' : 'transparent'; });
      const d = document.documentElement, max = d.scrollHeight - window.innerHeight;
      if (progress) progress.style.width = (max > 0 ? Math.min(100, window.scrollY / max * 100) : 0) + '%';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ---- 1300ms loop: hero source phases + pages + freshness ----
    const statuses = qa('[data-rt-status]'), pagesEl = q('[data-rt-pages]'), lastEl = q('[data-rt-last]'), ctafs = qa('[data-rt-ctaf]');
    let tick = 0, pages = 1284512;
    const paintHero = () => {
      statuses.forEach((cell, i) => {
        const ph = (tick + i * 2) % 6, p = ph < 2 ? 0 : ph < 3 ? 1 : 2;
        const p0 = cell.querySelector('.rt-p0') as HTMLElement, p1 = cell.querySelector('.rt-p1') as HTMLElement, p2 = cell.querySelector('.rt-p2') as HTMLElement;
        if (p0) p0.style.display = p === 0 ? 'flex' : 'none';
        if (p1) { p1.style.display = p === 1 ? 'inline-block' : 'none'; if (p === 1) { p1.style.animation = 'none'; void p1.offsetWidth; p1.style.animation = 'pi-flash 1.2s ease'; } }
        if (p2) p2.style.display = p === 2 ? 'flex' : 'none';
      });
      if (pagesEl) pagesEl.textContent = pages.toLocaleString('en-US');
      if (lastEl) lastEl.textContent = ((tick % 9) + 3) + 's ago';
      const mins = (tick % 50) + 1;
      ctafs.forEach((el, i) => (el.textContent = (mins + [0, 3, 7][i]) + 'm ago'));
    };
    paintHero();
    setInterval(() => { tick++; pages += 37 + Math.floor(Math.random() * 40); paintHero(); }, 1300);

    // ---- 260ms loop: engine step auto-advance ----
    const stepsData = [
      { t: 'Collect', b1: 'We monitor [marketplaces, retailer sites, comparison engines] across [X countries, X currencies, X languages].', b2: 'Owned extraction captures the sellers who never show up in a data feed.', mv: '[X]', ml: 'sources monitored' },
      { t: 'Render & unblock', b1: 'Headless rendering reads JavaScript-heavy pages — variants, infinite scroll, prices that load only after a click.', b2: 'Rotating proxies and managed fingerprints clear bot defenses on the hardest sites, including [Amazon & Cloudflare-protected stores].', mv: '[X]%', ml: 'pages rendered' },
      { t: 'Match', b1: 'We match by [EAN/UPC, attributes, image] — including items with no barcode and across pack-size or variant differences.', b2: 'Human review on every match our models flag as uncertain.', mv: '[X]%', ml: 'match accuracy' },
      { t: 'Validate', b1: 'Each data point clears anomaly checks before you see it — a price that drops 90% overnight gets caught, not shipped.', b2: 'When a competitor redesigns a page, the extractor self-heals instead of feeding you silent blanks.', mv: '[X]%', ml: 'anomalies caught' },
      { t: 'Deliver', b1: 'Guaranteed refresh by tier: priority SKUs every [X], standard catalog every [Y] — stated, not implied.', b2: 'Take the data however you work: [API, export, S3, Snowflake, webhook].', mv: '[X] min', ml: 'refresh, top tier' },
    ];
    const stepBtns = qa('[data-rt-step]'), epanels = qa('[data-rt-epanel]'), stepFill = q('[data-rt-stepfill]');
    let step = 0, stepP = 0;
    const paintStep = () => {
      stepBtns.forEach((el, i) => { el.classList.toggle('is-on', i === step); el.classList.toggle('is-done', i < step); el.setAttribute('aria-pressed', String(i === step)); const d = el.querySelector('.rt-step-dot') as HTMLElement; if (d) d.textContent = i < step ? '✓' : String(i + 1); });
      epanels.forEach((el, i) => (el.style.display = i === step ? (i === 3 ? 'flex' : 'block') : 'none'));
      if (stepFill) stepFill.style.width = Math.min(80, (step + stepP) / 4 * 80) + '%';
      const d = stepsData[step];
      const set = (sel: string, v: string) => { const el = q(sel); if (el) el.textContent = v; };
      set('[data-rt-curn]', '0' + (step + 1)); set('[data-rt-curt]', d.t); set('[data-rt-curb1]', d.b1); set('[data-rt-curb2]', d.b2); set('[data-rt-curmv]', d.mv); set('[data-rt-curml]', d.ml);
    };
    stepBtns.forEach((el, i) => el.addEventListener('click', () => { step = i; stepP = 0; paintStep(); }));
    q('[data-rt-prev]')?.addEventListener('click', () => { step = (step + 4) % 5; stepP = 0; paintStep(); });
    q('[data-rt-next]')?.addEventListener('click', () => { step = (step + 1) % 5; stepP = 0; paintStep(); });
    paintStep();
    setInterval(() => {
      stepP += 0.04;
      if (stepP >= 1) { step = (step + 1) % 5; stepP = 0; paintStep(); }
      else if (stepFill) stepFill.style.width = Math.min(80, (step + stepP) / 4 * 80) + '%';
    }, 260);

    // ---- faq ----
    qa('[data-rt-faq-btn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-rt-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-rt-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-rt-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

---
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';
import blogData from '../../data/blog.json';

type Article = {
  slug: string; category: string; title: string; excerpt: string; author: string;
  publishedAt: string; readTime: string; heroImage?: { src: string; alt: string };
};
const articles = blogData.articles as Article[];
const total = articles.length;
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

const categories = [...new Set(articles.map((a) => a.category))];
const catCounts = Object.fromEntries(categories.map((c) => [c, articles.filter((a) => a.category === c).length]));

const featured = articles[0];
const picks = articles.slice(1, 5);
const popular = ['Price index', 'MAP monitoring', 'Buy Box', 'Dynamic pricing'];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'PriceLeap Blog',
  url: 'https://priceleap.ai/blog',
  blogPost: articles.map((a) => ({
    '@type': 'BlogPosting', headline: a.title, description: a.excerpt,
    author: { '@type': 'Person', name: a.author }, datePublished: a.publishedAt,
    url: `https://priceleap.ai/blog/${a.slug}`,
  })),
}];
---
<PriceLeapLayout
  title="PriceLeap Blog · Pricing Intelligence, Explained"
  description="Guides, research and playbooks on competitor pricing, price indexes, MAP monitoring and dynamic pricing from the PriceLeap team."
  jsonLd={jsonLd}
>
  <section class="bl-hero" data-screen-label="Hero">
    <div aria-hidden="true" class="bl-hero-grid"></div>
    <div aria-hidden="true" class="bl-hero-glow"></div>
    <div class="bl-hero-inner">
      <span class="bl-badge"><span class="bl-badge-dot"></span>PRICELEAP BLOG · {total} ARTICLES</span>
      <h1 class="bl-h1"><span style="font-weight:400">Pricing intelligence, </span><span style="font-weight:700">explained.</span></h1>
      <p class="bl-lead">Guides, research and playbooks on competitor pricing, price indexes, MAP monitoring and dynamic pricing, written by the people who build PriceLeap.</p>
      <div role="search" class="bl-search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#7F7066" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input type="search" placeholder="Search articles, e.g. MAP monitoring" aria-label="Search articles" data-bl-search />
        <a href="#articles" class="bl-search-btn">Search</a>
      </div>
      <div class="bl-popular">
        <span class="bl-popular-label">POPULAR</span>
        {popular.map((p) => (<button type="button" class="bl-chip" data-bl-popular={p}>{p}</button>))}
      </div>
    </div>
  </section>

  <section class="bl-featured" data-screen-label="Featured" data-bl-featured>
    <div class="bl-featured-grid">
      <a href={`/blog/${featured.slug}`} class="bl-feat-card">
        <div class="bl-feat-cover">
          {featured.heroImage && (<img src={featured.heroImage.src} alt={featured.heroImage.alt} width="800" height="400" loading="eager" />)}
          <span class="bl-feat-tags"><span class="bl-feat-tag-gradient">FEATURED</span><span class="bl-feat-tag">{featured.category.toUpperCase()}</span></span>
        </div>
        <div class="bl-feat-body">
          <span class="bl-feat-title">{featured.title}</span>
          <span class="bl-feat-excerpt">{featured.excerpt}</span>
          <span class="bl-feat-meta">
            <span class="bl-ini bl-ini--accent">{initials(featured.author)}</span>
            <span class="bl-feat-author">{featured.author}</span>
            <span class="bl-feat-date">{featured.publishedAt} · {featured.readTime}</span>
            <span class="bl-feat-read">Read article<span style="color:var(--pl-accent-end)">→</span></span>
          </span>
        </div>
      </a>
      <div class="bl-picks">
        <div class="bl-picks-head"><span>EDITOR'S PICKS</span><span class="bl-picks-n">{String(picks.length).padStart(2, '0')}</span></div>
        {picks.map((p, i) => (
          <a href={`/blog/${p.slug}`} class="bl-pick" style={i === picks.length - 1 ? 'border-bottom:none' : ''}>
            <span class="bl-pick-n">{String(i + 1).padStart(2, '0')}</span>
            <span style="min-width:0"><span class="bl-pick-cat">{p.category.toUpperCase()}</span><span class="bl-pick-t">{p.title}</span><span class="bl-pick-read">{p.readTime}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="articles" class="bl-all" data-screen-label="All articles">
    <div class="bl-all-head">
      <div>
        <span class="bl-all-eyebrow"><span class="bl-diamond"></span>ALL ARTICLES</span>
        <h2 class="bl-all-title" data-bl-title>Latest from the team</h2>
      </div>
      <span class="bl-all-count" data-bl-count>{total} articles</span>
    </div>

    <div class="bl-sticky">
      <div role="tablist" aria-label="Categories" class="bl-cats">
        <button type="button" role="tab" class="bl-cat is-on" data-bl-cat="All" aria-selected="true">All<span class="bl-cat-n">{total}</span></button>
        {categories.map((c) => (
          <button type="button" role="tab" class="bl-cat" data-bl-cat={c} aria-selected="false">{c}<span class="bl-cat-n">{catCounts[c]}</span></button>
        ))}
      </div>
    </div>

    <div class="bl-grid" data-bl-grid>
      {articles.map((p) => (
        <a href={`/blog/${p.slug}`} class="bl-card" data-bl-card data-name={`${p.title} ${p.excerpt} ${p.category}`.toLowerCase()} data-cat={p.category}>
          <div class="bl-card-cover">
            {p.heroImage && (<img src={p.heroImage.src} alt={p.heroImage.alt} width="400" height="225" loading="lazy" />)}
            <span class="bl-card-cat">{p.category.toUpperCase()}</span>
          </div>
          <div class="bl-card-body">
            <span class="bl-card-title">{p.title}</span>
            <span class="bl-card-excerpt">{p.excerpt}</span>
            <span class="bl-card-meta">
              <span class="bl-ini">{initials(p.author)}</span>
              <span class="bl-card-author">{p.author}</span>
              <span class="bl-card-read">{p.readTime}</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="bl-empty" data-bl-empty hidden>
      <span class="bl-empty-ico">∅</span>
      <span class="bl-empty-t">No articles match your search</span>
      <span class="bl-empty-s">Try another term or browse all categories.</span>
      <button type="button" class="bl-empty-reset" data-bl-reset>Clear filters</button>
    </div>
  </section>

  <section class="bl-nl" data-screen-label="Newsletter">
    <div class="bl-nl-grid">
      <div class="bl-nl-left">
        <div aria-hidden="true" class="bl-nl-dots"></div>
        <span class="bl-nl-eyebrow"><span class="bl-diamond"></span>NEWSLETTER</span>
        <h2 class="bl-nl-h2"><span style="font-weight:400">Pricing insights, </span><span style="font-weight:700">every other week.</span></h2>
        <p class="bl-nl-p">Market moves, MAP trends and new guides from the PriceLeap research team. No spam, unsubscribe anytime.</p>
        <form class="bl-nl-form" data-newsletter>
          <input type="email" required placeholder="you@company.com" aria-label="Work email" class="bl-nl-input" />
          <button type="submit" class="bl-nl-sub">Subscribe</button>
        </form>
        <span class="bl-nl-note">Join pricing teams reading our market notes.</span>
      </div>
      <div class="bl-nl-right">
        <span class="bl-nl-k">PREFER A CONVERSATION?</span>
        <span class="bl-nl-rt">See PriceLeap on your own catalog</span>
        <span class="bl-nl-rs">We'll pull live competitor prices on your SKUs during the call.</span>
        <div class="bl-nl-btns"><a href="/book-a-demo" class="bl-nl-demo">Book a demo</a><a href="/contact" class="bl-nl-expert">Talk to an expert</a></div>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .bl-diamond { width: 6px; height: 6px; border-radius: 2px; background: var(--pl-accent); transform: rotate(45deg); }
  .bl-ini { width: 28px; height: 28px; border-radius: 50%; background: var(--pl-sand); border: 1px solid var(--pl-line); display: flex; align-items: center; justify-content: center; font-family: 'Geist Mono', monospace; font-size: 9.5px; color: var(--pl-ink-2); flex: none; }
  .bl-ini--accent { width: 34px; height: 34px; background: var(--pl-accent-tint); border-color: var(--pl-accent-line); color: var(--pl-accent-ink); font-size: 10px; }

  .bl-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
  .bl-hero-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse 70% 90% at 50% 0%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 70% 90% at 50% 0%,#000 10%,transparent 70%); pointer-events: none; }
  .bl-hero-glow { position: absolute; left: 50%; top: -260px; width: 820px; height: 520px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(251,138,46,.12),transparent); pointer-events: none; }
  .bl-hero-inner { position: relative; max-width: 1280px; margin: 0 auto; padding: clamp(48px,7vw,88px) clamp(16px,4vw,40px) clamp(40px,5vw,60px); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .bl-badge { height: 28px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: .1em; color: var(--pl-ink-2); }
  .bl-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--pl-accent); animation: plpulse 1.8s infinite; }
  .bl-h1 { margin: 20px 0 0; font-family: Geist, sans-serif; font-size: clamp(38px,6vw,72px); line-height: 1.02; letter-spacing: -.045em; color: var(--pl-ink); text-wrap: balance; max-width: 900px; }
  .bl-lead { margin: 18px 0 0; max-width: 620px; font-size: clamp(16px,1.6vw,18px); line-height: 1.6; color: var(--pl-ink-2); text-wrap: pretty; }
  .bl-search { margin-top: 28px; width: min(100%,560px); display: flex; align-items: center; gap: 10px; background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 14px; padding: 6px 6px 6px 16px; box-shadow: 0 20px 40px -30px rgba(60,30,15,.4); transition: border-color .2s, box-shadow .2s; }
  .bl-search:focus-within { border-color: var(--pl-accent-line); box-shadow: 0 0 0 4px rgba(247,99,30,.12); }
  .bl-search input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; font-size: 15px; color: var(--pl-ink); padding: 10px 0; }
  .bl-search-btn { height: 40px; padding: 0 16px; display: flex; align-items: center; border-radius: 10px; background: var(--pl-ink); color: var(--pl-surface); font-size: 14px; font-weight: 500; white-space: nowrap; }
  .bl-search-btn:hover { background: var(--pl-ink-hover); color: var(--pl-surface); }
  .bl-popular { margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; align-items: center; }
  .bl-popular-label { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: .08em; color: var(--pl-faint); }
  .bl-chip { height: 30px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--pl-line); background: var(--pl-surface); cursor: pointer; font-size: 13px; color: var(--pl-ink-2); transition: border-color .2s, color .2s; }
  .bl-chip:hover { border-color: var(--pl-accent-line); color: var(--pl-accent-ink); }

  .bl-featured { max-width: 1280px; margin: 0 auto; padding: clamp(36px,5vw,56px) clamp(16px,4vw,40px) 0; }
  .bl-featured-grid { display: grid; grid-template-columns: 1fr; gap: 16px; align-items: stretch; }
  .bl-feat-card { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 24px; overflow: hidden; display: grid; grid-template-rows: auto 1fr; color: var(--pl-ink); transition: box-shadow .25s, border-color .25s; }
  .bl-feat-card:hover { box-shadow: 0 36px 70px -46px rgba(60,30,15,.55); border-color: var(--pl-accent-line); color: var(--pl-ink); }
  .bl-feat-cover { position: relative; aspect-ratio: 16 / 8; background: var(--pl-sand); border-bottom: 1px solid var(--pl-line-soft); overflow: hidden; }
  .bl-feat-cover img { width: 100%; height: 100%; object-fit: cover; }
  .bl-feat-tags { position: absolute; left: 16px; top: 16px; display: flex; gap: 6px; }
  .bl-feat-tag-gradient { height: 26px; padding: 0 10px; display: flex; align-items: center; border-radius: 7px; background: var(--pl-gradient); font-family: 'Geist Mono', monospace; font-size: 10.5px; letter-spacing: .08em; color: var(--pl-surface); }
  .bl-feat-tag { height: 26px; padding: 0 10px; display: flex; align-items: center; border-radius: 7px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 10.5px; letter-spacing: .08em; color: var(--pl-accent-ink); }
  .bl-feat-body { padding: clamp(20px,3vw,30px); display: flex; flex-direction: column; gap: 12px; }
  .bl-feat-title { font-family: Geist, sans-serif; font-size: clamp(24px,2.8vw,34px); font-weight: 600; line-height: 1.15; letter-spacing: -.03em; text-wrap: balance; }
  .bl-feat-excerpt { font-size: 16px; line-height: 1.6; color: var(--pl-muted); max-width: 640px; }
  .bl-feat-meta { margin-top: auto; padding-top: 12px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .bl-feat-author { font-size: 14px; font-weight: 600; }
  .bl-feat-date { font-family: 'Geist Mono', monospace; font-size: 11.5px; color: var(--pl-faint); }
  .bl-feat-read { margin-left: auto; height: 38px; padding: 0 14px; display: inline-flex; align-items: center; gap: 8px; border-radius: 10px; background: var(--pl-ink); color: var(--pl-surface); font-size: 13.5px; font-weight: 500; }
  .bl-picks { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 24px; overflow: hidden; display: flex; flex-direction: column; }
  .bl-picks-head { padding: 16px 20px; border-bottom: 1px solid var(--pl-line-soft); background: var(--pl-cream); display: flex; justify-content: space-between; align-items: center; font-family: 'Geist Mono', monospace; font-size: 10.5px; letter-spacing: .12em; color: var(--pl-faint); }
  .bl-picks-n { color: var(--pl-accent-ink); letter-spacing: 0; }
  .bl-pick { flex: 1; padding: 16px 20px; border-bottom: 1px solid var(--pl-line-soft); display: grid; grid-template-columns: 30px minmax(0,1fr); gap: 12px; align-items: start; color: var(--pl-ink); transition: background .2s; }
  .bl-pick:hover { background: var(--pl-cream); color: var(--pl-ink); }
  .bl-pick-n { font-family: Geist, sans-serif; font-size: 22px; font-weight: 600; letter-spacing: -.04em; line-height: 1; color: var(--pl-line-strong); }
  .bl-pick-cat { display: block; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-accent-ink); }
  .bl-pick-t { display: block; margin-top: 4px; font-size: 15px; font-weight: 600; line-height: 1.35; }
  .bl-pick-read { display: block; margin-top: 6px; font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-faint); }

  .bl-all { max-width: 1280px; margin: 0 auto; padding: clamp(48px,6vw,80px) clamp(16px,4vw,40px) 0; scroll-margin-top: 80px; }
  .bl-all-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .bl-all-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .12em; color: var(--pl-accent-ink); }
  .bl-all-title { margin: 12px 0 0; font-family: Geist, sans-serif; font-size: clamp(26px,3.2vw,38px); line-height: 1.1; letter-spacing: -.03em; font-weight: 600; color: var(--pl-ink); }
  .bl-all-count { font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--pl-muted); }
  .bl-sticky { position: sticky; top: 64px; z-index: 10; margin: 22px calc(-1 * clamp(16px,4vw,40px)) 0; padding: 12px clamp(16px,4vw,40px); background: rgba(255,252,249,.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--pl-line-soft); }
  .bl-cats { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .bl-cats::-webkit-scrollbar { display: none; }
  .bl-cat { flex: none; height: 38px; padding: 0 14px; display: flex; align-items: center; gap: 8px; border-radius: 999px; border: 1px solid var(--pl-line); background: var(--pl-surface); color: var(--pl-ink-2); cursor: pointer; font-size: 13.5px; font-weight: 500; white-space: nowrap; transition: all .2s; }
  .bl-cat.is-on { background: var(--pl-ink); border-color: var(--pl-ink); color: var(--pl-surface); }
  .bl-cat-n { height: 20px; min-width: 20px; padding: 0 6px; display: flex; align-items: center; justify-content: center; border-radius: 999px; background: var(--pl-sand); font-family: 'Geist Mono', monospace; font-size: 10.5px; color: var(--pl-muted); }
  .bl-cat.is-on .bl-cat-n { background: rgba(255,255,255,.16); color: var(--pl-surface); }
  .bl-grid { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,300px),1fr)); gap: 16px; }
  .bl-card { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 20px; overflow: hidden; display: flex; flex-direction: column; color: var(--pl-ink); transition: transform .25s, box-shadow .25s, border-color .25s; }
  .bl-card:hover { transform: translateY(-4px); box-shadow: 0 28px 50px -34px rgba(60,30,15,.5); border-color: var(--pl-accent-line); color: var(--pl-ink); }
  .bl-card-cover { position: relative; aspect-ratio: 16 / 9; background: var(--pl-sand); border-bottom: 1px solid var(--pl-line-soft); overflow: hidden; }
  .bl-card-cover img { width: 100%; height: 100%; object-fit: cover; }
  .bl-card-cat { position: absolute; left: 12px; top: 12px; height: 24px; padding: 0 9px; display: flex; align-items: center; border-radius: 7px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-accent-ink); }
  .bl-card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .bl-card-title { font-family: Geist, sans-serif; font-size: 18.5px; font-weight: 600; line-height: 1.3; letter-spacing: -.01em; text-wrap: pretty; }
  .bl-card-excerpt { font-size: 14.5px; line-height: 1.55; color: var(--pl-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bl-card-meta { margin-top: auto; padding-top: 12px; border-top: 1px dashed var(--pl-line-soft); display: flex; align-items: center; gap: 10px; }
  .bl-card-author { font-size: 13px; font-weight: 500; color: var(--pl-ink); }
  .bl-card-read { margin-left: auto; font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-faint); }
  .bl-empty { margin-top: 24px; background: var(--pl-surface); border: 1px dashed var(--pl-line-strong); border-radius: 20px; padding: 48px 20px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .bl-empty-ico { width: 48px; height: 48px; border-radius: 14px; background: var(--pl-sand); display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--pl-faint); }
  .bl-empty-t { font-family: Geist, sans-serif; font-size: 18px; font-weight: 600; color: var(--pl-ink); }
  .bl-empty-s { font-size: 14px; color: var(--pl-muted); }
  .bl-empty-reset { margin-top: 6px; height: 40px; padding: 0 16px; border-radius: 10px; border: 1px solid var(--pl-line); background: var(--pl-surface); cursor: pointer; font-size: 14px; color: var(--pl-ink); }

  .bl-nl { max-width: 1280px; margin: 0 auto; padding: clamp(56px,7vw,96px) clamp(16px,4vw,40px) clamp(40px,5vw,64px); }
  .bl-nl-grid { position: relative; overflow: hidden; border: 1px solid var(--pl-line); border-radius: 26px; display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--pl-line-soft); }
  .bl-nl-left { position: relative; background: var(--pl-surface); padding: clamp(24px,4vw,44px); display: flex; flex-direction: column; gap: 14px; overflow: hidden; }
  .bl-nl-dots { position: absolute; inset: 0; background-image: radial-gradient(var(--pl-line) 1px,transparent 1px); background-size: 16px 16px; -webkit-mask-image: linear-gradient(135deg,transparent 40%,#000); mask-image: linear-gradient(135deg,transparent 40%,#000); }
  .bl-nl-eyebrow { position: relative; display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .12em; color: var(--pl-accent-ink); }
  .bl-nl-h2 { position: relative; margin: 0; font-family: Geist, sans-serif; font-size: clamp(26px,3.4vw,40px); line-height: 1.08; letter-spacing: -.035em; color: var(--pl-ink); text-wrap: balance; }
  .bl-nl-p { position: relative; margin: 0; font-size: 16px; line-height: 1.6; color: var(--pl-ink-2); max-width: 460px; }
  .bl-nl-form { position: relative; margin-top: 6px; display: flex; gap: 8px; flex-wrap: wrap; max-width: 480px; }
  .bl-nl-input { flex: 1; min-width: 200px; height: 48px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--pl-line); background: var(--pl-cream); outline: none; font-size: 15px; color: var(--pl-ink); }
  .bl-nl-sub { height: 48px; padding: 0 20px; border: none; border-radius: 12px; background: var(--pl-gradient); color: var(--pl-surface); cursor: pointer; font-size: 15px; font-weight: 500; box-shadow: 0 12px 24px -12px rgba(247,99,30,.85); }
  .bl-nl-note { position: relative; font-size: 12.5px; color: var(--pl-faint); }
  .bl-nl-right { background: var(--pl-cream); padding: clamp(24px,4vw,44px); display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  .bl-nl-k { font-family: 'Geist Mono', monospace; font-size: 10.5px; letter-spacing: .12em; color: var(--pl-faint); }
  .bl-nl-rt { font-family: Geist, sans-serif; font-size: 22px; font-weight: 600; line-height: 1.25; letter-spacing: -.02em; color: var(--pl-ink); }
  .bl-nl-rs { font-size: 15px; line-height: 1.6; color: var(--pl-muted); }
  .bl-nl-btns { margin-top: 6px; display: flex; gap: 10px; flex-wrap: wrap; }
  .bl-nl-demo { height: 46px; padding: 0 18px; display: inline-flex; align-items: center; border-radius: 12px; background: var(--pl-ink); color: var(--pl-surface); font-size: 14.5px; font-weight: 500; }
  .bl-nl-demo:hover { background: var(--pl-ink-hover); color: var(--pl-surface); }
  .bl-nl-expert { height: 46px; padding: 0 18px; display: inline-flex; align-items: center; border-radius: 12px; border: 1px solid var(--pl-line); background: var(--pl-surface); color: var(--pl-ink); font-size: 14.5px; font-weight: 500; }

  @media (min-width: 1000px) {
    .bl-featured-grid { grid-template-columns: minmax(0,1.7fr) minmax(0,1fr); }
    .bl-nl-grid { grid-template-columns: minmax(0,1.3fr) minmax(0,1fr); }
  }
</style>

<script>
  const search = document.querySelector('[data-bl-search]') as HTMLInputElement | null;
  const cats = Array.from(document.querySelectorAll('[data-bl-cat]')) as HTMLElement[];
  const cards = Array.from(document.querySelectorAll('[data-bl-card]')) as HTMLElement[];
  const empty = document.querySelector('[data-bl-empty]') as HTMLElement | null;
  const title = document.querySelector('[data-bl-title]') as HTMLElement | null;
  const count = document.querySelector('[data-bl-count]') as HTMLElement | null;
  const featured = document.querySelector('[data-bl-featured]') as HTMLElement | null;
  let activeCat = 'All';

  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((c) => {
      const matchCat = activeCat === 'All' || c.dataset.cat === activeCat;
      const matchQ = !q || (c.dataset.name || '').includes(q);
      const show = matchCat && matchQ;
      c.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    if (count) count.textContent = `${visible} ${visible === 1 ? 'article' : 'articles'}`;
    const filtered = q || activeCat !== 'All';
    if (featured) featured.style.display = filtered ? 'none' : '';
    if (title) title.textContent = q ? `Results for "${search?.value.trim()}"` : activeCat === 'All' ? 'Latest from the team' : activeCat;
  };

  search?.addEventListener('input', apply);
  cats.forEach((c) => c.addEventListener('click', () => {
    activeCat = c.dataset.blCat || 'All';
    cats.forEach((o) => { o.classList.toggle('is-on', o === c); o.setAttribute('aria-selected', String(o === c)); });
    apply();
  }));
  document.querySelectorAll('[data-bl-popular]').forEach((b) => b.addEventListener('click', () => {
    if (search) search.value = (b as HTMLElement).dataset.blPopular || '';
    activeCat = 'All';
    cats.forEach((o) => { o.classList.toggle('is-on', o.dataset.blCat === 'All'); o.setAttribute('aria-selected', String(o.dataset.blCat === 'All')); });
    apply();
    document.getElementById('articles')?.scrollIntoView({ behavior: 'smooth' });
  }));
  document.querySelector('[data-bl-reset]')?.addEventListener('click', () => {
    if (search) search.value = '';
    activeCat = 'All';
    cats.forEach((o) => { o.classList.toggle('is-on', o.dataset.blCat === 'All'); o.setAttribute('aria-selected', String(o.dataset.blCat === 'All')); });
    apply();
  });
  document.querySelectorAll('[data-newsletter]').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault(); const i = (f as HTMLFormElement).querySelector('input');
    if (i) { (i as HTMLInputElement).value = ''; i.setAttribute('placeholder', 'Thanks — you’re subscribed ✓'); }
  }));
</script>

<script>
  const fill = document.querySelector('[data-progress]') as HTMLElement | null;
  const onScroll = () => {
    if (!fill) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    fill.style.width = (max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0) + '%';
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  document.querySelector('[data-totop]')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  document.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => {
    navigator.clipboard?.writeText((b as HTMLElement).dataset.copy || '').catch(() => {});
    b.textContent = 'Copied ✓';
    setTimeout(() => { b.textContent = 'Copy link'; }, 1600);
  }));

  const links = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLElement[];
  const heads = links.map((l) => document.getElementById(l.dataset.tocLink || '')).filter(Boolean) as HTMLElement[];
  if (heads.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const id = (e.target as HTMLElement).id;
          links.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === id));
        }
      });
    }, { rootMargin: '-90px 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
  }
</script>

---
import LightBaseLayout from '@/layouts/LightBaseLayout.astro';
import AnnouncementBar from '@/components/layout/AnnouncementBar.astro';
import HeroLight from '@/components/home/light/HeroLight.astro';
import TrustLight from '@/components/home/light/TrustLight.astro';
import ProblemLight from '@/components/home/light/ProblemLight.astro';
import ProductTour from '@/components/home/ProductTour.astro';
import CapabilitiesLight from '@/components/home/light/CapabilitiesLight.astro';
import Accuracy from '@/components/home/Accuracy.astro';
import HowItWorksLight from '@/components/home/light/HowItWorksLight.astro';
import Integrations from '@/components/home/Integrations.astro';
import ResultsLight from '@/components/home/light/ResultsLight.astro';
import CTABanner from '@/components/sections/CTABanner.astro';
---
<LightBaseLayout title="Pricing Intelligence Software for E-commerce & Marketplaces | PriceLeap">
  <AnnouncementBar slot="before-nav" href="#product">PriceLeap Agent answers pricing questions in plain English, right inside your dashboard.</AnnouncementBar>

  <HeroLight />
  <TrustLight />
  <ProblemLight />

  <div class="dark-band">
    <ProductTour />
  </div>

  <CapabilitiesLight />
  <Accuracy />
  <HowItWorksLight />

  <div class="dark-band dark-band--int">
    <Integrations />
  </div>

  <ResultsLight />

  <CTABanner
    title="See your real competitor data in a 15-minute demo."
    text="We'll show PriceLeap running on your products and competitors — accuracy, pricing intelligence, and margin opportunities, live."
  />
</LightBaseLayout>

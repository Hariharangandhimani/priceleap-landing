---
import LightBaseLayout from '@/layouts/LightBaseLayout.astro';
import LAnnouncement from '@/components/light/LAnnouncement.astro';
import LHeader from '@/components/light/LHeader.astro';
import LHero from '@/components/light/LHero.astro';
import LTrusted from '@/components/light/LTrusted.astro';
import LProblem from '@/components/light/LProblem.astro';
import LCapabilities from '@/components/light/LCapabilities.astro';
import LResults from '@/components/light/LResults.astro';
import LCTA from '@/components/light/LCTA.astro';
import LFooter from '@/components/light/LFooter.astro';
---
<LightBaseLayout
  title="Pricing Intelligence Software for E-commerce & Marketplaces | PriceLeap"
  description="PriceLeap gives e-commerce and marketplace teams real-time competitor price tracking, verified data accuracy, and dynamic pricing that protects every point of margin."
>
  <LAnnouncement
    slot="before-header"
    text="PriceLeap Agent answers pricing questions in plain English, right inside your dashboard."
    cta="See it in action →"
    href="#product"
  />

  <LHeader />
  <LHero />
  <LTrusted />
  <LProblem />
  <LCapabilities />
  <LResults />
  <LCTA id="demo" />
  <LFooter />
</LightBaseLayout>

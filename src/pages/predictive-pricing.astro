---
// Native Astro port of the design package's Predictive Pricing page.
// Static initial render + the full 1s animation loop and interactions reimplemented
// in vanilla JS: hero lead-time countdown + forecast chart + pre-stage toggle,
// reveal-triggered probability markers / backtest bars / counters, cycling
// competitor-pattern highlight, horizon tabs and FAQ. Responsive via CSS media queries.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const problems = [['01', 'Monitoring tells you what happened. Every response is therefore a reaction, and the traffic that moved during the gap between their change and yours is gone.'], ['02', 'The same patterns repeat — end-of-quarter clearances, restock cuts, weekend promotions — but nobody has the history in one place to see them coming.'], ['03', "Reacting late forces over-correction. A cut made three days after a rival's is usually deeper than it needed to be, because share has to be won back rather than held."]].map(([n, t]) => ({ n, t }));
const rivalsData: [string, number, string, string, string, string][] = [
  ['Ridgeline Supply', 78, 'next 7 days', 'Cuts within a week of every restock. Inventory landed Tuesday.', '−$2.40 expected', 'stage'],
  ['Northvale Direct', 54, 'next 14 days', 'Quarter-end clearance pattern, three years running.', '−6% category-wide', 'watch'],
  ['Halden Marketplace', 19, 'next 7 days', 'Held price for 63 days. No trigger signal present.', 'no action staged', 'none'],
];
const rivals = rivalsData.map(([n, p, win, dsc, tag, k]) => ({ n, p, win, d: dsc, tag,
  pc: k === 'stage' ? '#C2410C' : '#665A51', bc: k === 'stage' ? '#FFD8BE' : '#EFE3DA', sh: k === 'stage' ? '0 24px 48px -32px rgba(247,99,30,.45)' : 'none',
  tb: k === 'stage' ? '#1C130E' : k === 'watch' ? '#FFF4EC' : '#FBF3EC', tbc: k === 'stage' ? '#1C130E' : k === 'watch' ? '#FFD8BE' : '#EFE3DA', tc: k === 'stage' ? '#FFFFFF' : k === 'watch' ? '#C2410C' : '#7F7066' }));
const triage = [[78, 'STAGED'], [64, 'STAGED'], [42, 'REPORT'], [19, 'REPORT']].map(([p, l]) => ({ p, l, c: (p as number) >= 60 ? '#C2410C' : '#7F7066', bar: (p as number) >= 60 ? '#F7631E' : '#D7C6BA' }));
const pat: [string, string, string, string, number[]][] = [
  ['Ridgeline Supply', 'restock-triggered · Tue / Wed', '11.4 d', '4 of last 4 after restock', [3, 14, 25, 36, 47, 58, 69, 80, 91]],
  ['Northvale Direct', 'calendar-driven · quarter end', '89 d', '3 years, same window', [24, 49, 74, 99]],
  ['Halden Marketplace', 'algorithmic · follows cheapest', '6 h', 'reactive, not predictive', Array.from({ length: 50 }, (_, i) => i * 2)],
  ['Ambervale Retail', 'promotional · weekend depth', '28 d', 'depth −8% to −12%', [10, 38, 66, 94]],
];
const patterns = pat.map(([n, k, mm, note, marks], i) => ({ n, k, m: mm, note, last: i === 3,
  ticks: Array.from({ length: 20 }, (_, j) => { const on = marks.some((x) => Math.floor(x / 5) === j); return { h: on ? (i === 3 ? 90 : 75) : 18, on }; }) }));
const hzData: [string, number, string][] = [
  ['48 hours', 31, 'A move inside 48 hours is possible but not the most likely window.'],
  ['7 days', 78, 'Most likely window. Ridgeline has cut this SKU within six days of every stock replenishment for the last four cycles, and inventory landed Tuesday.'],
  ['14 days', 64, 'Still above the action threshold, with a wider timing interval than seven days.'],
  ['30 days', 42, 'Past fourteen days most categories are reported for planning rather than used to stage prices.'],
];
const backtest = [['48 hours', 91], ['7 days', 84], ['14 days', 71], ['30 days', 48]].map(([t, p]) => ({ t, p: p as number, c: (p as number) >= 70 ? '#1C130E' : '#D7C6BA' }));
const cats = [['Electronics · live', '#1E7A3D'], ['Home & garden · live', '#1E7A3D'], ['Grocery · in backtest', '#F7631E'], ['Apparel · not started', '#D7C6BA']].map(([t, d]) => ({ t, d }));
const fq = [
  ['What is predictive pricing?', 'It is forecasting what competitors will charge next, rather than only recording what they charge now. The output is a probability, an expected price and a window, which together let you prepare a response before the move happens.'],
  ['How is it different from dynamic repricing?', 'Repricing reacts to a change that has already been published. Predictive Pricing anticipates it and stages the reaction in advance, so the two run together: the forecast decides when to be ready, your rules decide what to publish.'],
  ['How much history do you need before forecasts are usable?', 'Roughly six months of observed competitor changes gives workable cadence and depth patterns; twelve to thirty-six months makes seasonal and calendar-driven behaviour reliable. Competitors with too little history are reported as unmodelled rather than guessed at.'],
  ['How accurate are the forecasts?', 'Accuracy is measured per competitor, category and horizon, and published in the product alongside every forecast. Short horizons score far better than long ones, which is why staging is limited to the range that backtests well for your catalog.'],
  ['What happens when a predicted move never arrives?', 'Nothing is published. A pre-staged price waits for confirmation of the predicted move and expires at the end of its window, so a wrong forecast costs no margin.'],
  ['Can we control which forecasts are allowed to act?', 'Yes. You set the probability threshold, the maximum horizon and the categories in scope. Below the threshold a forecast is information only, and every staged price still passes through your floors, caps and MAP commitments.'],
  ['How is Predictive Pricing priced?', "It depends on catalog size, how many competitors you model and the forecast cadence. Book a demo and we'll scope it with you."],
].map(([q, a], i) => ({ q, a, n: String(i + 1).padStart(2, '0') }));
const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logos = [...brandLogos, ...brandLogos];
---
<PriceLeapLayout
  title="AI Predictive Pricing · Forecast competitor price moves · PriceLeap"
  description="PriceLeap learns each competitor's cadence, depth and triggers, forecasts their next move with a probability and a window, and pre-stages your response so it lands the same hour theirs does."
>
  <div class="pp">
    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.10),transparent);pointer-events:none"></div>
      <div class="pp-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(40px,6vw,84px) clamp(16px,4vw,40px) clamp(48px,6vw,88px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>AI Platform · Predictive Pricing</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(42px,6vw,76px);line-height:1;letter-spacing:-.05em;color:#1C130E"><span style="font-weight:400">Predictive </span><span style="font-weight:700">Pricing</span></h1>
          <p style="margin:0;max-width:580px;font-size:18px;line-height:1.65;color:#3A302A;text-wrap:pretty">Competitor price moves are rarely random. PriceLeap learns each rival's cadence, depth and triggers, forecasts the next move with a probability and a window, and pre-stages your response so it lands the same hour theirs does.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Get a Demo</a>
            <a href="/book-a-demo" style="height:48px;padding:0 18px;display:inline-flex;align-items:center;border-radius:12px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E;font-family:Geist,sans-serif;font-weight:500;font-size:15px">See a forecast on your data →</a>
          </div>
        </div>

        <div style="min-width:0;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 48px 90px -52px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
            <span style="font-size:13.5px;font-weight:600;color:#1C130E">Predictive Pricing · 14-day forecast</span>
            <span style="height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:#1C130E;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.06em;color:#FFFFFF">FORECAST v2.4</span>
          </div>
          <div style="padding:16px 16px 6px">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;font-size:12px;color:#665A51"><span>Competitor price · <b style="color:#1C130E">Ridgeline</b></span><span style="display:flex;gap:12px;font-family:'Geist Mono',monospace;font-size:10px"><span style="display:flex;align-items:center;gap:5px"><span style="width:12px;height:2px;background:#1C130E"></span>Observed</span><span style="display:flex;align-items:center;gap:5px"><span style="width:12px;height:0;border-top:2px dashed #F7631E"></span>Forecast</span><span style="display:flex;align-items:center;gap:5px"><span style="width:12px;height:8px;border-radius:2px;background:#FFE3CF"></span>80% interval</span></span></div>
            <svg viewBox="0 0 520 200" style="display:block;width:100%;height:auto;margin-top:10px;overflow:visible">
              <line x1="0" y1="40" x2="520" y2="40" stroke="#F5ECE5"></line><line x1="0" y1="100" x2="520" y2="100" stroke="#F5ECE5"></line><line x1="0" y1="160" x2="520" y2="160" stroke="#F5ECE5"></line>
              <path d="M260,62 L300,66 L340,108 L380,128 L420,124 L460,120 L520,118 L520,160 L460,158 L420,160 L380,162 L340,140 L300,82 L260,62 Z" fill="#FFE3CF" opacity=".75" style="animation:pp-fade 1s ease 1.4s both"></path>
              <polyline points="0,70 30,68 60,72 90,62 120,66 150,60 180,98 210,90 240,66 260,62" fill="none" stroke="#1C130E" stroke-width="2.2" stroke-linejoin="round" pathLength="1" style="stroke-dasharray:1;animation:pp-draw 1.4s ease both"></polyline>
              <polyline points="260,62 300,72 340,124 380,144 420,142 460,139 520,138" fill="none" stroke="#F7631E" stroke-width="2.2" stroke-dasharray="6 5" stroke-linejoin="round" style="animation:pp-fade .6s ease 1.3s both"></polyline>
              <line x1="260" y1="20" x2="260" y2="176" stroke="#1C130E" stroke-dasharray="3 4"></line>
              <rect x="232" y="4" width="56" height="18" rx="5" fill="#1C130E"></rect><text x="260" y="17" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#FFFFFF">TODAY</text>
              <g style="animation:pp-fade .5s ease 1.9s both"><circle cx="340" cy="124" r="5" fill="#F7631E"><animate attributeName="r" values="5;7;5" dur="1.6s" repeatCount="indefinite"></animate></circle><circle cx="340" cy="124" r="5" fill="none" stroke="#F7631E" style="animation:pp-ring 1.8s ease-out infinite"></circle><rect x="352" y="96" width="96" height="20" rx="5" fill="#FFF4EC" stroke="#FFD8BE"></rect><text x="400" y="110" text-anchor="middle" font-family="Geist Mono" font-size="9.5" fill="#C2410C">PREDICTED CUT</text></g>
              <g font-family="Geist Mono" font-size="9.5" fill="#7F7066"><text x="6" y="194">−21d</text><text x="88" y="194">−14d</text><text x="172" y="194">−7d</text><text x="338" y="194">+7d</text><text x="488" y="194">+14d</text></g>
            </svg>
          </div>
          <div class="pp-herostat" style="gap:1px;background:#F5ECE5;border-top:1px solid #F5ECE5">
            <div class="pp-pricecell" style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">PREDICTED PRICE · SKU 48201</div><div style="margin-top:4px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap"><span style="font-family:Geist,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.03em;color:#1C130E">$27.59</span><span style="font-size:12px;color:#665A51;white-space:nowrap">from <s>$29.99</s> · <b style="color:#C2410C">−$2.40</b> expected</span></div></div>
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">PROBABILITY</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:22px;font-weight:600;color:#1C130E">78%</div><div style="margin-top:6px;height:4px;border-radius:4px;background:#F5ECE5"><div style="height:100%;width:78%;border-radius:4px;background:#F7631E;transition:width .6s ease"></div></div></div>
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">WINDOW</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:22px;font-weight:600;color:#1C130E">6 days</div></div>
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">LEAD TIME</div><div data-pp-lead style="margin-top:4px;font-family:Geist,sans-serif;font-size:22px;font-weight:600;color:#1C130E">5d 14h 00m</div></div>
          </div>
          <div style="padding:12px 16px;border-top:1px solid #F5ECE5;display:flex;gap:10px;align-items:flex-start;font-size:12.5px;line-height:1.5;color:#3A302A"><span style="flex:none;margin-top:1px;height:20px;padding:0 7px;display:flex;align-items:center;border-radius:5px;background:#FFF4EC;border:1px solid #FFD8BE;font-family:'Geist Mono',monospace;font-size:9.5px;color:#C2410C">TRIGGER</span><span>Replenishment detected Tuesday · Ridgeline has cut within six days of restock on four of the last four cycles</span></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 16px;border-top:1px solid #F5ECE5;background:#FFF9F4">
            <button type="button" data-pp-stage class="pp-stagebtn" style="height:40px;border-radius:10px;border:1px solid transparent;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-size:13px;font-weight:500;cursor:pointer;transition:all .3s"><span data-pp-stagelabel>Pre-stage response</span></button>
            <button type="button" style="height:40px;border-radius:10px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E;font-size:13px;font-weight:500;cursor:pointer">Extend horizon</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 PROBLEM -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="max-width:900px">
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(28px,3.8vw,46px);line-height:1.1;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">By the time a competitor's price change shows up in a report, </span><span style="font-weight:700">the week is already lost.</span></h2>
        </div>
        <div data-reveal style="margin-top:28px;padding:18px clamp(16px,2.4vw,24px);border:1px solid #EFE3DA;border-radius:18px;background:#FFF9F4">
          <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:#7F7066"><span>RIVAL CUTS</span><span>REPORT ARRIVES</span><span>YOU RESPOND</span></div>
          <div style="position:relative;margin-top:12px;height:28px">
            <span style="position:absolute;left:0;right:0;top:13px;height:2px;background:#EFE3DA"></span>
            <span style="position:absolute;left:4%;top:13px;width:88%;height:2px;background:repeating-linear-gradient(90deg,#F5C6C3 0 6px,transparent 6px 10px)"></span>
            <span style="position:absolute;left:4%;top:7px;width:14px;height:14px;margin-left:-7px;border-radius:50%;background:#B42318;border:2px solid #FFFFFF"></span>
            <span style="position:absolute;left:50%;top:7px;width:14px;height:14px;margin-left:-7px;border-radius:50%;background:#FFFFFF;border:2px solid #7F7066"></span>
            <span style="position:absolute;left:92%;top:7px;width:14px;height:14px;margin-left:-7px;border-radius:50%;background:#1C130E;border:2px solid #FFFFFF"></span>
          </div>
          <div style="margin-top:6px;text-align:center;font-family:'Geist Mono',monospace;font-size:10.5px;color:#B42318">← traffic lost in the gap →</div>
        </div>
        <div data-reveal class="pp-three" style="margin-top:14px;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;background:#EFE3DA;gap:1px">
          {problems.map((p) => (<div style="background:#FFFFFF;padding:26px;display:flex;flex-direction:column;gap:14px"><span style="font-family:Geist,sans-serif;font-size:38px;font-weight:600;letter-spacing:-.05em;line-height:1;color:#E2D3C8">{p.n}</span><p style="margin:0;font-size:15.5px;line-height:1.65;color:#1C130E">{p.t}</p></div>))}
        </div>
      </div>
    </section>

    <!-- 03 APPROACH (probability markers) -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div class="pp-split" style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:center">
        <div data-reveal style="display:flex;flex-direction:column;gap:18px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The approach</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Forecast the move,</span><span style="font-weight:400"> not the aftermath</span></h2>
          <p style="margin:0;font-size:16.5px;line-height:1.7;color:#3A302A">PriceLeap models every tracked competitor separately: how often they move, how deep they cut, which days they favour and what usually precedes a change.</p>
          <p style="margin:0;font-size:16.5px;line-height:1.7;color:#3A302A">Each forecast is published with a probability, a price range and a window — so a 78% call and a 40% call are treated differently rather than both becoming an alert.</p>
          <p style="margin:0;font-size:16.5px;line-height:1.7;color:#3A302A">High-confidence forecasts pre-stage a response in the Pricing Decision Engine. It publishes the moment the predicted move is confirmed, and expires quietly if it never arrives.</p>
        </div>
        <div data-reveal style="display:flex;flex-direction:column;gap:10px">
          {rivals.map((r) => (
            <div style={`background:#FFFFFF;border:1px solid ${r.bc};border-radius:18px;padding:18px 20px;display:flex;flex-direction:column;gap:12px;box-shadow:${r.sh}`}>
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap"><span style="font-family:Geist,sans-serif;font-size:16.5px;font-weight:600;color:#1C130E">{r.n}</span><span style={`font-family:'Geist Mono',monospace;font-size:12px;color:${r.pc}`}>{r.p}% · {r.win}</span></div>
              <div>
                <div style="position:relative;height:8px;border-radius:8px;background:linear-gradient(90deg,#F5ECE5,#FFD8BE 60%,#F7631E)">
                  <span class="pp-rmark" data-pp-rmark={r.p} style="position:absolute;top:50%;left:0%;width:16px;height:16px;margin:-8px 0 0 -8px;border-radius:50%;background:#FFFFFF;border:3px solid #1C130E;box-shadow:0 4px 10px -4px rgba(60,30,15,.5);transition:left 1.2s cubic-bezier(.2,.7,.2,1)"></span>
                  <span style="position:absolute;top:-4px;bottom:-4px;left:60%;width:1.5px;background:#1C130E;opacity:.35"></span>
                </div>
                <div style="display:flex;justify-content:space-between;margin-top:6px;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066"><span>Unlikely</span><span>Near certain</span></div>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap"><span style="flex:1;min-width:200px;font-size:13.5px;line-height:1.5;color:#3A302A">{r.d}</span><span style={`height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;background:${r.tb};border:1px solid ${r.tbc};font-family:'Geist Mono',monospace;font-size:10.5px;color:${r.tc};white-space:nowrap`}>{r.tag}</span></div>
            </div>
          ))}
          <span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:#7F7066">Marker line = action threshold (60%)</span>
        </div>
      </div>
    </section>

    <!-- 04 WHY PREDICTION MATTERS -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>Why prediction matters</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;max-width:820px;text-wrap:balance"><span style="font-weight:400">Why a forecast is worth more than </span><span style="font-weight:700">a faster alert</span></h2>
          <p style="margin:0;font-size:17px;color:#3A302A">Speed only shortens the gap. Knowing the move is coming removes it.</p>
        </div>
        <div data-reveal class="pp-three" style="margin-top:44px;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;background:#EFE3DA;gap:1px">
          <div style="background:#FFFFFF;display:flex;flex-direction:column">

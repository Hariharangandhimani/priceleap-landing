                  <span style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;border:1px solid #EFE3DA;font-family:'Geist Mono',monospace;font-size:10px;color:#3A302A">3y history</span>
                </div>
                <span style="align-self:flex-start;height:30px;padding:0 12px;display:flex;align-items:center;gap:8px;border-radius:8px;background:#FFF4EC;border:1px solid #FFD8BE;font-size:12.5px;font-weight:500;color:#C2410C"><span style="width:7px;height:7px;border-radius:50%;background:#F7631E;animation:pp-pulse 1.6s infinite"></span>Response pre-staged</span>
              </div>

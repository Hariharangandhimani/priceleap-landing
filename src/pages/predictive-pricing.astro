    <!-- 09 TRUSTED BY -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFCF9">
      <div class="pp-logowrap" style="max-width:1280px;margin:0 auto">
        <div class="pp-logolabel" style="padding:22px clamp(16px,4vw,40px);display:flex;align-items:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#665A51">Trusted by teams at</div>
        <div style="overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)">
          <div style="display:flex;width:max-content;animation:pp-marquee 32s linear infinite">
            {logos.map((b, i) => (<div style="flex:none;width:200px;height:84px;display:flex;align-items:center;justify-content:center;border-right:1px solid #F5ECE5"><img src={`/assets/logos/${b}.svg`} alt={i < brandLogos.length ? b : ''} loading="lazy" style="height:34px;max-width:150px;width:auto;object-fit:contain" /></div>))}
          </div>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .pp { background: #FFFCF9; overflow-x: clip; }
  @keyframes pp-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pp-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes pp-ring { 0% { r: 5; opacity: .6; } 100% { r: 16; opacity: 0; } }
  @keyframes pp-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes pp-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 7px rgba(247,99,30,0); } }
  @keyframes pp-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .pp *, .pp *::before, .pp *::after { animation: none !important; transition: none !important; } }

  .pp-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .pp-hero { grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); } }
  .pp-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .pp-split { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); } }
  .pp-sticky { position: static; }
  @media (min-width: 1024px) { .pp-sticky { position: sticky; } }
  .pp-herostat { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); }
  .pp-pricecell { grid-column: 1 / -1; }
  @media (min-width: 600px) { .pp-herostat { grid-template-columns: minmax(0,1.5fr) repeat(3,minmax(0,1fr)); } .pp-pricecell { grid-column: auto; } }
  .pp-three { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .pp-three { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  .pp-stepg { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .pp-stepg { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); } }
  .pp-stepgr { display: grid; grid-template-columns: 1fr; }
  .pp-s2panel { order: 1; }
  @media (min-width: 1024px) { .pp-stepgr { grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr); } .pp-s2panel { order: 0; } }
  .pp-patrow { grid-template-columns: minmax(0,1fr) 90px; }
  .pp-patrow .pp-patnote { grid-column: 1 / -1; }
  @media (min-width: 720px) { .pp-patrow { grid-template-columns: minmax(0,1.2fr) minmax(0,1fr) 90px minmax(0,.9fr); } .pp-patrow .pp-patnote { grid-column: auto; } }
  .pp-out { display: grid; grid-template-columns: 1fr; }
  .pp-quote { grid-column: 1 / -1; }
  @media (min-width: 720px) { .pp-out { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .pp-out { grid-template-columns: minmax(0,1fr) minmax(0,1fr) minmax(0,2fr); } .pp-quote { grid-column: auto; } }
  .pp-case { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .pp-case { grid-template-columns: minmax(0,2fr) minmax(0,1fr); } }
  .pp-caseinner { grid-template-columns: 1fr; }
  @media (min-width: 600px) { .pp-caseinner { grid-template-columns: 200px minmax(0,1fr); } }
  .pp-logowrap { display: grid; grid-template-columns: 1fr; border-bottom: none; }
  .pp-logolabel { border-bottom: 1px solid #EFE3DA; }
  @media (min-width: 720px) { .pp-logowrap { grid-template-columns: 260px minmax(0,1fr); } .pp-logolabel { border-right: 1px solid #EFE3DA; border-bottom: none; } }

  .pp-hz.is-on { background: #FFFFFF; }
  .pp-hz.is-on .pp-hz-t { color: #C2410C; }
  .pp-hz.is-on .pp-hz-v { color: #1C130E; }
  .pp-hz.is-on .pp-hz-under { background: #1C130E; }
  .pp-stagebtn.is-staged { background: #1C130E !important; border-color: #1C130E !important; }
  .pp-faq.is-open { border-color: #FFD8BE; }
  .pp-faq.is-open .pp-faq-plus { background: #1C130E; color: #FFFFFF; transform: rotate(45deg); }
  .pp-faq.is-open .pp-faq-n { color: #C2410C; }
  .pp-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .pp-faq.is-open .pp-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.pp');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---- lead-time countdown + pattern highlight + counters (1s loop) ----
    let lead = 5 * 86400 + 14 * 3600, tick = 0, seen = false, seenTick = 0;
    const leadEl = q('[data-pp-lead]');
    const pats = qa('[data-pp-pat]');
    const cStaged = q('[data-pp-cstaged]'), cPub = q('[data-pp-cpub]'), cExp = q('[data-pp-cexp]');

    const paintLead = () => { const d = Math.floor(lead / 86400), h = Math.floor(lead % 86400 / 3600), m = Math.floor(lead % 3600 / 60); if (leadEl) leadEl.textContent = d + 'd ' + h + 'h ' + String(m).padStart(2, '0') + 'm'; };
    const paintHot = () => {
      const hot = Math.floor(tick / 3) % 4;
      pats.forEach((row, i) => {
        row.style.background = i === hot ? '#FFF9F4' : '#FFFFFF';
        row.querySelectorAll('.pp-tick').forEach((t) => { if ((t as HTMLElement).getAttribute('data-on') === '1') (t as HTMLElement).style.background = i === hot ? '#F7631E' : '#1C130E'; });
      });
    };
    const paintCounters = () => {
      const prog = seen ? Math.min(1, (tick - seenTick) / 6) : 0;
      if (cStaged) cStaged.textContent = String(Math.round(612 * prog));
      if (cPub) cPub.textContent = String(Math.round(487 * prog));
      if (cExp) cExp.textContent = String(Math.round(125 * prog));
    };
    const onSeen = () => {
      if (seen) return; seen = true; seenTick = tick;
      qa('[data-pp-rmark]').forEach((el) => (el.style.left = el.getAttribute('data-pp-rmark') + '%'));
      qa('[data-pp-bt]').forEach((el) => (el.style.width = el.getAttribute('data-pp-bt') + '%'));
    };

    paintLead(); paintHot(); paintCounters();
    setInterval(() => {
      tick++; lead = lead > 0 ? lead - 37 : 5 * 86400 + 14 * 3600;
      paintLead(); paintHot(); paintCounters();
    }, 1000);

    // ---- pre-stage toggle ----
    const stageBtn = q('[data-pp-stage]'), stageLabel = q('[data-pp-stagelabel]');
    let staged = false;
    stageBtn?.addEventListener('click', () => {
      staged = !staged;
      stageBtn.classList.toggle('is-staged', staged);
      if (stageLabel) stageLabel.textContent = staged ? '✓ Response pre-staged' : 'Pre-stage response';
    });

    // ---- horizon tabs ----
    const hzNotes = ['A move inside 48 hours is possible but not the most likely window.', 'Most likely window. Ridgeline has cut this SKU within six days of every stock replenishment for the last four cycles, and inventory landed Tuesday.', 'Still above the action threshold, with a wider timing interval than seven days.', 'Past fourteen days most categories are reported for planning rather than used to stage prices.'];
    const hzNote = q('[data-pp-hznote]'), hzFull = q('[data-pp-hzfull]'), hzPartial = q('[data-pp-hzpartial]');
    qa('[data-pp-hz]').forEach((btn) => btn.addEventListener('click', () => {
      const i = Number(btn.getAttribute('data-pp-hz'));
      qa('[data-pp-hz]').forEach((b) => { const on = b === btn; b.classList.toggle('is-on', on); b.setAttribute('aria-selected', String(on)); });
      if (hzNote) hzNote.textContent = hzNotes[i];
      const full = i === 1;
      if (hzFull) hzFull.style.display = full ? 'flex' : 'none';
      if (hzPartial) hzPartial.hidden = full;
    }));

    // ---- faq ----
    qa('[data-pp-faq-btn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-pp-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-pp-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-pp-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal (triggers bar fills + counters) ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); onSeen(); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); onSeen(); }
  }
</script>

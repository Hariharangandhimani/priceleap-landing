---
// Native Astro port of the design package's "For Retailers" page.
// Static initial render + the full animation loops and interactions reimplemented in
// vanilla JS: hero dashboard (price index / alerts counters, cycling category bars +
// alert feed), auto-advancing solution tabs (clickable), before/after toggle, feature
// demos (match bars, price-history draw, position bars, cycling sinks), SKU counter on
// reveal, pricing calculator (sliders + frequency) and FAQ. Responsive via CSS media.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const cats: [string, number][] = [['Grocery', -2.3], ['Electronics', 4.1], ['Home', -1.0], ['Beauty', 1.8], ['Toys', -3.2], ['Apparel', 0.6], ['Garden', -1.6]];
const catBar = (n: string, d: number, i: number, tk: number) => { const jitter = i === (tk % 7) ? (d < 0 ? -0.6 : 0.6) : 0, v = d + jitter; return { n, d: (v > 0 ? '+' : '−') + Math.abs(v).toFixed(1) + '%', h: Math.max(18, Math.min(96, 60 + v * 8)), c: v < 0 ? 'var(--pl-accent)' : v > 3 ? 'var(--pl-danger)' : '#D5DAD5', tc: v < 0 ? 'var(--pl-accent-ink)' : v > 3 ? 'var(--pl-danger-ink)' : 'var(--pl-muted)', dl: (i * 0.06).toFixed(2) }; };
const catBarsInit = cats.map(([n, d], i) => catBar(n, d, i, 0));

const alertData = [
  { t: 'Competitor A cut 34 SKUs · Grocery', d: '−3.8%', c: 'var(--pl-danger-ink)', m: 'REGION NORTH · 2M AGO' },
  { t: 'Marketplace B above you · Electronics', d: '+5.2%', c: 'var(--pl-accent-ink)', m: 'MARKETPLACE · 6M AGO' },
  { t: 'Banner C promo started · Toys', d: '−12%', c: 'var(--pl-danger-ink)', m: 'BANNER C · 11M AGO' },
  { t: 'Out of stock at Competitor D · Home', d: 'OOS', c: 'var(--pl-ink-2)', m: 'ONLINE · 18M AGO' },
  { t: 'Private-label match found · Beauty', d: '91%', c: 'var(--pl-accent-ink)', m: 'MATCHING · 24M AGO' },
];
const alertFeedInit = [0, 1, 2, 3].map((i) => alertData[i]);

const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logoLoop = [...brandLogos, ...brandLogos];

const sheetVals = ['SKU', 'YOU', 'COMP', 'Δ', '4471', '$12', '$11', '?', '4472', '$8', '—', '?', '4473', '$21', '$19', '?'];
const sheet = sheetVals.map((v, i) => ({ v, an: (i > 3 && (i % 4 === 2 || i % 4 === 3)) ? `pi-cell 2.4s ease ${(i * 0.15).toFixed(2)}s infinite` : 'none' }));
const covered = [0, 1, 2, 5, 6, 9, 11, 12, 15, 18, 20, 21, 24, 27, 30, 31, 33, 36, 38];
const coverage = Array.from({ length: 40 }, (_, i) => { const on = covered.includes(i); return { bg: on ? 'var(--pl-accent)' : 'var(--pl-surface)', bc: on ? 'var(--pl-accent)' : 'var(--pl-line-xstrong)', bs: on ? 'solid' : 'dashed' }; });

const solData = [
  { n: '01', t: 'Discover & match', chips: [['Sites found', '214'], ['Variant-level', '✓'], ['Private label', '✓']] },
  { n: '02', t: 'Monitor competitor prices', chips: [['Cadence', 'Daily'], ['Regions', 'All'], ['History', 'Full']] },
  { n: '03', t: 'See your price position', chips: [['By SKU', '✓'], ['By category', '✓'], ['By region', '✓']] },
  { n: '04', t: 'Optimize and act', chips: [['Alerts', 'On'], ['API / BI', '✓'], ['Optimization', 'Feeds']] },
];
const solInit = solData.map((d, i) => { const on = i === 0; return { ...d, bg: on ? 'var(--pl-accent)' : 'var(--pl-surface)', bc: on ? 'var(--pl-accent)' : 'var(--pl-line)', sh: on ? '0 0 0 8px rgba(247,99,30,.16),0 16px 30px -14px rgba(247,99,30,.8)' : '0 10px 20px -16px rgba(60,30,15,.4)', cb: on ? 'var(--pl-accent-line)' : 'var(--pl-line)', csh: on ? '0 24px 44px -28px rgba(194,65,12,.5)' : 'none' }; });

const audit = [
  { n: 'Store brand Oat Milk 1L', k: 'PRIVATE LABEL', v: '0.87', bg: 'var(--pl-warn-tint)', bc: 'var(--pl-warn-line)', c: 'var(--pl-warn-ink)' },
  { n: 'Sonix ANC 700 · Black', k: 'EXACT · EAN', v: '0.99', bg: 'var(--pl-accent-tint)', bc: 'var(--pl-accent-line)', c: 'var(--pl-accent-ink)' },
  { n: 'Detergent Pods 42ct → 60ct', k: 'VARIANT · PACK SIZE', v: '0.93', bg: 'var(--pl-accent-tint)', bc: 'var(--pl-accent-line)', c: 'var(--pl-accent-ink)' },
];
const matchBars = [['Exact matches', 98, '98% exact', 'var(--pl-accent)', 'var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)'], ['Variant matches', 91, '91% variant', 'var(--pl-accent)', 'var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)'], ['Private-label / similar', 74, '74% review', '#F0B44C', 'var(--pl-warn-tint)', 'var(--pl-warn-line)', 'var(--pl-warn-ink)']].map(([n, v, label, bar, bg, bc, c], i) => ({ n, v, label, bar, bg, bc, c, dl: (i * 0.2).toFixed(1) }));
const posBars = [62, 70, 48, 55, 80, 66, 44, 72, 58, 50, 84, 61, 46, 68, 53, 77, 49, 64].map((h, i) => ({ h, c: h > 62 ? 'var(--pl-danger)' : 'var(--pl-accent)', dl: (i * 0.04).toFixed(2) }));
const sinksInit = ['BI', 'ERP', 'PIM', 'Feeds'].map((t, i) => ({ t, bg: i === 0 ? 'var(--pl-accent-tint)' : 'var(--pl-surface)', dot: i === 0 ? 'var(--pl-accent)' : 'var(--pl-line-xstrong)' }));

// before/after — initial ba=1 (With PriceLeap)
const aList = ['Competitor prices arrive automatically on the cadence you set.', 'Your full catalog is monitored, into the millions of SKUs.', 'Products are matched down to the variant, so teams trust what they see.', 'Every region, marketplace, and banner sits in one view.'];
const baListInit = aList.map((t, i) => ({ t, dl: (0.08 * i + 0.1).toFixed(2) }));

const skuLabels = ['1K', '10K', '100K', '500K', '1M', '5M+'];
const faqData = [
  ['How accurate is your product matching?', '[X]% on exact and variant matches, with confidence scores and human review on the rest.'],
  ['How often does the data refresh?', 'As often as daily or intraday, set per category or competitor.'],
  ['How many SKUs and competitors can you handle?', 'Millions of SKUs across many competitors and marketplaces, without performance trade-offs.'],
  ['Is this a tracker or a retail price optimization software?', "It's the intelligence layer underneath optimization — accurate competitor data and price-position signals for your team or your optimization tools to act on."],
  ['Will it fit our existing pricing and ERP systems?', 'Yes — data flows in by API, BI connectors, or feeds into your ERP/PIM.'],
  ['How long does onboarding take?', 'Typically a few weeks, with a named solutions architect through go-live.'],
  ['Is our data secure?', 'SOC 2 / ISO 27001 certified with full access controls.'],
].map(([q, a], i) => ({ q, a, open: i === 0, n: '0' + (i + 1) }));
---
<PriceLeapLayout
  title="Retail Price Intelligence · PriceLeap"
  description="Competitor prices for your entire catalog, matched accurately and refreshed every day."
>
  <div class="fr" style="min-height:100vh;background:var(--pl-surface);overflow-x:clip">

    <!-- HERO -->
    <section id="top" style="position:relative;border-bottom:1px solid var(--pl-line);overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(var(--pl-line-alt) 1px,transparent 1px);background-size:22px 22px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 50% 20%,#000 10%,transparent 70%);mask-image:radial-gradient(ellipse 60% 70% at 50% 20%,#000 10%,transparent 70%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;left:50%;bottom:-260px;width:1100px;height:560px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.16),transparent);pointer-events:none"></div>
      <div style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,40px) 0;display:flex;flex-direction:column;align-items:center;text-align:center">
        <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--pl-muted)"><a href="/" style="color:var(--pl-muted)">Solutions</a><span style="color:var(--pl-line-xstrong)">/</span><span style="color:var(--pl-ink)">For Retailers</span></div>
        <span style="margin-top:24px;height:32px;padding:0 6px 0 14px;display:inline-flex;align-items:center;gap:10px;border-radius:999px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink);box-shadow:0 8px 20px -14px rgba(60,30,15,.3)"><span style="width:7px;height:7px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.8s infinite"></span>Retail Price Intelligence<span style="height:22px;padding:0 8px;display:flex;align-items:center;border-radius:999px;background:var(--pl-ink);color:var(--pl-surface);font-size:10px;letter-spacing:.06em">FOR RETAILERS</span></span>
        <h1 style="margin:22px 0 0;font-family:Geist,sans-serif;font-size:clamp(38px,5.6vw,72px);line-height:1.02;letter-spacing:-.045em;color:var(--pl-ink);max-width:1040px;text-wrap:balance"><span style="font-weight:700">Competitor prices for your entire catalog,</span><span style="font-weight:400"> matched accurately and refreshed every day.</span></h1>
        <p style="margin:22px 0 0;max-width:720px;font-size:18px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">Retail Price Intelligence finds your products across competitor sites and marketplaces, matches them down to the variant, and shows your category teams exactly where they stand on price.</p>
        <p style="margin:10px 0 0;max-width:720px;font-size:15px;line-height:1.6;color:var(--pl-muted)">The clean competitive data your retail price optimization software has been missing.</p>
        <div style="margin-top:28px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center">
          <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Book a demo</a>
          <a href="#demo" style="height:48px;padding:0 20px;display:inline-flex;align-items:center;gap:10px;border-radius:12px;background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">Talk to sales<span style="color:var(--pl-accent-ink)">→</span></a>
        </div>
        <div style="margin-top:28px;display:flex;flex-wrap:wrap;justify-content:center;border:1px solid var(--pl-line);border-radius:12px;background:var(--pl-surface);overflow:hidden">
          <span style="height:38px;padding:0 16px;display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink);border-right:1px solid var(--pl-line-soft)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient)"></span>1M+ SKUs tracked</span>
          <span style="height:38px;padding:0 16px;display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink);border-right:1px solid var(--pl-line-soft)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient)"></span>[X]% match accuracy</span>
          <span style="height:38px;padding:0 16px;display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient)"></span>Refreshed daily</span>
        </div>

        <div style="position:relative;margin-top:56px;width:100%;max-width:1080px">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-bottom:none;border-radius:20px 20px 0 0;box-shadow:0 -10px 60px -30px rgba(60,30,15,.25);overflow:hidden;text-align:left">
            <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)">
              <span style="display:flex;gap:5px"><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span></span>
              <span style="flex:1;max-width:340px;margin:0 auto;height:26px;border-radius:8px;background:var(--pl-surface);border:1px solid var(--pl-line);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-muted)">app.priceleap.io/price-position</span>
              <span style="display:flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:999px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span>LIVE</span>
            </div>
            <div class="fr-dash" style="display:grid;gap:1px;background:var(--pl-line-soft)">
              <div style="background:var(--pl-surface);display:grid;grid-template-rows:auto 1fr">
                <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--pl-line-soft);border-bottom:1px solid var(--pl-line-soft)">
                  <div style="background:var(--pl-surface);padding:16px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">PRICE INDEX</div><div data-fr-idx style="margin-top:4px;font-family:Geist,sans-serif;font-size:30px;font-weight:600;letter-spacing:-.04em;color:var(--pl-ink)">98.4</div></div>
                  <div style="background:var(--pl-surface);padding:16px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">BELOW MKT</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:30px;font-weight:600;letter-spacing:-.04em;color:var(--pl-accent-ink)">41%</div></div>
                  <div style="background:var(--pl-surface);padding:16px 18px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">ALERTS</div><div style="margin-top:4px;display:flex;align-items:center;gap:8px;font-family:Geist,sans-serif;font-size:30px;font-weight:600;letter-spacing:-.04em;color:var(--pl-ink)"><span data-fr-alerts>12</span><span style="width:8px;height:8px;border-radius:50%;background:var(--pl-danger);animation:pi-blink 1.2s steps(1) infinite"></span></div></div>
                </div>
                <div style="padding:18px">
                  <div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:14px;font-weight:600;color:var(--pl-ink)">Price index by category</span><span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-faint)">this week</span></div>
                  <div style="margin-top:16px;display:flex;align-items:flex-end;gap:clamp(8px,2vw,18px);height:150px;border-bottom:1px solid var(--pl-line-soft);position:relative">
                    <span style="position:absolute;left:0;right:0;bottom:60%;border-top:1px dashed var(--pl-line-xstrong)"></span>
                    <span style="position:absolute;right:0;bottom:calc(60% + 4px);font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-faint)">MARKET 100</span>
                    {catBarsInit.map((b) => (
                      <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:6px">
                        <span data-fr-catd style={`font-family:'Geist Mono',monospace;font-size:10px;color:${b.tc}`}>{b.d}</span>
                        <span data-fr-catbar style={`width:100%;max-width:44px;height:${b.h}%;border-radius:6px 6px 0 0;background:${b.c};transform-origin:bottom;animation:pi-growy .9s cubic-bezier(.2,.7,.2,1) ${b.dl}s both;transition:height .8s cubic-bezier(.2,.7,.2,1)`}></span>
                      </div>
                    ))}
                  </div>
                  <div style="display:flex;gap:clamp(8px,2vw,18px);margin-top:8px">
                    {catBarsInit.map((b) => (<span style="flex:1;text-align:center;font-size:11px;color:var(--pl-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{b.n}</span>))}
                  </div>
                </div>
              </div>
              <div class="fr-alerts" style="background:var(--pl-cream);padding:16px;flex-direction:column;gap:8px">
                <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)"><span>ALERTS</span><span style="color:var(--pl-accent-ink)">12 OPEN</span></div>
                <div data-fr-alertfeed style="display:flex;flex-direction:column;gap:8px">
                  {alertFeedInit.map((a) => (
                    <div style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;animation:pi-in .45s ease">
                      <span style="display:flex;justify-content:space-between;gap:8px"><span style="font-size:12px;font-weight:600;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{a.t}</span><span style={`font-family:'Geist Mono',monospace;font-size:11px;color:${a.c}`}>{a.d}</span></span>
                      <span style="font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-faint)">{a.m}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGOS -->
    <section style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div class="fr-logos" style="max-width:1280px;margin:0 auto;display:grid">
        <div class="fr-logolabel" style="padding:22px clamp(20px,4vw,40px);display:flex;align-items:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-muted)">Trusted by teams at</div>
        <div style="overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)">
          <div style="display:flex;width:max-content;animation:pi-marquee 32s linear infinite">
            {logoLoop.map((n, i) => (<div style="flex:none;width:188px;height:104px;display:flex;align-items:center;justify-content:center;border-right:1px solid var(--pl-line-soft)"><img src={`/assets/logos/${n}.svg`} alt={i < brandLogos.length ? n : ''} loading="lazy" style="height:50px;max-width:168px;width:auto;object-fit:contain" /></div>))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section id="problem" style="border-bottom:1px solid var(--pl-line)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px 64px;align-items:end">
          <div>
            <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-danger-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-danger)"></span>The problem</span>
            <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">Pricing at your scale </span><span style="font-weight:700">breaks the tools built for small stores.</span></h2>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.06em;color:var(--pl-faint)"><span>100 SKUs</span><span>1K</span><span>10K</span><span>100K</span><span style="color:var(--pl-ink)">1M+</span></div>
            <div style="position:relative;height:10px;border-radius:10px;background:linear-gradient(90deg,var(--pl-accent) 0 34%,var(--pl-danger-line) 34% 100%)">
              <span style="position:absolute;left:34%;top:-8px;bottom:-8px;width:2px;background:var(--pl-danger-ink)"></span>
              <span style="position:absolute;left:34%;top:calc(100% + 12px);transform:translateX(-50%);height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:var(--pl-danger-tint);border:1px solid var(--pl-danger-line);font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-danger-ink);white-space:nowrap">MOST TOOLS STOP HERE</span>
              <span style="position:absolute;right:0;top:50%;width:16px;height:16px;margin-top:-8px;border-radius:50%;background:var(--pl-ink);border:3px solid var(--pl-surface);box-shadow:0 0 0 1px var(--pl-ink)"></span>
            </div>
            <span style="align-self:flex-end;font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-ink)">YOUR CATALOG</span>
          </div>
        </div>
        <div data-reveal style="margin-top:48px;border:1px solid var(--pl-line);border-radius:24px;overflow:hidden;background:var(--pl-line);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1px">
          <div style="background:var(--pl-surface);display:flex;flex-direction:column">
            <div style="height:170px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream);display:flex;align-items:center;justify-content:center;padding:18px">
              <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--pl-line);border:1px solid var(--pl-line);border-radius:8px;overflow:hidden;width:200px">
                {sheet.map((c) => (<span style={`height:24px;background:var(--pl-surface);font-family:'Geist Mono',monospace;font-size:9px;color:var(--pl-muted);display:flex;align-items:center;justify-content:center;animation:${c.an}`}>{c.v}</span>))}
              </div>
            </div>

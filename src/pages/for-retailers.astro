---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';
import Faq from '../components/pl/Faq.astro';
import '../styles/pl-marketing.css';

const logos = [...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank'], ...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank']];
const catBars = [
  { n: 'Electronics', d: '96', h: 56, c: 'var(--pl-accent)' }, { n: 'Home', d: '104', h: 66, c: 'var(--pl-danger-line)' },
  { n: 'Apparel', d: '92', h: 48, c: 'var(--pl-accent)' }, { n: 'Grocery', d: '101', h: 62, c: 'var(--pl-danger-line)' },
  { n: 'Beauty', d: '88', h: 42, c: 'var(--pl-accent)' }, { n: 'Sports', d: '99', h: 58, c: 'var(--pl-accent-line-2)' }, { n: 'Toys', d: '95', h: 52, c: 'var(--pl-accent)' },
];
const alertFeed = [
  { t: 'Rival B cut 4K TVs', d: '−6.2%', c: 'var(--pl-danger-ink)', m: 'Electronics · 2m ago' },
  { t: 'Marketplace A out of stock', d: '0 units', c: 'var(--pl-warn-ink)', m: 'Home · 14m ago' },
  { t: 'Banner C promo launched', d: '20% off', c: 'var(--pl-accent-ink)', m: 'Beauty · 31m ago' },
  { t: 'MAP violation detected', d: '≤ MAP', c: 'var(--pl-danger-ink)', m: 'Sports · 1h ago' },
];
const problems = [
  { n: '01', t: 'Your category managers still rebuild competitor price sheets by hand. By the time a sheet is ready, half the prices have already moved.' },
  { n: '02', t: 'Most repricing tools quietly fall over past a few thousand SKUs. Your catalog runs into the millions.' },
  { n: '03', t: 'Matching your products to competitor listings is manual, so coverage is patchy and nobody fully trusts the numbers.' },
  { n: '04', t: "Prices shift by region, marketplace, and banner, and there's no single place to see all of it at once." },
];
const sol = [
  { n: '01', t: 'Find', chips: [['Sources', '38'], ['Marketplaces', '12'], ['Regions', '6']] },
  { n: '02', t: 'Match', chips: [['Exact', '71%'], ['Variant', '22%'], ['Review', '7%']] },
  { n: '03', t: 'Monitor', chips: [['Daily', 'core'], ['Intraday', 'priority'], ['Weekly', 'long-tail']] },
  { n: '04', t: 'Deliver', chips: [['API', 'live'], ['BI', 'push'], ['ERP/PIM', 'feed']] },
];
const audit = [
  { n: 'Aurora 55" 4K TV', k: 'EXACT MATCH', v: '99.4%', bg: 'var(--pl-accent-tint)', bc: 'var(--pl-accent-line)', c: 'var(--pl-accent-ink)' },
  { n: 'NovaBook Air 14', k: 'VARIANT MATCH', v: '96.1%', bg: 'var(--pl-cream)', bc: 'var(--pl-line)', c: 'var(--pl-ink-2)' },
  { n: 'House-brand kettle', k: 'PRIVATE LABEL', v: '91.8%', bg: 'var(--pl-cream)', bc: 'var(--pl-line)', c: 'var(--pl-ink-2)' },
];
const baList = [
  { mk: '✓', t: 'Every price matched to the right product, down to the variant.' },
  { mk: '✓', t: 'Full catalog refreshed on the cadence you set — no manual sheets.' },
  { mk: '✓', t: 'One live view across regions, marketplaces and banners.' },
  { mk: '✓', t: 'Clean data pushed into your BI, ERP/PIM or API.' },
];
const features = [
  { n: '01', t: 'AI product matching', d: 'Exact, variant and private-label matches across competitor sites and marketplaces, each with a confidence score and human review on the rest.' },
  { n: '02', t: 'Competitor price monitoring', d: 'Daily or intraday refresh per category and competitor — promotions, stock status and shelf vs promo price tracked separately.' },
  { n: '03', t: 'Price position, ready to act on', d: 'Revenue-weighted price index by category, gap analysis and alerts, surfaced where your team already works.' },
  { n: '04', t: 'Data delivery & integrations', d: 'Push clean competitive data into your BI, ERP/PIM, or any system by API — not one more dashboard to check.' },
];
const faqs = [
  { q: 'How accurate is your product matching?', a: '[X]% on exact and variant matches, with confidence scores and human review on the rest.' },
  { q: 'How often does the data refresh?', a: 'As often as daily or intraday, set per category or competitor.' },
  { q: 'How many SKUs and competitors can you handle?', a: 'Millions of SKUs across many competitors and marketplaces, without performance trade-offs.' },
  { q: 'Is this a tracker or a retail price optimization software?', a: "It's the intelligence layer underneath optimization — accurate competitor data and price-position signals for your team or your optimization tools to act on." },
  { q: 'Will it fit our existing pricing and ERP systems?', a: 'Yes — data flows in by API, BI connectors, or feeds into your ERP/PIM.' },
  { q: 'How long does onboarding take?', a: 'Typically a few weeks, with a named solutions architect through go-live.' },
  { q: 'Is our data secure?', a: 'SOC 2 / ISO 27001 certified with full access controls.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Retail Price Intelligence for Retailers', provider: { '@type': 'Organization', name: 'PriceLeap' }, url: 'https://priceleap.ai/for-retailers' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PriceLeapLayout title="For Retailers · Retail Price Intelligence · PriceLeap" description="Competitor prices for your entire catalog, matched accurately and refreshed every day. The clean competitive data your retail price optimization has been missing." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="fr-hero">
    <div aria-hidden="true" class="fr-hero-dots"></div>
    <div aria-hidden="true" class="fr-hero-glow"></div>
    <div class="fr-hero-inner">
      <nav class="fr-crumbs"><a href="/">Solutions</a><span>/</span><span class="fr-crumb-cur">For Retailers</span></nav>
      <span class="fr-badge"><span class="fr-badge-dot"></span>Retail Price Intelligence<span class="fr-badge-tag">FOR RETAILERS</span></span>
      <h1 class="fr-h1"><span style="font-weight:700">Competitor prices for your entire catalog,</span><span style="font-weight:400"> matched accurately and refreshed every day.</span></h1>
      <p class="fr-lead">Retail Price Intelligence finds your products across competitor sites and marketplaces, matches them down to the variant, and shows your category teams exactly where they stand on price.</p>
      <p class="fr-lead fr-lead--muted">The clean competitive data your retail price optimization software has been missing.</p>
      <div class="mk-hero-cta" style="justify-content:center"><a href="/contact" class="mk-btn-primary">Book a demo</a><a href="/contact" class="mk-btn-ghost">Talk to sales<span style="color:var(--pl-accent-ink)">→</span></a></div>
      <div class="fr-stats">
        {['1M+ SKUs tracked', '[X]% match accuracy', 'Refreshed daily'].map((t) => (<span class="fr-stat"><span class="fr-stat-dot"></span>{t}</span>))}
      </div>
      <div class="fr-dash">
        <div class="fr-dash-bar">
          <span class="fr-dots3"><span></span><span></span><span></span></span>
          <span class="fr-url">app.priceleap.io/price-position</span>
          <span class="fr-dash-live"><span class="mk-live-dot"></span>LIVE</span>
        </div>
        <div class="fr-dash-body">
          <div class="fr-dash-main">
            <div class="fr-kpis">
              <div class="fr-kpi"><div class="fr-kpi-k">PRICE INDEX</div><div class="fr-kpi-v">97.4</div></div>
              <div class="fr-kpi"><div class="fr-kpi-k">BELOW MKT</div><div class="fr-kpi-v" style="color:var(--pl-accent-ink)">41%</div></div>
              <div class="fr-kpi"><div class="fr-kpi-k">ALERTS</div><div class="fr-kpi-v">12<span class="fr-kpi-dot"></span></div></div>
            </div>
            <div class="fr-chart-wrap">
              <div class="fr-chart-head"><span>Price index by category</span><span class="fr-chart-sub">this week</span></div>
              <div class="fr-chart">
                <span class="fr-chart-line"></span><span class="fr-chart-mkt">MARKET 100</span>
                {catBars.map((b) => (<div class="fr-bar-col"><span class="fr-bar-d" style={`color:${b.c === 'var(--pl-danger-line)' ? 'var(--pl-danger-ink)' : 'var(--pl-accent-ink)'}`}>{b.d}</span><span class="fr-bar" style={`height:${b.h}%;background:${b.c}`}></span></div>))}
              </div>
              <div class="fr-chart-labels">{catBars.map((b) => (<span>{b.n}</span>))}</div>
            </div>
          </div>
          <div class="fr-dash-side">
            <div class="fr-side-head"><span>ALERTS</span><span style="color:var(--pl-accent-ink)">12 OPEN</span></div>
            {alertFeed.map((a) => (
              <div class="fr-alert"><span class="fr-alert-top"><span class="fr-alert-t">{a.t}</span><span class="fr-alert-d" style={`color:${a.c}`}>{a.d}</span></span><span class="fr-alert-m">{a.m}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="mk-logos mk-cream">
    <div class="mk-logos-wrap"><div class="mk-logos-label">Trusted by teams at</div><div class="mk-logos-marq-wrap"><div class="mk-logos-marq">{logos.map((l) => (<div class="mk-logo">{l}</div>))}</div></div></div>
  </section>

  <!-- Problem -->
  <section id="problem" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="fr-prob-head">
        <div>
          <span class="mk-eyebrow mk-eyebrow--danger"><span class="mk-sq mk-sq--danger"></span>The problem</span>
          <h2 class="mk-h2"><span style="font-weight:400">Pricing at your scale </span><span style="font-weight:700">breaks the tools built for small stores.</span></h2>
        </div>
        <div class="fr-scale">
          <div class="fr-scale-labels"><span>100 SKUs</span><span>1K</span><span>10K</span><span>100K</span><span style="color:var(--pl-ink)">1M+</span></div>
          <div class="fr-scale-bar"><span class="fr-scale-mark"></span><span class="fr-scale-stop">MOST TOOLS STOP HERE</span><span class="fr-scale-you"></span></div>
          <span class="fr-scale-cat">YOUR CATALOG</span>
        </div>
      </div>
      <div data-reveal class="fr-probs">
        {problems.map((p) => (<div class="fr-prob"><span class="fr-prob-n">{p.n}</span><p>{p.t}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section id="solution" class="mk-sec mk-cream fr-sol-sec">
    <div aria-hidden="true" class="fr-sol-grid"></div>
    <div class="mk-wrap" style="position:relative">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>The solution</span>
        <h2 class="mk-h2" style="max-width:900px"><span style="font-weight:700">Retail Price Intelligence</span><span style="font-weight:400"> does the matching and monitoring so your team doesn't.</span></h2>
        <p class="mk-center-p">It locates where your products are sold across competitor sites and marketplaces, matches them at the variant level, and refreshes pricing on the cadence you set — a live view of where you sit on price.</p>
      </div>
      <div data-reveal class="fr-sol">
        {sol.map((s) => (
          <div class="fr-sol-step">
            <span class="fr-sol-n">{s.n}</span>
            <div class="fr-sol-card">
              <span class="fr-sol-t">{s.t}</span>
              <div class="fr-sol-chips">{s.chips.map(([k, v]) => (<span class="fr-sol-chip">{k}<span style="color:var(--pl-accent-ink)">{v}</span></span>))}</div>
            </div>
          </div>
        ))}
      </div>
      <div data-reveal class="fr-sol-note"><span class="fr-sol-note-ico">⇢</span><span>Already use PriceLeap's Pricing Decision Engine or Margin Protection Engine? The competitive data flows straight in.</span></div>
    </div>
  </section>

  <!-- Why -->
  <section id="why" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal style="max-width:820px">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Why teams pick us</span>
        <h2 class="mk-h2"><span style="font-weight:700">Built for enterprise catalogs,</span><span style="font-weight:400"> not corner shops.</span></h2>
      </div>
      <div data-reveal class="fr-bento">
        <div class="fr-bento-wide">
          <div class="fr-bento-wide-l"><span class="fr-bento-n">01</span><h3>Matching you can actually audit.</h3><p>Exact, variant, and private-label matches, each with a confidence score, not a black-box guess.</p></div>
          <div class="fr-bento-wide-r">{audit.map((a) => (<div class="fr-audit"><span style="min-width:0"><span class="fr-audit-n">{a.n}</span><span class="fr-audit-k">{a.k}</span></span><span class="fr-audit-v" style={`background:${a.bg};border-color:${a.bc};color:${a.c}`}>{a.v}</span></div>))}</div>
        </div>
        <div class="fr-bento-card"><span class="fr-bento-n">02</span><span class="fr-bento-big">1M+</span><h3>Built for catalog scale.</h3><p>Millions of SKUs across regions and marketplaces, without the refresh slowing down.</p></div>
        <div class="fr-bento-card"><span class="fr-bento-n">03</span><div class="fr-int"><span class="fr-int-pl">PL</span><span class="fr-int-dash"></span><span class="fr-int-chip">BI</span><span class="fr-int-chip">ERP/PIM</span><span class="fr-int-chip">API</span></div><h3>Lands where your team already works.</h3><p>Pushes into your BI, ERP/PIM, or systems by API. Not one more dashboard.</p></div>
        <div class="fr-bento-card"><span class="fr-bento-n">04</span><div class="fr-sa"><span class="fr-sa-ava"></span><span style="min-width:0"><span class="fr-sa-n">Your solutions architect</span><span class="fr-sa-s">ONLINE · REPLIES IN MINUTES</span></span></div><h3>A real person during onboarding.</h3><p>A named solutions architect, not a ticket queue.</p></div>
      </div>
    </div>
  </section>

  <!-- Before / After (static "with PriceLeap" state) -->
  <section id="compare" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Before and after</span>
        <h2 class="mk-h2"><span style="font-weight:400">What changes when your team </span><span style="font-weight:700">switches to PriceLeap.</span></h2>
      </div>
      <div data-reveal class="fr-ba">
        <div class="fr-ba-left">
          <span class="fr-ba-tag">WITH PRICELEAP</span>
          <h3 class="fr-ba-title">One live view, matched and refreshed for you.</h3>
          <div class="fr-ba-meter"><span class="fr-ba-cov">98%</span><span class="fr-ba-cov-l">of catalog<br>monitored</span></div>
          <div class="fr-ba-track"><span style="width:98%"></span></div>
        </div>
        <div class="fr-ba-list">
          {baList.map((r) => (<div class="fr-ba-row"><span class="fr-ba-check">{r.mk}</span><span>{r.t}</span></div>))}
        </div>
      </div>
    </div>
  </section>

  <!-- Core features -->
  <section id="features" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Core features</span>
        <h2 class="mk-h2"><span style="font-weight:400">Everything from </span><span style="font-weight:700">match to action, in one layer.</span></h2>
      </div>
      <div data-reveal class="fr-feat">
        {features.map((f) => (<div class="fr-feat-card"><span class="fr-feat-n">{f.n}</span><h3>{f.t}</h3><p>{f.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section id="proof" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="fr-proof">
        <span class="fr-proof-chip">[ CUSTOMER RESULT ]</span>
        <p class="fr-proof-q">[Client name] cut competitor-price research from [X hours/week] to near zero.</p>
        <span class="fr-proof-note">— confirm quote &amp; stat before publish</span>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="mk-sec">
    <div class="mk-wrap fr-price">
      <span class="mk-eyebrow"><span class="mk-sq"></span>Pricing</span>
      <h2 class="mk-h2" style="font-size:clamp(34px,4.6vw,56px)"><span style="font-weight:400">Enterprise-grade </span><span style="font-weight:700">by default.</span></h2>
      <p class="fr-price-p">Pricing scales with your catalog, your competitor set, and how often you need data.</p>
      <div class="mk-hero-cta"><a href="/contact" class="mk-btn-primary">Book a demo</a><a href="/contact" class="mk-btn-ghost">Contact sales for a custom quote</a></div>
    </div>
  </section>

  <Faq items={faqs} title="Frequently asked " titleBold="questions." />

  <!-- CTA -->
  <section id="demo" class="mk-cta-sec">
    <div class="mk-cta">
      <div aria-hidden="true" class="mk-cta-glow"></div>
      <div data-reveal class="mk-cta-inner">
        <h2 class="mk-cta-h2"><span style="font-weight:400">See your real price position in a </span><span style="font-weight:700">20-minute demo.</span></h2>
        <a href="/contact" class="mk-btn-primary mk-btn-lg">Book a demo</a>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .fr-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
  .fr-hero-dots { position: absolute; inset: 0; background-image: radial-gradient(var(--pl-line-alt) 1px,transparent 1px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 20%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 60% 70% at 50% 20%,#000 10%,transparent 70%); pointer-events: none; }
  .fr-hero-glow { position: absolute; left: 50%; bottom: -260px; width: 1100px; height: 560px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(247,99,30,.16),transparent); pointer-events: none; }
  .fr-hero-inner { position: relative; max-width: 1280px; margin: 0 auto; padding: clamp(48px,7vw,96px) clamp(20px,4vw,40px) 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fr-crumbs { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--pl-muted); }
  .fr-crumbs a { color: var(--pl-muted); }
  .fr-crumbs span:nth-child(even) { color: var(--pl-line-xstrong); }
  .fr-crumb-cur { color: var(--pl-ink) !important; }
  .fr-badge { margin-top: 24px; height: 32px; padding: 0 6px 0 14px; display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-accent-ink); box-shadow: 0 8px 20px -14px rgba(60,30,15,.3); }
  .fr-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pl-gradient); animation: plpulse 1.8s infinite; }
  .fr-badge-tag { height: 22px; padding: 0 8px; display: flex; align-items: center; border-radius: 999px; background: var(--pl-ink); color: var(--pl-surface); font-size: 10px; letter-spacing: .06em; }
  .fr-h1 { margin: 22px 0 0; font-family: Geist, sans-serif; font-size: clamp(38px,5.6vw,72px); line-height: 1.02; letter-spacing: -.045em; color: var(--pl-ink); max-width: 1040px; text-wrap: balance; }
  .fr-lead { margin: 22px 0 0; max-width: 720px; font-size: 18px; line-height: 1.6; color: var(--pl-ink-2); text-wrap: pretty; }
  .fr-lead--muted { margin-top: 10px; font-size: 15px; color: var(--pl-muted); }
  .fr-stats { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; border: 1px solid var(--pl-line); border-radius: 12px; background: var(--pl-surface); overflow: hidden; }
  .fr-stat { height: 38px; padding: 0 16px; display: flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--pl-ink); border-right: 1px solid var(--pl-line-soft); }
  .fr-stat:last-child { border-right: none; }
  .fr-stat-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--pl-gradient); }
  .fr-dash { position: relative; margin-top: 56px; width: 100%; max-width: 1080px; background: var(--pl-surface); border: 1px solid var(--pl-line); border-bottom: none; border-radius: 20px 20px 0 0; box-shadow: 0 -10px 60px -30px rgba(60,30,15,.25); overflow: hidden; text-align: left; }
  .fr-dash-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--pl-line-soft); background: var(--pl-cream); }
  .fr-dots3 { display: flex; gap: 5px; }
  .fr-dots3 span { width: 9px; height: 9px; border-radius: 50%; background: var(--pl-line); }
  .fr-url { flex: 1; max-width: 340px; margin: 0 auto; height: 26px; border-radius: 8px; background: var(--pl-surface); border: 1px solid var(--pl-line); display: flex; align-items: center; justify-content: center; font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-muted); }
  .fr-dash-live { display: flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 999px; background: var(--pl-accent-tint); border: 1px solid var(--pl-accent-line); font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-accent-ink); }
  .fr-dash-body { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--pl-line-soft); }
  .fr-dash-main { background: var(--pl-surface); display: grid; grid-template-rows: auto 1fr; }
  .fr-kpis { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1px; background: var(--pl-line-soft); border-bottom: 1px solid var(--pl-line-soft); }
  .fr-kpi { background: var(--pl-surface); padding: 16px 18px; }
  .fr-kpi-k { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-faint); }
  .fr-kpi-v { margin-top: 4px; font-family: Geist, sans-serif; font-size: 30px; font-weight: 600; letter-spacing: -.04em; color: var(--pl-ink); display: flex; align-items: center; gap: 8px; }
  .fr-kpi-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--pl-danger); }
  .fr-chart-wrap { padding: 18px; }
  .fr-chart-head { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; font-weight: 600; color: var(--pl-ink); }
  .fr-chart-sub { font-family: 'Geist Mono', monospace; font-size: 10.5px; color: var(--pl-faint); font-weight: 400; }
  .fr-chart { margin-top: 16px; display: flex; align-items: flex-end; gap: clamp(8px,2vw,18px); height: 150px; border-bottom: 1px solid var(--pl-line-soft); position: relative; }
  .fr-chart-line { position: absolute; left: 0; right: 0; bottom: 60%; border-top: 1px dashed var(--pl-line-xstrong); }

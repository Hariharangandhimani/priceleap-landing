            <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:var(--pl-muted)">YOUR SETUP</span><span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-faint)">drag to scope</span></div>
            <label style="display:flex;flex-direction:column;gap:10px">
              <span style="display:flex;justify-content:space-between;font-size:14px;color:var(--pl-ink)"><span>Catalog size</span><span data-fr-scsku style="font-family:'Geist Mono',monospace;color:var(--pl-accent-ink)">1M SKUs</span></span>
              <input type="range" min="0" max="5" step="1" value="4" data-fr-skurange aria-label="Catalog size" style="width:100%" />
            </label>
            <label style="display:flex;flex-direction:column;gap:10px">
              <span style="display:flex;justify-content:space-between;font-size:14px;color:var(--pl-ink)"><span>Competitor set</span><span data-fr-sccomp style="font-family:'Geist Mono',monospace;color:var(--pl-accent-ink)">12 competitors</span></span>
              <input type="range" min="1" max="30" step="1" value="12" data-fr-comp aria-label="Competitor set" style="width:100%" />
            </label>
            <div style="display:flex;flex-direction:column;gap:10px">
              <span style="font-size:14px;color:var(--pl-ink)">Refresh frequency</span>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:4px;border:1px solid var(--pl-line);border-radius:12px;background:var(--pl-surface)">
                {['Daily', '4× daily', 'Hourly'].map((t, i) => (<button type="button" data-fr-freq={i} style={`height:36px;border:none;border-radius:9px;cursor:pointer;font-size:13px;font-weight:500;background:${i === 0 ? 'var(--pl-accent)' : 'transparent'};color:var(--pl-ink);transition:background .25s`}>{t}</button>))}
              </div>
            </div>
            <div style="margin-top:auto;background:var(--pl-surface);border:1px solid var(--pl-accent-line);border-radius:14px;padding:16px 18px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap">
              <div><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)">PRICE POINTS / DAY</div><div data-fr-scpoints style="margin-top:4px;font-family:Geist,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.03em;color:var(--pl-ink)">12.0M</div></div>
              <span style="font-size:13px;color:var(--pl-muted);max-width:220px">Scoped to your setup. We'll quote on this.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div class="fr-split" style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);gap:clamp(32px,5vw,72px);align-items:start">
        <div data-reveal class="fr-sticky" style="top:96px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>FAQ</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">Frequently asked </span><span style="font-weight:700">questions</span></h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          {faqData.map((q) => (
            <div class="fr-faq" class:list={[{ 'is-open': q.open }]} data-fr-faq style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:16px;overflow:hidden;transition:border-color .25s,box-shadow .25s">
              <button type="button" data-fr-faqbtn aria-expanded={q.open ? 'true' : 'false'} style="width:100%;border:none;background:transparent;cursor:pointer;display:flex;align-items:center;gap:16px;padding:20px 22px;text-align:left">
                <span class="fr-faq-n" style="font-family:'Geist Mono',monospace;font-size:11px">{q.n}</span>
                <span style="flex:1;font-family:Geist,sans-serif;font-size:17px;font-weight:500;color:var(--pl-ink)">{q.q}</span>
                <span class="fr-faq-ic" style="flex:none;width:30px;height:30px;border-radius:9px;color:var(--pl-ink);display:flex;align-items:center;justify-content:center"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg></span>
              </button>
              <div class="fr-faq-panel"><div style="overflow:hidden"><p style="margin:0;padding:0 22px 22px 58px;font-size:15px;line-height:1.65;color:var(--pl-ink-2)">{q.a}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="demo" style="padding:clamp(20px,3vw,28px)">
      <div style="position:relative;max-width:1280px;margin:0 auto;overflow:hidden;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:28px;padding:clamp(72px,10vw,120px) clamp(20px,4vw,40px);text-align:center">
        <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(var(--pl-line-alt) 1px,transparent 1px);background-size:20px 20px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 20%,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 20%,transparent 75%)"></div>
        <div aria-hidden="true" style="position:absolute;left:50%;top:50%;width:440px;height:440px;margin:-220px 0 0 -220px;border-radius:50%;border:1px dashed var(--pl-accent-line);animation:pi-orbit 40s linear infinite"><span style="position:absolute;left:50%;top:-6px;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:var(--pl-gradient);box-shadow:0 0 0 6px rgba(247,99,30,.18)"></span></div>
        <div aria-hidden="true" style="position:absolute;left:50%;top:50%;width:640px;height:640px;margin:-320px 0 0 -320px;border-radius:50%;border:1px solid var(--pl-line-soft)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;align-items:center;gap:26px">
          <span style="height:30px;padding:0 12px;display:flex;align-items:center;gap:8px;border-radius:999px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.08em;color:var(--pl-ink)">◷ 20 MIN</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(32px,4.8vw,60px);line-height:1.04;letter-spacing:-.045em;color:var(--pl-ink);max-width:820px;text-wrap:balance"><span style="font-weight:400">See your real price position </span><span style="font-weight:700">in a 20-minute demo.</span></h2>
          <a href="/book-a-demo" style="height:52px;padding:0 26px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:16px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Book a demo</a>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .fr { background: var(--pl-surface); overflow-x: clip; }
  @keyframes pi-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.55); } 100% { box-shadow: 0 0 0 10px rgba(247,99,30,0); } }
  @keyframes pi-marquee { to { transform: translateX(-50%); } }
  @keyframes pi-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes pi-spin { to { transform: rotate(360deg); } }
  @keyframes pi-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes pi-blink { 50% { opacity: .25; } }
  @keyframes pi-grow { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes pi-growy { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes pi-dashx { to { background-position: 20px 0; } }
  @keyframes pi-cell { 0%,100% { background: var(--pl-surface); } 50% { background: var(--pl-danger-tint); } }
  @keyframes pi-crack { 0%,55% { opacity: 0; } 65%,100% { opacity: 1; } }
  @keyframes pi-orbit { to { transform: rotate(360deg); } }

  .fr-dash { grid-template-columns: 1fr; }
  .fr-alerts { display: none; }
  @media (min-width: 1000px) { .fr-dash { grid-template-columns: minmax(0,1fr) 300px; } .fr-alerts { display: flex; } }
  .fr-logos { grid-template-columns: 1fr; }
  .fr-logolabel { border-bottom: 1px solid var(--pl-line); }
  @media (min-width: 760px) { .fr-logos { grid-template-columns: 260px minmax(0,1fr); } .fr-logolabel { border-right: 1px solid var(--pl-line); border-bottom: none; } }
  .fr-sol { grid-template-columns: 1fr; }
  .fr-solline { display: none; }
  @media (min-width: 760px) { .fr-sol { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1000px) { .fr-sol { grid-template-columns: repeat(4,minmax(0,1fr)); } .fr-solline { display: block; } }
  .fr-bento { grid-template-columns: 1fr; }
  .fr-bento-hero { grid-column: auto; }
  @media (min-width: 1000px) { .fr-bento { grid-template-columns: repeat(3,minmax(0,1fr)); } .fr-bento-hero { grid-column: span 3; } }
  .fr-split { grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .fr-split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }
  .fr-sticky { position: relative; }
  @media (min-width: 1000px) { .fr-sticky { position: sticky; } }
  .fr-feat { grid-template-columns: 1fr; }
  .fr-featorder { order: 0; }
  .fr-featline { display: none; }
  @media (min-width: 1000px) { .fr-feat { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } .fr-featorder { order: 2; } .fr-featline { display: block; } }
  .fr-badiv { border-right: none; }
  @media (min-width: 1000px) { .fr-badiv { border-right: 1px solid var(--pl-accent-line); } }
  .fr-proof { grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .fr-proof { grid-template-columns: minmax(0,1.5fr) minmax(0,1fr); } }

  .fr-faq-n { color: var(--pl-faint); }
  .fr-faq.is-open .fr-faq-n { color: var(--pl-accent-ink); }
  .fr-faq-ic { background: var(--pl-sand); transform: rotate(0deg); transition: transform .3s, background .3s; }
  .fr-faq.is-open .fr-faq-ic { background: var(--pl-accent); transform: rotate(45deg); }
  .fr-faq.is-open { border-color: var(--pl-accent-line); box-shadow: 0 18px 36px -28px rgba(194,65,12,.5); }
  .fr-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .fr-faq.is-open .fr-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .fr *, .fr *::before, .fr *::after { animation: none !important; transition: none !important; } [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.fr') as HTMLElement | null;
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---------- hero slow tick (2600ms) ----------
    const cats: [string, number][] = [['Grocery', -2.3], ['Electronics', 4.1], ['Home', -1.0], ['Beauty', 1.8], ['Toys', -3.2], ['Apparel', 0.6], ['Garden', -1.6]];
    const alertData = [
      { t: 'Competitor A cut 34 SKUs · Grocery', d: '−3.8%', c: 'var(--pl-danger-ink)', m: 'REGION NORTH · 2M AGO' },
      { t: 'Marketplace B above you · Electronics', d: '+5.2%', c: 'var(--pl-accent-ink)', m: 'MARKETPLACE · 6M AGO' },
      { t: 'Banner C promo started · Toys', d: '−12%', c: 'var(--pl-danger-ink)', m: 'BANNER C · 11M AGO' },
      { t: 'Out of stock at Competitor D · Home', d: 'OOS', c: 'var(--pl-ink-2)', m: 'ONLINE · 18M AGO' },
      { t: 'Private-label match found · Beauty', d: '91%', c: 'var(--pl-accent-ink)', m: 'MATCHING · 24M AGO' },
    ];
    const idxEl = q('[data-fr-idx]'), alertsEl = q('[data-fr-alerts]'), matchDone = q('[data-fr-matchdone]');
    const catBars = qa('[data-fr-catbar]'), catDs = qa('[data-fr-catd]');
    const alertFeed = q('[data-fr-alertfeed]'), sinks = qa('[data-fr-sink]');
    let tk = 0;
    function slowTick() {
      idxEl && (idxEl.textContent = (98.4 + [0, -0.2, 0.1, -0.1][tk % 4]).toFixed(1));
      alertsEl && (alertsEl.textContent = String(12 + (tk % 3 === 2 ? 1 : 0)));
      matchDone && (matchDone.textContent = String(2 + (tk % 2)));
      cats.forEach(([, d], i) => {
        const jitter = i === (tk % 7) ? (d < 0 ? -0.6 : 0.6) : 0, v = d + jitter;
        const bar = catBars[i], lab = catDs[i];
        if (bar) { bar.style.height = Math.max(18, Math.min(96, 60 + v * 8)) + '%'; bar.style.background = v < 0 ? 'var(--pl-accent)' : v > 3 ? 'var(--pl-danger)' : '#D5DAD5'; }
        if (lab) { lab.textContent = (v > 0 ? '+' : '−') + Math.abs(v).toFixed(1) + '%'; lab.style.color = v < 0 ? 'var(--pl-accent-ink)' : v > 3 ? 'var(--pl-danger-ink)' : 'var(--pl-muted)'; }
      });
      if (alertFeed) alertFeed.innerHTML = [0, 1, 2, 3].map((i) => { const a = alertData[(tk + i) % alertData.length]; return `<div style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:12px;padding:10px 12px;display:flex;flex-direction:column;gap:4px;animation:pi-in .45s ease"><span style="display:flex;justify-content:space-between;gap:8px"><span style="font-size:12px;font-weight:600;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${a.t}</span><span style="font-family:'Geist Mono',monospace;font-size:11px;color:${a.c}">${a.d}</span></span><span style="font-family:'Geist Mono',monospace;font-size:9.5px;color:var(--pl-faint)">${a.m}</span></div>`; }).join('');
      const sk = tk % 4;
      sinks.forEach((el, i) => { el.style.background = i === sk ? 'var(--pl-accent-tint)' : 'var(--pl-surface)'; const dot = el.querySelector('[data-fr-sinkdot]') as HTMLElement | null; if (dot) dot.style.background = i === sk ? 'var(--pl-accent)' : 'var(--pl-line-xstrong)'; });
    }
    setInterval(() => { tk++; slowTick(); }, 2600);

    // ---------- solution tabs (auto-advance + click) ----------
    const solBtns = qa('[data-fr-sol]'), solFill = q('[data-fr-solfill]');
    let sol = 0, solP = 0;
    function paintSol() {
      solBtns.forEach((b, i) => {
        const on = i === sol, done = i < sol;
        const node = b.querySelector('[data-fr-solnode]') as HTMLElement | null;
        const card = b.querySelector('[data-fr-solcard]') as HTMLElement | null;
        if (node) { node.style.background = on || done ? 'var(--pl-accent)' : 'var(--pl-surface)'; node.style.borderColor = on || done ? 'var(--pl-accent)' : 'var(--pl-line)'; node.style.boxShadow = on ? '0 0 0 8px rgba(247,99,30,.16),0 16px 30px -14px rgba(247,99,30,.8)' : '0 10px 20px -16px rgba(60,30,15,.4)'; }
        if (card) { card.style.borderColor = on ? 'var(--pl-accent-line)' : 'var(--pl-line)'; card.style.boxShadow = on ? '0 24px 44px -28px rgba(194,65,12,.5)' : 'none'; }
      });
      if (solFill) solFill.style.width = Math.min(75, (sol + solP) / 3 * 75) + '%';
    }
    setInterval(() => { solP += 0.05; if (solP >= 1) { sol = (sol + 1) % 4; solP = 0; } paintSol(); }, 200);
    solBtns.forEach((b, i) => b.addEventListener('click', () => { sol = i; solP = 0; paintSol(); }));

    // ---------- before/after toggle ----------
    const bList = ['Category managers rebuild competitor price sheets by hand every week.', "Coverage stops at a sample of SKUs because matching doesn't scale.", 'Mismatched variants make teams second-guess the numbers.', 'Regional, marketplace, and banner prices live in separate files.'];
    const aList = ['Competitor prices arrive automatically on the cadence you set.', 'Your full catalog is monitored, into the millions of SKUs.', 'Products are matched down to the variant, so teams trust what they see.', 'Every region, marketplace, and banner sits in one view.'];
    const baPanel = q('[data-fr-bapanel]'), baGrid = q('[data-fr-bagrid]'), baLeft = q('[data-fr-baleft]'), baList = q('[data-fr-balist]');
    const baKnob = q('[data-fr-baknob]'), baC0 = q('[data-fr-bac0]'), baTag = q('[data-fr-batag]'), baTitle = q('[data-fr-batitle]'), baCov = q('[data-fr-bacov]'), baMeter = q('[data-fr-bameter]');
    let ba = 1;
    function paintBA() {
      const before = ba === 0;
      if (baKnob) { baKnob.style.left = before ? '4px' : '50%'; baKnob.style.background = before ? 'var(--pl-sand)' : 'var(--pl-accent)'; }
      if (baC0) baC0.style.color = before ? 'var(--pl-ink)' : 'var(--pl-muted)';
      if (baPanel) { baPanel.style.border = before ? '1px solid var(--pl-line)' : '1.5px solid var(--pl-accent)'; baPanel.style.boxShadow = before ? 'none' : '0 0 0 6px rgba(247,99,30,.08),0 30px 60px -40px rgba(194,65,12,.5)'; }
      if (baLeft) baLeft.style.background = before ? 'var(--pl-cream)' : 'var(--pl-accent-tint)';
      if (baTag) { baTag.textContent = before ? 'BEFORE PRICELEAP' : 'WITH PRICELEAP'; baTag.style.background = before ? 'var(--pl-surface)' : 'var(--pl-accent)'; baTag.style.borderColor = before ? 'var(--pl-line)' : 'var(--pl-accent)'; baTag.style.color = before ? 'var(--pl-muted)' : 'var(--pl-ink)'; }
      if (baTitle) baTitle.textContent = before ? 'Manual, partial, and always behind.' : 'Accurate, complete, and refreshed daily.';
      if (baCov) { baCov.textContent = before ? '~8%' : '100%'; baCov.style.color = before ? 'var(--pl-danger-ink)' : 'var(--pl-accent-ink)'; }
      if (baMeter) { baMeter.style.width = before ? '8%' : '100%'; baMeter.style.background = before ? 'var(--pl-danger-ink)' : 'var(--pl-accent-ink)'; }
      const items = before ? bList : aList;
      if (baList) baList.innerHTML = items.map((t, i) => `<div style="display:flex;gap:14px;align-items:flex-start;padding:22px clamp(20px,3vw,32px);border-bottom:1px solid var(--pl-line-soft);animation:pi-in .45s ease ${(0.08 * i + 0.1).toFixed(2)}s both"><span style="flex:none;margin-top:2px;width:22px;height:22px;border-radius:50%;background:${before ? 'var(--pl-danger-tint)' : 'var(--pl-accent)'};border:1px solid ${before ? 'var(--pl-danger-line)' : 'var(--pl-accent)'};color:${before ? 'var(--pl-danger-ink)' : 'var(--pl-ink)'};font-size:11px;display:flex;align-items:center;justify-content:center">${before ? '✕' : '✓'}</span><span style="font-size:16px;line-height:1.55;color:${before ? 'var(--pl-muted)' : 'var(--pl-ink)'}">${t}</span></div>`).join('');
      if (baGrid) { baGrid.style.animation = 'none'; void baGrid.offsetWidth; baGrid.style.animation = 'pi-in .45s ease'; }
    }
    q('[data-fr-batoggle]')?.addEventListener('click', () => { ba = ba ? 0 : 1; paintBA(); });

    // ---------- sku counter on reveal ----------
    const skuEl = q('[data-fr-sku]');
    let counted = false;
    function countSku() {
      if (counted || !skuEl) return; counted = true;
      const t0 = performance.now(), D = 1800;
      const step = (n: number) => { const k = Math.min(1, (n - t0) / D), p = 1 - Math.pow(1 - k, 3); skuEl.textContent = p >= 1 ? '1M+' : Math.round(1000000 * p).toLocaleString('en-US'); if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    }

    // ---------- pricing calculator ----------
    const skuLabels = ['1K', '10K', '100K', '500K', '1M', '5M+'];
    const skuSteps = [1000, 10000, 100000, 500000, 1000000, 5000000];
    const rngSku = root.querySelector('input[data-fr-skurange]') as HTMLInputElement | null;
    const rngComp = root.querySelector('input[data-fr-comp]') as HTMLInputElement | null;
    const scSku = q('[data-fr-scsku]'), scComp = q('[data-fr-sccomp]'), scPoints = q('[data-fr-scpoints]');
    const freqBtns = qa('[data-fr-freq]');
    let freq = 0;
    const fmt = (n: number) => n >= 1e9 ? (n / 1e9).toFixed(1) + 'B' : n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? Math.round(n / 1e3) + 'K' : String(n);
    function paintPrice() {
      const skuI = rngSku ? +rngSku.value : 4, compI = rngComp ? +rngComp.value : 12, freqN = [1, 4, 24][freq];
      if (scSku) scSku.textContent = skuLabels[skuI] + ' SKUs';
      if (scComp) scComp.textContent = compI + ' competitors';
      if (scPoints) scPoints.textContent = fmt(skuSteps[skuI] * compI * freqN);
      freqBtns.forEach((b, i) => (b.style.background = i === freq ? 'var(--pl-accent)' : 'transparent'));
    }
    rngSku?.addEventListener('input', paintPrice);
    rngComp?.addEventListener('input', paintPrice);
    freqBtns.forEach((b, i) => b.addEventListener('click', () => { freq = i; paintPrice(); }));

    // ---------- faq ----------
    qa('[data-fr-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-fr-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-fr-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-fr-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---------- reveal ----------
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; e.target.classList.add('is-in'); io.unobserve(e.target); if ((e.target as HTMLElement).hasAttribute('data-fr-count')) countSku(); }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); countSku(); }
  }
</script>

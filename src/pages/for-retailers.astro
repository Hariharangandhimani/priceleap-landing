---
/**
 * Retail Price Intelligence (/for-retailers) — native rebuild on the shared
 * light design system. Content ported 1:1 from for-retailers.html.
 * [X] / [Client name] placeholders kept verbatim.
 */
import LightBaseLayout from '@/layouts/LightBaseLayout.astro';
import LHeader from '@/components/light/LHeader.astro';
import LFooter from '@/components/light/LFooter.astro';
import SectionHeader from '@/components/ds/nav/SectionHeader.astro';
import Tabs from '@/components/ds/nav/Tabs.astro';
import FAQ from '@/components/ds/faq/FAQ.astro';
import CTA from '@/components/ds/cta/CTA.astro';

const logos = ['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank'];

const catBars = [
  { n: 'Grocery', d: '−2.3%', neg: true }, { n: 'Electronics', d: '+4.1%', neg: false },
  { n: 'Home', d: '−1.0%', neg: true }, { n: 'Beauty', d: '+1.8%', neg: false },
  { n: 'Toys', d: '−3.2%', neg: true }, { n: 'Apparel', d: '+0.6%', neg: false },
  { n: 'Garden', d: '−1.6%', neg: true },
];
const alertFeed = [
  { t: 'Competitor A cut 34 SKUs · Grocery', d: '−3.8%', down: true, m: 'REGION NORTH · 2M AGO' },
  { t: 'Marketplace B above you · Electronics', d: '+5.2%', down: false, m: 'MARKETPLACE · 6M AGO' },
  { t: 'Banner C promo started · Toys', d: '−12%', down: true, m: 'BANNER C · 11M AGO' },
  { t: 'Out of stock at Competitor D · Home', d: 'OOS', down: null, m: 'ONLINE · 18M AGO' },
];

const problems = [
  { n: '01', t: 'Your category managers still rebuild competitor price sheets by hand. By the time a sheet is ready, half the prices have already moved.', tag: 'MANUAL' },
  { n: '02', t: 'Most repricing tools quietly fall over past a few thousand SKUs. Your catalog runs into the millions.', tag: 'SCALE' },
  { n: '03', t: 'Matching your products to competitor listings is manual, so coverage is patchy and nobody fully trusts the numbers.', tag: 'COVERAGE' },
  { n: '04', t: "Prices shift by region, marketplace, and banner, and there's no single place to see all of it at once.", tag: 'FRAGMENTED' },
];

const sol = [
  { n: '01', t: 'Discover & match', d: 'It locates where your products are sold across competitor sites and marketplaces and matches them at the variant level.', chips: [['Sites found', '214'], ['Variant-level', '✓'], ['Private label', '✓']] },
  { n: '02', t: 'Monitor competitor prices', d: 'Watches the prices that move your category, as often as you need them, with full price history.', chips: [['Cadence', 'Daily'], ['Regions', 'All'], ['History', 'Full']] },
  { n: '03', t: 'See your price position', d: 'Shows where you stand against each competitor, by SKU, category, and region.', chips: [['By SKU', '✓'], ['By category', '✓'], ['By region', '✓']] },
  { n: '04', t: 'Optimize and act', d: 'Surfaces the SKUs where a price change wins margin or share, and feeds clean inputs to your tools.', chips: [['Alerts', 'On'], ['API / BI', '✓'], ['Optimization', 'Feeds']] },
];

const audit = [
  { n: 'Store brand Oat Milk 1L', k: 'PRIVATE LABEL', v: '0.87', bg: '#FFF8EB', bc: '#F4DDAE', c: '#8A5A00' },
  { n: 'Sonix ANC 700 · Black', k: 'EXACT · EAN', v: '0.99', bg: '#E8FCEF', bc: '#BFF3D2', c: '#0B7A34' },
  { n: 'Detergent Pods 42ct → 60ct', k: 'VARIANT · PACK SIZE', v: '0.93', bg: '#E8FCEF', bc: '#BFF3D2', c: '#0B7A34' },
];

const bList = ['Category managers rebuild competitor price sheets by hand every week.', "Coverage stops at a sample of SKUs because matching doesn't scale.", 'Mismatched variants make teams second-guess the numbers.', 'Regional, marketplace, and banner prices live in separate files.'];
const aList = ['Competitor prices arrive automatically on the cadence you set.', 'Your full catalog is monitored, into the millions of SKUs.', 'Products are matched down to the variant, so teams trust what they see.', 'Every region, marketplace, and banner sits in one view.'];

const features = [
  { t: 'Competitor price monitoring', d: 'Watches the prices that move your category, as often as you need them.', points: ['Coverage across competitor sites, marketplaces, and channels', "Full price history, so you see patterns, not just today's number.", 'Alerts when a competitor crosses a threshold you care about'] },
  { t: 'Matching you can actually audit', d: 'Matches your catalog to competitor listings automatically, then keeps it accurate as listings change.', points: ['Exact, variant, and private-label matches, each with a confidence score, not a black-box guess.', 'Handles exact matches, variants, and private-label / similar products', 'Low-confidence matches route to a human QA reviewer.'] },
  { t: 'Price position, ready to act on', d: 'Shows where you stand against each competitor, by SKU, category, and region — and turns it into pricing moves.', points: ['Surfaces the SKUs where a price change wins margin or share.', 'Clean inputs for your retail price optimization software.', 'Already use the Decision or Margin Protection Engine? Data flows straight in.'] },
  { t: 'Data delivery & integrations', d: 'Gets competitive data into your stack with no copy-paste. Lands where your team already works.', points: ['API, BI connectors, and scheduled feeds', 'Pipes cleanly into your pricing, ERP, PIM, and reporting tools.', 'Pushes into your BI, ERP/PIM, or systems by API. Not one more dashboard.'] },
];
const matchBars = [
  { n: 'Exact matches', v: 98, label: '98% exact', bar: '#18E563', tc: '#0B7A34' },
  { n: 'Variant matches', v: 91, label: '91% variant', bar: '#18E563', tc: '#0B7A34' },
  { n: 'Private-label / similar', v: 74, label: '74% review', bar: '#F0B44C', tc: '#8A5A00' },
];

const proof = [
  '[X]% data-accuracy commitment and [X]% uptime SLA',
  'SOC 2 Type II and ISO 27001 certified',
  'A named solutions architect, not a ticket queue.',
  'Clear data governance and access controls.',
];

const scopeInputs = [
  { k: 'Catalog size', v: '1K – 5M+ SKUs' },
  { k: 'Competitor set', v: 'Up to 50+ competitors' },
  { k: 'Refresh cadence', v: 'Daily · 4× daily · hourly' },
];

const faqs = [
  { q: 'How accurate is your product matching?', a: '[X]% on exact and variant matches, with confidence scores and human review on the rest.' },
  { q: 'How often does the data refresh?', a: 'As often as daily or intraday, set per category or competitor.' },
  { q: 'How many SKUs and competitors can you handle?', a: 'Millions of SKUs across many competitors and marketplaces, without performance trade-offs.' },
  { q: 'Is this a tracker or a retail price optimization software?', a: "It's the intelligence layer underneath optimization — accurate competitor data and price-position signals for your team or your optimization tools to act on." },
  { q: 'Will it fit our existing pricing and ERP systems?', a: 'Yes — data flows in by API, BI connectors, or feeds into your ERP/PIM.' },
  { q: 'How long does onboarding take?', a: 'Typically a few weeks, with a named solutions architect through go-live.' },
  { q: 'Is our data secure?', a: 'SOC 2 / ISO 27001 certified with full access controls.' },
];
---

<LightBaseLayout
  title="Retail Price Intelligence · PriceLeap"
  description="Competitor prices for your entire catalog, matched accurately and refreshed every day."
>
  <LHeader />

  <!-- ══ HERO ══ -->
  <section class="fr-hero">
    <div class="fr-hero__grid" aria-hidden="true"></div>
    <div class="fr-hero__glow" aria-hidden="true"></div>
    <div class="fr-wrap fr-hero__inner">
      <div class="fr-hero__copy">
        <nav class="fr-crumb"><a href="/light">Solutions</a><span>/</span><span>For Retailers</span></nav>
        <span class="fr-eyebrow"><span class="fr-eyebrow__dot"></span>Retail Price Intelligence</span>
        <h1 class="fr-h1"><span class="w4">Competitor prices for your entire catalog, </span><b>matched accurately and refreshed every day.</b></h1>
        <p class="fr-lead">Retail Price Intelligence finds your products across competitor sites and marketplaces, matches them down to the variant, and shows your category teams exactly where they stand on price.</p>
        <div class="fr-hero__btns">
          <a href="/book-a-demo" class="fr-btn fr-btn--primary">Get a demo</a>
          <a href="#solution" class="fr-btn fr-btn--secondary">See how it works <span>→</span></a>
        </div>
        <div class="fr-hero__ticks">
          {['Matched down to the variant', 'Millions of SKUs, no slowdown', 'Confidence-scored matches'].map(t => (
            <span class="fr-tick"><span class="fr-tick__ic">✓</span>{t}</span>
          ))}
        </div>
      </div>

      <!-- Dashboard card -->
      <div class="fr-hero__card-wrap">
        <div class="fr-card">
          <div class="fr-card__head">
            <span class="fr-dots"><i></i><i></i><i></i></span>
            <span class="fr-card__title">Category price index</span>
            <span class="fr-live"><span class="fr-live__dot"></span>LIVE</span>
          </div>
          <div class="fr-card__kpis">
            <div><span class="fr-k">PRICE INDEX</span><span class="fr-v">98.4</span></div>
            <div><span class="fr-k">OPEN ALERTS</span><span class="fr-v">12</span></div>
            <div><span class="fr-k">COVERAGE</span><span class="fr-v" style="color:#0B7A34">100%</span></div>
          </div>
          <div class="fr-card__bars">
            {catBars.map(c => (
              <div class="fr-bar">
                <span class="fr-bar__col" style={`height:${c.neg ? 70 : 92}px;background:${c.neg ? '#18E563' : '#E5483F'}`}></span>
                <span class="fr-bar__n">{c.n.slice(0,4)}</span>
                <span class="fr-bar__d" style={`color:${c.neg ? '#0B7A34' : '#C9372E'}`}>{c.d}</span>
              </div>
            ))}
          </div>
          <div class="fr-card__feed">
            {alertFeed.map(a => (
              <div class="fr-feed__row">
                <span class="fr-feed__dot" style={`background:${a.down === null ? '#F4F5F4' : a.down ? '#FDECEB' : '#E8FCEF'};color:${a.down === null ? '#5A6373' : a.down ? '#C9372E' : '#0B7A34'}`}>{a.down === null ? '○' : a.down ? '▼' : '▲'}</span>
                <span class="fr-feed__t">{a.t}</span>
                <span class="fr-feed__d" style={`color:${a.down === null ? '#5A6373' : a.down ? '#C9372E' : '#0B7A34'}`}>{a.d}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ LOGOS ══ -->
  <section class="fr-logos">
    <div class="fr-wrap fr-logos__inner">
      <div class="fr-logos__label">Trusted by enterprise retail teams</div>
      <div class="fr-logos__track"><div class="fr-logos__marquee">{[...logos, ...logos].map(l => <span class="fr-logo">{l}</span>)}</div></div>
    </div>
  </section>

  <!-- ══ PROBLEM ══ -->
  <section id="problem" class="fr-sec fr-sec--tint">
    <div class="fr-wrap fr-problem">
      <div class="fr-problem__head" data-reveal>
        <span class="fr-eyebrow fr-eyebrow--red"><span class="fr-eyebrow__sq" style="background:#E5483F"></span>The problem</span>
        <h2 class="fr-h2"><span class="w4">Pricing at your scale </span><b>breaks the tools built for small stores.</b></h2>
      </div>
      <div class="fr-problem__list">
        {problems.map(p => (
          <div class="fr-prob" data-reveal>
            <span class="fr-prob__n">{p.n}</span>
            <span class="fr-prob__t">{p.t}</span>
            <span class="fr-prob__tag">{p.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ SOLUTION ══ -->
  <section id="solution" class="fr-sec">
    <div class="fr-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Solution" title="Retail Price Intelligence does the matching and monitoring" accent="so your team doesn't." lead="It locates where your products are sold across competitor sites and marketplaces, matches them at the variant level, and refreshes pricing on the cadence you set — a live view of where you sit on price, accurate enough to feed straight into your decisions." align="center" />
      </div>
      <div class="fr-sol" data-reveal>
        <Tabs tabs={sol.map(x => `${x.n} ${x.t}`)} id="fr-sol" variant="underline">
          <div slot="panel-0"><div class="fr-step"><p>{sol[0].d}</p><div class="fr-chips">{sol[0].chips.map(([k,v]) => <span class="fr-chip"><b>{k}</b>{v}</span>)}</div></div></div>
          <div slot="panel-1"><div class="fr-step"><p>{sol[1].d}</p><div class="fr-chips">{sol[1].chips.map(([k,v]) => <span class="fr-chip"><b>{k}</b>{v}</span>)}</div></div></div>
          <div slot="panel-2"><div class="fr-step"><p>{sol[2].d}</p><div class="fr-chips">{sol[2].chips.map(([k,v]) => <span class="fr-chip"><b>{k}</b>{v}</span>)}</div></div></div>
          <div slot="panel-3"><div class="fr-step"><p>{sol[3].d}</p><div class="fr-chips">{sol[3].chips.map(([k,v]) => <span class="fr-chip"><b>{k}</b>{v}</span>)}</div></div></div>
        </Tabs>
      </div>
    </div>
  </section>

  <!-- ══ WHY TEAMS PICK US ══ -->
  <section id="why" class="fr-sec fr-sec--tint">
    <div class="fr-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Why teams pick us" title="Built for enterprise catalogs," accent="not corner shops." align="center" />
      </div>
      <div class="fr-why" data-reveal>
        <div class="fr-why__scale">
          <span class="fr-why__num">1M+</span>
          <p>Millions of SKUs across regions and marketplaces, without the refresh slowing down.</p>
        </div>
        <div class="fr-why__audit">
          <div class="fr-why__audit-t">Matching you can actually audit</div>
          {audit.map(a => (
            <div class="fr-audit__row">
              <span class="fr-audit__n">{a.n}</span>
              <span class="fr-audit__k" style={`background:${a.bg};border-color:${a.bc};color:${a.c}`}>{a.k}</span>
              <span class="fr-audit__v" style={`color:${a.c}`}>{a.v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ BEFORE & AFTER ══ -->
  <section id="compare" class="fr-sec">
    <div class="fr-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Before and after" title="What changes when your team switches to" accent="PriceLeap." align="center" />
      </div>
      <div class="fr-ba" data-reveal>
        <div class="fr-ba__col fr-ba__col--before">
          <div class="fr-ba__tag">BEFORE PRICELEAP</div>
          <div class="fr-ba__title">Manual, partial, and always behind.</div>
          <div class="fr-ba__meter"><span class="fr-ba__meter-k">Coverage</span><span class="fr-ba__meter-bar"><i style="width:8%;background:#C9372E"></i></span><span class="fr-ba__meter-v" style="color:#C9372E">~8%</span></div>
          <ul class="fr-ba__list">{bList.map(t => <li><span class="fr-ba__x">✕</span>{t}</li>)}</ul>
        </div>
        <div class="fr-ba__col fr-ba__col--after">
          <div class="fr-ba__tag fr-ba__tag--on">WITH PRICELEAP</div>
          <div class="fr-ba__title">Accurate, complete, and refreshed daily.</div>
          <div class="fr-ba__meter"><span class="fr-ba__meter-k">Coverage</span><span class="fr-ba__meter-bar"><i style="width:100%;background:#18E563"></i></span><span class="fr-ba__meter-v" style="color:#0B7A34">100%</span></div>
          <ul class="fr-ba__list">{aList.map(t => <li><span class="fr-ba__check">✓</span>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CORE FEATURES ══ -->
  <section class="fr-sec fr-sec--tint">
    <div class="fr-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Core features" title="Everything from match to action," accent="in one layer." align="center" />
      </div>
      <div class="fr-feats" data-reveal>
        {features.map((f, i) => (
          <div class="fr-feat">
            <div class="fr-feat__n">0{i + 1}</div>
            <h3 class="fr-feat__t">{f.t}</h3>
            <p class="fr-feat__d">{f.d}</p>
            <ul class="fr-feat__list">{f.points.map(pt => <li><span class="fr-tick__ic">✓</span>{pt}</li>)}</ul>
            {i === 1 && (
              <div class="fr-match">
                {matchBars.map(m => (
                  <div class="fr-match__row">
                    <span class="fr-match__n">{m.n}</span>
                    <span class="fr-match__track"><i style={`width:${m.v}%;background:${m.bar}`}></i></span>
                    <span class="fr-match__v" style={`color:${m.tc}`}>{m.label}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ PROOF ══ -->
  <section id="proof" class="fr-sec">
    <div class="fr-wrap fr-proof">
      <div class="fr-proof__quote" data-reveal>
        <span class="fr-eyebrow"><span class="fr-eyebrow__sq"></span>Proof</span>
        <blockquote>[Client name] cut competitor-price research from [X hours/week] to near zero.</blockquote>
        <p class="fr-proof__sub">[Two or three lines: what they sell, what was breaking, what changed. End on a hard number.]</p>
      </div>
      <div class="fr-proof__points" data-reveal>
        <div class="fr-proof__title">Enterprise-grade by default.</div>
        <ul>{proof.map(p => <li><span class="fr-tick__ic">✓</span>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ══ PRICING ══ -->
  <section id="pricing" class="fr-sec fr-sec--tint">
    <div class="fr-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Pricing" title="Pricing scales with your catalog, your competitor set," accent="and how often you need data." align="center" />
      </div>
      <div class="fr-scope" data-reveal>
        <div class="fr-scope__inputs">
          {scopeInputs.map(s => (
            <div class="fr-scope__in"><span class="fr-scope__k">{s.k}</span><span class="fr-scope__v">{s.v}</span></div>
          ))}
        </div>
        <div class="fr-scope__cta">
          <div class="fr-scope__cta-t">Scoped to your setup. We'll quote on this.</div>
          <p>Tell us your setup and we'll scope it to your business. No tiers to outgrow.</p>
          <a href="/book-a-demo" class="fr-btn fr-btn--primary">Get a custom quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section id="faq" class="fr-sec">
    <div class="fr-wrap fr-faq">
      <div data-reveal>
        <SectionHeader eyebrow="FAQ" title="Frequently asked" accent="questions" align="center" />
      </div>
      <div data-reveal style="margin-top:36px">
        <FAQ items={faqs} variant="list" />
      </div>
    </div>
  </section>

  <!-- ══ CTA ══ -->
  <div class="fr-wrap" style="padding-bottom:96px">
    <CTA
      variant="primary"
      title="See your real price position in a"
      accent="20-minute demo."
      body="We'll show Retail Price Intelligence on your own catalog and competitor set — matched, scored, and refreshed."
      primary={{ label: 'Get a demo', href: '/book-a-demo' }}
      secondary={{ label: 'See pricing', href: '#pricing' }}
    />
  </div>

  <LFooter />
</LightBaseLayout>

<style>
.fr-wrap { max-width: var(--pl-container); margin: 0 auto; padding-left: var(--pl-gutter); padding-right: var(--pl-gutter); }
.fr-sec { padding: clamp(64px,8vw,112px) 0; border-bottom: 1px solid var(--pl-line); }
.fr-sec--tint { background: #FBFBFA; }
.fr-h1 { margin: 24px 0 0; font-family: var(--pl-font); font-size: clamp(36px,5vw,64px); line-height: 1.03; letter-spacing: -.045em; color: #0A0A0A; text-wrap: balance; font-weight: 700; }
.fr-h1 .w4 { font-weight: 400; }
.fr-h2 { margin: 16px 0 0; font-family: var(--pl-font); font-size: clamp(30px,4vw,48px); line-height: 1.06; letter-spacing: -.035em; color: #0A0A0A; text-wrap: balance; font-weight: 700; }
.fr-h2 .w4 { font-weight: 400; }
.fr-lead { margin: 22px 0 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: #3A414C; }
.fr-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--pl-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #0B7A34; }
.fr-eyebrow--red { color: #C9372E; }
.fr-eyebrow__dot { width: 7px; height: 7px; border-radius: 50%; background: #18E563; animation: pl-pulse 1.8s ease-out infinite; }
.fr-eyebrow__sq { width: 7px; height: 7px; border-radius: 2px; background: #18E563; }

.fr-btn { height: 48px; padding: 0 22px; display: inline-flex; align-items: center; gap: 10px; border-radius: 12px; font-family: var(--pl-font); font-weight: 500; font-size: 15px; transition: all .2s; }
.fr-btn--primary { background: #18E563; color: #0A0A0A; box-shadow: 0 12px 26px -12px rgba(24,229,99,.9); }
.fr-btn--primary:hover { background: #14D35A; color: #0A0A0A; }
.fr-btn--secondary { background: #fff; border: 1px solid var(--pl-line); color: #0A0A0A; }
.fr-btn--secondary:hover { border-color: #C4CAC4; }
.fr-btn--secondary span { color: #0B7A34; }

/* hero */
.fr-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
.fr-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(#EEF0EE 1px,transparent 1px),linear-gradient(90deg,#EEF0EE 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%); pointer-events: none; }
.fr-hero__glow { position: absolute; right: -10%; top: -20%; width: 720px; height: 620px; background: radial-gradient(closest-side,rgba(24,229,99,.14),transparent); pointer-events: none; }
.fr-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: clamp(40px,5vw,64px); align-items: center; padding-top: clamp(48px,7vw,96px); padding-bottom: clamp(48px,6vw,80px); }
.fr-crumb { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #5A6373; margin-bottom: 24px; }
.fr-crumb a { color: #5A6373; }
.fr-crumb span:last-child { color: #0A0A0A; }
.fr-hero__btns { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; }
.fr-hero__ticks { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 8px 20px; }
.fr-tick { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #3A414C; }
.fr-tick__ic { flex: none; width: 18px; height: 18px; border-radius: 50%; background: #E8FCEF; border: 1px solid #BFF3D2; color: #0B7A34; font-size: 10px; display: flex; align-items: center; justify-content: center; }

.fr-hero__card-wrap { position: relative; min-width: 0; }
.fr-card { background: #fff; border: 1px solid var(--pl-line); border-radius: 20px; box-shadow: 0 40px 80px -40px rgba(10,10,10,.28); overflow: hidden; }
.fr-card__head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid #EEF0EE; background: #FBFBFA; }

---
// Native Astro port of the design package's "For Marketing Managers" role page.
// Static initial render + the 1s loop reimplemented in vanilla JS: the hero Agent chat
// sequence (ask -> typing -> weekly-summary reply), the weekend-cut timeline that fills
// on scroll, and the three-beliefs row highlight; FAQ accordion; scroll-reveal.
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';

const H: Record<string, string> = { pie: '/price-intelligence-engine', dps: '/dynamic-pricing-software', no: '#' };
const P = (s: string) => { const m = s.match(/^([\s\S]*?)\[\[(.+?)\|(\w+)\]\]([\s\S]*)$/); return m ? { a1: m[1], lt: m[2], lh: H[m[3]], a2: m[4], ld: 'inline' } : { a1: s, lt: '', lh: '#', a2: '', ld: 'none' }; };

const eyebrow = 'For Marketing Managers';
const chips = ['Price drop alerts on competitors', 'A weekly summary on request', 'History for every campaign product'];
const faqH1 = 'Marketing manager';
const ctaH = "See your next campaign's competitors in a demo";

const mktChips = ['Biggest price drops', 'Competitor OOS', 'Set an alert', 'Weekly summary'];
const mktTl = [['Friday evening', 'A competitor drops the price on [12] products in your spring campaign by [15%].'], ['Next scheduled check', 'priceleap.ai records the new prices and sends the [[price drop alert|no]] you set on that competitor, by Slack or email.'], ['Saturday morning', 'You open the Agent and ask for a weekly summary of the price changes.'], ['Monday', 'You and the pricing team decide whether to match, hold, or move spend to products where you still lead on price.']].map(([w, t], i) => ({ w, t: P(t), no: '0' + (i + 1) }));
const mktBel = [["Last year's discount depth is a safe starting point.", '[[Price history|pie]] shows how deep each competitor actually went on your products, from the day you start tracking.'], ['A price check at launch is enough.', "Competitor prices keep being checked on a schedule while the campaign runs, and a price drop alert flags a rival's cut after the next check."], ['A lowest-price claim only needs a screenshot.', 'The competitor list shows each price and when it was last checked, so the claim rests on a dated record.']].map(([b, d], i, a) => ({ b, d: P(d), no: '0' + (i + 1), bb: i < a.length - 1 ? '1px solid #F5ECE5' : 'none' }));

const faqRaw: [string, string][] = [
  ['Can I see when a competitor cuts prices for a promotion?', "Yes, when the promotion changes the price on the competitor's product page. Set a price drop alert on competitors at the percentage you care about, and priceleap.ai alerts you by email, Slack or in-app after the next scheduled check finds the lower price."],
  ['Can I get a weekly summary of competitor price changes?', "Yes. Turn on the weekly digest for a product group and a summary of the week's price changes arrives by email. You can also ask the Agent for a weekly summary from any page, which is handy when you need an answer between two digests."],
  ['Can I track only the products in a campaign?', "Yes. Put the campaign products in their own product group, with its own competitors, schedule and alerts. Competitor alerts then fire only on the products you are promoting. When the campaign ends, the group's price history stays in place for the next planning round."],
  ["Can I plan next year's campaign from this year's prices?", 'Yes, as long as the products stay tracked through this campaign. Their price history keeps the full record, so next year you can see when each competitor cut prices and how deep the cuts went before you set your own discount.'],
];
const faqs = faqRaw.map(([q, a], i) => ({ q, a: P(a), n: String(i + 1).padStart(2, '0'), open: i === 0 }));

const site = 'https://priceleap.ai';
const faqText = (a: string) => a.replace(/\[\[(.+?)\|\w+\]\]/g, '$1');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqRaw.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: faqText(a) } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: site + '/solutions/' },
    { '@type': 'ListItem', position: 3, name: 'Marketing Managers', item: site + '/solutions/marketing-managers' },
  ] },
];
---
<PriceLeapLayout
  title="Competitor Promotion Tracking for Marketers | priceleap.ai"
  description="Track competitor prices on your campaign products, keep the history, and get alerted when a rival cuts a price — so your offer is still competitive on launch day."
  jsonLd={jsonLd}
>
  <div class="mk" style="min-height:100vh;background:#FFFCF9;overflow-x:clip">

    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 70% 80% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 70% 80% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-12%;top:-30%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.09),transparent);pointer-events:none"></div>
      <div class="mk-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(16px,4vw,40px) clamp(56px,7vw,96px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px;align-items:flex-start;text-align:left">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>{eyebrow}</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,4.8vw,62px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Competitor promotion tracking</span><span style="font-weight:400"> for marketing managers</span></h1>
          <p style="margin:0;max-width:600px;font-size:18px;line-height:1.65;color:#3A302A;text-wrap:pretty">A campaign only works if the offer is still competitive the day it goes live. priceleap.ai tracks competitor prices on the products in your campaign, keeps the history, and alerts you when a rival cuts a price.</p>
          <a href="/book-a-demo" style="height:48px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {chips.map((c) => (<span style="height:34px;padding:0 13px 0 9px;display:inline-flex;align-items:center;gap:9px;border-radius:999px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:13.5px;font-weight:500;color:#1C130E;box-shadow:0 6px 14px -12px rgba(60,30,15,.5)"><span style="width:18px;height:18px;border-radius:50%;background:#1C130E;color:#FFFFFF;font-size:9px;display:flex;align-items:center;justify-content:center">✓</span>{c}</span>))}
          </div>
        </div>

        <figure style="margin:0;min-width:0;display:flex;flex-direction:column;gap:12px">
          <div class="mk-chat" style="position:relative;display:grid;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:20px;overflow:hidden;box-shadow:0 48px 90px -52px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7);min-height:380px">
            <div class="mk-dash" style="background:#FBF3EC;padding:14px;flex-direction:column;gap:10px;opacity:.75">
              <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:12px;padding:12px"><div style="font-family:'Geist Mono',monospace;font-size:9px;letter-spacing:.08em;color:#7F7066">OUT OF STOCK</div><div style="margin-top:8px;font-size:11px;color:#665A51">Your Store</div><div style="font-family:Geist,sans-serif;font-size:18px;font-weight:600;color:#1C130E">1 <span style="font-size:11px;font-weight:400;color:#665A51">products</span></div><div style="margin-top:6px;font-size:11px;color:#665A51">Competitors</div><div style="font-family:Geist,sans-serif;font-size:18px;font-weight:600;color:#C2410C">3 <span style="font-size:11px;font-weight:400;color:#665A51">products</span></div></div>
              <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:12px;padding:12px"><div style="font-family:'Geist Mono',monospace;font-size:9px;letter-spacing:.08em;color:#7F7066">MARKET POSITION</div><div style="margin-top:6px;font-family:Geist,sans-serif;font-size:30px;font-weight:600;color:#1C130E">8</div><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#1E7A3D">CHEAPEST</div></div>
            </div>
            <div class="mk-chatcol" style="display:flex;flex-direction:column">
              <div style="display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid #F5ECE5"><span style="width:32px;height:32px;border-radius:9px;background:#FFF4EC;border:1px solid #FFD8BE;color:#C2410C;display:flex;align-items:center;justify-content:center;font-size:13px">◫</span><span><span style="display:block;font-size:13.5px;font-weight:600;color:#1C130E">PriceLeap Agent</span><span style="display:flex;align-items:center;gap:5px;font-size:11px;color:#665A51"><span style="width:6px;height:6px;border-radius:50%;background:#1E7A3D"></span>Online</span></span></div>
              <div style="flex:1;padding:14px;display:flex;flex-direction:column;gap:10px">
                <div style="align-self:flex-start;max-width:92%;padding:11px 13px;border-radius:14px;background:#FFF9F4;border:1px solid #F5ECE5;font-size:12.5px;line-height:1.5;color:#1C130E">Hey, I'm your PriceLeap Agent. I can help you monitor prices, analyse competitor movements, and set up alerts. What would you like to explore?</div>
                <div style="display:flex;flex-wrap:wrap;gap:6px">{mktChips.map((t) => (<span data-mk-chip style={`height:28px;padding:0 11px;display:flex;align-items:center;border-radius:999px;border:1px solid #EFE3DA;background:#FFFFFF;font-size:11.5px;color:#1C130E;transition:all .3s`}>{t}</span>))}</div>
                <div data-mk-ask style="display:none;align-self:flex-end;padding:9px 13px;border-radius:14px;background:#1C130E;color:#FFFFFF;font-size:12.5px;animation:rp-in .3s ease">Weekly summary</div>
                <div data-mk-typing style="display:none;align-self:flex-start;gap:4px;padding:12px 14px;border-radius:14px;background:#FFF9F4;border:1px solid #F5ECE5"><span style="width:6px;height:6px;border-radius:50%;background:#7F7066;animation:rp-dot 1s infinite"></span><span style="width:6px;height:6px;border-radius:50%;background:#7F7066;animation:rp-dot 1s .15s infinite"></span><span style="width:6px;height:6px;border-radius:50%;background:#7F7066;animation:rp-dot 1s .3s infinite"></span></div>
                <div data-mk-reply style="display:none;align-self:flex-start;max-width:96%;padding:12px 13px;border-radius:14px;background:#FFFFFF;border:1px solid #FFD8BE;font-size:12px;line-height:1.5;color:#1C130E;animation:rp-in .35s ease">
                  <div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#C2410C">WEEKLY SUMMARY · SPRING CAMPAIGN</div>
                  <div style="margin-top:8px;display:flex;flex-direction:column;gap:5px"><span>▼ [12] products cut by a competitor</span><span>▼ Deepest cut [15%]</span><span>◌ 3 competitor stock-outs</span></div>
                </div>
              </div>
            </div>
          </div>
          <figcaption style="font-size:13px;color:#665A51;text-align:center">Ask the Agent for a weekly summary from any page</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 WEEKEND PRICE CUT -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <h2 data-reveal style="margin:0;max-width:820px;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">What happens when a competitor starts </span><span style="font-weight:700">a weekend price cut?</span></h2>
        <div data-reveal data-mk-tlwrap class="mk-tl" style="position:relative;margin-top:48px;display:grid;gap:14px">
          <span class="mk-tlline" aria-hidden="true" style="position:absolute;left:12%;right:12%;top:19px;height:2px;background:#EFE3DA"></span>
          <span class="mk-tlline" aria-hidden="true" data-mk-tlfill style="position:absolute;left:12%;top:19px;height:2px;width:0%;background:#1C130E;transition:width .6s ease"></span>
          {mktTl.map((s) => (
            <div data-mk-tl style="position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:16px">
              <span data-mk-tlnode style="position:relative;z-index:1;width:40px;height:40px;border-radius:50%;background:#FFFFFF;border:1.5px solid #EFE3DA;color:#7F7066;font-family:'Geist Mono',monospace;font-size:12px;display:flex;align-items:center;justify-content:center;transition:all .4s">{s.no}</span>
              <div data-mk-tlcard style="width:100%;padding:20px;border-radius:18px;background:#FFFFFF;border:1px solid #EFE3DA;transition:all .4s">
                <div data-mk-tlwhen style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#7F7066">{s.w}</div>
                <p style="margin:8px 0 0;font-size:15px;line-height:1.6;color:#1C130E">{s.t.a1}<a href={s.t.lh} style={`display:${s.t.ld};font-weight:600`}>{s.t.lt}</a>{s.t.a2}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 THREE BELIEFS -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <h2 data-reveal style="margin:0;max-width:760px;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Three beliefs</span><span style="font-weight:400"> about competitor promotions</span></h2>
        <div data-reveal style="margin-top:40px;border:1px solid #EFE3DA;border-radius:24px;overflow:hidden;background:#FFFFFF;box-shadow:0 40px 80px -56px rgba(60,30,15,.35)">
          <div class="mk-bel mk-belhead" style="padding:14px 22px;border-bottom:1px solid #F5ECE5;background:#FFF9F4;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:#7F7066"><span>BELIEF</span><span></span><span style="color:#C2410C">WHAT THE DATA SHOWS</span></div>
          {mktBel.map((r) => (
            <div data-mk-bel class="mk-bel" style={`align-items:center;padding:20px 22px;border-bottom:${r.bb};background:#FFFFFF;transition:background .4s`}>
              <span style="display:flex;gap:14px;align-items:flex-start"><span style="flex:none;font-family:'Geist Mono',monospace;font-size:11px;color:#B9A99C;padding-top:4px">{r.no}</span><span style="font-family:Geist,sans-serif;font-size:17px;font-weight:500;line-height:1.45;color:#665A51;text-decoration:line-through;text-decoration-color:rgba(194,65,12,.45);text-decoration-thickness:1.5px">{r.b}</span></span>
              <span class="mk-arrow" data-mk-belarrow style="width:32px;height:32px;border-radius:50%;background:#FBF3EC;color:#B9A99C;font-size:13px;align-items:center;justify-content:center;transition:all .4s">→</span>
              <span data-mk-belcell style="padding:14px 16px;border-radius:14px;background:#FFFFFF;border:1px solid #F5ECE5;font-size:15px;line-height:1.6;color:#1C130E;transition:border-color .4s"><span class="mk-moblab" style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.1em;color:#C2410C;margin-bottom:4px">WHAT THE DATA SHOWS</span>{r.d.a1}<a href={r.d.lh} style={`display:${r.d.ld};font-weight:600`}>{r.d.lt}</a>{r.d.a2}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 FAQ -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div class="mk-split" style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px);gap:clamp(28px,5vw,72px);align-items:start">
        <h2 data-reveal class="mk-sticky" style="top:96px;margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E"><span style="font-weight:400">{faqH1} </span><span style="font-weight:700">FAQs</span></h2>
        <div style="display:flex;flex-direction:column;gap:10px">
          {faqs.map((qq) => (
            <div class="mk-faq" class:list={[{ 'is-open': qq.open }]} data-mk-faq style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:16px;overflow:hidden;transition:border-color .25s">
              <button type="button" data-mk-faqbtn aria-expanded={qq.open ? 'true' : 'false'} style="width:100%;border:none;background:transparent;cursor:pointer;display:flex;align-items:center;gap:14px;padding:18px 20px;text-align:left">
                <span class="mk-faq-n" style="font-family:'Geist Mono',monospace;font-size:11px">{qq.n}</span>
                <span style="flex:1;font-family:Geist,sans-serif;font-size:16.5px;font-weight:500;color:#1C130E">{qq.q}</span>
                <span class="mk-faq-ic" style="flex:none;width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"></path></svg></span>
              </button>
              <div class="mk-faq-panel"><div style="overflow:hidden"><p style="margin:0;padding:0 20px 20px 52px;font-size:15px;line-height:1.65;color:#3A302A">{qq.a.a1}<a href={qq.a.lh} style={`display:${qq.a.ld};font-weight:600`}>{qq.a.lt}</a>{qq.a.a2}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 05 CTA -->
    <section style="padding:clamp(16px,3vw,28px)">
      <div style="position:relative;max-width:1280px;margin:0 auto;overflow:hidden;background:#1C130E;border-radius:28px;padding:clamp(56px,8vw,96px) clamp(20px,4vw,48px);text-align:center">
        <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 10%,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 10%,transparent 75%)"></div>
        <div aria-hidden="true" style="position:absolute;left:50%;bottom:-240px;width:680px;height:420px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.32),transparent)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;align-items:center;gap:26px">
          <h2 style="margin:0;max-width:820px;font-family:Geist,sans-serif;font-size:clamp(30px,4.4vw,54px);line-height:1.05;letter-spacing:-.045em;font-weight:600;color:#FFFFFF;text-wrap:balance">{ctaH}</h2>
          <a href="/book-a-demo" style="height:52px;padding:0 26px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15.5px;box-shadow:0 14px 30px -12px rgba(247,99,30,.9)">Book a Demo</a>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .mk { background: #FFFCF9; overflow-x: clip; }
  @keyframes rp-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes rp-dot { 0%,80%,100% { opacity: .25; } 40% { opacity: 1; } }

  .mk-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .mk-hero { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); } }
  .mk-chat { grid-template-columns: 1fr; }
  .mk-dash { display: none; }
  .mk-chatcol { border-left: none; }
  @media (min-width: 600px) { .mk-chat { grid-template-columns: minmax(0,.75fr) minmax(0,1.25fr); } .mk-dash { display: flex; } .mk-chatcol { border-left: 1px solid #EFE3DA; } }
  .mk-tl { grid-template-columns: 1fr; }
  .mk-tlline { display: none; }
  @media (min-width: 720px) { .mk-tl { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 900px) { .mk-tl { grid-template-columns: repeat(4,minmax(0,1fr)); } .mk-tlline { display: block; } }
  .mk-bel { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .mk-arrow { display: none; }
  .mk-moblab { display: block; }
  .mk-belhead { display: none; }
  @media (min-width: 720px) { .mk-bel { grid-template-columns: minmax(0,1fr) 32px minmax(0,1.15fr); } .mk-arrow { display: flex; } .mk-moblab { display: none; } .mk-belhead { display: grid; } }
  .mk-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .mk-split { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); } }
  .mk-sticky { position: static; }
  @media (min-width: 1024px) { .mk-sticky { position: sticky; } }

  .mk-faq-n { color: #B9A99C; }
  .mk-faq.is-open .mk-faq-n { color: #C2410C; }
  .mk-faq-ic { background: #FBF3EC; color: #1C130E; transform: rotate(0deg); transition: all .3s; }
  .mk-faq.is-open .mk-faq-ic { background: #1C130E; color: #FFFFFF; transform: rotate(45deg); }
  .mk-faq.is-open { border-color: #FFD8BE; }
  .mk-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .mk-faq.is-open .mk-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .mk *, .mk *::before, .mk *::after { animation: none !important; transition: none !important; } [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.mk') as HTMLElement | null;
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const chipsEl = qa('[data-mk-chip]'), ask = q('[data-mk-ask]'), typing = q('[data-mk-typing]'), reply = q('[data-mk-reply]');
    const tlNodes = qa('[data-mk-tl]'), tlFill = q('[data-mk-tlfill]');
    const bels = qa('[data-mk-bel]');
    const whenText = ['Friday evening', 'Next scheduled check', 'Saturday morning', 'Monday'];
    let tk = 0, seen = false;
    function paint() {
      const p = tk % 12;
      chipsEl.forEach((el, i) => { const on = i === 3 && p >= 2; el.style.borderColor = on ? '#F7631E' : '#EFE3DA'; el.style.background = on ? '#FFF4EC' : '#FFFFFF'; el.style.color = on ? '#C2410C' : '#1C130E'; });
      if (ask) ask.style.display = p >= 3 ? 'block' : 'none';
      if (typing) typing.style.display = (p >= 4 && p < 6) ? 'flex' : 'none';
      if (reply) reply.style.display = p >= 6 ? 'block' : 'none';
      const st = seen ? Math.floor(tk / 2) % 5 : 0;
      if (tlFill) tlFill.style.width = Math.min(76, st * 25.3) + '%';
      tlNodes.forEach((el, i) => {
        const d = i < st, cur = i === st;
        const node = el.querySelector('[data-mk-tlnode]') as HTMLElement, card = el.querySelector('[data-mk-tlcard]') as HTMLElement, when = el.querySelector('[data-mk-tlwhen]') as HTMLElement;
        node.style.background = d || cur ? '#1C130E' : '#FFFFFF'; node.style.borderColor = d || cur ? '#1C130E' : '#EFE3DA'; node.style.color = d || cur ? '#FFFFFF' : '#7F7066'; node.style.boxShadow = cur ? '0 0 0 6px rgba(247,99,30,.16)' : 'none';
        card.style.background = cur ? '#FFF9F4' : '#FFFFFF'; card.style.borderColor = cur ? '#FFD8BE' : '#EFE3DA';
        when.style.color = cur ? '#C2410C' : '#7F7066';
      });
      const bHot = Math.floor(tk / 3) % 3;
      bels.forEach((el, i) => {
        const on = i === bHot; el.style.background = on ? '#FFFCF9' : '#FFFFFF';
        const ar = el.querySelector('[data-mk-belarrow]') as HTMLElement; if (ar) { ar.style.background = on ? '#1C130E' : '#FBF3EC'; ar.style.color = on ? '#FFFFFF' : '#B9A99C'; }
        (el.querySelector('[data-mk-belcell]') as HTMLElement).style.borderColor = on ? '#FFD8BE' : '#F5ECE5';
      });
    }
    paint();
    setInterval(() => { tk++; paint(); }, 1000);

    qa('[data-mk-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-mk-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-mk-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-mk-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); if ((e.target as HTMLElement).hasAttribute('data-mk-tlwrap')) { seen = true; paint(); } } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); seen = true; paint(); }
  }
</script>

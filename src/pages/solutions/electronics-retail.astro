---
// Native Astro port of the design package's "For Electronics Retail" solution page.
// Static initial render + the full 1s animation loop and interactions reimplemented
// in vanilla JS: cycling hero product-info card (model + identifiers), hero chips,
// three problem demos (street-price slide, variant match, markdown timeline),
// interactive price-history range tabs, "why teams pick us" demos (paste/match,
// SmartPrice slider, weekly digest) and FAQ. Responsive via CSS media queries.
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';

const MODELS: { n: string; p: string; cap: string; matched: number; total: number; f: [string, string, number][] }[] = [
  { n: 'Samsung Galaxy S24 Ultra · 512GB · Titanium Black', p: '$1,299.99', cap: '512GB', matched: 4, total: 5, f: [['SKU', 'SM-S928U-512-BK', 0], ['UPC', '887276789012', 1], ['GTIN', '00887276789012', 1], ['MPN', 'SM-S928UZKFXAA', 1], ['BRAND', 'Samsung', 0], ['CATEGORY', 'Smartphones', 0], ['CAPACITY', '512GB', 0], ['COLOR', 'Titanium Black', 0]] },
  { n: 'Sony WH-1000XM5 · Black', p: '$329.99', cap: 'Black', matched: 5, total: 5, f: [['SKU', 'WH1000XM5-B', 0], ['UPC', '027242923782', 1], ['GTIN', '04548736132610', 1], ['MPN', 'WH1000XM5/B', 1], ['BRAND', 'Sony', 0], ['CATEGORY', 'Headphones', 0], ['VARIANT', 'Over-ear', 0], ['COLOR', 'Black', 0]] },
  { n: 'LG C3 OLED 65" · OLED65C3PUA', p: '$1,599.99', cap: '65"', matched: 3, total: 4, f: [['SKU', 'LG-OLED65C3', 0], ['UPC', '195174049325', 1], ['GTIN', '00195174049325', 1], ['MPN', 'OLED65C3PUA', 1], ['BRAND', 'LG', 0], ['CATEGORY', 'TVs', 0], ['SIZE', '65"', 0], ['YEAR', '2023', 0]] },
];

// initial model (mi=0, hi=0 → no identifier highlighted)
const m0 = MODELS[0];
const idFieldsInit = m0.f.map(([k, v, id], i) => ({
  k, v, dl: (i * 0.05).toFixed(2),
  bg: id ? '#FFF9F4' : '#FFFFFF', bc: id ? '#FFD8BE' : '#F5ECE5', kc: id ? '#C2410C' : '#7F7066', ckD: 'none',
}));

const chipsInit = ['Price history from 14 days to the full record', 'Price drop alerts', 'UPC, GTIN and MPN on every product']
  .map((t, i) => { const on = i === 0; return { t, bg: on ? '#FFF4EC' : '#FFFFFF', bc: on ? '#FFD8BE' : '#EFE3DA', dot: on ? '#F7631E' : '#D7C6BA' }; });

// price-history series (matches the client series())
const series = (base: number, drift: number, wob: number, seed: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 24; i++) { const x = i / 24 * 600; const v = base - drift * (i / 24) + Math.sin(i * 0.9 + seed) * wob + (i % 7 === seed % 7 ? -wob * 1.6 : 0); pts.push(x.toFixed(0) + ',' + v.toFixed(1)); }
  return pts.join(' ');
};
// range = 2 (90D) initial, k = 1
const hYouInit = series(55, 22, 3, 1), hAInit = series(62, 34, 6, 3), hBInit = series(40, 14, 4, 5);
const rangesInit = [['14D', 14], ['30D', 30], ['90D', 90], ['1Y', 365]].map(([t], i) => ({ t, on: i === 2 }));

// markdown marks (mdW = 0 initial → none hit)
const mdMarksInit = [['SLOW SKU', 12], ['NEW MODEL', 58], ['REPORT', 92]].map(([t, x]) => ({ t, x, bg: '#FFFFFF', bc: '#E2D3C8', c: '#B9A99C' }));
const sellersInit = ['Retailer A · 512GB', 'Retailer B · 512GB', 'Retailer C · 256GB'].map((n) => ({ n, tag: 'CHECKING', o: '.45', bc: '#EFE3DA', bg: '#FFFFFF', tc: '#7F7066' }));
const chansInit = ['TVs', 'Phones', 'Audio'].map((t, i) => { const on = i === 0; return { t, bg: on ? '#1C130E' : '#FFFFFF', bc: on ? '#1C130E' : '#EFE3DA', c: on ? '#FFFFFF' : '#3A302A' }; });

const faqs = [
  { q: 'How do you avoid matching the wrong variant?', hasLink: true, a1: 'Every product stores its UPC, GTIN and MPN, so your team can confirm a competitor listing is the same variant before it counts. Listings that aren’t matched show as No match rather than a wrong price. More on ', a2: '.', a: '' },
  { q: 'How quickly can I add a new model?', hasLink: false, a: 'Paste the new model’s product URL into its group. Use Fetch now on the group for an immediate price check, and set a price drop alert to catch the first cut after launch.', a1: '', a2: '' },
  { q: 'Which electronics categories can I track?', hasLink: false, a: 'Any model with a product page you can link to, from TVs to headphones. Group them by category so each line gets its own competitor set, schedule and rules.', a1: '', a2: '' },
].map((f, i) => ({ ...f, n: '0' + (i + 1), open: i === 0 }));

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How do you avoid matching the wrong variant?', acceptedAnswer: { '@type': 'Answer', text: 'Every product stores its UPC, GTIN and MPN, so your team can confirm a competitor listing is the same variant before it counts. Listings that aren’t matched show as No match rather than a wrong price. More on Product Matching.' } },
    { '@type': 'Question', name: 'How quickly can I add a new model?', acceptedAnswer: { '@type': 'Answer', text: 'Paste the new model’s product URL into its group. Use Fetch now on the group for an immediate price check, and set a price drop alert to catch the first cut after launch.' } },
    { '@type': 'Question', name: 'Which electronics categories can I track?', acceptedAnswer: { '@type': 'Answer', text: 'Any model with a product page you can link to, from TVs to headphones. Group them by category so each line gets its own competitor set, schedule and rules.' } },
  ],
}];
---
<PriceLeapLayout
  title="Electronics Price Monitoring Software | priceleap.ai"
  description="Track competitor prices on every model, keep the price history from day one, and get alerts when a rival drops. UPC, GTIN and MPN included. Book a Demo."
  jsonLd={jsonLd}
>
  <div class="el" style="min-height:100vh;background:#FFFCF9;overflow-x:clip">

    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.10),transparent);pointer-events:none"></div>
      <div class="el-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(40px,6vw,84px) clamp(16px,4vw,40px) clamp(48px,6vw,88px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:#665A51"><a href="#" style="color:#665A51">Solutions</a><span style="color:#D7C6BA">›</span><a href="#" style="color:#665A51">By Industry</a><span style="color:#D7C6BA">›</span><span style="color:#1C130E">Electronics Retail</span></nav>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
            <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>For Electronics Retail</span>
            <span style="height:24px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:999px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:12px;color:#1C130E"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2.2"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"></path></svg>Price history on every model</span>
          </div>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,5vw,62px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Price monitoring</span><span style="font-weight:400"> for electronics retailers</span></h1>
          <p style="margin:0;max-width:580px;font-size:17.5px;line-height:1.65;color:#3A302A;text-wrap:pretty">priceleap.ai tracks the competitor listings you match to each model, keeps the price history from the day you start tracking, and alerts you when a competitor drops a price or runs out of stock. UPC, GTIN and MPN sit on every product, so you can check you're comparing the same variant.</p>
          <a href="/book-a-demo" style="align-self:flex-start;height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {chipsInit.map((c) => (
              <span data-el-chip style={`height:32px;padding:0 12px;display:flex;align-items:center;gap:8px;border-radius:9px;background:${c.bg};border:1px solid ${c.bc};font-size:13px;color:#1C130E;transition:all .35s`}><span data-el-chipdot style={`width:6px;height:6px;border-radius:50%;background:${c.dot};transition:background .35s`}></span>{c.t}</span>
            ))}
          </div>
        </div>

        <figure style="margin:0;min-width:0;display:flex;flex-direction:column;gap:10px">
          <div style="position:relative;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 48px 90px -52px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
              <span style="font-size:13.5px;font-weight:600;color:#1C130E">Product Info</span>
              <span style="display:flex;gap:6px"><span style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:7px;border:1px solid #EFE3DA;background:#FFFFFF;font-size:11.5px;color:#3A302A">Edit</span><span style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:7px;background:#1C130E;font-size:11.5px;color:#FFFFFF">Fetch now</span></span>
            </div>
            <div class="el-info" style="display:grid;gap:0">
              <div class="el-infoleft" style="padding:16px;display:flex;flex-direction:column;gap:10px">
                <div style="aspect-ratio:1 / 1;max-height:150px;border-radius:12px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 7px,#FFFCF9 7px 14px);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:10px;color:#7F7066">product image</div>
                <div data-el-mname style="font-size:14px;font-weight:600;line-height:1.35;color:#1C130E">{m0.n}</div>
                <div style="display:flex;align-items:center;gap:8px"><span data-el-mprice style="font-family:Geist,sans-serif;font-size:20px;font-weight:600;color:#1C130E">{m0.p}</span><span style="height:20px;padding:0 7px;display:flex;align-items:center;border-radius:5px;background:#F6FBF7;border:1px solid #BFE5CC;font-family:'Geist Mono',monospace;font-size:9.5px;color:#1E7A3D">● active</span></div>
              </div>
              <div data-el-idgrid style="padding:16px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;align-content:start">
                {idFieldsInit.map((f) => (
                  <div style={`padding:8px 10px;border-radius:10px;background:${f.bg};border:1px solid ${f.bc};display:flex;flex-direction:column;gap:3px;transition:all .3s;animation:el-in .35s ease ${f.dl}s both`}>
                    <span style={`display:flex;align-items:center;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:${f.kc}`}>{f.k}<span data-el-chk style={`display:${f.ckD};color:#1E7A3D`}>✓</span></span>
                    <span style="font-family:'Geist Mono',monospace;font-size:12px;font-weight:500;color:#1C130E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{f.v}</span>
                  </div>
                ))}
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:11px 16px;border-top:1px solid #F5ECE5;background:#FFF9F4;font-size:12px;color:#3A302A"><span style="width:18px;height:18px;flex:none;border-radius:50%;background:#1C130E;color:#FFFFFF;font-size:9px;display:flex;align-items:center;justify-content:center">✓</span>Comparing <b data-el-cap style="color:#1C130E">{m0.cap}</b> with <b data-el-cap style="color:#1C130E">{m0.cap}</b> · same MPN on <span data-el-matched style="font-weight:600;color:#1C130E">{m0.matched}</span> of <span data-el-total style="font-weight:600;color:#1C130E">{m0.total}</span> competitor listings</div>
          </div>
          <figcaption style="font-size:13px;color:#665A51;text-align:center">Identifiers stored on every product</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 PROBLEM -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The problem</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Electronics prices </span><span style="font-weight:700">don't stay right for long</span></h2>
        </div>
        <div class="el-prob" style="margin-top:48px;border:1px solid #EFE3DA;border-radius:24px;overflow:hidden;background:#EFE3DA;display:grid;gap:1px">
          <div data-reveal style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="position:relative;height:220px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;padding:20px;display:flex;align-items:center;justify-content:center;overflow:hidden"><div style="width:100%;max-width:300px;display:flex;flex-direction:column;gap:8px">
              <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066"><span>STREET PRICE</span><span data-el-slidenow style="color:#B42318">$1,299</span></div>
              <svg viewBox="0 0 300 120" style="display:block;width:100%;height:auto;overflow:visible">
                <line x1="0" y1="24" x2="300" y2="24" stroke="#1C130E" stroke-dasharray="3 4"></line>
                <text x="0" y="16" font-family="Geist Mono" font-size="9" fill="#1C130E">YOUR LAUNCH PRICE $1,299</text>
                <path d="M0,24 C40,26 60,40 100,52 C140,64 180,78 220,86 C250,92 275,96 300,98 L300,120 L0,120 Z" fill="#FFF4EC"></path>
                <path d="M0,24 C40,26 60,40 100,52 C140,64 180,78 220,86 C250,92 275,96 300,98" fill="none" stroke="#F7631E" stroke-width="2.2" pathLength="1" style="stroke-dasharray:1;animation:el-draw 2.2s ease both"></path>
                <circle data-el-slidedot cx="20" cy="25" r="5" fill="#F7631E" stroke="#FFFFFF" stroke-width="2" style="transition:all .9s ease"></circle>
                <line data-el-slideline x1="20" y1="24" x2="20" y2="25" stroke="#B42318" stroke-width="1.5" style="transition:all .9s ease"></line>
              </svg>
              <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066"><span>LAUNCH</span><span>WK 2</span><span>WK 4</span><span>WK 8</span></div>
            </div></div>
            <div style="padding:24px 26px 28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">01</span><p style="margin:0;font-size:16px;line-height:1.6;color:#1C130E;text-wrap:pretty">Street prices slide from launch day onward. A price you set at launch is above the market within a month.</p></div>
          </div>
          <div data-reveal style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="position:relative;height:220px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;padding:20px;display:flex;align-items:center;justify-content:center;overflow:hidden"><div style="width:100%;max-width:300px;display:grid;grid-template-columns:1fr 30px 1fr;align-items:center;gap:0">
              <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:6px">
                <div style="height:50px;border-radius:8px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 6px,#FFFCF9 6px 12px)"></div>
                <span style="font-size:11px;font-weight:600;line-height:1.3;color:#1C130E">Galaxy S24 Ultra Titanium Black</span>
                <span style="align-self:flex-start;height:20px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:#1C130E;font-family:'Geist Mono',monospace;font-size:10px;color:#FFFFFF">512GB</span>
              </div>
              <div style="display:flex;flex-direction:column;align-items:center;gap:4px"><span data-el-varline style="width:100%;height:2px;background:#EFE3DA;transition:background .4s"></span><span data-el-varmk style="width:22px;height:22px;border-radius:50%;background:#B9A99C;color:#FFFFFF;font-size:11px;display:flex;align-items:center;justify-content:center;transition:background .4s">?</span></div>
              <div data-el-varbox style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:12px;padding:10px;display:flex;flex-direction:column;gap:6px;transition:border-color .4s">
                <div style="height:50px;border-radius:8px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 6px,#FFFCF9 6px 12px)"></div>
                <span style="font-size:11px;font-weight:600;line-height:1.3;color:#1C130E">Galaxy S24 Ultra Titanium Black</span>
                <span data-el-vartag style="align-self:flex-start;height:20px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:#1C130E;font-family:'Geist Mono',monospace;font-size:10px;color:#FFFFFF;transition:all .4s">256GB</span>
              </div>
              <span data-el-varnote style="grid-column:1 / -1;margin-top:10px;text-align:center;font-family:'Geist Mono',monospace;font-size:10px;color:#7F7066;transition:color .4s">Title match: 100% identical</span>
            </div></div>
            <div style="padding:24px 26px 28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">02</span><p style="margin:0;font-size:16px;line-height:1.6;color:#1C130E;text-wrap:pretty">Model numbers, capacities, colors and retailer-exclusive bundles look almost identical. Matching on title alone compares a 512GB unit to a 256GB one.</p></div>
          </div>
          <div data-reveal style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="position:relative;height:220px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;padding:20px;display:flex;align-items:center;justify-content:center;overflow:hidden"><div style="width:100%;max-width:300px;display:flex;flex-direction:column;gap:10px">
              <div style="position:relative;height:56px">
                <span style="position:absolute;left:0;right:0;top:27px;height:2px;background:#EFE3DA"></span>
                <span data-el-mdbar style="position:absolute;left:0;top:27px;height:2px;width:0%;background:#1C130E;transition:width .9s linear"></span>
                {mdMarksInit.map((m) => (
                  <span data-el-mdmark style={`position:absolute;left:${m.x}%;top:0;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px`}>
                    <span data-el-mdtxt style={`font-family:'Geist Mono',monospace;font-size:9px;letter-spacing:.06em;color:${m.c};white-space:nowrap`}>{m.t}</span>
                    <span data-el-mddot style={`width:14px;height:14px;border-radius:50%;background:${m.bg};border:2px solid ${m.bc};transition:all .4s`}></span>
                  </span>
                ))}
              </div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center">
                <span style="height:26px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:7px;border:1px solid #EFE3DA;background:#FFFFFF;font-size:11.5px;color:#3A302A;white-space:nowrap"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l5 5v15H6zM14 2v6h6"></path></svg>Weekly report</span>
                <span data-el-mdtag style="height:26px;padding:0 9px;display:flex;align-items:center;white-space:nowrap;border-radius:7px;background:#FFFFFF;border:1px solid #EFE3DA;font-family:'Geist Mono',monospace;font-size:10px;color:#7F7066;transition:all .4s">WAITING FOR MONDAY</span>
              </div>
            </div></div>
            <div style="padding:24px 26px 28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">03</span><p style="margin:0;font-size:16px;line-height:1.6;color:#1C130E;text-wrap:pretty">Markdowns get taken too late. By the time a slow SKU shows up in a weekly report, the new model has already been announced.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 SOLUTION -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div style="max-width:1100px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The solution</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Follow every model's </span><span style="font-weight:700">price over time</span></h2>

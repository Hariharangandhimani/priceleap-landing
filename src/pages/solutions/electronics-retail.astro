        lastMi = mi;
        if (idgrid) idgrid.innerHTML = md.f.map(([k, v, id], i) => cellHTML(k, v, id, false, i)).join('');
        if (mname) mname.textContent = md.n;
        if (mprice) mprice.textContent = md.p;
        caps.forEach((c) => (c.textContent = md.cap));
        if (matchedEl) matchedEl.textContent = String(md.matched);
        if (totalEl) totalEl.textContent = String(md.total);
      }
      const cells = idgrid ? idgrid.children : null;
      md.f.forEach(([, , id], i) => {
        const on = !!id && hi >= 1 && hi - 1 <= i;
        const cell = cells ? (cells[i] as HTMLElement) : null; if (!cell) return;
        cell.style.background = id ? (on ? '#FFF4EC' : '#FFF9F4') : '#FFFFFF';
        cell.style.borderColor = id ? (on ? '#F7631E' : '#FFD8BE') : '#F5ECE5';
        const chk = cell.querySelector('[data-el-chk]') as HTMLElement | null;
        if (chk) chk.style.display = on ? 'inline' : 'none';
      });
      // chips
      const cph = Math.floor(tk / 3) % 3;
      chips.forEach((el, i) => { const on = i === cph; el.style.background = on ? '#FFF4EC' : '#FFFFFF'; el.style.borderColor = on ? '#FFD8BE' : '#EFE3DA'; const d = el.querySelector('[data-el-chipdot]') as HTMLElement | null; if (d) d.style.background = on ? '#F7631E' : '#D7C6BA'; });
      // problem 1 slide
      const sp = Math.floor(tk / 2) % 4, sx = [20, 100, 180, 280][sp], sy = [25, 52, 76, 96][sp];
      if (slideNow) slideNow.textContent = ['$1,299', '$1,229', '$1,169', '$1,099'][sp] + (sp ? ' · −' + [0, 5, 10, 15][sp] + '%' : '');
      if (slideDot) { slideDot.setAttribute('cx', String(sx)); slideDot.setAttribute('cy', String(sy)); }
      if (slideLine) { slideLine.setAttribute('x1', String(sx)); slideLine.setAttribute('x2', String(sx)); slideLine.setAttribute('y2', String(sy)); }
      // problem 2 variant
      const vp = Math.floor(tk / 3) % 2;
      if (varMk) { varMk.textContent = vp ? '✕' : '?'; varMk.style.background = vp ? '#B42318' : '#B9A99C'; }
      if (varLine) varLine.style.background = vp ? '#F5C6C3' : '#EFE3DA';
      if (varBox) varBox.style.borderColor = vp ? '#F5C6C3' : '#EFE3DA';
      if (varTag) { varTag.style.background = vp ? '#FDECEB' : '#1C130E'; varTag.style.color = vp ? '#B42318' : '#FFFFFF'; }
      if (varNote) { varNote.textContent = vp ? 'Different capacity · not the same product' : 'Title match: 100% identical'; varNote.style.color = vp ? '#B42318' : '#7F7066'; }
      // problem 3 markdown
      const mp = tk % 8, mdW = Math.min(100, mp * 16);
      if (mdBar) mdBar.style.width = mdW + '%';
      mdMarks.forEach((el, i) => { const x = mdMarksData[i][1]; const hit = mdW >= x; const red = i === 1; const dot = el.querySelector('[data-el-mddot]') as HTMLElement | null; const txt = el.querySelector('[data-el-mdtxt]') as HTMLElement | null; if (dot) { dot.style.background = hit ? (red ? '#B42318' : '#1C130E') : '#FFFFFF'; dot.style.borderColor = hit ? (red ? '#B42318' : '#1C130E') : '#E2D3C8'; } if (txt) txt.style.color = hit ? (red ? '#B42318' : '#1C130E') : '#B9A99C'; });
      const late = mdW >= 92;
      if (mdTag) { mdTag.textContent = late ? 'TOO LATE TO MARK DOWN' : 'WAITING FOR MONDAY'; mdTag.style.background = late ? '#FDECEB' : '#FFFFFF'; mdTag.style.borderColor = late ? '#F5C6C3' : '#EFE3DA'; mdTag.style.color = late ? '#B42318' : '#7F7066'; }
      // why 1 sellers
      if (pasteEl) pasteEl.textContent = ids[Math.floor(tk / 2) % 3];
      const up = Math.floor(tk / 2) % 4;
      sellers.forEach((el, i) => { const on = i < up, bad = sellTags[i][1]; const tag = el.querySelector('[data-el-stag]') as HTMLElement | null; if (tag) { tag.textContent = on ? (bad ? 'NO MATCH' : 'SAME MPN ✓') : 'CHECKING'; tag.style.color = on ? (bad ? '#B42318' : '#1E7A3D') : '#7F7066'; } el.style.opacity = on ? '1' : '.45'; el.style.borderColor = on ? (bad ? '#F5C6C3' : '#BFE5CC') : '#EFE3DA'; el.style.background = on ? (bad ? '#FFF7F6' : '#F6FBF7') : '#FFFFFF'; });
      // why 2 smartprice
      const spPos: [number, string] = [[22, '$1,099'], [48, '$1,199'], [86, '$1,299']][Math.floor(tk / 3) % 3] as [number, string];
      if (spDot) spDot.style.left = spPos[0] + '%';
      if (spLabel) { spLabel.style.left = spPos[0] + '%'; spLabel.textContent = spPos[1]; }
      // why 3 alert + chans
      if (alertEl) alertEl.style.display = (tk % 4 >= 1) ? 'flex' : 'none';
      const ach = Math.floor(tk / 2) % 3;
      chans.forEach((el, i) => { const on = i === ach; el.style.background = on ? '#1C130E' : '#FFFFFF'; el.style.borderColor = on ? '#1C130E' : '#EFE3DA'; el.style.color = on ? '#FFFFFF' : '#3A302A'; });
    }
    paint();
    setInterval(() => { tick++; paint(); }, 1000);

    // ---- price-history range tabs ----
    const RANGES: [string, number][] = [['14D', 14], ['30D', 30], ['90D', 90], ['1Y', 365]];
    const series = (base: number, drift: number, wob: number, seed: number) => { const pts: string[] = []; for (let i = 0; i <= 24; i++) { const x = i / 24 * 600; const v = base - drift * (i / 24) + Math.sin(i * 0.9 + seed) * wob + (i % 7 === seed % 7 ? -wob * 1.6 : 0); pts.push(x.toFixed(0) + ',' + v.toFixed(1)); } return pts.join(' '); };
    const hYou = root.querySelector('[data-el-hyou]') as SVGElement | null, hA = root.querySelector('[data-el-ha]') as SVGElement | null, hB = root.querySelector('[data-el-hb]') as SVGElement | null;
    const hStart = q('[data-el-hstart]'), hSummary = q('[data-el-hsummary]');
    const rangeBtns = qa('[data-el-range]');
    const draws = ['el-draw 1.2s ease both', 'el-draw 1.2s ease .15s both', 'el-draw 1.2s ease .3s both'];
    let range = 2;
    function paintRange() {
      const [rl, rd] = RANGES[range], k = rd / 90;
      if (hYou) hYou.setAttribute('points', series(55, 22 * k, 3, 1));
      if (hA) hA.setAttribute('points', series(62, 34 * k, 6, 3));
      if (hB) hB.setAttribute('points', series(40, 14 * k, 4, 5));
      const lo = Math.round(1299 - 200 * Math.min(1, k));
      if (hStart) hStart.textContent = '−' + rl;
      if (hSummary) hSummary.textContent = 'Range $' + lo.toLocaleString() + ' – $1,299 over ' + rl + ' · You are 2nd lowest today';
      rangeBtns.forEach((b, i) => { const on = range === i; b.style.background = on ? '#1C130E' : 'transparent'; b.style.color = on ? '#FFFFFF' : '#3A302A'; b.setAttribute('aria-selected', String(on)); });
      [hYou, hA, hB].forEach((p, i) => { if (!p) return; p.style.animation = 'none'; void (p as unknown as HTMLElement).getBoundingClientRect(); p.style.animation = draws[i]; });
    }
    rangeBtns.forEach((b, i) => b.addEventListener('click', () => { range = i; paintRange(); }));

    // ---- faq ----
    qa('[data-el-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-el-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-el-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-el-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

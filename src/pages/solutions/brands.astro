          <h2 style="margin:0;max-width:820px;font-family:Geist,sans-serif;font-size:clamp(30px,4.4vw,52px);line-height:1.06;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">See your resellers' prices next to your MAP, </span><span style="font-weight:700">on your own products.</span></h2>
          <span style="font-family:'Geist Mono',monospace;font-size:11.5px;color:#7F7066">[confirm demo format with sales]</span>
          <a href="/book-a-demo" style="height:50px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .fb { background: #FFFCF9; overflow-x: clip; }
  @keyframes fb-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 9px rgba(247,99,30,0); } }
  @keyframes fb-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes fb-pop { 0% { opacity: 0; transform: scale(.92); } 100% { opacity: 1; transform: none; } }
  @keyframes fb-flash { 0% { background: #FFE9D9; } 100% { background: transparent; } }
  @keyframes fb-scan { 0% { top: 0; } 100% { top: 100%; } }

  .fb-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .fb-hero { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); } }
  .fb-logos { grid-template-columns: 1fr; }
  .fb-logolabel { border-bottom: 1px solid #EFE3DA; }
  .fb-logogrid { grid-template-columns: repeat(3,minmax(0,1fr)); }
  @media (min-width: 720px) { .fb-logos { grid-template-columns: 260px minmax(0,1fr); } .fb-logolabel { border-right: 1px solid #EFE3DA; border-bottom: none; } }
  @media (min-width: 900px) { .fb-logogrid { grid-template-columns: repeat(6,minmax(0,1fr)); } }
  .fb-ask { grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .fb-ask { grid-template-columns: minmax(0,1.2fr) minmax(0,1fr); } }
  .fb-askrow { grid-template-columns: 1fr; }
  .fb-anshead { display: none; }
  @media (min-width: 720px) { .fb-askrow { grid-template-columns: minmax(0,1fr) minmax(0,1.3fr); } .fb-anshead { display: block; } }
  .fb-vs { grid-template-columns: 1fr; }
  .fb-vsbadge { display: none; }
  @media (min-width: 1024px) { .fb-vs { grid-template-columns: 1fr 1fr; } .fb-vsbadge { display: flex; } }
  .fb-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .fb-split { grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); } }
  .fb-auth { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .fb-auth { grid-template-columns: minmax(0,.75fr) minmax(0,1.25fr); } }
  .fb-splitr { display: grid; grid-template-columns: 1fr; }
  .fb-s5panel { order: 1; }
  @media (min-width: 1024px) { .fb-splitr { grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); } .fb-s5panel { order: 0; } }
  .fb-stockgrid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  @media (min-width: 560px) { .fb-stockgrid { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  .fb-sticky { position: static; }
  @media (min-width: 1024px) { .fb-sticky { position: sticky; } }

  .fb-faq-n { color: #B9A99C; }
  .fb-faq.is-open .fb-faq-n { color: #C2410C; }
  .fb-faq-ic { background: #FBF3EC; color: #1C130E; transform: rotate(0deg); transition: all .3s; }
  .fb-faq.is-open .fb-faq-ic { background: #1C130E; color: #FFFFFF; transform: rotate(45deg); }
  .fb-faq.is-open { border-color: #FFD8BE; }
  .fb-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .fb-faq.is-open .fb-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .fb *, .fb *::before, .fb *::after { animation: none !important; transition: none !important; } [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.fb') as HTMLElement | null;
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const tag = (k: string): string[] => (({ ok: ['AT MAP', '#EEF8F1', '#BFE5CC', '#1E7A3D'], above: ['ABOVE MAP', '#FBF3EC', '#EFE3DA', '#3A302A'], below: ['−7% BELOW MAP', '#FDECEB', '#F5C6C3', '#B42318'], unauth: ['UNAUTHORIZED', '#FFF4EC', '#FFD8BE', '#C2410C'], oos: ['OUT OF STOCK', '#FBF3EC', '#EFE3DA', '#665A51'] } as Record<string, string[]>)[k]);

    // hero refs
    const hPrice = q('[data-fb-hprice="1"]'), hTagSL = q('[data-fb-htag="1"]'), hRowSL = q('[data-fb-hrow="1"]');
    const hStock = q('[data-fb-hstock="1"]'), hDot = q('[data-fb-hdot="1"]'), hTagKH = q('[data-fb-htag="3"]');
    const nBelow = q('[data-fb-nbelow]'), nOos = q('[data-fb-noos]');
    // ask refs
    const askBtns = qa('[data-fb-ask]'), askCard = q('[data-fb-askcard]'), askTitle = q('[data-fb-asktitle]');
    const askPanels = qa('[data-fb-askpanel]'), askDots = qa('[data-fb-askdot]');
    const ASK_TITLES = ['MAP filter · below MAP', 'Authorized list check', 'Reseller stock', 'MAP & MSRP validity periods', 'Your store vs policy'];
    // v2 refs
    const v2stock = q('[data-fb-v2stock="1"]'), v2dot = q('[data-fb-v2dot="1"]'), v2row = q('[data-fb-v2row="1"]'), oosAlert = q('[data-fb-oosalert]');
    // v3 refs
    const pRange0 = q('[data-fb-prange="0"]'), pRange1 = q('[data-fb-prange="1"]'), pBar0 = q('[data-fb-pbar="0"]'), pBar1 = q('[data-fb-pbar="1"]');
    // v4 refs
    const ownP = q('[data-fb-ownp]'), ownDot = q('[data-fb-owndot]'), ownAlert = q('[data-fb-ownalert]'), ownAlertText = q('[data-fb-ownalerttext]');
    // section 04 / 05
    const foundRows = qa('[data-fb-found]');
    const sgStock = q('[data-fb-sgstock="1"]'), sgDot = q('[data-fb-sgdot="1"]'), sgRow = q('[data-fb-sgrow="1"]'), soAlert = q('[data-fb-so]');

    const foundOk = [true, true, true, false, false];
    const ownData: [number, string, string, string][] = [[189.00, 'none', '', '#1C130E'], [139.00, 'flex', 'Your price $139.00 is below MAP $149.00', '#B42318'], [209.00, 'flex', 'Your price $209.00 is above MSRP $199.00', '#B42318']];

    let tick = 0, ask = 0, askAuto = true, lastHp = 0, lastAsk = -1;

    function paintAsk() {
      askBtns.forEach((b, i) => { const on = i === ask; b.style.background = on ? '#FFF9F4' : '#FFFFFF'; b.setAttribute('aria-pressed', String(on)); const bar = b.querySelector('[data-fb-askbar]') as HTMLElement | null; if (bar) bar.style.background = on ? '#F7631E' : 'transparent'; });
      askDots.forEach((d, i) => { const on = i === ask; d.style.width = on ? '22px' : '6px'; d.style.background = on ? '#F7631E' : '#E2D3C8'; });
      askPanels.forEach((p) => { p.hidden = Number(p.getAttribute('data-fb-askpanel')) !== ask; });
      if (askTitle) askTitle.textContent = ASK_TITLES[ask];
      if (ask !== lastAsk) { lastAsk = ask; if (askCard) { askCard.style.animation = 'none'; void askCard.offsetWidth; askCard.style.animation = 'fb-in .35s ease'; } }
    }

    function paint() {
      const tk = tick;
      // hero (hp)
      const hp = Math.floor(tk / 3) % 4;
      const shopBelow = hp >= 1 && hp < 3, hubOos = hp >= 2;
      if (hp !== lastHp) {
        lastHp = hp;
        // ShopLine
        if (hPrice) { hPrice.textContent = shopBelow ? '$139.00' : '$149.00'; hPrice.style.color = shopBelow ? '#B42318' : '#1C130E'; hPrice.style.animation = 'none'; if (hp === 1) { void hPrice.offsetWidth; hPrice.style.animation = 'fb-flash 1.2s ease'; } }
        if (hTagSL) { const t = tag(shopBelow ? 'below' : 'ok'); hTagSL.textContent = shopBelow ? 'BELOW MAP' : t[0]; hTagSL.style.background = t[1]; hTagSL.style.borderColor = t[2]; hTagSL.style.color = t[3]; }
        if (hRowSL) hRowSL.style.background = shopBelow ? '#FFFCF9' : '#FFFFFF';
        // Kitchen Hub
        const kst = hubOos ? 'Out' : 'Low';
        if (hStock) hStock.textContent = kst;
        if (hDot) hDot.style.background = hubOos ? '#B42318' : '#F7631E';
        if (hStock) hStock.parentElement!.style.color = hubOos ? '#B42318' : '#C2410C';
        if (hTagKH) { const t = tag(hubOos ? 'oos' : 'ok'); hTagKH.textContent = t[0]; hTagKH.style.background = t[1]; hTagKH.style.borderColor = t[2]; hTagKH.style.color = t[3]; }
        if (nBelow) nBelow.textContent = String(shopBelow ? 2 : 1);
        if (nOos) nOos.textContent = String(hubOos ? 1 : 0);
      }
      // ask auto-advance (every 6 ticks)
      if (askAuto && (tk + 1) % 6 === 0) { ask = (ask + 1) % 5; paintAsk(); }
      // v2 (sp)
      const sp = tk % 6 >= 3;
      if (v2stock) v2stock.textContent = sp ? 'Out of stock' : 'Low stock';
      if (v2dot) v2dot.style.background = sp ? '#B42318' : '#F7631E';
      if (v2stock) v2stock.parentElement!.style.color = sp ? '#B42318' : '#C2410C';
      if (v2row) { v2row.style.borderColor = sp ? '#F5C6C3' : '#EFE3DA'; v2row.style.background = sp ? '#FFF7F6' : '#FFFFFF'; }
      if (oosAlert) oosAlert.style.display = sp ? 'flex' : 'none';
      // v3 (pp)
      const pp = tk % 6 >= 2;
      [pRange0, pRange1].forEach((el) => { if (el) el.textContent = pp ? 'NOV 20 – JAN 02' : 'ALWAYS'; });
      [pBar0, pBar1].forEach((el) => { if (el) { el.style.left = (pp ? 42 : 100) + '%'; el.style.width = (pp ? 42 : 0) + '%'; } });
      // v4 (op)
      const op = Math.floor(tk / 2) % 3, own = ownData[op], ownX = ((own[0] - 119) / (219 - 119) * 100).toFixed(1);
      if (ownP) { ownP.textContent = '$' + own[0].toFixed(2); ownP.style.color = own[3]; }
      if (ownDot) ownDot.style.left = ownX + '%';
      if (ownAlert) ownAlert.style.display = own[1];
      if (ownAlertText) ownAlertText.textContent = own[2];
      // section 04 found (fp)
      const fp = tk % 10;
      foundRows.forEach((row, i) => { const checked = fp >= i + 1; const ok = foundOk[i]; const flag = checked && !ok; const el = row.querySelector('[data-fb-foundtag]') as HTMLElement | null; if (el) { el.textContent = !checked ? 'CHECKING…' : ok ? 'AUTHORIZED' : 'FLAGGED'; el.style.background = flag ? '#FFF4EC' : checked ? '#EEF8F1' : '#FFFFFF'; el.style.borderColor = flag ? '#FFD8BE' : checked ? '#BFE5CC' : '#EFE3DA'; el.style.color = flag ? '#C2410C' : checked ? '#1E7A3D' : '#7F7066'; } row.style.background = flag ? '#FFF9F4' : '#FFFFFF'; });
      // section 05 stockGrid (sg)
      const sg = tk % 8 >= 4;
      if (sgStock) sgStock.textContent = sg ? 'Out of stock' : 'Low stock';
      if (sgDot) sgDot.style.background = sg ? '#B42318' : '#F7631E';
      if (sgStock) sgStock.parentElement!.style.color = sg ? '#B42318' : '#C2410C';
      if (sgRow) { sgRow.style.borderColor = sg ? '#1C130E' : '#EFE3DA'; sgRow.style.background = sg ? '#FFF7F6' : '#FFFFFF'; }
      if (soAlert) soAlert.style.display = sg ? 'block' : 'none';
    }
    paint();
    setInterval(() => { tick++; paint(); }, 900);

    // ask click (stops auto-advance)
    askBtns.forEach((b, i) => b.addEventListener('click', () => { ask = i; askAuto = false; paintAsk(); }));

    // faq
    qa('[data-fb-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-fb-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-fb-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-fb-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // reveal
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

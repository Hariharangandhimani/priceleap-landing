---
// Native Astro port of the design package's "For Brands & Manufacturers" solution page.
// Static initial render + the full 900ms animation loop and interactions reimplemented
// in vanilla JS: hero MAP/MSRP reseller table (cycling ShopLine below-MAP / Kitchen Hub
// stock-out + counters), an auto-advancing "what brands ask" panel switcher (5 panels,
// also clickable, auto-advance stops on click), vs-spreadsheet, unauthorized-seller
// scan, stock-out grid and FAQ. Responsive via CSS media queries.
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';

type Tag = [string, string, string, string];
const tag = (k: string): Tag => (({ ok: ['AT MAP', '#EEF8F1', '#BFE5CC', '#1E7A3D'], above: ['ABOVE MAP', '#FBF3EC', '#EFE3DA', '#3A302A'], below: ['−7% BELOW MAP', '#FDECEB', '#F5C6C3', '#B42318'], unauth: ['UNAUTHORIZED', '#FFF4EC', '#FFD8BE', '#C2410C'], oos: ['OUT OF STOCK', '#FBF3EC', '#EFE3DA', '#665A51'] } as Record<string, Tag>)[k]);

// hero table (tk=0 → hp=0: ShopLine at MAP, Kitchen Hub low)
const heroRaw: [string, string, string, string, string][] = [
  ['Appliance World', 'AW', '$149.00', 'In stock', 'ok'],
  ['ShopLine', 'SL', '$149.00', 'In stock', 'ok'],
  ['Amazon · Aero Store', 'AZ', '$159.00', 'In stock', 'above'],
  ['Kitchen Hub', 'KH', '$149.00', 'Low', 'ok'],
  ['Walmart Marketplace', 'WM', '$152.00', 'In stock', 'above'],
  ['deal-depot-88', 'D8', '$129.00', 'In stock', 'unauth'],
];
const heroRows = heroRaw.map(([n, ab, p, st, k]) => { const [t, tb, tbc, tc] = tag(k); const bad = k === 'below' || k === 'unauth'; return { n, ab, p, tag: t, tb, tbc, tc, s: st, pc: bad ? '#B42318' : '#1C130E', bg: bad ? '#FFFCF9' : '#FFFFFF', sc: st === 'Out' ? '#B42318' : st === 'Low' ? '#C2410C' : '#665A51', sd: st === 'Out' ? '#B42318' : st === 'Low' ? '#F7631E' : '#1E7A3D' }; });

const ASKS: [string, string, string, string][] = [
  ['“Who’s advertising us under MAP?”', 'Each reseller’s price on the same row as your MAP, with a MAP filter on the dashboard', '', 'MAP filter · below MAP'],
  ['“Who’s selling us without our approval?”', 'Sellers outside your authorized list, flagged', '[confirm: how the list is set up]', 'Authorized list check'],
  ['“Which resellers are out of stock?”', 'Stock status for every reseller you track, plus an alert when one runs out', '', 'Reseller stock'],
  ['“Our MAP changes for the holiday promo.”', 'MAP and MSRP per product, each with its own validity period', '', 'MAP & MSRP validity periods'],
  ['“Is our own store breaking policy?”', 'Alerts when your price drops below MAP or goes above MSRP', '', 'Your store vs policy'],
];
const asksInit = ASKS.map(([q, a, cf], i) => { const on = i === 0; return { q, a, cf, cfD: cf ? 'inline' : 'none', on, bb: i < 4 ? '1px solid #F5ECE5' : 'none', bg: on ? '#FFF9F4' : '#FFFFFF', bar: on ? '#F7631E' : 'transparent' }; });

const mapRows = [['Appliance World', '$149.00', 'ok'], ['ShopLine', '$139.00', 'below'], ['Amazon · Aero Store', '$159.00', 'above'], ['deal-depot-88', '$129.00', 'below']].map(([n, p, k], i) => { const [t, tb, tbc, tc] = tag(k); const b = k === 'below'; return { n, p, tag: b ? 'BELOW MAP' : t, tb, tbc, tc, pc: b ? '#B42318' : '#1C130E', bg: b ? '#FFF7F6' : '#FFFFFF', dl: (i * .08).toFixed(2) }; });
const authRows = [['Appliance World', true], ['ShopLine', true], ['deal-depot-88', false], ['Kitchen Hub', true]].map(([n, ok], i) => ({ n, mk: ok ? '✓' : '!', ib: ok ? '#1C130E' : '#F7631E', ic: '#FFFFFF', tag: ok ? 'AUTHORIZED' : 'NOT ON LIST', tc: ok ? '#1E7A3D' : '#C2410C', bc: ok ? '#F5ECE5' : '#FFD8BE', bg: ok ? '#FFFFFF' : '#FFF9F4', dl: (i as number * .08).toFixed(2) }));
// v2 stock (sp=false), v3 periods (pp=false → ALWAYS), v4 own (op=0 → $189 ok)
const stockRowsV2 = [['Appliance World', 'In stock'], ['ShopLine', 'In stock'], ['Kitchen Hub', 'Low stock'], ['Walmart Marketplace', 'In stock']].map(([n, st]) => { const out = st === 'Out of stock', low = st === 'Low stock'; return { n, s: st, sc: out ? '#B42318' : low ? '#C2410C' : '#665A51', sd: out ? '#B42318' : low ? '#F7631E' : '#1E7A3D', bc: out ? '#F5C6C3' : '#EFE3DA', bg: out ? '#FFF7F6' : '#FFFFFF' }; });
const periodsInit = [['MAP', 'Standard $149.00', 'Holiday MAP $129.00', '#F7631E'], ['MSRP', 'Standard $199.00', 'Holiday MSRP $179.00', '#1C130E']].map(([k, std, promo, pb]) => ({ k, std, promo, range: 'ALWAYS', l: 100, w: 0, pb }));

const sheet = [['Appl. World', '$149', '$149', 'Mon'], ['ShopLine', '$149', '$149', 'Mon'], ['Kitchen Hub', '—', '$149', 'not yet']].flat().map((t) => ({ t, c: t === 'not yet' || t === '—' ? '#B42318' : '#3A302A' }));
const authList = ['Appliance World', 'ShopLine', 'Amazon · Aero Store', 'Kitchen Hub'];
// section 04 found (fp=0 → all checking)
const foundRaw: [string, string, boolean][] = [['Appliance World', 'appliance-world.com', true], ['ShopLine', 'Shopify store', true], ['Amazon · Aero Store', 'Amazon', true], ['deal-depot-88', 'Amazon third-party', false], ['bargain.bin.shop', 'eBay', false]];
const foundInit = foundRaw.map(([n, ch]) => ({ n, ch, tag: 'CHECKING…', tb: '#FFFFFF', tbc: '#EFE3DA', tc: '#7F7066', bg: '#FFFFFF' }));
// section 05 stockGrid (sg=false → Kitchen Hub low)
const stockGrid = [['Appliance World', 'In stock', '$149.00'], ['ShopLine', 'In stock', '$149.00'], ['Kitchen Hub', 'Low stock', '$149.00'], ['Amazon · Aero', 'In stock', '$159.00'], ['Walmart Mkt', 'In stock', '$152.00'], ['HomeCart', 'In stock', '$155.00']].map(([n, st, p]) => { const out = st === 'Out of stock', low = st === 'Low stock'; return { n, s: st, p, sc: out ? '#B42318' : low ? '#C2410C' : '#665A51', sd: out ? '#B42318' : low ? '#F7631E' : '#1E7A3D', bc: out ? '#1C130E' : '#EFE3DA', bg: out ? '#FFF7F6' : '#FFFFFF' }; });

const FQ: [string, string][] = [
  ['How do I track the resellers that sell my products?', 'Paste each reseller’s product URL into priceleap.ai, or add it as a competitor on a product you already track. You then see that reseller’s price, stock and price history next to your own. Group products by brand line or channel to keep the weekly review short.'],
  ['Can I set MAP and MSRP for a set period, like a promo window?', 'Yes. Each product has MAP and MSRP fields, and each can carry a validity period, so a promotional MAP applies only during its window. priceleap.ai also alerts you when your own price drops below MAP or rises above MSRP, so your store stays inside the policy you set.'],
  ['Does priceleap.ai check reseller prices against my MAP automatically?', 'The MAP alerts in priceleap.ai apply to your own listings. Reseller prices sit on the same row as your MAP, and the dashboard has a MAP filter, so a reseller below MAP is easy to spot in a review. MAP policy in depth lives on the MAP Monitoring page.'],
  ['Can I track resellers that sell on Amazon and Walmart?', 'Yes. Add the Amazon or Walmart product page for each listing, the same way as any reseller site, and its price and stock show next to your MAP and MSRP. If you sell there too, connecting your seller account brings in your own listings.'],
  ['Does priceleap.ai contact resellers or enforce MAP for us?', 'No. priceleap.ai is software. It shows each reseller’s price next to your MAP, flags sellers you haven’t authorized and tracks stock-outs. Your channel or legal team decides what to do, and can export the data to Google Sheets or Excel to share it.'],
];
const faqs = FQ.map(([q, a], i) => ({ q, a, n: String(i + 1).padStart(2, '0'), open: i === 0 }));
const logoSlots = ['[Logo 1]', '[Logo 2]', '[Logo 3]', '[Logo 4]', '[Logo 5]', '[Logo 6]'];

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FQ.map(([q, a]) => ({ '@type': 'Question', name: q.replace(/’/g, "'"), acceptedAnswer: { '@type': 'Answer', text: a.replace(/’/g, "'") } })),
}];
---
<PriceLeapLayout
  title="Reseller Price Monitoring Software for Brands | priceleap.ai"
  description="See what each reseller charges for your products, next to your MAP and MSRP, and spot sellers you never authorized."
  jsonLd={jsonLd}
>
  <div class="fb" style="min-height:100vh;background:#FFFCF9;overflow-x:clip">

    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.10),transparent);pointer-events:none"></div>
      <div class="fb-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(40px,6vw,84px) clamp(16px,4vw,40px) clamp(48px,6vw,80px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:#665A51"><a href="#" style="color:#665A51">Solutions</a><span style="color:#D7C6BA">›</span><span style="color:#1C130E">For Brands &amp; Manufacturers</span></nav>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>For Brands &amp; Manufacturers</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,5vw,62px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Reseller price monitoring software</span><span style="font-weight:400"> for brands and manufacturers</span></h1>
          <p style="margin:0;max-width:560px;font-size:18px;line-height:1.65;color:#3A302A;text-wrap:pretty">See what each reseller charges for your products, next to your MAP and MSRP, and spot sellers you never authorized.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
            <a href="#monitor" style="height:48px;padding:0 18px;display:inline-flex;align-items:center;border-radius:12px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E;font-family:Geist,sans-serif;font-weight:500;font-size:15px">See how it works →</a>
          </div>
        </div>

        <figure style="margin:0;min-width:0;display:flex;flex-direction:column;gap:10px">
          <div style="position:relative;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 48px 90px -52px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
              <span style="min-width:0"><span style="display:block;font-size:13.5px;font-weight:600;color:#1C130E">Aero 360 Blender · 1.5L</span><span style="display:block;font-family:'Geist Mono',monospace;font-size:10px;color:#7F7066">MAP $149.00 · MSRP $199.00</span></span>
              <span style="display:flex;gap:6px;flex:none"><span style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;background:#1C130E;font-family:'Geist Mono',monospace;font-size:10px;color:#FFFFFF">MAP FILTER</span></span>
            </div>
            <div style="position:relative;overflow-x:auto">
              <span aria-hidden="true" style="position:absolute;left:0;right:0;height:36px;background:linear-gradient(180deg,transparent,rgba(247,99,30,.07),transparent);animation:fb-scan 4s linear infinite;pointer-events:none"></span>
              <div style="min-width:460px">
                <div style="display:grid;grid-template-columns:minmax(0,1.4fr) 84px 74px minmax(0,1.1fr);gap:10px;padding:9px 16px;border-bottom:1px solid #F5ECE5;font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066"><span>RESELLER</span><span>PRICE</span><span>STOCK</span><span>STATUS</span></div>
                {heroRows.map((r, i) => (
                  <div data-fb-hrow={i === 1 ? '1' : i === 3 ? '3' : undefined} style={`display:grid;grid-template-columns:minmax(0,1.4fr) 84px 74px minmax(0,1.1fr);gap:10px;align-items:center;padding:11px 16px;border-bottom:1px solid #F5ECE5;background:${r.bg};transition:background .4s`}>
                    <span style="display:flex;align-items:center;gap:9px;min-width:0"><span style="width:26px;height:26px;flex:none;border-radius:7px;background:#FBF3EC;border:1px solid #EFE3DA;font-family:'Geist Mono',monospace;font-size:9.5px;color:#3A302A;display:flex;align-items:center;justify-content:center">{r.ab}</span><span style="font-size:13px;font-weight:500;color:#1C130E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{r.n}</span></span>
                    <span data-fb-hprice={i === 1 ? '1' : undefined} style={`justify-self:start;padding:1px 5px;border-radius:5px;font-family:'Geist Mono',monospace;font-size:12.5px;color:${r.pc}`}>{r.p}</span>
                    <span style={`display:flex;align-items:center;gap:5px;font-size:11.5px;color:${r.sc}`}><span data-fb-hdot={i === 3 ? '1' : undefined} style={`width:6px;height:6px;border-radius:50%;background:${r.sd}`}></span><span data-fb-hstock={i === 3 ? '1' : undefined}>{r.s}</span></span>
                    <span data-fb-htag={i === 1 ? '1' : i === 3 ? '3' : undefined} style={`justify-self:start;height:22px;padding:0 8px;display:flex;align-items:center;gap:5px;border-radius:6px;background:${r.tb};border:1px solid ${r.tbc};font-family:'Geist Mono',monospace;font-size:9.5px;color:${r.tc};white-space:nowrap`}>{r.tag}</span>
                  </div>
                ))}
              </div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#F5ECE5">
              <div style="background:#FFFFFF;padding:12px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">BELOW MAP</div><div data-fb-nbelow style="margin-top:2px;font-family:Geist,sans-serif;font-size:19px;font-weight:600;color:#B42318">1</div></div>
              <div style="background:#FFFFFF;padding:12px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">UNAUTHORIZED</div><div style="margin-top:2px;font-family:Geist,sans-serif;font-size:19px;font-weight:600;color:#C2410C">1</div></div>
              <div style="background:#FFFFFF;padding:12px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">OUT OF STOCK</div><div data-fb-noos style="margin-top:2px;font-family:Geist,sans-serif;font-size:19px;font-weight:600;color:#1C130E">0</div></div>
            </div>
          </div>
          <figcaption style="font-size:13px;color:#665A51;text-align:center">Reseller prices on the same row as your MAP and MSRP</figcaption>
        </figure>
      </div>
      <div class="fb-logos" style="position:relative;border-top:1px solid #EFE3DA;background:#FFFFFF;display:grid">
        <div class="fb-logolabel" style="padding:20px clamp(16px,4vw,40px);display:flex;align-items:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#665A51">Trusted by brand teams at</div>
        <div class="fb-logogrid" style="display:grid;gap:1px;background:#F5ECE5">
          {logoSlots.map((l) => (<div style="background:#FFFFFF;height:76px;display:flex;align-items:center;justify-content:center"><span style="height:32px;padding:0 14px;display:flex;align-items:center;border-radius:8px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 6px,#FFFCF9 6px 12px);font-family:'Geist Mono',monospace;font-size:10.5px;color:#7F7066">{l}</span></div>))}
        </div>
      </div>
    </section>

    <!-- 02 HOW DO YOU MONITOR -->
    <section id="monitor" style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>One screen</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;max-width:860px;text-wrap:balance"><span style="font-weight:400">How do you monitor what resellers </span><span style="font-weight:700">charge for your products?</span></h2>
          <p style="margin:0;max-width:640px;font-size:16.5px;line-height:1.65;color:#3A302A">Add each reseller's product page once, and priceleap.ai answers these on one screen.</p>
        </div>
        <div data-reveal class="fb-ask" style="margin-top:44px;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;background:#EFE3DA;display:grid;gap:1px">
          <div style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);gap:16px;padding:12px 20px;border-bottom:1px solid #F5ECE5;background:#FFF9F4;font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.1em;color:#7F7066"><span>WHAT BRANDS ASK</span><span class="fb-anshead">WHAT YOU SEE IN PRICELEAP.AI</span></div>
            {asksInit.map((a, i) => (
              <button type="button" data-fb-ask={i} aria-pressed={a.on ? 'true' : 'false'} class="fb-askrow" style={`position:relative;border:none;border-bottom:${a.bb};background:${a.bg};cursor:pointer;text-align:left;display:grid;gap:8px 16px;padding:16px 20px;transition:background .3s`}>
                <span aria-hidden="true" data-fb-askbar style={`position:absolute;left:0;top:0;bottom:0;width:3px;background:${a.bar};transition:background .3s`}></span>
                <span style="font-family:Geist,sans-serif;font-size:15.5px;font-weight:600;line-height:1.4;color:#1C130E">{a.q}</span>
                <span style="font-size:14px;line-height:1.55;color:#3A302A">{a.a}<span style={`display:${a.cfD};font-family:'Geist Mono',monospace;font-size:11px;color:#7F7066`}> {a.cf}</span></span>
              </button>
            ))}
          </div>

          <div style="position:relative;background:#FFF9F4;padding:clamp(18px,2.6vw,28px);display:flex;flex-direction:column;justify-content:center;min-height:400px;overflow:hidden">
            <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(#EFE3DA 1px,transparent 1px);background-size:18px 18px;-webkit-mask-image:radial-gradient(ellipse at 50% 50%,#000 30%,transparent 80%);mask-image:radial-gradient(ellipse at 50% 50%,#000 30%,transparent 80%)"></div>
            <div data-fb-askcard style="position:relative;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:18px;overflow:hidden;box-shadow:0 30px 60px -40px rgba(60,30,15,.4);animation:fb-in .35s ease">
              <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid #F5ECE5;background:#FFF9F4"><span data-fb-asktitle style="font-size:13px;font-weight:600;color:#1C130E">MAP filter · below MAP</span><span style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">EXAMPLE</span></div>

              <div data-fb-askpanel="0" style="padding:6px 0">
                {mapRows.map((r) => (
                  <div style={`display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:12px;align-items:center;padding:10px 14px;background:${r.bg};animation:fb-in .3s ease ${r.dl}s both`}><span style="font-size:13px;color:#1C130E">{r.n}</span><span style={`font-family:'Geist Mono',monospace;font-size:12.5px;color:${r.pc}`}>{r.p}</span><span style={`height:20px;padding:0 7px;display:flex;align-items:center;border-radius:5px;background:${r.tb};border:1px solid ${r.tbc};font-family:'Geist Mono',monospace;font-size:9.5px;color:${r.tc}`}>{r.tag}</span></div>
                ))}
                <div style="margin:6px 14px 8px;padding-top:10px;border-top:1px dashed #EFE3DA;display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10.5px;color:#7F7066"><span>MAP $149.00</span><span>FILTER · BELOW MAP</span></div>
              </div>

              <div data-fb-askpanel="1" hidden style="padding:12px 14px;display:flex;flex-direction:column;gap:8px">
                {authRows.map((r) => (
                  <div style={`display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 12px;border-radius:11px;border:1px solid ${r.bc};background:${r.bg};animation:fb-in .3s ease ${r.dl}s both`}><span style={`width:22px;height:22px;border-radius:50%;background:${r.ib};color:${r.ic};font-size:10px;display:flex;align-items:center;justify-content:center`}>{r.mk}</span><span style="font-size:13px;color:#1C130E">{r.n}</span><span style={`font-family:'Geist Mono',monospace;font-size:9.5px;color:${r.tc}`}>{r.tag}</span></div>
                ))}
              </div>

              <div data-fb-askpanel="2" hidden style="padding:14px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
                {stockRowsV2.map((r, i) => (

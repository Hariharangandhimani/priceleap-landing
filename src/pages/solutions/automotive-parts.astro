  .ap-gcols { grid-template-columns: minmax(0,1fr) auto 30px; }
  .ap-gextra { display: none; }
  @media (min-width: 720px) { .ap-gcols { grid-template-columns: minmax(0,1.5fr) minmax(0,1fr) auto 30px; } .ap-gextra { display: flex; } }
  .ap-pgrid { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .ap-pgrid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  .ap-flow { grid-template-columns: 1fr; }
  .ap-flowline { display: none; }
  @media (min-width: 720px) { .ap-flow { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1024px) { .ap-flow { grid-template-columns: repeat(4,minmax(0,1fr)); } .ap-flowline { display: block; } }
  .ap-ba { grid-template-columns: 1fr; }
  .ap-baarrow { display: none; }
  .ap-barow { min-height: 0; }
  @media (min-width: 1024px) { .ap-ba { grid-template-columns: 1fr 1fr; } .ap-baarrow { display: flex; } .ap-barow { min-height: 108px; } }
  .ap-three { grid-template-columns: 1fr; }
  @media (min-width: 960px) { .ap-three { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  .ap-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .ap-split { grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); } }
  .ap-sticky { position: static; }
  @media (min-width: 1024px) { .ap-sticky { position: sticky; } }

  .ap-faq-n { color: #B9A99C; }
  .ap-faq.is-open .ap-faq-n { color: #C2410C; }
  .ap-faq-ic { background: #FBF3EC; color: #1C130E; transform: rotate(0deg); transition: all .3s; }
  .ap-faq.is-open .ap-faq-ic { background: #1C130E; color: #FFFFFF; transform: rotate(45deg); }
  .ap-faq.is-open { border-color: #FFD8BE; }
  .ap-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .ap-faq.is-open .ap-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .ap *, .ap *::before, .ap *::after { animation: none !important; transition: none !important; } [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.ap') as HTMLElement | null;
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    const CYCLE: [number, string, string][] = [
      [3, 'Manage competitors · 4 sellers suggested', 'M8 12l3 3 5-5'],
      [4, 'ZIP code set · 60614 Chicago', 'M8 12l3 3 5-5'],
      [2, 'Fetching prices for Brake Pads · Ceramic…', 'M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7'],
      [6, 'Rules saved · floor and ceiling per group', 'M8 12l3 3 5-5'],
    ];
    const PLUS = 'M12 5v14M5 12h14';

    // hero refs
    const chips = qa('[data-ap-chip]');
    const g0zip = q('[data-ap-g0zip="1"]'), g0ziptext = q('[data-ap-g0ziptext="1"]'), g0menubtn = q('[data-ap-g0menubtn="1"]');
    const menu = q('[data-ap-menu]'), menuItems = qa('[data-ap-mi]');
    const toast = q('[data-ap-toast]'), toastSvg = q('[data-ap-toastsvg]'), toastPath = q('[data-ap-toastpath]');
    // problem refs
    const pn1lines = qa('[data-ap-pn1line]'), pn1labels = qa('[data-ap-pn1label]');
    const specCells = qa('[data-ap-spec]'), specMarks = qa('[data-ap-specmk]');
    const fit3row = q('[data-ap-fit3row="1"]'), fit3price = q('[data-ap-fit3price="1"]');
    const avgLines = qa('[data-ap-avgline]'), avgTag = q('[data-ap-avgtag]');
    const regBars = qa('[data-ap-regbar="1"]'), regPrices = qa('[data-ap-regprice="1"]'); // only "over" ones
    // flow / why refs
    const flows = qa('[data-ap-flow]'), flowIcons = qa('[data-ap-flowicon]'), flowVals = qa('[data-ap-flowval]');
    const sellers = qa('[data-ap-seller]');
    const spDot = q('[data-ap-spdot]'), spLabel = q('[data-ap-splabel]');
    const alertEl = q('[data-ap-alert]'), alertCh = q('[data-ap-alertch]'), chans = qa('[data-ap-chan]');

    const specBad = [true, true, false];
    const sellerRm = [false, false, true, false];
    const spPosData: [number, string][] = [[50, '$61.20'], [32, '$57.90'], [68, '$64.10']];
    const flowIco = ['#1C130E', '#FFFFFF']; // placeholder not used

    let tick = 0, lastMenuOpen = true;

    function paint() {
      const tk = tick;
      const ph = Math.floor(tk / 3) % 4, step = tk % 3;
      const hiIdx = CYCLE[ph][0], menuOpen = step < 2, zipSet = ph >= 1;
      // chips
      chips.forEach((el, i) => { const on = (ph === 1 && i === 0) || (ph === 2 && i === 2) || ((ph === 0 || ph === 3) && i === 1); el.style.background = on ? '#FFF4EC' : '#FFFFFF'; el.style.borderColor = on ? '#FFD8BE' : '#EFE3DA'; const d = el.querySelector('[data-ap-chipdot]') as HTMLElement | null; if (d) d.style.background = on ? '#F7631E' : '#D7C6BA'; });
      // group 0 zip
      if (g0ziptext) g0ziptext.textContent = zipSet ? '60614' : 'Auto';
      if (g0zip) { const hl = zipSet && ph === 1; g0zip.style.background = hl ? '#FFF4EC' : '#FFFFFF'; g0zip.style.borderColor = hl ? '#FFD8BE' : '#EFE3DA'; g0zip.style.color = zipSet ? '#1C130E' : '#7F7066'; }
      // group 0 menu button + dropdown
      if (g0menubtn) g0menubtn.style.borderColor = menuOpen ? '#F7631E' : '#EFE3DA';
      if (menu) { menu.style.display = menuOpen ? 'block' : 'none'; if (menuOpen && !lastMenuOpen) { menu.style.animation = 'none'; void menu.offsetWidth; menu.style.animation = 'ap-pop .25s ease'; } }
      lastMenuOpen = menuOpen;
      menuItems.forEach((el, i) => { const on = i === hiIdx && step >= 1; const del = i === 7; el.style.background = on ? '#FFF4EC' : 'transparent'; el.style.color = del ? '#B42318' : on ? '#C2410C' : '#1C130E'; const svg = el.querySelector('svg') as SVGElement | null; if (svg) (svg as unknown as HTMLElement).style.color = del ? '#B42318' : on ? '#C2410C' : '#665A51'; });
      // toast
      if (toast) toast.textContent = CYCLE[ph][1];
      if (toastPath) toastPath.setAttribute('d', (step >= 2 || ph === 2) ? CYCLE[ph][2] : PLUS);
      if (toastSvg) toastSvg.style.animation = (ph === 2 && step < 2) ? 'ap-spin 1s linear infinite' : 'none';
      // problem 1 (q1)
      const q1 = tk % 6;
      pn1lines.forEach((el, k) => { el.setAttribute('stroke', k < q1 ? '#F7631E' : '#EFE3DA'); });
      pn1labels.forEach((el, k) => { const on = k < q1; el.style.borderColor = on ? '#FFD8BE' : '#EFE3DA'; el.style.color = on ? '#C2410C' : '#B9A99C'; });
      // problem 2 (q2)
      const q2 = Math.floor(tk / 2) % 2;
      specCells.forEach((el, i) => { const bad = specBad[i]; const show = !!q2 && bad; el.style.background = show ? '#FDECEB' : '#FFFFFF'; el.style.borderColor = show ? '#F5C6C3' : '#EFE3DA'; const mk = specMarks[i]; if (mk) mk.textContent = q2 ? (bad ? '≠' : '=') : ''; });
      // problem 3 (q3)
      const q3 = Math.floor(tk / 3) % 2;
      if (fit3row) fit3row.style.background = q3 ? '#FFF4EC' : '#FFFFFF';
      if (fit3price) fit3price.style.color = q3 ? '#C2410C' : '#1C130E';
      // problem 4 (q4)
      const q4 = Math.floor(tk / 3) % 2;
      regBars.forEach((el) => (el.style.background = q4 ? '#B42318' : '#1C130E'));
      regPrices.forEach((el) => (el.style.color = q4 ? '#B42318' : '#1C130E'));
      avgLines.forEach((el) => (el.style.opacity = q4 ? '1' : '0.35'));
      if (avgTag) { avgTag.textContent = q4 ? 'NATIONAL AVG $58.38 · HIDES 2 OVERPRICED ZIPS' : 'NATIONAL AVG $58.38'; avgTag.style.background = q4 ? '#FDECEB' : '#FFFFFF'; avgTag.style.borderColor = q4 ? '#F5C6C3' : '#EFE3DA'; avgTag.style.color = q4 ? '#B42318' : '#665A51'; }
      // solution flow (fp)
      const fp = tk % 5;
      flows.forEach((el, i) => { const on = fp === i, done = fp > i; el.style.borderColor = on ? '#FFD8BE' : '#EFE3DA'; el.style.boxShadow = on ? '0 24px 48px -30px rgba(247,99,30,.55)' : 'none'; const ic = flowIcons[i]; if (ic) { ic.style.background = on || done ? '#1C130E' : '#FFFFFF'; ic.style.borderColor = on || done ? '#1C130E' : '#EFE3DA'; ic.style.color = on || done ? '#FFFFFF' : '#C2410C'; } const v = flowVals[i]; if (v) v.style.color = on ? '#C2410C' : '#7F7066'; });
      // why sellers (sp2)
      const sp2 = Math.floor(tk / 2) % 4;
      sellers.forEach((el, i) => { const rm = sellerRm[i]; const removed = rm && sp2 >= 2; const kept = !rm && sp2 >= 3; const name = el.querySelector('[data-ap-sellername]') as HTMLElement | null; const t = el.querySelector('[data-ap-sellertag]') as HTMLElement | null; if (t) { t.textContent = removed ? 'REMOVED' : kept ? 'KEPT ✓' : 'SUGGESTED'; t.style.color = removed ? '#B42318' : kept ? '#1E7A3D' : '#6D4AC9'; } if (name) name.style.textDecoration = removed ? 'line-through' : 'none'; el.style.opacity = removed ? '.5' : '1'; el.style.borderColor = removed ? '#F5C6C3' : kept ? '#BFE5CC' : '#EFE3DA'; el.style.background = removed ? '#FFF7F6' : kept ? '#F6FBF7' : '#FFFFFF'; });
      // why smartprice
      const spPos = spPosData[Math.floor(tk / 3) % 3];
      if (spDot) spDot.style.left = spPos[0] + '%';
      if (spLabel) { spLabel.style.left = spPos[0] + '%'; spLabel.textContent = spPos[1]; }
      // why alert + chans
      if (alertEl) alertEl.style.display = (tk % 4 >= 1) ? 'flex' : 'none';
      const ach = Math.floor(tk / 2) % 3;
      if (alertCh) alertCh.textContent = ['EMAIL', 'SLACK', 'IN-APP'][ach];
      chans.forEach((el, i) => { const on = i === ach; el.style.background = on ? '#1C130E' : '#FFFFFF'; el.style.borderColor = on ? '#1C130E' : '#EFE3DA'; el.style.color = on ? '#FFFFFF' : '#3A302A'; });
    }
    paint();
    setInterval(() => { tick++; paint(); }, 1000);

    // faq
    qa('[data-ap-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-ap-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-ap-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-ap-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // reveal
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

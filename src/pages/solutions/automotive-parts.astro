---
// Native Astro port of the design package's "Automotive Parts & Accessories" solution page.
// Static initial render + the full 1s animation loop and interactions reimplemented in
// vanilla JS: hero Product-Groups card (cycling context menu + ZIP toggle + toast),
// four problem demos (part-number fan, spec match, fitment list, regional bars),
// step flow, before/after, "why teams pick us" demos and FAQ. Responsive via CSS media.
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';

const MENU: [string, string, number][] = [
  ['View in Price Intelligence', 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6', 0],
  ['Price history', 'M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 7v5l3 2', 0],
  ['Re-run / Fetch now', 'M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7', 0],
  ['Manage competitors', 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8a4 4 0 1 0 0 8M22 21v-2a4 4 0 0 0-3-3.9', 1],
  ['Set ZIP code', 'M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12zM12 6.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5', 0],
  ['Rename group', 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z', 0],
  ['Edit rules & alerts', 'M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1M15 4v4M9 10v4M17 16v4', 0],
  ['Delete group', 'M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14', 0],
];
const menuItemsInit = MENU.map(([t, ico, ai], i) => ({ t, ico, aiD: ai ? 'inline-flex' : 'none', sepD: i === 3 || i === 7 ? 'block' : 'none', bg: 'transparent', c: i === 7 ? '#B42318' : '#1C130E', ic: i === 7 ? '#B42318' : '#665A51' }));

const gData: [string, string, string, number, number, string][] = [
  ['Brake Pads · Ceramic', 'BP', '#C2410C', 148, 6, 'Auto'],
  ['Tires · All-season', 'TI', '#1C130E', 92, 8, '75201'],
  ['Batteries · AGM', 'BA', '#7F7066', 64, 5, 'Auto'],
  ['Wiper Blades', 'WB', '#B9A99C', 210, 4, 'Auto'],
];
const groupsInit = gData.map(([n, ini, ab, p, c, z], i) => ({ n, ini, ab, p, c, zip: z, act: i === 0, bb: i < 3 ? '1px solid #F5ECE5' : 'none', bg: i === 0 ? '#FFF9F4' : '#FFFFFF', hasZip: z !== 'Auto', zc: z !== 'Auto' ? '#1C130E' : '#7F7066' }));

const chipsInit = ['ZIP code per product group', 'MPN, UPC and GTIN on every product', 'Fetch now before a pricing call']
  .map((t, i) => { const on = i === 1; return { t, bg: on ? '#FFF4EC' : '#FFFFFF', bc: on ? '#FFD8BE' : '#EFE3DA', dot: on ? '#F7631E' : '#D7C6BA' }; });

// problem 1 part-number fan (q1=0 → none lit)
const pn1Init = [['OE 04465-33471', 16], ['OES D1210', 48], ['Brand A · 7921', 80], ['Brand B · CD1210', 112], ['+ 9 more', 144]].map(([t, y]) => ({ t, y, d: 'M96,80 C150,80 150,' + y + ' 196,' + y, lc: '#EFE3DA', bc: '#EFE3DA', c: '#B9A99C' }));
// problem 2 spec match (q2=0 → no marks)
const spec2Init = [['Ceramic', 'Semi-metallic', 1], ['2019 fitment', '2016 fitment', 1], ['Front axle', 'Front axle', 0]].map(([a, b, bad]) => ({ a, b, mk: '', bg: '#FFFFFF', bc: '#EFE3DA', mc: bad ? '#B42318' : '#1E7A3D' }));
// problem 3 fitment list (q3=0)
const fit3Init = [['ValuePad Economy', 'Private label', '$29.99', 'pl'], ['StopRight Basic', 'Private label', '$34.50', 'pl'], ['Your premium set', 'Ceramic · OE equivalent', '$64.99', 'you']].map(([n, t, p, k], i) => ({ n, t, p, k, bb: i < 2 ? '1px solid #F5ECE5' : 'none', bg: '#FFFFFF', tc: k === 'pl' ? '#7F7066' : '#C2410C', pc: '#1C130E' }));
// problem 4 regional bars (q4=0)
const reg4Init = [['60614', 58.40], ['75201', 54.10], ['94103', 61.80], ['10001', 59.20]].map(([z, p]) => ({ z, over: (p as number) > 58.4, p: '$' + (p as number).toFixed(2), w: Math.round(((p as number) - 40) / 25 * 100), c: '#1C130E' }));
const avgX = Math.round((58.38 - 40) / 25 * 100);

// solution flow (fp=0 → step 0 active)
const flowInit = [
  ['01', 'Group parts by line', 'Brake Pads · Ceramic', 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z'],
  ['02', 'Add competitor listings', '6 listings · MPN checked', 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1'],
  ['03', 'Set a ZIP code', '60614 · Chicago', 'M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12zM12 6.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5'],
  ['04', 'Get a price inside your limits', 'SmartPrice $61.20', 'M3 17l6-6 4 4 8-8M15 7h6v6'],
].map(([n, t, v, ico], i) => { const on = i === 0; return { n, t, v, ico, bc: on ? '#FFD8BE' : '#EFE3DA', sh: on ? '0 24px 48px -30px rgba(247,99,30,.55)' : 'none', ib: on ? '#1C130E' : '#FFFFFF', ibc: on ? '#1C130E' : '#EFE3DA', ic: on ? '#FFFFFF' : '#C2410C', vc: on ? '#C2410C' : '#7F7066' }; });

const baRows = [
  ['Matching parts', 'Analysts cross-reference part numbers by hand, and wrong-year or wrong-spec listings slip into the comparison.', 'MPN, UPC and GTIN stored on every product, so a competitor listing is quick to check before it counts.'],
  ['Choosing the competition', 'Private-label listings on the same fitment page drag the reference price down.', 'Each product group has its own competitor set, so economy sellers stay out of a premium line.'],
  ['Regional prices', 'One national price, checked from one location.', 'A ZIP code per product group for location-specific prices.'],
  ['Refresh', 'Fast-moving categories like brakes and tires are repriced long after the market has moved.', 'Prices checked 1 to 3 times a day, plus Fetch now before a pricing call.'],
].map(([k, b, a], i) => ({ k, b, a, bb: i < 3 ? '1px solid #F5ECE5' : 'none' }));

// why: sellers (sp2=0 → all suggested)
const sellersInit = [['AutoZone', 0], ['RockAuto', 0], ['Private-label seller', 1], ['Advance Auto Parts', 0]].map(([n]) => ({ n, tag: 'SUGGESTED', o: '1', td: 'none', bc: '#EFE3DA', bg: '#FFFFFF', tc: '#6D4AC9' }));
const chansInit = ['Email', 'Slack', 'In-app'].map((t, i) => { const on = i === 0; return { t, bg: on ? '#1C130E' : '#FFFFFF', bc: on ? '#1C130E' : '#EFE3DA', c: on ? '#FFFFFF' : '#3A302A' }; });

const FQ: [string, string, boolean?][] = [
  ['Can I compare prices by part number?', 'Every product record stores its MPN, UPC and GTIN, which makes it quick to check that a competitor listing is the same part before you compare prices. For matching in depth, see ', true],
  ['Can I track prices for one region or ZIP code?', 'Yes. Set a ZIP code on a product group and its prices are checked for that location. Run one group per region if your prices differ across markets.'],
  ['How are private-label and economy brands handled?', 'You choose. Each product group has its own competitor set, so leave private-label sellers out of a premium line and keep them in an economy one.'],
  ['What about used, remanufactured and take-off parts?', "Leave those sellers out of the product group's competitor set, so they never count against your new-part price."],
];
const faqs = FQ.map(([q, a, link], i) => ({ q, a, hasLink: !!link, n: '0' + (i + 1), open: i === 0 }));

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Can I compare prices by part number?', acceptedAnswer: { '@type': 'Answer', text: 'Every product record stores its MPN, UPC and GTIN, which makes it quick to check that a competitor listing is the same part before you compare prices. For matching in depth, see Product Matching.' } },
    { '@type': 'Question', name: 'Can I track prices for one region or ZIP code?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Set a ZIP code on a product group and its prices are checked for that location. Run one group per region if your prices differ across markets.' } },
    { '@type': 'Question', name: 'How are private-label and economy brands handled?', acceptedAnswer: { '@type': 'Answer', text: 'You choose. Each product group has its own competitor set, so leave private-label sellers out of a premium line and keep them in an economy one.' } },
    { '@type': 'Question', name: 'What about used, remanufactured and take-off parts?', acceptedAnswer: { '@type': 'Answer', text: "Leave those sellers out of the product group's competitor set, so they never count against your new-part price." } },
  ],
}];
---
<PriceLeapLayout
  title="Auto Parts Price Monitoring Software | priceleap.ai"
  description="Track competitor prices on every part, by region if you need it, with MPN, UPC and GTIN on each product and recommendations you approve. Book a Demo."
  jsonLd={jsonLd}
>
  <div class="ap" style="min-height:100vh;background:#FFFCF9;overflow-x:clip">

    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.10),transparent);pointer-events:none"></div>
      <div class="ap-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(40px,6vw,84px) clamp(16px,4vw,40px) clamp(48px,6vw,88px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:#665A51"><a href="#" style="color:#665A51">Solutions</a><span style="color:#D7C6BA">›</span><a href="#" style="color:#665A51">By Industry</a><span style="color:#D7C6BA">›</span><span style="color:#1C130E">Automotive Parts &amp; Accessories</span></nav>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
            <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>For Automotive Parts &amp; Accessories</span>
            <span style="height:24px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:999px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:12px;color:#1C130E"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2.2"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>Regional pricing by ZIP code</span>
          </div>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,5vw,62px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Price monitoring</span><span style="font-weight:400"> for auto parts and accessories</span></h1>
          <p style="margin:0;max-width:580px;font-size:17.5px;line-height:1.65;color:#3A302A;text-wrap:pretty">priceleap.ai tracks the competitor listings you match to each part, by region if you set a ZIP code, and shows their price and stock next to yours. MPN, UPC and GTIN sit on every product record, so your team can check it's the same part.</p>
          <a href="/book-a-demo" style="align-self:flex-start;height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {chipsInit.map((c) => (<span data-ap-chip style={`height:32px;padding:0 12px;display:flex;align-items:center;gap:8px;border-radius:9px;background:${c.bg};border:1px solid ${c.bc};font-size:13px;color:#1C130E;transition:all .35s`}><span data-ap-chipdot style={`width:6px;height:6px;border-radius:50%;background:${c.dot};transition:background .35s`}></span>{c.t}</span>))}
          </div>
        </div>

        <figure style="margin:0;min-width:0;display:flex;flex-direction:column;gap:10px">
          <div style="position:relative;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:visible;box-shadow:0 48px 90px -52px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4;border-radius:22px 22px 0 0">
              <span style="font-size:13.5px;font-weight:600;color:#1C130E">Product Groups</span>
              <span style="height:28px;padding:0 10px;display:flex;align-items:center;gap:6px;border-radius:8px;background:#1C130E;font-size:12px;color:#FFFFFF">+ New group</span>
            </div>
            <div class="ap-gcols" style="display:grid;gap:10px;padding:9px 16px;border-bottom:1px solid #F5ECE5;font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066"><span>GROUP</span><span class="ap-gextra">COMPETITORS</span><span>LOCATION</span><span></span></div>
            {groupsInit.map((g) => (
              <div class="ap-gcols" style={`position:relative;display:grid;gap:10px;align-items:center;padding:13px 16px;border-bottom:${g.bb};background:${g.bg};transition:background .35s`}>
                <span style="display:flex;align-items:center;gap:10px;min-width:0"><span style={`width:30px;height:30px;flex:none;border-radius:8px;background:${g.ab};color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:10px;display:flex;align-items:center;justify-content:center`}>{g.ini}</span><span style="min-width:0"><span style="display:block;font-size:13px;font-weight:600;color:#1C130E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{g.n}</span><span style="display:block;font-size:11px;color:#7F7066">{g.p} parts</span></span></span>
                <span class="ap-gextra" style="justify-self:start;height:26px;padding:0 9px;align-items:center;gap:6px;border-radius:999px;border:1px solid #EFE3DA;font-size:11.5px;color:#1C130E;white-space:nowrap"><span style="display:flex;gap:2px"><span style="width:6px;height:6px;border-radius:50%;background:#F59E0B"></span><span style="width:6px;height:6px;border-radius:50%;background:#3B82F6"></span><span style="width:6px;height:6px;border-radius:50%;background:#EF4444"></span></span>{g.c} competitors</span>
                <span data-ap-g0zip={g.act ? '1' : undefined} style={`justify-self:start;height:26px;padding:0 9px;display:flex;align-items:center;gap:5px;border-radius:999px;border:1px solid ${g.act ? '#EFE3DA' : '#EFE3DA'};background:#FFFFFF;font-family:'Geist Mono',monospace;font-size:11px;color:${g.zc};white-space:nowrap;transition:all .35s`}><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path></svg><span data-ap-g0ziptext={g.act ? '1' : undefined}>{g.zip}</span></span>
                <span data-ap-g0menubtn={g.act ? '1' : undefined} style={`justify-self:end;width:30px;height:30px;border-radius:8px;border:1px solid ${g.act ? '#F7631E' : '#EFE3DA'};background:#FFFFFF;color:#1C130E;display:flex;align-items:center;justify-content:center;font-size:14px;letter-spacing:1px;transition:border-color .3s`}>⋯</span>
                {g.act && (
                  <div data-ap-menu role="menu" style="position:absolute;right:12px;top:calc(100% - 6px);z-index:5;width:min(250px,calc(100% - 24px));background:#FFFFFF;border:1px solid #EFE3DA;border-radius:14px;box-shadow:0 30px 60px -28px rgba(60,30,15,.45);padding:6px;animation:ap-pop .25s ease">
                    {menuItemsInit.map((m) => (
                      <div><div style={`display:${m.sepD};height:1px;margin:4px 6px;background:#F5ECE5`}></div>
                      <div data-ap-mi role="menuitem" style={`display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:9px;background:${m.bg};font-size:13px;color:${m.c};transition:background .25s`}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style={`flex:none;color:${m.ic}`}><path d={m.ico}></path></svg>
                        <span style="flex:1">{m.t}</span>
                        <span style={`display:${m.aiD};height:18px;padding:0 6px;align-items:center;border-radius:5px;background:#F4F0FF;border:1px solid #DDD3FA;font-family:'Geist Mono',monospace;font-size:9.5px;color:#6D4AC9`}>AI</span>
                      </div></div>
                    ))}
                  </div>
                )}
              </div>
            ))}
            <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-top:1px solid #F5ECE5;background:#FFF9F4;border-radius:0 0 22px 22px;min-height:52px">
              <span style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#1C130E"><span style="width:20px;height:20px;flex:none;border-radius:6px;background:#1C130E;color:#FFFFFF;display:flex;align-items:center;justify-content:center"><svg data-ap-toastsvg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path data-ap-toastpath d="M12 5v14M5 12h14"></path></svg></span><span data-ap-toast>Manage competitors · 4 sellers suggested</span></span>
            </div>
          </div>
          <figcaption style="font-size:13px;color:#665A51;text-align:center">Each product line gets its own competitors, ZIP code and rules</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 PROBLEM -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The problem</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Pricing parts starts with </span><span style="font-weight:700">finding the right part</span></h2>
        </div>
        <div class="ap-pgrid" style="margin-top:48px;border:1px solid #EFE3DA;border-radius:24px;overflow:hidden;background:#EFE3DA;display:grid;gap:1px">
          <div data-reveal style="background:#FFFFFF;display:flex;flex-direction:column;min-width:0">
            <div style="position:relative;height:210px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;padding:20px;display:flex;align-items:center;justify-content:center;overflow:hidden"><div style="position:relative;width:100%;max-width:300px;height:160px">
              <svg aria-hidden="true" viewBox="0 0 300 160" style="position:absolute;inset:0;width:100%;height:100%">
                {pn1Init.map((p) => (<path data-ap-pn1line d={p.d} fill="none" stroke={p.lc} stroke-width="1.5" style="transition:stroke .4s"></path>))}
              </svg>
              <div style="position:absolute;left:0;top:50%;transform:translateY(-50%);width:96px;padding:10px;border-radius:12px;background:#1C130E;color:#FFFFFF;display:flex;flex-direction:column;gap:4px"><span style="font-family:'Geist Mono',monospace;font-size:9px;color:#FB8A2E">ONE PART</span><span style="font-size:12px;font-weight:600;line-height:1.25">Front brake pad set</span></div>
              {pn1Init.map((p) => (<span data-ap-pn1label style={`position:absolute;right:0;top:${p.y}px;transform:translateY(-50%);height:24px;padding:0 8px;display:flex;align-items:center;gap:6px;border-radius:6px;background:#FFFFFF;border:1px solid ${p.bc};font-family:'Geist Mono',monospace;font-size:10px;color:${p.c};white-space:nowrap;transition:all .4s`}>{p.t}</span>))}
            </div></div>
            <div style="padding:24px 26px 28px;display:flex;flex-direction:column;gap:12px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">01</span><p style="margin:0;font-size:16px;line-height:1.6;color:#1C130E;text-wrap:pretty">A single pad set carries an OE number, an OES number and a dozen aftermarket equivalents, each listed by a different seller under a different brand.</p></div>
          </div>
          <div data-reveal style="background:#FFFFFF;display:flex;flex-direction:column;min-width:0">
            <div style="position:relative;height:210px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;padding:20px;display:flex;align-items:center;justify-content:center;overflow:hidden"><div style="width:100%;max-width:300px;display:flex;flex-direction:column;gap:8px">
              <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.06em;color:#7F7066"><span>YOUR PART</span><span>TITLE MATCH</span></div>
              {spec2Init.map((r) => (
                <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px">
                  <span style="height:30px;padding:0 10px;display:flex;align-items:center;border-radius:8px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:12px;color:#1C130E">{r.a}</span>
                  <span data-ap-spec style={`height:30px;padding:0 10px;display:flex;align-items:center;justify-content:space-between;gap:6px;border-radius:8px;background:${r.bg};border:1px solid ${r.bc};font-size:12px;color:#1C130E;transition:all .4s`}>{r.b}<span data-ap-specmk style={`font-family:'Geist Mono',monospace;font-size:11px;color:${r.mc}`}>{r.mk}</span></span>
                </div>
              ))}
            </div></div>

---
// Native Astro port of the design package's "For Drop Shippers" solution page.
// Static initial render + the full 1s animation loop and interactions reimplemented
// in vanilla JS: cycling notification center + Slack card, hero chips, solution
// cost-stack with moving SmartPrice marker, "why teams pick us" demos (paste/track,
// SmartPrice slider, stock-out alert) and a live competitor table + FAQ.
// Responsive via CSS media queries.
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';

const STOCK = 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10';
const PRICE = 'M3 17l6-6 4 4 8-8M15 7h6v6';
const FLOOR = 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z';

// --- notifications (tk=0, nph=0 → oos = TechDeals / Wireless Earbuds Pro) ---
const notifsInit = [
  { t: 'Competitor out of stock', d: 'TechDeals · Wireless Earbuds Pro is out of stock.', ch: 'SLACK · IN-APP', ico: STOCK, time: 'now', bg: '#FFF9F4', ib: '#1C130E', ibc: '#1C130E', ic: '#FFFFFF', dot: '#F7631E', anim: 'ds-flash 1.4s ease', bb: '1px solid #F5ECE5', first: true },
  { t: 'Price drop · Wireless Earbuds Pro', d: 'BudgetBuy dropped to $29.90 (−6%).', ch: 'EMAIL · IN-APP', ico: PRICE, time: '12m', bg: '#FFFFFF', ib: '#FFF4EC', ibc: '#FFD8BE', ic: '#C2410C', dot: '#F7631E', anim: 'none', bb: '1px solid #F5ECE5', first: false },
  { t: 'Below your floor', d: 'SmartPrice held Phone Ring Light at $18.40, above your $17.90 floor.', ch: 'IN-APP', ico: FLOOR, time: '1h', bg: '#FFFFFF', ib: '#FFF4EC', ibc: '#FFD8BE', ic: '#C2410C', dot: 'transparent', anim: 'none', bb: '1px solid #F5ECE5', first: false },
  { t: 'Price drop · Silicone Watch Band', d: 'ShopNova dropped to $7.49 (−4%).', ch: 'SLACK', ico: PRICE, time: '3h', bg: '#FFFFFF', ib: '#FFF4EC', ibc: '#FFD8BE', ic: '#C2410C', dot: 'transparent', anim: 'none', bb: 'none', first: false },
];

const chipsInit = ['Competitor prices and stock', 'Margin floor on your full cost', 'Price recommendations you approve']
  .map((t, i) => { const on = i === 0; return { t, bg: on ? '#FFF4EC' : '#FFFFFF', bc: on ? '#FFD8BE' : '#EFE3DA', dot: on ? '#F7631E' : '#D7C6BA' }; });

const C = (t: string, k: 'n' | 'a' | 'r') => ({ t, ...({ n: { bg: '#FFFFFF', bc: '#EFE3DA', c: '#3A302A' }, a: { bg: '#FFF4EC', bc: '#FFD8BE', c: '#C2410C' }, r: { bg: '#FDECEB', bc: '#F5C6C3', c: '#B42318' } }[k]) });
const problems: [string, string, ReturnType<typeof C>[]][] = [
  ['01', "Every seller sourcing from the same supplier lists the same product under a different title. Competing on the sticker price alone is a race to the supplier's floor.", [C('Same SKU', 'a'), C('7 sellers', 'n'), C('7 titles', 'n')]],
  ['02', "The sticker price is not your margin. Shipping, marketplace commission, payment fees, ad spend and returns land after the sale, and a listing that looks profitable often isn't.", [C('$34.99 sticker', 'n'), C('−$31.20 costs', 'r')]],
  ['03', 'Every new seller on a supplier product pushes the price lower, so a listing that made money last month can lose it this month.', [C('Oct $39.99', 'n'), C('Nov $33.50', 'r')]],
  ["04", "The same SKU sits on Amazon, eBay, Shopify and Etsy with different fees and different competitors, and one flat markup can't be right on all four.", [C('Amazon', 'n'), C('eBay', 'n'), C('Shopify', 'n'), C('Etsy', 'n')]],
];
const problemsInit = problems.map(([n, t, chips], i) => ({ n, t, chips, bb: i < 3 ? '1px solid #F5ECE5' : 'none' }));

// --- solution cost stack (tk=0, cph=0 → priceV 32.9) ---
const costs: [string, number, string, string][] = [['Product cost', 14.2, '#1C130E', '#FFFFFF'], ['Shipping', 4.8, '#665A51', '#FFFFFF'], ['Fees', 4.6, '#B9A99C', '#1C130E'], ['Margin floor', 3.0, '#FFD8BE', '#C2410C']];
const total = 40, used = costs.reduce((a, c) => a + c[1], 0);
const costBars = costs.map(([t, v, bg, c]) => ({ t: (v / total * 100) > 9 ? t : '', w: v / total * 100, bg, c }));
const priceV0 = 32.9;
const costRowsInit = costs.map(([k, v, dot]) => ({ k: k.toUpperCase(), v: '$' + v.toFixed(2), dot })).concat([{ k: 'SMARTPRICE', v: '$' + priceV0.toFixed(2), dot: '#F7631E' }]);
const floorX = used / total * 100, priceX0 = priceV0 / total * 100;

const sellersInit = ['Amazon · TechDeals', 'eBay · BudgetBuy', 'ShopNova store'].map((n) => ({ n, tag: 'PENDING', o: '.45', bc: '#EFE3DA', bg: '#FFFFFF', tc: '#7F7066' }));
const chansInit = ['Slack', 'Email', 'In-app'].map((t, i) => { const on = i === 0; return { t, bg: on ? '#1C130E' : '#FFFFFF', bc: on ? '#1C130E' : '#EFE3DA', c: on ? '#FFFFFF' : '#3A302A' }; });

// --- core competitor table (tk=0, rph=0) ---
const kColors: Record<string, { sb: string; sbc: string; sc: string }> = { g: { sb: '#F6FBF7', sbc: '#BFE5CC', sc: '#1E7A3D' }, r: { sb: '#FDECEB', sbc: '#F5C6C3', sc: '#B42318' }, a: { sb: '#FFF8EB', sbc: '#F4DDAE', sc: '#8A5A00' }, n: { sb: '#FFFFFF', sbc: '#EFE3DA', sc: '#7F7066' } };
const coreRaw: [string, string, string, string, string, number][] = [
  ['You', '$34.99', 'In stock', 'g', '—', 600],
  ['TechDeals', '$33.49', 'In stock', 'g', '2m', 400],
  ['BudgetBuy', '$29.90', 'In stock', 'g', '5m', 400],
  ['ShopNova', '$36.20', 'Low stock', 'a', '9m', 400],
  ['GadgetHub', 'No match', '—', 'n', '—', 400],
];
const coreRowsInit = coreRaw.map(([n, p, st, k, t2, fw], i) => ({ n, p, s: st, t: t2, fw, bb: i < 4 ? '1px solid #F5ECE5' : 'none', bg: i === 0 ? '#FFF9F4' : '#FFFFFF', dot: i === 0 ? '#F7631E' : '#D7C6BA', pc: p === 'No match' ? '#C2410C' : '#1C130E', anim: 'none', ...kColors[k] }));

const FQ: [string, string, string?, string?][] = [
  ["How do I track sellers who list the same product?", "Paste each seller's product URL into a product group, or let priceleap.ai suggest competitors for the group. Their price and stock then show next to yours, with price history from the day tracking starts."],
  ["How are marketplace fees and returns handled?", "Add them to the product as an add-on cost, alongside your product cost. The margin floor sits on that total, so SmartPrice recommendations stay above what the sale actually costs you."],
  ["What if a supplier sets a MAP?", "", "Add the ", " to the product. priceleap.ai warns you before a SmartPrice recommendation would go below it, and alerts you if your own price drops under MAP."],
  ["We sell print-on-demand. Does this apply?", "Yes, for any product with listings you can compare against. Track the closest equivalents to your designs, add your print and shipping cost, and set the floor on that total."],
];
const faqs = FQ.map(([q, a, a1, a2], i) => ({ q, a, a1: a1 || '', a2: a2 || '', hasLink: !!a1, n: '0' + (i + 1), open: i === 0 }));

const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'How do I track sellers who list the same product?', acceptedAnswer: { '@type': 'Answer', text: "Paste each seller's product URL into a product group, or let priceleap.ai suggest competitors for the group. Their price and stock then show next to yours, with price history from the day tracking starts." } },
    { '@type': 'Question', name: 'How are marketplace fees and returns handled?', acceptedAnswer: { '@type': 'Answer', text: 'Add them to the product as an add-on cost, alongside your product cost. The margin floor sits on that total, so SmartPrice recommendations stay above what the sale actually costs you.' } },
    { '@type': 'Question', name: 'What if a supplier sets a MAP?', acceptedAnswer: { '@type': 'Answer', text: 'Add the MAP to the product. priceleap.ai warns you before a SmartPrice recommendation would go below it, and alerts you if your own price drops under MAP.' } },
    { '@type': 'Question', name: 'We sell print-on-demand. Does this apply?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, for any product with listings you can compare against. Track the closest equivalents to your designs, add your print and shipping cost, and set the floor on that total.' } },
  ],
}];
---
<PriceLeapLayout
  title="Dropshipping Price Monitoring Software | priceleap.ai"
  description="Track the sellers on your supplier's products, set a margin floor on your full cost, and get price recommendations you approve. Book a Demo."
  jsonLd={jsonLd}
>
  <div class="ds" style="min-height:100vh;background:#FFFCF9;overflow-x:clip">

    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.10),transparent);pointer-events:none"></div>
      <div class="ds-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(40px,6vw,84px) clamp(16px,4vw,40px) clamp(48px,6vw,88px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:#665A51"><a href="#" style="color:#665A51">Solutions</a><span style="color:#D7C6BA">›</span><a href="#" style="color:#665A51">By Industry</a><span style="color:#D7C6BA">›</span><span style="color:#1C130E">Drop Shippers</span></nav>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
            <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>For Drop Shippers</span>
            <span style="height:24px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:999px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:12px;color:#1C130E"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2.2"><path d="M4 20h16M6 16l4-5 3 3 5-7"></path></svg>Margin floors on every product</span>
          </div>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,5vw,62px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Dropshipping price monitoring that </span><span style="font-weight:700">protects your margin</span></h1>
          <p style="margin:0;max-width:580px;font-size:17.5px;line-height:1.65;color:#3A302A;text-wrap:pretty">Dozens of sellers list the same supplier products you do. priceleap.ai tracks the ones you choose, sets a margin floor on your product cost plus extras like shipping and fees, and recommends a price that stays above it.</p>
          <a href="/book-a-demo" style="align-self:flex-start;height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {chipsInit.map((c) => (
              <span data-ds-chip style={`height:32px;padding:0 12px;display:flex;align-items:center;gap:8px;border-radius:9px;background:${c.bg};border:1px solid ${c.bc};font-size:13px;color:#1C130E;transition:all .35s`}><span data-ds-chipdot style={`width:6px;height:6px;border-radius:50%;background:${c.dot};transition:background .35s`}></span>{c.t}</span>
            ))}
          </div>
        </div>

        <figure style="margin:0;min-width:0;display:flex;flex-direction:column;gap:10px">
          <div class="ds-notif" style="position:relative;display:grid;gap:12px;align-items:start">
            <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 48px 90px -52px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
                <span style="display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:600;color:#1C130E"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1C130E" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21a2 2 0 0 0 4 0"></path></svg>Notifications</span>
                <span data-ds-unread style="height:22px;min-width:22px;padding:0 7px;display:flex;align-items:center;justify-content:center;border-radius:999px;background:#F7631E;font-family:'Geist Mono',monospace;font-size:10.5px;color:#FFFFFF">2</span>
              </div>
              <div style="display:flex;gap:6px;padding:10px 16px;border-bottom:1px solid #F5ECE5"><span style="height:26px;padding:0 10px;display:flex;align-items:center;border-radius:7px;background:#1C130E;font-size:12px;color:#FFFFFF">All</span><span style="height:26px;padding:0 10px;display:flex;align-items:center;border-radius:7px;border:1px solid #EFE3DA;font-size:12px;color:#3A302A">Stock</span><span style="height:26px;padding:0 10px;display:flex;align-items:center;border-radius:7px;border:1px solid #EFE3DA;font-size:12px;color:#3A302A">Price</span></div>
              {notifsInit.map((n) => (
                <div style={`display:grid;grid-template-columns:32px minmax(0,1fr) auto;gap:12px;align-items:start;padding:13px 16px;border-bottom:${n.bb};background:${n.bg};animation:${n.anim}`}>
                  <span style={`width:32px;height:32px;border-radius:9px;background:${n.ib};border:1px solid ${n.ibc};color:${n.ic};display:flex;align-items:center;justify-content:center`}><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={n.ico}></path></svg></span>
                  <span style="min-width:0"><span style="display:block;font-size:13px;font-weight:600;color:#1C130E">{n.t}</span><span data-ds-notifd={n.first ? '1' : undefined} style="display:block;margin-top:2px;font-size:12px;line-height:1.45;color:#665A51">{n.d}</span><span style="display:flex;gap:6px;margin-top:6px"><span style="height:18px;padding:0 6px;display:flex;align-items:center;border-radius:5px;background:#FBF3EC;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">{n.ch}</span></span></span>
                  <span style="display:flex;flex-direction:column;align-items:flex-end;gap:6px"><span style="font-family:'Geist Mono',monospace;font-size:10px;color:#7F7066;white-space:nowrap">{n.time}</span><span style={`width:7px;height:7px;border-radius:50%;background:${n.dot}`}></span></span>
                </div>
              ))}
            </div>
            <div style="align-self:center;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:16px;overflow:hidden;box-shadow:0 30px 60px -36px rgba(60,30,15,.45)">
              <div style="display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1px solid #F5ECE5;background:#FFF9F4"><span style="width:18px;height:18px;border-radius:5px;background:#4A154B;color:#FFFFFF;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center">#</span><span style="font-size:12.5px;font-weight:600;color:#1C130E">pricing-alerts</span><span style="margin-left:auto;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">SLACK</span></div>
              <div data-ds-slackbody style="padding:12px;display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;animation:ds-pop .35s ease">
                <img src="/assets/pl-mark.png" alt="" width="28" height="28" style="width:28px;height:28px;border-radius:7px;object-fit:contain;background:#FFF4EC;padding:4px" />
                <div style="min-width:0"><div style="display:flex;align-items:baseline;gap:6px"><span style="font-size:12.5px;font-weight:700;color:#1C130E">priceleap.ai</span><span style="height:15px;padding:0 4px;display:flex;align-items:center;border-radius:3px;background:#F5ECE5;font-size:9px;color:#665A51">APP</span><span data-ds-slacktime style="font-size:10.5px;color:#7F7066">9:14 AM</span></div>
                  <div style="margin-top:4px;padding:8px 10px;border-left:3px solid #F7631E;border-radius:0 8px 8px 0;background:#FFF9F4;font-size:12px;line-height:1.5;color:#1C130E"><b>Competitor out of stock</b><br /><span data-ds-slackmsg>TechDeals · Wireless Earbuds Pro is out of stock. Your price: in stock.</span></div></div>
              </div>
            </div>
          </div>
          <figcaption style="font-size:13px;color:#665A51;text-align:center">A competitor out-of-stock alert, sent to Slack and kept in the notification center</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 PROBLEM -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div class="ds-split" style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px);gap:clamp(32px,5vw,72px);align-items:start">
        <div data-reveal class="ds-sticky" style="top:96px;display:flex;flex-direction:column;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The problem</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Why dropshipping </span><span style="font-weight:700">margins disappear</span></h2>
        </div>
        <div style="display:flex;flex-direction:column;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;background:#FFFFFF">
          {problemsInit.map((p) => (
            <div data-reveal class="ds-probrow" style={`display:grid;gap:16px 22px;align-items:center;padding:22px clamp(18px,2.4vw,26px);border-bottom:${p.bb}`}>
              <span style="font-family:Geist,sans-serif;font-size:34px;font-weight:600;letter-spacing:-.05em;line-height:1;color:#E2D3C8">{p.n}</span>
              <p style="margin:0;font-size:15.5px;line-height:1.6;color:#1C130E">{p.t}</p>
              <div class="ds-probchips" style="flex-wrap:wrap;gap:5px;justify-content:flex-end">
                {p.chips.map((c) => (<span style={`height:24px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:${c.bg};border:1px solid ${c.bc};font-family:'Geist Mono',monospace;font-size:10.5px;color:${c.c};white-space:nowrap`}>{c.t}</span>))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 SOLUTION -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div style="max-width:1100px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The solution</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Track the sellers,</span><span style="font-weight:400"> set the floor, approve the price</span></h2>
          <p style="margin:0;max-width:720px;font-size:17px;line-height:1.7;color:#3A302A;text-wrap:pretty">Add the listings you compete with, or let priceleap.ai <a href="#" style="font-weight:600">suggest competitors</a> for each product group. Enter your product cost and per-unit extras, set a margin floor and ceiling, and SmartPrice recommends a price that stays inside them.</p>
        </div>
        <div data-reveal style="margin:44px auto 0;max-width:760px;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 40px 80px -52px rgba(60,30,15,.4)">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 18px;border-bottom:1px solid #F5ECE5;background:#FFF9F4"><span style="font-size:13.5px;font-weight:600;color:#1C130E">Wireless earbuds · supplier SKU</span><span style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:#7F7066">EXAMPLE</span></div>
          <div style="padding:22px 18px 18px">
            <div style="position:relative;height:44px;display:flex;border-radius:10px;overflow:hidden;background:#F5ECE5">
              {costBars.map((b) => (<span style={`width:${b.w}%;height:100%;background:${b.bg};border-right:1px solid #FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:10px;color:${b.c};white-space:nowrap;overflow:hidden;transition:width .8s cubic-bezier(.2,.7,.2,1)`}>{b.t}</span>))}
              <span style={`position:absolute;top:-6px;bottom:-6px;left:${floorX}%;width:2px;background:#1C130E;transition:left .8s cubic-bezier(.2,.7,.2,1)`}></span>
              <span data-ds-pricedot style={`position:absolute;top:50%;left:${priceX0}%;width:18px;height:18px;margin:-9px 0 0 -9px;border-radius:50%;background:#F7631E;border:3px solid #FFFFFF;box-shadow:0 0 0 1px #F7631E;transition:left 1s cubic-bezier(.2,.7,.2,1)`}></span>
            </div>
            <div style="position:relative;height:30px;margin-top:8px">
              <span style={`position:absolute;left:${floorX}%;transform:translateX(-50%);font-family:'Geist Mono',monospace;font-size:10px;color:#1C130E;white-space:nowrap;transition:left .8s`}>FLOOR $26.60</span>

    const notif0d = q('[data-ds-notifd="1"]');
    const slackBody = q('[data-ds-slackbody]'), slackTime = q('[data-ds-slacktime]'), slackMsg = q('[data-ds-slackmsg]');
    const priceDot = q('[data-ds-pricedot]'), priceLabel = q('[data-ds-pricelabel]'), costSp = q('[data-ds-costv="1"]');
    const paste = q('[data-ds-paste]'), sellers = qa('[data-ds-seller]');
    const spDot = q('[data-ds-spdot]'), spLabel = q('[data-ds-splabel]');
    const alertEl = q('[data-ds-alert]'), alertCh = q('[data-ds-alertch]'), chans = qa('[data-ds-chan]');
    const rank = q('[data-ds-rank]'), tRow = q('[data-ds-corerow="1"]'), tPrice = q('[data-ds-cprice="1"]'), tStock = q('[data-ds-cstock="1"]');

    let tick = 0, lastNph = 0, lastRph = 0;
    function paint() {
      const tk = tick;
      const nph = Math.floor(tk / 4) % 3;
      const oos = oosData[nph];
      // notification + slack
      if (notif0d) notif0d.textContent = oos[0] + ' · ' + oos[1] + ' is out of stock.';
      if (unread) unread.textContent = String(2 + nph);
      if (slackTime) slackTime.textContent = '9:' + String(14 + nph * 7).padStart(2, '0') + ' AM';
      if (slackMsg) slackMsg.textContent = oos[0] + ' · ' + oos[1] + ' is out of stock. Your price: in stock.';
      if (nph !== lastNph) { lastNph = nph; if (slackBody) { slackBody.style.animation = 'none'; void slackBody.offsetWidth; slackBody.style.animation = 'ds-pop .35s ease'; } }
      // chips highlight (nph)
      chips.forEach((el, i) => { const on = i === nph; el.style.background = on ? '#FFF4EC' : '#FFFFFF'; el.style.borderColor = on ? '#FFD8BE' : '#EFE3DA'; const d = el.querySelector('[data-ds-chipdot]') as HTMLElement | null; if (d) d.style.background = on ? '#F7631E' : '#D7C6BA'; });
      // solution SmartPrice marker (cph)
      const cph = Math.floor(tk / 3) % 2, priceV = cph ? 30.4 : 32.9, priceX = priceV / total * 100;
      if (priceDot) priceDot.style.left = priceX + '%';
      if (priceLabel) { priceLabel.style.left = priceX + '%'; priceLabel.textContent = 'SMARTPRICE $' + priceV.toFixed(2); }
      if (costSp) costSp.textContent = '$' + priceV.toFixed(2);
      // paste url
      if (paste) paste.textContent = urls[Math.floor(tk / 2) % 3];
      // sellers tracked progressive (up)
      const up = Math.floor(tk / 2) % 4;
      sellers.forEach((el, i) => { const on = i < up; const tag = el.querySelector('[data-ds-stag]') as HTMLElement | null; if (tag) { tag.textContent = on ? 'TRACKED ✓' : 'PENDING'; tag.style.color = on ? '#1E7A3D' : '#7F7066'; } el.style.opacity = on ? '1' : '.45'; el.style.borderColor = on ? '#BFE5CC' : '#EFE3DA'; el.style.background = on ? '#F6FBF7' : '#FFFFFF'; });
      // why-2 smartprice slider
      const spPos = spPosData[Math.floor(tk / 3) % 3];
      if (spDot) spDot.style.left = spPos[0] + '%';
      if (spLabel) { spLabel.style.left = spPos[0] + '%'; spLabel.textContent = spPos[1]; }
      // why-3 alert + chans
      if (alertEl) alertEl.style.display = (tk % 4 >= 1) ? 'flex' : 'none';
      const ach = Math.floor(tk / 2) % 3;
      if (alertCh) alertCh.textContent = ['SLACK', 'EMAIL', 'IN-APP'][ach];
      chans.forEach((el, i) => { const on = i === ach; el.style.background = on ? '#1C130E' : '#FFFFFF'; el.style.borderColor = on ? '#1C130E' : '#EFE3DA'; el.style.color = on ? '#FFFFFF' : '#3A302A'; });
      // core table TechDeals row (rph)
      const rph = Math.floor(tk / 4) % 2;
      if (rank) rank.textContent = rph ? '#2 of 4' : '#3 of 5';
      if (rph !== lastRph) {
        lastRph = rph;
        if (tRow) tRow.style.background = (rph ? '#FFF7F6' : '#FFFFFF');
        if (tPrice) { tPrice.textContent = rph ? '—' : '$33.49'; tPrice.style.animation = 'none'; if (rph) { void tPrice.offsetWidth; tPrice.style.animation = 'ds-flash 1.2s ease'; } }
        if (tStock) { tStock.textContent = rph ? 'Out of stock' : 'In stock'; const col = rph ? { sb: '#FDECEB', sbc: '#F5C6C3', sc: '#B42318' } : { sb: '#F6FBF7', sbc: '#BFE5CC', sc: '#1E7A3D' }; tStock.style.background = col.sb; tStock.style.borderColor = col.sbc; tStock.style.color = col.sc; }
      }
    }
    paint();
    setInterval(() => { tick++; paint(); }, 1000);

    // ---- faq ----
    qa('[data-ds-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-ds-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-ds-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-ds-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

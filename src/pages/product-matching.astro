---
// Native Astro port of the design package's Product Matching page.
// Static initial render + the full 300ms animation loop and interactions
// reimplemented in vanilla JS: hero match-evidence demo (signals light up, confidence
// bar, bundle flag, confirm state), shuffling "manual matching" sheet grid, auto-advancing
// How-it-works stepper with 5 panels (incl. live track-toggle, review-queue + threshold),
// a no-match fix demo, animated coverage bars, and FAQ. Responsive via CSS media queries.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const C = { amz: '#F59E0B', bb: '#3B82F6', ne: '#8B5CF6', wmt: '#2563EB', tgt: '#EF4444' };
const sigNames = ['Identifiers', 'Title', 'Image', 'Specs', 'Pack and variant'];
const stepData = [
  ['Add your products and identifiers', 'Paste product URLs, upload a file or connect a catalog. Titles and specs are parsed into brand, model, MPN, GTIN, color, size and pack count.', 'Product Info', 'IDENTIFIERS'],
  ['Find the competitor listings', 'Let AI find competing products for the group, or assign the competitor domains and URLs you already track. Each product can switch between the two later.', 'Add Products', 'TRACKING'],
  ['Score every candidate', "Matching starts with identifiers where they're published, then weighs brand, model, specs, title text and images where they're not. Each candidate gets a confidence score showing which signals agreed and which didn't.", 'Candidate scoring', 'EXAMPLE'],
  ['Keep variants, bundles and multipacks apart', 'Pack count, condition and variant attributes are compared on every candidate. A two-pack, a bundle or a refurbished unit is flagged, never merged into your single-unit price.', 'Variant flags', 'EXAMPLE'],
  ['Set a threshold and review the rest', 'Set the confidence threshold once. Matches above it flow into pricing, and the rest go to a review queue for your team to confirm or reject.', 'Review queue', 'EXAMPLE'],
].map(([t, d, pt, pk], i) => ({ t, d, no: '0' + (i + 1), pt, pk }));
const infoFields = [['SKU', 'HD9650/96', 1], ['UPC', '075020071125', 1], ['GTIN', '8710103796360', 1], ['MPN', 'HD9650/96', 1], ['BRAND', 'Philips', 0], ['MODEL', 'Airfryer XXL', 0], ['COLOR', 'Black', 0], ['SIZE', '7.3 qt', 0], ['PACK COUNT', '1', 0], ['STATUS', '● active', 0]].map(([k, v, id], i) => ({ k, v, bg: id ? '#FFF9F4' : '#FFFFFF', bc: id ? '#FFD8BE' : '#F5ECE5', c: k === 'STATUS' ? '#1E7A3D' : '#1C130E', dl: (i * 0.06).toFixed(2) }));
const trackOpts = [['Find & monitor competitors', 'AI discovers competing products and tracks pricing and strategy for the group above.', 'AI POWERED', '#C2410C', '#FFD8BE'], ['Track prices for your product URLs', "Monitors your product URLs and lets you assign competitor domains or URLs per product whenever you're ready.", 'SAVE CREDITS', '#1E7A3D', '#BFE5CC']].map(([t, d, tag, tagC, tagBc]) => ({ t, d, tag, tagC, tagBc }));
const multiSig = [['Identifier (GTIN)', 'agrees', '#1E7A3D'], ['Specs', 'agrees', '#1E7A3D'], ['Title text', 'agrees', '#1E7A3D'], ['Pack count', '1 ≠ 2', '#B42318']].map(([t, v, c], i) => ({ t, v, c, dl: (i * 0.12).toFixed(2) }));
const variantFlags = [['Listing · same model, 2-pack', 'Pack count differs'], ['Listing · with travel case', 'Bundle differs'], ['Listing · renewed', 'Condition differs']].map(([t, f], i) => ({ t, f, dl: (i * 0.15).toFixed(2) }));
const queue = [['pack count differs', 'Review'], ['brand unresolved', 'Review'], ['condition differs', 'Reject']].map(([t, b]) => ({ t, b, rej: b === 'Reject' }));
const nmStatic = [
  { n: 'Logitech MX Master 3S', p: '$99.99', pos: 'Competitive', posC: '#1E7A3D', comps: [['Amazon', C.amz, '$99.99'], ['Best Buy', C.bb, '$109.99'], ['Newegg', C.ne, 'No match']] },
  { n: 'Anker 737 Power Bank', p: '$89.99', pos: 'Premium', posC: '#C2410C', comps: [['Amazon', C.amz, '$79.99'], ['Target', C.tgt, 'No match'], ['Walmart', C.wmt, '$84.99']] },
];
const coverage = [['Kitchen_Appliances', 72, '13 / 18 slots'], ['TV_Weekly_Promo', 54, '9 / 15 slots'], ['Laptops_BackToSchool', 88, '22 / 25 slots']].map(([n, wv, slots]) => ({ n, wv, slots }));
const checklist = ['It should use identifiers when they exist and still match when they don\'t.', 'Look for a reason behind every match, such as a score and the signals behind it.', 'Pack sizes, bundles and refurbished listings need to be caught before they distort your prices.', 'Your team should be able to set the bar for auto-acceptance and fix matches without raising a ticket.', 'Ask how long setup takes before the first trustworthy matches arrive.'].map((t, i, a) => ({ t, n: '0' + (i + 1), last: i === a.length - 1 }));
const uses = [['Price comparison', 'Compare prices across sellers for the exact same item.', '#', 'M4 4h6v16H4zM14 4h6v16h-6z'], ['Competitor tracking', 'Track the retailers and marketplaces you choose.', '/competitive-data', 'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6'], ['MAP monitoring', 'MAP and MSRP violations are flagged against the right product.', '#', 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z'], ['Pricing Decision Engine', 'Pricing rules use matched prices as their benchmark. SmartPrice is a recommendation, and your team decides.', '/dynamic-pricing-software', 'M6 3v12M18 9a3 3 0 1 0 0-6a3 3 0 1 0 0 6M6 21a3 3 0 1 0 0-6a3 3 0 1 0 0 6M18 9c0 6-12 3-12 9'], ['Price alerts', 'Alerts for competitor price drops and out-of-stock listings.', '#', 'M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21a2 2 0 0 0 4 0']].map(([t, d, href, ico]) => ({ t, d, href, ico }));
const teamDoes = [['01', 'Adds products'], ['02', 'Sets the confidence threshold'], ['03', 'Works the review queue'], ['04', 'Fixes gaps in the dashboard']].map(([n, t]) => ({ n, t }));
const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logos = [...brandLogos, ...brandLogos];
const fq = [
  ['What is product matching in ecommerce?', 'Product matching in ecommerce means linking a product in your catalog to the listings on other sites and marketplaces that sell the same item. It is the step that makes competitor price comparison valid, because a price is only useful if it belongs to the same product, pack size and condition. Read the full definition in the', true],
  ['Do you need GTINs or UPCs to match products?', "No. Matching uses identifiers where they're published, then weighs brand, model, specs, title text and images where they're not. Each candidate gets a confidence score showing which signals agreed.", false],
  ['How are bundles, multipacks and variants handled?', 'Pack count, condition and variant attributes are compared on every candidate. A two-pack, a bundle or a refurbished unit is flagged, never merged into your single-unit price.', false],
  ['Can we review and correct matches?', 'Yes. Set the confidence threshold once; matches below it go to a review queue for your team to confirm or reject. You can also add the right listing by URL from the product page or the dashboard.', false],
  ["How accurate is PriceLeap's product matching?", 'Accuracy is visible one match at a time, through the confidence score and its signals. Low-confidence candidates wait in review, and matches pass QC checks before they count, backed by an SLA of [X% maximum false positives].', false],
  ['How is product matching priced?', 'Product matching runs inside the Price Intelligence Engine and is part of PriceLeap plans. Larger catalogs can request a custom proposal.', false],
].map(([q, a, link], i) => ({ q, a, link, n: String(i + 1).padStart(2, '0') }));
---
<PriceLeapLayout
  title="Product Matching Software for Competitor Pricing · PriceLeap"
  description="PriceLeap's product matching links each product in your catalog to the same product on competitor sites, even when titles, pack sizes and identifiers don't agree — every match with a confidence score."
>
  <div class="pm">
    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 65% 75% at 78% 40%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-25%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.09),transparent);pointer-events:none"></div>
      <div class="pm-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(36px,5vw,72px) clamp(16px,4vw,40px) clamp(48px,6vw,88px);gap:clamp(36px,4.5vw,64px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:20px">
          <nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:13px;color:#665A51"><a href="#" style="color:#665A51">Product</a><span style="color:#D7C6BA">›</span><a href="/price-intelligence-engine" style="color:#665A51">Price Intelligence</a><span style="color:#D7C6BA">›</span><span style="color:#1C130E">Product Matching</span></nav>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>Product matching</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(36px,5vw,64px);line-height:1.03;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Product Matching Software</span><span style="font-weight:400"> for Competitor Pricing</span></h1>
          <p style="margin:0;max-width:600px;font-size:18px;line-height:1.6;color:#3A302A;text-wrap:pretty">PriceLeap's product matching links each product in your catalog to the same product on competitor sites and marketplaces, even when titles, pack sizes and identifiers don't agree. Every match carries a confidence score and the signals behind it, so the prices you compare are like for like.</p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
            <a href="/contact" style="height:48px;padding:0 18px;display:inline-flex;align-items:center;border-radius:12px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E;font-family:Geist,sans-serif;font-weight:500;font-size:15px">Talk to a matching expert →</a>
          </div>
        </div>

        <div style="position:relative;min-width:0;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 44px 84px -50px rgba(60,30,15,.42),0 0 0 6px rgba(255,255,255,.7)">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
            <span style="font-size:13.5px;font-weight:600;color:#1C130E">Match evidence</span>
            <span style="height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;border:1px dashed #E2D3C8;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:#7F7066">EXAMPLE</span>
          </div>
          <div class="pm-ev" style="position:relative;padding:16px;gap:0;align-items:stretch">
            <div style="border:1px solid #EFE3DA;border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:8px">
              <span style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">YOUR PRODUCT</span>
              <div style="height:70px;border-radius:9px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 6px,#FFFCF9 6px 12px);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">image</div>
              <span style="font-size:13px;font-weight:600;color:#1C130E">Product title</span>
              <span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:#665A51">SKU · GTIN</span>
              <span style="font-family:'Geist Mono',monospace;font-size:12px;color:#1C130E">[price]</span>
            </div>
            <div aria-hidden="true" class="pm-evarrow" style="display:flex;align-items:center;justify-content:center">
              <svg class="pm-evarrow-h" width="54" height="20" viewBox="0 0 54 20" style="overflow:visible"><path d="M0,10 L54,10" fill="none" stroke="#E2D3C8" stroke-width="1.5"></path><path d="M0,10 L54,10" fill="none" stroke="#F7631E" stroke-width="1.5" stroke-dasharray="4 8" style="animation:pm-dash 1s linear infinite"></path></svg>
              <svg class="pm-evarrow-v" width="20" height="32" viewBox="0 0 20 32" style="overflow:visible"><path d="M10,0 L10,32" fill="none" stroke="#E2D3C8" stroke-width="1.5"></path><path d="M10,0 L10,32" fill="none" stroke="#F7631E" stroke-width="1.5" stroke-dasharray="4 8" style="animation:pm-dash 1s linear infinite"></path></svg>
            </div>
            <div data-pm-compbc style="border:1px solid #EFE3DA;border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:8px;transition:border-color .4s">
              <span style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">COMPETITOR LISTING</span>
              <div style="height:70px;border-radius:9px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 6px,#FFFCF9 6px 12px);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">image</div>
              <span style="font-size:13px;font-weight:600;color:#1C130E">Listing title</span>
              <span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:#665A51">MPN</span>
              <span style="font-family:'Geist Mono',monospace;font-size:12px;color:#1C130E">[price]</span>
            </div>
          </div>
          <div class="pm-sig" style="padding:0 16px 16px;gap:12px">
            <div style="border:1px solid #F5ECE5;border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:8px">
              {sigNames.map((t, i) => (
                <div class="pm-sigrow" data-pm-sig={i} style="display:flex;align-items:center;gap:10px;font-size:13px;color:#7F7066;transition:color .3s">
                  <span class="pm-sigmk" style="width:18px;height:18px;flex:none;border-radius:50%;background:#FFFFFF;border:1.5px solid #E2D3C8;color:#FFFFFF;font-size:9px;display:flex;align-items:center;justify-content:center;transition:all .3s"></span>{t}
                  <span class="pm-sigstat" style="margin-left:auto;font-family:'Geist Mono',monospace;font-size:10px;color:#B9A99C">checking</span>
                </div>
              ))}
            </div>
            <div style="border:1px solid #F5ECE5;border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px">
              <span style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">CONFIDENCE SCORE</span>
              <span style="font-family:Geist,sans-serif;font-size:30px;font-weight:600;letter-spacing:-.03em;color:#1C130E">[XX%]</span>
              <div style="height:6px;border-radius:6px;background:#F5ECE5"><div data-pm-conf style="height:100%;width:0%;border-radius:6px;background:#1C130E;transition:width .5s ease"></div></div>
              <span data-pm-bundle style="align-self:flex-start;height:22px;padding:0 8px;display:flex;align-items:center;gap:6px;border-radius:6px;background:#FFFFFF;border:1px solid #EFE3DA;font-family:'Geist Mono',monospace;font-size:10px;color:#7F7066;transition:all .3s">⚑ Bundle flag</span>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 16px;border-top:1px solid #F5ECE5;background:#FFF9F4">
            <span data-pm-ok style="height:38px;display:flex;align-items:center;justify-content:center;border-radius:10px;background:#FFFFFF;color:#1C130E;border:1px solid #EFE3DA;font-size:13px;font-weight:500;transition:all .3s">Confirm match</span>
            <span style="height:38px;display:flex;align-items:center;justify-content:center;border-radius:10px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E;font-size:13px;font-weight:500">Not a match</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 WHY IT MATTERS -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="max-width:820px;display:flex;flex-direction:column;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>Why it matters</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Why does product matching matter for </span><span style="font-weight:700">competitor pricing?</span></h2>
        </div>
        <div data-reveal class="pm-three" style="margin-top:44px;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;background:#EFE3DA;gap:1px">
          <div style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="height:160px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;display:flex;align-items:center;justify-content:center;padding:18px">
              <div style="width:min(100%,260px);display:flex;flex-direction:column;gap:6px;font-size:12px">
                <span style="padding:7px 10px;border-radius:8px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E">Philips Airfryer XXL HD9650/96</span>
                <span style="padding:7px 10px;border-radius:8px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E">PHILIPS XXL Air Fryer Blk 7.3QT</span>
                <span style="padding:7px 10px;border-radius:8px;border:1px dashed #E2D3C8;background:#FFFFFF;color:#665A51">Airfryer XXL (no GTIN listed)</span>
              </div>
            </div>
            <div style="padding:24px;display:flex;gap:14px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">01</span><p style="margin:0;font-size:15.5px;line-height:1.6;color:#1C130E">The same product is listed differently on every site. Titles, abbreviations, pack sizes and colorways change, and many marketplace listings carry no shared identifier.</p></div>
          </div>
          <div style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="height:160px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;display:flex;align-items:center;justify-content:center;padding:18px">
              <div style="width:min(100%,260px);display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center">
                <span style="padding:10px;border-radius:10px;border:1px solid #EFE3DA;background:#FFFFFF;text-align:center"><span style="display:block;font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">YOU</span><span style="display:block;font-size:13px;font-weight:600;color:#1C130E">1 unit</span></span>
                <span style="font-family:'Geist Mono',monospace;font-size:14px;color:#B42318">≠</span>
                <span style="padding:10px;border-radius:10px;border:1px solid #F5C6C3;background:#FDECEB;text-align:center"><span style="display:block;font-family:'Geist Mono',monospace;font-size:9.5px;color:#B42318">RIVAL</span><span style="display:block;font-size:13px;font-weight:600;color:#1C130E">2-pack</span></span>
                <span style="grid-column:1 / -1;text-align:center;font-family:'Geist Mono',monospace;font-size:10.5px;color:#B42318">↓ price cut you didn't need</span>
              </div>
            </div>
            <div style="padding:24px;display:flex;gap:14px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">02</span><p style="margin:0;font-size:15.5px;line-height:1.6;color:#1C130E">A wrong match is worse than no match. Compare your single unit with a rival's two-pack and you cut price on a product you were never losing.</p></div>
          </div>
          <div style="background:#FFFFFF;display:flex;flex-direction:column">
            <div style="height:160px;border-bottom:1px solid #F5ECE5;background:#FFFCF9;display:flex;align-items:center;justify-content:center;padding:18px">
              <div style="width:min(100%,260px);display:grid;grid-template-columns:repeat(8,1fr);gap:3px">
                {Array.from({ length: 40 }, (_, i) => (<span class="pm-cell" data-pm-cell={i} style="height:14px;border-radius:2px;background:#F5ECE5;transition:background .4s"></span>))}
              </div>
            </div>
            <div style="padding:24px;display:flex;gap:14px"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:#C2410C">03</span><p style="margin:0;font-size:15.5px;line-height:1.6;color:#1C130E">Manual matching breaks as the catalog grows. Thousands of SKUs across many sites, changing every week, outgrow a spreadsheet fast.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 HOW IT WORKS (stepper + 5 panels) -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>How it works</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">How does product matching </span><span style="font-weight:700">work in PriceLeap?</span></h2>
          <p style="margin:0;max-width:680px;font-size:16.5px;line-height:1.65;color:#3A302A">Product matching runs inside the <a href="/price-intelligence-engine" style="font-weight:600">Price Intelligence Engine</a>, one product group at a time. Every step happens in the dashboard.</p>
        </div>
        <div data-reveal class="pm-how" style="margin-top:48px;gap:clamp(20px,3vw,36px);align-items:start">
          <div style="display:flex;flex-direction:column">
            {stepData.map((s, i) => (
              <button type="button" class="pm-step" class:list={[{ 'is-on': i === 0 }]} data-pm-step={i} aria-pressed={i === 0 ? 'true' : 'false'} style="position:relative;text-align:left;border:none;background:transparent;border-radius:16px;padding:16px 16px 16px 14px;display:grid;grid-template-columns:36px minmax(0,1fr);gap:14px;cursor:pointer;transition:background .3s">
                {i < 4 && <span aria-hidden="true" class="pm-step-line" style="position:absolute;left:31px;top:54px;bottom:-14px;width:2px;background:#EFE3DA;transition:background .3s"></span>}

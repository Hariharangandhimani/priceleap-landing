<script>
  const root = document.querySelector('.pm');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---- hero match-evidence demo ----
    const sigRows = qa('[data-pm-sig]'), conf = q('[data-pm-conf]'), bundle = q('[data-pm-bundle]'), compbc = q('[data-pm-compbc]'), ok = q('[data-pm-ok]');
    const paintHero = (tk: number) => {
      const evPhase = tk % 22, nSig = Math.min(5, Math.max(0, evPhase - 2)), done = nSig >= 5, bundleOn = evPhase >= 4 && evPhase < 10;
      sigRows.forEach((row, i) => {
        const okk = i < nSig;
        const mk = row.querySelector('.pm-sigmk') as HTMLElement, stat = row.querySelector('.pm-sigstat') as HTMLElement;
        if (mk) { mk.textContent = okk ? '✓' : ''; mk.style.background = okk ? '#1C130E' : '#FFFFFF'; mk.style.borderColor = okk ? '#1C130E' : '#E2D3C8'; }
        row.style.color = okk ? '#1C130E' : '#7F7066';
        if (stat) { stat.textContent = okk ? 'agrees' : 'checking'; stat.style.color = okk ? '#1E7A3D' : '#B9A99C'; }
      });
      if (conf) conf.style.width = (nSig * 20) + '%';
      if (bundle) { bundle.style.background = bundleOn ? '#FFF4EC' : '#FFFFFF'; bundle.style.borderColor = bundleOn ? '#FFD8BE' : '#EFE3DA'; bundle.style.color = bundleOn ? '#C2410C' : '#7F7066'; }
      if (compbc) compbc.style.borderColor = done ? '#1C130E' : '#EFE3DA';
      if (ok) { ok.style.background = done ? '#1C130E' : '#FFFFFF'; ok.style.color = done ? '#FFFFFF' : '#1C130E'; ok.style.borderColor = done ? '#1C130E' : '#EFE3DA'; }
    };

    // ---- manual-matching sheet grid ----
    const cells = qa('[data-pm-cell]');
    const paintCells = (tk: number) => {
      cells.forEach((el, i) => { const v = (i * 37 + Math.floor(tk / 3) * 11) % 40; el.style.background = v < 4 ? '#FDECEB' : v < 9 ? '#FFE9D9' : '#F5ECE5'; });
    };

    // ---- no-match fix demo ----
    const nmRow = q('[data-pm-nmrow]'), nmPos = q('[data-pm-nmpos]'), nmPrice = q('[data-pm-nmprice]'), nmAdd = q('[data-pm-nmadd]');
    const paintNm = (tk: number) => {
      const nmPh = Math.floor(tk / 6) % 4, fixed = nmPh >= 2;
      if (nmRow) nmRow.style.background = (nmPh === 1 || nmPh === 2) ? '#FFF9F4' : '#FFFFFF';
      if (nmPos) { nmPos.textContent = fixed ? 'Competitive' : 'Unknown'; nmPos.style.color = fixed ? '#1E7A3D' : '#665A51'; }
      if (nmPrice) { nmPrice.textContent = fixed ? '$328.00' : 'No match'; nmPrice.style.color = fixed ? '#1C130E' : '#C2410C'; nmPrice.style.animation = nmPh === 2 ? 'pm-flash 1.2s ease' : 'none'; }
      if (nmAdd) {
        nmAdd.textContent = nmPh === 1 ? '+ amazon.com/dp/B09XS7…' : '+ add';
        nmAdd.style.borderColor = nmPh === 1 ? '#F7631E' : '#EFE3DA'; nmAdd.style.background = nmPh === 1 ? '#FFF4EC' : '#FFFFFF'; nmAdd.style.color = nmPh === 1 ? '#C2410C' : '#7F7066';
      }
    };

    // ---- coverage bars ----
    const covs = qa('[data-pm-cov]');
    const paintCov = (tk: number) => {
      const covPh = Math.floor(tk / 12) % 2;
      covs.forEach((el) => { const wv = Number(el.getAttribute('data-pm-cov')); el.style.width = (covPh ? wv : Math.max(10, wv - 18)) + '%'; });
    };

    // ---- stepper (track toggle, queue, threshold are inside panels) ----
    const steps = qa('[data-pm-step]'), panels3 = qa('[data-pm-panel]'), fills = qa('.pm-step-fill');
    let step = 0, sp = 0, stepAuto = true;
    const paintSteps = () => {
      steps.forEach((el, i) => {
        el.classList.toggle('is-on', i === step); el.classList.toggle('is-done', i < step);
        el.setAttribute('aria-pressed', String(i === step));
        const n = el.querySelector('.pm-step-n') as HTMLElement; if (n) n.textContent = i < step ? '✓' : String(i + 1);
      });
      panels3.forEach((pnl, i) => (pnl.style.display = i === step ? (i === 0 ? 'grid' : (i === 2 ? 'block' : 'flex')) : 'none'));
      const pt = q('[data-pm-ptitle]'), pk = q('[data-pm-pkey]');
      const meta = [['Product Info', 'IDENTIFIERS'], ['Add Products', 'TRACKING'], ['Candidate scoring', 'EXAMPLE'], ['Variant flags', 'EXAMPLE'], ['Review queue', 'EXAMPLE']];
      if (pt) pt.textContent = meta[step][0]; if (pk) pk.textContent = meta[step][1];
      fills.forEach((f, i) => (f.style.width = (i === step ? (stepAuto ? sp : 100) : 0) + '%'));
    };
    steps.forEach((el, i) => el.addEventListener('click', () => { step = i; sp = 0; stepAuto = false; paintSteps(); }));
    const paintPanelAnims = (tk: number) => {
      // track toggle (panel 1)
      const tPh = Math.floor(tk / 8) % 2;
      qa('[data-pm-track]').forEach((el, i) => el.classList.toggle('is-on', i === tPh));
      // queue highlight (panel 4)
      const qPh = Math.floor(tk / 5) % 4;
      qa('[data-pm-qrow]').forEach((row, i) => {
        const act = qPh === i + 1, rej = row.getAttribute('data-rej') === '1';
        row.style.background = act ? '#FFF9F4' : '#FFFFFF';
        const btn = row.querySelector('.pm-qbtn') as HTMLElement;
        if (btn) { btn.style.borderColor = act ? (rej ? '#F5C6C3' : '#1C130E') : '#EFE3DA'; btn.style.background = act ? (rej ? '#FDECEB' : '#1C130E') : '#FFFFFF'; btn.style.color = act ? (rej ? '#B42318' : '#FFFFFF') : '#1C130E'; }
      });
      // threshold (panel 4)
      const thr = 55 + (Math.floor(tk / 8) % 2) * 15;
      const tb = q('[data-pm-thrbar]'), tk2 = q('[data-pm-thrknob]');
      if (tb) tb.style.width = thr + '%'; if (tk2) tk2.style.left = thr + '%';
    };

    // ---- 300ms loop ----
    let tick = 0;
    paintHero(0); paintCells(0); paintNm(0); paintCov(0); paintSteps(); paintPanelAnims(0);
    setInterval(() => {
      tick++;
      paintHero(tick); paintCells(tick); paintNm(tick); paintCov(tick); paintPanelAnims(tick);
      if (stepAuto) { sp += 2.6; if (sp >= 100) { sp = 0; step = (step + 1) % 5; paintSteps(); } else fills.forEach((f, i) => { if (i === step) f.style.width = sp + '%'; }); }
    }, 300);

    // ---- faq ----
    qa('[data-pm-faq-btn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-pm-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-pm-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-pm-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

              <div class="pm-panel" data-pm-panel={4} style="display:none;flex-direction:column;gap:12px">
                <div style="padding:12px 14px;border:1px solid #F5ECE5;border-radius:12px">
                  <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:#7F7066"><span>AUTO-ACCEPT THRESHOLD</span><span style="color:#1C130E">[≥ X]</span></div>

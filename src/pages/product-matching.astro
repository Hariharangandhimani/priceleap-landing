                  <span style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:#1C130E"><span style={`width:6px;height:6px;border-radius:50%;background:${C.bb}`}></span><span style="min-width:58px">Best Buy</span><span style="padding:0 4px;border-radius:4px;font-family:'Geist Mono',monospace;color:#C2410C">No match</span></span>

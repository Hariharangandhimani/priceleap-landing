                <span style="display:flex;align-items:center;gap:10px;min-width:0"><span style="width:34px;height:34px;flex:none;border-radius:9px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 5px,#FFFCF9 5px 10px)"></span><span style="font-size:13px;font-weight:600;color:#1C130E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{nmStatic[0].n}</span></span>

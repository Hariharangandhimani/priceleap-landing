                      <span style="font-size:13px;color:#1C130E">Listing · <span style="color:#665A51">{qq.t}</span></span>
                      <span class="pm-qbtn" style="height:26px;padding:0 10px;display:flex;align-items:center;border-radius:7px;border:1px solid #EFE3DA;background:#FFFFFF;color:#1C130E;font-size:12px;transition:all .3s">{qq.b}</span>
                    </div>
                  ))}
                </div>
                <span style="font-family:'Geist Mono',monospace;font-size:11px;color:#7F7066">[Confirm: decisions are kept for future matching.]</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 NO MATCH (fix demo) -->

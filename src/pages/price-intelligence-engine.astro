        <div class="pie-trust" style="display:grid;gap:1px">
          <div style="background:var(--pl-cream);padding:22px 24px;display:flex;flex-direction:column;justify-content:center;gap:4px"><span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)">Trusted Partners</span></div>
          {partners.map((p) => (
            <div style="background:var(--pl-surface);padding:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;text-align:center;min-height:96px;transition:background .2s">
              <span style="font-family:Geist,sans-serif;font-size:16px;font-weight:600;letter-spacing:-.01em;color:var(--pl-ink)">{p.t}</span>
              <span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.06em;color:var(--pl-muted)">{p.s}</span>
            </div>
          ))}
        </div>
        <div class="pie-trust" style="display:grid;gap:1px">
          <div style="background:var(--pl-cream);padding:22px 24px;display:flex;flex-direction:column;justify-content:center;gap:4px"><span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)">Trusted, Certified &amp; Secure</span></div>
          <div style="background:var(--pl-surface);padding:18px;display:flex;align-items:center;justify-content:center;gap:12px;min-height:96px"><img src="/assets/iso-9001.webp" alt="ISO 9001" style="height:44px;width:auto;max-width:56px;object-fit:contain" /><span style="display:flex;flex-direction:column"><span style="font-family:Geist,sans-serif;font-size:15px;font-weight:600;color:var(--pl-ink)">ISO 9001</span><span style="font-size:12.5px;color:var(--pl-muted)">Quality</span></span></div>
          <div style="background:var(--pl-surface);padding:18px;display:flex;align-items:center;justify-content:center;gap:12px;min-height:96px"><img src="/assets/iso-27001.avif" alt="ISO 27001" style="height:44px;width:auto;max-width:56px;object-fit:contain" /><span style="display:flex;flex-direction:column"><span style="font-family:Geist,sans-serif;font-size:15px;font-weight:600;color:var(--pl-ink)">ISO 27001</span><span style="font-size:12.5px;color:var(--pl-muted)">Security</span></span></div>

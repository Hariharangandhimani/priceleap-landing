        <div aria-hidden="true" style="position:absolute;left:50%;top:50%;width:min(76%,820px);height:64%;transform:translate(-50%,-50%);border:1px solid var(--pl-line);border-radius:6px">
          <span style="position:absolute;left:-1px;top:-1px;width:16px;height:16px;border-left:2px solid var(--pl-accent);border-top:2px solid var(--pl-accent)"></span>
          <span style="position:absolute;right:-1px;top:-1px;width:16px;height:16px;border-right:2px solid var(--pl-accent);border-top:2px solid var(--pl-accent)"></span>
          <span style="position:absolute;left:-1px;bottom:-1px;width:16px;height:16px;border-left:2px solid var(--pl-accent);border-bottom:2px solid var(--pl-accent)"></span>
          <span style="position:absolute;right:-1px;bottom:-1px;width:16px;height:16px;border-right:2px solid var(--pl-accent);border-bottom:2px solid var(--pl-accent)"></span>
        </div>
        <div aria-hidden="true" style="position:absolute;left:50%;bottom:-180px;width:680px;height:360px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.18),transparent)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;align-items:center;gap:22px">
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(32px,4.8vw,60px);line-height:1.04;letter-spacing:-.045em;color:var(--pl-ink);max-width:880px;text-wrap:balance"><span style="font-weight:400">See your market position </span><span style="font-weight:700">before your next pricing decision.</span></h2>
          <p style="margin:0;max-width:620px;font-size:17px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">PriceLeap helps your team move from scattered competitor data to pricing intelligence your team can actually use.</p>
          <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center">
            <a href="/book-a-demo" style="height:50px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Get a demo</a>
            <a href="#pricing" style="height:50px;padding:0 22px;display:inline-flex;align-items:center;gap:10px;border-radius:12px;background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">View pricing<span style="color:var(--pl-accent-ink)">→</span></a>

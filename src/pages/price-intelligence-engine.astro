---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';
import Faq from '../components/pl/Faq.astro';
import '../styles/pl-marketing.css';

const logos = [...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank'], ...['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank']];
const problems = [
  { n: '01', t: 'Raw exports pile up faster than anyone can read them, so the signal gets lost in the noise.' },
  { n: '02', t: 'A single competitor price means nothing without context — who moved, by how much, and where you now stand.' },
  { n: '03', t: 'Price, availability, matches and history live in different tools, so no one has the full picture at once.' },
];
const caps = [
  { n: '01', t: 'Price index & positioning', d: 'One revenue-weighted number per category shows exactly where you sit against the market.' },
  { n: '02', t: 'Competitor moves', d: 'See who changed price, by how much, and when — with the context to judge whether to respond.' },
  { n: '03', t: 'Verified product matching', d: 'Every competitor price mapped to the right product, down to the variant, with confidence scores.' },
  { n: '04', t: 'Full price history', d: 'Track how each price moved over time, so promotions and trends are obvious, not guessed.' },
  { n: '05', t: 'Availability & stock', d: 'Know when a rival sells out — often the best moment to move on price.' },
  { n: '06', t: 'Channel-level signals', d: 'Marketplace, region and banner differences in one view, not scattered across tabs.' },
];
const uses = [
  { n: '01', t: 'Monday review', d: 'Start the week with overnight moves and promotions already surfaced.' },
  { n: '02', t: 'Category planning', d: 'See price position by category before setting the quarter\'s strategy.' },
  { n: '03', t: 'Promo response', d: 'Catch a competitor promotion early enough to decide whether to match.' },
  { n: '04', t: 'Exec reporting', d: 'One trusted market view to share with finance and merchandising.' },
];
const baList = [
  'One trusted market view instead of scattered exports.',
  'Every price in context — who moved, by how much, where you stand.',
  'Price, availability, matches and history in a single layer.',
  'Signals ready for your Decision and Margin Protection engines.',
];
const plans = [
  { n: 'Starter', price: '$89', sku: 'Up to 1,500 products / month', cta: 'Start with Starter', pop: false, f: ['Track 5 competitors', 'Daily price refresh, 1× per day', 'Real-time competitor price tracking', 'Email price alerts', 'Basic pricing rules engine', 'CSV export & dashboard access', 'REST API access'] },
  { n: 'Growth', price: '$159', sku: 'Up to 3,000 products / month', cta: 'Choose Growth', pop: true, f: ['Everything in Starter', 'Daily price refresh, 2× per day', 'Advanced pricing rules & auto-response', 'Margin protection system', 'Slack & webhook alerts', 'Decision engine & auto-response'] },
  { n: 'Scale', price: '$299', sku: 'Up to 6,000 products / month', cta: 'Choose Scale', pop: false, f: ['Everything in Growth', 'Daily price refresh, 3× per day', 'Priority alert processing', 'Full automation mode', 'Advanced ERP integration', 'Dedicated onboarding support'] },
];
const faqs = [
  { q: 'What is a Price Intelligence Engine?', a: "It's the layer that organizes competitor prices, availability, product matches, history, and channel signals into one trusted view of your market position — so your team reads answers, not raw exports." },
  { q: 'How is this different from price tracking?', a: 'Price tracking tells you what a price is. The Price Intelligence Engine tells you what it means — where you stand, who moved, and what changed in context — so a single number becomes a decision signal.' },
  { q: 'What data does it use?', a: 'Competitor prices, product availability, verified product matches, full price history, and channel-level signals across the marketplaces and sites you choose to track.' },
  { q: 'Does it automatically change prices?', a: 'No. The Price Intelligence Engine is the intelligence layer — it explains the market. Acting on it is the job of the separate Pricing Decision and Margin Protection Engines, which you control.' },
  { q: 'Can we track our own competitor set?', a: 'Yes. You define exactly which competitors, marketplaces, and channels matter for your catalog, and the engine builds your market view around that set.' },
  { q: 'How often is the data refreshed?', a: 'Refresh frequency scales with your plan — from once daily on Starter up to three times daily on Scale, with custom cadence available for larger catalogs.' },
  { q: 'How is pricing calculated?', a: "Plan pricing is based on the number of products monitored per month and refresh frequency. Need more competitors, SKUs, or a custom cadence? We'll scope a plan to your setup." },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Price Intelligence Engine', provider: { '@type': 'Organization', name: 'PriceLeap' }, url: 'https://priceleap.ai/price-intelligence-engine' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PriceLeapLayout title="Price Intelligence Engine · PriceLeap" description="Turn competitor price movement into pricing intelligence. See where your prices stand, which competitors moved, and what changed — before your team decides." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="mk-hero">
    <div aria-hidden="true" class="mk-hero-lines"></div>
    <div aria-hidden="true" class="mk-hero-glow"></div>
    <div class="mk-hero-inner" style="grid-template-columns:1fr">
      <div style="min-width:0;max-width:820px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center">
        <span class="pie-badge"><span class="pie-badge-sq"></span>Price Intelligence Engine</span>
        <h1 class="mk-h1" style="text-wrap:balance"><span style="font-weight:400">Turn competitor price movement into </span><span style="font-weight:700">pricing intelligence.</span></h1>
        <p class="mk-sub" style="max-width:680px">PriceLeap shows where your prices stand, which competitors moved, and what changed across products, channels, and categories — before your team decides what to do next.</p>
        <div class="mk-hero-cta" style="justify-content:center"><a href="#pricing" class="mk-btn-primary">See plans</a><a href="/contact" class="mk-btn-text">Book a demo<span style="color:var(--pl-accent-ink)">→</span></a></div>
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="mk-logos">
    <div class="mk-logos-wrap"><div class="mk-logos-label">Trusted by teams at</div><div class="mk-logos-marq-wrap"><div class="mk-logos-marq">{logos.map((l) => (<div class="mk-logo">{l}</div>))}</div></div></div>
  </section>

  <!-- Overview -->
  <section id="overview" class="mk-sec">
    <div class="mk-split mk-split--center">
      <div data-reveal>
        <span class="mk-eyebrow"><span class="mk-sq"></span>Overview</span>
        <h2 class="mk-h2"><span style="font-weight:400">What is the </span><span style="font-weight:700">Price Intelligence Engine?</span></h2>
        <p class="pie-p">It's the layer that turns raw competitor prices into a single, trusted view of your market position. Prices, availability, verified matches, history and channel signals are organized so your team reads answers — not exports.</p>
        <p class="pie-p pie-p--muted">The intelligence that feeds your pricing decisions, not another dashboard to reconcile.</p>
      </div>
      <div data-reveal class="pie-overview-card">
        <div class="pie-oc-head"><span>MARKET POSITION</span><span class="pie-oc-live"><span class="mk-live-dot"></span>LIVE</span></div>
        <div class="pie-oc-index"><span class="pie-oc-v">97.4</span><span class="pie-oc-l">PRICE INDEX · ELECTRONICS</span></div>
        <div class="pie-oc-rows">
          {[['You', '$179.00', 'AT MARKET', 'var(--pl-ink)'], ['Rival A', '$169.00', '−5.6%', 'var(--pl-accent-ink)'], ['Rival B', '$184.99', '+3.3%', 'var(--pl-danger-ink)'], ['Marketplace', '$174.50', '−2.5%', 'var(--pl-accent-ink)']].map(([n, p, d, c]) => (
            <div class="pie-oc-row"><span>{n}</span><span class="pie-oc-p">{p}</span><span class="pie-oc-d" style={`color:${c}`}>{d}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section id="problem" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal style="max-width:760px">
        <span class="mk-eyebrow mk-eyebrow--danger"><span class="mk-sq mk-sq--danger"></span>The problem</span>
        <h2 class="mk-h2"><span style="font-weight:400">Pricing teams don't need more raw data. </span><span style="font-weight:700">They need trusted answers.</span></h2>
      </div>
      <div data-reveal class="pie-probs">
        {problems.map((p) => (<div class="pie-prob"><span class="pie-prob-n">{p.n}</span><p>{p.t}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>What it does</span>
        <h2 class="mk-h2" style="max-width:820px"><span style="font-weight:400">Everything your team reads </span><span style="font-weight:700">before a pricing decision.</span></h2>
      </div>
      <div data-reveal class="pie-caps">
        {caps.map((c) => (<div class="pie-cap"><span class="pie-cap-n">{c.n}</span><h3>{c.t}</h3><p>{c.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Before / After -->
  <section id="compare" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Before and after</span>
        <h2 class="mk-h2"><span style="font-weight:400">How pricing work changes </span><span style="font-weight:700">with PriceLeap.</span></h2>
      </div>
      <div data-reveal class="fr-ba">
        <div class="fr-ba-left">
          <span class="fr-ba-tag">WITH PRICELEAP</span>
          <h3 class="fr-ba-title">Intelligence first. Decisions next.</h3>
          <div class="fr-ba-meter"><span class="fr-ba-cov">1</span><span class="fr-ba-cov-l">trusted market<br>view</span></div>
          <div class="fr-ba-track"><span style="width:100%"></span></div>
        </div>
        <div class="fr-ba-list">{baList.map((t) => (<div class="fr-ba-row"><span class="fr-ba-check">✓</span><span>{t}</span></div>))}</div>
      </div>
    </div>
  </section>

  <!-- Platform / Uses -->
  <section id="uses" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Where teams use it</span>
        <h2 class="mk-h2"><span style="font-weight:400">One market view, </span><span style="font-weight:700">used across the pricing week.</span></h2>
      </div>
      <div data-reveal class="pie-uses">
        {uses.map((u) => (<div class="pie-use"><span class="pie-use-n">{u.n}</span><h3>{u.t}</h3><p>{u.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Scale -->
  <section id="scale" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="pie-scale">
        <div>
          <span class="mk-eyebrow"><span class="mk-sq"></span>Built for scale</span>
          <h2 class="mk-h2"><span style="font-weight:400">Built for pricing work at </span><span style="font-weight:700">real catalog scale.</span></h2>
        </div>
        <div class="pie-scale-stats">
          {[['1M+', 'SKUs under coverage'], ['[X]%', 'match accuracy'], ['3×/day', 'refresh on Scale'], ['SOC 2', 'certified security']].map(([v, l]) => (
            <div class="pie-stat"><span class="pie-stat-v">{v}</span><span class="pie-stat-l">{l}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Pricing</span>
        <h2 class="mk-h2"><span style="font-weight:400">Choose the plan that fits </span><span style="font-weight:700">your catalog size.</span></h2>
      </div>
      <div data-reveal class="pie-plans">
        {plans.map((p) => (
          <div class={`pie-plan${p.pop ? ' pie-plan--pop' : ''}`}>
            {p.pop && (<span class="pie-plan-badge">MOST POPULAR</span>)}
            <div class="pie-plan-n">{p.n}</div>
            <div class="pie-plan-price"><span class="pie-plan-amt">{p.price}</span><span class="pie-plan-per">/month</span></div>
            <div class="pie-plan-sku">{p.sku}</div>
            <a href="/contact" class={p.pop ? 'mk-btn-primary pie-plan-cta' : 'mk-btn-ghost pie-plan-cta'}>{p.cta}</a>
            <div class="pie-plan-feats">{p.f.map((f) => (<span class="pie-plan-feat"><span class="pie-plan-check">✓</span>{f}</span>))}</div>
          </div>
        ))}
      </div>
      <div class="pie-plans-note">Need more competitors, SKUs, or a custom cadence? <a href="/contact">Talk to us</a> and we'll scope a plan to your setup.</div>
    </div>
  </section>

  <Faq items={faqs} title="Questions pricing teams " titleBold="ask first." />

  <!-- CTA -->
  <section id="demo" class="mk-cta-sec">
    <div class="mk-cta">
      <div aria-hidden="true" class="mk-cta-glow"></div>
      <div data-reveal class="mk-cta-inner">
        <h2 class="mk-cta-h2"><span style="font-weight:400">See your market position </span><span style="font-weight:700">before your next pricing decision.</span></h2>
        <a href="/contact" class="mk-btn-primary mk-btn-lg">Book a demo</a>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .pie-badge { height: 30px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-accent-ink); }
  .pie-badge-sq { width: 7px; height: 7px; border-radius: 2px; background: var(--pl-gradient); transform: rotate(45deg); }
  .pie-p { margin: 20px 0 0; font-size: 17px; line-height: 1.7; color: var(--pl-ink-2); }
  .pie-p--muted { margin-top: 10px; font-size: 15px; color: var(--pl-muted); }

  .pie-overview-card { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 22px; overflow: hidden; box-shadow: 0 30px 60px -40px rgba(60,30,15,.3); }
  .pie-oc-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid var(--pl-line-soft); background: var(--pl-cream); font-family: 'Geist Mono', monospace; font-size: 10.5px; letter-spacing: .08em; color: var(--pl-faint); }
  .pie-oc-live { display: flex; align-items: center; gap: 6px; color: var(--pl-accent-ink); }
  .pie-oc-index { padding: 22px 18px 16px; display: flex; flex-direction: column; gap: 4px; }
  .pie-oc-v { font-family: Geist, sans-serif; font-size: 48px; font-weight: 600; letter-spacing: -.045em; line-height: 1; color: var(--pl-ink); }
  .pie-oc-l { font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-accent-ink); }
  .pie-oc-rows { border-top: 1px solid var(--pl-line-soft); }
  .pie-oc-row { display: grid; grid-template-columns: minmax(0,1fr) auto auto; gap: 12px; align-items: center; padding: 12px 18px; border-bottom: 1px solid var(--pl-sand); font-size: 14px; color: var(--pl-ink); }
  .pie-oc-row:last-child { border-bottom: none; }
  .pie-oc-p { font-family: 'Geist Mono', monospace; font-size: 13px; color: var(--pl-ink); }
  .pie-oc-d { font-family: 'Geist Mono', monospace; font-size: 11.5px; }

  .pie-probs { margin-top: 48px; border: 1px solid var(--pl-line); border-radius: 24px; overflow: hidden; background: var(--pl-line); display: grid; grid-template-columns: 1fr; gap: 1px; }
  .pie-prob { background: var(--pl-surface); padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .pie-prob-n { font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--pl-danger-ink); }
  .pie-prob p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--pl-ink); }

  .pie-caps { margin-top: 48px; border: 1px solid var(--pl-line); border-radius: 24px; overflow: hidden; background: var(--pl-line); display: grid; grid-template-columns: 1fr; gap: 1px; }
  .pie-cap { background: var(--pl-surface); padding: 28px; display: flex; flex-direction: column; gap: 8px; }
  .pie-cap-n { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-accent-ink); }
  .pie-cap h3 { margin: 0; font-family: Geist, sans-serif; font-size: 19px; font-weight: 600; letter-spacing: -.02em; color: var(--pl-ink); }
  .pie-cap p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--pl-muted); }

  .pie-uses { margin-top: 48px; display: grid; grid-template-columns: 1fr; gap: 16px; }
  .pie-use { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .pie-use-n { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-accent-ink); }
  .pie-use h3 { margin: 0; font-family: Geist, sans-serif; font-size: 18px; font-weight: 600; color: var(--pl-ink); }
  .pie-use p { margin: 0; font-size: 14.5px; line-height: 1.6; color: var(--pl-muted); }

  .pie-scale { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  .pie-scale-stats { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
  .pie-stat { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 18px; padding: 24px; display: flex; flex-direction: column; gap: 6px; }
  .pie-stat-v { font-family: Geist, sans-serif; font-size: clamp(36px,4.6vw,52px); font-weight: 600; letter-spacing: -.05em; line-height: 1; color: var(--pl-ink); }
  .pie-stat-l { font-size: 14px; color: var(--pl-muted); }

  .pie-plans { margin-top: 48px; display: grid; grid-template-columns: 1fr; gap: 16px; align-items: start; }
  .pie-plan { position: relative; background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 22px; padding: 28px; display: flex; flex-direction: column; gap: 6px; }
  .pie-plan--pop { border: 1.5px solid var(--pl-accent); box-shadow: 0 0 0 6px rgba(247,99,30,.08),0 30px 60px -36px rgba(194,65,12,.4); }
  .pie-plan-badge { position: absolute; top: -11px; left: 28px; height: 22px; padding: 0 10px; display: flex; align-items: center; border-radius: 999px; background: var(--pl-gradient); color: var(--pl-surface); font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; }
  .pie-plan-n { font-family: Geist, sans-serif; font-size: 20px; font-weight: 600; color: var(--pl-ink); }
  .pie-plan-price { display: flex; align-items: baseline; gap: 4px; margin-top: 8px; }
  .pie-plan-amt { font-family: Geist, sans-serif; font-size: 48px; font-weight: 600; letter-spacing: -.045em; color: var(--pl-ink); }
  .pie-plan-per { font-size: 15px; color: var(--pl-muted); }
  .pie-plan-sku { font-size: 14px; color: var(--pl-muted); }
  .pie-plan-cta { margin-top: 16px; width: 100%; justify-content: center; }
  .pie-plan-feats { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--pl-line-soft); display: flex; flex-direction: column; gap: 10px; }
  .pie-plan-feat { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--pl-ink-2); }
  .pie-plan-check { flex: none; margin-top: 1px; width: 18px; height: 18px; border-radius: 50%; background: var(--pl-accent-tint); border: 1px solid var(--pl-accent-line); color: var(--pl-accent-ink); font-size: 10px; display: flex; align-items: center; justify-content: center; }
  .pie-plans-note { margin-top: 20px; text-align: center; font-size: 14px; color: var(--pl-muted); }
  .pie-plans-note a { color: var(--pl-accent-ink); text-decoration: underline; text-underline-offset: 3px; }

  @media (min-width: 760px) {
    .mk-split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
    .mk-logos-wrap { grid-template-columns: 260px minmax(0,1fr); }
    .mk-logos-label { border-bottom: none; border-right: 1px solid var(--pl-line); }
    .pie-probs { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .pie-caps { grid-template-columns: repeat(auto-fit,minmax(min(100%,320px),1fr)); }
    .pie-uses { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .fr-ba { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
    .pie-scale { grid-template-columns: minmax(0,1fr) minmax(0,1.1fr); }
    .pie-scale-stats { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .pie-plans { grid-template-columns: repeat(3,minmax(0,1fr)); }
  }
  @media (min-width: 1000px) { .pie-caps { grid-template-columns: repeat(3,minmax(0,1fr)); } }
</style>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('mk-in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

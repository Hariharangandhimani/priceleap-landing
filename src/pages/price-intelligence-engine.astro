</PriceLeapLayout>

<style>
  .pie { background: var(--pl-surface); overflow-x: clip; }
  @keyframes pi-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.55); } 100% { box-shadow: 0 0 0 10px rgba(247,99,30,0); } }
  @keyframes pi-dashx { to { background-position: 20px 0; } }
  @keyframes pi-dashy { to { background-position: 0 20px; } }
  @keyframes pi-marquee { to { transform: translateX(-50%); } }
  @keyframes pi-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes pi-rise { 0% { opacity: 0; transform: translateY(26px); } 15%,70% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(-22px); } }
  @keyframes pi-travel { 0% { left: 0; opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { left: 100%; opacity: 0; } }
  @keyframes pi-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes pi-ring { 0% { transform: scale(.6); opacity: .8; } 100% { transform: scale(2.4); opacity: 0; } }
  @keyframes pi-slide { 0%,15% { left: 18%; } 40%,60% { left: 52%; } 85%,100% { left: 80%; } }
  @keyframes pi-link { 0%,20% { transform: scaleX(0); } 45%,100% { transform: scaleX(1); } }
  @keyframes pi-ok { 0%,45% { opacity: 0; transform: scale(.8); } 55%,100% { opacity: 1; transform: none; } }
  @keyframes pi-orbit { to { transform: rotate(360deg); } }
  @keyframes pi-streak { from { stroke-dashoffset: .16; } to { stroke-dashoffset: -.84; } }
  @keyframes pi-blink { 50% { opacity: .25; } }

  .pie-subnav { display: none; }
  @media (min-width: 760px) { .pie-subnav { display: block; } }
  .pie-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .pie-hero { grid-template-columns: minmax(0,1.02fr) minmax(0,1fr); } }
  .pie-herobadge { display: none; }
  @media (min-width: 760px) { .pie-herobadge { display: flex; } }
  .pie-logos { grid-template-columns: 1fr; }
  .pie-logolabel { border-bottom: 1px solid var(--pl-line); }
  @media (min-width: 760px) { .pie-logos { grid-template-columns: 260px minmax(0,1fr); } .pie-logolabel { border-right: 1px solid var(--pl-line); border-bottom: none; } }
  .pie-wide { display: none; }
  @media (min-width: 1000px) { .pie-wide { display: block; } }
  .pie-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .pie-split { grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); } }
  .pie-sticky { position: relative; }
  @media (min-width: 1000px) { .pie-sticky { position: sticky; } }
  .pie-flow-wide { display: none; }
  .pie-flow-mob { display: flex; }
  @media (min-width: 1000px) { .pie-flow-wide { display: block; } .pie-flow-mob { display: none; } }
  .pie-cap { grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .pie-cap { grid-template-columns: minmax(0,400px) minmax(0,1fr); } }
  .pie-captab.is-on { background: var(--pl-surface) !important; }
  .pie-captab.is-on .pie-capbar { background: var(--pl-accent) !important; }
  .pie-captab .pie-capn { color: var(--pl-faint); }
  .pie-captab.is-on .pie-capn { color: var(--pl-accent-ink); }
  .pie-capexp { display: none; }
  .pie-captab.is-on .pie-capexp { display: flex; }
  .pie-cmptoggle { display: grid; }
  @media (min-width: 760px) { .pie-cmptoggle { display: none; } }
  .pie-cmprow { display: grid; grid-template-columns: 1fr; }
  .pie-cmphead { display: none; }
  @media (min-width: 760px) { .pie-cmprow { grid-template-columns: minmax(0,.8fr) minmax(0,1fr) minmax(0,1fr); } .pie-cmphead { display: grid; } }
  @media (max-width: 759px) { [data-pie-cmp][data-ba="1"] .pie-cmpb { display: none; } [data-pie-cmp][data-ba="0"] .pie-cmpa { display: none; } }
  .pie-plat { grid-template-columns: 1fr; }
  .pie-conn { display: flex; align-items: center; justify-content: center; padding: 6px 0; }
  .pie-connline { display: block; width: 2px; height: 32px; background: repeating-linear-gradient(180deg,var(--pl-accent) 0 6px,transparent 6px 12px); background-size: 2px 20px; animation: pi-dashy .8s linear infinite; }
  @media (min-width: 1000px) { .pie-plat { grid-template-columns: minmax(0,1fr) 56px minmax(0,1fr) 56px minmax(0,1fr); } .pie-conn { padding: 0; } .pie-connline { width: 100%; height: 2px; background: repeating-linear-gradient(90deg,var(--pl-accent) 0 6px,transparent 6px 12px); background-size: 20px 2px; animation: pi-dashx .8s linear infinite; } }
  .pie-trust { grid-template-columns: repeat(2,minmax(0,1fr)); }
  @media (min-width: 760px) { .pie-trust { grid-template-columns: repeat(3,minmax(0,1fr)); } }
  @media (min-width: 1000px) { .pie-trust { grid-template-columns: 220px repeat(5,minmax(0,1fr)); } }

  .pie-faq-n { color: var(--pl-faint); }
  .pie-faq.is-open .pie-faq-n { color: var(--pl-accent-ink); }
  .pie-faq-ic { background: var(--pl-sand); transform: rotate(0deg); transition: transform .3s, background .3s; }
  .pie-faq.is-open .pie-faq-ic { background: var(--pl-accent); transform: rotate(45deg); }
  .pie-faq.is-open { border-color: var(--pl-accent-line); box-shadow: 0 18px 36px -28px rgba(194,65,12,.5); }
  .pie-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .pie-faq.is-open .pie-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .pie *, .pie *::before, .pie *::after { animation: none !important; transition: none !important; } [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.pie') as HTMLElement | null;
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---------- scrollspy subnav + progress ----------
    const ids = ['overview', 'problem', 'how', 'capabilities', 'compare', 'platform', 'pricing', 'faq'];
    const subs = qa('[data-pie-sub]'), progress = q('[data-pie-progress]');
    function onScroll() {
      let a = ids[0];
      ids.forEach((id) => { const el = document.getElementById(id); if (el && el.getBoundingClientRect().top < 160) a = id; });
      subs.forEach((el) => { const on = el.getAttribute('data-pie-sub') === a; el.style.color = on ? 'var(--pl-ink)' : 'var(--pl-muted)'; el.style.background = on ? 'var(--pl-sand)' : 'transparent'; });
      const d = document.documentElement, max = d.scrollHeight - window.innerHeight;
      if (progress) progress.style.width = (max > 0 ? Math.min(100, window.scrollY / max * 100) : 0) + '%';
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ---------- hero slow tick (3s) ----------
    const tagSty: Record<string, string[]> = { 'BELOW': ['var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)', 'var(--pl-accent)'], 'ABOVE': ['var(--pl-danger-tint)', 'var(--pl-danger-line)', 'var(--pl-danger-ink)', 'var(--pl-danger)'], 'IN LINE': ['var(--pl-sand)', 'var(--pl-line)', 'var(--pl-ink-2)', 'var(--pl-ink)'] };
    const heroPos = [28, 74, 50, 46], heroTag = ['BELOW', 'ABOVE', 'IN LINE', 'IN LINE'];
    const moves = [
      { who: 'Retailer B', what: 'Earbuds Pro 2', d: '▼ 6.2%', arrow: '▼', c: 'var(--pl-danger-ink)', t: '2 MIN AGO' },
      { who: 'Marketplace A', what: 'SmartFit Watch 46mm', d: '▲ 3.1%', arrow: '▲', c: 'var(--pl-accent-ink)', t: '9 MIN AGO' },
      { who: 'D2C store C', what: 'Speaker Mini 4', d: '▼ 4.0%', arrow: '▼', c: 'var(--pl-danger-ink)', t: '14 MIN AGO' },
      { who: 'Marketplace D', what: 'Sonix ANC 700', d: 'Out of stock', arrow: '○', c: 'var(--pl-ink-2)', t: '21 MIN AGO' },
    ];
    const idxEl = q('[data-pie-index]'), movedEl = q('[data-pie-moved]');
    const heroDots = qa('[data-pie-herodot]'), heroTags = qa('[data-pie-herotag]');
    const moveArrow = q('[data-pie-movearrow]'), moveBody = q('[data-pie-movebody]'), moveT = q('[data-pie-movet]');
    const routes = qa('[data-pie-route]');
    let tk = 0;
    function slowTick() {
      if (idxEl) idxEl.textContent = (101.8 + (tk % 4 === 1 ? -0.4 : tk % 4 === 3 ? 0.3 : 0)).toFixed(1);
      if (movedEl) movedEl.textContent = String(37 + (tk % 5));
      heroPos.forEach((basePos, i) => {
        let pos = basePos, tag = heroTag[i];
        if (i === 1 && tk % 2 === 1) { pos = 52; tag = 'IN LINE'; }
        if (i === 3 && tk % 3 === 2) { pos = 34; tag = 'BELOW'; }
        const t = tagSty[tag], dot = heroDots[i], tg = heroTags[i];
        if (dot) { dot.style.left = pos + '%'; dot.style.background = t[3]; dot.style.boxShadow = '0 0 0 1px ' + t[3]; }
        if (tg) { tg.textContent = tag; tg.style.background = t[0]; tg.style.borderColor = t[1]; tg.style.color = t[2]; }
      });
      const m = moves[tk % moves.length];
      if (moveArrow) { moveArrow.textContent = m.arrow; moveArrow.style.color = m.c; }
      if (moveBody) { moveBody.innerHTML = `<b style="font-weight:600;color:var(--pl-ink)">${m.who}</b> moved ${m.what} <span style="font-family:'Geist Mono',monospace;color:${m.c}">${m.d}</span>`; moveBody.style.animation = 'none'; void moveBody.offsetWidth; moveBody.style.animation = 'pi-in .45s ease'; }
      if (moveT) moveT.textContent = m.t;
      const rk = tk % 3;
      routes.forEach((el, i) => { const on = i <= rk; el.style.background = on ? 'var(--pl-accent-tint)' : 'var(--pl-surface)'; el.style.borderColor = on ? 'var(--pl-accent-line)' : 'var(--pl-line)'; const dot = el.querySelector('[data-pie-routedot]') as HTMLElement | null; if (dot) dot.style.background = on ? 'var(--pl-accent)' : 'var(--pl-line-xstrong)'; });
    }
    slowTick();
    setInterval(() => { tk++; slowTick(); }, 3000);

    // ---------- capability tabs (auto-advance 240ms + click) ----------
    const capTabs = qa('[data-pie-cap]'), capPanels = qa('[data-pie-cappanel]');
    let tab = 0, tabP = 0;
    function paintCap() {
      capTabs.forEach((b, i) => { const on = i === tab; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); const fill = b.querySelector('[data-pie-capfill]') as HTMLElement | null; if (fill) fill.style.width = (on ? Math.round(tabP * 100) : 0) + '%'; });
      capPanels.forEach((p) => { p.hidden = Number(p.getAttribute('data-pie-cappanel')) !== tab; });
    }
    paintCap();
    setInterval(() => { tabP += 0.04; if (tabP >= 1) { tab = (tab + 1) % 4; tabP = 0; } paintCap(); }, 240);
    capTabs.forEach((b, i) => b.addEventListener('click', () => { tab = i; tabP = 0; paintCap(); }));

    // ---------- before/after (mobile toggle) ----------
    const cmp = q('[data-pie-cmp]'), cmpBefore = q('[data-pie-cmpbefore]'), cmpAfter = q('[data-pie-cmpafter]');
    function setBA(v: number) {
      if (cmp) cmp.setAttribute('data-ba', String(v));
      if (cmpBefore) { cmpBefore.style.background = v === 0 ? 'var(--pl-surface)' : 'transparent'; cmpBefore.style.color = v === 0 ? 'var(--pl-ink)' : 'var(--pl-muted)'; }
      if (cmpAfter) { cmpAfter.style.background = v === 1 ? 'var(--pl-accent)' : 'transparent'; cmpAfter.style.color = 'var(--pl-ink)'; }
    }
    cmpBefore?.addEventListener('click', () => setBA(0));
    cmpAfter?.addEventListener('click', () => setBA(1));

    // ---------- stats count-up on reveal ----------
    const statV = qa('[data-pie-statv]'), statBar = qa('[data-pie-statbar]');
    let counted = false;
    function countStats() {
      if (counted) return; counted = true;
      const t0 = performance.now(), D = 1600;
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / D), p = 1 - Math.pow(1 - k, 3);
        const vals = [Math.round(8000 * p).toLocaleString('en-US'), '28%→' + Math.round(28 + 62 * p) + '%+', '~' + Math.round(19 * p) + '%', Math.round(50 * p) + 'K+'];
        const bars = [16 * p, 28 + 62 * p, 19 * p * 3, 100 * p];
        statV.forEach((el, i) => (el.textContent = vals[i]));
        statBar.forEach((el, i) => (el.style.width = bars[i] + '%'));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // ---------- faq ----------
    qa('[data-pie-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-pie-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-pie-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-pie-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---------- reveal ----------
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; e.target.classList.add('is-in'); io.unobserve(e.target); if ((e.target as HTMLElement).hasAttribute('data-pie-stats')) countStats(); }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); countStats(); }
  }
</script>

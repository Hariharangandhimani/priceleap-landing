---
// Native Astro port of the design package's "Price Intelligence Engine" page.
// Static initial render + all loops/interactions reimplemented in vanilla JS: sticky
// scrollspy subnav + scroll-progress bar, hero market-position dashboard (cycling rows,
// move ticker, counters), auto-advancing + clickable capability tabs (4 panels), the
// inputs→engine→outputs flow diagram (CSS/SMIL), before/after compare (mobile toggle),
// platform connectors, uses grid, stats count-up on reveal, pricing, FAQ. Responsive
// via CSS media queries.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const tagSty: Record<string, string[]> = { 'BELOW': ['var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)', 'var(--pl-accent)'], 'ABOVE': ['var(--pl-danger-tint)', 'var(--pl-danger-line)', 'var(--pl-danger-ink)', 'var(--pl-danger)'], 'IN LINE': ['var(--pl-sand)', 'var(--pl-line)', 'var(--pl-ink-2)', 'var(--pl-ink)'] };
const heroBase = [
  { n: 'Sonix ANC 700 Headphones', you: 'You $189.00', lo: 18, span: 54, pos: 28, tag: 'BELOW' },
  { n: 'Earbuds Pro 2 · White', you: 'You $159.00', lo: 22, span: 40, pos: 74, tag: 'ABOVE' },
  { n: 'SmartFit Watch 46mm', you: 'You $249.00', lo: 14, span: 62, pos: 50, tag: 'IN LINE' },
  { n: 'Portable Speaker Mini 4', you: 'You $79.00', lo: 30, span: 44, pos: 46, tag: 'IN LINE' },
];
const heroRowsInit = heroBase.map((r) => { const t = tagSty[r.tag]; return { ...r, tbg: t[0], tbc: t[1], tc: t[2], dot: t[3] }; });

const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logoLoop = [...brandLogos, ...brandLogos];
const subItems: [string, string][] = [['overview', 'Overview'], ['problem', 'Problem'], ['how', 'What it does'], ['capabilities', 'Capabilities'], ['compare', 'Before & after'], ['platform', 'Platform'], ['pricing', 'Pricing'], ['faq', 'FAQ']];

const problems = [
  { n: '01', t: 'Competitor prices change before weekly reports are ready.', tag: 'STALE' },
  { n: '02', t: 'Spreadsheet checks miss product-level context.', tag: 'NO CONTEXT' },
  { n: '03', t: 'One bad product match can trigger the wrong pricing move.', tag: 'MISMATCH' },
  { n: '04', t: 'Teams lose time debating screenshots, exports, and stale market views.', tag: 'DEBATE' },
];
const flowIn = [['Competitor prices', '$'], ['Availability', '◐'], ['Product matches', '⇄'], ['Price history', '∿'], ['Channel signals', '◎']].map(([t, ic], i) => ({ t, ic, y: [15.38, 32.69, 50, 67.31, 84.62][i] }));
const flowOut = [['Market position', '◆'], ['Price gaps', '↔'], ['Alerts', '!'], ['Decision signals', '→']].map(([t, ic], i) => ({ t, ic, y: [24.04, 41.35, 58.65, 75.96][i] }));

const capsData = [
  { t: 'Market position intelligence', d: 'See exactly where you sit against the market — by product, category, and channel — in a single index you can trust.', b1: 'Live price index that rolls up to category and channel views.', b2: "See where you're below, at, or above market at a glance." },
  { t: 'Competitor movement detection', d: 'Know which competitors moved, on which products, and by how much — the moment it happens, not next week.', b1: 'Movement feed grouped by competitor, category, and direction.', b2: 'Filters out noise so only meaningful changes surface.' },
  { t: 'Price history & trend context', d: 'Every price comes with its history — so a single data point becomes a trend your team can read with confidence.', b1: 'Side-by-side history for you and each tracked competitor.', b2: 'Spot recurring promo cycles and pricing patterns over time.' },
  { t: 'Decision-ready alerts', d: 'Alerts arrive with the context to act on — what changed, why it matters, and where you now stand.', b1: 'Prioritized by impact, not just by what moved.', b2: 'Routed to email, Slack, or webhook with full context attached.' },
];
const capsInit = capsData.map((c, i) => ({ ...c, n: '0' + (i + 1), on: i === 0 }));
const catRows = [['Headphones', -6.2], ['Wearables', 3.4], ['Speakers', -2.1], ['Accessories', 7.8], ['Smart home', 0.6]].map(([n, v]) => { const vv = v as number; const wd = Math.min(48, Math.abs(vv) * 5.5); return { n, v: (vv > 0 ? '+' : '') + vv.toFixed(1) + '%', wd, l: vv < 0 ? 50 - wd : 50, org: vv < 0 ? 'right' : 'left', col: vv < 0 ? 'var(--pl-accent)' : vv > 3 ? 'var(--pl-danger)' : 'var(--pl-line-xstrong)', tc: vv < 0 ? 'var(--pl-accent-ink)' : vv > 3 ? 'var(--pl-danger-ink)' : 'var(--pl-ink-2)' }; });
const feed = [
  { who: 'Retailer B', what: 'Earbuds Pro 2', cat: 'HEADPHONES', t: '2m', d: '−6.2%', a: '▼', down: true },
  { who: 'Marketplace A', what: 'SmartFit Watch 46mm', cat: 'WEARABLES', t: '9m', d: '+3.1%', a: '▲', down: false },
  { who: 'D2C store C', what: 'Speaker Mini 4', cat: 'SPEAKERS', t: '14m', d: '−4.0%', a: '▼', down: true },
  { who: 'Retailer B', what: 'Sonix ANC 700', cat: 'HEADPHONES', t: '31m', d: '−2.5%', a: '▼', down: true },
  { who: 'Marketplace D', what: 'Charging Dock 3-in-1', cat: 'ACCESSORIES', t: '48m', d: '+5.0%', a: '▲', down: false },
].map((m, i) => ({ ...m, dl: (i * 0.12).toFixed(2), bg: m.down ? 'var(--pl-danger-tint)' : 'var(--pl-accent-tint)', c: m.down ? 'var(--pl-danger-ink)' : 'var(--pl-accent-ink)' }));
const routesInit = ['Email', 'Slack', 'Webhook'].map((t, i) => ({ t, bg: i <= 0 ? 'var(--pl-accent-tint)' : 'var(--pl-surface)', bc: i <= 0 ? 'var(--pl-accent-line)' : 'var(--pl-line)', dot: i <= 0 ? 'var(--pl-accent)' : 'var(--pl-line-xstrong)' }));

const compare = [
  ['Collecting prices', 'Analysts check competitor sites by hand and paste prices into spreadsheets.', 'Competitor prices, stock, and promotions are collected automatically.'],
  ['Product matching', 'Listings are compared by name, so pack sizes and variants get mixed up.', 'Each competitor listing is matched to the right product for like-for-like comparison.'],
  ['Spotting changes', 'Competitor moves are noticed late, often after sales have already shifted.', 'Alerts flag which competitors moved and which products are affected.'],
  ['Market position', 'No single view of where you sit across channels and categories.', 'One view shows where you are above, below, or in line with the market.'],
  ['Reporting', 'Hours spent building slides before every pricing review.', 'Shareable market snapshots ready for reviews and leadership updates.'],
  ['Pricing decisions', 'Based on partial data and gut feel.', 'Based on current, complete market data.'],
].map(([k, b, a], i) => ({ n: '0' + (i + 1), k, b, a }));

const useIcons = ['intelligence', 'optimize', 'decision', 'alert', 'compare', 'data'];
const uses = [
  ['Weekly pricing review', 'Walk into the meeting with the market already summarized and prioritized.'],
  ['Category performance checks', 'See which categories are slipping or winning on price at a glance.'],
  ['Competitor response planning', "Understand a rival's move and its impact before you respond."],
  ['Promotion monitoring', 'Track competitor promotions and discount depth as they happen.'],
  ['Marketplace position review', 'Compare your standing across each marketplace and channel.'],
  ['Executive pricing updates', 'Share a clean, board-ready snapshot of market position in seconds.'],
].map(([t, d], i) => ({ t, d, n: '0' + (i + 1), icon: useIcons[i] || 'engine' }));
const statsMeta = [
  { l: 'SKUs monitored across a single catalog.' },
  { l: 'Buy Box win rate, before and after.' },
  { l: 'Gross margin recovered through better positioning.' },
  { l: 'SKU catalog readiness, without slowdown.' },
];
const planData = [
  { n: 'Starter', price: '$89', sku: 'Up to 1,500 products / month', cta: 'Start with Starter', pop: false, f: ['Track 5 competitors', 'Daily price refresh, 1× per day', 'Real-time competitor price tracking', 'Email price alerts', 'Basic pricing rules engine', 'CSV export & dashboard access', 'REST API access'] },
  { n: 'Growth', price: '$159', sku: 'Up to 3,000 products / month', cta: 'Choose Growth', pop: true, f: ['Everything in Starter', 'Track 5 competitors', 'Daily price refresh, 2× per day', 'Advanced pricing rules & auto-response', 'Margin protection system', 'Slack & webhook alerts', 'Decision engine & auto-response'] },
  { n: 'Scale', price: '$299', sku: 'Up to 6,000 products / month', cta: 'Choose Scale', pop: false, f: ['Everything in Growth', 'Track 5 competitors', 'Daily price refresh, 3× per day', 'Priority alert processing', 'Full automation mode', 'Advanced ERP integration', 'Dedicated onboarding support'] },
];
const plans = planData.map((pl) => ({ ...pl, bd: pl.pop ? '1.5px solid var(--pl-accent)' : '1px solid var(--pl-line)', sh: pl.pop ? '0 0 0 6px rgba(247,99,30,.1),0 30px 60px -36px rgba(194,65,12,.5)' : 'none', btnBg: pl.pop ? 'var(--pl-accent)' : 'var(--pl-surface)', btnBc: pl.pop ? 'var(--pl-accent)' : 'var(--pl-line)', f: pl.f.map((t) => ({ t, c: t.startsWith('Everything') ? 'var(--pl-ink)' : 'var(--pl-ink-2)', w: t.startsWith('Everything') ? 600 : 400 })) }));
const faqs = [
  ['What is a Price Intelligence Engine?', "It's the layer that organizes competitor prices, availability, product matches, history, and channel signals into one trusted view of your market position — so your team reads answers, not raw exports."],
  ['How is this different from price tracking?', 'Price tracking tells you what a price is. The Price Intelligence Engine tells you what it means — where you stand, who moved, and what changed in context — so a single number becomes a decision signal.'],
  ['What data does it use?', 'Competitor prices, product availability, verified product matches, full price history, and channel-level signals across the marketplaces and sites you choose to track.'],
  ['Does it automatically change prices?', 'No. The Price Intelligence Engine is the intelligence layer — it explains the market. Acting on it is the job of the separate Pricing Decision and Margin Protection Engines, which you control.'],
  ['Can we track our own competitor set?', 'Yes. You define exactly which competitors, marketplaces, and channels matter for your catalog, and the engine builds your market view around that set.'],
  ['How often is the data refreshed?', 'Refresh frequency scales with your plan — from once daily on Starter up to three times daily on Scale, with custom cadence available for larger catalogs.'],
  ['How is pricing calculated?', "Plan pricing is based on the number of products monitored per month and refresh frequency. Need more competitors, SKUs, or a custom cadence? We'll scope a plan to your setup."],
].map(([q, a], i) => ({ q, a, open: i === 0, n: '0' + (i + 1) }));
const partners = [['Automation Anywhere', 'Partner'], ['Google Cloud', 'Partner'], ['Microsoft', 'Partner'], ['Adobe', 'Solution Partner'], ['AWS', 'Partner Network']].map(([t, s]) => ({ t, s }));
---
<PriceLeapLayout
  title="Price Intelligence Engine · PriceLeap"
  description="PriceLeap shows where your prices stand, which competitors moved, and what changed across products, channels, and categories."
>
  <div class="pie" style="min-height:100vh;background:var(--pl-surface);overflow-x:clip">

    <!-- SUBNAV (scrollspy + progress) -->
    <div class="pie-subnav" style="position:sticky;top:64px;z-index:55;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--pl-line-soft)">
      <div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,40px);height:46px;display:flex;align-items:center;gap:20px">
        <span style="flex:none;display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--pl-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>Price Intelligence</span>
        <nav style="display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0">
          {subItems.map(([id, t]) => (<a href={`#${id}`} data-pie-sub={id} style={`flex:none;height:30px;padding:0 10px;display:flex;align-items:center;border-radius:8px;font-size:13px;color:${id === 'overview' ? 'var(--pl-ink)' : 'var(--pl-muted)'};background:${id === 'overview' ? 'var(--pl-sand)' : 'transparent'};transition:background .2s,color .2s`}>{t}</a>))}
        </nav>
      </div>
      <div data-pie-progress style="height:2px;background:var(--pl-gradient);width:0%;transition:width .15s linear"></div>
    </div>

    <!-- HERO -->
    <section id="top" style="position:relative;border-bottom:1px solid var(--pl-line);overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%);mask-image:radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-10%;top:-20%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.14),transparent);pointer-events:none"></div>
      <div class="pie-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,40px) clamp(48px,6vw,80px);gap:clamp(40px,5vw,64px);align-items:center">
        <div style="min-width:0">
          <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--pl-muted)"><a href="/" style="color:var(--pl-muted)">Product</a><span style="color:var(--pl-line-xstrong)">/</span><span style="color:var(--pl-ink)">Price Intelligence Engine</span></div>
          <span style="margin-top:28px;display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.8s ease-out infinite"></span>Price Intelligence Engine</span>
          <h1 style="margin:18px 0 0;font-family:Geist,sans-serif;font-size:clamp(38px,5.4vw,68px);line-height:1.02;letter-spacing:-.045em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">Turn competitor price movement into </span><span style="font-weight:700">pricing intelligence.</span></h1>
          <p style="margin:22px 0 0;max-width:560px;font-size:18px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">PriceLeap shows where your prices stand, which competitors moved, and what changed across products, channels, and categories — before your team decides what to do next.</p>
          <div style="margin-top:30px;display:flex;flex-wrap:wrap;gap:10px">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Get a demo</a>
            <a href="#how" style="height:48px;padding:0 20px;display:inline-flex;align-items:center;gap:10px;border-radius:12px;background:var(--pl-surface);border:1px solid var(--pl-line);color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">See how it works<span style="color:var(--pl-accent-ink)">→</span></a>
          </div>
          <div style="margin-top:32px;display:flex;flex-wrap:wrap;gap:8px 20px">
            <span style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--pl-ink-2)"><span style="width:18px;height:18px;border-radius:50%;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);color:var(--pl-accent-ink);font-size:10px;display:flex;align-items:center;justify-content:center">✓</span>Verified, QC-checked matches</span>
            <span style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--pl-ink-2)"><span style="width:18px;height:18px;border-radius:50%;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);color:var(--pl-accent-ink);font-size:10px;display:flex;align-items:center;justify-content:center">✓</span>Refreshed up to 3× daily</span>
            <span style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--pl-ink-2)"><span style="width:18px;height:18px;border-radius:50%;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);color:var(--pl-accent-ink);font-size:10px;display:flex;align-items:center;justify-content:center">✓</span>Built for 50K+ SKU catalogs</span>
          </div>
        </div>

        <div style="position:relative;min-width:0">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;box-shadow:0 40px 80px -40px rgba(60,30,15,.28),0 0 0 6px rgba(255,255,255,.7);overflow:hidden">
            <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)">
              <span style="display:flex;gap:5px"><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span><span style="width:9px;height:9px;border-radius:50%;background:var(--pl-line)"></span></span>
              <span style="font-size:13px;font-weight:500;color:var(--pl-ink)">Market position</span>
              <span style="font-size:12px;color:var(--pl-faint)">· All channels</span>
              <span style="margin-left:auto;display:flex;align-items:center;gap:6px;height:22px;padding:0 8px;border-radius:999px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span>LIVE</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--pl-line-soft);border-bottom:1px solid var(--pl-line-soft)">
              <div style="background:var(--pl-surface);padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">PRICE INDEX</div><div data-pie-index style="margin-top:4px;font-family:Geist,sans-serif;font-size:24px;font-weight:600;letter-spacing:-.03em;color:var(--pl-ink)">101.8</div></div>
              <div style="background:var(--pl-surface);padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">MOVED · 24H</div><div data-pie-moved style="margin-top:4px;font-family:Geist,sans-serif;font-size:24px;font-weight:600;letter-spacing:-.03em;color:var(--pl-ink)">37</div></div>
              <div style="background:var(--pl-surface);padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)">MATCH QC</div><div style="margin-top:4px;font-family:Geist,sans-serif;font-size:24px;font-weight:600;letter-spacing:-.03em;color:var(--pl-accent-ink)">99.1%</div></div>
            </div>
            <div style="padding:6px 16px 10px">
              <div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1.4fr) 76px;gap:14px;padding:8px 0;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)"><span>PRODUCT</span><span>YOU VS MARKET RANGE</span><span style="text-align:right">POSITION</span></div>
              {heroRowsInit.map((r, i) => (
                <div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1.4fr) 76px;gap:14px;align-items:center;padding:11px 0;border-top:1px solid var(--pl-line-soft)">
                  <div style="min-width:0"><div style="font-size:13px;font-weight:500;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{r.n}</div><div style="font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-muted)">{r.you}</div></div>
                  <div style="position:relative;height:18px">
                    <span style="position:absolute;left:0;right:0;top:8px;height:2px;border-radius:2px;background:var(--pl-line-soft)"></span>
                    <span style={`position:absolute;left:${r.lo}%;width:${r.span}%;top:6px;height:6px;border-radius:6px;background:var(--pl-line-alt)`}></span>
                    <span style="position:absolute;left:50%;top:2px;width:1px;height:14px;background:var(--pl-line-xstrong)"></span>
                    <span data-pie-herodot={i} style={`position:absolute;left:${r.pos}%;top:9px;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:${r.dot};border:2px solid var(--pl-surface);box-shadow:0 0 0 1px ${r.dot};transition:left .9s cubic-bezier(.2,.7,.2,1)`}></span>
                  </div>
                  <span data-pie-herotag={i} style={`justify-self:end;height:22px;padding:0 8px;display:inline-flex;align-items:center;border-radius:6px;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.04em;background:${r.tbg};border:1px solid ${r.tbc};color:${r.tc};white-space:nowrap`}>{r.tag}</span>
                </div>
              ))}
            </div>
            <div style="border-top:1px solid var(--pl-line-soft);background:var(--pl-cream);padding:12px 16px;display:flex;align-items:center;gap:10px;min-height:52px">
              <span data-pie-movearrow style="flex:none;width:26px;height:26px;border-radius:8px;background:var(--pl-surface);border:1px solid var(--pl-line);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--pl-danger-ink)">▼</span>
              <div data-pie-movebody style="min-width:0;flex:1;font-size:13px;color:var(--pl-ink-2);animation:pi-in .45s ease;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><b style="font-weight:600;color:var(--pl-ink)">Retailer B</b> moved Earbuds Pro 2 <span style="font-family:'Geist Mono',monospace;color:var(--pl-danger-ink)">▼ 6.2%</span></div>
              <span data-pie-movet style="flex:none;font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-faint)">2 MIN AGO</span>
            </div>
          </div>
          <div class="pie-herobadge" style="position:absolute;left:-28px;bottom:-22px;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:14px;padding:10px 14px;box-shadow:0 20px 40px -24px rgba(60,30,15,.35);align-items:center;gap:10px">
            <span style="width:28px;height:28px;border-radius:8px;background:var(--pl-gradient);color:var(--pl-surface);display:flex;align-items:center;justify-content:center;font-size:13px">✓</span>
            <div><div style="font-size:12px;font-weight:600;color:var(--pl-ink)">Like-for-like match</div><div style="font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-muted)">Pack size · variant · seller</div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGOS -->
    <section style="border-bottom:1px solid var(--pl-line)">
      <div class="pie-logos" style="max-width:1280px;margin:0 auto;display:grid">
        <div class="pie-logolabel" style="padding:22px clamp(20px,4vw,40px);display:flex;align-items:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-muted)">Used by pricing teams at</div>

---
/**
 * Price Intelligence Engine — native rebuild on the shared light design system.
 * Layout: SiteLayout. Content ported 1:1 from the
 * original design; bespoke JS widgets re-expressed as clean CSS/markup.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHeader from '@/components/ds/nav/SectionHeader.astro';
import Tabs from '@/components/ds/nav/Tabs.astro';
import FeatureGrid from '@/components/ds/content/FeatureGrid.astro';
import StatsStrip from '@/components/ds/content/StatsStrip.astro';
import FAQ from '@/components/ds/faq/FAQ.astro';
import CTA from '@/components/ds/cta/CTA.astro';

// ── Content (ported from the source page) ──
const heroRows = [
  { n: 'Sonix ANC 700 Headphones', you: 'You $189.00', lo: 18, span: 54, pos: 28, tag: 'BELOW' },
  { n: 'Earbuds Pro 2 · White',    you: 'You $159.00', lo: 22, span: 40, pos: 74, tag: 'ABOVE' },
  { n: 'SmartFit Watch 46mm',      you: 'You $249.00', lo: 14, span: 62, pos: 50, tag: 'IN LINE' },
  { n: 'Portable Speaker Mini 4',  you: 'You $79.00',  lo: 30, span: 44, pos: 46, tag: 'IN LINE' },
];
const tagStyle = {
  'BELOW':   { bg: '#E8FCEF', bc: '#FFD6C8', c: '#B01C1C', dot: '#FF3131' },
  'ABOVE':   { bg: '#FDECEB', bc: '#F5C6C3', c: '#C9372E', dot: '#E5483F' },
  'IN LINE': { bg: '#F4F5F4', bc: '#E6E8E6', c: '#3A414C', dot: '#0A0A0A' },
};
const logos = ['apoBank', 'McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho'];

const overview = [
  { n: '1', t: 'Collects market data', d: 'Competitor prices, stock status, promotions, and price history from the channels you sell in.' },
  { n: '2', t: 'Matches it to your catalog', d: 'Links each competitor listing to the right product so every comparison is like-for-like.' },
  { n: '3', t: 'Shows your position', d: 'Highlights where you are above, below, or in line with the market, and which competitors moved.' },
];

const problems = [
  { n: '01', t: 'Competitor prices change before weekly reports are ready.', tag: 'STALE' },
  { n: '02', t: 'Spreadsheet checks miss product-level context.', tag: 'NO CONTEXT' },
  { n: '03', t: 'One bad product match can trigger the wrong pricing move.', tag: 'MISMATCH' },
  { n: '04', t: 'Teams lose time debating screenshots, exports, and stale market views.', tag: 'DEBATE' },
];

const flowIn = ['Competitor prices', 'Availability', 'Product matches', 'Price history', 'Channel signals'];
const flowOut = ['Market position', 'Price gaps', 'Alerts', 'Decision signals'];

const caps = [
  { t: 'Market position intelligence', d: 'See exactly where you sit against the market — by product, category, and channel — in a single index you can trust.', b1: 'Live price index that rolls up to category and channel views.', b2: "See where you're below, at, or above market at a glance." },
  { t: 'Competitor movement detection', d: 'Know which competitors moved, on which products, and by how much — the moment it happens, not next week.', b1: 'Movement feed grouped by competitor, category, and direction.', b2: 'Filters out noise so only meaningful changes surface.' },
  { t: 'Price history & trend context', d: 'Every price comes with its history — so a single data point becomes a trend your team can read with confidence.', b1: 'Side-by-side history for you and each tracked competitor.', b2: 'Spot recurring promo cycles and pricing patterns over time.' },
  { t: 'Decision-ready alerts', d: 'Alerts arrive with the context to act on — what changed, why it matters, and where you now stand.', b1: 'Prioritized by impact, not just by what moved.', b2: 'Routed to email, Slack, or webhook with full context attached.' },
];

const compare = [
  { n: '01', k: 'Collecting prices', b: 'Analysts check competitor sites by hand and paste prices into spreadsheets.', a: 'Competitor prices, stock, and promotions are collected automatically.' },
  { n: '02', k: 'Product matching', b: 'Listings are compared by name, so pack sizes and variants get mixed up.', a: 'Each competitor listing is matched to the right product for like-for-like comparison.' },
  { n: '03', k: 'Spotting changes', b: 'Competitor moves are noticed late, often after sales have already shifted.', a: 'Alerts flag which competitors moved and which products are affected.' },
  { n: '04', k: 'Market position', b: 'No single view of where you sit across channels and categories.', a: 'One view shows where you are above, below, or in line with the market.' },
  { n: '05', k: 'Reporting', b: 'Hours spent building slides before every pricing review.', a: 'Shareable market snapshots ready for reviews and leadership updates.' },
  { n: '06', k: 'Pricing decisions', b: 'Based on partial data and gut feel.', a: 'Based on current, complete market data.' },
];

const catRows = [
  { n: 'Headphones', v: -6.2 }, { n: 'Wearables', v: 3.4 }, { n: 'Speakers', v: -2.1 },
  { n: 'Accessories', v: 7.8 }, { n: 'Smart home', v: 0.6 },
];
const feed = [
  { who: 'Retailer B',    what: 'Earbuds Pro 2',        cat: 'HEADPHONES',  t: '2m',  d: '−6.2%', down: true },
  { who: 'Marketplace A', what: 'SmartFit Watch 46mm',  cat: 'WEARABLES',   t: '9m',  d: '+3.1%', down: false },
  { who: 'D2C store C',   what: 'Speaker Mini 4',       cat: 'SPEAKERS',    t: '14m', d: '−4.0%', down: true },
  { who: 'Retailer B',    what: 'Sonix ANC 700',        cat: 'HEADPHONES',  t: '31m', d: '−2.5%', down: true },
  { who: 'Marketplace D', what: 'Charging Dock 3-in-1', cat: 'ACCESSORIES', t: '48m', d: '+5.0%', down: false },
];

const uses = [
  { t: 'Weekly pricing review', d: 'Walk into the meeting with the market already summarized and prioritized.' },
  { t: 'Category performance checks', d: 'See which categories are slipping or winning on price at a glance.' },
  { t: 'Competitor response planning', d: "Understand a rival's move and its impact before you respond." },
  { t: 'Promotion monitoring', d: 'Track competitor promotions and discount depth as they happen.' },
  { t: 'Marketplace position review', d: 'Compare your standing across each marketplace and channel.' },
  { t: 'Executive pricing updates', d: 'Share a clean, board-ready snapshot of market position in seconds.' },
];

const stats = [
  { value: '8,000', label: 'SKUs monitored across a single catalog.' },
  { value: '28%→90%+', label: 'Buy Box win rate, before and after.' },
  { value: '~19%', label: 'Gross margin recovered through better positioning.' },
  { value: '50K+', label: 'SKU catalog readiness, without slowdown.' },
];

const plans = [
  { n: 'Starter', price: '$89',  sku: 'Up to 1,500 products / month', cta: 'Start with Starter', pop: false, f: ['Track 5 competitors', 'Daily price refresh, 1× per day', 'Real-time competitor price tracking', 'Email price alerts', 'Basic pricing rules engine', 'CSV export & dashboard access', 'REST API access'] },
  { n: 'Growth',  price: '$159', sku: 'Up to 3,000 products / month', cta: 'Choose Growth', pop: true,  f: ['Everything in Starter', 'Track 5 competitors', 'Daily price refresh, 2× per day', 'Advanced pricing rules & auto-response', 'Margin protection system', 'Slack & webhook alerts', 'Decision engine & auto-response'] },
  { n: 'Scale',   price: '$299', sku: 'Up to 6,000 products / month', cta: 'Choose Scale', pop: false, f: ['Everything in Growth', 'Track 5 competitors', 'Daily price refresh, 3× per day', 'Priority alert processing', 'Full automation mode', 'Advanced ERP integration', 'Dedicated onboarding support'] },
];

const faqs = [
  { q: 'What is a Price Intelligence Engine?', a: "It's the layer that organizes competitor prices, availability, product matches, history, and channel signals into one trusted view of your market position — so your team reads answers, not raw exports." },
  { q: 'How is this different from price tracking?', a: 'Price tracking tells you what a price is. The Price Intelligence Engine tells you what it means — where you stand, who moved, and what changed in context — so a single number becomes a decision signal.' },
  { q: 'What data does it use?', a: 'Competitor prices, product availability, verified product matches, full price history, and channel-level signals across the marketplaces and sites you choose to track.' },
  { q: 'Does it automatically change prices?', a: 'No. The Price Intelligence Engine is the intelligence layer — it explains the market. Acting on it is the job of the separate Pricing Decision and Margin Protection Engines, which you control.' },
  { q: 'Can we track our own competitor set?', a: 'Yes. You define exactly which competitors, marketplaces, and channels matter for your catalog, and the engine builds your market view around that set.' },
  { q: 'How often is the data refreshed?', a: 'Refresh frequency scales with your plan — from once daily on Starter up to three times daily on Scale, with custom cadence available for larger catalogs.' },
  { q: 'How is pricing calculated?', a: "Plan pricing is based on the number of products monitored per month and refresh frequency. Need more competitors, SKUs, or a custom cadence? We'll scope a plan to your setup." },
];

const partners = ['Automation Anywhere', 'Google Cloud', 'Microsoft', 'Adobe', 'AWS'];
const certs = [
  { t: 'ISO 9001', s: 'Quality', src: '/assets/iso-9001.webp' },
  { t: 'ISO 27001', s: 'Security', src: '/assets/iso-27001.avif' },
  { t: 'GDPR', s: 'Compliant', src: '/assets/gdpr.webp' },
  { t: 'HIPAA', s: 'Compliant', ab: 'HIPAA' },
  { t: 'Forbes', s: 'Featured', ab: 'F' },
];

const catMax = Math.max(...catRows.map(c => Math.abs(c.v)));
---

<SiteLayout
  title="Price Intelligence Engine · PriceLeap"
  description="PriceLeap shows where your prices stand, which competitors moved, and what changed across products, channels, and categories."
>

  <!-- ══ HERO ══ -->
  <section class="pie-hero">
    <div class="pie-hero__grid" aria-hidden="true"></div>
    <div class="pie-hero__glow" aria-hidden="true"></div>
    <div class="pie-wrap pie-hero__inner">
      <div class="pie-hero__copy">
        <nav class="pie-crumb"><a href="/light">Product</a><span>/</span><span>Price Intelligence Engine</span></nav>
        <span class="pie-eyebrow"><span class="pie-eyebrow__dot"></span>Price Intelligence Engine</span>
        <h1 class="pie-h1"><span class="w4">Turn competitor price movement into </span><b>pricing intelligence.</b></h1>
        <p class="pie-lead">PriceLeap shows where your prices stand, which competitors moved, and what changed across products, channels, and categories — before your team decides what to do next.</p>
        <div class="pie-hero__btns">
          <a href="/book-a-demo" class="pie-btn pie-btn--primary">Get a demo</a>
          <a href="#how" class="pie-btn pie-btn--secondary">See how it works <span>→</span></a>
        </div>
        <div class="pie-hero__ticks">
          {['Verified, QC-checked matches', 'Refreshed up to 3× daily', 'Built for 50K+ SKU catalogs'].map(t => (
            <span class="pie-tick"><span class="pie-tick__ic">✓</span>{t}</span>
          ))}
        </div>
      </div>

      <!-- Market position card -->
      <div class="pie-hero__card-wrap">
        <div class="pie-card">
          <div class="pie-card__head">
            <span class="pie-dots"><i></i><i></i><i></i></span>
            <span class="pie-card__title">Market position</span>
            <span class="pie-card__sub">· All channels</span>
            <span class="pie-live"><span class="pie-live__dot"></span>LIVE</span>
          </div>
          <div class="pie-card__kpis">
            <div><span class="pie-k">PRICE INDEX</span><span class="pie-v">101.8</span></div>
            <div><span class="pie-k">MOVED · 24H</span><span class="pie-v">37</span></div>
            <div><span class="pie-k">MATCH QC</span><span class="pie-v" style="color:#B01C1C">99.1%</span></div>
          </div>
          <div class="pie-card__rows">
            <div class="pie-rowhead"><span>PRODUCT</span><span>YOU VS MARKET RANGE</span><span style="text-align:right">POSITION</span></div>
            {heroRows.map(r => {
              const s = tagStyle[r.tag as keyof typeof tagStyle];
              return (
                <div class="pie-row">
                  <div class="pie-row__name"><div class="pie-row__n">{r.n}</div><div class="pie-row__you">{r.you}</div></div>
                  <div class="pie-row__bar">
                    <span class="pie-bar__track"></span>
                    <span class="pie-bar__span" style={`left:${r.lo}%;width:${r.span}%`}></span>
                    <span class="pie-bar__mid"></span>
                    <span class="pie-bar__dot" style={`left:${r.pos}%;background:${s.dot};box-shadow:0 0 0 1px ${s.dot}`}></span>
                  </div>
                  <span class="pie-row__tag" style={`background:${s.bg};border-color:${s.bc};color:${s.c}`}>{r.tag}</span>
                </div>
              );
            })}
          </div>
          <div class="pie-card__foot">
            <span class="pie-card__arrow" style="color:#C9372E">▼</span>
            <div class="pie-card__move"><b>Retailer B</b> moved Earbuds Pro 2 <span style="font-family:var(--pl-mono);color:#C9372E">▼ 6.2%</span></div>
            <span class="pie-card__ago">2 MIN AGO</span>
          </div>
        </div>
        <div class="pie-card__badge">
          <span class="pie-card__badge-ic">✓</span>
          <div><div class="pie-card__badge-t">Like-for-like match</div><div class="pie-card__badge-s">Pack size · variant · seller</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ LOGOS ══ -->
  <section class="pie-logos">
    <div class="pie-wrap pie-logos__inner">
      <div class="pie-logos__label">Used by pricing teams at</div>
      <div class="pie-logos__track">
        <div class="pie-logos__marquee">
          {[...logos, ...logos].map(l => <span class="pie-logo">{l}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ OVERVIEW ══ -->
  <section id="overview" class="pie-sec">
    <div class="pie-wrap">
      <div class="pie-split-head" data-reveal>
        <div>
          <span class="pie-eyebrow"><span class="pie-eyebrow__sq"></span>Overview</span>
          <h2 class="pie-h2"><span class="w4">What is the </span><b>Price Intelligence Engine?</b></h2>
        </div>
        <p class="pie-split-lead">The Price Intelligence Engine is the market-monitoring layer of PriceLeap. It collects competitor prices and availability, matches them to your products, and shows where you stand across products, channels, and categories.</p>
      </div>
      <div class="pie-overview" data-reveal>
        {overview.map(o => (
          <div class="pie-ov">
            <div class="pie-ov__head"><span class="pie-ov__n">{o.n}</span><span class="pie-ov__t">{o.t}</span></div>
            <p class="pie-ov__d">{o.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ PROBLEM ══ -->
  <section id="problem" class="pie-sec pie-sec--tint">
    <div class="pie-wrap pie-problem">
      <div class="pie-problem__head" data-reveal>
        <span class="pie-eyebrow pie-eyebrow--red"><span class="pie-eyebrow__sq" style="background:#E5483F"></span>The real problem</span>
        <h2 class="pie-h2"><span class="w4">Pricing teams don't need more raw data. </span><b>They need trusted answers.</b></h2>
      </div>
      <div class="pie-problem__list">
        {problems.map(p => (
          <div class="pie-prob" data-reveal>
            <span class="pie-prob__n">{p.n}</span>
            <span class="pie-prob__t">{p.t}</span>
            <span class="pie-prob__tag"><span class="pie-prob__tagdot"></span>{p.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHAT IT DOES (inputs → engine → outputs) ══ -->
  <section id="how" class="pie-sec">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader
          eyebrow="What it does"
          title="What the Price Intelligence Engine"
          accent="does"
          lead="The Price Intelligence Engine organizes competitor prices, availability, product matches, price history, and channel signals into a clear view of your market position."
          align="center"
        />
      </div>
      <div class="pie-flow" data-reveal>
        <div class="pie-flow__col">
          <div class="pie-flow__lbl">INPUTS</div>
          <div class="pie-flow__items">
            {flowIn.map(f => <div class="pie-flow__chip">{f}</div>)}
          </div>
        </div>
        <div class="pie-flow__engine">
          <div class="pie-flow__engine-lbl">PRICELEAP</div>
          <div class="pie-flow__engine-t">Price Intelligence Engine</div>
          <div class="pie-flow__engine-d">Organizes, matches &amp; contextualizes the market in real time.</div>
          <div class="pie-flow__engine-tags"><span>ORGANIZE</span><span>MATCH</span><span class="on">CONTEXT</span></div>
        </div>
        <div class="pie-flow__col pie-flow__col--out">
          <div class="pie-flow__lbl pie-flow__lbl--out">OUTPUTS</div>
          <div class="pie-flow__items">
            {flowOut.map(f => <div class="pie-flow__chip pie-flow__chip--out">{f}</div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CAPABILITIES (tabs) ══ -->
  <section id="capabilities" class="pie-sec pie-sec--tint">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Capabilities" title="Everything your team reads before a" accent="pricing decision." align="center" />
      </div>
      <div class="pie-caps" data-reveal>
        <Tabs tabs={caps.map(c => c.t)} id="pie-caps" variant="underline">
          <div slot="panel-0"><div class="pie-cap"><p class="pie-cap__d">{caps[0].d}</p><ul class="pie-cap__list"><li><span class="pie-cap__tick">✓</span>{caps[0].b1}</li><li><span class="pie-cap__tick">✓</span>{caps[0].b2}</li></ul></div></div>
          <div slot="panel-1"><div class="pie-cap"><p class="pie-cap__d">{caps[1].d}</p><ul class="pie-cap__list"><li><span class="pie-cap__tick">✓</span>{caps[1].b1}</li><li><span class="pie-cap__tick">✓</span>{caps[1].b2}</li></ul></div></div>
          <div slot="panel-2"><div class="pie-cap"><p class="pie-cap__d">{caps[2].d}</p><ul class="pie-cap__list"><li><span class="pie-cap__tick">✓</span>{caps[2].b1}</li><li><span class="pie-cap__tick">✓</span>{caps[2].b2}</li></ul></div></div>
          <div slot="panel-3"><div class="pie-cap"><p class="pie-cap__d">{caps[3].d}</p><ul class="pie-cap__list"><li><span class="pie-cap__tick">✓</span>{caps[3].b1}</li><li><span class="pie-cap__tick">✓</span>{caps[3].b2}</li></ul></div></div>
        </Tabs>
      </div>
    </div>
  </section>

  <!-- ══ BEFORE & AFTER ══ -->
  <section id="compare" class="pie-sec">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Before and after" title="How pricing work changes with" accent="PriceLeap." align="center" />
      </div>
      <div class="pie-cmp" data-reveal>
        <div class="pie-cmp__head">
          <span></span>
          <span class="pie-cmp__hb">Before · manual</span>
          <span class="pie-cmp__ha">After · PriceLeap</span>
        </div>
        {compare.map(c => (
          <div class="pie-cmp__row">
            <div class="pie-cmp__k"><span class="pie-cmp__n">{c.n}</span>{c.k}</div>
            <div class="pie-cmp__b">{c.b}</div>
            <div class="pie-cmp__a"><span class="pie-cmp__atick">✓</span>{c.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ PLATFORM (category movers + live feed) ══ -->
  <section id="platform" class="pie-sec pie-sec--tint">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Platform" title="Intelligence first. Decisions next." accent="Margins protected." align="center" />
      </div>
      <div class="pie-plat" data-reveal>
        <div class="pie-plat__card">
          <div class="pie-plat__title">Category movement · 24h</div>
          <div class="pie-cats">
            {catRows.map(c => {
              const wd = Math.abs(c.v) / catMax * 48;
              const neg = c.v < 0;
              const col = neg ? '#FF3131' : c.v > 3 ? '#E5483F' : '#C4CAC4';
              const tc = neg ? '#B01C1C' : c.v > 3 ? '#C9372E' : '#3A414C';
              return (
                <div class="pie-cat">
                  <span class="pie-cat__n">{c.n}</span>
                  <span class="pie-cat__track">
                    <span class="pie-cat__fill" style={`width:${wd}%;${neg ? 'right' : 'left'}:50%;background:${col}`}></span>
                    <span class="pie-cat__mid"></span>
                  </span>
                  <span class="pie-cat__v" style={`color:${tc}`}>{c.v > 0 ? '+' : ''}{c.v.toFixed(1)}%</span>
                </div>
              );
            })}
          </div>
        </div>
        <div class="pie-plat__card">
          <div class="pie-plat__title">Live movement feed</div>
          <div class="pie-feed">
            {feed.map(m => (
              <div class="pie-feed__row">
                <span class="pie-feed__a" style={`background:${m.down ? '#FDECEB' : '#E8FCEF'};color:${m.down ? '#C9372E' : '#B01C1C'}`}>{m.down ? '▼' : '▲'}</span>
                <div class="pie-feed__meta"><b>{m.who}</b> · {m.what}<span class="pie-feed__cat">{m.cat}</span></div>
                <span class="pie-feed__d" style={`color:${m.down ? '#C9372E' : '#B01C1C'}`}>{m.d}</span>
                <span class="pie-feed__t">{m.t}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHERE TEAMS USE IT ══ -->
  <section class="pie-sec">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Where teams use it" title="One market view, used across the" accent="pricing week." align="center" />
      </div>
      <div data-reveal style="margin-top:40px">
        <FeatureGrid variant="numbered" min="300px" items={uses.map(u => ({ title: u.t, body: u.d }))} />
      </div>
    </div>
  </section>

  <!-- ══ BUILT FOR SCALE ══ -->
  <section class="pie-sec pie-sec--tint">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Built for scale" title="Built for pricing work at real" accent="catalog scale." align="center" />
      </div>
      <div data-reveal style="margin-top:40px;border:1px solid var(--pl-line);border-radius:20px;overflow:hidden">
        <StatsStrip items={stats} />
      </div>
    </div>
  </section>

  <!-- ══ PRICING ══ -->
  <section id="pricing" class="pie-sec">
    <div class="pie-wrap">
      <div data-reveal>
        <SectionHeader eyebrow="Pricing" title="Choose the plan that fits your" accent="catalog size." align="center" />
      </div>
      <div class="pie-plans" data-reveal>
        {plans.map(p => (
          <div class={`pie-plan${p.pop ? ' pie-plan--pop' : ''}`}>
            {p.pop && <span class="pie-plan__badge">MOST POPULAR</span>}
            <div class="pie-plan__name">{p.n}</div>
            <div class="pie-plan__price">{p.price}<span>/mo</span></div>
            <div class="pie-plan__sku">{p.sku}</div>
            <a href="/book-a-demo" class={`pie-plan__cta${p.pop ? ' pie-plan__cta--pop' : ''}`}>{p.cta}</a>
            <ul class="pie-plan__feats">
              {p.f.map(f => <li><span class="pie-plan__tick">✓</span><span class={f.startsWith('Everything') ? 'pie-plan__f--bold' : ''}>{f}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section id="faq" class="pie-sec pie-sec--tint">
    <div class="pie-wrap pie-faq">
      <div data-reveal>
        <SectionHeader eyebrow="FAQ" title="Questions pricing teams ask" accent="first." align="center" />
      </div>
      <div data-reveal style="margin-top:36px">
        <FAQ items={faqs} variant="list" />
      </div>
    </div>
  </section>


          <div style="background:var(--pl-surface);padding:18px;display:flex;align-items:center;justify-content:center;gap:12px;min-height:96px"><span style="width:44px;height:44px;border-radius:50%;border:1.5px solid var(--pl-accent);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:500;color:var(--pl-accent-ink)">HIPAA</span><span style="display:flex;flex-direction:column"><span style="font-family:Geist,sans-serif;font-size:15px;font-weight:600;color:var(--pl-ink)">HIPAA</span><span style="font-size:12.5px;color:var(--pl-muted)">Compliant</span></span></div>
          <div style="background:var(--pl-surface);padding:18px;display:flex;align-items:center;justify-content:center;gap:12px;min-height:96px"><span style="width:44px;height:44px;border-radius:50%;border:1.5px solid var(--pl-accent);display:flex;align-items:center;justify-content:center;font-family:'Geist Mono',monospace;font-size:10px;font-weight:500;color:var(--pl-accent-ink)">F</span><span style="display:flex;flex-direction:column"><span style="font-family:Geist,sans-serif;font-size:15px;font-weight:600;color:var(--pl-ink)">Forbes</span><span style="font-size:12.5px;color:var(--pl-muted)">Featured</span></span></div>
        </div>

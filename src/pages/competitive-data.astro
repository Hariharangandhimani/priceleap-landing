</PriceLeapLayout>

<style>
  .cd { background: #FFFCF9; overflow-x: clip; }
  @keyframes cd-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 9px rgba(247,99,30,0); } }
  @keyframes cd-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes cd-pop { 0% { opacity: 0; transform: scale(.92); } 100% { opacity: 1; transform: none; } }
  @keyframes cd-spin { to { transform: rotate(360deg); } }
  @keyframes cd-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes cd-flash { 0%,100% { background: transparent; } 35% { background: #FFF4EC; } }
  @media (prefers-reduced-motion: reduce) { .cd *, .cd *::before, .cd *::after { animation: none !important; transition: none !important; } }

  .cd-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .cd-split { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); } }

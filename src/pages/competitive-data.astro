  @media (min-width: 1024px) { .cd-sticky { position: sticky; } }
  .cd-kpi { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
  @media (min-width: 720px) { .cd-kpi { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .cd-pillar { grid-template-columns: 1fr; }
  @media (min-width: 560px) { .cd-pillar { grid-template-columns: 1fr 1fr; } }
  .cd-prob { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cd-prob { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1100px) { .cd-prob { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .cd-steps { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cd-steps { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 980px) { .cd-steps { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .cd-step-track, .cd-step-fill { display: none; }
  @media (min-width: 980px) { .cd-step-track, .cd-step-fill { display: block; } }
  .cd-radio { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .cd-radio { grid-template-columns: 1fr 1fr; } }
  .cd-sched { grid-template-columns: 1fr; }
  @media (min-width: 720px) { .cd-sched { grid-template-columns: minmax(0,1.3fr) minmax(0,1.2fr) auto auto; } }
  .cd-field { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .cd-field { grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr); } }
  .cd-ft, .cd-frow { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: 12px; align-items: start; padding: 13px 18px; border-bottom: 1px solid #F5ECE5; }
  .cd-ft-where { display: none; }
  @media (min-width: 720px) { .cd-ft, .cd-frow { grid-template-columns: minmax(0,.8fr) minmax(0,1.4fr) minmax(0,.9fr); } .cd-ft-where { display: block; } .cd-ft-wmob { display: none; } }
  .cd-ft-wmob { display: block; }
  .cd-refresh { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .cd-refresh { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); } }
  .cd-proof { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .cd-proof { grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); } }
  .cd-match-card { order: 1; }
  @media (min-width: 1024px) { .cd-match-card { order: 0; } }
  .cd-plans { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .cd-plans { grid-template-columns: repeat(3,minmax(0,1fr)); } }

  .cd-frow.is-on { background: #FFF9F4; }
  .cd-frow.is-on .cd-fdot { background: #F7631E; }
  .cd-step.is-on { border-color: #FFD8BE; background: #FFFFFF; box-shadow: 0 24px 48px -32px rgba(60,30,15,.45); }
  .cd-step .cd-step-n { background: #FFFFFF; border: 1.5px solid #EFE3DA; color: #7F7066; }
  .cd-step.is-on .cd-step-n, .cd-step.is-done .cd-step-n { background: #1C130E; border-color: #1C130E; color: #FFFFFF; }

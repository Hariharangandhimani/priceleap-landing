---
// Native Astro port of the design package's Competitive Data page.
// Static initial render + the full 300ms animation loop and interactions
// reimplemented in vanilla JS: hero competitor price-flash + velocity + freshness
// timers, auto-advancing How-it-works stepper with swapping panels, data-field
// hover highlighting the product-detail card, region toggle (US/India), a
// match-fixing demo, a refresh/failed-fetch demo with donut, an integration
// connect demo, billing toggle and FAQ accordion. Responsive via CSS media queries.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const C = { amz: '#F59E0B', bb: '#3B82F6', tgt: '#EF4444', wmt: '#2563EB', cro: '#0EA5A4', rel: '#8B5CF6', fk: '#EAB308' };
const heroData: [string, string, string, string, string, string, string, string, string, [string, string, string, string][], string][] = [
  ['Philips Airfryer XXL HD9650', 'bestbuy.com', '$249.99', '−2.1% vs avg', '#1E7A3D', 'Competitive', 'Lowest among tracked sellers', '#1E7A3D', '0,16 12,15 24,17 36,12 48,13 60,9 70,10', [['Amazon', C.amz, '$254.00', '$251.50'], ['Walmart', C.wmt, '$259.00', '$259.00'], ['Target', C.tgt, 'No match', 'No match']], 'Today 9:02'],
  ['Ninja Foodi 9-in-1 OL501', 'amazon.com', '$229.99', '+6.7% vs avg', '#B42318', 'Premium', '13% above lowest', '#C2410C', '0,12 12,12 24,10 36,10 48,8 60,8 70,6', [['Best Buy', C.bb, '$199.99', '$194.99'], ['Walmart', C.wmt, '$214.00', '$214.00'], ['Target', C.tgt, '$219.99', '$219.99']], 'Today 9:02'],
  ['KitchenAid Artisan 5-Qt', 'walmart.com', '$379.00', '+0.0% vs avg', '#665A51', 'Competitive', '20% under highest', '#1E7A3D', '0,12 12,12 24,12 36,12 48,12 60,12 70,12', [['Amazon', C.amz, '$379.99', '$374.99'], ['Best Buy', C.bb, '$449.99', '$449.99'], ['Target', C.tgt, '$399.99', '$399.99']], 'Today 9:03'],
  ['Dyson V15 Detect', 'target.com', '$749.99', '+0.0% vs avg', '#665A51', 'Unknown', 'Waiting on matches', '#665A51', '0,12 12,12 24,12 36,12 48,12 60,12 70,12', [['Amazon', C.amz, 'No match', 'No match'], ['Best Buy', C.bb, '$749.99', '$729.99'], ['Walmart', C.wmt, 'No match', 'No match']], 'Today 9:03'],
];
const heroRows = heroData.map(([n, src, p, vs, vc, pos, posD, posC, spark, comps, f]) => ({
  n, src, p, vs, vc, pos, posD, posC, spark, f,
  comps: comps.map(([cn, dot, a, b], k) => ({ n: cn, dot, a, b, flips: k === 0 && a !== b, pc0: a === 'No match' ? '#C2410C' : '#1C130E' })),
}));
const problems = [['01', 'BROKEN SCRAPERS', 'In-house scrapers break the week a competitor changes their site, and nobody notices until a price move is already wrong.'], ['02', 'LOOSE MATCHING', "Loose matching compares your SKU to a different pack size, variant, or seller, so the gap on screen isn't a real gap."], ['03', 'THIN COVERAGE', 'Coverage stops at one or two big marketplaces and misses the regional sites where you actually lose sales.'], ['04', 'STALE FILES', 'Data lands as a weekly CSV. By the time it reaches the pricing model, the market has moved on.']].map(([n, tag, t]) => ({ n, tag, t }));
const steps4 = [['Add your products', 'Paste product URLs, upload a file or connect your catalog.'], ['Choose competitors', 'Let AI competitor discovery find competing products for a product group, or add the competitor URLs you already watch.'], ['Set a schedule', 'Each product group gets its own refresh time, competitor set and location.'], ['Review and export', 'Review prices, gaps and stock on the dashboard, then export them.']].map(([t, d], i) => ({ t, d, no: i + 1 }));
const panels = [['Add Products', 'Paste URLs, upload a file or connect a catalog'], ['Add Products · tracking', 'How should we track this group?'], ['Product Groups', 'Refresh time, competitor set and location per group'], ['Price Intelligence', 'Review prices, gaps and stock, then export']];
const addUrls = ['https://bestbuy.com/site/philips-airfryer-xxl/6512345.p', 'https://walmart.com/ip/ninja-foodi-ol501/1234567', 'https://amazon.com/dp/B0B8RZ1Y9K'].map((t, i) => ({ t, dl: (i * 0.25).toFixed(2) }));
const discovered = [['Amazon', C.amz], ['Best Buy', C.bb], ['Walmart', C.wmt]].map(([t, c], i) => ({ t, c, dl: (0.2 + i * 0.15).toFixed(2) }));
const schedRows = [['KA', 'Kitchen_Appliances', '#D97706', 'EVERY DAY', '3:00 pm London (GMT)', '4 competitors', 'Auto'], ['TV', 'TV_Weekly_Promo', '#0E8FA3', '2× DAILY', '8:00 · 20:00 PT', '5 competitors', '94105'], ['LP', 'Laptops_BackToSchool', '#E04A3A', '3× DAILY', '6 · 12 · 18 CST', '5 competitors', '60601']].map(([ab, n, av, freq, time, c, loc], i) => ({ ab, n, av, freq, time, c, loc, dl: (i * 0.1).toFixed(1) }));
const fd: [string, string, string, string, boolean?][] = [
  ['Your price', 'Current price and % vs market average', 'Dashboard, product detail', 'price'],
  ['Competitor prices', 'Each tracked retailer\'s price, or "No match"', 'Dashboard, product detail', 'comp'],
  ['Gap vs you', 'Amount and percent per competitor', 'Product detail', 'comp'],
  ['Position vs market', 'Competitive, Premium or Unknown, plus market rank', 'Dashboard, product detail', 'pos'],
  ['Stock status', 'In stock or out of stock, for you and each competitor', 'Dashboard, product detail', 'comp'],
  ['Price history', 'Trend sparkline; history for 14 days, 30 days, 90 days, 1 year or full', 'Dashboard, product detail', 'hist'],
  ['MAP and MSRP', 'Values with a validity period', 'Product detail', 'ids', true],
  ['Identifiers', 'SKU, UPC, GTIN, MPN', 'Product detail', 'ids'],
  ['Last check', 'Last fetch per product, last seen per competitor', 'Dashboard, product detail', 'ids'],
];
const fieldRows = fd.map(([k, v, wh, key, cf]) => ({ k, v, w: wh, key, cf: !!cf }));
const detailComps = [['Amazon', C.amz, '$254.00', '+$4.01 (1.6%)', 'IN STOCK'], ['Walmart', C.wmt, '$259.00', '+$9.01 (3.6%)', 'IN STOCK'], ['Target', C.tgt, 'No match', '—', '—']].map(([n, dot, p, g, st]) => ({ n, dot, p, g, s: st, pc: p === 'No match' ? '#C2410C' : '#1C130E', gc: g === '—' ? '#B9A99C' : '#1E7A3D', sc: st === 'IN STOCK' ? '#1E7A3D' : '#B9A99C' }));
const RG = [
  { t: 'United States', zip: '94105', product: 'Philips Airfryer XXL', yours: '$249.99', comps: [['Amazon', C.amz, '$254.00', 'USD'], ['Best Buy', C.bb, '$249.99', 'USD'], ['target.com', C.tgt, 'No match', ''], ['Walmart', C.wmt, '$259.00', 'USD']] },
  { t: 'India', zip: '560001', product: 'Philips Airfryer XXL', yours: '₹21,999', comps: [['Amazon India', C.amz, '₹21,499', 'INR'], ['Croma', C.cro, '₹22,990', 'INR'], ['Flipkart', C.fk, 'No match', ''], ['Reliance Digital', C.rel, '₹21,999', 'INR']] },
];
const sellerApis = [['AMZ', 'Amazon Seller Central', '#F59E0B'], ['WMT', 'Walmart Marketplace', '#2563EB'], ['eB', 'eBay Seller Hub', '#E04A3A'], ['TP', 'Target Plus', '#CC0000']].map(([ab, t, c]) => ({ ab, t, c }));
const refreshGroups = [['KA', 'Kitchen_Appliances', '#D97706', 'Every day · 3:00 pm London'], ['TV', 'TV_Weekly_Promo', '#0E8FA3', '2× daily · 8:00 / 20:00 PT'], ['LP', 'Laptops_BackToSchool', '#E04A3A', '3× daily · 6 / 12 / 18 CST']].map(([ab, n, av, sched], i) => ({ ab, n, av, sched, last: i === 2 }));
const plans = [['Starter', '$89', '$71', ['1,500 products per month', '1 check per day'], false], ['Growth', '$159', '$127', ['3,000 products per month', '2 checks per day'], true], ['Scale', '$299', '$239', ['6,000 products per month', '3 checks per day'], false]].map(([n, m, a, f, pop]) => ({ n, f: f as string[], pop: pop as boolean, m: m as string, a: a as string }));
const fq = [
  ['What is competitive pricing intelligence?', 'Competitive pricing intelligence is the practice of tracking competitor prices, stock and price changes for the products you sell, then using that data to set your own prices. It depends on two things: matching each competitor listing to the right product, and knowing how recent each price is. priceleap.ai shows both for every tracked product.'],
  ['How does priceleap.ai match competitor listings to my products?', 'Each product carries its identifiers: SKU, UPC, GTIN and MPN. If no matching listing is found, priceleap.ai shows "No match" instead of a price, so a gap on screen is a real gap. You can add the right competitor listing by URL from the product page.'],
  ['How often is competitor price data refreshed?', 'Each product group runs on its own schedule, with 1, 2 or 3 checks a day depending on your plan, and you can re-run a group on demand. Every product shows its last fetch time, and every competitor price shows when it was last seen.'],
  ['What data do I get for each product?', 'Your price, competitor prices, gap vs you, position vs market, stock status, price history from 14 days to full, identifiers and last check time, on the dashboard and the product detail page.'],
  ['Can I export competitor price data to Excel or Google Sheets?', 'Yes. Export the full dashboard or one product\'s data, or connect Google Sheets or Microsoft Excel from Integrations.'],
  ['Can I track competitors in more than one country?', 'Yes. Track US and international sites in one workspace, each price in its own currency, and set a ZIP code per product group when a retailer prices by location.'],
].map(([q, a], i) => ({ q, a, n: String(i + 1).padStart(2, '0') }));
---
<PriceLeapLayout
  title="Competitive Pricing Intelligence & Competitor Data · PriceLeap"
  description="priceleap.ai is competitor price monitoring software that tracks competitor prices and stock for the products you sell, matched to your catalog with last-checked timestamps."
>
  <div class="cd">
    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 70% 60% at 50% 0%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;left:50%;top:-30%;width:900px;height:560px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.09),transparent);pointer-events:none"></div>
      <div style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(44px,6vw,88px) clamp(16px,4vw,40px) clamp(48px,6vw,80px)">
        <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:50%;background:#F7631E;animation:cd-pulse 1.8s ease-out infinite"></span>Competitive Data</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(34px,5vw,62px);line-height:1.04;letter-spacing:-.045em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">Competitive pricing intelligence built on </span><span style="font-weight:700">competitor data you can check</span></h1>
          <p style="margin:0;max-width:720px;font-size:18px;line-height:1.6;color:#3A302A;text-wrap:pretty">priceleap.ai is competitor price monitoring software that tracks competitor prices and stock for the products you sell. It matches each listing to your catalog and shows when every price was last checked.</p>
          <p style="margin:0;font-size:16px;line-height:1.6;color:#665A51">Your team picks the products, competitors and schedule. The software does the checking.</p>
          <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:8px">
            {['Refresh schedules per product group', 'Price history from 14 days to full', 'Exports to Google Sheets and Excel'].map((t) => (
              <span style="height:32px;padding:0 12px;display:inline-flex;align-items:center;gap:8px;border-radius:9px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:13px;color:#1C130E"><span style="width:6px;height:6px;border-radius:50%;background:#F7631E"></span>{t}</span>
            ))}
          </div>
        </div>

        <div style="margin:clamp(36px,5vw,56px) auto 0;max-width:1120px;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;box-shadow:0 50px 100px -60px rgba(60,30,15,.45),0 0 0 6px rgba(255,255,255,.7)">
          <div style="display:flex;align-items:center;gap:10px;padding:12px 18px;border-bottom:1px solid #F5ECE5;background:#FFF9F4">
            <span style="font-size:13.5px;font-weight:600;color:#1C130E">Price Intelligence</span>
            <span style="width:1px;height:14px;background:#EFE3DA"></span>
            <span style="font-size:12px;color:#7F7066;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Monitor competitor prices and track your market position.</span>
            <span style="margin-left:auto;flex:none;display:flex;align-items:center;gap:6px;height:24px;padding:0 9px;border-radius:999px;background:#FFF4EC;border:1px solid #FFD8BE;font-family:'Geist Mono',monospace;font-size:10px;color:#C2410C"><span style="width:6px;height:6px;border-radius:50%;background:#F7631E;animation:cd-pulse 1.6s infinite"></span>LAST FETCH 9:02</span>
          </div>
          <div class="cd-kpi" style="gap:1px;background:#F5ECE5;border-bottom:1px solid #F5ECE5">
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.1em;color:#7F7066">CATALOG OVERVIEW</div><div style="margin-top:6px;display:flex;align-items:baseline;gap:8px"><span style="font-family:Geist,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.03em;color:#1C130E">248</span><span style="font-size:12px;color:#665A51">active products</span></div></div>
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.1em;color:#7F7066">PRICE VELOCITY · 30D</div><div style="margin-top:6px;display:flex;gap:14px;font-family:Geist,sans-serif;font-size:20px;font-weight:600"><span style="color:#B42318"><span data-cd-velup>3</span><span style="display:block;font-family:'Geist Mono',monospace;font-size:9px;font-weight:400;letter-spacing:.06em">UP</span></span><span style="color:#1E7A3D"><span data-cd-veldown>5</span><span style="display:block;font-family:'Geist Mono',monospace;font-size:9px;font-weight:400;letter-spacing:.06em">DOWN</span></span></div></div>
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.1em;color:#7F7066">MARKET POSITION</div><div style="margin-top:6px;display:flex;align-items:baseline;gap:8px"><span style="font-family:Geist,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.03em;color:#1E7A3D">96</span><span style="font-size:12px;color:#665A51">cheapest</span></div></div>
            <div style="background:#FFFFFF;padding:14px 16px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.1em;color:#7F7066">FAILED FETCHES</div><div style="margin-top:6px;display:flex;align-items:baseline;gap:8px"><span style="font-family:Geist,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.03em;color:#1C130E">0</span><span style="font-size:12px;color:#665A51">products</span></div></div>
          </div>
          <div style="overflow-x:auto">
            <div style="min-width:820px">
              <div style="display:grid;grid-template-columns:minmax(0,1.6fr) 120px minmax(0,1.1fr) 80px minmax(0,1.5fr) 110px;gap:14px;padding:10px 18px;border-bottom:1px solid #F5ECE5;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:#7F7066"><span>PRODUCT</span><span>YOUR PRICE</span><span>POSITION VS MARKET</span><span>TREND</span><span>COMPETITORS</span><span>LAST FETCH</span></div>
              {heroRows.map((r, ri) => (
                <div style="display:grid;grid-template-columns:minmax(0,1.6fr) 120px minmax(0,1.1fr) 80px minmax(0,1.5fr) 110px;gap:14px;align-items:center;padding:12px 18px;border-bottom:1px solid #F5ECE5">
                  <span style="display:flex;align-items:center;gap:10px;min-width:0"><span style="width:36px;height:36px;flex:none;border-radius:9px;border:1px dashed #E2D3C8;background:repeating-linear-gradient(135deg,#FBF3EC 0 5px,#FFFCF9 5px 10px)"></span><span style="min-width:0"><span style="display:block;font-size:13px;font-weight:600;color:#1C130E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{r.n}</span><span style="display:block;font-family:'Geist Mono',monospace;font-size:10.5px;color:#7F7066">{r.src}</span></span></span>
                  <span><span style="display:block;font-family:Geist,sans-serif;font-size:15px;font-weight:600;color:#1C130E">{r.p}</span><span style={`display:block;font-size:11px;color:${r.vc}`}>{r.vs}</span></span>
                  <span><span style={`display:block;font-size:13px;font-weight:500;color:${r.posC}`}>{r.pos}</span><span style="display:block;font-size:11px;color:#7F7066">{r.posD}</span></span>
                  <svg viewBox="0 0 70 24" width="70" height="24"><polyline points={r.spark} fill="none" stroke="#1C130E" stroke-width="1.6" stroke-linecap="round"></polyline></svg>
                  <span style="display:flex;flex-direction:column;gap:3px">
                    {r.comps.map((c, ci) => (
                      <span style="display:flex;align-items:center;gap:7px;font-size:11.5px;color:#1C130E"><span style={`width:6px;height:6px;border-radius:50%;background:${c.dot}`}></span><span style="min-width:62px">{c.n}</span><span class={ci === 0 ? 'cd-flip' : ''} data-cd-flip={ci === 0 ? ri : undefined} data-a={ci === 0 ? c.a : undefined} data-b={ci === 0 ? c.b : undefined} data-flips={ci === 0 && c.flips ? '1' : undefined} style={`padding:0 4px;border-radius:4px;font-family:'Geist Mono',monospace;color:${c.pc0}`}>{c.a}</span></span>
                    ))}
                  </span>
                  <span style="font-family:'Geist Mono',monospace;font-size:11px;color:#665A51">{r.f}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 DEFINITION -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div class="cd-split" style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:center">
        <div data-reveal style="display:flex;flex-direction:column;gap:18px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The basics</span>
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:400">What is </span><span style="font-weight:700">competitive pricing intelligence?</span></h2>
          <p style="margin:0;font-size:17px;line-height:1.7;color:#3A302A;text-wrap:pretty">Competitive pricing intelligence is competitor price, stock and price-change data for the products you sell, matched to your catalog and used to set your own prices. Its value rests on two things: correct matches and current prices.</p>
          <p style="margin:0;font-size:17px;line-height:1.7;color:#3A302A;text-wrap:pretty">priceleap.ai gives your pricing team both in one dashboard. The evidence behind every number is on screen.</p>
        </div>
        <div data-reveal class="cd-pillar" style="display:grid;gap:12px">
          <div style="background:#FFF9F4;border:1px solid #EFE3DA;border-radius:20px;padding:22px;display:flex;flex-direction:column;gap:14px">
            <span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:#7F7066">01 · CORRECT MATCHES</span>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:12px;padding:10px 12px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">YOUR SKU</div><div style="font-size:13px;font-weight:600;color:#1C130E">Philips Airfryer XXL · HD9650</div></div>
              <div style="display:flex;justify-content:center"><span style="height:22px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:999px;background:#1C130E;font-family:'Geist Mono',monospace;font-size:10px;color:#FFFFFF">✓ GTIN MATCH</span></div>
              <div style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:12px;padding:10px 12px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;color:#7F7066">AMAZON</div><div style="font-size:13px;font-weight:600;color:#1C130E">Philips HD9650/96 Airfryer XXL</div></div>
            </div>
          </div>
          <div style="background:#FFF9F4;border:1px solid #EFE3DA;border-radius:20px;padding:22px;display:flex;flex-direction:column;gap:14px">
            <span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:#7F7066">02 · CURRENT PRICES</span>
            <div style="display:flex;flex-direction:column;gap:6px">
              {[['Amazon', '$254.00'], ['Walmart', '$259.00'], ['Best Buy', '$249.99']].map(([n, p], i) => (
                <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;background:#FFFFFF;border:1px solid #EFE3DA;border-radius:10px;padding:9px 12px;font-size:12.5px"><span style="color:#1C130E">{n}</span><span style="font-family:'Geist Mono',monospace;color:#1C130E">{p}</span><span class="cd-fresh" data-cd-fresh={i} style="font-family:'Geist Mono',monospace;font-size:10.5px;color:#C2410C">{[2, 6, 11][i]}m ago</span></div>
              ))}
            </div>
            <span style="font-size:12px;color:#665A51">Every price shows when it was last seen.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 PROBLEM (static) -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="max-width:780px;display:flex;flex-direction:column;gap:16px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E"></span>The problem</span>

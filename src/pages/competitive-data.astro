<script>
  const root = document.querySelector('.cd');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---- hero flips + velocity + freshness ----
    const flips = qa('[data-cd-flip]');
    const velUp = q('[data-cd-velup]'), velDown = q('[data-cd-veldown]');
    const fresh = qa('[data-cd-fresh]');
    const paintHero = (tk: number) => {
      const flipIdx = Math.floor(tk / 10) % 4, flipOn = tk % 10 < 3;
      flips.forEach((el) => {
        const i = Number(el.getAttribute('data-cd-flip')), a = el.getAttribute('data-a')!, b = el.getAttribute('data-b');
        const canFlip = el.getAttribute('data-flips') === '1';
        if (i === flipIdx && canFlip) { el.textContent = flipOn ? a : (b || a); el.style.animation = flipOn ? 'cd-flash 1.2s ease' : 'none'; }
        else { el.textContent = a; el.style.animation = 'none'; }
      });
      if (velUp) velUp.textContent = String(3 + Math.floor(tk / 10) % 3);
      if (velDown) velDown.textContent = String(5 + Math.floor(tk / 14) % 2);
      fresh.forEach((el, i) => { el.textContent = ((tk % 9) + [2, 6, 11][i]) + 'm ago'; });
    };

    // ---- stepper + panels ----
    const steps = qa('[data-cd-step]'), panels3 = qa('[data-cd-panel]');
    const panelMeta = [['Add Products', 'Paste URLs, upload a file or connect a catalog'], ['Add Products · tracking', 'How should we track this group?'], ['Product Groups', 'Refresh time, competitor set and location per group'], ['Price Intelligence', 'Review prices, gaps and stock, then export']];
    const stepFill = q('[data-cd-stepfill]');
    let step = 0, sp = 0, stepAuto = true;
    const paintSteps = () => {
      steps.forEach((el, i) => {
        el.classList.toggle('is-on', i === step); el.classList.toggle('is-done', i < step);
        el.setAttribute('aria-pressed', String(i === step));
        const n = el.querySelector('.cd-step-n') as HTMLElement; if (n) n.textContent = i < step ? '✓' : String(i + 1);
      });
      panels3.forEach((pnl, i) => (pnl.style.display = i === step ? (i === 0 ? 'flex' : (i === 1 ? 'grid' : 'flex')) : 'none'));
      const pt = q('[data-cd-ptitle]'), psb = q('[data-cd-psub]');
      if (pt) pt.textContent = panelMeta[step][0]; if (psb) psb.textContent = panelMeta[step][1];
      if (stepFill) stepFill.style.width = Math.min(75, (step + (stepAuto ? sp / 100 : 0)) / 3 * 75) + '%';
    };
    steps.forEach((el, i) => el.addEventListener('click', () => { step = i; sp = 0; stepAuto = false; paintSteps(); }));

    // ---- data field hover ----
    const hlBoxes = qa('[data-cd-hl]');
    qa('[data-cd-field]').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        qa('[data-cd-field]').forEach((r) => r.classList.remove('is-on'));
        row.classList.add('is-on');
        const key = row.getAttribute('data-key');
        hlBoxes.forEach((box) => { box.style.borderColor = box.getAttribute('data-cd-hl') === key ? '#F7631E' : '#F5ECE5'; });
      });
    });

    // ---- region toggle ----
    const RG = [
      { zip: '94105', yours: '$249.99', comps: [['Amazon', '#F59E0B', '$254.00', 'USD'], ['Best Buy', '#3B82F6', '$249.99', 'USD'], ['target.com', '#EF4444', 'No match', ''], ['Walmart', '#2563EB', '$259.00', 'USD']] },
      { zip: '560001', yours: '₹21,999', comps: [['Amazon India', '#F59E0B', '₹21,499', 'INR'], ['Croma', '#0EA5A4', '₹22,990', 'INR'], ['Flipkart', '#EAB308', 'No match', ''], ['Reliance Digital', '#8B5CF6', '₹21,999', 'INR']] },
    ];
    qa('[data-cd-region]').forEach((btn) => btn.addEventListener('click', () => {
      const i = Number(btn.getAttribute('data-cd-region'));
      qa('[data-cd-region]').forEach((b) => b.classList.toggle('is-on', b === btn));
      const r = RG[i];
      const zip = q('[data-cd-zip]'), yours = q('[data-cd-yours]'), comps = q('[data-cd-comps]'), body = q('[data-cd-regionbody]');
      if (zip) zip.textContent = r.zip; if (yours) yours.textContent = r.yours;
      if (comps) comps.innerHTML = r.comps.map(([n, dot, p, ccy], k) =>
        `<div style="display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:10px 12px;border-bottom:1px solid #F5ECE5;font-size:12.5px;animation:cd-in .3s ease ${(k * 0.06).toFixed(2)}s both"><span style="display:flex;align-items:center;gap:7px;color:#1C130E"><span style="width:6px;height:6px;border-radius:50%;background:${dot}"></span>${n}</span><span style="font-family:'Geist Mono',monospace;color:${p === 'No match' ? '#C2410C' : '#1C130E'}">${p}</span><span style="height:18px;padding:0 6px;display:${ccy ? 'flex' : 'none'};align-items:center;border-radius:5px;background:#FBF3EC;font-family:'Geist Mono',monospace;font-size:9px;color:#665A51">${ccy}</span></div>`).join('');
      if (body) { body.style.animation = 'none'; void body.offsetWidth; body.style.animation = 'cd-in .35s ease'; }
    }));

    // ---- matching demo ----
    const matchRow = q('[data-cd-matchrow]'), matchPrice = q('[data-cd-matchprice]'), matchUrl = q('[data-cd-matchurl]'), addRow = q('[data-cd-addrow]'), addText = q('[data-cd-addtext]');
    const typed = 'target.com/p/ninja-foodi-ol501';
    const paintMatch = (tk: number) => {
      const mPhase = Math.floor(tk / 6) % 4;
      const at = mPhase === 1 ? typed.slice(0, Math.min(typed.length, (tk % 6 + 1) * 6)) : mPhase === 2 ? typed : '';
      const fixed = mPhase >= 3 || (mPhase === 2 && tk % 6 > 3);
      if (addText) addText.textContent = at || 'paste a competitor URL';
      if (addRow) { addRow.style.borderColor = (mPhase === 1 || mPhase === 2) ? '#F7631E' : '#E2D3C8'; addRow.style.color = (mPhase === 1 || mPhase === 2) ? '#C2410C' : '#7F7066'; }
      if (matchPrice) { matchPrice.textContent = fixed ? '$219.99' : 'No match'; matchPrice.style.color = fixed ? '#1C130E' : '#C2410C'; matchPrice.style.animation = fixed ? 'cd-flash 1.2s ease' : 'none'; }
      if (matchUrl) matchUrl.style.display = fixed ? 'inline' : 'none';
      if (matchRow) { matchRow.style.borderColor = fixed ? '#FFD8BE' : '#F5ECE5'; matchRow.style.background = fixed ? '#FFF9F4' : '#FFFFFF'; }
    };

    // ---- refresh demo ----
    const failedN = q('[data-cd-failed]'), failedNote = q('[data-cd-failednote]'), donut = q('[data-cd-donut]');
    const paintRefresh = (tk: number) => {
      const rPhase = Math.floor(tk / 8) % 3;
      qa('[data-cd-rstat]').forEach((cell, i) => {
        const spin = rPhase === 1 && i === 2, failed = rPhase === 0 && i === 2;
        const sp2 = cell.querySelector('[data-cd-rspin]') as HTMLElement, tx = cell.querySelector('[data-cd-rtext]') as HTMLElement;
        if (sp2) sp2.hidden = !spin;
        if (tx) tx.textContent = spin ? 'Re-running…' : failed ? '1 failed' : 'Fetched 9:02';
        cell.style.color = failed ? '#B42318' : spin ? '#C2410C' : '#665A51';
      });
      const fN = rPhase === 0 ? 1 : 0;
      if (failedN) failedN.textContent = String(fN);
      if (failedNote) { failedNote.textContent = fN ? 'Laptops_BackToSchool · retrying' : 'All products fetched'; failedNote.style.color = fN ? '#B42318' : '#1E7A3D'; }
      if (donut) { donut.style.stroke = fN ? '#B42318' : '#1E7A3D'; donut.style.strokeDashoffset = String(fN ? 150 : 0); }
    };

    // ---- integration demo ----
    const intBtn = q('[data-cd-intbtn]'), intRow = q('[data-cd-int]');
    const paintInt = (tk: number) => {
      const on = Math.floor(tk / 10) % 2 === 1;
      if (intBtn) { intBtn.textContent = on ? '✓ Connected' : 'Connect'; intBtn.style.background = on ? '#1C130E' : '#FFFFFF'; intBtn.style.color = on ? '#FFFFFF' : '#1C130E'; intBtn.style.borderColor = on ? '#1C130E' : '#EFE3DA'; }
      if (intRow) { intRow.style.borderColor = on ? '#FFD8BE' : '#F5ECE5'; intRow.style.background = on ? '#FFF9F4' : '#FFFFFF'; }
    };

    // ---- 300ms loop ----
    let tick = 0;
    paintHero(0); paintSteps(); paintMatch(0); paintRefresh(0); paintInt(0);
    setInterval(() => {
      tick++;
      paintHero(tick); paintMatch(tick); paintRefresh(tick); paintInt(tick);
      if (stepAuto) { sp += 3; if (sp >= 100) { sp = 0; step = (step + 1) % 4; paintSteps(); } else if (stepFill) stepFill.style.width = Math.min(75, (step + sp / 100) / 3 * 75) + '%'; }
    }, 300);

    // ---- billing ----
    qa('[data-cd-bill]').forEach((b) => b.addEventListener('click', () => {
      const annual = b.getAttribute('data-cd-bill') === 'annual';
      qa('[data-cd-bill]').forEach((x) => x.classList.toggle('is-on', x === b));
      qa('.cd-price').forEach((el) => el.textContent = el.getAttribute(annual ? 'data-annual' : 'data-monthly') || '');
      qa('.cd-note').forEach((el) => el.textContent = el.getAttribute(annual ? 'data-annual' : 'data-monthly') || '');
    }));

    // ---- faq ----
    qa('[data-cd-faq-btn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-cd-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-cd-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-cd-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

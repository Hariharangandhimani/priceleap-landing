---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const links = [
  { href: '/', label: 'Homepage', icon: 'engine' },
  { href: '/pricing', label: 'Pricing', icon: 'optimize' },
  { href: '/blog', label: 'Blog', icon: 'blog' },
  { href: '/glossary', label: 'Glossary', icon: 'glossary' },
  { href: '/learn', label: 'Learn', icon: 'decision' },
  { href: '/contact', label: 'Contact', icon: 'match' },
];
---
<PriceLeapLayout title="404 · Page not found · PriceLeap" description="This page isn't in our catalog. Head back to the homepage or explore pricing, the blog, glossary and more.">
  <section class="nf" data-screen-label="404">
    <div aria-hidden="true" class="nf-grid"></div>
    <div aria-hidden="true" class="nf-glow"></div>
    <div class="nf-inner">
      <!-- Big 404 centerpiece -->
      <div class="nf-num" aria-hidden="true">
        <span class="nf-digit">4</span>
        <span class="nf-zero">
          <svg viewBox="0 0 160 160" class="nf-zero-svg">
            <circle cx="80" cy="80" r="66" fill="none" stroke="var(--pl-line)" stroke-width="16"></circle>
            <circle cx="80" cy="80" r="66" fill="none" stroke="url(#nfg)" stroke-width="16" stroke-linecap="round" stroke-dasharray="300 414" transform="rotate(-90 80 80)"></circle>
            <defs><linearGradient id="nfg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F2421B"></stop><stop offset="1" stop-color="#FB8A2E"></stop></linearGradient></defs>
          </svg>
          <span class="nf-zero-tag">NO<br>MATCH</span>
        </span>
        <span class="nf-digit">4</span>
      </div>

      <span class="nf-badge"><span class="nf-badge-dot"></span>ERROR 404 · PAGE NOT FOUND</span>
      <h1 class="nf-h1">This page isn't in our catalog.</h1>
      <p class="nf-lead">We monitored every URL on the site and couldn't match this one — it may have moved, been renamed, or never existed. Let's get you back to tracked territory.</p>

      <div class="nf-cta">
        <a href="/" class="nf-btn-primary">← Back to homepage</a>
        <a href="/book-a-demo" class="nf-btn-ghost">Book a demo</a>
      </div>

      <div class="nf-links">
        {links.map((l) => (
          <a href={l.href} class="nf-link">
            <span class="nf-link-ico"><img src={`/assets/icons/${l.icon}.svg`} alt="" width="16" height="16" /></span>
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .nf { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; background: var(--pl-canvas); }
  .nf-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 35%,#000 10%,transparent 72%); mask-image: radial-gradient(ellipse 70% 70% at 50% 35%,#000 10%,transparent 72%); pointer-events: none; }
  .nf-glow { position: absolute; left: 50%; top: -120px; width: 820px; height: 520px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(247,99,30,.14),transparent); pointer-events: none; }
  .nf-inner { position: relative; max-width: 820px; margin: 0 auto; padding: clamp(48px,7vw,88px) clamp(16px,4vw,40px) clamp(56px,7vw,96px); display: flex; flex-direction: column; align-items: center; text-align: center; }

  /* Big 404 */
  .nf-num { display: flex; align-items: center; justify-content: center; gap: clamp(6px,2vw,20px); }
  .nf-digit { font-family: Geist, sans-serif; font-size: clamp(120px,22vw,240px); font-weight: 700; letter-spacing: -.06em; line-height: 1; background: linear-gradient(180deg,var(--pl-ink) 0%,var(--pl-ink-2) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nf-zero { position: relative; width: clamp(110px,20vw,220px); height: clamp(110px,20vw,220px); flex: none; display: flex; align-items: center; justify-content: center; }
  .nf-zero-svg { width: 100%; height: 100%; display: block; }
  .nf-zero-tag { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'Geist Mono', monospace; font-size: clamp(11px,1.6vw,15px); letter-spacing: .1em; line-height: 1.3; color: var(--pl-accent-ink); }

  .nf-badge { margin-top: clamp(28px,4vw,40px); height: 28px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: .1em; color: var(--pl-accent-ink); }
  .nf-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--pl-accent); animation: plpulse 1.8s infinite; }
  .nf-h1 { margin: 18px 0 0; font-family: Geist, sans-serif; font-size: clamp(30px,4.6vw,48px); line-height: 1.06; letter-spacing: -.04em; font-weight: 600; color: var(--pl-ink); text-wrap: balance; }
  .nf-lead { margin: 16px 0 0; max-width: 540px; font-size: clamp(15px,1.6vw,17px); line-height: 1.6; color: var(--pl-ink-2); text-wrap: pretty; }
  .nf-cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .nf-btn-primary { height: 48px; padding: 0 22px; display: inline-flex; align-items: center; border-radius: 12px; background: var(--pl-gradient); color: var(--pl-surface); font-family: Geist, sans-serif; font-weight: 500; font-size: 15px; box-shadow: 0 12px 24px -12px rgba(247,99,30,.85); }
  .nf-btn-primary:hover { filter: brightness(.95); color: var(--pl-surface); }
  .nf-btn-ghost { height: 48px; padding: 0 20px; display: inline-flex; align-items: center; border-radius: 12px; border: 1px solid var(--pl-line); background: var(--pl-surface); color: var(--pl-ink); font-family: Geist, sans-serif; font-weight: 500; font-size: 15px; }
  .nf-btn-ghost:hover { border-color: var(--pl-line-xstrong); color: var(--pl-ink); }

  .nf-links { margin-top: 40px; padding-top: 28px; border-top: 1px dashed var(--pl-line); display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .nf-link { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--pl-line); background: var(--pl-surface); color: var(--pl-ink); font-size: 14px; font-weight: 500; transition: border-color .2s, color .2s, transform .2s; }
  .nf-link:hover { border-color: var(--pl-accent-line); color: var(--pl-accent-ink); transform: translateY(-2px); }
  .nf-link-ico { width: 24px; height: 24px; border-radius: 7px; background: var(--pl-accent-tint); border: 1px solid var(--pl-accent-line); display: flex; align-items: center; justify-content: center; }
  .nf-link-ico img { width: 14px; height: 14px; }
</style>

---
import SiteLayout from '@/layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found | PriceLeap" description="The page you requested could not be found.">
  <section class="grid min-h-[60vh] place-items-center px-6 py-24 text-center">
    <div><p class="font-mono text-xs uppercase tracking-[.16em] text-[var(--pl-accent-ink)]">404 · Not found</p><h1 class="mt-4 text-5xl font-semibold tracking-[-.05em] text-[var(--pl-ink)]">This page moved.</h1><p class="mx-auto mt-4 max-w-md text-[var(--pl-muted)]">Try the homepage or talk to the PriceLeap team.</p><div class="mt-8 flex justify-center gap-3"><a class="rounded-lg bg-[var(--pl-accent)] px-4 py-3 text-sm font-medium text-white" href="/">Go home</a><a class="rounded-lg border border-[var(--pl-line)] bg-white px-4 py-3 text-sm" href="/contact">Contact us</a></div></div>
  </section>
</SiteLayout>

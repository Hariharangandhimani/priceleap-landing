---
// Native Astro port of the design package's About page.
// Static initial render + all animation/interactivity reimplemented as a vanilla
// <script>: cycling competitor/decision demo (2800ms), auto-advancing solutions
// carousel (click/hover), vs-comparison hover, 8-person team bio accordion, and
// scroll-reveal. Same layout, tokens, colors and animations. Responsive via CSS.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const rv = [['Competitor A', '$184.99', 'IN STOCK'], ['Marketplace B', '$179.50', '−3.0%'], ['Retailer C', '$189.00', 'OUT'], ['Reseller D', '$176.20', '−4.8%']];
const rivals = rv.map(([n, p, s]) => ({ n, p, s, sc: s.startsWith('−') ? 'var(--pl-danger-ink)' : s === 'OUT' ? 'var(--pl-muted)' : 'var(--pl-accent-ink)' }));
const decs = [
  { sku: 'SKU 48201', price: '$184.99', action: 'Hold', margin: '+3.2%', rule: 'Floor 28%' },
  { sku: 'SKU 48201', price: '$181.49', action: 'Match −1%', margin: '+1.4%', rule: 'MAP ✓' },
  { sku: 'SKU 48201', price: '$192.00', action: 'Raise', margin: '+5.6%', rule: 'Rival OOS' },
  { sku: 'SKU 48201', price: '$179.99', action: 'Review', margin: '+0.8%', rule: 'Threshold' },
];
const solData = [
  ['01 - Competitive Intelligence', 'Market Visibility at Scale', 'Track competitor prices, stock availability, and market movements across thousands of SKUs with speed and precision.'],
  ['02 - Pricing Decision Engine', 'Data That Drives Action', 'Turn raw competitor data into structured decisions using configurable rules, pricing models, and real-time insights.'],
  ['03 - Control & Automation', 'Margin-Aligned Execution', 'Apply pricing strategies automatically - aligned with your margins, inventory levels, and business rules. Always in control.'],
  ['04 - Enterprise Integration', 'Connect Your Ecosystem', 'Seamlessly connect via APIs, ERP systems, and analytics tools. PriceLeap fits into your existing infrastructure.'],
].map(([k, t, d], i) => ({ k, t, d, n: '0' + (i + 1) }));
const valData = [['Real-Time Alerts', 'Instant notifications via Email, Slack, and SMS — so you never miss a market move.'], ['Clear Price Positioning', 'Understand exactly where you stand against competitors at any moment.'], ['Margin Protection', 'Rule-based logic ensures your pricing never erodes the margins that matter.'], ['Reduced Manual Effort', 'Eliminate spreadsheet-based tracking and fragmented monitoring tools permanently.'], ['Scalable Across SKUs', 'Apply consistent pricing intelligence across thousands of products simultaneously.']];
const valIcons = ['alert', 'intelligence', 'shield', 'optimize', 'data'];
const values = valData.map(([t, d], i) => ({ t, d, icon: valIcons[i] || 'engine' }));
const vs = [['Track prices', 'Turn data into decisions'], ['Dashboards', 'Strategy enablement'], ['Limited integrations', 'Deep integrations'], ['Reactive alerts', 'Proactive control']].map(([a, b]) => ({ a, b }));
const serve = [
  { t: 'Primary Customers', n: '01', items: ['E-commerce sellers', 'Multi-SKU brands', 'Online retailers', 'Distributors'] },
  { t: 'Industries', n: '02', items: ['Electronics', 'Automotive', 'Consumer goods', 'Industrial distribution'] },
  { t: 'Operational Scale', n: '03', items: ['Mid-market operations', 'Enterprise e-commerce', 'OEM pricing teams', 'Complex SKU environments'] },
];
const tm = [
  ['Seema Phull', 'Executive Advisor, USA', 'Provides strategic guidance to the leadership team, shaping company direction. With 25+ years of driving change in Aerospace, Defense, and Renewable Energy, she has led turnarounds and improvements, including doubling EBITDA for a distressed aerospace firm and building a global supply chain for a Blackstone portfolio company.'],
  ['Justin Dye', 'Technology & Analytics, USA', 'Drives innovation, leveraging data, and ensuring the technological backbone aligns with business goals. Justin has a proven track record of driving market-leading growth through analytics, risk management, and operational excellence. Global industry experience across Defense and Space, Aerospace, Transportation, and Hi-Tech industries.'],
  ['Mike Kapusta', 'Strategic Solutions & Business Development, USA', 'Drives growth by identifying new opportunities, creating tailored solutions, and building strong relationships. Mike has 25 years of experience in driving corporate growth and profitability through customer-centric and solutions-focused strategies.'],
  ['Joshua McDonough', 'Operations & Commercial Excellence, USA', 'Drives efficiency, profitability, and alignment between operational and commercial strategies. 25 years of experience in business improvement through process analysis, demand forecasting, strategic planning, inventory management, and supply chain management. Expertise in transformative projects in Aerospace, Defense, Medical Device, CPG, High Tech, and Renewable Energy sectors.'],
  ['Jyothish R', 'CTO & Global Delivery Officer', 'Leads the delivery and innovation team with a strong focus on operational efficiency and client success. Jyothish brings experience from Honeywell, Oracle, and Ford Motors. Key responsibilities include: ensuring customer success and strategic alignment, championing an AI- and automation-first mindset, developing new capabilities aligned with business goals, and driving team growth through continuous enablement and leadership.'],
  ['Biju M L', 'Chief Growth Officer', "Leads the organization's growth strategy with a focus on revenue generation, market expansion, and customer success. Biju brings 17+ years of experience across small to large enterprises, having worked at Cognizant and Capgemini before joining AIMLEAP. Key focus areas include: developing and executing data-driven strategies, identifying new market opportunities, scaling revenue streams, building strategic partnerships, aligning marketing, sales, and product functions, and leveraging innovation to accelerate growth."],
  ['Jay Suresh', 'Head – HR & Operations', 'Seasoned HR leader with over a decade of experience. Known for driving organizational success through people-centric strategies, fostering high-performance cultures, and empowering talent. Focus areas include: innovative hiring and retention strategies, engagement initiatives to boost alignment and motivation, championing DEI programs, and aligning HR strategy with long-term business goals.'],
  ['Edwin P. Davis', 'Strategic Alliances & Partnerships', 'Brings a unique blend of operational excellence & strategic insight, backed in project and operations roles & an MBA in Marketing from a Tier 1 institute. He has worked across leading tech & consulting firms. At AIMLEAP, he drives cross-functional collaboration, global partnerships, and growth initiatives. Areas of expertise include GTM strategy, CXO reporting, KPI dashboards, & crafting scalable, insight-led strategies for long-term impact.'],
];
const team = tm.map(([n, r, b]) => ({ n, r, b, ini: n.replace(/\./g, '').split(' ').filter(Boolean).map((x) => x[0]).slice(0, 2).join('') }));
const beliefs = ['Pricing should be a system, not guesswork — built on data, rules, and repeatable logic.', 'Control matters more than automation. The best systems keep humans confidently in charge.', 'Speed is a competitive advantage. Responding to market changes faster wins margins.', "Data must lead to action. Dashboards that don't drive decisions are just noise.", 'Infrastructure over tools. Sustainable businesses are built on platforms, not point solutions.', 'Customer-centricity is built into every layer — from the interface to the integration.'].map((t, i) => ({ t, n: '0' + (i + 1) }));
const impact = ['Faster response to market changes', 'Better pricing consistency across all SKUs', 'Stronger margins through rule-based protection', 'Dramatically reduced manual pricing work', 'More confident, data-backed pricing decisions'];
const banner = [0, 1, 2, 3, 4, 5].map((i) => ({ w: i % 2 ? 400 : 700, c: i % 2 ? 'var(--pl-line-xstrong)' : 'var(--pl-ink)' }));
---
<PriceLeapLayout
  title="About PriceLeap · Pricing Intelligence Built for Scale"
  description="PriceLeap is a pricing intelligence engine that transforms competitor data into structured, real-time pricing decisions."
>
  <div class="ab">
    <!-- HERO -->
    <section id="top" style="position:relative;border-bottom:1px solid var(--pl-line);overflow:hidden">
      <div aria-hidden="true" class="ab-hero-grid"></div>
      <div aria-hidden="true" class="ab-hero-glow"></div>
      <div style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(56px,8vw,104px) clamp(20px,4vw,40px) clamp(56px,6vw,88px);display:flex;flex-direction:column;align-items:center;text-align:center">
        <span style="height:30px;padding:0 12px;display:inline-flex;align-items:center;gap:8px;border-radius:999px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.8s infinite"></span>About PriceLeap</span>
        <h1 style="margin:22px 0 0;font-family:Geist,sans-serif;font-size:clamp(40px,6vw,80px);line-height:1;letter-spacing:-.05em;color:var(--pl-ink);max-width:1000px;text-wrap:balance"><span style="font-weight:400">Turn Competitor Prices Into </span><span style="font-weight:700">Pricing Decisions</span></h1>
        <p style="margin:24px 0 0;max-width:720px;font-size:18px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">PriceLeap is a pricing intelligence engine built for businesses operating in complex pricing environments. We transform competitor data into structured, real-time pricing decisions.</p>
        <div style="margin-top:28px;display:flex;flex-wrap:wrap;justify-content:center;border:1px solid var(--pl-line);border-radius:12px;background:var(--pl-surface);overflow:hidden">
          {['Pricing Intelligence', 'Real-Time Decisions', 'Enterprise Scale', 'Deep Integration'].map((t, i) => (
            <span style={`height:40px;padding:0 16px;display:flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink)${i < 3 ? ';border-right:1px solid var(--pl-line-soft)' : ''}`}><span style="width:6px;height:6px;border-radius:2px;background:var(--pl-gradient)"></span>{t}</span>
          ))}
        </div>

        <div class="ab-flow">
          <div style="background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:18px;padding:16px;box-shadow:0 24px 48px -32px rgba(60,30,15,.35);display:flex;flex-direction:column;gap:8px">
            <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint)"><span>COMPETITOR DATA</span><span style="color:var(--pl-accent-ink)">LIVE</span></div>
            {rivals.map((r, i) => (
              <div class="ab-rival" data-ab-rival={i} style={`display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:9px 10px;border-radius:10px;background:${i === 0 ? 'var(--pl-cream)' : 'var(--pl-surface)'};border:1px solid ${i === 0 ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)'};transition:all .35s`}>
                <span style="font-size:13px;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{r.n}</span>
                <span style={`font-family:'Geist Mono',monospace;font-size:10px;color:${r.sc}`}>{r.s}</span>
                <span style="font-family:'Geist Mono',monospace;font-size:12.5px;color:var(--pl-ink)">{r.p}</span>
              </div>
            ))}
          </div>
          <span aria-hidden="true" class="ab-conn" style="height:2px;margin:0 -1px;background:repeating-linear-gradient(90deg,var(--pl-accent) 0 6px,transparent 6px 12px);background-size:20px 2px;animation:pi-dashx .8s linear infinite"></span>
          <div class="ab-core" style="justify-self:center;display:flex;flex-direction:column;align-items:center;gap:10px">
            <span style="position:relative;width:96px;height:96px;display:flex;align-items:center;justify-content:center">
              <span style="position:absolute;inset:-12px;border-radius:50%;border:1px dashed var(--pl-accent-line);animation:pi-orbit 22s linear infinite"></span>
              <span style="position:absolute;inset:0;border-radius:28px;border:1px solid rgba(247,99,30,.6);animation:pi-ring 2.8s ease-out infinite"></span>
              <span style="position:relative;width:96px;height:96px;border-radius:28px;background:var(--pl-surface);border:1.5px solid var(--pl-accent);box-shadow:0 0 0 8px rgba(247,99,30,.1),0 20px 40px -16px rgba(194,65,12,.5);display:flex;align-items:center;justify-content:center"><img src="/assets/pl-mark.png" alt="" width="36" height="34"></span>
            </span>
            <span style="font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.1em;color:var(--pl-accent-ink)">DECISION ENGINE</span>
          </div>
          <span aria-hidden="true" class="ab-conn" style="height:2px;margin:0 -1px;background:repeating-linear-gradient(90deg,var(--pl-accent) 0 6px,transparent 6px 12px);background-size:20px 2px;animation:pi-dashx .8s linear infinite"></span>
          <div data-ab-dec style="background:var(--pl-surface);border:1.5px solid var(--pl-accent);border-radius:18px;padding:16px;box-shadow:0 0 0 6px rgba(247,99,30,.08),0 24px 48px -30px rgba(194,65,12,.5);display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-accent-ink)"><span>PRICING DECISION</span><span data-ab-sku>{decs[0].sku}</span></div>
            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:10px"><span data-ab-price style="font-family:Geist,sans-serif;font-size:30px;font-weight:600;letter-spacing:-.04em;color:var(--pl-ink)">{decs[0].price}</span><span data-ab-action style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;background:var(--pl-ink);color:var(--pl-surface);font-family:'Geist Mono',monospace;font-size:10.5px">{decs[0].action}</span></div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">
              <span style="padding:8px 10px;border-radius:9px;background:var(--pl-cream);border:1px solid #FFE8D6;font-size:12px;color:var(--pl-ink-2)">Margin <b data-ab-margin style="font-family:'Geist Mono',monospace;font-weight:500;color:var(--pl-accent-ink)">{decs[0].margin}</b></span>
              <span style="padding:8px 10px;border-radius:9px;background:var(--pl-cream);border:1px solid var(--pl-line-soft);font-size:12px;color:var(--pl-ink-2)">Rule <b data-ab-rule style="font-family:'Geist Mono',monospace;font-weight:500;color:var(--pl-ink)">{decs[0].rule}</b></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WHO WE ARE -->
    <section id="who" style="border-bottom:1px solid var(--pl-line)">
      <div class="ab-split" style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:start">
        <div data-reveal>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>Who We Are</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">Pricing Intelligence </span><span style="font-weight:700">Built for Scale</span></h2>
          <div style="margin-top:24px;display:flex;flex-direction:column;gap:16px;font-size:16.5px;line-height:1.7;color:var(--pl-ink-2)">
            <p style="margin:0">PriceLeap is designed as a scalable pricing infrastructure - enabling businesses to respond faster, protect margins, and maintain control across thousands of SKUs.</p>
            <p style="margin:0">We help companies move beyond manual tracking and fragmented tools by transforming competitor data into structured, real-time pricing decisions.</p>
            <p style="margin:0">Track competitor prices, monitor stock availability, and respond to market changes - all within a system designed for speed, control, and scale.</p>
          </div>
        </div>
        <div data-reveal style="display:flex;flex-direction:column;gap:16px">
          <div style="position:relative;background:var(--pl-cream);border:1px solid var(--pl-line);border-left:3px solid var(--pl-accent);border-radius:4px 18px 18px 4px;padding:24px 26px">
            <p style="margin:0;font-family:Geist,sans-serif;font-size:clamp(19px,2vw,23px);font-weight:500;line-height:1.45;letter-spacing:-.015em;color:var(--pl-ink);text-wrap:pretty">PriceLeap is not just a tool - it is a pricing decision engine that bridges SaaS simplicity with enterprise-grade capability.</p>
          </div>
          <div style="border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;background:var(--pl-line);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px">
            <div style="background:var(--pl-surface);padding:24px"><div style="font-family:Geist,sans-serif;font-size:clamp(34px,4vw,48px);font-weight:600;letter-spacing:-.045em;line-height:1;color:var(--pl-ink)">1000s</div><div style="margin-top:8px;font-size:14px;color:var(--pl-muted)">SKUs Tracked</div></div>
            <div style="background:var(--pl-surface);padding:24px"><div style="display:flex;align-items:center;gap:10px;font-family:Geist,sans-serif;font-size:clamp(34px,4vw,48px);font-weight:600;letter-spacing:-.045em;line-height:1;color:var(--pl-ink)">Real-Time<span style="width:10px;height:10px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span></div><div style="margin-top:8px;font-size:14px;color:var(--pl-muted)">Price Intelligence</div></div>
            <div style="background:var(--pl-surface);padding:24px"><div style="font-family:Geist,sans-serif;font-size:clamp(34px,4vw,48px);font-weight:600;letter-spacing:-.045em;line-height:1;color:var(--pl-ink)">3<span style="color:var(--pl-accent)">+</span></div><div style="margin-top:8px;font-size:14px;color:var(--pl-muted)">Alert Channels</div></div>
            <div style="background:var(--pl-surface);padding:24px"><div style="font-family:Geist,sans-serif;font-size:clamp(34px,4vw,48px);font-weight:600;letter-spacing:-.045em;line-height:1;color:var(--pl-ink)">100<span style="color:var(--pl-accent)">%</span></div><div style="margin-top:8px;font-size:14px;color:var(--pl-muted)">Decision Driven</div></div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {['Mid-Market', 'Enterprise', 'E-Commerce', 'Distributors', 'OEMs'].map((t) => (
              <span style="height:34px;padding:0 14px;display:flex;align-items:center;border-radius:999px;background:var(--pl-surface);border:1px solid var(--pl-line);font-size:13.5px;color:var(--pl-ink)">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- MISSION & VISION -->
    <section id="purpose" style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>Our Purpose</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink)"><span style="font-weight:400">Mission </span><span style="font-weight:700">&amp; Vision</span></h2>
        </div>
        <div data-reveal style="margin-top:48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:24px;padding:clamp(28px,4vw,44px);overflow:hidden;display:flex;flex-direction:column;gap:18px">
            <span aria-hidden="true" style="position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;border:1px solid var(--pl-line-soft);box-shadow:inset 0 0 0 30px var(--pl-cream),inset 0 0 0 31px var(--pl-line-soft),inset 0 0 0 60px var(--pl-surface),inset 0 0 0 61px var(--pl-line-soft)"></span>
            <span style="position:relative;width:56px;height:56px;border-radius:50%;border:1.5px solid var(--pl-accent);display:flex;align-items:center;justify-content:center"><span style="width:30px;height:30px;border-radius:50%;border:1.5px solid var(--pl-accent);display:flex;align-items:center;justify-content:center"><span style="width:10px;height:10px;border-radius:50%;background:var(--pl-gradient)"></span></span></span>
            <span style="position:relative;font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)">Our Mission</span>
            <p style="position:relative;margin:0;font-family:Geist,sans-serif;font-size:clamp(20px,2.2vw,26px);font-weight:500;line-height:1.4;letter-spacing:-.015em;color:var(--pl-ink);text-wrap:pretty">To empower businesses with the speed, clarity, and control to make smarter pricing decisions - transforming complex market data into structured, scalable intelligence that eliminates guesswork.</p>
          </div>
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:24px;padding:clamp(28px,4vw,44px);overflow:hidden;display:flex;flex-direction:column;gap:18px">
            <span aria-hidden="true" style="position:absolute;right:-50px;top:-50px;width:200px;height:200px;border-radius:50%;border:1px solid var(--pl-line-soft);background:repeating-linear-gradient(0deg,transparent 0 24px,var(--pl-sand-3) 24px 25px),repeating-linear-gradient(90deg,transparent 0 24px,var(--pl-sand-3) 24px 25px)"></span>
            <span style="position:relative;width:56px;height:56px;border-radius:50%;border:1.5px solid var(--pl-accent);overflow:hidden;display:flex;align-items:center;justify-content:center"><span style="position:absolute;width:56px;height:24px;border-radius:50%;border:1.5px solid var(--pl-accent)"></span><span style="position:absolute;width:24px;height:56px;border-radius:50%;border:1.5px solid var(--pl-accent);animation:pi-orbit 8s linear infinite"></span><span style="position:absolute;left:0;right:0;top:50%;height:1.5px;background:var(--pl-gradient)"></span></span>
            <span style="position:relative;font-family:'Geist Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)">Our Vision</span>
            <p style="position:relative;margin:0;font-family:Geist,sans-serif;font-size:clamp(20px,2.2vw,26px);font-weight:500;line-height:1.4;letter-spacing:-.015em;color:var(--pl-ink);text-wrap:pretty">To become the core pricing infrastructure layer powering how businesses monitor, decide, and execute pricing strategies globally.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SOLUTION (auto-advancing carousel) -->
    <section id="solution" style="border-bottom:1px solid var(--pl-line)">
      <div style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px 64px;align-items:end">
          <div>
            <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>What We Do</span>
            <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink)"><span style="font-weight:400">Our </span><span style="font-weight:700">Solution</span></h2>
          </div>
          <p style="margin:0;max-width:460px;font-size:17px;line-height:1.6;color:var(--pl-ink-2)">Four integrated capabilities that move you from price watching to pricing control.</p>
        </div>
        <div data-reveal style="position:relative;margin-top:48px">
          <span aria-hidden="true" class="ab-sol-track" style="position:absolute;left:12.5%;right:12.5%;top:27px;height:2px;background:var(--pl-line-soft)"></span>

</PriceLeapLayout>

<style>
  .ab { background: var(--pl-surface); overflow-x: clip; }
  @keyframes pi-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.55); } 100% { box-shadow: 0 0 0 10px rgba(247,99,30,0); } }
  @keyframes pi-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes pi-spin { to { transform: rotate(360deg); } }
  @keyframes pi-orbit { to { transform: rotate(360deg); } }
  @keyframes pi-marquee { to { transform: translateX(-50%); } }
  @keyframes pi-dashx { to { background-position: 20px 0; } }
  @keyframes pi-ring { 0% { transform: scale(1); opacity: .55; } 100% { transform: scale(1.5); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ab *, .ab *::before, .ab *::after { animation: none !important; transition: none !important; } }

  .ab-hero-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 30%,#000 10%,transparent 72%); mask-image: radial-gradient(ellipse 70% 70% at 50% 30%,#000 10%,transparent 72%); pointer-events: none; }
  .ab-hero-glow { position: absolute; left: 50%; bottom: -300px; width: 1100px; height: 600px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(247,99,30,.15),transparent); pointer-events: none; }

  /* flow diagram */
  .ab-flow { margin-top: 56px; width: 100%; max-width: 1080px; display: grid; grid-template-columns: 1fr; align-items: center; gap: 0; text-align: left; }
  .ab-flow .ab-conn { display: none; }
  .ab-flow .ab-core { margin: 24px 0; }
  @media (min-width: 760px) {
    .ab-flow { grid-template-columns: minmax(0,1fr) minmax(40px,.3fr) auto minmax(40px,.3fr) minmax(0,1fr); }
    .ab-flow .ab-conn { display: block; }
    .ab-flow .ab-core { margin: 0; }
  }

  /* generic responsive helpers */
  .ab-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .ab-split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }
  .ab-sticky { position: relative; }
  @media (min-width: 1000px) { .ab-sticky { position: sticky; } }
  .ab-believe { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .ab-believe { grid-template-columns: minmax(0,.7fr) minmax(0,1.3fr); } }
  .ab-impact { display: grid; grid-template-columns: 1fr; }
  .ab-impact-r { border-top: 1px solid var(--pl-line-soft); }
  @media (min-width: 1000px) { .ab-impact { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } .ab-impact-r { border-top: none; border-left: 1px solid var(--pl-line-soft); } }

  .ab-val:hover, .ab-serve:hover, .ab-cv:hover { background: var(--pl-cream); }
  .ab-tm:hover { transform: translateY(-3px); }
  .ab-belief:hover { border-color: var(--pl-accent-line); transform: translateY(-3px); }

  /* solutions carousel */
  .ab-sol-grid { grid-template-columns: 1fr; }
  @media (min-width: 760px) { .ab-sol-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1000px) { .ab-sol-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .ab-sol-track, .ab-sol-fill { display: none; }
  @media (min-width: 1000px) { .ab-sol-track, .ab-sol-fill { display: block; } }
  .ab-sol-n { background: var(--pl-surface); border: 1.5px solid var(--pl-line); }
  .ab-sol-card { border: 1px solid var(--pl-line); box-shadow: none; }
  .ab-sol.is-on .ab-sol-n { background: var(--pl-accent); border-color: var(--pl-accent); box-shadow: 0 0 0 8px rgba(247,99,30,.16); }
  .ab-sol.is-done .ab-sol-n { background: var(--pl-accent); border-color: var(--pl-accent); }
  .ab-sol.is-on .ab-sol-card { border-color: var(--pl-accent-line); box-shadow: 0 24px 44px -28px rgba(194,65,12,.5); }
  @media (min-width: 1000px) { .ab-sol.is-on .ab-sol-card { transform: translateY(-4px); } }

  /* vs comparison */
  .ab-vs-line { background: repeating-linear-gradient(90deg,var(--pl-line) 0 6px,transparent 6px 12px); }
  .ab-vs-dot { background: var(--pl-surface); border: 1px solid var(--pl-line); }
  .ab-vs-b { background: var(--pl-cream); }
  .ab-vs.is-on .ab-vs-a { text-decoration: line-through; }
  .ab-vs.is-on .ab-vs-line { background: repeating-linear-gradient(90deg,var(--pl-accent) 0 6px,transparent 6px 12px); }
  .ab-vs.is-on .ab-vs-dot { background: var(--pl-accent); border-color: var(--pl-accent); }
  .ab-vs.is-on .ab-vs-b { background: var(--pl-accent-tint); }

  /* scroll reveal */
  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.ab');
  if (root) {
    // ---- cycling competitor + decision demo (2800ms) + solutions auto-advance ----
    const decs = [
      { sku: 'SKU 48201', price: '$184.99', action: 'Hold', margin: '+3.2%', rule: 'Floor 28%' },
      { sku: 'SKU 48201', price: '$181.49', action: 'Match −1%', margin: '+1.4%', rule: 'MAP ✓' },
      { sku: 'SKU 48201', price: '$192.00', action: 'Raise', margin: '+5.6%', rule: 'Rival OOS' },
      { sku: 'SKU 48201', price: '$179.99', action: 'Review', margin: '+0.8%', rule: 'Threshold' },
    ];
    const rivals = Array.from(root.querySelectorAll('[data-ab-rival]')) as HTMLElement[];
    const decCard = root.querySelector('[data-ab-dec]') as HTMLElement | null;
    const set = (sel: string, v: string) => { const el = root.querySelector(sel); if (el) el.textContent = v; };
    const sols = Array.from(root.querySelectorAll('[data-ab-sol]')) as HTMLElement[];
    const solFill = root.querySelector('[data-ab-solfill]') as HTMLElement | null;
    let sol = 0, autoSol = true;

    const paintSol = () => {
      sols.forEach((el, i) => {
        el.classList.toggle('is-on', i === sol);
        el.classList.toggle('is-done', i < sol);
      });
      if (solFill) solFill.style.width = Math.min(75, sol / 3 * 75) + '%';
    };
    sols.forEach((el, i) => {
      const pick = () => { sol = i; autoSol = false; paintSol(); };
      el.addEventListener('click', pick);
      el.addEventListener('mouseenter', pick);
    });

    let tick = 0;
    setInterval(() => {
      tick++;
      const hot = tick % 4;
      rivals.forEach((el, i) => {
        el.style.background = i === hot ? 'var(--pl-cream)' : 'var(--pl-surface)';
        el.style.borderColor = i === hot ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)';
      });
      const d = decs[tick % 4];
      set('[data-ab-sku]', d.sku); set('[data-ab-price]', d.price); set('[data-ab-action]', d.action);
      set('[data-ab-margin]', d.margin); set('[data-ab-rule]', d.rule);
      if (decCard) { decCard.style.animation = 'none'; void decCard.offsetWidth; decCard.style.animation = 'pi-in .45s ease'; }
      if (autoSol) { sol = (sol + 1) % 4; paintSol(); }
    }, 2800);
    paintSol();

    // ---- vs comparison hover ----
    root.querySelectorAll('[data-ab-vs]').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        root.querySelectorAll('[data-ab-vs]').forEach((r) => r.classList.remove('is-on'));
        row.classList.add('is-on');
      });
    });

    // ---- team bio accordion ----
    root.querySelectorAll('.ab-tm').forEach((card) => {
      const btn = card.querySelector('.ab-tm-btn') as HTMLElement | null;
      const bio = card.querySelector('.ab-tm-bio') as HTMLElement | null;
      const lbl = card.querySelector('.ab-tm-lbl') as HTMLElement | null;
      const chev = card.querySelector('.ab-tm-chev') as HTMLElement | null;
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        if (bio) bio.style.webkitLineClamp = open ? '4' : 'unset';
        if (lbl) lbl.textContent = open ? 'Read bio' : 'Show less';
        if (chev) chev.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
        (card as HTMLElement).style.borderColor = open ? 'var(--pl-line)' : 'var(--pl-accent-line)';
        (card as HTMLElement).style.boxShadow = open ? 'none' : '0 24px 44px -30px rgba(194,65,12,.5)';
      });
    });

    // ---- scroll reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      root.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    } else {
      root.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
    }
  }
</script>

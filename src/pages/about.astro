---
/**
 * About PriceLeap — native rebuild on the shared light design system.
 * Content ported 1:1 from about.html. No support.js.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import SectionHeader from '@/components/ds/nav/SectionHeader.astro';
import Tabs from '@/components/ds/nav/Tabs.astro';

const rivals = [
  { n: 'Competitor A', p: '$184.99', s: 'IN STOCK', sc: '#B01C1C' },
  { n: 'Marketplace B', p: '$179.50', s: '−3.0%', sc: '#C9372E' },
  { n: 'Retailer C', p: '$189.00', s: 'OUT', sc: '#5A6373' },
  { n: 'Reseller D', p: '$176.20', s: '−4.8%', sc: '#C9372E' },
];
const decision = { sku: 'SKU 48201', price: '$184.99', action: 'Hold', margin: '+3.2%', rule: 'Floor 28%' };

const sol = [
  { k: '01 — Competitive Intelligence', t: 'Market Visibility at Scale', d: 'Track competitor prices, stock availability, and market movements across thousands of SKUs with speed and precision.' },
  { k: '02 — Pricing Decision Engine', t: 'Data That Drives Action', d: 'Turn raw competitor data into structured decisions using configurable rules, pricing models, and real-time insights.' },
  { k: '03 — Control & Automation', t: 'Margin-Aligned Execution', d: 'Apply pricing strategies automatically — aligned with your margins, inventory levels, and business rules. Always in control.' },
  { k: '04 — Enterprise Integration', t: 'Connect Your Ecosystem', d: 'Seamlessly connect via APIs, ERP systems, and analytics tools. PriceLeap fits into your existing infrastructure.' },
];

const vs = [
  { a: 'Track prices', b: 'Turn data into decisions' },
  { a: 'Dashboards', b: 'Strategy enablement' },
  { a: 'Limited integrations', b: 'Deep integrations' },
  { a: 'Reactive alerts', b: 'Proactive control' },
];

const serve = [
  { t: 'Primary Customers', n: '01', items: ['E-commerce sellers', 'Multi-SKU brands', 'Online retailers', 'Distributors'] },
  { t: 'Industries', n: '02', items: ['Electronics', 'Automotive', 'Consumer goods', 'Industrial distribution'] },
  { t: 'Operational Scale', n: '03', items: ['Mid-market operations', 'Enterprise e-commerce', 'OEM pricing teams', 'Complex SKU environments'] },
];

const team = [
  { n: 'Seema Phull', r: 'Executive Advisor, USA', b: 'Provides strategic guidance to the leadership team, shaping company direction. With 25+ years of driving change in Aerospace, Defense, and Renewable Energy, she has led turnarounds and improvements, including doubling EBITDA for a distressed aerospace firm and building a global supply chain for a Blackstone portfolio company.' },
  { n: 'Justin Dye', r: 'Technology & Analytics, USA', b: 'Drives innovation, leveraging data, and ensuring the technological backbone aligns with business goals. Justin has a proven track record of driving market-leading growth through analytics, risk management, and operational excellence. Global industry experience across Defense and Space, Aerospace, Transportation, and Hi-Tech industries.' },
  { n: 'Mike Kapusta', r: 'Strategic Solutions & Business Development, USA', b: 'Drives growth by identifying new opportunities, creating tailored solutions, and building strong relationships. Mike has 25 years of experience in driving corporate growth and profitability through customer-centric and solutions-focused strategies.' },
  { n: 'Joshua McDonough', r: 'Operations & Commercial Excellence, USA', b: 'Drives efficiency, profitability, and alignment between operational and commercial strategies. 25 years of experience in business improvement through process analysis, demand forecasting, strategic planning, inventory management, and supply chain management. Expertise in transformative projects in Aerospace, Defense, Medical Device, CPG, High Tech, and Renewable Energy sectors.' },
  { n: 'Jyothish R', r: 'CTO & Global Delivery Officer', b: 'Leads the delivery and innovation team with a strong focus on operational efficiency and client success. Jyothish brings experience from Honeywell, Oracle, and Ford Motors. Key responsibilities include: ensuring customer success and strategic alignment, championing an AI- and automation-first mindset, developing new capabilities aligned with business goals, and driving team growth through continuous enablement and leadership.' },
  { n: 'Biju M L', r: 'Chief Growth Officer', b: "Leads the organization's growth strategy with a focus on revenue generation, market expansion, and customer success. Biju brings 17+ years of experience across small to large enterprises, having worked at Cognizant and Capgemini before joining AIMLEAP. Key focus areas include: developing and executing data-driven strategies, identifying new market opportunities, scaling revenue streams, building strategic partnerships, aligning marketing, sales, and product functions, and leveraging innovation to accelerate growth." },
  { n: 'Jay Suresh', r: 'Head – HR & Operations', b: 'Seasoned HR leader with over a decade of experience. Known for driving organizational success through people-centric strategies, fostering high-performance cultures, and empowering talent. Focus areas include: innovative hiring and retention strategies, engagement initiatives to boost alignment and motivation, championing DEI programs, and aligning HR strategy with long-term business goals.' },
  { n: 'Edwin P. Davis', r: 'Strategic Alliances & Partnerships', b: 'Brings a unique blend of operational excellence & strategic insight, backed in project and operations roles & an MBA in Marketing from a Tier 1 institute. He has worked across leading tech & consulting firms. At AIMLEAP, he drives cross-functional collaboration, global partnerships, and growth initiatives. Areas of expertise include GTM strategy, CXO reporting, KPI dashboards, & crafting scalable, insight-led strategies for long-term impact.' },
];
const ini = (n: string) => n.replace(/\./g, '').split(' ').filter(Boolean).map(x => x[0]).slice(0, 2).join('');

const values = [
  { t: 'Real-Time Alerts', d: 'Instant notifications via Email, Slack, and SMS — so you never miss a market move.' },
  { t: 'Clear Price Positioning', d: 'Understand exactly where you stand against competitors at any moment.' },
  { t: 'Margin Protection', d: 'Rule-based logic ensures your pricing never erodes the margins that matter.' },
  { t: 'Reduced Manual Effort', d: 'Eliminate spreadsheet-based tracking and fragmented monitoring tools permanently.' },
  { t: 'Scalable Across SKUs', d: 'Apply consistent pricing intelligence across thousands of products simultaneously.' },
];

const beliefs = [
  'Pricing should be a system, not guesswork — built on data, rules, and repeatable logic.',
  'Control matters more than automation. The best systems keep humans confidently in charge.',
  'Speed is a competitive advantage. Responding to market changes faster wins margins.',
  "Data must lead to action. Dashboards that don't drive decisions are just noise.",
  'Infrastructure over tools. Sustainable businesses are built on platforms, not point solutions.',
  'Customer-centricity is built into every layer — from the interface to the integration.',
];

const impact = [
  'Faster response to market changes',
  'Better pricing consistency across all SKUs',
  'Stronger margins through rule-based protection',
  'Dramatically reduced manual pricing work',
  'More confident, data-backed pricing decisions',
];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PriceLeap',
  description: 'PriceLeap is a pricing intelligence engine that transforms competitor data into structured, real-time pricing decisions.',
  url: 'https://priceleap.ai/about',
  logo: 'https://priceleap.ai/assets/pl-mark.png',
};
---

<SiteLayout
  title="About PriceLeap · Pricing Intelligence Built for Scale"
  description="PriceLeap is a pricing intelligence engine that transforms competitor data into structured, real-time pricing decisions."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgLd)} />

  <!-- ══ HERO ══ -->
  <section class="ab-hero">
    <div class="ab-hero__grid" aria-hidden="true"></div>
    <div class="ab-hero__glow" aria-hidden="true"></div>
    <div class="ab-wrap ab-hero__inner">
      <div class="ab-hero__copy">
        <span class="ab-eyebrow"><span class="ab-eyebrow__dot"></span>About PriceLeap</span>
        <h1 class="ab-h1"><span class="w4">Turn Competitor Prices Into </span><b>Pricing Decisions</b></h1>
        <p class="ab-lead">We help companies move beyond manual tracking and fragmented tools by transforming competitor data into structured, real-time pricing decisions.</p>
        <div class="ab-hero__btns">
          <a href="/book-a-demo" class="ab-btn ab-btn--primary">Book a demo</a>
          <a href="/price-intelligence-engine" class="ab-btn ab-btn--secondary">Explore the platform <span>→</span></a>
        </div>
      </div>
      <div class="ab-hero__card-wrap">
        <div class="ab-card">
          <div class="ab-card__head">
            <span class="ab-dots"><i></i><i></i><i></i></span>
            <span class="ab-card__title">Competitor prices → decision</span>
            <span class="ab-live"><span class="ab-live__dot"></span>LIVE</span>
          </div>
          <div class="ab-card__rivals">
            {rivals.map(r => (
              <div class="ab-rival">
                <span class="ab-rival__n">{r.n}</span>
                <span class="ab-rival__p">{r.p}</span>
                <span class="ab-rival__s" style={`color:${r.sc}`}>{r.s}</span>
              </div>
            ))}
          </div>
          <div class="ab-card__dec">
            <div class="ab-dec__left"><span class="ab-dec__sku">{decision.sku}</span><span class="ab-dec__price">{decision.price}</span></div>
            <div class="ab-dec__right">
              <span class="ab-dec__action">{decision.action}</span>
              <span class="ab-dec__meta">{decision.margin} · {decision.rule}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ WHO WE ARE ══ -->
  <section class="ab-sec">
    <div class="ab-wrap ab-split" data-reveal>
      <div>
        <span class="ab-eyebrow"><span class="ab-eyebrow__sq"></span>Who we are</span>
        <h2 class="ab-h2"><span class="w4">PriceLeap helps businesses </span><b>compete with confidence, act with speed, and scale with control.</b></h2>
      </div>
      <div class="ab-split__body">
        <p>PriceLeap is a pricing intelligence engine built for businesses operating in complex pricing environments. We transform competitor data into structured, real-time pricing decisions.</p>
        <p>PriceLeap is designed as a scalable pricing infrastructure — enabling businesses to respond faster, protect margins, and maintain control across thousands of SKUs.</p>
        <p class="ab-muted">PriceLeap is not just a tool — it is a pricing decision engine that bridges SaaS simplicity with enterprise-grade capability.</p>
      </div>
    </div>
  </section>

  <!-- ══ MISSION & VISION ══ -->
  <section class="ab-sec ab-sec--tint">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="Mission & Vision" title="Building pricing infrastructure on a foundation of" accent="principles that matter." align="center" /></div>
      <div class="ab-mv" data-reveal>
        <div class="ab-mv__card">
          <span class="ab-mv__k">MISSION</span>
          <p>To empower businesses with the speed, clarity, and control to make smarter pricing decisions — transforming complex market data into structured, scalable intelligence that eliminates guesswork.</p>
        </div>
        <div class="ab-mv__card ab-mv__card--accent">
          <span class="ab-mv__k">VISION</span>
          <p>To become the core pricing infrastructure layer powering how businesses monitor, decide, and execute pricing strategies globally.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ OUR SOLUTION ══ -->
  <section class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="Our solution" title="Four integrated capabilities that move you from price watching to" accent="pricing control." align="center" /></div>
      <div class="ab-sol" data-reveal>
        <Tabs tabs={sol.map(x => x.k)} id="ab-sol" variant="underline">
          <div slot="panel-0"><div class="ab-step"><h3>{sol[0].t}</h3><p>{sol[0].d}</p></div></div>
          <div slot="panel-1"><div class="ab-step"><h3>{sol[1].t}</h3><p>{sol[1].d}</p></div></div>
          <div slot="panel-2"><div class="ab-step"><h3>{sol[2].t}</h3><p>{sol[2].d}</p></div></div>
          <div slot="panel-3"><div class="ab-step"><h3>{sol[3].t}</h3><p>{sol[3].d}</p></div></div>
        </Tabs>
      </div>
    </div>
  </section>

  <!-- ══ HOW WE DELIVER (Traditional vs PriceLeap) ══ -->
  <section class="ab-sec ab-sec--tint">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="How we deliver" title="How PriceLeap" accent="delivers value." lead="Four integrated capabilities that move you from price watching to pricing control." align="center" /></div>
      <div class="ab-vs" data-reveal>
        <div class="ab-vs__head"><span>Traditional Tools</span><span class="ab-vs__head-on">PriceLeap</span></div>
        {vs.map(row => (
          <div class="ab-vs__row">
            <span class="ab-vs__a"><span class="ab-vs__x">✕</span>{row.a}</span>
            <span class="ab-vs__b"><span class="ab-vs__check">✓</span>{row.b}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHO WE SERVE ══ -->
  <section class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="Who we serve" title="Built specifically for mid-market to enterprise operations in" accent="complex pricing environments." align="center" /></div>
      <div class="ab-serve" data-reveal>
        {serve.map(g => (
          <div class="ab-serve__card">
            <div class="ab-serve__top"><span class="ab-serve__n">{g.n}</span><h3>{g.t}</h3></div>
            <ul>{g.items.map(it => <li><span class="ab-dot"></span>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ OUR PEOPLE ══ -->
  <section class="ab-sec ab-sec--tint">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="Our people" title="Meet the dedicated team at" accent="PriceLeap." lead="Committed to transforming pricing complexity into competitive advantage for businesses worldwide." align="center" /></div>
      <div class="ab-team" data-reveal>
        {team.map(m => (
          <details class="ab-member">
            <summary>
              <span class="ab-member__head">
                <span class="ab-member__av">{ini(m.n)}</span>
                <span class="ab-member__id"><b>{m.n}</b><small>{m.r}</small></span>
              </span>
              <span class="ab-member__bio">{m.b}</span>
              <span class="ab-member__toggle" aria-hidden="true"></span>
            </summary>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ BANNER ══ -->
  <section class="ab-banner">
    <div class="ab-wrap ab-banner__inner" data-reveal>
      <span class="ab-eyebrow"><span class="ab-eyebrow__dot"></span>Smarter Pricing Starts Here</span>
      <h2 class="ab-banner__h">Compete with confidence. Act with speed. Scale with control.</h2>
      <a href="/book-a-demo" class="ab-btn ab-btn--primary">Book a demo</a>
    </div>
  </section>

  <!-- ══ CORE VALUES ══ -->
  <section class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="Core values" title="Our" accent="core values." align="center" /></div>
      <div class="ab-values" data-reveal>
        {values.map((v, i) => (
          <div class="ab-value">
            <span class="ab-value__n">0{i + 1}</span>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHAT WE BELIEVE ══ -->
  <section class="ab-sec ab-sec--tint">
    <div class="ab-wrap ab-believe">
      <div class="ab-believe__head" data-reveal>
        <span class="ab-eyebrow"><span class="ab-eyebrow__sq"></span>What we believe</span>
        <h2 class="ab-h2">Pricing decisions depend on <b>data you can trust.</b></h2>
        <p class="ab-muted">We build systems that perform consistently at scale.</p>
      </div>
      <div class="ab-believe__list" data-reveal>
        {beliefs.map((b, i) => (
          <div class="ab-belief"><span class="ab-belief__n">0{i + 1}</span><p>{b}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CUSTOMER IMPACT ══ -->
  <section class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal><SectionHeader eyebrow="Customer impact" title="What changes with" accent="PriceLeap." align="center" /></div>
      <div class="ab-impact" data-reveal>
        {impact.map(it => <div class="ab-impact__row"><span class="ab-impact__check">✓</span>{it}</div>)}
      </div>
      <div class="ab-cta" data-reveal>
        <a href="/book-a-demo" class="ab-btn ab-btn--primary">Book a demo</a>
        <a href="/contact" class="ab-btn ab-btn--secondary">Talk to us <span>→</span></a>
      </div>
    </div>
  </section>

</SiteLayout>

<style>
.ab-wrap { max-width: var(--pl-container); margin: 0 auto; padding-left: var(--pl-gutter); padding-right: var(--pl-gutter); }
.ab-sec { padding: clamp(64px,8vw,112px) 0; border-bottom: 1px solid var(--pl-line); }
.ab-sec--tint { background: #FBFBFA; }
.ab-h1 { margin: 24px 0 0; font-family: var(--pl-font); font-size: clamp(38px,5.4vw,68px); line-height: 1.02; letter-spacing: -.045em; color: #0A0A0A; text-wrap: balance; font-weight: 700; }
.ab-h1 .w4 { font-weight: 400; }
.ab-h2 { margin: 16px 0 0; font-family: var(--pl-font); font-size: clamp(28px,3.6vw,44px); line-height: 1.08; letter-spacing: -.03em; color: #0A0A0A; text-wrap: balance; font-weight: 700; }
.ab-h2 .w4 { font-weight: 400; }
.ab-h2 b { font-weight: 700; }
.ab-lead { margin: 22px 0 0; max-width: 560px; font-size: 18px; line-height: 1.6; color: #3A414C; }
.ab-muted { color: #5A6373 !important; }
.ab-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--pl-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #B01C1C; }
.ab-eyebrow__dot { width: 7px; height: 7px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.8s ease-out infinite; }
.ab-eyebrow__sq { width: 7px; height: 7px; border-radius: 2px; background: #FF3131; }
.ab-dot { width: 5px; height: 5px; border-radius: 50%; background: #FF3131; flex: none; }

.ab-btn { height: 48px; padding: 0 22px; display: inline-flex; align-items: center; gap: 10px; border-radius: 12px; font-family: var(--pl-font); font-weight: 500; font-size: 15px; transition: all .2s; }
.ab-btn--primary { background: #FF3131; color: #0A0A0A; box-shadow: 0 12px 26px -12px rgba(255, 49, 49,.9); }
.ab-btn--primary:hover { background: #F23830; color: #0A0A0A; }
.ab-btn--secondary { background: #fff; border: 1px solid var(--pl-line); color: #0A0A0A; }
.ab-btn--secondary:hover { border-color: #C4CAC4; }
.ab-btn--secondary span { color: #B01C1C; }

/* hero */
.ab-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
.ab-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(#EEF0EE 1px,transparent 1px),linear-gradient(90deg,#EEF0EE 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 70% 80% at 75% 35%,#000 10%,transparent 70%); pointer-events: none; }
.ab-hero__glow { position: absolute; right: -10%; top: -20%; width: 720px; height: 620px; background: radial-gradient(closest-side,rgba(255, 49, 49,.14),transparent); pointer-events: none; }
.ab-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); gap: clamp(40px,5vw,64px); align-items: center; padding-top: clamp(56px,8vw,104px); padding-bottom: clamp(56px,7vw,88px); }
.ab-hero__btns { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; }

.ab-hero__card-wrap { min-width: 0; }
.ab-card { background: #fff; border: 1px solid var(--pl-line); border-radius: 20px; box-shadow: 0 40px 80px -40px rgba(10,10,10,.28); overflow: hidden; }
.ab-card__head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid #EEF0EE; background: #FBFBFA; }
.ab-dots { display: flex; gap: 5px; }
.ab-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--pl-line); }
.ab-card__title { font-size: 13px; font-weight: 500; color: #0A0A0A; }
.ab-live { margin-left: auto; display: flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 999px; background: #E8FCEF; border: 1px solid #FFD6C8; font-family: var(--pl-mono); font-size: 10px; color: #B01C1C; }
.ab-live__dot { width: 6px; height: 6px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.6s infinite; }
.ab-card__rivals { padding: 6px 8px; }
.ab-rival { display: grid; grid-template-columns: 1fr auto 72px; gap: 12px; align-items: center; padding: 12px 10px; border-top: 1px solid #EEF0EE; }
.ab-rival:first-child { border-top: none; }
.ab-rival__n { font-size: 13px; color: #0A0A0A; }
.ab-rival__p { font-family: var(--pl-font); font-size: 14px; font-weight: 600; color: #0A0A0A; }
.ab-rival__s { font-family: var(--pl-mono); font-size: 11px; text-align: right; }
.ab-card__dec { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px; border-top: 1px solid #EEF0EE; background: #F4FDF7; }
.ab-dec__sku { font-family: var(--pl-mono); font-size: 10px; color: #6E7684; display: block; }
.ab-dec__price { font-family: var(--pl-font); font-size: 22px; font-weight: 600; letter-spacing: -.02em; color: #0A0A0A; }
.ab-dec__right { text-align: right; }
.ab-dec__action { display: inline-flex; align-items: center; height: 26px; padding: 0 12px; border-radius: 8px; background: #FF3131; color: #0A0A0A; font-family: var(--pl-font); font-weight: 600; font-size: 13px; }
.ab-dec__meta { display: block; margin-top: 4px; font-family: var(--pl-mono); font-size: 10px; color: #B01C1C; }

/* split who-we-are */
.ab-split { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(32px,5vw,64px); align-items: start; }
.ab-split__body p { margin: 0 0 16px; font-size: 17px; line-height: 1.65; color: #3A414C; }
.ab-split__body p:last-child { margin-bottom: 0; }

/* mission/vision */
.ab-mv { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.ab-mv__card { border: 1px solid var(--pl-line); border-radius: 20px; background: #fff; padding: 32px; }
.ab-mv__card--accent { border: 1.5px solid #FF3131; box-shadow: 0 0 0 6px rgba(255, 49, 49,.08); }
.ab-mv__k { font-family: var(--pl-mono); font-size: 11px; letter-spacing: .12em; color: #B01C1C; }
.ab-mv__card p { margin: 14px 0 0; font-size: 17px; line-height: 1.6; color: #3A414C; }

/* solution tabs */
.ab-sol { margin-top: 48px; border: 1px solid var(--pl-line); border-radius: 20px; background: #fff; padding: clamp(20px,3vw,32px); }
.ab-step h3 { margin: 0; font-family: var(--pl-font); font-size: 22px; font-weight: 600; letter-spacing: -.02em; color: #0A0A0A; }
.ab-step p { margin: 12px 0 0; font-size: 16px; line-height: 1.6; color: #3A414C; max-width: 680px; }

/* vs table */
.ab-vs { margin-top: 48px; border: 1px solid var(--pl-line); border-radius: 20px; overflow: hidden; max-width: 820px; margin-left: auto; margin-right: auto; }
.ab-vs__head, .ab-vs__row { display: grid; grid-template-columns: 1fr 1fr; }
.ab-vs__head { background: #FBFBFA; border-bottom: 1px solid var(--pl-line); }
.ab-vs__head span { padding: 14px 20px; font-family: var(--pl-mono); font-size: 11px; letter-spacing: .08em; color: #5A6373; }
.ab-vs__head-on { color: #B01C1C; border-left: 1px solid #FFD6C8; }
.ab-vs__row { border-bottom: 1px solid #EEF0EE; transition: background .2s; }
.ab-vs__row:last-child { border-bottom: none; }
.ab-vs__row:hover { background: #F4FDF7; }
.ab-vs__a, .ab-vs__b { display: flex; align-items: center; gap: 10px; padding: 18px 20px; font-size: 15px; }

---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const rivals = [
  { n: 'Rival A · Marketplace', s: 'LIVE', p: '$184.00', sc: 'var(--pl-accent-ink)' },
  { n: 'Rival B · D2C store', s: '−4.2%', p: '$176.50', sc: 'var(--pl-danger-ink)' },
  { n: 'Rival C · Retailer', s: 'OOS', p: '—', sc: 'var(--pl-faint)' },
  { n: 'Rival D · Marketplace', s: 'LIVE', p: '$189.99', sc: 'var(--pl-accent-ink)' },
];
const dec = { sku: 'SKU 48201', price: '$181.49', action: 'Reprice', margin: '+4.1%', rule: 'Beat cheapest' };

const solData = [
  { k: '01 · Competitive Intelligence', t: 'Market Visibility at Scale', d: 'Track competitor prices, stock availability, and market movements across thousands of SKUs with speed and precision.' },
  { k: '02 · Pricing Decision Engine', t: 'Data That Drives Action', d: 'Turn raw competitor data into structured decisions using configurable rules, pricing models, and real-time insights.' },
  { k: '03 · Control & Automation', t: 'Margin-Aligned Execution', d: 'Apply pricing strategies automatically — aligned with your margins, inventory levels, and business rules. Always in control.' },
  { k: '04 · Enterprise Integration', t: 'Connect Your Ecosystem', d: 'Seamlessly connect via APIs, ERP systems, and analytics tools. PriceLeap fits into your existing infrastructure.' },
];
const valData = [
  { t: 'Real-Time Alerts', d: 'Instant notifications via Email, Slack, and SMS — so you never miss a market move.', r: '50%', rot: '0' },
  { t: 'Clear Price Positioning', d: 'Understand exactly where you stand against competitors at any moment.', r: '4px', rot: '0' },
  { t: 'Margin Protection', d: 'Rule-based logic ensures your pricing never erodes the margins that matter.', r: '2px', rot: '45' },
  { t: 'Reduced Manual Effort', d: 'Eliminate spreadsheet-based tracking and fragmented monitoring tools permanently.', r: '4px', rot: '0' },
  { t: 'Scalable Across SKUs', d: 'Apply consistent pricing intelligence across thousands of products simultaneously.', r: '50%', rot: '0' },
];
const vs = [['Track prices', 'Turn data into decisions'], ['Dashboards', 'Strategy enablement'], ['Limited integrations', 'Deep integrations'], ['Reactive alerts', 'Proactive control']];
const serve = [
  { t: 'Primary Customers', n: '01', items: ['E-commerce sellers', 'Multi-SKU brands', 'Online retailers', 'Distributors'] },
  { t: 'Industries', n: '02', items: ['Electronics', 'Automotive', 'Consumer goods', 'Industrial distribution'] },
  { t: 'Operational Scale', n: '03', items: ['Mid-market operations', 'Enterprise e-commerce', 'OEM pricing teams', 'Complex SKU environments'] },
];
const tm = [
  ['Seema Phull', 'Executive Advisor, USA', 'Provides strategic guidance to the leadership team, shaping company direction. With 25+ years of driving change in Aerospace, Defense, and Renewable Energy, she has led turnarounds and improvements, including doubling EBITDA for a distressed aerospace firm and building a global supply chain for a Blackstone portfolio company.'],
  ['Justin Dye', 'Technology & Analytics, USA', 'Drives innovation, leveraging data, and ensuring the technological backbone aligns with business goals. Justin has a proven track record of driving market-leading growth through analytics, risk management, and operational excellence. Global industry experience across Defense and Space, Aerospace, Transportation, and Hi-Tech industries.'],
  ['Mike Kapusta', 'Strategic Solutions & Business Development, USA', 'Drives growth by identifying new opportunities, creating tailored solutions, and building strong relationships. Mike has 25 years of experience in driving corporate growth and profitability through customer-centric and solutions-focused strategies.'],
  ['Joshua McDonough', 'Operations & Commercial Excellence, USA', 'Drives efficiency, profitability, and alignment between operational and commercial strategies. 25 years of experience in business improvement through process analysis, demand forecasting, strategic planning, inventory management, and supply chain management.'],
  ['Jyothish R', 'CTO & Global Delivery Officer', 'Leads the delivery and innovation team with a strong focus on operational efficiency and client success. Jyothish brings experience from Honeywell, Oracle, and Ford Motors, championing an AI- and automation-first mindset and driving team growth through continuous enablement.'],
  ['Biju M L', 'Chief Growth Officer', 'Leads the organization’s growth strategy with a focus on revenue generation, market expansion, and customer success. Biju brings 17+ years of experience across small to large enterprises, having worked at Cognizant and Capgemini before joining AIMLEAP.'],
  ['Jay Suresh', 'Head – HR & Operations', 'Seasoned HR leader with over a decade of experience. Known for driving organizational success through people-centric strategies, fostering high-performance cultures, and empowering talent.'],
  ['Edwin P. Davis', 'Strategic Alliances & Partnerships', 'Brings a unique blend of operational excellence and strategic insight, backed by project and operations roles and an MBA in Marketing. At AIMLEAP he drives cross-functional collaboration, global partnerships, and growth initiatives.'],
];
const team = tm.map(([n, r, b]) => ({ n, r, b, ini: n.replace(/\./g, '').split(' ').filter(Boolean).map((x) => x[0]).slice(0, 2).join('') }));
const beliefs = [
  'Pricing should be a system, not guesswork — built on data, rules, and repeatable logic.',
  'Control matters more than automation. The best systems keep humans confidently in charge.',
  'Speed is a competitive advantage. Responding to market changes faster wins margins.',
  'Data must lead to action. Dashboards that don’t drive decisions are just noise.',
  'Infrastructure over tools. Sustainable businesses are built on platforms, not point solutions.',
  'Customer-centricity is built into every layer — from the interface to the integration.',
].map((t, i) => ({ t, n: '0' + (i + 1) }));
const impact = ['Faster response to market changes', 'Better pricing consistency across all SKUs', 'Stronger margins through rule-based protection', 'Dramatically reduced manual pricing work', 'More confident, data-backed pricing decisions'];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About PriceLeap',
  url: 'https://priceleap.ai/about',
}];
---
<PriceLeapLayout title="About PriceLeap · Turn Competitor Prices Into Pricing Decisions" description="PriceLeap is a pricing intelligence engine that transforms competitor data into structured, real-time pricing decisions for mid-market to enterprise teams." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="ab-hero">
    <div aria-hidden="true" class="ab-hero-grid"></div>
    <div aria-hidden="true" class="ab-hero-glow"></div>
    <div class="ab-hero-inner">
      <span class="ab-badge"><span class="ab-badge-dot"></span>About PriceLeap</span>
      <h1 class="ab-h1"><span style="font-weight:400">Turn Competitor Prices Into </span><span style="font-weight:700">Pricing Decisions</span></h1>
      <p class="ab-lead">PriceLeap is a pricing intelligence engine built for businesses operating in complex pricing environments. We transform competitor data into structured, real-time pricing decisions.</p>
      <div class="ab-pills-strip">
        {['Pricing Intelligence', 'Real-Time Decisions', 'Enterprise Scale', 'Deep Integration'].map((t) => (<span class="ab-pill-strip"><span class="ab-pill-sq"></span>{t}</span>)) }
      </div>
      <div class="ab-flow">
        <div class="ab-flow-card">
          <div class="ab-flow-head"><span>COMPETITOR DATA</span><span style="color:var(--pl-accent-ink)">LIVE</span></div>
          {rivals.map((r) => (
            <div class="ab-rival"><span class="ab-rival-n">{r.n}</span><span class="ab-rival-s" style={`color:${r.sc}`}>{r.s}</span><span class="ab-rival-p">{r.p}</span></div>
          ))}
        </div>
        <span aria-hidden="true" class="ab-flow-dash"></span>
        <div class="ab-flow-core">
          <span class="ab-core-ring"><span class="ab-core-orbit"></span><span class="ab-core-box"><img src="/assets/pl-mark.png" alt="" width="36" height="34" /></span></span>
          <span class="ab-core-label">DECISION ENGINE</span>
        </div>
        <span aria-hidden="true" class="ab-flow-dash"></span>
        <div class="ab-flow-dec">
          <div class="ab-dec-head"><span>PRICING DECISION</span><span>{dec.sku}</span></div>
          <div class="ab-dec-price"><span>{dec.price}</span><span class="ab-dec-action">{dec.action}</span></div>
          <div class="ab-dec-tags"><span class="ab-dec-tag">Margin <b style="color:var(--pl-accent-ink)">{dec.margin}</b></span><span class="ab-dec-tag">Rule <b>{dec.rule}</b></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section id="who" class="ab-sec">
    <div class="ab-split">
      <div data-reveal>
        <span class="ab-eyebrow"><span class="ab-sq"></span>Who We Are</span>
        <h2 class="ab-h2"><span style="font-weight:400">Pricing Intelligence </span><span style="font-weight:700">Built for Scale</span></h2>
        <div class="ab-paras">
          <p>PriceLeap is designed as a scalable pricing infrastructure — enabling businesses to respond faster, protect margins, and maintain control across thousands of SKUs.</p>
          <p>We help companies move beyond manual tracking and fragmented tools by transforming competitor data into structured, real-time pricing decisions.</p>
          <p>Track competitor prices, monitor stock availability, and respond to market changes — all within a system designed for speed, control, and scale.</p>
        </div>
      </div>
      <div data-reveal class="ab-who-right">
        <div class="ab-quote">PriceLeap is not just a tool — it is a pricing decision engine that bridges SaaS simplicity with enterprise-grade capability.</div>
        <div class="ab-stats">
          <div class="ab-stat"><div class="ab-stat-n">1000s</div><div class="ab-stat-l">SKUs Tracked</div></div>
          <div class="ab-stat"><div class="ab-stat-n ab-stat-row">Real-Time<span class="ab-stat-dot"></span></div><div class="ab-stat-l">Price Intelligence</div></div>
          <div class="ab-stat"><div class="ab-stat-n">3<span style="color:var(--pl-accent)">+</span></div><div class="ab-stat-l">Alert Channels</div></div>
          <div class="ab-stat"><div class="ab-stat-n">100<span style="color:var(--pl-accent)">%</span></div><div class="ab-stat-l">Decision Driven</div></div>
        </div>
        <div class="ab-tags">{['Mid-Market', 'Enterprise', 'E-Commerce', 'Distributors', 'OEMs'].map((t) => (<span class="ab-tag">{t}</span>))}</div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section id="purpose" class="ab-sec ab-cream">
    <div class="ab-wrap">
      <div data-reveal class="ab-center">
        <span class="ab-eyebrow"><span class="ab-sq"></span>Our Purpose</span>
        <h2 class="ab-h2"><span style="font-weight:400">Mission </span><span style="font-weight:700">&amp; Vision</span></h2>
      </div>
      <div data-reveal class="ab-mv">
        <div class="ab-mv-card"><span class="ab-mv-k">Our Mission</span><p>To empower businesses with the speed, clarity, and control to make smarter pricing decisions — transforming complex market data into structured, scalable intelligence that eliminates guesswork.</p></div>
        <div class="ab-mv-card"><span class="ab-mv-k">Our Vision</span><p>To become the core pricing infrastructure layer powering how businesses monitor, decide, and execute pricing strategies globally.</p></div>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section id="solution" class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal class="ab-sol-head">
        <div><span class="ab-eyebrow"><span class="ab-sq"></span>What We Do</span><h2 class="ab-h2"><span style="font-weight:400">Our </span><span style="font-weight:700">Solution</span></h2></div>
        <p class="ab-sol-p">Four integrated capabilities that move you from price watching to pricing control.</p>
      </div>
      <div data-reveal class="ab-sol-grid">
        {solData.map((s, i) => (
          <div class="ab-sol-card">
            <span class="ab-sol-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="ab-sol-body">
              <span class="ab-sol-k">{s.k}</span>
              <span class="ab-sol-t">{s.t}</span>
              <span class="ab-sol-d">{s.d}</span>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we deliver -->
  <section id="deliver" class="ab-sec ab-cream">
    <div class="ab-wrap">
      <div data-reveal class="ab-narrow">
        <span class="ab-eyebrow"><span class="ab-sq"></span>How We Deliver</span>
        <h2 class="ab-h2"><span style="font-weight:400">How PriceLeap </span><span style="font-weight:700">Delivers Value</span></h2>
      </div>
      <div class="ab-deliver">
        <div data-reveal class="ab-values">
          {valData.map((v) => (
            <div class="ab-value"><span class="ab-value-ico"><span class="ab-value-sq" style={`border-radius:${v.r};transform:rotate(${v.rot}deg)`}></span></span><span><span class="ab-value-t">{v.t}</span><span class="ab-value-d">{v.d}</span></span></div>
          ))}
        </div>
        <div data-reveal class="ab-vs">
          <div class="ab-vs-head">Traditional Tools vs PriceLeap</div>
          <div class="ab-vs-labels"><span class="ab-vs-l1">Traditional</span><span></span><span class="ab-vs-l2">PriceLeap</span></div>
          {vs.map(([a, b]) => (
            <div class="ab-vs-row"><span class="ab-vs-a">{a}</span><span class="ab-vs-arrow"><span class="ab-vs-line"></span><span class="ab-vs-dot">→</span></span><span class="ab-vs-b">{b}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section id="market" class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal class="ab-center">
        <span class="ab-eyebrow"><span class="ab-sq"></span>Our Market</span>
        <h2 class="ab-h2"><span style="font-weight:400">Who We </span><span style="font-weight:700">Serve</span></h2>
        <p class="ab-center-p">Built specifically for mid-market to enterprise operations in complex pricing environments.</p>
      </div>
      <div data-reveal class="ab-serve">
        {serve.map((c) => (
          <div class="ab-serve-col">
            <div class="ab-serve-head"><span>{c.t}</span><span class="ab-serve-n">{c.n}</span></div>
            <div class="ab-serve-items">{c.items.map((i) => (<span class="ab-serve-item"><span class="ab-diamond"></span>{i}</span>))}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="ab-sec ab-cream">
    <div class="ab-wrap">
      <div data-reveal class="ab-team-head">
        <div><span class="ab-eyebrow"><span class="ab-sq"></span>The Team</span><h2 class="ab-h2"><span style="font-weight:400">Our </span><span style="font-weight:700">People</span></h2></div>
        <p class="ab-team-p">Meet the dedicated team at PriceLeap, committed to transforming pricing complexity into competitive advantage for businesses worldwide.</p>
      </div>
      <div data-reveal class="ab-team-grid">
        {team.map((p) => (
          <div class="ab-member">
            <div class="ab-member-photo"><span class="ab-member-ini">{p.ini}</span></div>
            <div class="ab-member-body">
              <div><div class="ab-member-n">{p.n}</div><div class="ab-member-r">{p.r}</div></div>
              <p class="ab-member-bio" data-bio>{p.b}</p>
              <button type="button" class="ab-member-btn" data-bio-toggle>Read bio<span class="ab-member-caret">↓</span></button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <section class="ab-banner" aria-label="Smarter Pricing Starts Here">
    <div class="ab-marquee">
      {[0, 1, 2, 3, 4, 5].map((i) => (<span class="ab-marquee-item" style={`font-weight:${i % 2 ? 400 : 700};color:${i % 2 ? 'var(--pl-line-xstrong)' : 'var(--pl-ink)'}`}>Smarter Pricing Starts Here<span class="ab-marquee-sq"></span></span>))}
    </div>
  </section>

  <!-- Core values -->
  <section id="values" class="ab-sec">
    <div class="ab-wrap">
      <div data-reveal class="ab-center">
        <span class="ab-eyebrow"><span class="ab-sq"></span>What Drives Us</span>
        <h2 class="ab-h2"><span style="font-weight:400">Our Core </span><span style="font-weight:700">Values</span></h2>
        <p class="ab-center-p">Building pricing infrastructure on a foundation of principles that matter.</p>
      </div>
      <div data-reveal class="ab-coreval">
        {[
          { t: 'Clarity', d: 'Every insight we surface is clear, actionable, and free of ambiguity — because decisions require certainty.' },
          { t: 'Reliability', d: 'Pricing decisions depend on data you can trust. We build systems that perform consistently at scale.' },
          { t: 'Control', d: 'Automation without control is risk. We keep your team in command of every pricing strategy and outcome.' },
          { t: 'Scalability', d: 'Built from the ground up to grow with your business — from hundreds to hundreds of thousands of SKUs.' },
        ].map((v) => (
          <div class="ab-cv"><span class="ab-cv-ico"><span class="ab-cv-dot"></span></span><span class="ab-cv-t">{v.t}</span><p>{v.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we believe -->
  <section id="believe" class="ab-sec ab-cream">
    <div class="ab-believe">
      <div data-reveal class="ab-believe-left">
        <span class="ab-eyebrow"><span class="ab-sq"></span>Our Philosophy</span>
        <h2 class="ab-h2"><span style="font-weight:400">What We </span><span style="font-weight:700">Believe</span></h2>
      </div>
      <div class="ab-beliefs">
        {beliefs.map((b) => (<div data-reveal class="ab-belief"><span class="ab-belief-n">{b.n}</span><p>{b.t}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Customer impact -->
  <section id="impact" class="ab-impact-sec">
    <div class="ab-impact">
      <div aria-hidden="true" class="ab-impact-dots"></div>
      <div aria-hidden="true" class="ab-impact-glow"></div>
      <div data-reveal class="ab-impact-left">
        <span class="ab-eyebrow"><span class="ab-sq"></span>The Results</span>
        <h2 class="ab-h2"><span style="font-weight:400">Customer </span><span style="font-weight:700">Impact</span></h2>
        <div class="ab-impact-list">{impact.map((i) => (<span class="ab-impact-item"><span class="ab-impact-check">✓</span>{i}</span>))}</div>
      </div>
      <div data-reveal class="ab-impact-right">
        <p class="ab-impact-q"><span style="font-weight:400">PriceLeap helps businesses </span><span style="font-weight:700">compete with confidence, act with speed, and scale with control.</span></p>
        <div class="ab-impact-btns"><a href="/contact" class="ab-btn-primary">Start Free Trial</a><a href="/contact" class="ab-btn-ghost">Contact us<span style="color:var(--pl-accent-ink)">→</span></a></div>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .ab-sec { border-bottom: 1px solid var(--pl-line); }
  .ab-cream { background: var(--pl-cream); }
  .ab-wrap { max-width: 1280px; margin: 0 auto; padding: clamp(72px,9vw,120px) clamp(20px,4vw,40px); }
  .ab-center { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ab-narrow { max-width: 760px; }
  .ab-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-accent-ink); }
  .ab-sq { width: 7px; height: 7px; border-radius: 2px; background: var(--pl-gradient); }
  .ab-diamond { width: 8px; height: 8px; border-radius: 2px; background: var(--pl-gradient); transform: rotate(45deg); flex: none; }
  .ab-h2 { margin: 16px 0 0; font-family: Geist, sans-serif; font-size: clamp(30px,4vw,48px); line-height: 1.06; letter-spacing: -.035em; color: var(--pl-ink); text-wrap: balance; }
  .ab-center-p { margin: 18px 0 0; max-width: 620px; font-size: 17px; line-height: 1.6; color: var(--pl-ink-2); }
  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].ab-in { opacity: 1; transform: none; }

  /* Hero */
  .ab-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
  .ab-hero-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 30%,#000 10%,transparent 72%); mask-image: radial-gradient(ellipse 70% 70% at 50% 30%,#000 10%,transparent 72%); pointer-events: none; }
  .ab-hero-glow { position: absolute; left: 50%; bottom: -300px; width: 1100px; height: 600px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(247,99,30,.15),transparent); pointer-events: none; }
  .ab-hero-inner { position: relative; max-width: 1280px; margin: 0 auto; padding: clamp(56px,8vw,104px) clamp(20px,4vw,40px) clamp(56px,6vw,88px); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ab-badge { height: 30px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-accent-ink); }
  .ab-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pl-gradient); animation: plpulse 1.8s infinite; }
  .ab-h1 { margin: 22px 0 0; font-family: Geist, sans-serif; font-size: clamp(40px,6vw,80px); line-height: 1; letter-spacing: -.05em; color: var(--pl-ink); max-width: 1000px; text-wrap: balance; }
  .ab-lead { margin: 24px 0 0; max-width: 720px; font-size: 18px; line-height: 1.6; color: var(--pl-ink-2); text-wrap: pretty; }
  .ab-pills-strip { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; border: 1px solid var(--pl-line); border-radius: 12px; background: var(--pl-surface); overflow: hidden; }
  .ab-pill-strip { height: 40px; padding: 0 16px; display: flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 12px; color: var(--pl-ink); border-right: 1px solid var(--pl-line-soft); }
  .ab-pill-strip:last-child { border-right: none; }
  .ab-pill-sq { width: 6px; height: 6px; border-radius: 2px; background: var(--pl-gradient); }
  .ab-flow { margin-top: 56px; width: 100%; max-width: 1080px; display: grid; grid-template-columns: 1fr; align-items: center; gap: 24px; text-align: left; }
  .ab-flow-card { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 18px; padding: 16px; box-shadow: 0 24px 48px -32px rgba(60,30,15,.35); display: flex; flex-direction: column; gap: 8px; }
  .ab-flow-head { display: flex; justify-content: space-between; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; color: var(--pl-faint); }
  .ab-rival { display: grid; grid-template-columns: minmax(0,1fr) auto auto; gap: 10px; align-items: center; padding: 9px 10px; border-radius: 10px; background: var(--pl-cream); border: 1px solid var(--pl-line-soft); }
  .ab-rival-n { font-size: 13px; color: var(--pl-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ab-rival-s { font-family: 'Geist Mono', monospace; font-size: 10px; }
  .ab-rival-p { font-family: 'Geist Mono', monospace; font-size: 12.5px; color: var(--pl-ink); }
  .ab-flow-dash { display: none; }
  .ab-flow-core { justify-self: center; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .ab-core-ring { position: relative; width: 96px; height: 96px; display: flex; align-items: center; justify-content: center; }
  .ab-core-orbit { position: absolute; inset: -12px; border-radius: 50%; border: 1px dashed var(--pl-accent-line); }
  .ab-core-box { position: relative; width: 96px; height: 96px; border-radius: 28px; background: var(--pl-surface); border: 1.5px solid var(--pl-accent); box-shadow: 0 0 0 8px rgba(247,99,30,.1),0 20px 40px -16px rgba(194,65,12,.5); display: flex; align-items: center; justify-content: center; }

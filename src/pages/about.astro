<script>
  // Reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('ab-in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  // Team bios
  document.querySelectorAll('[data-bio-toggle]').forEach((btn) => btn.addEventListener('click', () => {
    const body = btn.closest('.ab-member-body');
    const bio = body?.querySelector('[data-bio]');
    const open = bio?.classList.toggle('is-open');
    btn.classList.toggle('is-open', open);
    btn.childNodes[0].textContent = open ? 'Show less' : 'Read bio';
  }));
</script>

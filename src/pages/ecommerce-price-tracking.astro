          <div style="position:absolute;left:0;right:0;top:22%;display:flex;width:max-content;animation:pi-marquee 40s linear infinite">
            {tape.map((t) => (<span style="flex:none;margin-right:10px;height:34px;padding:0 14px;display:flex;align-items:center;gap:8px;border-radius:999px;border:1px solid var(--pl-line-soft);background:var(--pl-cream);font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-faint);white-space:nowrap">{t.n} <span style={`color:${t.c}`}>{t.d}</span></span>))}
          </div>
          <div style="position:absolute;left:0;right:0;bottom:22%;display:flex;width:max-content;animation:pi-marquee 52s linear infinite reverse">
            {tape.map((t) => (<span style="flex:none;margin-right:10px;height:34px;padding:0 14px;display:flex;align-items:center;gap:8px;border-radius:999px;border:1px solid var(--pl-line-soft);background:var(--pl-cream);font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-faint);white-space:nowrap">{t.n} <span style={`color:${t.c}`}>{t.d}</span></span>))}
          </div>
          <div style="position:absolute;inset:0;background:radial-gradient(ellipse 50% 60% at 50% 50%,var(--pl-surface) 40%,rgba(255,255,255,0) 80%)"></div>
        </div>
        <div aria-hidden="true" style="position:absolute;left:50%;bottom:-180px;width:680px;height:360px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.18),transparent)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;align-items:center;gap:26px">
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(32px,4.8vw,60px);line-height:1.04;letter-spacing:-.045em;color:var(--pl-ink);max-width:820px;text-wrap:balance"><span style="font-weight:400">See it run on </span><span style="font-weight:700">your own catalog and competitors.</span></h2>
          <a href="/book-a-demo" style="height:52px;padding:0 26px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:16px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Book a demo</a>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .et { background: var(--pl-surface); overflow-x: clip; }
  @keyframes pi-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.5); } 100% { box-shadow: 0 0 0 8px rgba(247,99,30,0); } }
  @keyframes pi-scan { 0% { top: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: 100%; opacity: 0; } }
  @keyframes pi-marquee { to { transform: translateX(-50%); } }
  @keyframes pi-stale { 0%,100% { background: transparent; } 50% { background: var(--pl-danger-tint); } }
  @keyframes pi-blink { 50% { opacity: 0; } }
  @keyframes pi-orbit { to { transform: rotate(360deg); } }
  @keyframes pi-spin { to { transform: rotate(360deg); } }
  @keyframes pi-ring { from { stroke-dashoffset: var(--c,552.9); } to { stroke-dashoffset: 0; } }
  @keyframes pi-dashx { to { background-position: 20px 0; } }
  @keyframes pi-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes pi-growy { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes pi-link { 0%,15% { transform: scaleX(0); } 40%,100% { transform: scaleX(1); } }
  @keyframes pi-travel { 0% { left: 28px; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { left: calc(100% - 36px); opacity: 0; } }
  @keyframes pi-wobble { 0%,100% { transform: rotate(-1.2deg); } 50% { transform: rotate(1.2deg); } }
  .et-stale { animation: pi-stale 2.4s ease infinite; }
  @media (prefers-reduced-motion: reduce) { .et *, .et *::before, .et *::after { animation: none !important; transition: none !important; } }

  .et-hero { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .et-hero { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); } }
  .et-hrow { display: grid; grid-template-columns: minmax(0,1.4fr) 76px 76px 64px; gap: 10px; }
  @media (min-width: 760px) { .et-hrow { grid-template-columns: minmax(0,1.6fr) 92px 92px 76px; } }
  .et-logo { display: grid; grid-template-columns: 1fr; }
  .et-logolabel { border-bottom: 1px solid var(--pl-line); }
  @media (min-width: 760px) { .et-logo { grid-template-columns: 260px minmax(0,1fr); } .et-logolabel { border-right: 1px solid var(--pl-line); border-bottom: none; } }
  .et-split { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .et-split { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }
  .et-sticky { position: relative; }
  @media (min-width: 1000px) { .et-sticky { position: sticky; } }
  .et-sol { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .et-sol { grid-template-columns: 300px minmax(0,1fr); } }
  .et-ba { display: grid; grid-template-columns: 1fr; }
  .et-ba-mid { display: none; }
  @media (min-width: 1000px) { .et-ba { grid-template-columns: minmax(0,1fr) 72px minmax(0,1fr); } .et-ba-mid { display: flex; } }
  .et-why { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 760px) { .et-why { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1000px) { .et-why { grid-template-columns: repeat(4,minmax(0,1fr)); } }
  .et-feat { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .et-feat { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  .et-proof { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .et-proof { grid-template-columns: 280px minmax(0,1fr) minmax(0,1.4fr); } }

  .et-barow.is-on { background: var(--pl-cream) !important; }
  .et-barow .et-ba-a { background: rgba(232,252,239,.35); }
  .et-barow.is-on .et-ba-a { background: var(--pl-accent-tint); }
  .et-barow .et-ba-b { text-decoration: none; }
  .et-barow.is-on .et-ba-b { text-decoration: line-through; }
  .et-barow .et-ba-line { background: repeating-linear-gradient(90deg,var(--pl-line) 0 6px,transparent 6px 12px); }
  .et-barow.is-on .et-ba-line { background: repeating-linear-gradient(90deg,var(--pl-accent) 0 6px,transparent 6px 12px); }
  .et-barow .et-ba-dot { background: var(--pl-surface); border: 1px solid var(--pl-line); }
  .et-barow.is-on .et-ba-dot { background: var(--pl-accent); border-color: var(--pl-accent); }

  .et-faq.is-open { border-color: var(--pl-accent-line); box-shadow: 0 18px 36px -28px rgba(194,65,12,.5); }
  .et-faq.is-open .et-faq-plus { background: var(--pl-accent); transform: rotate(45deg); }
  .et-faq.is-open .et-faq-n { color: var(--pl-accent-ink); }
  .et-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .et-faq.is-open .et-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.et');
  if (root) {
    const q = (s: string) => root.querySelector(s) as HTMLElement | null;
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];

    // ---- 1800ms loop: hero live row + sites lit + alerts hot + schedule donuts ----
    const rows = qa('[data-et-row]');
    const sites = qa('[data-et-site]');
    const alerts = qa('[data-et-alert]');
    const schedRings = qa('.et-sched-ring');
    let tick = 0;
    const sched = [0.2, 0.55, 0.35, 0.8];
    const inc = [0.08, 0.03, 0.05, 0.015];

    const paintHero = () => {
      const live = tick % 4;
      rows.forEach((r, i) => {
        r.style.background = i === live ? 'rgba(232,252,239,.45)' : 'transparent';
        const comp = r.querySelector('.et-comp') as HTMLElement;
        if (comp) { if (i === live) { comp.style.animation = 'none'; void comp.offsetWidth; comp.style.animation = 'pi-flash 1.4s ease'; } }
      });
    };
    const paintSites = () => {
      const lit = tick % 9;
      sites.forEach((el, i) => {
        const raw = el.getAttribute('data-raw') || ''; const lock = raw.includes('🔒'); const on = i <= lit;
        el.textContent = lock ? (on ? '✓ ' + raw.replace('🔒 ', '') : raw.replace('🔒', '◆')) : raw;
        el.style.background = on ? 'var(--pl-accent-tint)' : 'var(--pl-surface)';
        el.style.borderColor = on ? 'var(--pl-accent-line)' : lock ? 'var(--pl-danger-line)' : 'var(--pl-line)';
        el.style.color = on ? 'var(--pl-accent-ink)' : lock ? 'var(--pl-danger-ink)' : 'var(--pl-muted)';
      });
    };
    const paintAlerts = () => {
      const hot = tick % 3;
      alerts.forEach((el, i) => {
        const down = el.getAttribute('data-down') === '1';
        el.style.borderColor = i === hot ? (down ? 'var(--pl-danger-line)' : 'var(--pl-accent-line)') : 'var(--pl-line-soft)';
        el.style.background = i === hot ? (down ? '#FFF7F6' : 'var(--pl-cream)') : 'var(--pl-cream)';
      });
    };
    const paintSched = () => {
      schedRings.forEach((ring, i) => {
        const p = sched[i]; const hot = p > 0.85;
        ring.style.strokeDashoffset = (69.1 * (1 - p)).toFixed(1);
        const btn = qa('[data-et-sched]')[i];
        if (btn) { btn.style.borderColor = hot ? 'var(--pl-accent-line)' : 'var(--pl-line-soft)'; btn.style.background = hot ? 'var(--pl-accent-tint)' : 'var(--pl-cream)'; }
      });
    };

    paintHero(); paintSites(); paintAlerts(); paintSched();
    setInterval(() => {
      tick++;
      sched.forEach((v, i) => { const n = v + inc[i]; sched[i] = n > 1 ? 0 : n; });
      paintHero(); paintSites(); paintAlerts(); paintSched();
    }, 1800);

    // schedule click -> fill that ring
    qa('[data-et-sched]').forEach((btn, i) => btn.addEventListener('click', () => { sched[i] = 0.98; paintSched(); }));

    // ---- before/after hover ----
    qa('[data-et-ba]').forEach((row) => row.addEventListener('mouseenter', () => {
      qa('[data-et-ba]').forEach((r) => r.classList.remove('is-on'));
      row.classList.add('is-on');
    }));

    // ---- scope heatmap ----
    const skuHead = ['1K', '5K', '10K', '25K', '50K', '100K', '250K', '1M'];
    const siteRows = ['5 sites', '10 sites', '20 sites', '40 sites', '80 sites'];
    const scopeLabel = q('[data-et-scopelabel]');
    const paintScope = (hx: number, hy: number) => {
      qa('.et-scope').forEach((cell) => {
        const x = Number(cell.getAttribute('data-x')), y = Number(cell.getAttribute('data-y'));
        const on = x <= hx && y <= hy, tip = x === hx && y === hy;
        cell.style.background = on ? (tip ? 'var(--pl-accent)' : 'var(--pl-accent-line-2)') : 'var(--pl-sand)';
        cell.style.border = on ? '1px solid transparent' : '1px solid var(--pl-line-soft)';
      });
      if (scopeLabel) scopeLabel.textContent = siteRows[hy] + ' × ' + skuHead[hx] + ' SKUs';
    };
    qa('.et-scope').forEach((cell) => cell.addEventListener('mouseenter', () => paintScope(Number(cell.getAttribute('data-x')), Number(cell.getAttribute('data-y')))));
    paintScope(5, 3);

    // ---- faq ----
    qa('[data-et-faq-btn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-et-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-et-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-et-faq-btn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    // ---- reveal ----
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

          <div style="background:var(--pl-surface);padding:18px 26px;display:flex;align-items:center;justify-content:center"><span style="height:48px;padding:0 22px;display:flex;align-items:center;border-radius:10px;border:1px dashed var(--pl-line-xstrong);background:repeating-linear-gradient(135deg,var(--pl-sand) 0 6px,var(--pl-cream) 6px 12px);font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;color:var(--pl-muted)">LOGO</span></div>

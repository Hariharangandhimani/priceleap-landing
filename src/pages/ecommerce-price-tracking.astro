---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';
import Faq from '../components/pl/Faq.astro';

const pos: Record<string, [string, string, string]> = {
  Above: ['#FFF7F6', 'var(--pl-danger-line)', 'var(--pl-danger-ink)'],
  Below: ['var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)'],
  Match: ['var(--pl-sand)', 'var(--pl-line)', 'var(--pl-muted)'],
};
const heroRows = [
  { n: 'Aurora 55" 4K TV', vs: 'vs MarketOne', you: '$619.00', comp: '$598.00', d: '▼ 3.4%', pos: 'Above', live: true },
  { n: 'NovaBook Air 14', vs: 'vs ShopRanked', you: '$1,049.00', comp: '$1,089.00', d: '▲ 3.8%', pos: 'Below', live: false },
  { n: 'PureSound Buds Pro', vs: 'vs Marketplace', you: '$129.00', comp: '$129.00', d: '— 0%', pos: 'Match', live: false },
  { n: 'Kettle K2 Stainless', vs: 'vs MarketOne', you: '$74.50', comp: '$66.90', d: '▼ 10.2%', pos: 'Above', live: false },
].map((r) => ({ ...r, dc: r.d.startsWith('▼') ? 'var(--pl-danger-ink)' : r.d.startsWith('▲') ? 'var(--pl-accent-ink)' : 'var(--pl-faint)' }));

const tapeData = [['Aurora 55" 4K TV', '▼ 3.4%', 'var(--pl-danger-ink)'], ['NovaBook Air 14', '▲ 3.8%', 'var(--pl-accent-ink)'], ['Kettle K2 Stainless', '▼ 10.2%', 'var(--pl-danger-ink)'], ['PureSound Buds Pro', '— 0%', 'var(--pl-faint)'], ['12 SKUs changed', '3 competitors', 'var(--pl-accent-ink)'], ['MarketOne · SKU 88213', 'checked 06:00', 'var(--pl-muted)']];
const tape = [...tapeData, ...tapeData].map(([n, d, c]) => ({ n, d, c }));
const logoNames = ['McAfee', 'Xometry', 'Do it Best', 'Wolt', 'neho', 'apoBank'];
const logos = [...logoNames, ...logoNames];

const sheetRows = [['TV-55-AUR', '$612', '?', '11 days ago'], ['NB-AIR-14', '$1,099', '$1,080', '6 days ago'], ['BUDS-PRO', '#N/A', '$132', '14 days ago'], ['KET-K2-SS', '$71', '?', '9 days ago']];
const solStats = [
  { k: 'SKUs monitored', v: '12,480', c: 'var(--pl-ink)', dot: 'var(--pl-ink)' },
  { k: 'Sources tracked', v: '38', c: 'var(--pl-ink)', dot: 'var(--pl-ink)' },
  { k: 'Priced below market', v: '61%', c: 'var(--pl-accent-ink)', dot: 'var(--pl-accent)' },
  { k: 'Priced above market', v: '22%', c: 'var(--pl-danger-ink)', dot: 'var(--pl-danger)' },
  { k: 'Match confidence', v: '98.4%', c: 'var(--pl-ink)', dot: 'var(--pl-line-xstrong)' },
  { k: 'Last full sync', v: '06:00 & 18:00', c: 'var(--pl-ink)', dot: 'var(--pl-line-xstrong)' },
].map((m) => ({ ...m, fs: m.v.length > 8 ? '22px' : '28px' }));

const baRows = [
  ['Analysts check competitor sites by hand and paste prices into spreadsheets.', 'Competitor and marketplace prices are collected automatically.'],
  ['Data is days old by the time anyone reviews it.', 'Data refreshes on the schedule you set.'],
  ['Product matches are guessed by title, so variants and pack sizes get mixed up.', 'Each price is matched to the right product in your catalog, down to the variant.'],
  ['Coverage stops at a few hundred SKUs and a handful of competitors.', 'Your full catalog and competitive set are covered in one view.'],
  ['Price moves are spotted late, after margin or sales are already lost.', 'Alerts flag meaningful price changes so your team can act on them quickly.'],
];
const schedules = [['Electronics · high-velocity', 'Every 4 hours'], ['Home & kitchen', 'Daily'], ['Seasonal · clearance', '2× / day'], ['Long-tail catalog', 'Weekly']];
const matches = [['Aurora 55" 4K TV', 'MarketOne SKU 88213'], ['NovaBook Air 14', 'no UPC · matched on specs'], ['PureSound Buds Pro', '3 variants linked']];
const alerts = [
  { t: "MarketOne dropped Kettle K2 to $66.90 · you're now 10.2% above.", time: '2 min ago', mk: '▼', ib: 'var(--pl-danger-tint)', ic: 'var(--pl-danger-ink)', bc: 'var(--pl-danger-line)' },
  { t: "ShopRanked raised NovaBook Air to $1,089 · you're now cheapest.", time: '1 hr ago', mk: '▲', ib: 'var(--pl-accent-tint)', ic: 'var(--pl-accent-ink)', bc: 'var(--pl-line-soft)' },
  { t: '12 SKUs changed across 3 competitors.', time: 'Today', mk: '≡', ib: 'var(--pl-sand)', ic: 'var(--pl-ink-2)', bc: 'var(--pl-line-soft)' },
];
const scaleBars = [14, 22, 30, 40, 52, 64, 80, 100].map((h, i, a) => ({ h, c: i === a.length - 1 ? 'var(--pl-accent)' : i > 4 ? 'var(--pl-accent-line-2)' : 'var(--pl-line-alt)' }));

const skuHead = ['1K', '5K', '10K', '25K', '50K', '100K', '250K', '1M'];
const scopeRows = ['5 sites', '10 sites', '20 sites', '40 sites', '80 sites'].map((label, y) => ({
  label,
  cells: skuHead.map((_, x) => {
    const on = x <= 3 && y <= 2;
    const hot = x === 3 && y === 2;
    return { bg: on ? (hot ? 'var(--pl-accent)' : 'var(--pl-accent-line-2)') : 'var(--pl-sand)', bd: on ? '1px solid transparent' : '1px solid var(--pl-line-soft)' };
  }),
}));
const faqs = [
  { q: 'Which websites and marketplaces can you track?', a: "Competitor sites, marketplaces, and sites that are hard for most tools to reach. If it's on the web, we can usually track it." },
  { q: 'How accurate is the matching?', a: 'We match on more than barcodes, so products without a UPC or EAN still get matched to the right competitor item.' },
  { q: 'How often is the data refreshed?', a: 'You set the cadence per product group, from daily down to multiple times a day where it matters.' },
  { q: 'Can it handle our full catalog?', a: 'Yes. The platform is built for large SKU counts and many competitors at once.' },
  { q: 'How do we get the data into our systems?', a: 'Through the dashboard, scheduled exports, or our API.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Ecommerce Price Tracking', provider: { '@type': 'Organization', name: 'PriceLeap' }, url: 'https://priceleap.ai/ecommerce-price-tracking' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PriceLeapLayout title="Ecommerce Price Tracking · PriceLeap" description="Track competitor and marketplace prices across your entire catalog, kept accurate and current without manual checks." jsonLd={jsonLd}>
  <!-- Hero -->
  <section id="top" class="mk-hero">
    <div aria-hidden="true" class="mk-hero-lines"></div>
    <div aria-hidden="true" class="mk-hero-glow"></div>
    <div class="mk-hero-inner">
      <div style="min-width:0">
        <span class="mk-kicker"><span class="mk-kicker-tag">Solution</span><span style="color:var(--pl-accent-ink)">Ecommerce price tracking</span></span>
        <h1 class="mk-h1"><span style="font-weight:700">Ecommerce price tracking,</span><span style="font-weight:400"> built for retail teams, </span><span class="mk-strike">not spreadsheets.</span></h1>
        <p class="mk-sub">Track competitor and marketplace prices across your entire catalog, kept accurate and current without manual checks.</p>
        <div class="mk-hero-cta">
          <a href="#demo" class="mk-btn-primary">Book a demo</a>
          <a href="#pricing" class="mk-btn-text">Talk to us about custom coverage<span style="color:var(--pl-accent-ink)">→</span></a>
        </div>
      </div>
      <div style="position:relative;min-width:0">
        <div class="mk-panel">
          <div class="mk-panel-head"><span class="mk-panel-title">CATALOG · COMPETITOR PRICES</span><span class="mk-live"><span class="mk-live-dot"></span>TRACKING</span></div>
          <div class="mk-table-head"><span>PRODUCT</span><span style="text-align:right">YOUR PRICE</span><span style="text-align:right">COMPETITOR</span><span style="text-align:right">POSITION</span></div>
          {heroRows.map((r) => (
            <div class="mk-row" style={r.live ? 'background:rgba(232,252,239,.45)' : ''}>
              <span style="min-width:0"><span class="mk-row-n">{r.n}</span><span class="mk-row-vs">{r.vs}</span></span>
              <span class="mk-row-you">{r.you}</span>
              <span style="text-align:right"><span class="mk-row-comp">{r.comp}</span><span class="mk-row-d" style={`color:${r.dc}`}>{r.d}</span></span>
              <span class="mk-pos" style={`background:${pos[r.pos][0]};border-color:${pos[r.pos][1]};color:${pos[r.pos][2]}`}>{r.pos}</span>
            </div>
          ))}
          <div class="mk-tape-wrap"><div class="mk-tape">{tape.map((t) => (<span class="mk-tape-item"><span style="color:var(--pl-ink)">{t.n}</span><span style={`color:${t.c}`}>{t.d}</span></span>))}</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="mk-logos">
    <div class="mk-logos-wrap">
      <div class="mk-logos-label">Trusted by teams at</div>
      <div class="mk-logos-marq-wrap"><div class="mk-logos-marq">{logos.map((l) => (<div class="mk-logo">{l}</div>))}</div></div>
    </div>
  </section>

  <!-- Problem -->
  <section id="problem" class="mk-sec mk-cream">
    <div class="mk-split">
      <div data-reveal>
        <span class="mk-eyebrow mk-eyebrow--danger"><span class="mk-sq mk-sq--danger"></span>The problem</span>
        <h2 class="mk-h2"><span style="font-weight:400">Prices shift every day across hundreds of competitors and marketplaces. </span><span style="font-weight:700">Past a few hundred SKUs, manual tracking stops working.</span></h2>
        <div class="mk-problist">
          {['Spreadsheets and one-off checks fall behind the moment your catalog grows.', 'Bad matches and stale prices quietly cost you margin on some products and sales on others.', 'Built for retailers and brands tracking thousands of SKUs, not shoppers tracking one.'].map((t, i) => (
            <div class="mk-prob"><span class="mk-prob-n">{String(i + 1).padStart(2, '0')}</span><span>{t}</span></div>
          ))}
        </div>
      </div>
      <div data-reveal class="mk-sheet-wrap">
        <div class="mk-sheet">
          <div class="mk-sheet-head"><span class="mk-sheet-x">X</span><span class="mk-sheet-file">competitor_prices_FINAL_v7.xlsx</span><span class="mk-sheet-note">the "before" state</span></div>
          <div class="mk-sheet-grid">
            <span class="mk-sheet-th">SKU</span><span class="mk-sheet-th">Comp A</span><span class="mk-sheet-th">Comp B</span><span class="mk-sheet-th">Updated</span>
            {sheetRows.map((r) => r.map((v, ci) => {
              const bad = v === '?' || v === '#N/A';
              return <span class="mk-sheet-td" style={`color:${bad ? 'var(--pl-danger-ink)' : ci === 3 ? 'var(--pl-warn-ink)' : 'var(--pl-ink)'}`}>{v}</span>;
            }))}
            <span class="mk-sheet-more">...+3,400 rows</span><span class="mk-sheet-td" style="color:var(--pl-danger-ink)">unknown</span>
          </div>
        </div>
        <span class="mk-sheet-badge mk-sheet-badge--stale"><span class="mk-blink"></span>11 DAYS STALE</span>
        <span class="mk-sheet-badge mk-sheet-badge--na">#N/A · match guessed by title</span>
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section id="solution" class="mk-sec mk-sol">
    <div aria-hidden="true" class="mk-sol-ring1"></div>
    <div aria-hidden="true" class="mk-sol-ring2"></div>
    <div class="mk-wrap" style="position:relative">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>The solution · Ecommerce price monitoring tools</span>
        <h2 class="mk-h2" style="max-width:820px"><span style="font-weight:700">One reliable view</span><span style="font-weight:400"> of where your prices sit against the market.</span></h2>
        <p class="mk-center-p">PriceLeap watches the prices you care about, matches them to the right products in your catalog, and keeps that data fresh enough to act on.</p>
        <p class="mk-center-p mk-muted">You get one reliable view of where your prices sit against the market, updated on a schedule you set.</p>
      </div>
      <div data-reveal class="mk-sol-card">
        <div class="mk-sol-card-head"><span>Market position · today</span><span class="mk-sol-chip"><span class="mk-sol-spin"></span>Refreshed 2×/day</span></div>
        <div class="mk-sol-body">
          <div class="mk-sol-donut">
            <div class="mk-donut">
              <svg viewBox="0 0 220 220" style="width:100%;height:100%;transform:rotate(-90deg)">
                <circle cx="110" cy="110" r="88" fill="none" stroke="#F5ECE5" stroke-width="18"></circle>
                <circle cx="110" cy="110" r="88" fill="none" stroke="#F7631E" stroke-width="18" stroke-dasharray="337.3 552.9"></circle>
                <circle cx="110" cy="110" r="88" fill="none" stroke="#E5483F" stroke-width="18" stroke-dasharray="121.6 552.9" stroke-dashoffset="-341.3" opacity=".85"></circle>
                <circle cx="110" cy="110" r="88" fill="none" stroke="#D7C6BA" stroke-width="18" stroke-dasharray="86 552.9" stroke-dashoffset="-466.9"></circle>
              </svg>
              <div class="mk-donut-c"><span class="mk-donut-v">61%</span><span class="mk-donut-l">BELOW MARKET</span></div>
            </div>
          </div>
          <div class="mk-sol-stats">
            {solStats.map((m) => (
              <div class="mk-sol-stat"><span class="mk-sol-stat-k"><span class="mk-sol-stat-dot" style={`background:${m.dot}`}></span>{m.k}</span><span class="mk-sol-stat-v" style={`font-size:${m.fs};color:${m.c}`}>{m.v}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Before / After -->
  <section id="compare" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="mk-ba-head">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Before and after</span>
        <h2 class="mk-h2"><span style="font-weight:400">What changes when </span><span style="font-weight:700">PriceLeap runs your price tracking.</span></h2>
      </div>
      <div data-reveal class="mk-ba">
        <div class="mk-ba-labels">
          <div class="mk-ba-l mk-ba-l--before"><span class="mk-ba-tag mk-ba-tag--before">BEFORE</span><span>Manual tracking</span></div>
          <div class="mk-ba-mid"></div>
          <div class="mk-ba-l mk-ba-l--after"><span class="mk-ba-tag mk-ba-tag--after">AFTER</span><span>With PriceLeap</span></div>
        </div>
        {baRows.map(([b, a]) => (
          <div class="mk-ba-row">
            <div class="mk-ba-cell"><span class="mk-ba-x">✕</span><span class="mk-ba-btxt">{b}</span></div>
            <div class="mk-ba-arrow"><span class="mk-ba-line"></span><span class="mk-ba-dot">→</span></div>
            <div class="mk-ba-cell mk-ba-cell--after"><span class="mk-ba-check">✓</span><span>{a}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why -->
  <section id="why" class="mk-sec">
    <div class="mk-wrap">
      <div data-reveal style="max-width:780px">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Why PriceLeap</span>
        <h2 class="mk-h2"><span style="font-weight:400">What makes the tracking </span><span style="font-weight:700">dependable at scale.</span></h2>
      </div>
      <div data-reveal class="mk-why">
        {[
          { n: '01', t: 'Matching you can trust', d: 'We match competitor products to yours accurately, including items without a UPC or EAN, so you compare the right product and not a lookalike.' },
          { n: '02', t: 'Any website, any marketplace', d: 'Track competitors, marketplaces, and sites that block most tools, across your full catalog.' },
          { n: '03', t: 'Tracking that goes somewhere', d: 'Prices don’t just sit in a report. They feed your repricing and pricing decisions.' },
          { n: '04', t: 'Made for scale', d: 'Large catalogs, many sources, dependable data your pricing team can rely on.' },
        ].map((c, idx) => (
          <div class="mk-why-card">
            <div class="mk-why-viz">
              {idx === 3 ? (
                <div class="mk-why-bars">{scaleBars.map((b) => (<span style={`height:${b.h}%;background:${b.c}`}></span>))}</div>
              ) : (
                <span class="mk-why-ico"><span class="mk-why-ico-dot"></span></span>
              )}
            </div>
            <div class="mk-why-body"><span class="mk-why-n">{c.n}</span><h3>{c.t}</h3><p>{c.d}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core features -->
  <section id="features" class="mk-sec mk-cream">
    <div class="mk-wrap">
      <div data-reveal class="mk-center">
        <span class="mk-eyebrow"><span class="mk-sq"></span>Core features</span>
        <h2 class="mk-h2"><span style="font-weight:400">What you get </span><span style="font-weight:700">inside the platform.</span></h2>
      </div>
      <div data-reveal class="mk-feat">
        <div class="mk-feat-card">
          <div class="mk-feat-top"><h3>Real-time and scheduled monitoring</h3><p>Choose how often each group of products refreshes.</p></div>
          <div class="mk-feat-body">
            {schedules.map(([n, f], i) => (
              <div class={`mk-sched${i === 0 ? ' is-on' : ''}`}><span class="mk-sched-ring"></span><span class="mk-sched-n">{n}</span><span class="mk-sched-f">{f}</span></div>
            ))}
          </div>
        </div>
        <div class="mk-feat-card">
          <div class="mk-feat-top mk-feat-top--row"><div><h3>Product matching</h3><p>AI matching across sites, sellers, and variants.</p></div><a href="#" class="mk-feat-link">See product matching →</a></div>
          <div class="mk-feat-body">
            {matches.map(([n, d]) => (<div class="mk-match"><span class="mk-match-check">✓</span><span style="min-width:0"><span class="mk-match-n">{n}</span><span class="mk-match-d">→ {d}</span></span></div>))}
            <div class="mk-match-flag"><span class="mk-blink mk-blink--warn"></span>… 4 candidates flagged for review</div>
          </div>
        </div>
        <div class="mk-feat-card">
          <div class="mk-feat-top mk-feat-top--row"><div><h3>Price change alerts</h3><p>Know the moment a competitor moves, before you lose the sale.</p></div><a href="#" class="mk-feat-link">See price alerts →</a></div>
          <div class="mk-feat-body">
            {alerts.map((a) => (
              <div class="mk-alert" style={`border-color:${a.bc}`}><span class="mk-alert-ico" style={`background:${a.ib};color:${a.ic}`}>{a.mk}</span><span class="mk-alert-t">{a.t}</span><span class="mk-alert-time">{a.time}</span></div>
            ))}
          </div>
        </div>
        <div class="mk-feat-card">
          <div class="mk-feat-top mk-feat-top--row"><div style="max-width:420px"><h3>Coverage and export</h3><p>Any site or marketplace in, your data out through the dashboard, export, or API. A price tracker for any website you compete on.</p></div><a href="#" class="mk-feat-link">See competitive data →</a></div>
          <div class="mk-code">
            <div style="white-space:nowrap"><span style="color:var(--pl-accent)">GET</span> <span style="color:var(--pl-surface)">/v1/products/88213/prices</span></div>
            <div>{'{'}</div>
            <div style="padding-left:16px">"sku": <span style="color:var(--pl-accent-line-2)">"TV-55-AUR"</span>,</div>
            <div style="padding-left:16px">"competitor": <span style="color:var(--pl-accent-line-2)">"MarketOne"</span>,</div>
            <div style="padding-left:16px">"price": <span style="color:var(--pl-surface)">598.00</span>,</div>
            <div style="padding-left:16px">"checked_at": <span style="color:var(--pl-accent-line-2)">"2026-06-18T06:00Z"</span></div>
            <div>{'}'}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="mk-sec mk-cream">
    <div class="mk-split mk-split--center">
      <div data-reveal>
        <span class="mk-eyebrow"><span class="mk-sq"></span>Pricing</span>
        <h2 class="mk-h2" style="font-size:clamp(34px,4.6vw,56px)"><span style="font-weight:400">Scoped to </span><span style="font-weight:700">your catalog.</span></h2>
        <p class="mk-price-p">Pricing scales with the number of sites and SKUs you track.</p>
        <p class="mk-price-p mk-muted">Tell us your catalog and competitive set, and we'll scope it to fit.</p>
        <div class="mk-hero-cta">
          <a href="#demo" class="mk-btn-primary">Book a demo</a>
          <a href="/contact" class="mk-btn-ghost">Contact us for custom requirements</a>
        </div>
      </div>
      <div data-reveal class="mk-scope">
        <div class="mk-scope-head"><span>SITES × SKUS</span><span style="color:var(--pl-accent-ink)">20 sites × 25K SKUs</span></div>
        <div class="mk-scope-grid">
          <span></span>
          {skuHead.map((h) => (<span class="mk-scope-h">{h}</span>))}
          {scopeRows.map((row) => (
            <Fragment>
              <span class="mk-scope-row">{row.label}</span>
              {row.cells.map((c) => (<span class="mk-scope-cell" style={`background:${c.bg};border:${c.bd}`}></span>))}
            </Fragment>
          ))}
        </div>
        <div class="mk-scope-note">Every cell is priced the same way: sites × SKUs.</div>
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Questions " titleBold="buyers ask us." />

  <!-- CTA -->
  <section id="demo" class="mk-cta-sec">
    <div class="mk-cta">
      <div aria-hidden="true" class="mk-cta-tape"><div class="mk-cta-tape-row">{tape.map((t) => (<span class="mk-cta-pill">{t.n} <span style={`color:${t.c}`}>{t.d}</span></span>))}</div></div>
      <div aria-hidden="true" class="mk-cta-glow"></div>
      <div data-reveal class="mk-cta-inner">
        <h2 class="mk-cta-h2"><span style="font-weight:400">See it run on </span><span style="font-weight:700">your own catalog and competitors.</span></h2>
        <a href="/contact" class="mk-btn-primary mk-btn-lg">Book a demo</a>
      </div>
    </div>
  </section>
</PriceLeapLayout>


<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('mk-in'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
</script>

---
// Native Astro port of the design package's Ecommerce Price Tracking page.
// Static initial render + the full 1800ms animation loop and interactions
// reimplemented in vanilla JS: hero live-highlight row + price flash, ticker tape,
// before/after hover comparison, four auto-advancing schedule donuts (clickable),
// coverage-sites lit progression, alerts hot-cycle, SKU×sites scope heatmap (hover),
// and FAQ. Uses design tokens. Responsive via CSS media queries.
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const POS: Record<string, [string, string, string]> = {
  Above: ['var(--pl-danger-tint)', 'var(--pl-danger-line)', 'var(--pl-danger-ink)'],
  Below: ['var(--pl-accent-tint)', 'var(--pl-accent-line)', 'var(--pl-accent-ink)'],
  Match: ['var(--pl-sand)', 'var(--pl-line)', 'var(--pl-ink-2)'],
};
const base = [
  { n: 'Aurora 55" 4K TV', vs: 'vs MarketOne', you: '$619.00', comp: '$598.00', d: '▼ 3.4%', pos: 'Above' },
  { n: 'NovaBook Air 14', vs: 'vs ShopRanked', you: '$1,049.00', comp: '$1,089.00', d: '▲ 3.8%', pos: 'Below' },
  { n: 'PureSound Buds Pro', vs: 'vs Marketplace', you: '$129.00', comp: '$129.00', d: '— 0%', pos: 'Match' },
  { n: 'Kettle K2 Stainless', vs: 'vs MarketOne', you: '$74.50', comp: '$66.90', d: '▼ 10.2%', pos: 'Above' },
];
const heroRows = base.map((r) => { const p = POS[r.pos]; return { ...r, pbg: p[0], pbc: p[1], pc: p[2], dc: r.d.startsWith('▼') ? 'var(--pl-danger-ink)' : r.d.startsWith('▲') ? 'var(--pl-accent-ink)' : 'var(--pl-faint)' }; });
const tapeData = [['Aurora 55" 4K TV', '▼ 3.4%', 'var(--pl-danger-ink)'], ['NovaBook Air 14', '▲ 3.8%', 'var(--pl-accent-ink)'], ['Kettle K2 Stainless', '▼ 10.2%', 'var(--pl-danger-ink)'], ['PureSound Buds Pro', '— 0%', 'var(--pl-faint)'], ['12 SKUs changed', '3 competitors', 'var(--pl-accent-ink)'], ['MarketOne · SKU 88213', 'checked 06:00', 'var(--pl-muted)']];
const tape = [...tapeData, ...tapeData].map(([n, d, c]) => ({ n, d, c }));
const brandLogos = ['amazon', 'shopify', 'walmart', 'ebay', 'target', 'flipkart', 'etsy', 'magento', 'woocommerce', 'bigcommerce', 'salesforce', 'sap'];
const logoLoop = [...brandLogos, ...brandLogos];
const rowsS = [['TV-55-AUR', '$612', '?', '11 days ago'], ['NB-AIR-14', '$1,099', '$1,080', '6 days ago'], ['BUDS-PRO', '#N/A', '$132', '14 days ago'], ['KET-K2-SS', '$71', '?', '9 days ago']];
const sheet: { v: string; br: string; col: string; bad: boolean; dl: string }[] = [];
rowsS.forEach((r, ri) => r.forEach((v, ci) => {
  const bad = v === '?' || v === '#N/A';
  sheet.push({ v, br: ci < 3 ? '1px solid var(--pl-line-soft)' : 'none', col: bad ? 'var(--pl-danger-ink)' : ci === 3 ? 'var(--pl-warn-ink)' : 'var(--pl-ink)', bad, dl: (ri * 0.3).toFixed(1) });
}));
const solStats = [
  { k: 'SKUs monitored', v: '12,480', c: 'var(--pl-ink)', dot: 'var(--pl-ink)' },
  { k: 'Sources tracked', v: '38', c: 'var(--pl-ink)', dot: 'var(--pl-ink)' },
  { k: 'Priced below market', v: '61%', c: 'var(--pl-accent-ink)', dot: 'var(--pl-accent)' },
  { k: 'Priced above market', v: '22%', c: 'var(--pl-danger-ink)', dot: 'var(--pl-danger)' },
  { k: 'Match confidence', v: '98.4%', c: 'var(--pl-ink)', dot: 'var(--pl-line-xstrong)' },
  { k: 'Last full sync', v: '06:00 & 18:00', c: 'var(--pl-ink)', dot: 'var(--pl-line-xstrong)' },
].map((m) => ({ ...m, fs: m.v.length > 8 ? '22px' : '28px' }));
const baRows = [
  ['Analysts check competitor sites by hand and paste prices into spreadsheets.', 'Competitor and marketplace prices are collected automatically.'],
  ['Data is days old by the time anyone reviews it.', 'Data refreshes on the schedule you set.'],
  ['Product matches are guessed by title, so variants and pack sizes get mixed up.', 'Each price is matched to the right product in your catalog, down to the variant.'],
  ['Coverage stops at a few hundred SKUs and a handful of competitors.', 'Your full catalog and competitive set are covered in one view.'],
  ['Price moves are spotted late, after margin or sales are already lost.', 'Alerts flag meaningful price changes so your team can act on them quickly.'],
].map(([b, a]) => ({ b, a }));
const siteNames = ['MarketOne', 'ShopRanked', 'Marketplace', '🔒 Protected', 'Regional', 'Long-tail', 'D2C', '🔒 JS-heavy', 'Reseller'];
const scaleBars = [14, 22, 30, 40, 52, 64, 80, 100].map((h, i, a) => ({ h, c: i === a.length - 1 ? 'var(--pl-accent)' : i > 4 ? 'var(--pl-accent-line-2)' : 'var(--pl-line-alt)', dl: (i * 0.06).toFixed(2) }));
const groups = [['Electronics · high-velocity', 'Every 4 hours'], ['Home & kitchen', 'Daily'], ['Seasonal · clearance', '2× / day'], ['Long-tail catalog', 'Weekly']].map(([n, f], i) => ({ n, f, tbg: i === 0 ? 'var(--pl-accent)' : 'var(--pl-sand)', tc: i === 0 ? 'var(--pl-ink)' : 'var(--pl-ink-2)' }));
const schedInit = [0.2, 0.55, 0.35, 0.8];
const matches = [['Aurora 55" 4K TV', 'MarketOne SKU 88213'], ['NovaBook Air 14', 'no UPC · matched on specs'], ['PureSound Buds Pro', '3 variants linked']].map(([n, d], i) => ({ n, d, dl: (i * 0.12).toFixed(2) }));
const alertData = [
  { t: "MarketOne dropped Kettle K2 to $66.90 · you're now 10.2% above.", time: '2 min ago', mk: '▼', down: true, neutral: false },
  { t: "ShopRanked raised NovaBook Air to $1,089 · you're now cheapest.", time: '1 hr ago', mk: '▲', down: false, neutral: false },
  { t: '12 SKUs changed across 3 competitors.', time: 'Today', mk: '≡', down: false, neutral: true },
];
const alerts = alertData.map((a) => ({ ...a, ib: a.down ? 'var(--pl-danger-tint)' : a.neutral ? 'var(--pl-sand)' : 'var(--pl-accent-tint)', ic: a.down ? 'var(--pl-danger-ink)' : a.neutral ? 'var(--pl-ink-2)' : 'var(--pl-accent-ink)' }));
const skuHead = ['1K', '5K', '10K', '25K', '50K', '100K', '250K', '1M'];
const siteRows = ['5 sites', '10 sites', '20 sites', '40 sites', '80 sites'];
const faqData = [
  ['Which websites and marketplaces can you track?', "Competitor sites, marketplaces, and sites that are hard for most tools to reach. If it's on the web, we can usually track it."],
  ['How accurate is the matching?', 'We match on more than barcodes, so products without a UPC or EAN still get matched to the right competitor item.'],
  ['How often is the data refreshed?', 'You set the cadence per product group, from daily down to multiple times a day where it matters.'],
  ['Can it handle our full catalog?', 'Yes. The platform is built for large SKU counts and many competitors at once.'],
  ['How do we get the data into our systems?', 'Through the dashboard, scheduled exports, or our API.'],
].map(([q, a], i) => ({ q, a, n: '0' + (i + 1) }));
---
<PriceLeapLayout
  title="Ecommerce Price Tracking · PriceLeap"
  description="Track competitor and marketplace prices across your entire catalog, matched to the right products and kept current without manual checks. Built for retail and brand teams."
>
  <div class="et">
    <!-- HERO -->
    <section id="top" style="position:relative;border-bottom:1px solid var(--pl-line);overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px);background-size:80px 100%;-webkit-mask-image:linear-gradient(180deg,#000,transparent 90%);mask-image:linear-gradient(180deg,#000,transparent 90%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-6%;top:10%;width:720px;height:620px;background:radial-gradient(closest-side,rgba(247,99,30,.13),transparent);pointer-events:none"></div>
      <div class="et-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,40px) clamp(40px,5vw,64px);gap:clamp(40px,5vw,64px);align-items:center">
        <div style="min-width:0">
          <span style="display:inline-flex;align-items:center;gap:10px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-muted)"><span style="height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;background:var(--pl-ink);color:var(--pl-surface);font-size:10.5px">Solution</span><span style="color:var(--pl-accent-ink)">Ecommerce price tracking</span></span>
          <h1 style="margin:22px 0 0;font-family:Geist,sans-serif;font-size:clamp(38px,5.4vw,68px);line-height:1.02;letter-spacing:-.045em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:700">Ecommerce price tracking,</span><span style="font-weight:400"> built for retail teams, </span><span style="font-weight:400;color:var(--pl-faint);text-decoration:line-through;text-decoration-color:var(--pl-danger);text-decoration-thickness:3px">not spreadsheets.</span></h1>
          <p style="margin:22px 0 0;max-width:540px;font-size:18px;line-height:1.6;color:var(--pl-ink-2);text-wrap:pretty">Track competitor and marketplace prices across your entire catalog, kept accurate and current without manual checks.</p>
          <div style="margin-top:30px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <a href="/book-a-demo" style="height:48px;padding:0 22px;display:inline-flex;align-items:center;border-radius:12px;background:var(--pl-gradient);color:var(--pl-surface);font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.9)">Book a demo</a>
            <a href="#pricing" style="height:48px;padding:0 18px;display:inline-flex;align-items:center;gap:10px;border-radius:12px;color:var(--pl-ink);font-family:Geist,sans-serif;font-weight:500;font-size:15px">Talk to us about custom coverage<span style="color:var(--pl-accent-ink)">→</span></a>
          </div>
        </div>
        <div style="position:relative;min-width:0">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:20px;box-shadow:0 40px 80px -40px rgba(60,30,15,.28),0 0 0 6px rgba(255,255,255,.7);overflow:hidden">
            <div style="display:flex;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid var(--pl-line-soft);background:var(--pl-cream)">
              <span style="font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.08em;color:var(--pl-ink)">CATALOG · COMPETITOR PRICES</span>
              <span style="margin-left:auto;display:flex;align-items:center;gap:6px;font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-accent-ink)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-gradient);animation:pi-pulse 1.6s infinite"></span>TRACKING</span>
            </div>
            <div style="position:relative">
              <span aria-hidden="true" style="position:absolute;left:0;right:0;top:0;height:44px;background:linear-gradient(180deg,transparent,rgba(247,99,30,.10),transparent);animation:pi-scan 4s linear infinite;pointer-events:none;z-index:1"></span>
              <div class="et-hrow" style="padding:10px 16px;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:var(--pl-faint);border-bottom:1px solid var(--pl-line-soft)"><span>PRODUCT</span><span style="text-align:right">YOUR PRICE</span><span style="text-align:right">COMPETITOR</span><span style="text-align:right">POSITION</span></div>
              {heroRows.map((r, i) => (
                <div class="et-hrow et-row" data-et-row={i} style="align-items:center;padding:13px 16px;border-bottom:1px solid var(--pl-sand);background:transparent">
                  <span style="min-width:0"><span style="display:block;font-size:13.5px;font-weight:500;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{r.n}</span><span style="font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-faint)">{r.vs}</span></span>
                  <span style="text-align:right;font-family:'Geist Mono',monospace;font-size:13px;color:var(--pl-ink)">{r.you}</span>
                  <span style="text-align:right"><span class="et-comp" style="display:block;font-family:'Geist Mono',monospace;font-size:13px;color:var(--pl-ink)">{r.comp}</span><span style={`font-family:'Geist Mono',monospace;font-size:10.5px;color:${r.dc}`}>{r.d}</span></span>
                  <span style={`justify-self:end;height:24px;padding:0 9px;display:inline-flex;align-items:center;border-radius:999px;background:${r.pbg};border:1px solid ${r.pbc};font-family:'Geist Mono',monospace;font-size:10.5px;color:${r.pc}`}>{r.pos}</span>
                </div>
              ))}
            </div>
            <div style="overflow:hidden;background:var(--pl-cream);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)">
              <div style="display:flex;width:max-content;animation:pi-marquee 26s linear infinite">
                {tape.map((t) => (<span style="flex:none;height:40px;padding:0 16px;display:flex;align-items:center;gap:8px;border-right:1px solid var(--pl-line-soft);font-family:'Geist Mono',monospace;font-size:11px;color:var(--pl-ink-2);white-space:nowrap"><span style="color:var(--pl-ink)">{t.n}</span><span style={`color:${t.c}`}>{t.d}</span></span>))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGOS -->
    <section style="border-bottom:1px solid var(--pl-line)">
      <div class="et-logo" style="max-width:1280px;margin:0 auto">
        <div class="et-logolabel" style="padding:22px clamp(20px,4vw,40px);display:flex;align-items:center;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-muted)">Trusted by teams at</div>
        <div style="overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)">
          <div style="display:flex;width:max-content;animation:pi-marquee 32s linear infinite">
            {logoLoop.map((n) => (<div style="flex:none;width:188px;height:104px;display:flex;align-items:center;justify-content:center;border-right:1px solid var(--pl-line-soft)"><img src={`/assets/logos/${n}.svg`} alt={n} loading="lazy" style="height:50px;max-width:168px;width:auto;object-fit:contain"></div>))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section id="problem" style="border-bottom:1px solid var(--pl-line);background:var(--pl-cream)">
      <div class="et-split" style="max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);gap:clamp(36px,5vw,72px);align-items:center">
        <div data-reveal>
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-danger-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-danger)"></span>The problem</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(28px,3.4vw,42px);line-height:1.1;letter-spacing:-.035em;color:var(--pl-ink);text-wrap:balance"><span style="font-weight:400">Prices shift every day across hundreds of competitors and marketplaces. </span><span style="font-weight:700">Past a few hundred SKUs, manual tracking stops working.</span></h2>
          <div style="margin-top:28px;display:flex;flex-direction:column;border-top:1px solid var(--pl-line)">
            {['Spreadsheets and one-off checks fall behind the moment your catalog grows.', 'Bad matches and stale prices quietly cost you margin on some products and sales on others.', 'Built for retailers and brands tracking thousands of SKUs, not shoppers tracking one.'].map((t, i) => (
              <div style="display:grid;grid-template-columns:36px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--pl-line)"><span style="font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-danger-ink)">0{i + 1}</span><span style="font-size:16px;line-height:1.55;color:var(--pl-ink)">{t}</span></div>
            ))}
          </div>
        </div>
        <div data-reveal style="position:relative;padding:clamp(8px,2vw,24px)">
          <div style="position:relative;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:14px;box-shadow:0 40px 70px -40px rgba(60,30,15,.35);overflow:hidden;animation:pi-wobble 6s ease-in-out infinite">
            <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--pl-sand);border-bottom:1px solid var(--pl-line)">
              <span style="width:18px;height:18px;border-radius:4px;background:#1F7A44;color:var(--pl-surface);font-family:'Geist Mono',monospace;font-size:10px;display:flex;align-items:center;justify-content:center">X</span>
              <span style="font-family:'Geist Mono',monospace;font-size:12px;color:var(--pl-ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">competitor_prices_FINAL_v7.xlsx</span>
              <span style="margin-left:auto;font-family:'Geist Mono',monospace;font-size:10px;color:var(--pl-faint);white-space:nowrap">Visual · the "before" state</span>
            </div>
            <div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr) minmax(0,.8fr) minmax(0,1fr);font-family:'Geist Mono',monospace;font-size:12px">
              {['SKU', 'Comp A', 'Comp B', 'Updated'].map((h, i) => (<span style={`padding:8px 10px;background:var(--pl-cream);${i < 3 ? 'border-right:1px solid var(--pl-line-soft);' : ''}border-bottom:1px solid var(--pl-line);color:var(--pl-muted)`}>{h}</span>))}
              {sheet.map((c) => (<span class:list={[{ 'et-stale': c.bad }]} style={`padding:10px;border-right:${c.br};border-bottom:1px solid var(--pl-line-soft);color:${c.col};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;animation-delay:${c.dl}s`}>{c.v}</span>))}
              <span style="grid-column:1 / 4;padding:10px;color:var(--pl-faint);font-style:italic">...+3,400 rows</span><span style="padding:10px;color:var(--pl-danger-ink)">unknown</span>
            </div>
          </div>
          <span style="position:absolute;right:0;top:0;height:28px;padding:0 10px;display:flex;align-items:center;gap:6px;border-radius:8px;background:var(--pl-danger-tint);border:1px solid var(--pl-danger-line);font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-danger-ink);box-shadow:0 10px 20px -14px rgba(201,55,46,.6)"><span style="width:6px;height:6px;border-radius:50%;background:var(--pl-danger);animation:pi-blink 1s steps(1) infinite"></span>11 DAYS STALE</span>
          <span style="position:absolute;left:0;bottom:0;height:28px;padding:0 10px;display:flex;align-items:center;gap:6px;border-radius:8px;background:var(--pl-surface);border:1px solid var(--pl-line);font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-muted);box-shadow:0 10px 20px -14px rgba(60,30,15,.4)">#N/A · match guessed by title</span>
        </div>
      </div>
    </section>

    <!-- SOLUTION -->
    <section id="solution" style="border-bottom:1px solid var(--pl-line);position:relative;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;left:50%;top:58%;width:900px;height:900px;margin:-450px 0 0 -450px;border-radius:50%;border:1px solid var(--pl-line-soft)"></div>
      <div aria-hidden="true" style="position:absolute;left:50%;top:58%;width:640px;height:640px;margin:-320px 0 0 -320px;border-radius:50%;border:1px dashed var(--pl-line-alt);animation:pi-orbit 60s linear infinite"></div>
      <div style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;text-align:center">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-accent-ink)"><span style="width:7px;height:7px;border-radius:2px;background:var(--pl-gradient)"></span>The solution · Ecommerce price monitoring tools</span>
          <h2 style="margin:16px 0 0;font-family:Geist,sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.06;letter-spacing:-.035em;color:var(--pl-ink);max-width:820px;text-wrap:balance"><span style="font-weight:700">One reliable view</span><span style="font-weight:400"> of where your prices sit against the market.</span></h2>
          <p style="margin:18px 0 0;max-width:700px;font-size:17px;line-height:1.65;color:var(--pl-ink-2);text-wrap:pretty">PriceLeap watches the prices you care about, matches them to the right products in your catalog, and keeps that data fresh enough to act on.</p>
          <p style="margin:10px 0 0;max-width:700px;font-size:15px;line-height:1.6;color:var(--pl-muted)">You get one reliable view of where your prices sit against the market, updated on a schedule you set.</p>
        </div>
        <div data-reveal style="margin:52px auto 0;max-width:1000px;background:var(--pl-surface);border:1px solid var(--pl-line);border-radius:24px;box-shadow:0 40px 80px -50px rgba(60,30,15,.35);overflow:hidden">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:16px 22px;border-bottom:1px solid var(--pl-line-soft);flex-wrap:wrap">
            <span style="font-family:Geist,sans-serif;font-size:16px;font-weight:600;color:var(--pl-ink)">Market position · today</span>
            <span style="height:26px;padding:0 10px;display:flex;align-items:center;gap:6px;border-radius:999px;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);font-family:'Geist Mono',monospace;font-size:10.5px;color:var(--pl-accent-ink)"><span style="width:12px;height:12px;border-radius:50%;border:2px solid var(--pl-accent-line);border-top-color:var(--pl-accent);animation:pi-spin 1.2s linear infinite"></span>Refreshed 2×/day</span>
          </div>
          <div class="et-sol" style="gap:1px;background:var(--pl-line-soft)">
            <div style="background:var(--pl-cream);padding:28px;display:flex;align-items:center;justify-content:center">
              <div style="position:relative;width:220px;height:220px">
                <svg viewBox="0 0 220 220" style="width:100%;height:100%;transform:rotate(-90deg)">
                  <circle cx="110" cy="110" r="88" fill="none" stroke="#F5ECE5" stroke-width="18"></circle>
                  <circle cx="110" cy="110" r="88" fill="none" stroke="#F7631E" stroke-width="18" stroke-dasharray="337.3 552.9" style="--c:552.9;animation:pi-ring 1.6s cubic-bezier(.2,.7,.2,1) both"></circle>

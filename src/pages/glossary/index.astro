---
import SiteLayout from '@/layouts/SiteLayout.astro';
import GlossaryCard from '@/components/glossary/GlossaryCard.astro';
import glossaryData from '@/data/glossary.json';
const terms = glossaryData.terms;
const letters = [...new Set(terms.map((term) => term.term.charAt(0).toUpperCase()))].sort();
const categories = [...new Set(terms.map((term) => term.category))].sort();
const glossarySchema = { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'PriceLeap Pricing Intelligence Glossary', description: 'Definitions for competitive pricing, marketplace strategy, and repricing automation.', url: 'https://priceleap.ai/glossary/', hasDefinedTerm: terms.map((term) => ({ '@type': 'DefinedTerm', name: term.term, description: term.shortDefinition, url: 'https://priceleap.ai/glossary/' + term.slug + '/' })) };
---
<SiteLayout title="Pricing Intelligence Glossary | PriceLeap" description="Clear definitions for competitive pricing, marketplace strategy, pricing rules, and repricing automation.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(glossarySchema)} />
  <section class="glossary-hero"><div class="glossary-hero__grid" aria-hidden="true"></div><div class="pl-container glossary-hero__inner"><span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">Pricing intelligence glossary</span></span><h1>The language of <em>better pricing.</em></h1><p>Every term you’ll encounter in competitive pricing, marketplace strategy, and repricing automation—defined clearly.</p><div class="glossary-hero__stats"><strong>{terms.length}</strong><span>terms across pricing, marketplaces, and catalog management</span></div></div></section>
  <section class="pl-container glossary-page" aria-labelledby="glossary-heading">
    <div class="glossary-toolbar"><label class="glossary-search"><span class="sr-only">Search glossary terms</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg><input type="search" placeholder="Search terms..." data-glossary-search /><span data-glossary-count>{terms.length} terms</span></label><div class="glossary-filters" role="tablist" aria-label="Filter glossary terms"><button type="button" role="tab" aria-selected="true" data-glossary-filter="All">All</button>{categories.map((category) => <button type="button" role="tab" aria-selected="false" data-glossary-filter={category}>{category}</button>)}</div></div>
    <div class="glossary-alpha" aria-label="Jump to letter">{letters.map((letter) => <a href={'#glossary-' + letter} data-glossary-letter={letter}>{letter}</a>)}</div>
    <div class="glossary-results" data-glossary-results>{letters.map((letter) => <section class="glossary-letter" id={'glossary-' + letter} data-glossary-section={letter}><div class="glossary-letter__head"><span>{letter}</span><i aria-hidden="true"></i></div><div class="glossary-grid">{terms.filter((term) => term.term.startsWith(letter)).map((term) => <GlossaryCard term={term} />)}</div></section>)}</div>
    <p class="glossary-empty" data-glossary-empty hidden>No matching terms found. Try a different search or category.</p>
  </section>
  <section class="pl-container glossary-cta"><div><span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">See the concepts in action</span></span><h2>Turn market data into controlled decisions.</h2><p>PriceLeap puts these strategies to work across your catalog.</p></div><a class="pl-btn pl-btn--primary pl-btn--lg" href="/book-a-demo">Book a demo <span aria-hidden="true">→</span></a></section>
</SiteLayout>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-glossary-card]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-glossary-section]')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-glossary-filter]')];
  const search = document.querySelector<HTMLInputElement>('[data-glossary-search]');
  const count = document.querySelector<HTMLElement>('[data-glossary-count]');
  const empty = document.querySelector<HTMLElement>('[data-glossary-empty]');
  let activeFilter = 'All';
  const render = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => { const show = (activeFilter === 'All' || card.dataset.category === activeFilter) && (!query || (card.dataset.search ?? '').includes(query)); card.hidden = !show; if (show) visible += 1; });
    sections.forEach((section) => { section.hidden = !section.querySelector('[data-glossary-card]:not([hidden])'); });
    if (count) count.textContent = visible + ' ' + (visible === 1 ? 'term' : 'terms');
    if (empty) empty.hidden = visible > 0;
  };
  buttons.forEach((button) => button.addEventListener('click', () => { activeFilter = button.dataset.glossaryFilter ?? 'All'; buttons.forEach((item) => item.setAttribute('aria-selected', String(item === button))); render(); }));
  search?.addEventListener('input', render);
</script>
<style>
  .glossary-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--pl-line); background: var(--pl-surface); } .glossary-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px, transparent 1px), linear-gradient(90deg, var(--pl-line-soft) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 75% 100% at 70% 30%, #000 8%, transparent 78%); opacity: .65; } .glossary-hero__inner { position: relative; display: flex; flex-direction: column; align-items: center; padding-block: clamp(64px, 9vw, 112px); text-align: center; } .glossary-hero h1 { margin-top: 22px; color: var(--pl-ink); font-size: clamp(42px, 6vw, 76px); line-height: 1; letter-spacing: -.055em; } .glossary-hero h1 em { color: var(--pl-accent-ink); font-style: normal; } .glossary-hero p { max-width: 650px; margin-top: 22px; color: var(--pl-muted); font-size: 18px; line-height: 1.6; } .glossary-hero__stats { display: flex; align-items: center; gap: 12px; margin-top: 28px; color: var(--pl-muted); font-family: var(--pl-mono); font-size: 11px; text-align: left; } .glossary-hero__stats strong { color: var(--pl-accent-ink); font-size: 28px; letter-spacing: -.05em; } .glossary-page { padding-block: clamp(44px, 7vw, 84px); } .glossary-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; } .glossary-search { display: flex; width: min(100%, 400px); align-items: center; gap: 10px; border: 1px solid var(--pl-line-strong); border-radius: 12px; background: #fff; padding: 0 15px; box-shadow: var(--pl-shadow-sm); } .glossary-search svg { width: 18px; flex: none; fill: none; stroke: var(--pl-muted); stroke-width: 1.7; } .glossary-search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--pl-ink); padding: 14px 0; font: inherit; font-size: 13px; } .glossary-search > span:last-child { color: var(--pl-faint); font-family: var(--pl-mono); font-size: 10px; white-space: nowrap; } .glossary-filters { display: flex; flex-wrap: wrap; justify-content: end; gap: 8px; } .glossary-filters button { border: 1px solid var(--pl-line); border-radius: 999px; background: var(--pl-surface); color: var(--pl-muted); padding: 8px 12px; font: inherit; font-size: 11px; cursor: pointer; } .glossary-filters button:hover, .glossary-filters button[aria-selected='true'] { border-color: var(--pl-ink); background: var(--pl-ink); color: #fff; } .glossary-alpha { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 36px; border-top: 1px solid var(--pl-line); border-bottom: 1px solid var(--pl-line); padding-block: 16px; } .glossary-alpha a { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; color: var(--pl-muted); font-family: var(--pl-mono); font-size: 11px; } .glossary-alpha a:hover { background: var(--pl-accent-tint); color: var(--pl-accent-ink); } .glossary-letter { padding-top: 46px; } .glossary-letter[hidden], .glossary-card[hidden] { display: none; } .glossary-letter__head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; color: var(--pl-ink); font-family: var(--pl-mono); font-size: 14px; font-weight: 600; } .glossary-letter__head span { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: var(--pl-ink); color: #fff; } .glossary-letter__head i { height: 1px; flex: 1; background: var(--pl-line); } .glossary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; } .glossary-empty { padding: 60px 0; color: var(--pl-muted); text-align: center; } .glossary-cta { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-bottom: 72px; border-radius: var(--pl-radius-xl); background: var(--pl-ink); padding: clamp(28px, 5vw, 56px); color: #fff; } .glossary-cta .pl-eyebrow { color: #fff; } .glossary-cta h2 { max-width: 620px; margin-top: 15px; color: #fff; font-size: clamp(28px, 4vw, 50px); letter-spacing: -.045em; } .glossary-cta p { margin-top: 10px; color: rgba(255,255,255,.65); font-size: 15px; } @media (max-width: 900px) { .glossary-toolbar { align-items: flex-start; flex-direction: column; } .glossary-search { width: 100%; } .glossary-filters { justify-content: start; } .glossary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } } @media (max-width: 600px) { .glossary-grid { grid-template-columns: 1fr; } .glossary-cta { align-items: flex-start; flex-direction: column; } }
</style>

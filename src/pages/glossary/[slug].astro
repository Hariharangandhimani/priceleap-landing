---
import SiteLayout from '@/layouts/SiteLayout.astro';
import glossaryData from '@/data/glossary.json';
export function getStaticPaths() {
  return glossaryData.terms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}
const { term } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'DefinedTerm', name: term.term, description: term.metaDescription || term.shortDefinition, termCode: term.slug, inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'PriceLeap Pricing Intelligence Glossary', url: 'https://priceleap.ai/glossary/' } };
---
<SiteLayout title={term.term + ' | PriceLeap Glossary'} description={term.metaDescription || term.shortDefinition}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <section class="term-hero"><div class="term-hero__grid" aria-hidden="true"></div><div class="pl-container term-hero__inner"><a class="term-back" href="/glossary/">← Back to glossary</a><span class="term-category">{term.category}</span><h1>{term.term}</h1>{term.phonetic && <span class="term-phonetic">{term.phonetic}</span>}</div></section>
  <main class="pl-container term-page"><div class="term-layout"><article class="term-content"><div class="term-content__label">Definition</div><div class="term-content__body" set:html={term.contentHtml}></div><div class="term-cta"><span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">See it in action</span></span><h2>Make this strategy work across your catalog.</h2><p>Bring your real pricing challenge and we’ll show you the workflow.</p><a class="pl-btn pl-btn--primary" href="/book-a-demo">Book a demo <span aria-hidden="true">→</span></a></div></article><aside class="term-aside"><div class="term-aside__label">Related terms</div><div class="term-related">{term.relatedTerms.map((related) => <a href={'/glossary/' + related.slug + '/'}><span>{related.category}</span><strong>{related.term}</strong><i aria-hidden="true">↗</i></a>)}</div><a class="term-all" href="/glossary/">Browse all terms <span aria-hidden="true">→</span></a></aside></div></main>
</SiteLayout>
<style>
  .term-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--pl-line); background: var(--pl-surface); } .term-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px, transparent 1px), linear-gradient(90deg, var(--pl-line-soft) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 75% 100% at 70% 30%, #000 8%, transparent 78%); opacity: .65; } .term-hero__inner { position: relative; display: flex; flex-direction: column; align-items: center; padding-block: clamp(50px, 8vw, 92px); text-align: center; } .term-back { align-self: flex-start; color: var(--pl-muted); font-family: var(--pl-mono); font-size: 10px; } .term-back:hover { color: var(--pl-accent-ink); } .term-category { margin-top: 48px; color: var(--pl-accent-ink); font-family: var(--pl-mono); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; } .term-hero h1 { max-width: 900px; margin-top: 16px; color: var(--pl-ink); font-size: clamp(44px, 7vw, 88px); line-height: .98; letter-spacing: -.06em; } .term-phonetic { margin-top: 18px; color: var(--pl-faint); font-family: var(--pl-mono); font-size: 14px; }
  .term-page { padding-block: clamp(48px, 8vw, 96px); } .term-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: clamp(44px, 9vw, 128px); max-width: 1040px; margin: 0 auto; } .term-content__label, .term-aside__label { color: var(--pl-accent-ink); font-family: var(--pl-mono); font-size: 10px; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; } .term-content__body { margin-top: 24px; color: var(--pl-muted); font-size: 18px; line-height: 1.8; } .term-content__body :global(p) { margin: 0 0 22px; } .term-content__body :global(strong) { color: var(--pl-ink); } .term-content__body :global(a) { color: var(--pl-accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  .term-cta { margin-top: 54px; border-radius: var(--pl-radius-lg); background: var(--pl-ink); padding: 30px; color: #fff; } .term-cta .pl-eyebrow { color: #fff; } .term-cta h2 { margin-top: 14px; color: #fff; font-size: 28px; line-height: 1.08; letter-spacing: -.04em; } .term-cta p { margin-top: 10px; color: rgba(255,255,255,.65); font-size: 14px; line-height: 1.55; } .term-cta .pl-btn { margin-top: 22px; }
  .term-aside { align-self: start; position: sticky; top: 100px; } .term-related { display: grid; margin-top: 18px; border-top: 1px solid var(--pl-line); } .term-related a { position: relative; display: grid; gap: 7px; border-bottom: 1px solid var(--pl-line); padding: 16px 28px 16px 0; } .term-related a:hover strong { color: var(--pl-accent-ink); } .term-related span { color: var(--pl-faint); font-family: var(--pl-mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; } .term-related strong { color: var(--pl-ink); font-size: 14px; line-height: 1.25; } .term-related i { position: absolute; top: 18px; right: 0; color: var(--pl-accent-ink); font-size: 18px; font-style: normal; } .term-all { display: flex; justify-content: space-between; margin-top: 20px; color: var(--pl-ink); font-family: var(--pl-mono); font-size: 10px; } .term-all span { color: var(--pl-accent-ink); font-size: 16px; }
  @media (max-width: 760px) { .term-layout { grid-template-columns: 1fr; } .term-aside { position: static; } .term-back { align-self: auto; } }
</style>

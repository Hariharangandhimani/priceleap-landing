---
// Native Astro port of the delivered "Price Comparison" feature page.
// Static initial render (tick 0) + the 1.8s loop reimplemented in vanilla JS:
// the hero price-position bar (your marker + rank + vs-avg cycle), the
// software-vs-site row highlight, the interactive 5-pin product table that
// auto-advances (and stops on click) with column highlight + footer, and the
// catalog Q&A row highlight with per-row mini visuals; FAQ accordion; reveal.
import PriceLeapLayout from '../../layouts/PriceLeapLayout.astro';

const R = { ct: '/features/competitor-tracking', dps: '/dynamic-pricing-software', pie: '/price-intelligence-engine', demo: '/book-a-demo' };
const chips = ['Gap to every tracked seller', 'Your rank on each product', 'US and India listings in one table'];

const sellers: [string, string, number, string][] = [['Amazon', '#F59E0B', 12, '$139.99'], ['Best Buy', '#3B82F6', 46, '$152.00'], ['Walmart', '#2563EB', 64, '$158.50'], ['Target', '#EF4444', 88, '$169.00']];
// tick 0 => ph 0
const yourX0 = 34, yourP0 = '$149.00', vsAvgN0 = -4.1;
const all0 = [...sellers.map(([n, dot, x, p]) => ({ n, dot, x, p, you: false })), { n: 'You', dot: '#F7631E', x: yourX0, p: yourP0, you: true }];
const rank0 = [...all0].sort((a, b) => a.x - b.x).findIndex((a) => a.you) + 1;
const heroSellers = all0.map((a, i) => ({ ...a, y: a.you ? 76 : (i % 2 ? 76 : 0), dir: a.you ? 'column-reverse' : (i % 2 ? 'column-reverse' : 'column'), bg: a.you ? '#1C130E' : '#FFFFFF', bc: a.you ? '#1C130E' : '#EFE3DA', c: a.you ? '#FFFFFF' : '#1C130E', sh: a.you ? '0 10px 22px -10px rgba(60,30,15,.6)' : 'none', stem: a.you ? '#1C130E' : '#E2D3C8', mk: a.you ? '#F7631E' : '#FFFFFF', anim: a.you ? 'pc-pulse 1.8s infinite' : 'none' }));

const siteRaw = [['Who it is for', 'Shoppers looking for the cheapest offer on one product.'], ['What it compares', 'Offers from whichever sellers list on the site.'], ['Which sellers count', 'Any seller the site happens to carry.'], ['What you do next', 'Buy from the cheapest seller.']];
const swRaw: [string, string, string, boolean][] = [['Who it is for', 'Sellers who set prices across a whole catalog.', '', false], ['What it compares', 'Your own price against each competitor, on every product you track.', '', false], ['Which sellers count', 'The competitors you add, or the ones AI finds for each product group.', '', false], ['What you do next', 'Adjust the price, or check the ', ' recommendation your pricing rule produces.', true]];
const siteRows = siteRaw.map(([k, v], i) => ({ k, v, bb: i < 3 ? '1px solid #F5ECE5' : 'none', bg: i === 0 ? '#FBF3EC' : 'transparent' }));
const swRows = swRaw.map(([k, v1, v2, l], i) => ({ k, v1, v2, ld: l ? 'inline' : 'none', bb: i < 3 ? '1px solid #F5ECE5' : 'none', bg: i === 0 ? '#FFF4EC' : '#FFFFFF' }));

// [title, desc, pinX, colL, colW]
const pinData: [string, string, number, number, number][] = [['Price', "Each seller's price at the last check. No match means that seller's listing for this product hasn't been found.", 24.5, 23.2, 14], ['VS You', 'The gap between that seller and your price, as an amount and a percentage.', 41, 40.2, 15], ['Position', 'Where the seller sits on a bar from the lowest to the highest tracked price.', 57.5, 56.8, 15.5], ['Stock', 'Whether the seller had the product in stock at the last check.', 74, 73.4, 13], ['Seen', "How long ago that seller's price was checked.", 88.5, 87.8, 10.4]];
// tick 0 => pin 0
const pins = pinData.map(([t, , x], i) => ({ t, n: String(i + 1), x, bg: i === 0 ? '#F7631E' : '#1C130E', anim: i === 0 ? 'pc-pulse 1.8s infinite' : 'none' }));
const callouts = pinData.map(([t, d], i) => { const on = i === 0; return { t, d, n: String(i + 1), bg: on ? '#FFFFFF' : 'transparent', bc: on ? '#FFD8BE' : '#EFE3DA', sh: on ? '0 18px 36px -26px rgba(247,99,30,.6)' : 'none', nb: on ? '#F7631E' : '#1C130E' }; });

const qRaw = [['Am I above or below the market on this product?', 'Your Price shows the percentage against the market average, green at or below it and red above it.'], ['How wide is the market?', 'A range bar under your price marks the lowest and highest tracked price, with a marker for yours.'], ['Who is cheaper, and by how much?', "The Competitors column lists each seller's price side by side, with an out-of-stock badge where it applies."], ['Is this product competitive or premium?', 'Position vs Market gives a label with a short reason, such as Lowest among tracked sellers or 13% above lowest.'], ['How fresh is this row?', "Last fetch shows the date and time of the product's latest check."]];
const qs = qRaw.map(([q, a], i) => ({ q, a, bb: i < 4 ? '1px solid #F5ECE5' : 'none', bg: i === 0 ? '#FFFCF9' : '#FFFFFF', ab: i === 0 ? '#1C130E' : '#FBF3EC', ac: i === 0 ? '#FFFFFF' : '#B9A99C', rbc: i === 0 ? '#FFD8BE' : '#F5ECE5' }));

const fq: [string, string, string, boolean][] = [
  ['Can I compare prices across countries and currencies?', 'Yes. One workspace can hold US and Indian listings side by side, and each product shows prices in its own currency, such as USD or INR. Keep products from one market in their own product group, so each group follows the competitors and schedule that suit that market.', '', false],
  ["What happens when a competitor doesn't sell the same product?", 'Their column shows No match instead of a price, so you can see at a glance where a comparison has a gap. If you know the right listing, add it to the product, as described on the ', ' page, and it joins the comparison from the next check.', true],
  ['Can I export the comparison?', 'Yes. Export the dashboard table, or a single product page, with the Export button. You can also connect Google Sheets or Microsoft Excel under Integrations to send price data out to the reports your team already uses, without copying numbers by hand.', '', false],
];
const faqs = fq.map(([q, a1, a2, l], i) => { const open = i === 0; return { q, a1, a2: a2 || '', ld: l ? 'inline' : 'none', open, n: '0' + (i + 1), rows: open ? '1fr' : '0fr', rot: open ? 45 : 0, bc: open ? '#FFD8BE' : '#EFE3DA', nc: open ? '#C2410C' : '#B9A99C', ib: open ? '#1C130E' : '#FBF3EC', ic: open ? '#FFFFFF' : '#1C130E' }; });

const site = 'https://priceleap.ai';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: fq.map(([q, a1, a2]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: (a1 + (a2 ? 'Competitor Tracking' + a2 : '')).trim() } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Features', item: site + '/features/' },
    { '@type': 'ListItem', position: 3, name: 'Price Comparison', item: site + '/features/price-comparison' },
  ] },
];
---
<PriceLeapLayout
  title="Price Comparison Software for Sellers | priceleap.ai"
  description="Compare your price with every competitor you track, product by product: the gap, your rank, their stock and when each price was checked. Book a Demo."
  jsonLd={jsonLd}
>
  <div class="pc" style="min-height:100vh;background:#FFFCF9;overflow-x:clip">

    <!-- 01 HERO -->
    <section style="position:relative;border-bottom:1px solid #EFE3DA;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(#F5ECE5 1px,transparent 1px),linear-gradient(90deg,#F5ECE5 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:radial-gradient(ellipse 60% 80% at 78% 45%,#000 10%,transparent 72%);mask-image:radial-gradient(ellipse 60% 80% at 78% 45%,#000 10%,transparent 72%);pointer-events:none"></div>
      <div aria-hidden="true" style="position:absolute;right:-8%;top:-20%;width:700px;height:640px;background:radial-gradient(closest-side,rgba(247,99,30,.09),transparent);pointer-events:none"></div>
      <div class="pc-hero" style="position:relative;max-width:1280px;margin:0 auto;padding:clamp(48px,7vw,104px) clamp(16px,4vw,40px) clamp(48px,6vw,96px);display:grid;gap:clamp(36px,5vw,72px);align-items:center">
        <div style="min-width:0;display:flex;flex-direction:column;gap:22px">
          <span style="display:inline-flex;align-items:center;gap:8px;font-family:'Geist Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>Features · Price Comparison</span>
          <h1 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(40px,5.6vw,72px);line-height:1;letter-spacing:-.05em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Price comparison software</span><span style="font-weight:400"> for sellers</span></h1>
          <p style="margin:0;max-width:600px;font-size:18px;line-height:1.65;color:#3A302A;text-wrap:pretty">priceleap.ai puts your price next to every competitor you track, for each product in your catalog. You see the gap to each seller, your rank among them, who has stock and when each price was last checked.</p>
          <a href={R.demo} style="align-self:flex-start;height:50px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            {chips.map((c) => (<span style="height:34px;padding:0 14px;display:flex;align-items:center;gap:8px;border-radius:999px;background:#FFFFFF;border:1px solid #EFE3DA;font-size:13.5px;color:#1C130E"><span style="width:18px;height:18px;border-radius:50%;background:#1C130E;color:#FFFFFF;font-size:9px;display:flex;align-items:center;justify-content:center">✓</span>{c}</span>))}
          </div>
        </div>
        <div class="pc-herovis" aria-hidden="true" style="position:relative;min-width:0;padding:26px;border-radius:24px;background:#FFFFFF;border:1px solid #EFE3DA;box-shadow:0 48px 90px -56px rgba(60,30,15,.42)">
          <div style="display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.08em;color:#7F7066"><span>LOWEST</span><span>TRACKED SELLERS</span><span>HIGHEST</span></div>
          <div style="position:relative;margin-top:20px;height:150px">
            <span style="position:absolute;left:0;right:0;top:72px;height:6px;border-radius:6px;background:linear-gradient(90deg,#F5ECE5,#FFD8BE)"></span>
            {heroSellers.map((h) => (
              <span data-pc-hs={h.you ? 'you' : ''} style={`position:absolute;left:${h.x}%;top:${h.y}px;transform:translateX(-50%);display:flex;flex-direction:${h.dir};align-items:center;gap:6px;transition:left 1.1s cubic-bezier(.2,.7,.2,1)`}>
                <span style={`height:26px;padding:0 9px;display:flex;align-items:center;gap:6px;border-radius:8px;background:${h.bg};border:1px solid ${h.bc};font-family:'Geist Mono',monospace;font-size:11px;color:${h.c};white-space:nowrap;box-shadow:${h.sh}`}><span style={`width:6px;height:6px;border-radius:50%;background:${h.dot}`}></span>{h.n} · <span data-pc-hsp>{h.p}</span></span>
                <span style={`width:2px;height:14px;background:${h.stem}`}></span>
                <span style={`width:12px;height:12px;border-radius:50%;background:${h.mk};border:2px solid #FFFFFF;box-shadow:0 0 0 1px ${h.stem};animation:${h.anim}`}></span>
              </span>
            ))}
          </div>
          <div style="margin-top:8px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#F5ECE5;border:1px solid #F5ECE5;border-radius:14px;overflow:hidden">
            <div style="background:#FFF9F4;padding:12px 14px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">YOUR RANK</div><div style="margin-top:3px;font-family:Geist,sans-serif;font-size:20px;font-weight:600;color:#1C130E">#<span data-pc-rank>{rank0}</span> <span style="font-size:13px;font-weight:400;color:#665A51">of 5</span></div></div>
            <div style="background:#FFF9F4;padding:12px 14px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">VS MARKET AVG</div><div data-pc-vs style="margin-top:3px;font-family:Geist,sans-serif;font-size:20px;font-weight:600;color:#1E7A3D">{(vsAvgN0 > 0 ? '+' : '') + vsAvgN0 + '%'}</div></div>
            <div style="background:#FFF9F4;padding:12px 14px"><div style="font-family:'Geist Mono',monospace;font-size:9.5px;letter-spacing:.08em;color:#7F7066">IN STOCK</div><div style="margin-top:3px;font-family:Geist,sans-serif;font-size:20px;font-weight:600;color:#1C130E">4 <span style="font-size:13px;font-weight:400;color:#665A51">of 5</span></div></div>
          </div>
          <span style="position:absolute;top:-12px;right:18px;height:24px;padding:0 9px;display:flex;align-items:center;border-radius:6px;border:1px dashed #E2D3C8;background:#FFFFFF;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.06em;color:#7F7066">EXAMPLE</span>
        </div>
      </div>
    </section>

    <!-- 02 SOFTWARE VS SITE -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <h2 data-reveal style="margin:0;max-width:820px;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E;text-wrap:balance"><span style="font-weight:700">Price comparison software</span><span style="font-weight:400"> vs a price comparison site</span></h2>
        <div data-reveal class="pc-vs" style="position:relative;margin-top:40px;display:grid;gap:14px;align-items:stretch">
          <div style="border:1px solid #EFE3DA;border-radius:22px;overflow:hidden;background:#FFFCF9">
            <div style="padding:18px 22px;border-bottom:1px solid #EFE3DA;display:flex;align-items:center;gap:12px"><span style="width:36px;height:36px;border-radius:10px;border:1px solid #EFE3DA;background:#FFFFFF;color:#7F7066;display:flex;align-items:center;justify-content:center"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11h11L21 7H6M9 20a1 1 0 1 0 0-2a1 1 0 1 0 0 2M18 20a1 1 0 1 0 0-2a1 1 0 1 0 0 2"></path></svg></span><span style="font-family:Geist,sans-serif;font-size:18px;font-weight:600;color:#665A51">A price comparison site</span></div>
            {siteRows.map((r) => (<div data-pc-site class="pc-vsrow" style={`padding:16px 22px;border-bottom:${r.bb};display:flex;flex-direction:column;gap:4px;background:${r.bg};transition:background .4s`}><span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#B9A99C">{r.k}</span><span style="font-size:15px;line-height:1.55;color:#665A51">{r.v}</span></div>))}
          </div>
          <div class="pc-vsmid" style="align-items:center;justify-content:center"><span style="width:44px;height:44px;border-radius:50%;background:#FFFFFF;border:1px solid #EFE3DA;font-family:'Geist Mono',monospace;font-size:12px;color:#1C130E;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 24px -14px rgba(60,30,15,.4)">VS</span></div>
          <div style="border:1.5px solid #1C130E;border-radius:22px;overflow:hidden;background:#FFFFFF;box-shadow:0 30px 60px -40px rgba(60,30,15,.5)">
            <div style="padding:18px 22px;border-bottom:1px solid #1C130E;background:#1C130E;display:flex;align-items:center;gap:12px"><span style="width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;display:flex;align-items:center;justify-content:center"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h6v16H4zM14 4h6v16h-6z"></path></svg></span><span style="font-family:Geist,sans-serif;font-size:18px;font-weight:600;color:#FFFFFF">Price comparison software</span></div>
            {swRows.map((r) => (<div data-pc-sw class="pc-vsrow" style={`padding:16px 22px;border-bottom:${r.bb};display:flex;flex-direction:column;gap:4px;background:${r.bg};transition:background .4s`}><span style="font-family:'Geist Mono',monospace;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:#C2410C">{r.k}</span><span style="font-size:15px;line-height:1.55;color:#1C130E">{r.v1}<a href={R.dps} style={`display:${r.ld};font-weight:600`}>SmartPrice</a>{r.v2}</span></div>))}
          </div>
        </div>
        <p data-reveal style="margin:20px 0 0;display:flex;align-items:center;gap:10px;font-size:15.5px;color:#1C130E"><span style="width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>priceleap.ai is the second kind: a tool for the team that sets prices, not a shopping site.</p>
      </div>
    </section>

    <!-- 03 READ ONE PRODUCT -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;gap:14px">
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E"><span style="font-weight:400">How to read </span><span style="font-weight:700">one product's comparison</span></h2>
          <p style="margin:0;max-width:640px;font-size:16.5px;line-height:1.65;color:#3A302A">Open any product and the Competitors panel lines up every tracked seller against your price.</p>
        </div>
        <figure data-reveal style="margin:36px 0 0">
          <div style="border:1px solid #EFE3DA;border-radius:20px;overflow:hidden;background:#FFFFFF;box-shadow:0 44px 84px -52px rgba(60,30,15,.42)">
            <div style="overflow-x:auto">
              <div style="position:relative;min-width:760px">
                <img src="/assets/pc-01-competitor-table.png" alt="priceleap.ai Competitors panel for one product with price, gap to you, position, stock and last-seen columns" width="1100" height="270" style="display:block;width:100%;height:auto" />
                {pins.map((p) => (<button type="button" data-pc-pin aria-label={p.t} style={`position:absolute;left:${p.x}%;top:30.5%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;border:2px solid #FFFFFF;background:${p.bg};color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:11.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 14px -6px rgba(60,30,15,.55);animation:${p.anim};transition:background .3s`}>{p.n}</button>))}
                <span aria-hidden="true" data-pc-col style="position:absolute;top:41.5%;bottom:13.5%;left:23.2%;width:14%;background:rgba(247,99,30,.07);border-left:1.5px solid rgba(247,99,30,.45);border-right:1.5px solid rgba(247,99,30,.45);transition:left .5s cubic-bezier(.2,.7,.2,1),width .5s;pointer-events:none"></span>
                <span aria-hidden="true" data-pc-foot style="position:absolute;left:0;right:0;bottom:0;height:13.5%;outline:2px solid transparent;outline-offset:-3px;border-radius:0 0 20px 20px;transition:outline-color .3s;pointer-events:none"></span>
              </div>
            </div>
          </div>
          <figcaption style="margin-top:12px;display:flex;align-items:center;gap:8px;font-size:13.5px;color:#665A51"><span style="width:6px;height:6px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span>One product's Competitors panel, with your rank in the footer</figcaption>
        </figure>
        <div data-reveal class="pc-calls" style="margin-top:24px;display:grid;gap:10px">
          {callouts.map((c) => (
            <button type="button" data-pc-call style={`text-align:left;cursor:pointer;border:1px solid ${c.bc};background:${c.bg};border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:8px;box-shadow:${c.sh};transition:all .3s`}>
              <span style="display:flex;align-items:center;gap:10px"><span data-pc-calln style={`width:24px;height:24px;border-radius:50%;background:${c.nb};color:#FFFFFF;font-family:'Geist Mono',monospace;font-size:11px;display:flex;align-items:center;justify-content:center;transition:background .3s`}>{c.n}</span><span style="font-family:Geist,sans-serif;font-size:16px;font-weight:600;color:#1C130E">{c.t}</span></span>
              <span style="font-size:14px;line-height:1.55;color:#3A302A">{c.d}</span>
            </button>
          ))}
        </div>
        <p data-reveal data-pc-footnote style="margin:16px 0 0;padding:14px 18px;border-radius:14px;background:#FFFFFF;border:1px solid #F5ECE5;display:flex;gap:12px;align-items:center;font-size:15px;line-height:1.55;color:#1C130E;transition:border-color .3s"><span style="flex:none;height:22px;padding:0 8px;display:flex;align-items:center;border-radius:6px;background:#1C130E;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:.06em;color:#FFFFFF">FOOTER</span>The footer sums it up: your rank among tracked sellers, and whether you hold the lowest price in the market.</p>
      </div>
    </section>

    <!-- 04 CATALOG VIEW -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFFFFF">
      <div style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px)">
        <div data-reveal style="display:flex;flex-direction:column;gap:14px">
          <h2 style="margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E"><span style="font-weight:400">What the </span><span style="font-weight:700">catalog view answers</span></h2>
          <p style="margin:0;max-width:680px;font-size:16.5px;line-height:1.65;color:#3A302A">The <a href={R.pie} style="font-weight:600">Price Intelligence dashboard</a> runs the same comparison across every product you track, one row per product.</p>
        </div>
        <div data-reveal style="margin-top:36px;border:1px solid #EFE3DA;border-radius:24px;overflow:hidden;background:#FFFFFF;box-shadow:0 40px 80px -56px rgba(60,30,15,.35)">
          <div class="pc-qrow pc-qhead" style="padding:14px 22px;border-bottom:1px solid #F5ECE5;background:#FFF9F4;font-family:'Geist Mono',monospace;font-size:11px;letter-spacing:.1em;color:#7F7066"><span>THE QUESTION</span><span></span><span style="color:#C2410C">WHERE TO LOOK</span></div>
          {qs.map((r, i) => (
            <div data-pc-q class="pc-qrow" style={`align-items:center;padding:18px 22px;border-bottom:${r.bb};background:${r.bg};transition:background .4s`}>
              <span style="display:flex;gap:14px;align-items:flex-start"><span style="flex:none;width:26px;height:26px;border-radius:8px;background:#FFF4EC;border:1px solid #FFD8BE;color:#C2410C;font-family:Geist,sans-serif;font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center">?</span><span style="font-family:Geist,sans-serif;font-size:16.5px;font-weight:600;line-height:1.45;color:#1C130E">{r.q}</span></span>
              <span class="pc-qarrow" data-pc-qarrow style={`width:32px;height:32px;border-radius:50%;background:${r.ab};color:${r.ac};font-size:13px;align-items:center;justify-content:center;transition:all .4s`}>→</span>
              <span class="pc-qmini" data-pc-qcell style={`align-items:center;padding:12px 14px;border-radius:14px;background:#FFFFFF;border:1px solid ${r.rbc};transition:border-color .4s`}>
                <span style="font-size:14.5px;line-height:1.55;color:#1C130E">{r.a}</span>
                <span class="pc-mini" aria-hidden="true" style="justify-self:end">
                  {i === 0 && (<span style="display:flex;flex-direction:column;align-items:flex-end;gap:4px"><span style="font-family:Geist,sans-serif;font-size:15px;font-weight:600;color:#1C130E">$149.00</span><span data-pc-mvs style="font-family:'Geist Mono',monospace;font-size:11px;color:#1E7A3D">-4.1%</span></span>)}
                  {i === 1 && (<span style="position:relative;display:block;width:90px;height:8px;border-radius:8px;background:#F5ECE5"><span style="position:absolute;left:8%;right:10%;top:0;bottom:0;border-radius:8px;background:#FFD8BE"></span><span data-pc-mmark style="position:absolute;top:50%;left:34%;width:12px;height:12px;margin:-6px 0 0 -6px;border-radius:50%;background:#1C130E;border:2px solid #FFFFFF;transition:left .8s ease"></span></span>)}
                  {i === 2 && (<span style="display:flex;flex-direction:column;gap:3px;font-family:'Geist Mono',monospace;font-size:10.5px"><span style="display:flex;gap:6px;align-items:center;color:#1C130E"><span style="width:6px;height:6px;border-radius:50%;background:#F59E0B"></span>$139.99</span><span style="display:flex;gap:6px;align-items:center;color:#1C130E"><span style="width:6px;height:6px;border-radius:50%;background:#3B82F6"></span>$152.00</span><span style="display:flex;gap:6px;align-items:center;color:#B42318"><span style="width:6px;height:6px;border-radius:50%;background:#EF4444"></span>OOS</span></span>)}
                  {i === 3 && (<span data-pc-mpos style="height:26px;padding:0 10px;display:flex;align-items:center;border-radius:7px;background:#EAF6EE;border:1px solid #BFE5CC;font-size:12px;font-weight:500;color:#1E7A3D;white-space:nowrap;transition:all .4s">Lowest among tracked sellers</span>)}
                  {i === 4 && (<span style="display:flex;flex-direction:column;align-items:flex-end;font-family:'Geist Mono',monospace;font-size:10.5px;color:#665A51"><span>Nov 25, 2026</span><span data-pc-mfetch style="color:#1C130E">09:02 AM</span></span>)}
                </span>
              </span>
            </div>
          ))}
        </div>
        <p data-reveal style="margin:18px 0 0;display:flex;gap:10px;font-size:15.5px;line-height:1.6;color:#1C130E"><span style="flex:none;margin-top:8px;width:7px;height:7px;border-radius:2px;background:#F7631E;transform:rotate(45deg)"></span><span>When a gap needs action, a <a href={R.dps} style="font-weight:600">pricing rule</a> turns it into a SmartPrice recommendation your team reviews before any price changes.</span></p>
      </div>
    </section>

    <!-- 05 FAQ -->
    <section style="border-bottom:1px solid #EFE3DA;background:#FFF9F4">
      <div class="pc-faqgrid" style="max-width:1180px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(16px,4vw,40px);display:grid;gap:clamp(28px,5vw,72px);align-items:start">
        <h2 data-reveal class="pc-sticky" style="top:96px;margin:0;font-family:Geist,sans-serif;font-size:clamp(30px,3.8vw,46px);line-height:1.06;letter-spacing:-.035em;color:#1C130E"><span style="font-weight:400">Price comparison </span><span style="font-weight:700">FAQs</span></h2>
        <div style="display:flex;flex-direction:column;gap:10px">
          {faqs.map((q) => (
            <div class="pc-faq" class:list={[{ 'is-open': q.open }]} data-pc-faq style="background:#FFFFFF;border:1px solid #EFE3DA;border-radius:16px;overflow:hidden;transition:border-color .25s">
              <button type="button" data-pc-faqbtn aria-expanded={q.open ? 'true' : 'false'} style="width:100%;border:none;background:transparent;cursor:pointer;display:flex;align-items:center;gap:14px;padding:18px 20px;text-align:left">
                <span class="pc-faq-n" style="font-family:'Geist Mono',monospace;font-size:11px">{q.n}</span>
                <span style="flex:1;font-family:Geist,sans-serif;font-size:16.5px;font-weight:500;color:#1C130E">{q.q}</span>
                <span class="pc-faq-ic" style="flex:none;width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M12 5v14M5 12h14"></path></svg></span>
              </button>
              <div class="pc-faq-panel"><div style="overflow:hidden"><p style="margin:0;padding:0 20px 20px 52px;font-size:15px;line-height:1.65;color:#3A302A">{q.a1}<a href={R.ct} style={`display:${q.ld};font-weight:600`}>Competitor Tracking</a>{q.a2}</p></div></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 06 CTA -->
    <section style="padding:clamp(16px,3vw,28px)">
      <div style="position:relative;max-width:1280px;margin:0 auto;overflow:hidden;background:#1C130E;border-radius:28px;padding:clamp(56px,8vw,96px) clamp(20px,4vw,48px);text-align:center">
        <div aria-hidden="true" style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:44px 44px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 10%,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 10%,transparent 75%)"></div>
        <div aria-hidden="true" style="position:absolute;left:50%;bottom:-240px;width:700px;height:420px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(247,99,30,.32),transparent)"></div>
        <div data-reveal style="position:relative;display:flex;flex-direction:column;align-items:center;gap:24px">
          <h2 style="margin:0;max-width:760px;font-family:Geist,sans-serif;font-size:clamp(30px,4.4vw,54px);line-height:1.05;letter-spacing:-.045em;color:#FFFFFF;text-wrap:balance"><span style="font-weight:400">Compare your own catalog </span><span style="font-weight:700">in a demo</span></h2>
          <a href={R.demo} style="height:50px;padding:0 24px;display:inline-flex;align-items:center;border-radius:12px;background:linear-gradient(135deg,#F2421B 0%,#F7631E 50%,#FB8A2E 100%);color:#FFFFFF;font-family:Geist,sans-serif;font-weight:500;font-size:15px;box-shadow:0 12px 26px -12px rgba(247,99,30,.85)">Book a Demo</a>
        </div>
      </div>
    </section>
  </div>
</PriceLeapLayout>

<style>
  .pc { background: #FFFCF9; overflow-x: clip; }
  @keyframes pc-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes pc-pulse { 0% { box-shadow: 0 0 0 0 rgba(247,99,30,.55); } 100% { box-shadow: 0 0 0 10px rgba(247,99,30,0); } }

  .pc-hero { grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .pc-hero { grid-template-columns: minmax(0,1fr) minmax(0,1fr); } }
  .pc-herovis { display: none; }
  @media (min-width: 600px) { .pc-herovis { display: block; } }
  .pc-vs { grid-template-columns: 1fr; }
  .pc-vsmid { display: none; }
  .pc-vsrow { min-height: 0; }
  @media (min-width: 1000px) { .pc-vs { grid-template-columns: minmax(0,1fr) 56px minmax(0,1fr); } .pc-vsmid { display: flex; } .pc-vsrow { min-height: 96px; } }
  .pc-calls { grid-template-columns: 1fr; }
  @media (min-width: 720px) { .pc-calls { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1000px) { .pc-calls { grid-template-columns: repeat(5,minmax(0,1fr)); } }
  .pc-qrow { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .pc-qhead { display: none; }
  .pc-qarrow { display: none; }
  .pc-qmini { display: grid; grid-template-columns: 1fr; }
  .pc-mini { display: none; }
  @media (min-width: 560px) { .pc-qmini { grid-template-columns: minmax(0,1fr) auto; } .pc-mini { display: block; } }
  @media (min-width: 720px) { .pc-qrow { grid-template-columns: minmax(0,1fr) 32px minmax(0,1.25fr); } .pc-qhead { display: grid; } .pc-qarrow { display: flex; } }
  .pc-faqgrid { grid-template-columns: 1fr; }
  .pc-sticky { position: static; }
  @media (min-width: 1000px) { .pc-faqgrid { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); } .pc-sticky { position: sticky; } }

  .pc-faq-n { color: #B9A99C; }
  .pc-faq.is-open .pc-faq-n { color: #C2410C; }
  .pc-faq-ic { background: #FBF3EC; color: #1C130E; transform: rotate(0deg); transition: all .3s; }
  .pc-faq.is-open .pc-faq-ic { background: #1C130E; color: #FFFFFF; transform: rotate(45deg); }
  .pc-faq.is-open { border-color: #FFD8BE; }
  .pc-faq-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; }
  .pc-faq.is-open .pc-faq-panel { grid-template-rows: 1fr; }

  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); }
  [data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .pc *, .pc *::before, .pc *::after { animation: none !important; transition: none !important; } [data-reveal] { opacity: 1 !important; transform: none !important; } }
</style>

<script>
  const root = document.querySelector('.pc') as HTMLElement | null;
  if (root) {
    const qa = (s: string) => Array.from(root.querySelectorAll(s)) as HTMLElement[];
    const youEl = root.querySelector('[data-pc-hs="you"]') as HTMLElement | null;
    const youP = youEl?.querySelector('[data-pc-hsp]') as HTMLElement | null;
    const rankEl = root.querySelector('[data-pc-rank]') as HTMLElement | null, vsEl = root.querySelector('[data-pc-vs]') as HTMLElement | null;
    const siteEls = qa('[data-pc-site]'), swEls = qa('[data-pc-sw]');
    const pinEls = qa('[data-pc-pin]'), callEls = qa('[data-pc-call]'), colEl = root.querySelector('[data-pc-col]') as HTMLElement | null, footEl = root.querySelector('[data-pc-foot]') as HTMLElement | null, footnote = root.querySelector('[data-pc-footnote]') as HTMLElement | null;
    const qEls = qa('[data-pc-q]'), mvs = root.querySelector('[data-pc-mvs]') as HTMLElement | null, mmark = root.querySelector('[data-pc-mmark]') as HTMLElement | null, mpos = root.querySelector('[data-pc-mpos]') as HTMLElement | null, mfetch = root.querySelector('[data-pc-mfetch]') as HTMLElement | null;

    const fixedX = [12, 46, 64, 88];
    const yourXs = [34, 18, 52], yourPs = ['$149.00', '$142.00', '$156.00'], vsAvgNs = [-4.1, -8.6, 2.3];
    const colData = [[23.2, 14], [40.2, 15], [56.8, 15.5], [73.4, 13], [87.8, 10.4]];
    let tk = 0, pin = 0, pinAuto = true;

    function paintPins() {
      pinEls.forEach((el, i) => { const on = pin === i; el.style.background = on ? '#F7631E' : '#1C130E'; el.style.animation = on ? 'pc-pulse 1.8s infinite' : 'none'; });
      callEls.forEach((el, i) => { const on = pin === i; el.style.background = on ? '#FFFFFF' : 'transparent'; el.style.borderColor = on ? '#FFD8BE' : '#EFE3DA'; el.style.boxShadow = on ? '0 18px 36px -26px rgba(247,99,30,.6)' : 'none'; const n = el.querySelector('[data-pc-calln]') as HTMLElement; if (n) n.style.background = on ? '#F7631E' : '#1C130E'; });
      if (colEl) { if (pin < 5) { colEl.style.left = colData[pin][0] + '%'; colEl.style.width = colData[pin][1] + '%'; } else { colEl.style.width = '0%'; } }
      if (footEl) footEl.style.outlineColor = pin === 5 ? '#F7631E' : 'transparent';
      if (footnote) footnote.style.borderColor = pin === 5 ? '#F7631E' : '#F5ECE5';
    }
    function paint() {
      const ph = Math.floor(tk / 2) % 3;
      if (youEl) youEl.style.left = yourXs[ph] + '%';
      if (youP) youP.textContent = yourPs[ph];
      const n = vsAvgNs[ph];
      if (rankEl) { const order = [...fixedX, yourXs[ph]].map((x, i) => ({ x, you: i === 4 })).sort((a, b) => a.x - b.x); rankEl.textContent = String(order.findIndex((o) => o.you) + 1); }
      if (vsEl) { vsEl.textContent = (n > 0 ? '+' : '') + n + '%'; vsEl.style.color = n > 0 ? '#B42318' : '#1E7A3D'; }

      const rHot = tk % 4;
      siteEls.forEach((el, i) => { el.style.background = i === rHot ? '#FBF3EC' : 'transparent'; });
      swEls.forEach((el, i) => { el.style.background = i === rHot ? '#FFF4EC' : '#FFFFFF'; });

      const qHot = Math.floor(tk / 2) % 5;
      qEls.forEach((el, i) => { const on = i === qHot; el.style.background = on ? '#FFFCF9' : '#FFFFFF'; const ar = el.querySelector('[data-pc-qarrow]') as HTMLElement; if (ar) { ar.style.background = on ? '#1C130E' : '#FBF3EC'; ar.style.color = on ? '#FFFFFF' : '#B9A99C'; } (el.querySelector('[data-pc-qcell]') as HTMLElement).style.borderColor = on ? '#FFD8BE' : '#F5ECE5'; });

      if (mvs) { mvs.textContent = (n > 0 ? '+' : '') + n + '%'; mvs.style.color = n > 0 ? '#B42318' : '#1E7A3D'; }
      if (mmark) mmark.style.left = yourXs[ph] + '%';
      const posPh = Math.floor(tk / 3) % 2;
      if (mpos) { mpos.textContent = posPh ? '13% above lowest' : 'Lowest among tracked sellers'; mpos.style.background = posPh ? '#FFF4EC' : '#EAF6EE'; mpos.style.borderColor = posPh ? '#FFD8BE' : '#BFE5CC'; mpos.style.color = posPh ? '#C2410C' : '#1E7A3D'; }
      if (mfetch) mfetch.textContent = '09:' + String(2 + (tk % 50)).padStart(2, '0') + ' AM';
    }
    paintPins(); paint();
    setInterval(() => { tk++; if (pinAuto) pin = (pin + 1) % 6; paintPins(); paint(); }, 1800);

    const setPin = (i: number) => { pin = i; pinAuto = false; paintPins(); };
    pinEls.forEach((el, i) => el.addEventListener('click', () => setPin(i)));
    callEls.forEach((el, i) => el.addEventListener('click', () => setPin(i)));

    qa('[data-pc-faqbtn]').forEach((b) => b.addEventListener('click', () => {
      const item = b.closest('[data-pc-faq]');
      const was = item?.classList.contains('is-open');
      qa('[data-pc-faq]').forEach((el) => { el.classList.remove('is-open'); el.querySelector('[data-pc-faqbtn]')?.setAttribute('aria-expanded', 'false'); });
      if (!was && item) { item.classList.add('is-open'); b.setAttribute('aria-expanded', 'true'); }
    }));

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
      qa('[data-reveal]').forEach((el) => io.observe(el));
    } else { qa('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
  }
</script>

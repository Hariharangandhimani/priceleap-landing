---
import SiteLayout from '@/layouts/SiteLayout.astro';
import FaqItem from '@/components/faq/FaqItem.astro';
import faqData from '@/data/faq.json';

const categories = faqData.categories;
const allItems = categories.flatMap((category) => category.items);
const topicItems = ['All', ...faqData.topics.filter((topic) => topic !== 'All')];
const getTopics = (item: { question: string; shortAnswer: string }) => {
  const text = `${item.question} ${item.shortAnswer}`.toLowerCase();
  const topics: string[] = [];
  if (/repric|rule|automat|velocity|dynamic pric/.test(text)) topics.push('Repricing Strategy');
  if (/amazon|buy box|sp-api|seller central|asin|fba|walmart/.test(text)) topics.push('Amazon Strategy');
  if (/competitor|monitor|intelligence|data collect|marketplace cover/.test(text)) topics.push('Competitive Intelligence');
  if (/margin|cost|floor|profit|fee/.test(text)) topics.push('Margin Management');
  return topics;
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.shortAnswer } })),
};
---

<SiteLayout title="FAQ | PriceLeap pricing intelligence" description="Frequently asked questions about PriceLeap pricing intelligence, repricing, integrations, setup, pricing, and security.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="faq-hero">
    <div class="faq-hero__grid" aria-hidden="true"></div>
    <div class="pl-container faq-hero__inner">
      <span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">Help center</span></span>
      <h1>Frequently asked questions.</h1>
      <p>Everything you need to know about PriceLeap—from how the platform works to pricing, setup, integrations, and security.</p>
      <label class="faq-search"><span class="sr-only">Search questions</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg><input type="search" placeholder="Search questions..." data-faq-search /><span data-faq-count>{allItems.length} answers</span></label>
    </div>
  </section>

  <section class="pl-container faq-page" aria-labelledby="faq-heading">
    <div class="faq-topics" role="tablist" aria-label="Filter questions by topic">
      {topicItems.map((topic, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-faq-topic={topic}>{topic}</button>)}
    </div>

    <div class="faq-layout">
      <aside class="faq-categories" aria-label="FAQ categories">
        <p class="faq-categories__label">Browse by category</p>
        {categories.map((category, index) => <button type="button" class:list={{ 'is-active': index === 0 }} data-faq-category={category.id}><span>{category.label}</span><small>{category.items.length} answers</small></button>)}
      </aside>

      <div class="faq-panel">
        <div class="faq-panel__head"><div><p class="faq-panel__eyebrow" data-faq-panel-label>{categories[0].label}</p><h2 id="faq-heading" data-faq-panel-title>{categories[0].desc}</h2></div><span class="faq-panel__count" data-faq-panel-count>{categories[0].items.length} answers</span></div>
        <div class="faq-list" data-faq-list>
          {allItems.map((item, index) => <FaqItem item={item} topics={getTopics(item)} active={index < categories[0].items.length} />)}
        </div>
        <p class="faq-empty" data-faq-empty hidden>No results found. Try a different search or category.</p>
      </div>
    </div>
  </section>

  <section class="pl-container faq-cta">
    <div><span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">Still have questions?</span></span><h2>Bring your actual catalog.</h2><p>Our team will walk you through the platform with your market, not a generic demo.</p></div>
    <div class="faq-cta__actions"><a class="pl-btn pl-btn--primary pl-btn--lg" href="/book-a-demo">Book a demo <span aria-hidden="true">→</span></a><a class="pl-btn pl-btn--secondary pl-btn--lg" href="/contact">Talk to us</a></div>
  </section>
</SiteLayout>

<script type="application/json" data-faq-categories set:html={JSON.stringify(categories)}></script>

<script>
  const faqItems = [...document.querySelectorAll<HTMLElement>('[data-faq-item]')];
  const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-faq-category]')];
  const topicButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-faq-topic]')];
  const searchInput = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const count = document.querySelector<HTMLElement>('[data-faq-count]');
  const panelLabel = document.querySelector<HTMLElement>('[data-faq-panel-label]');
  const panelTitle = document.querySelector<HTMLElement>('[data-faq-panel-title]');
  const panelCount = document.querySelector<HTMLElement>('[data-faq-panel-count]');
  const empty = document.querySelector<HTMLElement>('[data-faq-empty]');
    const categoryData = JSON.parse(document.querySelector<HTMLScriptElement>('script[data-faq-categories]')?.textContent ?? '[]') as Array<{
      id: string;
      label: string;
      desc: string;
      items: unknown[];
    }>;
  let activeCategory = 'integrations';
  let activeTopic = 'All';

  const render = () => {
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    const searching = Boolean(query) || activeTopic !== 'All';
    let visible = 0;
    faqItems.forEach((item) => {
      const categoryOk = searching || item.dataset.category === activeCategory;
      const searchOk = !query || (item.dataset.search ?? '').includes(query);
      const topicOk = activeTopic === 'All' || (item.dataset.topics ?? '').split('|').includes(activeTopic);
      const show = categoryOk && searchOk && topicOk;
      item.hidden = !show;
      if (show) visible += 1;
    });
    const category = categoryData.find((item) => item.id === activeCategory) ?? categoryData[0];
    if (!searching && category) {
      if (panelLabel) panelLabel.textContent = category.label;
      if (panelTitle) panelTitle.textContent = category.desc;
      if (panelCount) panelCount.textContent = `${category.items.length} answers`;
    } else {
      if (panelLabel) panelLabel.textContent = activeTopic === 'All' ? 'Search results' : activeTopic;
      if (panelTitle) panelTitle.textContent = query ? `Questions matching “${searchInput?.value.trim()}”` : 'Questions across the PriceLeap platform';
      if (panelCount) panelCount.textContent = `${visible} ${visible === 1 ? 'answer' : 'answers'}`;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'answer' : 'answers'}`;
    if (empty) empty.hidden = visible > 0;
  };

  categoryButtons.forEach((button) => button.addEventListener('click', () => {
    activeCategory = button.dataset.faqCategory ?? 'integrations';
    activeTopic = 'All';
      if (searchInput) searchInput.value = '';
    categoryButtons.forEach((item) => item.classList.toggle('is-active', item === button));
    topicButtons.forEach((item) => item.setAttribute('aria-selected', String(item.dataset.faqTopic === 'All')));
    render();
  }));
  topicButtons.forEach((button) => button.addEventListener('click', () => {
    activeTopic = button.dataset.faqTopic ?? 'All';
    categoryButtons.forEach((item) => item.classList.remove('is-active'));
    topicButtons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
    render();
  }));
  searchInput?.addEventListener('input', () => { categoryButtons.forEach((item) => item.classList.remove('is-active')); render(); });
</script>

<style>
  .faq-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--pl-line); background: var(--pl-surface); }
  .faq-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px, transparent 1px), linear-gradient(90deg, var(--pl-line-soft) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 75% 100% at 70% 30%, #000 8%, transparent 78%); opacity: .65; }
  .faq-hero__inner { position: relative; display: flex; flex-direction: column; align-items: center; padding-block: clamp(64px, 9vw, 112px); text-align: center; }
  .faq-hero h1 { margin-top: 22px; color: var(--pl-ink); font-size: clamp(42px, 6vw, 76px); line-height: 1; letter-spacing: -.055em; }
  .faq-hero p { max-width: 660px; margin-top: 22px; color: var(--pl-muted); font-size: 18px; line-height: 1.6; }
  .faq-search { display: flex; align-items: center; gap: 10px; width: min(100%, 620px); margin-top: 32px; border: 1px solid var(--pl-line-strong); border-radius: 12px; background: #fff; padding: 0 15px; text-align: left; box-shadow: var(--pl-shadow-sm); }
  .faq-search svg { width: 19px; flex: none; fill: none; stroke: var(--pl-muted); stroke-width: 1.7; }
  .faq-search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--pl-ink); padding: 15px 0; font: inherit; font-size: 14px; }
  .faq-search > span:last-child { flex: none; color: var(--pl-faint); font-family: var(--pl-mono); font-size: 10px; white-space: nowrap; }
  .faq-page { padding-block: clamp(44px, 7vw, 84px); }
  .faq-topics { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 30px; scrollbar-width: none; }
  .faq-topics button { flex: none; border: 1px solid var(--pl-line); border-radius: 999px; background: var(--pl-surface); color: var(--pl-muted); padding: 9px 14px; font: inherit; font-size: 12px; cursor: pointer; transition: color .2s, background .2s, border-color .2s; }
  .faq-topics button:hover, .faq-topics button[aria-selected='true'] { border-color: var(--pl-ink); background: var(--pl-ink); color: #fff; }
  .faq-layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: clamp(32px, 6vw, 84px); }
  .faq-categories { align-self: start; position: sticky; top: 100px; }
  .faq-categories__label { margin-bottom: 12px; color: var(--pl-faint); font-family: var(--pl-mono); font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .faq-categories button { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 12px; border: 0; border-left: 2px solid transparent; background: transparent; color: var(--pl-muted); padding: 13px 12px; text-align: left; font: inherit; font-size: 13px; cursor: pointer; }
  .faq-categories button:hover, .faq-categories button.is-active { border-left-color: var(--pl-accent); background: var(--pl-accent-tint); color: var(--pl-ink); }
  .faq-categories small { color: var(--pl-faint); font-family: var(--pl-mono); font-size: 10px; white-space: nowrap; }
  .faq-panel__head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .faq-panel__eyebrow { color: var(--pl-accent-ink); font-family: var(--pl-mono); font-size: 10px; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; }
  .faq-panel__head h2 { max-width: 620px; margin-top: 10px; color: var(--pl-ink); font-size: clamp(24px, 3vw, 34px); line-height: 1.12; letter-spacing: -.035em; }
  .faq-panel__count { flex: none; color: var(--pl-faint); font-family: var(--pl-mono); font-size: 10px; }
  .faq-list { border-top: 1px solid var(--pl-line); }
  .faq-list [hidden] { display: none; }
  .faq-empty { padding: 48px 0; color: var(--pl-muted); text-align: center; }
  .faq-cta { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-bottom: 72px; border-radius: var(--pl-radius-xl); background: var(--pl-ink); padding: clamp(28px, 5vw, 56px); color: #fff; }
  .faq-cta .pl-eyebrow { color: #fff; }
  .faq-cta h2 { margin-top: 15px; color: #fff; font-size: clamp(28px, 4vw, 52px); letter-spacing: -.045em; }
  .faq-cta p { margin-top: 10px; color: rgba(255,255,255,.65); font-size: 15px; }
  .faq-cta__actions { display: flex; flex: none; flex-wrap: wrap; gap: 10px; }
  .faq-cta .pl-btn--secondary { border-color: rgba(255,255,255,.28); background: transparent; color: #fff; }
  .faq-cta .pl-btn--secondary:hover { border-color: #fff; }
  @media (max-width: 820px) { .faq-layout { grid-template-columns: 1fr; } .faq-categories { position: static; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; } .faq-categories__label { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .faq-panel__head, .faq-cta { align-items: flex-start; flex-direction: column; } .faq-categories { grid-template-columns: 1fr; } .faq-cta__actions, .faq-cta__actions .pl-btn { width: 100%; } }
</style>

---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';
import faqData from '../data/faq.json';

type Item = { slug: string; question: string; shortAnswer: string; categoryId: string; categoryLabel: string; categoryDescription: string };
type Category = { id: string; label: string; desc: string; items: Item[] };

const categories = faqData.categories as Category[];
const allItems = categories.flatMap((c) => c.items);
const total = allItems.length;

const catIcon: Record<string, string> = {
  integrations: 'integrations', platform: 'engine', pricing: 'optimize', onboarding: 'decision', data: 'shield',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.shortAnswer } })),
};
const jsonLd = [faqSchema];
---
<PriceLeapLayout
  title="FAQ · PriceLeap"
  description="Answers to common questions about PriceLeap pricing intelligence — integrations, platform, pricing, onboarding and security."
  jsonLd={jsonLd}
>
  <section class="fq-hero" data-screen-label="Hero">
    <div aria-hidden="true" class="fq-hero-grid"></div>
    <div aria-hidden="true" class="fq-hero-glow"></div>
    <div class="fq-hero-inner">
      <span class="fq-badge"><span class="fq-badge-dot"></span>FAQ · {total} ANSWERS</span>
      <h1 class="fq-h1"><span style="font-weight:400">Frequently asked </span><span style="font-weight:700">questions.</span></h1>
      <p class="fq-lead">Everything about integrations, the platform, pricing, onboarding and security — in one place. Can't find it? <a href="/contact">Ask our team</a>.</p>
      <div role="search" class="fq-search">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#7F7066" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input type="search" placeholder="Search questions, e.g. Amazon" aria-label="Search FAQ" data-fq-search />
      </div>
    </div>
  </section>

  <section class="fq-body" data-screen-label="FAQ">
    <div class="fq-layout">
      <aside class="fq-cats" aria-label="Categories">
        <button type="button" class="fq-cat is-on" data-fq-cat="all" aria-selected="true">
          <span class="fq-cat-ico"><img src="/assets/icons/data.svg" alt="" width="18" height="18" /></span>
          <span class="fq-cat-txt"><span class="fq-cat-label">All questions</span><span class="fq-cat-n">{total} answers</span></span>
        </button>
        {categories.map((c) => (
          <button type="button" class="fq-cat" data-fq-cat={c.id} aria-selected="false">
            <span class="fq-cat-ico"><img src={`/assets/icons/${catIcon[c.id] || 'engine'}.svg`} alt="" width="18" height="18" /></span>
            <span class="fq-cat-txt"><span class="fq-cat-label">{c.label}</span><span class="fq-cat-n">{c.items.length} answers</span></span>
          </button>
        ))}
        <div class="fq-help">
          <span class="fq-help-t">Still have a question?</span>
          <a href="/contact" class="fq-help-link">Talk to our team →</a>
        </div>
      </aside>

      <div class="fq-panel">
        {categories.map((c) => (
          <div class="fq-group" data-fq-group={c.id}>
            <div class="fq-group-head" id={`cat-${c.id}`}>
              <h2 class="fq-group-title">{c.label}</h2>
              <p class="fq-group-desc">{c.desc}</p>
            </div>
            <div class="fq-list">
              {c.items.map((item, i) => (
                <div class="fq-item" data-fq-item data-text={`${item.question} ${item.shortAnswer}`.toLowerCase()}>
                  <button type="button" class="fq-q" aria-expanded="false" data-fq-btn>
                    <span class="fq-n">{String(i + 1).padStart(2, '0')}</span>
                    <span class="fq-qt">{item.question}</span>
                    <span class="fq-plus"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg></span>
                  </button>
                  <div class="fq-answer"><div class="fq-answer-inner"><p>{item.shortAnswer}</p></div></div>
                </div>
              ))}
            </div>
          </div>
        ))}
        <div class="fq-empty" data-fq-empty hidden>
          <span class="fq-empty-ico">∅</span>
          <span class="fq-empty-t">No questions match your search</span>
          <button type="button" class="fq-empty-reset" data-fq-reset>Clear search</button>
        </div>
      </div>
    </div>
  </section>

  <section class="fq-cta" data-screen-label="CTA">
    <div class="fq-cta-card">
      <div aria-hidden="true" class="fq-cta-dots"></div>
      <div class="fq-cta-left">
        <span class="fq-cta-eyebrow"><span class="fq-diamond"></span>STILL CURIOUS?</span>
        <h2 class="fq-cta-h2"><span style="font-weight:400">See PriceLeap </span><span style="font-weight:700">on your own catalog.</span></h2>
        <p class="fq-cta-p">A 20-minute demo with live competitor prices on your SKUs answers more than any FAQ.</p>
        <div class="fq-cta-btns"><a href="/book-a-demo" class="fq-btn-primary">Book a demo</a><a href="/contact" class="fq-btn-ghost">Talk to an expert</a></div>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .fq-diamond { width: 6px; height: 6px; border-radius: 2px; background: var(--pl-accent); transform: rotate(45deg); }

  .fq-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
  .fq-hero-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px); background-size: 48px 48px; -webkit-mask-image: radial-gradient(ellipse 70% 90% at 50% 0%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 70% 90% at 50% 0%,#000 10%,transparent 70%); }
  .fq-hero-glow { position: absolute; left: 50%; top: -260px; width: 820px; height: 520px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(251,138,46,.12),transparent); }
  .fq-hero-inner { position: relative; max-width: 1280px; margin: 0 auto; padding: clamp(48px,7vw,88px) clamp(16px,4vw,40px) clamp(40px,5vw,56px); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fq-badge { height: 28px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: .1em; color: var(--pl-ink-2); }
  .fq-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--pl-accent); animation: plpulse 1.8s infinite; }
  .fq-h1 { margin: 20px 0 0; font-family: Geist, sans-serif; font-size: clamp(38px,6vw,72px); line-height: 1.02; letter-spacing: -.045em; color: var(--pl-ink); text-wrap: balance; }
  .fq-lead { margin: 18px 0 0; max-width: 620px; font-size: clamp(16px,1.6vw,18px); line-height: 1.6; color: var(--pl-ink-2); text-wrap: pretty; }
  .fq-lead a { color: var(--pl-accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  .fq-search { margin-top: 28px; width: min(100%,560px); display: flex; align-items: center; gap: 10px; background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 14px; padding: 6px 16px; box-shadow: 0 20px 40px -30px rgba(60,30,15,.4); transition: border-color .2s, box-shadow .2s; }
  .fq-search:focus-within { border-color: var(--pl-accent-line); box-shadow: 0 0 0 4px rgba(247,99,30,.12); }
  .fq-search input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; font-size: 15px; color: var(--pl-ink); padding: 10px 0; }

  .fq-body { border-bottom: 1px solid var(--pl-line); }
  .fq-layout { max-width: 1280px; margin: 0 auto; padding: clamp(40px,5vw,64px) clamp(16px,4vw,40px); display: grid; grid-template-columns: 1fr; gap: clamp(24px,3vw,40px); align-items: start; }
  .fq-cats { display: flex; flex-direction: column; gap: 4px; }
  .fq-cat { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; border: 1px solid transparent; background: transparent; cursor: pointer; text-align: left; transition: all .2s; }
  .fq-cat:hover { background: var(--pl-cream); }
  .fq-cat.is-on { background: var(--pl-surface); border-color: var(--pl-accent-line); box-shadow: 0 10px 24px -18px rgba(194,65,12,.5); }
  .fq-cat-ico { width: 38px; height: 38px; flex: none; border-radius: 11px; background: var(--pl-cream); border: 1px solid var(--pl-line-soft); display: flex; align-items: center; justify-content: center; transition: all .2s; }
  .fq-cat.is-on .fq-cat-ico { background: var(--pl-accent-tint); border-color: var(--pl-accent-line); }
  .fq-cat-label { display: block; font-family: Geist, sans-serif; font-size: 15px; font-weight: 600; color: var(--pl-ink); }
  .fq-cat-n { display: block; font-family: 'Geist Mono', monospace; font-size: 10.5px; color: var(--pl-faint); margin-top: 1px; }
  .fq-help { margin-top: 12px; padding: 18px; border-radius: 16px; background: var(--pl-cream); border: 1px solid var(--pl-line); display: flex; flex-direction: column; gap: 8px; }
  .fq-help-t { font-size: 14.5px; font-weight: 600; color: var(--pl-ink); }
  .fq-help-link { font-size: 13.5px; font-weight: 500; color: var(--pl-accent-ink); }

  .fq-panel { min-width: 0; }
  .fq-group { margin-bottom: 36px; scroll-margin-top: 90px; }
  .fq-group:last-of-type { margin-bottom: 0; }
  .fq-group-head { margin-bottom: 16px; }
  .fq-group-title { margin: 0; font-family: Geist, sans-serif; font-size: clamp(22px,2.6vw,28px); font-weight: 600; letter-spacing: -.025em; color: var(--pl-ink); }
  .fq-group-desc { margin: 6px 0 0; font-size: 14.5px; line-height: 1.55; color: var(--pl-muted); }
  .fq-list { display: flex; flex-direction: column; gap: 10px; }
  .fq-item { background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 16px; overflow: hidden; transition: border-color .25s, box-shadow .25s; }
  .fq-item.is-open { border-color: var(--pl-accent-line); box-shadow: 0 18px 36px -28px rgba(194,65,12,.5); }
  .fq-q { width: 100%; border: none; background: transparent; cursor: pointer; display: flex; align-items: center; gap: 16px; padding: 20px 22px; text-align: left; }
  .fq-n { font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-faint); }
  .fq-item.is-open .fq-n { color: var(--pl-accent-ink); }
  .fq-qt { flex: 1; font-family: Geist, sans-serif; font-size: 16.5px; font-weight: 500; color: var(--pl-ink); }
  .fq-plus { flex: none; width: 30px; height: 30px; border-radius: 9px; background: var(--pl-sand); color: var(--pl-ink); display: flex; align-items: center; justify-content: center; transition: transform .3s, background .3s, color .3s; }
  .fq-item.is-open .fq-plus { background: var(--pl-gradient); color: var(--pl-surface); transform: rotate(45deg); }
  .fq-answer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; }
  .fq-item.is-open .fq-answer { grid-template-rows: 1fr; }
  .fq-answer-inner { overflow: hidden; }
  .fq-answer-inner p { margin: 0; padding: 0 22px 22px 58px; font-size: 15px; line-height: 1.7; color: var(--pl-ink-2); }

  .fq-empty { background: var(--pl-surface); border: 1px dashed var(--pl-line-strong); border-radius: 20px; padding: 48px 20px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .fq-empty-ico { width: 48px; height: 48px; border-radius: 14px; background: var(--pl-sand); display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--pl-faint); }
  .fq-empty-t { font-family: Geist, sans-serif; font-size: 18px; font-weight: 600; color: var(--pl-ink); }
  .fq-empty-reset { margin-top: 6px; height: 40px; padding: 0 16px; border-radius: 10px; border: 1px solid var(--pl-line); background: var(--pl-surface); cursor: pointer; font-size: 14px; color: var(--pl-ink); }

  .fq-cta { max-width: 1280px; margin: 0 auto; padding: clamp(56px,7vw,96px) clamp(16px,4vw,40px) clamp(40px,5vw,64px); }
  .fq-cta-card { position: relative; overflow: hidden; background: var(--pl-surface); border: 1px solid var(--pl-line); border-radius: 26px; }
  .fq-cta-dots { position: absolute; inset: 0; background-image: radial-gradient(var(--pl-line) 1px,transparent 1px); background-size: 16px 16px; -webkit-mask-image: linear-gradient(135deg,transparent 40%,#000); mask-image: linear-gradient(135deg,transparent 40%,#000); }
  .fq-cta-left { position: relative; padding: clamp(28px,4vw,48px); display: flex; flex-direction: column; gap: 14px; }
  .fq-cta-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .12em; color: var(--pl-accent-ink); }
  .fq-cta-h2 { margin: 0; font-family: Geist, sans-serif; font-size: clamp(26px,3.4vw,40px); line-height: 1.08; letter-spacing: -.035em; color: var(--pl-ink); text-wrap: balance; }
  .fq-cta-p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--pl-ink-2); max-width: 460px; }
  .fq-cta-btns { margin-top: 6px; display: flex; gap: 10px; flex-wrap: wrap; }
  .fq-btn-primary { height: 48px; padding: 0 20px; display: inline-flex; align-items: center; border-radius: 12px; background: var(--pl-gradient); color: var(--pl-surface); font-size: 15px; font-weight: 500; box-shadow: 0 12px 24px -12px rgba(247,99,30,.85); }
  .fq-btn-primary:hover { filter: brightness(.95); color: var(--pl-surface); }
  .fq-btn-ghost { height: 48px; padding: 0 20px; display: inline-flex; align-items: center; border-radius: 12px; border: 1px solid var(--pl-line); background: var(--pl-surface); color: var(--pl-ink); font-size: 15px; font-weight: 500; }

  @media (min-width: 900px) {
    .fq-layout { grid-template-columns: 280px minmax(0,1fr); }
    .fq-cats { position: sticky; top: 88px; }
  }
</style>

<script>
  const search = document.querySelector('[data-fq-search]') as HTMLInputElement | null;
  const cats = Array.from(document.querySelectorAll('[data-fq-cat]')) as HTMLElement[];
  const groups = Array.from(document.querySelectorAll('[data-fq-group]')) as HTMLElement[];
  const items = Array.from(document.querySelectorAll('[data-fq-item]')) as HTMLElement[];
  const empty = document.querySelector('[data-fq-empty]') as HTMLElement | null;
  let activeCat = 'all';

  // Accordion
  document.querySelectorAll('[data-fq-btn]').forEach((btn) => btn.addEventListener('click', () => {
    const item = btn.closest('[data-fq-item]');
    const open = item?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(!!open));
  }));

  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    items.forEach((it) => {
      const g = it.closest('[data-fq-group]') as HTMLElement;
      const matchCat = activeCat === 'all' || g?.dataset.fqGroup === activeCat;
      const matchQ = !q || (it.dataset.text || '').includes(q);
      const show = matchCat && matchQ;
      it.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    groups.forEach((g) => {
      const any = Array.from(g.querySelectorAll('[data-fq-item]')).some((it) => (it as HTMLElement).style.display !== 'none');
      g.style.display = any ? '' : 'none';
    });
    if (empty) empty.hidden = visible > 0;
  };

  search?.addEventListener('input', apply);
  cats.forEach((c) => c.addEventListener('click', () => {
    activeCat = c.dataset.fqCat || 'all';
    cats.forEach((o) => { o.classList.toggle('is-on', o === c); o.setAttribute('aria-selected', String(o === c)); });
    apply();
  }));
  document.querySelector('[data-fq-reset]')?.addEventListener('click', () => { if (search) search.value = ''; apply(); });
</script>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pill from '@/components/ui/Pill.astro';
import Accordion from '@/components/ui/Accordion.astro';
import DemoForm from '@/components/demo/DemoForm.astro';
import TrustStrip from '@/components/home/TrustStrip.astro';
import Button from '@/components/ui/Button.astro';
import { demoBenefits, demoSample, agenda, demoFaqs } from '@/data/demo';
---
<BaseLayout title="Book a demo | PriceLeap Pricing Intelligence" description="See PriceLeap running on your products and competitors in a 15-minute demo. Free competitor price sample included.">
  <section class="dh">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="container dh__grid">
      <div class="dh__head">
        <Pill>15-minute live demo</Pill>
        <h1><span class="light">See your real competitor data — </span><span class="bold accent">before you buy.</span></h1>
        <p class="lede">We'll run PriceLeap on your products and competitors, live. You leave with a free price-gap sample — whether you sign up or not.</p>
      </div>
      <div id="book" class="dh__form"><DemoForm /><p class="dh__privacy">We'll never share your data. <a href="#">Privacy policy</a></p></div>
      <div class="dh__rest">
        <ul class="dh__benefits">{demoBenefits.map((b) => <li><span>✓</span><p><b>{b.t}</b> {b.d}</p></li>)}</ul>
        <div class="dh__sample" aria-hidden="true">
          <div class="dh__sample-bar"><img src="/assets/mark.png" alt="" width="14" height="13" /><span>Your free price-gap sample</span><span class="mono accent">PREVIEW</span></div>
          <div class="dh__kpis"><div><small class="mono">PRICE INDEX</small><b class="mono accent">96.4</b></div><div><small class="mono">OVERPRICED</small><b class="mono" style="color:var(--red)">18 SKUs</b></div><div><small class="mono">MARGIN LEFT</small><b class="mono">₹4.2L</b></div></div>
          {demoSample.map((r) => <div class="dh__srow"><span>{r.n}</span><span class="mono">{r.p}</span><span class="mono" style={`color:${r.c}`}>{r.g}</span></div>)}
        </div>
      </div>
    </div>
  </section>
  <TrustStrip />
  <section class="container section">
    <div class="eyebrow">Your 15 minutes</div>
    <h2 class="h2" style="margin-top:14px;font-size:clamp(30px,4vw,48px)">No slides. Just your market, live.</h2>
    <div class="dh__agenda">{agenda.map((g) => <div class="card"><div class="dh__ag-top"><span class="icon-tile"><img src={g.icon} alt="" width="22" height="22" /></span><span class="mono">{g.time}</span></div><h3 class="h3">{g.t}</h3><p>{g.d}</p></div>)}</div>
  </section>
  <section class="container section dh__faq">
    <h2 class="h2" style="text-align:center;font-size:clamp(28px,3.6vw,42px)">Questions before you book</h2>
    <div style="margin-top:32px"><Accordion items={demoFaqs} /></div>
    <div style="margin-top:40px;display:flex;justify-content:center"><Button href="#book" size="lg">Book my 15-minute demo →</Button></div>
  </section>
  <div class="dh__bar" data-sticky-cta><div><b>15-min live demo</b><span>Free competitor sample</span></div><a href="#book">Book now →</a></div>
  <script>
    const bar = document.querySelector<HTMLElement>('[data-sticky-cta]'); const form = document.getElementById('book');
    if (bar && form && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => bar.classList.toggle('is-on', !e.isIntersecting), { threshold: 0.15 }).observe(form);
  </script>
</BaseLayout>
<style>
  .dh { position: relative; }
  .dh__grid { position: relative; padding-block: clamp(32px, 6vw, 72px) clamp(48px, 7vw, 96px); display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "form" "rest"; gap: 28px clamp(32px, 5vw, 72px); align-items: start; }
  @media (min-width: 900px) { .dh__grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); grid-template-areas: "head form" "rest form"; } .dh__form { position: sticky; top: 84px; } }
  .dh__head { grid-area: head; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; } .dh__form { grid-area: form; scroll-margin-top: 84px; } .dh__rest { grid-area: rest; display: flex; flex-direction: column; gap: 28px; }
  h1 { font-size: clamp(38px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -.045em; text-wrap: balance; }
  .dh__privacy { margin-top: 12px; text-align: center; font-size: 12px; color: var(--dim); } .dh__privacy a { color: var(--muted); }
  .dh__benefits { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; } .dh__benefits li { display: flex; gap: 14px; } .dh__benefits li > span { width: 26px; height: 26px; flex: none; border-radius: 8px; background: var(--green-deep); border: 1px solid var(--green-dark); color: var(--green); font-size: 12px; font-weight: 700; display: grid; place-items: center; }
  .dh__benefits p { font-size: 16px; line-height: 1.5; } .dh__benefits b { color: var(--white); font-weight: 500; }
  .dh__sample { border: 1px solid var(--line); border-radius: 18px; background: var(--surface-3); overflow: hidden; }
  .dh__sample-bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line-soft); background: var(--surface-4); font-size: 12.5px; color: var(--white); } .dh__sample-bar .mono { margin-left: auto; font-size: 10px; letter-spacing: .08em; }
  .dh__kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--line-soft); } .dh__kpis div { padding: 14px 16px; } .dh__kpis div + div { border-left: 1px solid var(--line-soft); }
  .dh__kpis small { font-size: 9.5px; letter-spacing: .1em; color: var(--muted); } .dh__kpis b { display: block; margin-top: 4px; font-size: 20px; font-weight: 400; color: var(--white); }
  .dh__srow { display: grid; grid-template-columns: minmax(0, 1.6fr) 1fr 1fr; gap: 10px; padding: 11px 16px; font-size: 13px; color: var(--white); } .dh__srow + .dh__srow { border-top: 1px solid var(--line-soft); } .dh__srow .mono { text-align: right; font-size: 12px; }
  .dh__srow span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dh__agenda { margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; } .dh__agenda .card { padding: 24px; display: flex; flex-direction: column; gap: 14px; } .dh__agenda p { font-size: 15px; line-height: 1.55; }
  .dh__ag-top { display: flex; justify-content: space-between; align-items: center; } .dh__ag-top .mono { font-size: 11px; color: var(--dim); }
  .dh__faq { max-width: 880px; padding-bottom: var(--section-y); }
  .dh__bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(10,10,10,.92); backdrop-filter: blur(14px); border-top: 1px solid var(--line); display: none; align-items: center; gap: 12px; }
  .dh__bar b { display: block; font-size: 14px; color: var(--white); } .dh__bar span { font-size: 12px; color: var(--muted); } .dh__bar > div { flex: 1; }
  .dh__bar a { height: 48px; padding: 0 20px; border-radius: 12px; background: var(--green); color: var(--bg); font-family: var(--font-display); font-weight: 600; font-size: 15px; display: flex; align-items: center; }
  @media (max-width: 899px) { .dh__bar.is-on { display: flex; } }
</style>

---
import PriceLeapLayout from '../layouts/PriceLeapLayout.astro';

const routes = [
  { id: 'demo', t: 'See a product demo', d: 'Walk through PriceLeap on your own catalog with a specialist.', who: 'a pricing strategist', shape: '4px', rot: '0' },
  { id: 'technical', t: 'Technical / API question', d: 'Integrations, data feeds, security and implementation.', who: 'a technical specialist', shape: '2px', rot: '45' },
  { id: 'sales', t: 'Enterprise & pricing', d: 'Plans, procurement and enterprise rollout.', who: 'our sales team', shape: '50%', rot: '0' },
];

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact PriceLeap',
  url: 'https://priceleap.ai/contact',
}];
---
<PriceLeapLayout title="Contact · PriceLeap" description="Talk to the PriceLeap team about competitor price tracking, pricing intelligence and dynamic pricing for your catalog." jsonLd={jsonLd}>
  <section class="ct" data-screen-label="Contact">
    <div aria-hidden="true" class="ct-grid"></div>
    <div aria-hidden="true" class="ct-glow"></div>
    <div class="ct-inner">
      <div class="ct-head">
        <span class="ct-badge"><span class="ct-badge-dot"></span>Contact</span>
        <h1 class="ct-h1"><span style="font-weight:400">Let's talk </span><span style="font-weight:700">pricing.</span></h1>
        <p class="ct-lead">Whether you're evaluating PriceLeap for the first time or ready to scale your catalog — our team is ready to walk you through it.</p>
        <div class="ct-strip">
          <span class="ct-strip-item"><span class="ct-badge-dot"></span>Avg. response under 4 hours</span>
          <a href="mailto:sales_team@priceleap.ai" class="ct-strip-mail">✉ sales_team@priceleap.ai</a>
        </div>
      </div>

      <div class="ct-card">
        <div class="ct-left">
          <div>
            <span class="ct-mono">01 · Who do you need?</span>
            <p class="ct-left-p">We'll match you with the right person — whether that's a pricing strategist, a technical specialist, or our sales team.</p>
          </div>
          <div role="radiogroup" aria-label="Who do you need" class="ct-routes">
            {routes.map((r, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} class={`ct-route${i === 0 ? ' is-on' : ''}`} data-route={r.id} data-who={r.who}>
                <span class="ct-route-ico"><span class="ct-route-dot" style={`border-radius:${r.shape};transform:rotate(${r.rot}deg)`}></span></span>
                <span><span class="ct-route-t">{r.t}</span><span class="ct-route-d">{r.d}</span></span>
                <span class="ct-route-radio"></span>
              </button>
            ))}
          </div>
          <div class="ct-match">
            <span class="ct-match-ava"><span class="ct-match-a1"></span><span class="ct-match-a2"><img src="/assets/pl-mark.png" alt="" width="14" height="13" /></span></span>
            <span class="ct-match-txt">You'll be matched with <b data-who-label>a pricing strategist</b></span>
          </div>
          <div class="ct-info">
            <div class="ct-info-row">
              <span class="ct-info-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2"><path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span>
              <span><span class="ct-info-k">Headquarters</span><span class="ct-info-v">Manhattan, New York</span><span class="ct-info-s">80 Broad St, 5th Floor PMB#1148, NY</span></span>
            </div>
            <div class="ct-info-row">
              <span class="ct-info-ico"><span class="ct-dot-live"></span></span>
              <span><span class="ct-info-k">Business Hours</span><span class="ct-info-v">Mon–Fri, 8am–6pm PT</span><span class="ct-info-s">Enterprise SLA customers receive 24/7 monitoring alerts.</span></span>
            </div>
          </div>
        </div>

        <div class="ct-right">
          <div class="ct-progress"><div class="ct-progress-fill" data-progress></div></div>
          <form class="ct-form" novalidate data-form>
            <div class="ct-form-head">
              <div><span class="ct-mono">02 · Tell us about you</span><h2 class="ct-form-h2">Contact Us</h2></div>
              <span class="ct-complete" data-complete>0 / 7 complete</span>
            </div>
            <p class="ct-form-p">Fill in the form and we'll match you with the right person — a pricing strategist, a technical specialist, or our sales team.</p>
            <div class="ct-pair">
              <label class="ct-field"><span class="ct-label">First Name</span><input name="first" autocomplete="given-name" placeholder="Alex" required /><span class="ct-err"></span></label>
              <label class="ct-field"><span class="ct-label">Last Name</span><input name="last" autocomplete="family-name" placeholder="Johnson" required /><span class="ct-err"></span></label>
              <label class="ct-field"><span class="ct-label">Work Email</span><input name="email" type="email" autocomplete="email" placeholder="alex@company.com" required /><span class="ct-err"></span></label>
              <label class="ct-field"><span class="ct-label">Company</span><input name="company" autocomplete="organization" placeholder="Acme Corp" required /><span class="ct-err"></span></label>
              <label class="ct-field"><span class="ct-label">Catalog Size (SKUs)</span><span class="ct-select"><select name="size" required><option value="">Select range</option><option>Under 1,000</option><option>1,000 – 10,000</option><option>10,000 – 50,000</option><option>50,000+</option></select><span class="ct-caret">▾</span></span><span class="ct-err"></span></label>
              <label class="ct-field"><span class="ct-label">Inquiry Type</span><span class="ct-select"><select name="type" required><option value="">What can we help with?</option><option>Book a demo</option><option>Pricing &amp; plans</option><option>Enterprise sales</option><option>Technical support</option><option>Partnerships</option><option>Other</option></select><span class="ct-caret">▾</span></span><span class="ct-err"></span></label>
            </div>
            <label class="ct-field"><span class="ct-label ct-label-row"><span>Message</span><span class="ct-count" data-msglen>0 chars</span></span><textarea name="msg" rows="5" placeholder="Tell us about your pricing challenges, catalog size, marketplaces you compete on, or anything else that helps us prepare..." required></textarea><span class="ct-err"></span></label>
            <div class="ct-alert" role="alert" data-alert hidden>Please fix the highlighted fields.</div>
            <div class="ct-submit-row">
              <button type="submit" class="ct-submit">Send message</button>
              <p class="ct-consent">By submitting, you agree to our <a href="/privacy-policy">Privacy Policy</a>. We never share your data with third parties.</p>
            </div>
          </form>
          <div class="ct-success" data-success hidden>
            <span class="ct-success-ico">✓</span>
            <h2 class="ct-success-h2">Thanks, <span data-success-name>there</span>.</h2>
            <p class="ct-success-p">We'll match you with <b data-success-who>a pricing strategist</b> and reply to <b data-success-email>your inbox</b> — on average in under 4 hours.</p>
            <button type="button" class="ct-success-again" data-reset>Send another message</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</PriceLeapLayout>

<style>
  .ct { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
  .ct-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--pl-line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--pl-line-soft) 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 0%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 70% 55% at 50% 0%,#000 10%,transparent 70%); pointer-events: none; }
  .ct-glow { position: absolute; left: 50%; top: 260px; width: 1200px; height: 700px; transform: translateX(-50%); background: radial-gradient(closest-side,rgba(247,99,30,.12),transparent); pointer-events: none; }
  .ct-inner { position: relative; max-width: 1280px; margin: 0 auto; padding: clamp(48px,7vw,88px) clamp(20px,4vw,40px) clamp(56px,7vw,96px); }
  .ct-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ct-badge { height: 30px; padding: 0 12px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; background: var(--pl-surface); border: 1px solid var(--pl-line); font-family: 'Geist Mono', monospace; font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-accent-ink); }
  .ct-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--pl-gradient); animation: plpulse 1.8s infinite; }
  .ct-h1 { margin: 20px 0 0; font-family: Geist, sans-serif; font-size: clamp(44px,6.4vw,84px); line-height: .98; letter-spacing: -.05em; color: var(--pl-ink); }
  .ct-lead { margin: 20px 0 0; max-width: 620px; font-size: 18px; line-height: 1.6; color: var(--pl-ink-2); text-wrap: pretty; }
  .ct-strip { margin-top: 24px; display: flex; flex-wrap: wrap; justify-content: center; border: 1px solid var(--pl-line); border-radius: 12px; background: var(--pl-surface); overflow: hidden; }
  .ct-strip-item { height: 40px; padding: 0 16px; display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--pl-ink); border-right: 1px solid var(--pl-line-soft); }
  .ct-strip-mail { height: 40px; padding: 0 16px; display: flex; align-items: center; gap: 8px; font-family: 'Geist Mono', monospace; font-size: 12.5px; color: var(--pl-ink); }
  .ct-strip-mail:hover { color: var(--pl-accent-ink); }

  .ct-card { margin-top: clamp(40px,5vw,64px); border: 1px solid var(--pl-line); border-radius: 28px; overflow: hidden; background: var(--pl-line); display: grid; grid-template-columns: 1fr; gap: 1px; box-shadow: 0 50px 100px -60px rgba(60,30,15,.35); }
  .ct-left { background: var(--pl-cream); padding: clamp(22px,3vw,36px); display: flex; flex-direction: column; gap: 20px; }
  .ct-mono { font-family: 'Geist Mono', monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--pl-muted); }
  .ct-left-p { margin: 8px 0 0; font-size: 14.5px; line-height: 1.55; color: var(--pl-muted); }
  .ct-routes { display: flex; flex-direction: column; gap: 10px; }
  .ct-route { text-align: left; cursor: pointer; background: var(--pl-surface); border: 1.5px solid var(--pl-line); border-radius: 16px; padding: 16px; display: grid; grid-template-columns: 40px minmax(0,1fr) 22px; gap: 14px; align-items: start; transition: all .25s; }
  .ct-route.is-on { border-color: var(--pl-accent); box-shadow: 0 0 0 4px rgba(247,99,30,.12); }
  .ct-route-ico { width: 40px; height: 40px; border-radius: 11px; background: var(--pl-sand); border: 1px solid var(--pl-line); display: flex; align-items: center; justify-content: center; transition: all .25s; }
  .ct-route.is-on .ct-route-ico { background: var(--pl-accent-tint); border-color: var(--pl-accent-line); }
  .ct-route-dot { width: 12px; height: 12px; background: var(--pl-line-xstrong); }
  .ct-route.is-on .ct-route-dot { background: var(--pl-gradient); }
  .ct-route-t { display: block; font-family: Geist, sans-serif; font-size: 16px; font-weight: 600; color: var(--pl-ink); }
  .ct-route-d { display: block; margin-top: 4px; font-size: 13.5px; line-height: 1.5; color: var(--pl-muted); }
  .ct-route-radio { width: 20px; height: 20px; margin-top: 2px; border-radius: 50%; border: 2px solid var(--pl-line-xstrong); background: var(--pl-surface); transition: all .2s; }
  .ct-route.is-on .ct-route-radio { border-color: var(--pl-accent); border-width: 6px; }
  .ct-match { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: var(--pl-surface); border: 1px dashed var(--pl-accent-line); }
  .ct-match-ava { display: flex; }
  .ct-match-a1 { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--pl-surface); background: repeating-linear-gradient(135deg,var(--pl-accent-tint) 0 4px,var(--pl-cream) 4px 8px); box-shadow: 0 0 0 1px var(--pl-accent-line); }
  .ct-match-a2 { width: 30px; height: 30px; margin-left: -10px; border-radius: 50%; border: 2px solid var(--pl-surface); background: var(--pl-gradient); display: flex; align-items: center; justify-content: center; }
  .ct-match-txt { font-size: 13.5px; line-height: 1.45; color: var(--pl-ink-2); }
  .ct-match-txt b { color: var(--pl-ink); }
  .ct-info { margin-top: auto; border-top: 1px solid var(--pl-line); padding-top: 18px; display: flex; flex-direction: column; gap: 14px; }
  .ct-info-row { display: grid; grid-template-columns: 32px minmax(0,1fr); gap: 12px; }
  .ct-info-ico { width: 32px; height: 32px; border-radius: 9px; border: 1px solid var(--pl-line); background: var(--pl-surface); display: flex; align-items: center; justify-content: center; }
  .ct-dot-live { width: 8px; height: 8px; border-radius: 50%; background: var(--pl-accent); animation: plpulse 1.8s infinite; }
  .ct-info-k { display: block; font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--pl-muted); }
  .ct-info-v { display: block; margin-top: 2px; font-size: 14.5px; font-weight: 600; color: var(--pl-ink); }
  .ct-info-s { display: block; font-size: 13.5px; color: var(--pl-muted); }

  .ct-right { background: var(--pl-surface); position: relative; }
  .ct-progress { height: 4px; background: var(--pl-line-soft); }
  .ct-progress-fill { height: 100%; width: 0; background: var(--pl-gradient); transition: width .4s cubic-bezier(.2,.7,.2,1); }
  .ct-form { padding: clamp(22px,3vw,40px); display: flex; flex-direction: column; gap: 18px; }
  .ct-form-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
  .ct-form-h2 { margin: 6px 0 0; font-family: Geist, sans-serif; font-size: 28px; font-weight: 600; letter-spacing: -.03em; color: var(--pl-ink); }
  .ct-complete { height: 26px; padding: 0 10px; display: flex; align-items: center; border-radius: 999px; background: var(--pl-sand); font-family: 'Geist Mono', monospace; font-size: 11px; color: var(--pl-ink-2); }
  .ct-form-p { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--pl-muted); }
  .ct-pair { display: grid; grid-template-columns: 1fr; gap: 14px 16px; }
  .ct-field { display: flex; flex-direction: column; gap: 6px; }
  .ct-label { font-size: 13px; font-weight: 500; color: var(--pl-ink); }
  .ct-label-row { display: flex; justify-content: space-between; }
  .ct-count { font-family: 'Geist Mono', monospace; font-size: 11px; font-weight: 400; color: var(--pl-faint); }
  .ct-field input, .ct-field select, .ct-field textarea { height: 48px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--pl-line); background: var(--pl-surface); font-size: 15px; color: var(--pl-ink); outline: none; transition: border-color .2s, box-shadow .2s; }
  .ct-field textarea { height: auto; padding: 12px 14px; line-height: 1.55; resize: vertical; min-height: 130px; }
  .ct-field input:focus, .ct-field select:focus, .ct-field textarea:focus { border-color: var(--pl-accent); box-shadow: 0 0 0 4px rgba(247,99,30,.15); }
  .ct-field.is-invalid input, .ct-field.is-invalid select, .ct-field.is-invalid textarea { border-color: var(--pl-danger); }
  .ct-select { position: relative; display: block; }
  .ct-select select { width: 100%; padding-right: 40px; appearance: none; -webkit-appearance: none; cursor: pointer; }
  .ct-caret { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 11px; color: var(--pl-muted); }
  .ct-err { font-size: 12px; color: var(--pl-danger-ink); min-height: 14px; }
  .ct-alert { padding: 11px 14px; border-radius: 11px; background: var(--pl-danger-tint); border: 1px solid var(--pl-danger-line); font-size: 13.5px; color: var(--pl-danger-ink); }
  .ct-submit-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; border-top: 1px solid var(--pl-line-soft); padding-top: 18px; }
  .ct-submit { height: 52px; padding: 0 28px; border: none; border-radius: 12px; background: var(--pl-gradient); color: var(--pl-surface); font-family: Geist, sans-serif; font-weight: 500; font-size: 16px; cursor: pointer; display: flex; align-items: center; gap: 10px; box-shadow: 0 12px 26px -12px rgba(247,99,30,.9); transition: background .2s; }
  .ct-submit:hover { background: var(--pl-gradient-hover); }
  .ct-consent { margin: 0; flex: 1; min-width: 220px; font-size: 12.5px; line-height: 1.55; color: var(--pl-muted); }
  .ct-consent a { color: var(--pl-accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  .ct-success { padding: clamp(40px,6vw,72px) clamp(22px,3vw,40px); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; }
  .ct-success-ico { width: 72px; height: 72px; border-radius: 22px; background: var(--pl-gradient); display: flex; align-items: center; justify-content: center; font-size: 30px; color: var(--pl-surface); box-shadow: 0 0 0 10px rgba(247,99,30,.14); }
  .ct-success-h2 { margin: 6px 0 0; font-family: Geist, sans-serif; font-size: 28px; font-weight: 600; letter-spacing: -.03em; color: var(--pl-ink); }
  .ct-success-p { margin: 0; max-width: 400px; font-size: 15.5px; line-height: 1.6; color: var(--pl-ink-2); }
  .ct-success-p b { color: var(--pl-ink); }
  .ct-success-again { height: 44px; padding: 0 18px; border-radius: 11px; border: 1px solid var(--pl-line); background: var(--pl-surface); color: var(--pl-ink); font-size: 14px; font-weight: 500; cursor: pointer; }

  @media (min-width: 900px) {
    .ct-card { grid-template-columns: minmax(0,0.85fr) minmax(0,1.15fr); }
    .ct-pair { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const form = document.querySelector('[data-form]') as HTMLFormElement | null;
  if (form) {
    const fields = ['first', 'last', 'email', 'company', 'size', 'type', 'msg'];
    const progress = document.querySelector('[data-progress]') as HTMLElement | null;
    const complete = document.querySelector('[data-complete]') as HTMLElement | null;
    const msglen = document.querySelector('[data-msglen]') as HTMLElement | null;
    const alert = document.querySelector('[data-alert]') as HTMLElement | null;
    const routes = Array.from(document.querySelectorAll('[data-route]')) as HTMLElement[];
    const whoLabel = document.querySelector('[data-who-label]') as HTMLElement | null;
    let who = 'a pricing strategist';

    const el = (name: string) => form.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
    const valid = (name: string) => {
      const v = (el(name)?.value || '').trim();
      if (name === 'email') return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);
      return v.length > 0;
    };
    const update = () => {
      const done = fields.filter(valid).length;
      if (progress) progress.style.width = (done / 7 * 100) + '%';
      if (complete) complete.textContent = `${done} / 7 complete`;
      const msg = el('msg') as HTMLTextAreaElement | null;
      if (msglen && msg) msglen.textContent = `${msg.value.length} chars`;
    };

    routes.forEach((r) => r.addEventListener('click', () => {
      routes.forEach((o) => { o.classList.toggle('is-on', o === r); o.setAttribute('aria-checked', String(o === r)); });
      who = r.dataset.who || who;
      if (whoLabel) whoLabel.textContent = who;
    }));
    fields.forEach((name) => el(name)?.addEventListener('input', update));
    update();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = true;
      fields.forEach((name) => {
        const field = el(name)?.closest('.ct-field');
        const err = field?.querySelector('.ct-err');
        const good = valid(name);
        field?.classList.toggle('is-invalid', !good);
        if (err) err.textContent = good ? '' : (name === 'email' ? 'Enter a valid work email.' : 'This field is required.');
        if (!good) ok = false;
      });
      if (alert) alert.hidden = ok;
      if (!ok) return;
      // No endpoint yet — show success state (see MIGRATION.md).
      const name = (el('first')?.value || 'there').trim();
      const email = (el('email')?.value || 'your inbox').trim();
      (document.querySelector('[data-success-name]') as HTMLElement).textContent = name;
      (document.querySelector('[data-success-email]') as HTMLElement).textContent = email;
      (document.querySelector('[data-success-who]') as HTMLElement).textContent = who;
      form.hidden = true;
      (document.querySelector('[data-success]') as HTMLElement).hidden = false;
      if (progress) progress.style.width = '100%';
    });

    document.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      (document.querySelector('[data-success]') as HTMLElement).hidden = true;
      update();
    });
  }
</script>

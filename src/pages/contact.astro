---
/**
 * Contact PriceLeap — native light rebuild (replaces the old dark contact page).
 * Content ported 1:1 from contact.html. Vanilla-JS form: validation, progress,
 * honeypot, success state. ContactPage JSON-LD. No support.js.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';

const sizes = ['Under 1,000', '1,000 – 10,000', '10,000 – 50,000', '50,000+'];
const inquiries = ['Book a demo', 'Pricing & plans', 'Enterprise sales', 'Technical support', 'Partnerships', 'Other'];

const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact PriceLeap',
  description: 'Talk to the PriceLeap team about pricing intelligence, enterprise rollouts or support.',
  url: 'https://priceleap.ai/contact',
};
---

<SiteLayout
  title="Contact PriceLeap · Let's talk pricing"
  description="Talk to the PriceLeap team about pricing intelligence, enterprise rollouts or support."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(contactLd)} />

  <section class="ct-hero">
    <div class="ct-hero__grid" aria-hidden="true"></div>
    <div class="ct-hero__glow" aria-hidden="true"></div>
    <div class="ct-wrap ct-hero__inner">

      <!-- ── Left: info ── -->
      <aside class="ct-info">
        <div>
          <span class="ct-eyebrow"><span class="ct-eyebrow__dot"></span>Contact</span>
          <h1 class="ct-h1"><span class="w4">Let's talk </span><b>pricing.</b></h1>
          <p class="ct-lead">Whether you're evaluating PriceLeap for the first time or ready to scale your catalog — our team is ready to walk you through it.</p>
          <span class="ct-resp"><span class="ct-resp__ring" aria-hidden="true"></span>Avg. response under 4 hours</span>
        </div>

        <div class="ct-channels">
          <a href="mailto:sales_team@priceleap.ai" class="ct-chan">
            <span class="ct-chan__ic" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            </span>
            <span class="ct-chan__body"><span class="ct-chan__k">Email Us</span><span class="ct-chan__v">sales_team@priceleap.ai</span></span>
            <span class="ct-chan__go">→</span>
          </a>
          <div class="ct-chan ct-chan--static">
            <span class="ct-chan__ic" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="1.8"><path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <span class="ct-chan__body"><span class="ct-chan__k">Headquarters</span><span class="ct-chan__v ct-chan__v--sm">80 Broad St, 5th Floor PMB#1148, NY</span></span>
          </div>
          <div class="ct-chan ct-chan--static">
            <span class="ct-chan__ic" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            </span>
            <span class="ct-chan__body"><span class="ct-chan__k">Business Hours</span><span class="ct-chan__v ct-chan__v--sm">Mon–Fri · 8:00–18:00 PT <span class="ct-open"><span class="ct-open__dot"></span>All systems operational</span></span></span>
          </div>
        </div>

        <div class="ct-notes">
          <p><b>50K+ SKUs</b> or complex multi-marketplace setups? Talk directly to our enterprise team.</p>
          <p>Existing customer? Your dedicated onboarding contact has priority access.</p>
        </div>
      </aside>

      <!-- ── Right: form ── -->
      <div class="ct-formwrap">
        <form class="ct-form" id="ct-form" novalidate aria-describedby="ct-formnote">
          <div class="ct-form__head">
            <div>
              <h2>Send us a message</h2>
              <p id="ct-formnote">Fill in the form and we'll match you with the right person — a pricing strategist, a technical specialist, or our sales team.</p>
            </div>
          </div>

          <div class="ct-progress" aria-hidden="true"><i id="ct-progress"></i></div>
          <div class="ct-progress__lbl"><span id="ct-count">0</span> / 7 complete</div>

          <!-- honeypot (spam trap) -->
          <div class="ct-hp" aria-hidden="true"><label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label></div>

          <div class="ct-grid2">
            <div class="ct-field">
              <label for="f-first">First Name</label>
              <input id="f-first" name="first" required aria-required="true" placeholder="Alex" />
              <span class="ct-err" data-err-for="first" role="alert"></span>
            </div>
            <div class="ct-field">
              <label for="f-last">Last Name</label>
              <input id="f-last" name="last" required aria-required="true" placeholder="Johnson" />
              <span class="ct-err" data-err-for="last" role="alert"></span>
            </div>
          </div>

          <div class="ct-field">
            <label for="f-email">Work Email</label>
            <input id="f-email" name="email" type="email" required aria-required="true" placeholder="alex@company.com" />
            <span class="ct-err" data-err-for="email" role="alert"></span>
          </div>

          <div class="ct-field">
            <label for="f-company">Company</label>
            <input id="f-company" name="company" required aria-required="true" placeholder="Acme Corp" />
            <span class="ct-err" data-err-for="company" role="alert"></span>
          </div>

          <div class="ct-grid2">
            <div class="ct-field">
              <label for="f-size">Catalog Size (SKUs)</label>
              <select id="f-size" name="size" required aria-required="true">
                <option value="">Select range</option>
                {sizes.map(s => <option value={s}>{s}</option>)}
              </select>
              <span class="ct-err" data-err-for="size" role="alert"></span>
            </div>
            <div class="ct-field">
              <label for="f-type">Inquiry Type</label>
              <select id="f-type" name="type" required aria-required="true">
                <option value="">What can we help with?</option>
                {inquiries.map(s => <option value={s}>{s}</option>)}
              </select>
              <span class="ct-err" data-err-for="type" role="alert"></span>
            </div>
          </div>

          <div class="ct-field">
            <label for="f-msg">Message</label>
            <textarea id="f-msg" name="msg" rows="5" required aria-required="true" placeholder="Tell us about your pricing challenges, catalog size, marketplaces you compete on, or anything else that helps us prepare…"></textarea>
            <div class="ct-field__foot"><span class="ct-err" data-err-for="msg" role="alert"></span><span class="ct-count" id="ct-msglen">0 chars</span></div>
          </div>

          <button type="submit" class="ct-submit" id="ct-submit">Submit →</button>
          <p class="ct-fineprint">By submitting, you agree to our <a href="/privacy-policy">privacy policy</a>. We never share your data with third parties.</p>
        </form>

        <!-- success state -->
        <div class="ct-done" id="ct-done" hidden role="status" aria-live="polite">
          <span class="ct-done__ic">✓</span>
          <h2>Message sent</h2>
          <p>Thanks — we'll be in touch, on average in under 4 hours.</p>
          <button type="button" class="ct-btn-secondary" id="ct-again">Send another message</button>
        </div>
      </div>
    </div>
  </section>

</SiteLayout>

<script>
  // Native contact form: validation, progress, honeypot, success.
  // To wire a real backend, set ENDPOINT to your POST URL (Astro API route, HubSpot, Formspree, …).
  const ENDPOINT = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? '';
  const form = document.getElementById('ct-form') as HTMLFormElement | null;
  if (form) {
    const fields = ['first', 'last', 'email', 'company', 'size', 'type', 'msg'];
    const rules: Record<string, (v: string) => string> = {
      first: v => v.trim() ? '' : 'Enter your first name.',
      last: v => v.trim() ? '' : 'Enter your last name.',
      email: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Enter a valid work email.',
      company: v => v.trim() ? '' : 'Enter your company.',
      size: v => v ? '' : 'Select a range.',
      type: v => v ? '' : 'Select an inquiry type.',
      msg: v => v.trim().length >= 10 ? '' : 'Tell us a little more (10+ characters).',
    };
    const el = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const errBox = (n: string) => form.querySelector(`[data-err-for="${n}"]`) as HTMLElement | null;
    const progress = document.getElementById('ct-progress')!;
    const countEl = document.getElementById('ct-count')!;
    const msgLen = document.getElementById('ct-msglen')!;
    let tried = false;

    const valid = (n: string) => !rules[n](el(n).value);
    const refresh = () => {
      const done = fields.filter(valid).length;
      countEl.textContent = String(done);
      progress.style.width = Math.round(done / 7 * 100) + '%';
      const m = el('msg') as HTMLTextAreaElement;
      msgLen.textContent = m.value.length + ' chars';
    };
    const showErr = (n: string) => {
      const msg = rules[n](el(n).value);
      const box = errBox(n); const input = el(n);
      if (box) box.textContent = msg;
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      input.classList.toggle('is-err', !!msg);
      input.classList.toggle('is-ok', !msg && !!input.value);
      return !msg;
    };
    fields.forEach(n => {
      const input = el(n);
      input.addEventListener('input', () => { if (tried) showErr(n); refresh(); });
      input.addEventListener('change', () => { if (tried) showErr(n); refresh(); });
      input.addEventListener('blur', () => showErr(n));
    });
    refresh();

    form.addEventListener('submit', async e => {
      e.preventDefault();
      // honeypot: silently succeed-ignore if filled
      const hp = form.elements.namedItem('company_website') as HTMLInputElement;
      if (hp && hp.value) { return; }
      tried = true;
      const ok = fields.map(showErr).every(Boolean);
      if (!ok) { (form.querySelector('.is-err') as HTMLElement)?.focus(); return; }
      const btn = document.getElementById('ct-submit') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        if (!ENDPOINT) throw new Error('Contact endpoint is not configured');
        const response = await fetch(ENDPOINT, { method: 'POST', body: new FormData(form) });
        if (!response.ok) throw new Error('Contact request failed');
      } catch {
        btn.disabled = false; btn.textContent = 'Submit →';
        document.getElementById('ct-formnote')!.textContent = 'We could not send your message. Please email sales_team@priceleap.ai or try again.';
        (window as any).plToast?.('Message could not be sent.', 'error');
        return;
      }
      form.hidden = true;
      const done = document.getElementById('ct-done')!; done.hidden = false;
      (window as any).plToast?.('Message sent.');
      document.getElementById('ct-again')?.addEventListener('click', () => {
        form.reset(); form.hidden = false; done.hidden = true;
        btn.disabled = false; btn.textContent = 'Submit →'; tried = false;
        form.querySelectorAll('.is-err,.is-ok').forEach(x => x.classList.remove('is-err', 'is-ok'));
        form.querySelectorAll('.ct-err').forEach(x => (x.textContent = ''));
        refresh();
      });
    });
  }
</script>

<style>
.ct-wrap { max-width: var(--pl-container); margin: 0 auto; padding-left: var(--pl-gutter); padding-right: var(--pl-gutter); }
.ct-eyebrow { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border-radius: 999px; background: #fff; border: 1px solid var(--pl-line); font-family: var(--pl-mono); font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: #B01C1C; }
.ct-eyebrow__dot { width: 7px; height: 7px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.8s infinite; }

.ct-hero { position: relative; overflow: hidden; }
.ct-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(#EEF0EE 1px,transparent 1px),linear-gradient(90deg,#EEF0EE 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 60% 70% at 20% 20%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 60% 70% at 20% 20%,#000 10%,transparent 70%); pointer-events: none; }
.ct-hero__glow { position: absolute; right: -10%; top: 10%; width: 760px; height: 700px; background: radial-gradient(closest-side,rgba(255, 49, 49,.13),transparent); pointer-events: none; }
.ct-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); gap: clamp(36px,5vw,64px); align-items: start; padding-top: clamp(48px,7vw,88px); padding-bottom: clamp(56px,7vw,96px); }

.ct-info { display: flex; flex-direction: column; gap: 28px; }
.ct-h1 { margin: 22px 0 0; font-family: var(--pl-font); font-size: clamp(44px,6vw,76px); line-height: .98; letter-spacing: -.05em; color: #0A0A0A; font-weight: 700; }
.ct-h1 .w4 { font-weight: 400; }
.ct-lead { margin: 22px 0 0; max-width: 520px; font-size: 18px; line-height: 1.6; color: #3A414C; }
.ct-resp { margin-top: 22px; height: 36px; padding: 0 14px 0 6px; display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; background: #E8FCEF; border: 1px solid #FFD6C8; font-size: 13.5px; color: #0A0A0A; }
.ct-resp__ring { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #FF3131; border-right-color: transparent; }

.ct-channels { display: flex; flex-direction: column; gap: 10px; }
.ct-chan { background: #fff; border: 1px solid var(--pl-line); border-radius: 18px; padding: 18px 20px; display: grid; grid-template-columns: 44px minmax(0,1fr) auto; gap: 16px; align-items: center; color: #0A0A0A; transition: border-color .25s, transform .25s, box-shadow .25s; }
a.ct-chan:hover { border-color: #FF3131; transform: translateX(4px); box-shadow: 0 18px 36px -28px rgba(200, 30, 30,.6); color: #0A0A0A; }
.ct-chan__ic { width: 44px; height: 44px; border-radius: 12px; background: #FF3131; display: flex; align-items: center; justify-content: center; }
.ct-chan__k { display: block; font-family: var(--pl-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: #5A6373; }
.ct-chan__v { display: block; margin-top: 2px; font-family: var(--pl-font); font-size: 17px; font-weight: 600; word-break: break-word; }
.ct-chan__v--sm { font-size: 14px; font-weight: 500; }
.ct-chan__go { color: #B01C1C; }
.ct-open { display: inline-flex; align-items: center; gap: 6px; margin-left: 8px; font-family: var(--pl-mono); font-size: 11px; color: #B01C1C; }
.ct-open__dot { width: 6px; height: 6px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.8s infinite; }
.ct-notes { display: flex; flex-direction: column; gap: 12px; }
.ct-notes p { margin: 0; padding-left: 16px; border-left: 2px solid #FFD6C8; font-size: 14px; line-height: 1.55; color: #5A6373; }
.ct-notes b { color: #0A0A0A; }

/* form */
.ct-formwrap { position: relative; }
.ct-form { border: 1px solid var(--pl-line); border-radius: 24px; background: #fff; padding: clamp(24px,3vw,36px); box-shadow: 0 40px 80px -48px rgba(10,10,10,.22); }
.ct-form__head h2 { margin: 0; font-family: var(--pl-font); font-size: 22px; font-weight: 600; letter-spacing: -.02em; color: #0A0A0A; }
.ct-form__head p { margin: 8px 0 0; font-size: 14px; line-height: 1.55; color: #5A6373; }
.ct-progress { margin: 22px 0 8px; height: 6px; border-radius: 6px; background: #F4F5F4; overflow: hidden; }
.ct-progress i { display: block; height: 100%; width: 0; border-radius: 6px; background: #FF3131; transition: width .3s cubic-bezier(.2,.8,.2,1); }
.ct-progress__lbl { font-family: var(--pl-mono); font-size: 11px; color: #5A6373; margin-bottom: 20px; }
.ct-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.ct-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.ct-field { margin-bottom: 16px; display: flex; flex-direction: column; }
.ct-grid2 .ct-field { margin-bottom: 0; }
.ct-field label { font-size: 13px; font-weight: 500; color: #0A0A0A; margin-bottom: 7px; }
.ct-field input, .ct-field select, .ct-field textarea { width: 100%; border: 1px solid var(--pl-line); border-radius: 12px; padding: 12px 14px; font-size: 15px; color: #0A0A0A; background: #fff; outline: none; transition: border-color .2s, box-shadow .2s; }
.ct-field textarea { resize: vertical; }
.ct-field input:focus, .ct-field select:focus, .ct-field textarea:focus { border-color: #FF3131; box-shadow: 0 0 0 4px rgba(255, 49, 49,.14); }
.ct-field .is-ok { border-color: #FFD6C8; }
.ct-field .is-err { border-color: #E5483F; }
.ct-field .is-err:focus { box-shadow: 0 0 0 4px rgba(229,72,63,.14); }
.ct-err { color: #C9372E; font-size: 12px; min-height: 0; margin-top: 6px; }
.ct-err:empty { margin-top: 0; }
.ct-field__foot { display: flex; justify-content: space-between; align-items: center; }
.ct-count { font-family: var(--pl-mono); font-size: 11px; color: #6E7684; }
.ct-submit { margin-top: 8px; width: 100%; height: 50px; border: none; border-radius: 12px; background: #FF3131; color: #0A0A0A; font-family: var(--pl-font); font-weight: 600; font-size: 15px; cursor: pointer; box-shadow: 0 12px 26px -12px rgba(255, 49, 49,.9); transition: background .2s; }
.ct-submit:hover { background: #F23830; }
.ct-submit:disabled { opacity: .7; cursor: default; }
.ct-fineprint { margin: 14px 0 0; font-size: 12px; line-height: 1.5; color: #6E7684; text-align: center; }

.ct-done { border: 1.5px solid #FF3131; border-radius: 24px; background: #fff; padding: 48px 32px; text-align: center; box-shadow: 0 0 0 6px rgba(255, 49, 49,.08); display: flex; flex-direction: column; align-items: center; gap: 10px; }
.ct-done[hidden] { display: none; }
.ct-done__ic { width: 56px; height: 56px; border-radius: 16px; background: #FF3131; color: #0A0A0A; font-size: 24px; display: flex; align-items: center; justify-content: center; }
.ct-done h2 { margin: 8px 0 0; font-family: var(--pl-font); font-size: 24px; font-weight: 600; color: #0A0A0A; }
.ct-done p { margin: 0; font-size: 15px; color: #5A6373; }
.ct-btn-secondary { margin-top: 10px; height: 44px; padding: 0 20px; border: 1px solid var(--pl-line); border-radius: 11px; background: #fff; font-family: var(--pl-font); font-weight: 500; font-size: 14px; cursor: pointer; }
.ct-btn-secondary:hover { border-color: #0A0A0A; }

@media (max-width: 999px) {
  .ct-hero__inner { grid-template-columns: 1fr; }
}
@media (max-width: 520px) {
  .ct-grid2 { grid-template-columns: 1fr; gap: 0; }
  .ct-grid2 .ct-field { margin-bottom: 16px; }
}
</style>

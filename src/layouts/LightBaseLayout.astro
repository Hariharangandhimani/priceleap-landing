---
import Nav from '@/components/layout/Nav.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title = '[Light] ' + site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      /* Light theme tokens */
      :root {
        --lbg: #F5F6F3;
        --lsurface: #FFFFFF;
        --lsurface-2: #F4F6F2;
        --lline: #E3E6E1;
        --lline-soft: #ECEEEA;
        --ltext: #3D4450;
        --lmuted: #5F6876;
        --ldim: #9AA2AD;
        --lheading: #0A0A0A;
        --lgreen: #0B8F3C;
        --green: #18E563;
        --green-hover: #4CEE87;
        --red: #FF5247;
        --amber: #F5A524;
        --font-display: 'Geist', system-ui, sans-serif;
        --font-mono: 'Geist Mono', ui-monospace, monospace;
        --font-body: 'Inter', system-ui, sans-serif;
        --container: 1240px;
        --gutter: clamp(20px, 3vw, 24px);
        --section-y: clamp(96px, 11vw, 150px);
        --ease: cubic-bezier(.2, .7, .2, 1);
        --lcard-shadow: 0 1px 2px rgba(10,10,10,.04), 0 18px 40px -24px rgba(10,10,10,.18);
        --radius-lg: 20px;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; overflow-x: hidden; }
      body {
        margin: 0;
        background: var(--lbg);
        color: var(--ltext);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img, svg { display: block; max-width: 100%; }
      a { color: var(--lgreen); text-decoration: none; }
      a:hover { color: #0A0A0A; }
      button, input, textarea, select { font: inherit; }
      ::selection { background: var(--green); color: #0A0A0A; }
      :focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
      h1, h2, h3, h4 { margin: 0; color: var(--lheading); font-family: var(--font-display); }
      p { margin: 0; }
      .container { max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
      .section { padding-top: var(--section-y); scroll-margin-top: 80px; }
      .mono { font-family: var(--font-mono); }
      .eyebrow-l { font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--lgreen); }
      .h2-l { font-weight: 600; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -.035em; color: var(--lheading); text-wrap: balance; }
      .h3-l { font-weight: 600; font-size: 20px; letter-spacing: -.01em; color: var(--lheading); }
      .lcard { border: 1px solid var(--lline); border-radius: var(--radius-lg); background: var(--lsurface); box-shadow: var(--lcard-shadow); }
      .lcard:hover { border-color: #B9C0C8; transform: translateY(-2px); }
      .lcard { transition: border-color .3s, transform .3s; }
      .licon { width: 48px; height: 48px; flex: none; border-radius: 13px; background: #0A0A0A; color: var(--green); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px -12px rgba(10,10,10,.5), inset 0 0 0 1px rgba(24,229,99,.25); }
      @keyframes pl-pulse { 0% { box-shadow: 0 0 0 0 rgba(24,229,99,.55); } 100% { box-shadow: 0 0 0 9px rgba(24,229,99,0); } }
      @keyframes pl-marquee { to { transform: translateX(-50%); } }
      @keyframes pl-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @keyframes pl-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
      @keyframes fresh-l { 0% { width: 100%; } 100% { width: 8%; } }
      @keyframes flowstep-l { 0%, 33% { border-color: var(--green); color: var(--lgreen); background: rgba(24,229,99,.14); } 34%, 100% { border-color: #7FD3A0; color: var(--lgreen); background: #E3F7EA; } }
      .pl-js [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
      .pl-js [data-reveal].pl-in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .pl-js [data-reveal] { opacity: 1; transform: none; transition: none; }
        *, *::before, *::after { animation: none !important; transition: none !important; }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot name="before-nav" />
    <Nav theme="light" />
    <main><slot /></main>
    <Footer theme="light" />
    <script>
      const root = document.documentElement;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        root.classList.add('pl-js');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('pl-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

---
import { skuSizes, channels, timeSlots } from '@/data/demo';
/** 3-step booking form. Replace the submit handler in the script with your CRM/calendar call. */
---
<div class="df" data-demo-form>
  <div class="df__top"><div class="df__meta mono"><span data-step-label>STEP 1 OF 3</span><span data-step-hint>~30 sec</span></div>
    <div class="df__bars"><i data-bar="0"></i><i data-bar="1"></i><i data-bar="2"></i></div></div>

  <form class="df__step" data-step="0" novalidate>
    <div><h2>Book your demo</h2><p class="muted">Takes 30 seconds. No credit card.</p></div>
    <label class="field"><span class="field__label">Work email</span><input class="input" type="email" name="email" inputmode="email" autocomplete="email" placeholder="you@company.com" required /><small class="df__hint" data-email-hint></small></label>
    <label class="field"><span class="field__label">Full name</span><input class="input" type="text" name="name" autocomplete="name" placeholder="Priya Sharma" required /></label>
    <button class="df__cta" type="submit">Continue →</button>
    <div class="df__trust"><span>✓ Free competitor sample</span><span>✓ 15 minutes</span><span>✓ No commitment</span></div>
  </form>

  <form class="df__step" data-step="1" novalidate hidden>
    <div><h2>Tailor your demo</h2><p class="muted">So we can load your market before the call.</p></div>
    <label class="field"><span class="field__label">Company website</span><input class="input" type="url" name="site" inputmode="url" autocomplete="url" placeholder="yourstore.com" /></label>
    <div class="field"><span class="field__label">How many SKUs do you sell?</span><div class="df__grid4" role="radiogroup">{skuSizes.map((s, i) => <button type="button" role="radio" class="choice mono" aria-checked={i === 1 ? 'true' : 'false'} data-size={s}>{s}</button>)}</div></div>
    <div class="field"><span class="field__label">Where do you sell? <span class="dim">Pick all that apply</span></span><div class="df__chips">{channels.map(([k, n], i) => <button type="button" class="choice df__chip" aria-pressed={i < 2 ? 'true' : 'false'} data-channel={n}><img src={`/assets/logos/${k}.svg`} alt="" width="14" height="14" />{n}</button>)}</div></div>
    <div class="df__row"><button type="button" class="df__back" data-back aria-label="Back">←</button><button class="df__cta" type="submit">Pick a time →</button></div>
  </form>

  <div class="df__step" data-step="2" hidden>
    <div><h2>Pick a time</h2><p class="muted">15 minutes · Google Meet or Zoom · <span data-tz></span></p></div>
    <div class="df__days" data-days></div>
    <div class="df__times">{timeSlots.map((t) => <button type="button" class="choice mono" aria-pressed="false" data-time={t}>{t}</button>)}</div>
    <div class="df__row"><button type="button" class="df__back" data-back aria-label="Back">←</button><button type="button" class="df__cta" data-confirm disabled>Select a time</button></div>
  </div>

  <div class="df__step df__done" data-step="3" hidden>
    <span class="df__check">✓</span>
    <h2>You're booked, <span data-first>there</span>.</h2>
    <p><span data-when></span><br /><span class="muted">Invite sent to <span data-email-out></span></span></p>
    <div class="df__note"><span class="dot dot--pulse"></span><span><b>We're already building your sample.</b> Our team is matching your top products against competitors so the demo uses your real data.</span></div>
    <div class="df__row"><a href="#" class="df__ghost">Add to calendar</a><button type="button" class="df__ghost" data-reschedule>Reschedule</button></div>
  </div>

  <div class="df__foot"><span class="df__avs"><i>AK</i><i>RM</i><i>SN</i></span><span>Run by a pricing specialist, not a sales script.</span></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo-form]');
  if (root) {
    const FREE = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com'];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const state: Record<string, any> = { size: '1K–10K', channels: ['Shopify', 'Amazon'], day: null, time: null };
    const go = (n: number) => {
      steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
      root.querySelector('[data-step-label]')!.textContent = n < 3 ? `STEP ${n + 1} OF 3` : 'CONFIRMED';
      root.querySelector('[data-step-hint]')!.textContent = ['~30 sec', '~20 sec', 'Last step', ''][n];
      root.querySelectorAll<HTMLElement>('[data-bar]').forEach((b) => (b.style.setProperty('--w', Number(b.dataset.bar) < n ? '100%' : Number(b.dataset.bar) === n ? '40%' : '0%')));
      steps[n].querySelector<HTMLElement>('input, button')?.focus({ preventScroll: true });
    };
    const f0 = steps[0] as HTMLFormElement, email = f0.elements.namedItem('email') as HTMLInputElement, name = f0.elements.namedItem('name') as HTMLInputElement;
    const hint = root.querySelector<HTMLElement>('[data-email-hint]')!;
    const valid = () => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim());
    email.addEventListener('input', () => {
      const free = valid() && FREE.includes(email.value.split('@')[1].toLowerCase());
      hint.textContent = free ? 'Tip: a work email gets your sample built faster.' : valid() ? '✓ Looks good' : '';
      hint.dataset.tone = free ? 'warn' : 'ok'; email.removeAttribute('aria-invalid');
    });
    f0.addEventListener('submit', (e) => {
      e.preventDefault();
      email.setAttribute('aria-invalid', String(!valid())); name.setAttribute('aria-invalid', String(!name.value.trim()));
      if (!valid()) { hint.textContent = 'Enter a valid work email.'; hint.dataset.tone = 'err'; return; }
      if (!name.value.trim()) return;
      go(1);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((b) => b.addEventListener('click', () => { root.querySelectorAll('[data-size]').forEach((x) => x.setAttribute('aria-checked', String(x === b))); state.size = b.dataset.size; }));
    root.querySelectorAll<HTMLButtonElement>('[data-channel]').forEach((b) => b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))));
    (steps[1] as HTMLFormElement).addEventListener('submit', (e) => { e.preventDefault(); go(2); });
    root.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => go(Math.max(0, steps.findIndex((s) => !s.hidden) - 1))));

    root.querySelector('[data-tz]')!.textContent = (Intl.DateTimeFormat().resolvedOptions().timeZone || 'Local time').replace(/_/g, ' ');
    const days: Date[] = []; const d = new Date(); d.setHours(12, 0, 0, 0);
    while (days.length < 5) { d.setDate(d.getDate() + 1); if (d.getDay() % 6 !== 0) days.push(new Date(d)); }
    const daysEl = root.querySelector<HTMLElement>('[data-days]')!;
    daysEl.innerHTML = days.map((x, i) => `<button type="button" class="choice df__day" aria-pressed="${i === 0}" data-day="${i}"><small>${x.toLocaleDateString('en-US', { weekday: 'short' }).toUpperCase()}</small><b>${x.getDate()}</b><small>${x.toLocaleDateString('en-US', { month: 'short' })}</small></button>`).join('');
    state.day = 0;
    const times = [...root.querySelectorAll<HTMLButtonElement>('[data-time]')];
    const confirm = root.querySelector<HTMLButtonElement>('[data-confirm]')!;
    const markTaken = () => times.forEach((t, i) => { t.disabled = i === (state.day * 2 + 1) % times.length; t.setAttribute('aria-pressed', 'false'); });
    markTaken();
    daysEl.querySelectorAll<HTMLButtonElement>('[data-day]').forEach((b) => b.addEventListener('click', () => {
      daysEl.querySelectorAll('[data-day]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      state.day = Number(b.dataset.day); state.time = null; markTaken(); confirm.disabled = true; confirm.textContent = 'Select a time';
    }));
    times.forEach((t) => t.addEventListener('click', () => { times.forEach((x) => x.setAttribute('aria-pressed', String(x === t))); state.time = t.dataset.time; confirm.disabled = false; confirm.textContent = 'Confirm ' + state.time; }));
    confirm.addEventListener('click', async () => {
      confirm.disabled = true; confirm.textContent = 'Booking…';
      state.email = email.value; state.name = name.value; state.site = (steps[1] as HTMLFormElement).site?.value;
      state.channels = [...root.querySelectorAll<HTMLElement>('[data-channel][aria-pressed="true"]')].map((x) => x.dataset.channel);
      // TODO: send `state` to your CRM / calendar (HubSpot, Calendly, etc.)
      await new Promise((r) => setTimeout(r, 900));
      root.querySelector('[data-first]')!.textContent = name.value.trim().split(' ')[0] || 'there';
      root.querySelector('[data-email-out]')!.textContent = email.value;
      root.querySelector('[data-when]')!.textContent = days[state.day].toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' + state.time;
      go(3);
    });
    root.querySelector('[data-reschedule]')!.addEventListener('click', () => { confirm.textContent = 'Select a time'; markTaken(); go(2); });
    go(0);
  }
</script>

<style>
  .df { border: 1px solid var(--line); border-radius: 22px; background: var(--surface); box-shadow: 0 50px 120px -40px rgba(0,0,0,.9), inset 0 1px 0 rgba(255,255,255,.04); overflow: hidden; }
  .df__top { padding: 20px 22px 0; } .df__meta { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .1em; color: var(--muted); } .df__meta span:last-child { letter-spacing: 0; color: var(--dim); }
  .df__bars { margin-top: 12px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; } .df__bars i { position: relative; height: 4px; border-radius: 2px; background: var(--line-soft); overflow: hidden; }
  .df__bars i::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w, 0%); background: var(--green); transition: width .5s var(--ease); }
  .df__step { padding: 22px; display: flex; flex-direction: column; gap: 16px; animation: pl-in .4s ease both; } .df__step[hidden] { display: none; }
  h2 { font-size: 24px; font-weight: 600; letter-spacing: -.02em; } .df__step p.muted { margin-top: 6px; font-size: 14px; }
  .dim { color: var(--dim); font-weight: 400; }
  .df__hint { min-height: 16px; font-size: 12px; color: var(--green); } .df__hint[data-tone="warn"] { color: var(--amber); } .df__hint[data-tone="err"] { color: var(--red-soft); }
  .df__cta { flex: 1; height: 54px; border: 0; border-radius: 12px; background: var(--green); color: var(--bg); font-family: var(--font-display); font-weight: 600; font-size: 16px; cursor: pointer; box-shadow: 0 12px 30px -12px rgba(24,229,99,.7); transition: background .2s; }
  .df__cta:hover { background: var(--green-hover); } .df__cta:disabled { background: var(--green-dark); cursor: not-allowed; box-shadow: none; }
  .df__trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; font-size: 12px; color: var(--muted); }
  .df__grid4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; } .df__grid4 .choice { font-size: 12.5px; padding: 0 4px; }
  .df__chips { display: flex; flex-wrap: wrap; gap: 6px; } .df__chip { height: 40px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; }
  .df__row { display: flex; gap: 8px; }
  .df__back { width: 54px; height: 54px; flex: none; border-radius: 12px; border: 1px solid var(--line); background: transparent; color: var(--text); font-size: 18px; cursor: pointer; }
  .df__days { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  :global(.df__day) { height: auto !important; padding: 10px 0 !important; display: flex; flex-direction: column; align-items: center; gap: 2px; }
  :global(.df__day small) { font-family: var(--font-mono); font-size: 10px; color: var(--muted); } :global(.df__day b) { font-family: var(--font-display); font-size: 20px; color: var(--white); }
  :global(.df__day[aria-pressed="true"] small) { color: var(--green); }
  .df__times { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 6px; }
  .df__times .choice[aria-pressed="true"] { background: var(--green); color: var(--bg); } .df__times .choice:disabled { color: #3A3A3A; text-decoration: line-through; cursor: not-allowed; }
  .df__done { align-items: center; text-align: center; padding-block: 32px 26px; } .df__done p { font-size: 15px; line-height: 1.55; }
  .df__check { width: 64px; height: 64px; border-radius: 50%; background: var(--green); color: var(--bg); display: grid; place-items: center; font-size: 28px; font-weight: 700; animation: pl-pop .5s ease both; box-shadow: 0 0 0 10px rgba(24,229,99,.1); }
  .df__note { width: 100%; padding: 14px; border: 1px solid var(--green-dark); border-radius: 12px; background: rgba(24,229,99,.05); text-align: left; display: flex; gap: 12px; font-size: 13.5px; line-height: 1.5; } .df__note .dot { margin-top: 6px; } .df__note b { color: var(--white); font-weight: 500; }
  .df__done .df__row { width: 100%; } .df__ghost { flex: 1; height: 46px; border-radius: 11px; border: 1px solid var(--line); background: transparent; color: var(--white); font-size: 14px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .df__foot { padding: 14px 22px; border-top: 1px solid var(--line-soft); background: var(--surface-2); display: flex; align-items: center; gap: 12px; font-size: 12.5px; color: var(--muted); }
  .df__avs { display: flex; } .df__avs i { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--surface-2); background: var(--green-deep); color: var(--green); font-style: normal; font-size: 10px; font-weight: 600; display: grid; place-items: center; } .df__avs i + i { margin-left: -8px; background: var(--line-soft); color: var(--white); }
</style>

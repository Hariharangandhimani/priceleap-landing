---
// Integrations & security — animated SVG flow diagram + connector grid
const cats = ['All','Ecommerce','ERP & CRM','Data & BI','Alerts'];
const connectors = [
  { m:'Sh', n:'Shopify', api:'ADMIN API', cat:1, on:true },
  { m:'Am', n:'Amazon Seller Central', api:'SP-API', cat:1, on:false },
  { m:'Fk', n:'Flipkart', api:'SELLER API', cat:1, on:false },
  { m:'Wc', n:'WooCommerce', api:'REST API', cat:1, on:false },
  { m:'Bc', n:'BigCommerce', api:'REST API', cat:1, on:false },
  { m:'Eb', n:'eBay Seller Hub', api:'OAUTH 2.0', cat:1, on:false },
  { m:'Wm', n:'Walmart Marketplace', api:'PARTNER API', cat:1, on:false },
  { m:'Mg', n:'Magento', api:'REST API', cat:1, on:false },
  { m:'Et', n:'Etsy', api:'OPEN API', cat:1, on:false },
  { m:'Tg', n:'Target Plus', api:'PARTNER API', cat:1, on:false },
  { m:'Sf', n:'Salesforce', api:'COMMERCE CLOUD', cat:2, on:false },
  { m:'Or', n:'NetSuite', api:'SUITETALK', cat:2, on:false },
  { m:'Sa', n:'SAP S/4HANA', api:'ODATA', cat:2, on:false },
  { m:'D3', n:'Dynamics 365', api:'DATAVERSE', cat:2, on:false },
  { m:'Sn', n:'Snowflake', api:'DATA SHARE', cat:3, on:false },
  { m:'Db', n:'Databricks', api:'DELTA SHARE', cat:3, on:false },
  { m:'Bq', n:'BigQuery', api:'EXPORT', cat:3, on:false },
  { m:'Gs', n:'Google Sheets', api:'SHEETS API', cat:3, on:false },
  { m:'Ex', n:'Microsoft Excel', api:'GRAPH API', cat:3, on:false },
  { m:'Sl', n:'Slack', api:'OAUTH 2.0', cat:4, on:true },
  { m:'Em', n:'Email alerts', api:'SMTP', cat:4, on:true },
];
const inNodes = [
  { initials:'Sh', label:'Shopify', pct:'15.91' },
  { initials:'Am', label:'Amazon', pct:'38.64' },
  { initials:'Fk', label:'Flipkart', pct:'61.36' },
  { initials:'Mg', label:'Magento', pct:'84.09' },
];
const outNodes = [
  { initials:'Sl', label:'Slack', pct:'15.91' },
  { initials:'Sn', label:'Snowflake', pct:'38.64' },
  { initials:'Sf', label:'Salesforce', pct:'61.36' },
  { initials:'Gs', label:'Sheets', pct:'84.09' },
];
---
<section id="integrations" class="l-section lint">
  <div class="lint__top">
    <div class="lint__copy" data-reveal>
      <div class="l-eyebrow">
        <span class="l-eyebrow__slash">//</span>
        <span class="l-eyebrow__label"><span class="l-eyebrow__diamond"></span>Integrations &amp; security</span>
        <span class="l-eyebrow__slash">\\</span>
      </div>
      <h2 class="lint__h2">Fits your stack.<br /><span class="l-grad">Secures your data.</span></h2>
      <p class="l-lead" style="max-width:520px">Connect Shopify, marketplaces, and your BI tools, or pull live data via API. Enterprise-ready with SSO, role-based access, and ISO 27001-aligned security.</p>
      <div class="l-frame lint__kpis">
        <div><b>20+</b><span>native connectors</span></div>
        <div><b>5 min</b><span>typical setup</span></div>
        <div><b>API</b><span>REST &amp; webhooks</span></div>
      </div>
    </div>

    <!-- SVG flow diagram -->
    <div class="lint__hub" role="img" aria-label="Data flows from Shopify, Amazon, Flipkart, Magento into PriceLeap, and insights flow to Slack, Snowflake, Salesforce, Sheets" data-reveal style="--i:1">
      <div class="lint__hub-bg" aria-hidden="true"></div>
      <div class="mono lint__data-in"><span class="lint__small-dot"></span>DATA IN</div>
      <div class="mono lint__insights-out">INSIGHTS OUT<span class="lint__small-dot lint__small-dot--out"></span></div>

      <svg viewBox="0 0 500 440" class="lint__svg" aria-hidden="true">
        <style>@keyframes pldash{to{stroke-dashoffset:-18}}</style>
        <!-- Track paths -->
        {['M78,70 C160,70 160,220 222,220','M78,170 C160,170 160,220 222,220','M78,270 C160,270 160,220 222,220','M78,370 C160,370 160,220 222,220'].map(d => (
          <path d={d} fill="none" stroke="#e4e2dc" stroke-width="1.5" />
        ))}
        {['M78,70 C160,70 160,220 222,220','M78,170 C160,170 160,220 222,220','M78,270 C160,270 160,220 222,220','M78,370 C160,370 160,220 222,220'].map((d, i) => (
          <path d={d} fill="none" stroke="#18E563" stroke-width="1.5" stroke-dasharray="4 14" style={`animation:pldash 1.2s linear ${-i*0.6}s infinite`} />
        ))}
        {['M278,220 C340,220 340,70 422,70','M278,220 C340,220 340,170 422,170','M278,220 C340,220 340,270 422,270','M278,220 C340,220 340,370 422,370'].map(d => (
          <path d={d} fill="none" stroke="#e4e2dc" stroke-width="1.5" />
        ))}
        {['M278,220 C340,220 340,70 422,70','M278,220 C340,220 340,170 422,170','M278,220 C340,220 340,270 422,270','M278,220 C340,220 340,370 422,370'].map((d, i) => (
          <path d={d} fill="none" stroke="#0fb04b" stroke-width="1.5" stroke-dasharray="4 14" opacity=".7" style={`animation:pldash 1.2s linear ${-i*0.6}s infinite`} />
        ))}
      </svg>

      <!-- Source nodes (left) -->
      {inNodes.map((n, i) => (
        <div class="lint__node lint__node--in" style={`top:${n.pct}%`}>
          <span class="lint__node-ic lint__node-ic--in">{n.initials}<span class="lint__node-dot lint__node-dot--in"></span></span>
          <span class="lint__node-label">{n.label}</span>
        </div>
      ))}

      <!-- Destination nodes (right) -->
      {outNodes.map((n, i) => (
        <div class="lint__node lint__node--out" style={`top:${n.pct}%`}>
          <span class="lint__node-ic lint__node-ic--out">{n.initials}<span class="lint__node-dot lint__node-dot--out"></span></span>
          <span class="lint__node-label">{n.label}</span>
        </div>
      ))}

      <!-- Centre PriceLeap logo -->
      <div class="lint__core">
        <span class="lint__core-ring" aria-hidden="true"></span>
        <span class="lint__core-ripple" aria-hidden="true"></span>
        <span class="lint__core-inner">
          <span class="lint__core-bars" aria-hidden="true">
            <i class="b1"></i><i class="b2"></i>
            <span class="b3w"><i class="b3d"></i><i class="b3b"></i></span>
          </span>
          <span class="lint__core-name">Price<b>Leap</b></span>
        </span>
        <span class="lint__core-badge mono"><span class="lint__badge-dot"></span>SYNCING LIVE</span>
      </div>
    </div>
  </div>

  <!-- Connector directory -->
  <div class="lint__dir" data-reveal style="--i:2" data-lint>
    <div class="lint__dir-bar">
      <div class="lint__tabs" role="tablist" aria-label="Integration categories">
        {cats.map((c, i) => (
          <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-lcat={i} class:list={['lint__tab', { 'lint__tab--on': i === 0 }]}>
            {c}<span class="mono lint__tab-count">{i===0 ? connectors.length : connectors.filter(x=>x.cat===i).length}</span>
          </button>
        ))}
      </div>
      <span class="mono lint__req">Don't see yours? <a href="/contact">Request a connector →</a></span>
    </div>
    <div class="lint__grid">
      {connectors.map((c, i) => (
        <div class:list={['lint__tile', { 'lint__tile--on': c.on }]} data-ltile-cat={c.cat}>
          <span class="lint__tile-ic mono">{c.m}</span>
          <div class="lint__tile-body">
            <div class="lint__tile-name">{c.n}</div>
            <div class="lint__tile-meta">
              <span class="mono lint__api-tag">{c.api}</span>
              {c.on && <span class="mono lint__connected">● CONNECTED</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-lint]');
  if (root) {
    root.querySelectorAll<HTMLButtonElement>('[data-lcat]').forEach(b => b.addEventListener('click', () => {
      const cat = Number(b.dataset.lcat);
      root.querySelectorAll('[data-lcat]').forEach(x => { const on = x===b; x.setAttribute('aria-selected',String(on)); (x as HTMLElement).classList.toggle('lint__tab--on',on); });
      root.querySelectorAll<HTMLElement>('[data-ltile-cat]').forEach(el => el.hidden = cat !== 0 && Number(el.dataset.ltileCat) !== cat);
    }));
  }
</script>

<style>
@keyframes pldash{to{stroke-dashoffset:-18}}
@keyframes plspin-l{to{transform:rotate(360deg)}}
@keyframes plring-l{0%{transform:translate(-50%,-50%) scale(1);opacity:.55}100%{transform:translate(-50%,-50%) scale(2.6);opacity:0}}

.lint__top { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,440px),1fr)); gap: 40px; align-items: center; }
.lint__copy { display: flex; flex-direction: column; gap: 16px; }
.lint__h2 { margin: 22px 0 0; font-size: clamp(38px,5vw,60px); line-height: 1.04; letter-spacing: -.035em; font-weight: 500; }
.lint__kpis { grid-template-columns: repeat(3,minmax(0,1fr)) !important; border-radius: 14px !important; max-width: 520px; }
.lint__kpis > * { background: #fff; padding: 18px; }
.lint__kpis b { display: block; font-size: 28px; font-weight: 600; letter-spacing: -.02em; color: var(--pl-ink); }
.lint__kpis span { font-size: 13px; color: var(--pl-muted); }

/* Hub */
.lint__hub { position: relative; width: min(100%,500px); aspect-ratio: 500/440; margin-inline: auto; }
.lint__hub-bg { position: absolute; left: 50%; top: 50%; width: 62%; height: 70%; transform: translate(-50%,-50%); border-radius: 50%; background: radial-gradient(closest-side,rgba(24,229,99,.16),transparent 70%); pointer-events: none; }
.lint__data-in { position: absolute; left: 0; top: 0; font-size: 10.5px; letter-spacing: .12em; color: var(--pl-faint); display: flex; align-items: center; gap: 6px; }
.lint__insights-out { position: absolute; right: 0; top: 0; font-size: 10.5px; letter-spacing: .12em; color: var(--pl-faint); display: flex; align-items: center; gap: 6px; }
.lint__small-dot { width: 6px; height: 6px; border-radius: 50%; background: #18E563; flex: none; }
.lint__small-dot--out { border: 1.5px solid #0fb04b; background: transparent; }
.lint__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

.lint__node { position: absolute; display: flex; flex-direction: column; align-items: center; transform: translate(-50%,-50%); }
.lint__node--in { left: 10%; }
.lint__node--out { left: 90%; }
.lint__node-ic { width: 56px; height: 56px; border-radius: 16px; border: 1px solid var(--pl-line); background: #fff; box-shadow: 0 12px 26px -14px rgba(23,22,26,.35); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; color: #3a3940; position: relative; }
.lint__node-dot { position: absolute; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; border: 1.5px solid #fff; }
.lint__node-ic--in .lint__node-dot { right: -4px; background: #18E563; }
.lint__node-ic--out .lint__node-dot { left: -4px; background: transparent; border-color: #0fb04b; }
.lint__node-label { position: absolute; top: calc(100% + 6px); font-size: 11px; color: var(--pl-faint); white-space: nowrap; }

/* Centre */
.lint__core { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: flex; flex-direction: column; align-items: center; }
.lint__core-ring { position: absolute; inset: -18px; border-radius: 50%; border: 1px dashed #8ef0b2; animation: plspin-l 24s linear infinite; }
.lint__core-ripple { position: absolute; left: 50%; top: 50%; width: 104px; height: 104px; border-radius: 28px; border: 1.5px solid #18E563; animation: plring-l 3s ease-out infinite; }
.lint__core-inner { position: relative; width: 104px; height: 104px; border-radius: 28px; border: 1px solid #18E563; background: #fff; box-shadow: 0 0 0 8px rgba(24,229,99,.08),0 20px 50px -14px rgba(24,229,99,.55); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
.lint__core-bars { display: flex; align-items: flex-end; gap: 4px; height: 26px; }
.lint__core-bars i { display: block; border-radius: 2px; }
.b1{width:7px;height:10px;background:#18E563}.b2{width:7px;height:17px;background:#12c455}
.b3w{display:flex;flex-direction:column;align-items:center;gap:3px}.b3d{width:7px;height:7px;border-radius:50%;background:#0fb04b}.b3b{width:7px;height:16px;border-radius:2px;background:#0fb04b}
.lint__core-name { font-size: 12px; font-weight: 500; color: var(--pl-ink); } .lint__core-name b { color: #0a8f3c; }
.lint__core-badge { position: absolute; top: calc(100% + 22px); height: 24px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--pl-accent-line); background: var(--pl-accent-tint); display: flex; align-items: center; gap: 6px; font-size: 10px; letter-spacing: .08em; color: #0a8f3c; white-space: nowrap; }
.lint__badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #18E563; animation: pl-pulse 1.6s infinite; }

/* Directory */
.lint__dir { margin-top: 56px; background: #fff; border: 1px solid var(--pl-line); border-radius: 20px; overflow: hidden; }
.lint__dir-bar { display: flex; align-items: center; gap: 6px; padding: 12px 14px; border-bottom: 1px solid var(--pl-line-soft); flex-wrap: wrap; }
.lint__tabs { display: flex; gap: 4px; flex-wrap: wrap; }
.lint__tab { font: inherit; font-size: 14px; cursor: pointer; padding: 7px 14px; border-radius: 9px; border: 1px solid transparent; background: transparent; color: var(--pl-muted); display: flex; gap: 8px; align-items: center; transition: all .2s; }
.lint__tab--on { border-color: var(--pl-accent); background: var(--pl-accent-tint); color: var(--pl-ink); }
.lint__tab-count { font-size: 11px; color: var(--pl-faint-2); }
.lint__req { margin-left: auto; font-size: 12px; color: var(--pl-faint); }
.lint__req a { color: #0a8f3c; }
.lint__grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,240px),1fr)); gap: 10px; padding: 16px; }
.lint__tile { display: flex; align-items: center; gap: 12px; border: 1px solid var(--pl-line-soft); background: var(--pl-surface-2); border-radius: 12px; padding: 14px; transition: border-color .2s; }
.lint__tile[hidden] { display: none; }
.lint__tile--on { border-color: var(--pl-accent-line); background: var(--pl-accent-tint); }
.lint__tile-ic { width: 40px; height: 40px; flex: none; border-radius: 10px; border: 1px solid var(--pl-line-soft); background: #fbfaf8; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; color: #3a3940; }
.lint__tile-body { min-width: 0; }
.lint__tile-name { font-size: 15px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lint__tile-meta { display: flex; gap: 8px; align-items: center; margin-top: 5px; }
.lint__api-tag { font-size: 10px; letter-spacing: .08em; color: var(--pl-faint); border: 1px solid var(--pl-line-soft); border-radius: 5px; padding: 1px 6px; }
.lint__connected { font-size: 10px; color: #0a8f3c; }
</style>

---
/**
 * LHeader — light theme header with full mega-nav (exact match to design system Header.astro)
 * Desktop: sticky frosted bar, 3 mega-menu dropdowns, Sign in + CTA
 * Mobile (<960px): burger → full-height drawer with tabbed sections
 */
const shapes = ['sq','ci','di'];

const MENUS = [
  {
    key: 'product', label: 'Product', eyebrow: 'PLATFORM',
    all: { label: 'Explore the platform', href: '#' },
    items: [
      { t: 'Price Intelligence', d: 'Live competitor prices, index and positioning.', href: '#product' },
      { t: 'Decision Engine', d: 'Rules with floors, ceilings and MAP built in.', href: '#product' },
      { t: 'Dynamic Pricing', d: 'AI price recommendations inside your margin.', href: '#product' },
      { t: 'PriceLeap Agent', d: 'Plain-English answers on prices and rivals.', href: '#product', tag: 'NEW' },
      { t: 'Product Matching', d: 'AI matching plus human QC on every SKU.', href: '#' },
      { t: 'MAP Monitoring', d: 'Violation alerts and promotion tracking.', href: '#' },
    ],
    links: [
      { label: 'Data accuracy', href: '#accuracy' },
      { label: 'Security', href: '#integrations' },
      { label: 'Changelog', href: '#' },
    ],
    featured: {
      tag: 'PRICE INDEX · LIVE', stat: '105.4', bar: 72, sub: '▼ 3.6% vs market',
      title: 'See where you stand on every SKU',
      desc: 'One index across your full catalog, refreshed in real time.',
      cta: 'See a sample of your data', href: '/book-a-demo',
    },
  },
  {
    key: 'solutions', label: 'Solutions', eyebrow: 'BY TEAM & INDUSTRY',
    all: { label: 'All solutions', href: '#' },
    items: [
      { t: 'E-commerce brands', d: 'Protect price position across every channel.', href: '#' },
      { t: 'Marketplace sellers', d: 'Win the Buy Box without racing to the bottom.', href: '#' },
      { t: 'Retailers', d: 'Monitor thousands of SKUs against every rival.', href: '#' },
      { t: 'D2C stores', d: 'Stay competitive without giving away margin.', href: '#' },
      { t: 'Consumer electronics', d: 'Track fast-moving prices and launches.', href: '#' },
      { t: 'Automotive parts', d: 'Match parts by fitment, brand and condition.', href: '#' },
    ],
    links: [
      { label: 'Pricing teams', href: '#' },
      { label: 'Category managers', href: '#' },
      { label: 'Marketplace ops', href: '#' },
    ],
    featured: {
      tag: 'CUSTOMER RESULT', stat: '90%+', bar: 90, sub: 'BUY BOX WIN RATE · 6 WKS',
      title: 'Consumer electronics seller',
      desc: 'Automated responses to undercuts, inside the margin floor.',
      cta: 'Read customer stories', href: '/book-a-demo',
    },
  },
  {
    key: 'resources', label: 'Resources', eyebrow: 'LEARN',
    all: { label: 'Resource center', href: '#' },
    items: [
      { t: 'How it works', d: 'From catalog upload to live pricing in days.', href: '#how' },
      { t: 'Data accuracy', d: 'How every match is verified before it counts.', href: '#accuracy' },
      { t: 'Integrations', d: '20+ connectors, REST API and webhooks.', href: '#integrations' },
      { t: 'API docs', d: 'Pull live competitor data into your stack.', href: '#' },
      { t: 'Customer stories', d: 'Results from pricing teams like yours.', href: '#results' },
      { t: 'Blog', d: 'Pricing strategy, marketplaces and MAP.', href: '#' },
    ],
    links: [
      { label: 'Help center', href: '#' },
      { label: 'Status', href: '#' },
      { label: 'Contact sales', href: '/contact' },
    ],
    featured: {
      tag: 'GUIDE', stat: 'Live in days', bar: 40, sub: 'TYPICAL SETUP · 5 MIN',
      title: "The pricing team's setup guide",
      desc: 'Connect your catalog, set rules and go live.',
      cta: 'Read the guide', href: '/book-a-demo',
    },
  },
];

const DIRECT = [
  { label: 'Integrations', href: '#integrations' },
  { label: 'Pricing', href: '/pricing' },
];
---

<header class="hdr" data-header>
  <!-- Frosted glass backdrop -->
  <span class="hdr__bg" aria-hidden="true"></span>

  <div class="hdr__bar">
    <!-- Logo -->
    <div class="hdr__left">
      <a href="/light" class="hdr__logo" aria-label="PriceLeap home">
        <span class="hdr__bars" aria-hidden="true">
          <i class="hb1"></i><i class="hb2"></i>
          <span class="hb3"><i class="hb3d"></i><i class="hb3b"></i></span>
        </span>
        <span class="hdr__wordmark">Price<span class="hdr__grad">Leap</span></span>
      </a>

      <!-- Desktop nav -->
      <nav class="hdr__nav" aria-label="Main">
        {MENUS.map(m => (
          <button
            class="hdr__nl"
            aria-expanded="false"
            aria-controls={`mega-${m.key}`}
            data-menu={m.key}
          >
            {m.label}
            <svg class="hdr__caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        ))}
        {DIRECT.map(d => <a class="hdr__nl" href={d.href}>{d.label}</a>)}
      </nav>
    </div>

    <!-- Right: sign in + CTA + burger -->
    <div class="hdr__right">
      <a class="hdr__signin" href="https://app.priceleap.ai">Sign in</a>
      <a class="hdr__cta" href="/book-a-demo">Book a demo</a>
      <button class="hdr__burger" aria-label="Menu" aria-expanded="false" aria-controls="lhdr-mob" data-burger>
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>

  <!-- ── Mega menus (desktop) ── -->
  {MENUS.map(m => (
    <div class="mega" id={`mega-${m.key}`} data-mega={m.key} hidden>
      <div class="mega__frame">

        <!-- Top label row -->
        <div class="mega__top">
          <span class="mega__ey">
            <span class="mega__dia" aria-hidden="true"></span>
            {m.eyebrow}
          </span>
          <a href={m.all.href} class="mega__all">{m.all.label} →</a>
        </div>

        <!-- Body: 3-col items + featured panel -->
        <div class="mega__body">
          <div class="mega__items">
            {m.items.map((it, i) => (
              <a href={it.href} class="mega__item">
                <span class="mega__item-top">
                  <span class="mega__ic"><span class={`mega__shape ${shapes[i % 3]}`}></span></span>
                  <span class="mega__no">0{i + 1}</span>
                </span>
                <span class="mega__title">
                  {it.t}
                  {it.tag && <span class="mega__tag">{it.tag}</span>}
                </span>
                <span class="mega__desc">{it.d}</span>
                <span class="mega__go">Open →</span>
              </a>
            ))}
          </div>

          <!-- Featured panel -->
          <div class="mega__feat">
            <span class="mega__feat-dots" aria-hidden="true"></span>
            <span class="mega__feat-lbl">// FEATURED</span>
            <div class="mega__fcard">
              <div class="mega__fcard-top">
                <span class="mega__fcard-tag">{m.featured.tag}</span>
                <span class="mega__live" aria-hidden="true"></span>
              </div>
              <div class="mega__fstat">{m.featured.stat}</div>
              <div class="mega__fbar"><i style={`width:${m.featured.bar}%`}></i></div>
              <span class="mega__fsub">{m.featured.sub}</span>
            </div>
            <strong class="mega__ftitle">{m.featured.title}</strong>
            <p class="mega__fdesc">{m.featured.desc}</p>
            <a href={m.featured.href} class="mega__fcta">{m.featured.cta}</a>
          </div>
        </div>

        <!-- Bottom links row -->
        <div class="mega__links">
          {m.links.map(l => (
            <a href={l.href} class="mega__link">
              <span class="mega__link-dot" aria-hidden="true"></span>
              {l.label}
              <span class="mega__link-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
          <span class="mega__status">
            <span class="mega__status-dot" aria-hidden="true"></span>
            All systems operational
          </span>
        </div>

      </div>
    </div>
  ))}

  <!-- ── Mobile drawer ── -->
  <div class="mob" id="lhdr-mob" data-mob hidden>
    <!-- Tab switcher -->
    <div class="mob__seg" role="tablist">
      {MENUS.map((m, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`mob-panel-${m.key}`}
          data-tab={m.key}
        >
          {m.label}
        </button>
      ))}
    </div>

    <!-- Panels (one per menu) -->
    {MENUS.map((m, i) => (
      <div class="mob__panel" id={`mob-panel-${m.key}`} data-panel={m.key} hidden={i !== 0}>
        <div class="mob__panel-eyebrow">
          <span class="mega__dia" style="flex:none" aria-hidden="true"></span>
          <span>{m.eyebrow}</span>
          <a href={m.all.href} class="mob__all">{m.all.label} →</a>
        </div>
        <div class="mob__grid">
          {m.items.map((it, k) => (
            <a href={it.href} class="mob__row">
              <span class="mega__ic mob__ic"><span class={`mega__shape ${shapes[k % 3]}`}></span></span>
              <span>
                <b>{it.t}{it.tag && <span class="mob__tag">{it.tag}</span>}</b>
                <small>{it.d}</small>
              </span>
              <span class="mob__arrow" aria-hidden="true">›</span>
            </a>
          ))}
        </div>
        <!-- Featured card inside mobile -->
        <div class="mob__feat">
          <div>
            <span class="mob__feat-tag">{m.featured.tag}</span>
            <div class="mob__feat-stat">{m.featured.stat}</div>
            <div class="mob__feat-sub">{m.featured.sub}</div>
          </div>
          <a href={m.featured.href} class="mob__feat-cta">→</a>
        </div>
      </div>
    ))}

    <!-- Direct links (Integrations, Pricing) -->
    <div class="mob__direct">
      {DIRECT.map(d => (
        <a href={d.href} class="mob__dlink">
          {d.label}<span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <!-- Sticky CTA footer -->
    <div class="mob__foot">
      <a href="https://app.priceleap.ai" class="mob__signin">Sign in</a>
      <a href="/book-a-demo" class="mob__book">Book a demo</a>
    </div>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-header]')!;
  let open: string | null = null;

  // ── Mega menu (desktop) ──
  const showMega = (key: string | null) => {
    open = key;
    hdr.querySelectorAll<HTMLElement>('[data-mega]').forEach(p => p.hidden = p.dataset.mega !== key);
    hdr.querySelectorAll<HTMLElement>('[data-menu]').forEach(b => {
      const on = b.dataset.menu === key;
      b.setAttribute('aria-expanded', String(on));
      b.classList.toggle('is-open', on);
    });
  };

  hdr.querySelectorAll<HTMLElement>('[data-menu]').forEach(b => {
    b.addEventListener('mouseenter', () => matchMedia('(hover:hover)').matches && showMega(b.dataset.menu!));
    b.addEventListener('click', () => showMega(open === b.dataset.menu ? null : b.dataset.menu!));
  });
  hdr.addEventListener('mouseleave', () => showMega(null));
  document.addEventListener('click', e => { if (!hdr.contains(e.target as Node)) showMega(null); });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { showMega(null); toggleMob(false); }
  });

  // ── Mobile drawer ──
  const burger = hdr.querySelector<HTMLElement>('[data-burger]')!;
  const mob = hdr.querySelector<HTMLElement>('[data-mob]')!;

  const toggleMob = (force?: boolean) => {
    const open = force !== undefined ? force : mob.hidden;
    mob.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => toggleMob());
  mob.querySelectorAll('a').forEach(a => a.addEventListener('click', () => toggleMob(false)));

  // ── Mobile tabs ──
  hdr.querySelectorAll<HTMLElement>('[data-tab]').forEach(t => {
    t.addEventListener('click', () => {
      hdr.querySelectorAll('[data-tab]').forEach(x => x.setAttribute('aria-selected', String(x === t)));
      hdr.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => {
        p.hidden = p.dataset.panel !== t.dataset.tab;
      });
    });
  });

  // ── Scroll: add scrolled class ──
  const onScroll = () => hdr.classList.toggle('scrolled', scrollY > 4);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
/* ══════════════════ HEADER SHELL ══════════════════ */
.hdr {
  position: sticky; top: 0; z-index: 50;
  border-bottom: 1px solid var(--pl-line);
  isolation: isolate;
}
.hdr__bg {
  position: absolute; inset: 0; z-index: -1;
  background: rgba(246,245,242,.86);
  backdrop-filter: saturate(1.4) blur(14px);
  -webkit-backdrop-filter: saturate(1.4) blur(14px);
  transition: background .3s;
}
.hdr.scrolled .hdr__bg { background: rgba(246,245,242,.96); }

/* ── Bar ── */
.hdr__bar {
  max-width: var(--pl-container); margin: 0 auto;
  padding: 14px var(--pl-gutter);
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
}
.hdr__left { display: flex; align-items: center; gap: 36px; min-width: 0; }

/* ── Logo ── */
.hdr__logo {
  display: inline-flex; align-items: center; gap: 9px; flex: none;
  font-family: var(--pl-font); font-size: 21px; font-weight: 600;
  letter-spacing: -.02em; color: var(--pl-ink);
}
.hdr__logo:hover { color: var(--pl-ink); }
.hdr__bars { display: flex; align-items: flex-end; gap: 3px; height: 22px; }
.hdr__bars i, .hb3 i { display: block; border-radius: 2px; }
.hb1 { width: 5px; height: 8px; background: #18E563; }
.hb2 { width: 5px; height: 13px; background: #12c455; }
.hb3 { display: flex; flex-direction: column; align-items: center; gap: 2px; }
.hb3d { width: 5px; height: 5px; border-radius: 50% !important; background: #0fb04b; }
.hb3b { width: 5px; height: 13px; background: #0fb04b; }
.hdr__wordmark { color: var(--pl-ink); }
.hdr__grad { background: var(--pl-grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }

/* ── Desktop nav ── */
.hdr__nav { display: flex; gap: 2px; }
.hdr__nl {
  font: inherit; font-size: 15px; border: none; background: none;
  color: #4a4950; padding: 8px 12px; border-radius: 9px;
  cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
  text-decoration: none; transition: background var(--pl-dur-fast), color var(--pl-dur-fast);
  white-space: nowrap;
}
.hdr__nl:hover, .hdr__nl.is-open { background: var(--pl-hover); color: var(--pl-ink); }
.hdr__caret { flex: none; transition: transform .2s; }
.hdr__nl.is-open .hdr__caret { transform: rotate(180deg); }

/* ── Right actions ── */
.hdr__right { display: flex; align-items: center; gap: 10px; flex: none; }
.hdr__signin {
  font-size: 15px; padding: 8px 10px; color: var(--pl-ink);
  transition: color var(--pl-dur-fast);
}
.hdr__signin:hover { color: var(--pl-ink); }
.hdr__cta {
  height: 40px; padding: 0 18px; border-radius: 11px;
  background: #18E563; color: #0b1f12;
  font-family: var(--pl-font); font-weight: 600; font-size: 14px;
  display: inline-flex; align-items: center;
  box-shadow: 0 10px 24px -12px rgba(24,229,99,.8);
  transition: background var(--pl-dur-fast);
}
.hdr__cta:hover { background: #14d159; color: #0b1f12; }

/* Burger */
.hdr__burger {
  display: none; width: 44px; height: 44px; border-radius: 11px;
  border: 1px solid var(--pl-line); background: #fff;
  flex-direction: column; align-items: center; justify-content: center;
  gap: 5px; cursor: pointer; padding: 0;
}
.hdr__burger i {
  display: block; width: 18px; height: 1.5px;
  background: var(--pl-ink); border-radius: 2px;
  transition: transform .25s, opacity .2s;
}
.hdr__burger.is-open i:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.hdr__burger.is-open i:nth-child(2) { opacity: 0; }
.hdr__burger.is-open i:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* ══════════════════ MEGA MENU ══════════════════ */
.mega {
  position: absolute; left: 0; right: 0; top: 100%;
  padding: 10px 12px 0;
  animation: pl-pop .2s ease;
}
.mega__frame {
  max-width: calc(var(--pl-container) - 24px); margin: 0 auto;
  border: 1px solid var(--pl-line); border-radius: 20px;
  overflow: hidden; background: var(--pl-line);
  display: grid; gap: 1px;
  box-shadow: 0 40px 80px -40px rgba(23,22,26,.35);
}

/* Top row */
.mega__top {
  background: var(--pl-surface-2) !important;
  padding: 12px 20px;
  display: flex; justify-content: space-between; align-items: center;
}
.mega__ey {
  display: flex; align-items: center; gap: 8px;
  font-family: var(--pl-mono); font-size: 11px;
  letter-spacing: .14em; color: var(--pl-ink);
}
.mega__dia {
  width: 7px; height: 7px; background: var(--pl-accent);
  transform: rotate(45deg); flex: none;
}
.mega__all { font-family: var(--pl-mono); font-size: 11px; letter-spacing: .08em; color: var(--pl-accent-ink); }

/* Body */
.mega__body {
  display: grid; grid-template-columns: minmax(0,1fr) 320px;
  gap: 1px; background: var(--pl-line) !important;
}
.mega__items {
  display: grid; grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 1px; background: var(--pl-line);
}

/* Item cards */
.mega__item {
  position: relative; background: #fff;
  padding: 18px 18px 20px;
  display: grid; grid-template-columns: 1fr auto;
  gap: 12px 8px; color: var(--pl-ink);
  transition: background .2s;
}
.mega__item::before {
  content: ""; position: absolute; left: 0; right: 0; top: 0;
  height: 2px; background: transparent; transition: background .2s;
}
.mega__item:hover { background: var(--pl-surface-2); color: var(--pl-ink); }
.mega__item:hover::before { background: var(--pl-accent); }
.mega__item-top { display: flex; justify-content: space-between; align-items: center; grid-column: 1 / -1; }
.mega__ic {
  width: 36px; height: 36px; border-radius: 10px;
  border: 1px solid var(--pl-line-soft); background: #fff;
  display: flex; align-items: center; justify-content: center;
  transition: all .2s;
}
.mega__item:hover .mega__ic { background: var(--pl-accent-tint); border-color: var(--pl-accent-line); }
.mega__shape { width: 11px; height: 11px; background: var(--pl-accent); }
.mega__shape.sq { border-radius: 4px; }
.mega__shape.ci { border-radius: 50%; }
.mega__shape.di { border-radius: 2px; transform: rotate(45deg); }
.mega__no { font-family: var(--pl-mono); font-size: 10px; color: var(--pl-faint-2); }
.mega__title {
  grid-column: 1 / -1; font-size: 15px; font-weight: 500;
  display: flex; align-items: center; gap: 8px;
}
.mega__tag {
  font-family: var(--pl-mono); font-size: 9px; letter-spacing: .1em;
  background: var(--pl-accent); color: var(--pl-on-accent);
  border-radius: 4px; padding: 1px 5px;
}
.mega__desc {
  grid-column: 1 / -1; font-size: 13px; line-height: 1.45;
  color: var(--pl-muted); margin-top: -8px;
}
.mega__go {
  grid-column: 1 / -1; font-family: var(--pl-mono); font-size: 11px;
  color: var(--pl-accent-ink); opacity: 0; transition: opacity .2s;
}
.mega__item:hover .mega__go { opacity: 1; }

/* Featured panel */
.mega__feat {
  background: #fff; padding: 20px;
  display: flex; flex-direction: column; gap: 12px;
  position: relative; overflow: hidden;
}
.mega__feat-dots {
  position: absolute; inset: 0;
  background-image: linear-gradient(var(--pl-line-soft) 1px, transparent 1px),
                    linear-gradient(90deg, var(--pl-line-soft) 1px, transparent 1px);
  background-size: 28px 28px;
  -webkit-mask-image: linear-gradient(180deg, #000, transparent 75%);
  mask-image: linear-gradient(180deg, #000, transparent 75%);
  pointer-events: none;
}
.mega__feat > * { position: relative; }
.mega__feat-lbl { font-family: var(--pl-mono); font-size: 11px; color: var(--pl-faint); }
.mega__fcard {
  border: 1px solid var(--pl-line); border-radius: 14px; padding: 16px;
  display: flex; flex-direction: column; gap: 10px;
  box-shadow: 0 16px 30px -22px rgba(23,22,26,.4);
  background: #fff;
}
.mega__fcard-top { display: flex; justify-content: space-between; align-items: center; }
.mega__fcard-tag { font-family: var(--pl-mono); font-size: 10px; letter-spacing: .12em; color: var(--pl-accent-ink); }
.mega__live { width: 7px; height: 7px; border-radius: 50%; background: var(--pl-accent); animation: pl-pulse 1.6s infinite; flex: none; }
.mega__fstat { font-size: 28px; font-weight: 600; letter-spacing: -.03em; color: var(--pl-ink); }
.mega__fbar { height: 5px; border-radius: 5px; background: var(--pl-line-soft); }
.mega__fbar i { display: block; height: 100%; border-radius: 5px; background: var(--pl-accent); }
.mega__fsub { font-family: var(--pl-mono); font-size: 10px; letter-spacing: .06em; color: var(--pl-faint); }
.mega__ftitle { font-size: 16px; font-weight: 600; letter-spacing: -.01em; line-height: 1.3; color: var(--pl-ink); }
.mega__fdesc { margin: 0; font-size: 13px; line-height: 1.5; color: var(--pl-muted); }
.mega__fcta {
  margin-top: auto; display: flex; justify-content: center; align-items: center;
  height: 40px; border-radius: 10px; background: var(--pl-accent);
  color: var(--pl-on-accent); font-size: 14px; font-weight: 500;
  transition: background var(--pl-dur-fast);
}
.mega__fcta:hover { background: #14d159; color: var(--pl-on-accent); }

/* Bottom links */
.mega__links {
  display: grid; grid-template-columns: repeat(3,minmax(0,1fr)) 320px;
  gap: 1px; background: var(--pl-line) !important;
}
.mega__links > * {
  background: var(--pl-surface-2);
  padding: 12px 18px; display: flex; align-items: center; gap: 8px;
  font-size: 13px; color: var(--pl-ink);
}
.mega__link { transition: color var(--pl-dur-fast); }
.mega__link:hover { color: var(--pl-accent-ink); }
.mega__link-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--pl-accent); flex: none; }

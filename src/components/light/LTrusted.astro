---
// Trust strip — clean full-width logo marquee, no sidebar text
const certs = [
  { src: '/assets/badges/iso-9001.webp', alt: 'ISO 9001' },
  { src: '/assets/badges/cmmi.webp', alt: 'CMMI Level 3' },
  { src: '/assets/badges/iso-27001.avif', alt: 'ISO 27001' },
  { src: '/assets/badges/gdpr.webp', alt: 'GDPR' },
];
// 4× loop for smooth infinite scroll
const row = [...certs, ...certs, ...certs, ...certs];
---
<section class="ltrust" aria-label="Trusted and certified">
  <div class="ltrust__marquee">
    <div class="ltrust__track">
      {row.map((c, i) => (
        <div class="ltrust__cell" aria-hidden={i >= certs.length ? 'true' : undefined}>
          <img src={c.src} alt={i < certs.length ? c.alt : ''} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.ltrust {
  border-bottom: 1px solid var(--pl-line);
  background: #fff;
  max-width: var(--pl-container);
  margin: 0 auto;
}
.ltrust__marquee {
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
}
.ltrust__track {
  display: flex;
  width: max-content;
  animation: pl-marquee 28s linear infinite;
}
.ltrust__marquee:hover .ltrust__track { animation-play-state: paused; }
.ltrust__cell {
  flex: none;
  width: 240px;
  height: 96px;
  border-right: 1px solid var(--pl-line);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}
.ltrust__cell img {
  max-height: 44px;
  max-width: 150px;
  object-fit: contain;
  filter: grayscale(1);
  opacity: .75;
  transition: filter .3s, opacity .3s;
}
.ltrust__cell:hover img { filter: none; opacity: 1; }
</style>

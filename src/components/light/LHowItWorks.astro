---
// How it works — 4-step interactive onboarding flow
const steps = [
  { day:'DAY 1', t:'Connect your catalog', d:'Upload your products or sync from Shopify, marketplaces, or a feed in minutes.' },
  { day:'DAY 2–3', t:'We match & monitor', d:'AI matches every product and human QC verifies it — then we track prices in real time.' },
  { day:'DAY 4', t:'Get pricing intelligence', d:'See your price index, competitive gaps, and the biggest pricing opportunities.' },
  { day:'DAY 5', t:'Optimize & act', d:'Push dynamic pricing rules or apply AI recommendations to win on margin.' },
];
---
<section id="how" class="l-section lhow" data-lhow>
  <div class="lhow__head">
    <div class="l-eyebrow">
      <span class="l-eyebrow__slash">//</span>
      <span class="l-eyebrow__label"><span class="l-eyebrow__diamond"></span>How it works</span>
      <span class="l-eyebrow__slash">\\</span>
    </div>
    <h2 class="lhow__h2">Live in days, <span class="l-grad">not months.</span></h2>
    <p class="l-lead" style="max-width:560px">Four steps from your catalog to live, margin-safe pricing.</p>
  </div>

  <div class="lhow__card l-frame" data-reveal>
    <!-- Progress header -->
    <div class="lhow__progbar">
      <span class="mono lhow__prog-label"><span class="lhow__prog-dot"></span>ONBOARDING · <span data-lhow-step>STEP 1</span> OF 04</span>
      <div class="lhow__prog-track"><div class="lhow__prog-fill" data-lhow-fill style="width:25%"></div></div>
      <span class="mono lhow__prog-note">~5 DAYS TO LIVE</span>
    </div>

    <!-- Steps grid -->
    <div class="lhow__steps">
      {steps.map((s, i) => (
        <button class:list={['lhow__step', { 'lhow__step--on': i === 0 }]} data-lhow-btn={i}>
          <span class="lhow__accent-bar" aria-hidden="true"></span>
          <div class="lhow__step-top">
            <span class="lhow__num mono" data-lhow-num={i}>{i < 3 ? '0'+(i+1) : '✓'}</span>
            <span class="mono lhow__day-tag" data-lhow-tag={i}>{s.day}</span>
          </div>
          <div>
            <div class="lhow__step-title">{s.t}</div>
            <div class="lhow__step-desc">{s.d}</div>
          </div>
          <!-- Preview content per step -->
          {i === 0 && (
            <div class="lhow__preview" data-lhow-preview={i}>
              <div class="lhow__preview-row"><span class="lhow__dot-sm"></span>Shopify<span class="mono lhow__preview-val">SYNCED</span></div>
              <div class="lhow__preview-row"><span class="lhow__dot-sm"></span>catalog.csv<span class="mono lhow__preview-val">12,480 rows</span></div>
              <div class="lhow__preview-row"><span class="lhow__dot-sm"></span>Product feed<span class="mono lhow__preview-val">HOURLY</span></div>
            </div>
          )}
          {i === 1 && (
            <div class="lhow__preview" data-lhow-preview={i}>
              <div class="lhow__match">
                <div class="lhow__match-card">Wireless ANC<br /><span class="mono lhow__match-sku">WH-ANC-700</span></div>
                <span class="lhow__match-icon">⇄</span>
                <div class="lhow__match-card lhow__match-card--found">Sonix ANC 700<br /><span class="mono lhow__match-conf">99.1% match</span></div>
              </div>
              <div class="lhow__badges"><span>✓ AI</span><span>✓ QC</span><span>✓ AUTO</span></div>
            </div>
          )}
          {i === 2 && (
            <div class="lhow__preview" data-lhow-preview={i}>
              <div class="lhow__index-preview">
                <div class="lhow__index-row"><span class="mono lhow__index-n">105.4</span><span class="mono lhow__index-d">▼ 3.6%</span></div>
                <div class="lhow__index-bars">
                  {[40,55,48,62,58,70,66,80,74,88].map((h, k) => <span style={`height:${h}%;background:${k>=7?'#18E563':'#e4e2dc'}`}></span>)}
                </div>
              </div>
            </div>
          )}
          {i === 3 && (
            <div class="lhow__preview" data-lhow-preview={i}>
              <div class="lhow__rec">
                <div class="mono lhow__rec-label">AI RECOMMENDATION</div>
                <div class="mono lhow__rec-price"><s>₹24,990</s><b>₹24,540</b></div>
                <span class="lhow__rec-apply">Apply price</span>
              </div>
            </div>
          )}
        </button>
      ))}
    </div>

    <!-- CTA footer -->
    <div class="lhow__footer">
      <span>A dedicated onboarding lead sets up your first product groups with you.</span>
      <a href="/book-a-demo" class="lhow__cta">Book a demo</a>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-lhow]');
  if (root) {
    let cur = 0;
    const go = (i: number) => {
      cur = i;
      root.querySelectorAll<HTMLElement>('[data-lhow-btn]').forEach((b, k) => b.classList.toggle('lhow__step--on', k === i));
      const fill = ((i+1)/4*100).toFixed(0) + '%';
      const f = root.querySelector<HTMLElement>('[data-lhow-fill]'); if (f) f.style.width = fill;
      const sl = root.querySelector('[data-lhow-step]'); if (sl) sl.textContent = 'STEP '+(i+1);
    };
    root.querySelectorAll<HTMLButtonElement>('[data-lhow-btn]').forEach((b, i) => b.addEventListener('click', () => go(i)));
    // Auto-advance
    const timer = setInterval(() => { if (!window.matchMedia('(prefers-reduced-motion:reduce)').matches) go((cur+1)%4); }, 3000);
    root.querySelectorAll('[data-lhow-btn]').forEach(b => b.addEventListener('click', () => clearInterval(timer)));
  }
</script>

<style>
.lhow__head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0; margin-bottom: 52px; }
.lhow__h2 { margin: 22px 0 0; font-size: clamp(36px,5vw,60px); line-height: 1.04; letter-spacing: -.035em; font-weight: 500; }

.lhow__card { border-radius: 22px !important; }

/* Progress header */
.lhow__progbar { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 14px 22px; }
.lhow__prog-label { display: flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: .12em; color: var(--pl-ink); }
.lhow__prog-dot { width: 7px; height: 7px; border-radius: 50%; background: #18E563; animation: pl-pulse 1.6s infinite; flex: none; }
.lhow__prog-track { flex: 1; min-width: 160px; height: 4px; border-radius: 4px; background: var(--pl-line); }
.lhow__prog-fill { height: 100%; border-radius: 4px; background: #18E563; transition: width .6s ease; }
.lhow__prog-note { font-size: 11px; color: var(--pl-faint); }

/* Steps */
.lhow__steps { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,220px),1fr)); gap: 1px; background: var(--pl-line) !important; }
.lhow__step { position: relative; font: inherit; color: inherit; text-align: left; border: none; background: var(--pl-surface-2); padding: 26px 22px 24px; display: flex; flex-direction: column; gap: 16px; cursor: pointer; transition: background .3s; }
.lhow__step--on { background: #fff; }
.lhow__accent-bar { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: transparent; transition: background .3s; }
.lhow__step--on .lhow__accent-bar { background: linear-gradient(90deg,#18E563,#0fb04b); }
.lhow__step-top { display: flex; justify-content: space-between; align-items: center; }
.lhow__num { width: 36px; height: 36px; border-radius: 50%; background: var(--pl-canvas); border: 1px solid var(--pl-line); color: var(--pl-faint); font-size: 12px; font-weight: 500; display: flex; align-items: center; justify-content: center; transition: all .3s; }
.lhow__step--on .lhow__num { background: #18E563; border-color: #18E563; color: var(--pl-on-accent); box-shadow: 0 4px 14px -4px rgba(24,229,99,.7); }
.lhow__day-tag { font-size: 10px; letter-spacing: .12em; padding: 3px 8px; border-radius: 5px; background: var(--pl-canvas); color: var(--pl-faint); transition: all .3s; }
.lhow__step--on .lhow__day-tag { background: var(--pl-accent-tint); color: var(--pl-accent-ink); }
.lhow__step-title { font-size: 19px; font-weight: 600; letter-spacing: -.01em; color: var(--pl-faint); transition: color .3s; }
.lhow__step--on .lhow__step-title { color: var(--pl-ink); }
.lhow__step-desc { font-size: 14px; line-height: 1.55; color: var(--pl-muted); text-wrap: pretty; }

/* Previews */
.lhow__preview { margin-top: auto; padding: 12px; border-radius: 12px; background: var(--pl-canvas); border: 1px dashed var(--pl-line); opacity: 0; transition: opacity .3s; }
.lhow__step--on .lhow__preview { opacity: 1; }
.lhow__preview-row { display: flex; align-items: center; gap: 7px; border: 1px solid var(--pl-line-soft); background: #fff; border-radius: 8px; padding: 7px 10px; font-size: 12px; margin-bottom: 6px; }
.lhow__dot-sm { width: 6px; height: 6px; border-radius: 50%; background: #18E563; flex: none; }
.lhow__preview-val { margin-left: auto; font-size: 10px; color: var(--pl-faint); }
.lhow__match { display: grid; grid-template-columns: 1fr 26px 1fr; gap: 6px; align-items: center; }
.lhow__match-card { border: 1px solid var(--pl-line-soft); background: #fff; border-radius: 8px; padding: 8px; font-size: 11px; line-height: 1.35; }
.lhow__match-card--found { border-color: var(--pl-accent-line); }
.lhow__match-sku { font-size: 9px; color: var(--pl-faint); }
.lhow__match-conf { font-size: 9px; color: #0a8f3c; }
.lhow__match-icon { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--pl-accent-line); background: var(--pl-accent-tint); color: #0a8f3c; font-size: 11px; display: flex; align-items: center; justify-content: center; }
.lhow__badges { display: flex; gap: 6px; margin-top: 8px; }
.lhow__badges span { font-family: var(--pl-mono); font-size: 9px; letter-spacing: .08em; color: #0a8f3c; border: 1px solid var(--pl-accent-line); background: var(--pl-accent-tint); border-radius: 4px; padding: 2px 6px; }
.lhow__index-preview { border: 1px solid var(--pl-line-soft); background: #fff; border-radius: 8px; padding: 10px; }
.lhow__index-row { display: flex; justify-content: space-between; align-items: baseline; }
.lhow__index-n { font-size: 20px; font-weight: 500; }
.lhow__index-d { font-size: 9px; color: #0a8f3c; }
.lhow__index-bars { display: flex; align-items: flex-end; gap: 3px; height: 28px; margin-top: 8px; }
.lhow__index-bars span { flex: 1; border-radius: 2px; }
.lhow__rec { border: 1px solid var(--pl-accent-line); background: var(--pl-accent-tint); border-radius: 8px; padding: 10px; }
.lhow__rec-label { font-size: 9px; letter-spacing: .1em; color: #0a8f3c; }
.lhow__rec-price { display: flex; align-items: baseline; gap: 8px; margin-top: 6px; } .lhow__rec-price s { font-size: 11px; color: var(--pl-faint-2); } .lhow__rec-price b { font-size: 18px; font-weight: 500; }
.lhow__rec-apply { display: inline-block; margin-top: 8px; background: #18E563; color: var(--pl-on-accent); font-size: 11px; font-weight: 500; padding: 4px 10px; border-radius: 6px; }

/* Footer */
.lhow__footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 18px 22px; }
.lhow__footer span { font-size: 15px; color: #3a3940; }
.lhow__cta { background: #18E563; color: var(--pl-on-accent); font-weight: 500; font-size: 15px; padding: 12px 20px; border-radius: 12px; box-shadow: 0 10px 24px -12px rgba(24,229,99,.8); white-space: nowrap; }
.lhow__cta:hover { background: #14d159; color: var(--pl-on-accent); }
</style>

---
interface Props { plan: { id: string; kicker: string; name: string; desc: string; tag: string; cta: string; href: string; stats: string[][] } }
const { plan: p } = Astro.props;
---
<div id={p.id} class="fp" data-plan={p.id}>
  <div class="fp__head">
    <div><div class="fp__kicker"><span class="mono">{p.kicker}</span><span class="tag tag--solid fp__rec">RECOMMENDED</span></div><h3>{p.name}</h3><p>{p.desc}</p></div>
    <div class="fp__price"><b>Free</b><span class="mono accent">{p.tag}</span></div>
  </div>
  <div class="fp__stats">{p.stats.map(([v, l]) => <div><b class="mono">{v}</b><span>{l}</span></div>)}</div>
  <a class="fp__cta" href={p.href}>{p.cta}</a>
</div>
<style>
  .fp { padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 90px; transition: border-color .3s, box-shadow .3s; }
  .fp.is-rec { border-color: var(--green); box-shadow: var(--glow); }
  .fp__rec { display: none; } .fp.is-rec .fp__rec { display: inline-block; }
  .fp__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .fp__kicker { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; } .fp__kicker .mono { font-size: 10.5px; letter-spacing: .1em; color: var(--muted); }
  h3 { margin-top: 6px; font-size: 20px; font-weight: 600; } .fp__head p { margin-top: 6px; font-size: 14px; line-height: 1.5; color: var(--muted); max-width: 380px; }
  .fp__price { text-align: right; flex: none; } .fp__price b { display: block; font-family: var(--font-display); font-size: 26px; color: var(--white); } .fp__price span { font-size: 11px; }
  .fp__stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--line-soft); border-radius: 12px; overflow: hidden; background: var(--line-soft); }
  .fp__stats div { padding: 10px 12px; background: var(--surface-2); } .fp__stats b { display: block; font-size: 16px; font-weight: 400; color: var(--white); } .fp__stats span { font-size: 11.5px; color: var(--muted); }
  @media (max-width: 480px) { .fp__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .fp__cta { height: 46px; border-radius: 11px; border: 1px solid var(--line); color: var(--white); font-family: var(--font-display); font-weight: 500; font-size: 14.5px; display: flex; align-items: center; justify-content: center; } .fp__cta:hover { border-color: var(--green); color: var(--white); }
</style>

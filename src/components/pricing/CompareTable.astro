---
import { compareCols, compareRows, paidPlans, ANNUAL_DISCOUNT } from '@/data/pricing';
const cls = (v: string) => (v === '✓' ? 'yes' : v === '—' ? 'no' : '');
const annualFor = (i: number) => (i >= 2 && i <= 4 ? '$' + Math.round(paidPlans[i - 2].price * (1 - ANNUAL_DISCOUNT)) : null);
---
<section id="compare" class="container section ct" data-compare>
  <div class="ct__head"><h2 class="h2" style="font-size:clamp(30px,4vw,46px)">Compare all plans</h2><p>Everything you need to make the right choice for your catalog size.</p></div>

  <div class="ct__mobile">
    <div class="ct__chips" role="tablist" aria-label="Choose a plan">
      {compareCols.map((c, i) => <button type="button" role="tab" class="choice" aria-selected={c.popular ? 'true' : 'false'} data-mcol={i}>{c.label}</button>)}
    </div>
    <div class="ct__list">
      {compareRows.map(([f, vals], r) => (
        <div class="ct__item"><span>{f}</span>{vals.map((v, i) => <b class:list={['mono', cls(v)]} data-mcell={i} hidden={!compareCols[i].popular}>{r === 0 && annualFor(i) ? <span data-monthly={v} data-annual={annualFor(i)}>{v}</span> : v}</b>)}</div>
      ))}
    </div>
  </div>

  <div class="ct__desktop">
    <table>
      <thead><tr><th scope="col" class="ct__feat mono">FEATURE</th>{compareCols.map((c) => <th scope="col" data-col={c.id} class:list={{ pop: c.popular }}>{c.label}<small class="mono ct__poptag">{c.popular ? 'MOST POPULAR' : ''}</small><small class="mono ct__rectag">RECOMMENDED</small></th>)}</tr></thead>
      <tbody>
        {compareRows.map(([f, vals], r) => (
          <tr><th scope="row">{f}</th>{vals.map((v, i) => <td class:list={['mono', cls(v), { pop: compareCols[i].popular }]}>{r === 0 && annualFor(i) ? <span data-monthly={v} data-annual={annualFor(i)}>{v}</span> : v}</td>)}</tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-compare]');
  root?.querySelectorAll<HTMLButtonElement>('[data-mcol]').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('[data-mcol]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    root.querySelectorAll<HTMLElement>('[data-mcell]').forEach((c) => (c.hidden = c.dataset.mcell !== b.dataset.mcol));
  }));
</script>
<style>
  .ct__head { text-align: center; } .ct__head p { margin: 12px auto 0; max-width: 520px; font-size: 16px; line-height: 1.55; color: var(--muted); }
  .yes { color: var(--green) !important; } .no { color: #3A3A3A !important; }
  .ct__mobile { margin-top: 28px; } .ct__desktop { display: none; margin-top: 36px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); overflow: auto; }
  @media (min-width: 860px) { .ct__mobile { display: none; } .ct__desktop { display: block; } }
  .ct__chips { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; } .ct__chips .choice { flex: none; height: 40px; border-radius: 999px; font-size: 13.5px; }
  .ct__list { margin-top: 14px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); overflow: hidden; }
  .ct__item { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 16px; font-size: 14px; } .ct__item + .ct__item { border-top: 1px solid var(--line-soft); }
  .ct__item b { font-weight: 400; font-size: 13.5px; color: var(--white); text-align: right; } .ct__item b[hidden] { display: none; }
  table { width: 100%; min-width: 900px; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 14px; border-top: 1px solid var(--line-soft); text-align: center; }
  thead th { border-top: 0; padding: 18px 14px; background: var(--surface-2); border-bottom: 1px solid var(--line); font-family: var(--font-display); font-size: 15px; font-weight: 600; color: var(--white); white-space: nowrap; }
  thead th small { display: block; margin-top: 4px; font-size: 9.5px; letter-spacing: .08em; color: var(--green); min-height: 12px; }
  thead th.pop, thead th.is-rec { background: var(--green-deep); }
  .ct__rectag { display: none !important; } th.is-rec .ct__rectag { display: block !important; } th.is-rec .ct__poptag { display: none; }
  .ct__feat { position: sticky; left: 0; z-index: 2; text-align: left; padding-left: 20px; font-family: var(--font-mono) !important; font-size: 11px !important; letter-spacing: .1em; font-weight: 500 !important; color: var(--muted) !important; }
  tbody th { position: sticky; left: 0; text-align: left; padding-left: 20px; background: var(--surface); font-weight: 400; color: var(--text); white-space: nowrap; }
  td { font-size: 13.5px; color: var(--white); } td.pop { background: rgba(24,229,99,.04); }
  tbody tr:hover td, tbody tr:hover th { background: #151515; }
</style>

---
/** Small stroke icon set used across pages. Add new paths to ICONS. */
const ICONS: Record<string, string[]> = {
  mail: ['M5 5h14a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3z', 'M4 7l8 6 8-6'],
  headset: ['M4 14v-2a8 8 0 0 1 16 0v2', 'M3 15.5A1.5 1.5 0 0 1 4.5 14h1A1.5 1.5 0 0 1 7 15.5v3A1.5 1.5 0 0 1 5.5 20h-1A1.5 1.5 0 0 1 3 18.5z', 'M17 15.5a1.5 1.5 0 0 1 1.5-1.5h1a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5z'],
  clock: ['M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18', 'M12 7v5l3 2'],
  link: ['M9 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10', 'M15 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10'],
  user: ['M12 4.5a3.5 3.5 0 1 0 0 7a3.5 3.5 0 1 0 0-7', 'M5 20c1.5-4 4-5.5 7-5.5s5.5 1.5 7 5.5'],
  pulse: ['M3 13h4l2.5-6l3.5 11l2.5-7H21', 'M3 21h18'],
  shield: ['M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z', 'M9 12l2.2 2.2L15 10'],
};
interface Props { name: keyof typeof ICONS | string; size?: number; stroke?: number }
const { name, size = 22, stroke = 1.8 } = Astro.props;
const paths = ICONS[name] ?? [];
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {paths.map((d) => <path d={d} />)}
</svg>

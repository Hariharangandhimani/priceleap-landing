---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'dark' | 'ghost-dark';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}
const { href, variant = 'primary', size = 'md', type = 'button', class: cls = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : type} class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]} {...rest}>
  <slot />
</Tag>
<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: var(--radius); font-family: var(--font-display); font-weight: 600; white-space: nowrap; cursor: pointer; border: 1px solid transparent; transition: background .2s, border-color .2s, transform .2s; }
  .btn:hover { transform: translateY(-1px); }
  .btn--sm { height: 40px; padding: 0 16px; font-size: 14px; border-radius: 10px; }
  .btn--md { height: 48px; padding: 0 22px; font-size: 15px; }
  .btn--lg { height: 54px; padding: 0 26px; font-size: 16px; }
  .btn--primary { background: var(--green); color: var(--bg); box-shadow: 0 12px 30px -12px rgba(24,229,99,.6); }
  .btn--primary:hover { background: var(--green-hover); color: var(--bg); }
  .btn--secondary { background: var(--surface); border-color: var(--line); color: var(--white); font-weight: 500; }
  .btn--secondary:hover { border-color: var(--dim); color: var(--white); }
  .btn--outline { background: transparent; border-color: var(--line); color: var(--white); font-weight: 500; }
  .btn--outline:hover { border-color: var(--green); color: var(--white); }
  .btn--dark { background: var(--bg); color: var(--white); }
  .btn--dark:hover { color: var(--white); }
  .btn--ghost-dark { background: transparent; border: 1.5px solid var(--bg); color: var(--bg); }
  .btn--ghost-dark:hover { color: var(--bg); background: rgba(10,10,10,.06); }
  :global(.btn .arrow) { color: var(--green); }
  .btn--primary :global(.arrow) { color: inherit; }
</style>

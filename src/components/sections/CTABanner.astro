---
import Button from '@/components/ui/Button.astro';
import { routes } from '@/data/site';
/** Green closing banner — reused on every page. */
interface Props { title: string; text?: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string }; size?: 'lg' | 'md'; id?: string }
const { title, text, primary = { label: 'Book a demo', href: routes.demo }, secondary, size = 'lg', id } = Astro.props;
---
<section id={id} class="container cta-wrap">
  <div class:list={['cta', `cta--${size}`]} data-reveal>
    <div class="cta__art" aria-hidden="true"><span></span><span></span><span class="cta__i"><span></span><span></span></span></div>
    <div class="cta__copy">
      <h2>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="cta__actions">
      <Button href={primary.href} variant="dark" size="lg">{primary.label} <span class="arrow">→</span></Button>
      {secondary && <Button href={secondary.href} variant="ghost-dark" size="lg">{secondary.label}</Button>}
    </div>
  </div>
</section>
<style>
  .cta-wrap { padding-block: var(--section-y); }
  .cta { position: relative; overflow: hidden; border-radius: 28px; background: var(--green); display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px; }
  .cta--lg { padding: clamp(48px, 7vw, 104px) clamp(24px, 6vw, 80px); }
  .cta--md { padding: clamp(32px, 5vw, 56px); align-items: center; border-radius: 24px; }
  .cta__copy { position: relative; flex: 1 1 480px; max-width: 760px; }
  h2 { font-weight: 700; font-size: clamp(30px, 5vw, 68px); line-height: 1; letter-spacing: -.045em; color: var(--bg); text-wrap: balance; }
  .cta--md h2 { font-size: clamp(28px, 3.6vw, 44px); }
  p { margin-top: 18px; font-size: 18px; line-height: 1.55; color: var(--green-deep); max-width: 560px; }
  .cta__actions { position: relative; display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 479px) {
    .cta__actions { flex-direction: column; }
    .cta__actions :global(.btn) { width: 100%; justify-content: center; }
  }
  .cta__art { position: absolute; right: clamp(16px, 6vw, 80px); top: -40px; display: flex; align-items: flex-end; gap: clamp(10px, 1.6vw, 22px); opacity: .14; pointer-events: none; }
  .cta__art > span:not(.cta__i), .cta__i span { width: clamp(40px, 6vw, 84px); border-radius: 14px; background: var(--bg); }
  .cta__art > span:nth-child(1) { height: clamp(60px, 9vw, 130px); }
  .cta__art > span:nth-child(2) { height: clamp(100px, 15vw, 210px); }
  .cta__i { display: flex; flex-direction: column; align-items: center; gap: clamp(10px, 1.6vw, 22px); }
  .cta__i span:first-child { height: clamp(40px, 6vw, 84px); border-radius: 50%; }
  .cta__i span:last-child { height: clamp(140px, 21vw, 300px); }
</style>

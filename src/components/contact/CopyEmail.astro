---
interface Props { email: string }
const { email } = Astro.props;
---
<div class="ce" data-copy-email={email}>
  <a href={`mailto:${email}`} class="mono">{email}</a>
  <button type="button" aria-label="Copy email address">Copy</button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-copy-email]').forEach((el) => {
    const btn = el.querySelector('button')!; let t = 0;
    btn.addEventListener('click', () => {
      navigator.clipboard?.writeText(el.dataset.copyEmail!).catch(() => {});
      btn.textContent = '✓ Copied'; btn.classList.add('is-on'); clearTimeout(t);
      t = window.setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('is-on'); }, 1800);
    });
  });
</script>
<style>
  .ce { width: 100%; display: flex; align-items: center; gap: 8px; padding: 6px 6px 6px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); }
  a { flex: 1; min-width: 0; font-size: 14px; color: var(--white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } a:hover { color: var(--green); }
  button { height: 36px; padding: 0 12px; flex: none; border-radius: 9px; border: 1px solid var(--line); background: transparent; color: var(--text); font-size: 12.5px; font-weight: 500; cursor: pointer; transition: all .2s; }
  button.is-on { background: var(--green); border-color: var(--green); color: var(--bg); }
</style>

---
interface Props { id?: string; placeholder?: string; items?: { t: string; cat: string; href: string }[] }
const { id='search', placeholder='Search articles, features, docs…', items=[] } = Astro.props;
---
<button class="trigger" data-open={id}><span class="lens" aria-hidden="true"></span>{placeholder}<kbd>⌘K</kbd></button>
<dialog class="pl-dialog sd" id={id} aria-label="Search"><div class="box"><div class="row"><span class="lens"></span><input type="search" placeholder={placeholder} data-search-input autofocus /><button data-close>ESC</button></div><div class="res"><div class="pl-label" style="padding:8px 10px">Articles</div>{items.map(r => <a href={r.href} data-search-item={r.t.toLowerCase()}><span>{r.t}</span><em>{r.cat}</em></a>)}</div></div></dialog>
<script>
addEventListener('keydown', e => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); (document.querySelector('dialog.sd') as HTMLDialogElement)?.showModal(); } });
document.querySelectorAll<HTMLInputElement>('[data-search-input]').forEach(i => i.addEventListener('input', () => i.closest('dialog')!.querySelectorAll<HTMLElement>('[data-search-item]').forEach(a => a.hidden = !a.dataset.searchItem!.includes(i.value.toLowerCase()))));
</script>
<style>.trigger{font:inherit;cursor:pointer;display:flex;align-items:center;gap:10px;border:1px solid var(--pl-line);background:#fff;border-radius:12px;padding:12px 14px;font-size:15px;color:var(--pl-faint-2);width:100%;max-width:440px;text-align:left}kbd{margin-left:auto;font-family:var(--pl-mono);font-size:10px;border:1px solid var(--pl-line);border-radius:5px;padding:1px 6px}.lens{width:13px;height:13px;border-radius:50%;border:1.5px solid var(--pl-faint);flex:none}.sd{margin-top:12vh;width:min(100% - 32px,600px)}.row{display:flex;align-items:center;gap:12px;padding:6px 16px;border-bottom:1px solid var(--pl-line-soft)}.row input{flex:1;font:inherit;font-size:16px;border:none;outline:none;padding:12px 0}.row button{font-family:var(--pl-mono);font-size:10px;border:1px solid var(--pl-line);background:#fff;border-radius:5px;padding:2px 6px;cursor:pointer}.res{padding:8px}.res a{display:flex;justify-content:space-between;gap:12px;padding:10px;border-radius:10px;font-size:14px}.res a:hover{background:var(--pl-canvas)}.res em{font-style:normal;font-family:var(--pl-mono);font-size:10px;color:var(--pl-accent-ink)}</style>

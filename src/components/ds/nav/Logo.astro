---
interface Props { size?: number; href?: string }
const { size=21, href='/' } = Astro.props;
---
<a href={href} class="logo" aria-label="PriceLeap home" style={`--fs:${size}px`}><span class="bars" aria-hidden="true"><i></i><i></i><i><b></b></i></span><span>Price<span class="pl-grad">Leap</span></span></a>
<style>.logo{display:inline-flex;align-items:center;gap:9px;font-size:var(--fs);font-weight:600;letter-spacing:-.02em;color:var(--pl-ink)}.bars{display:flex;align-items:flex-end;gap:3px;height:22px}.bars i{display:block;width:5px;border-radius:2px}.bars i:nth-child(1){height:8px;background:#FF3131}.bars i:nth-child(2){height:13px;background:#F83A2E}.bars i:nth-child(3){height:13px;background:#EE2A22;position:relative}.bars b{position:absolute;left:0;top:-7px;width:5px;height:5px;border-radius:50%;background:#EE2A22}</style>

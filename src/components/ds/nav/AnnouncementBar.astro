---
interface Props { tag?: string; text: string; href?: string; cta?: string; variant?: 'dark'|'tint' }
const { tag='NEW', text, href, cta='Learn more →', variant='dark' } = Astro.props;
---
<div class={'ann ' + variant} role="region" aria-label="Announcement"><span class="tag">{tag}</span><span>{text}</span>{href && <a href={href}>{cta}</a>}</div>
<style>.ann{border-radius:10px;padding:10px 16px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;font-size:14px;text-align:center}.dark{background:var(--pl-on-accent);color:#fff}.dark a{color:#fff;text-decoration:underline;text-underline-offset:3px;font-weight:500}.tint{background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line)}.tint a{color:var(--pl-accent-ink);font-weight:500}.tag{font-family:var(--pl-mono);font-size:11px;letter-spacing:.08em;background:var(--pl-accent);color:var(--pl-on-accent);padding:2px 7px;border-radius:5px;font-weight:500}</style>

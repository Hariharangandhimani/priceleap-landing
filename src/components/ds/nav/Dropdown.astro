---
interface Props { label: string; options: string[]; name?: string }
const { label, options, name='dd' } = Astro.props;
---
<details class="dd"><summary aria-label={label}><span data-dd-val>{options[0]}</span><span class="c" aria-hidden="true">▾</span></summary>
<ul role="listbox">{options.map((o, i) => <li><button type="button" role="option" aria-selected={i===0 ? 'true' : 'false'} data-dd-opt={o}>{o}<span>✓</span></button></li>)}</ul><input type="hidden" name={name} value={options[0]} /></details>
<script>document.querySelectorAll<HTMLDetailsElement>('details.dd').forEach(d => d.querySelectorAll<HTMLElement>('[data-dd-opt]').forEach(b => b.addEventListener('click', () => { d.querySelector('[data-dd-val]')!.textContent = b.dataset.ddOpt!; d.querySelector('input')!.value = b.dataset.ddOpt!; d.querySelectorAll('[role=option]').forEach(x => x.setAttribute('aria-selected', String(x === b))); d.open = false; })));</script>
<style>.dd{position:relative;display:inline-block}summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid var(--pl-line);background:#fff;border-radius:11px;padding:10px 14px;font-size:14px;min-width:200px}summary::-webkit-details-marker{display:none}.c{font-size:10px;color:var(--pl-faint-2);transition:transform .2s}.dd[open] .c{transform:rotate(180deg)}ul{list-style:none;margin:0;position:absolute;left:0;top:calc(100% + 6px);min-width:220px;background:#fff;border:1px solid var(--pl-line);border-radius:12px;box-shadow:0 20px 40px -20px rgba(23,22,26,.35);padding:6px;z-index:20;animation:pl-pop .2s ease}button{font:inherit;width:100%;border:none;background:none;text-align:left;padding:9px 10px;border-radius:8px;font-size:14px;cursor:pointer;display:flex;justify-content:space-between;color:var(--pl-ink-2)}button span{opacity:0}[aria-selected=true]{background:var(--pl-accent-tint);color:var(--pl-accent-ink)}[aria-selected=true] span{opacity:1}</style>

---
interface Props { name: string; label: string; checked?: boolean }
const { name, label, checked=false } = Astro.props;
---
<label class="tg"><input type="checkbox" role="switch" name={name} checked={checked} /><span class="track" aria-hidden="true"><span class="thumb"></span></span>{label}</label>
<style>.tg{display:inline-flex;align-items:center;gap:10px;font-size:15px;cursor:pointer}input{position:absolute;opacity:0}.track{position:relative;width:40px;height:24px;border-radius:999px;background:var(--pl-line);transition:background .2s}.thumb{position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:left .2s}input:checked+.track{background:var(--pl-accent)}input:checked+.track .thumb{left:18px}input:focus-visible+.track{box-shadow:var(--pl-ring)}</style>

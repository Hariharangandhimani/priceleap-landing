---
interface Props { label?: string; name: string; type?: 'text' | 'email' | 'url' | 'number' | 'search' | 'tel' | 'password'; placeholder?: string; error?: string; textarea?: boolean; required?: boolean; value?: string; disabled?: boolean }
const { label, name, type='text', placeholder, error, textarea=false, required=false, value, disabled=false } = Astro.props;
const id = 'f-' + name; const errId = id + '-err';
---
<label class="pl-field" for={id}>
  {label && <span class="pl-field__label">{label}{required && <span aria-hidden="true"> *</span>}</span>}
  {textarea
    ? <textarea class="pl-input" id={id} name={name} placeholder={placeholder} required={required} rows="4" aria-invalid={!!error || undefined} aria-describedby={error ? errId : undefined} disabled={disabled}>{value}</textarea>
    : <input class="pl-input" id={id} name={name} type={type} placeholder={placeholder} required={required} value={value} aria-invalid={!!error || undefined} aria-describedby={error ? errId : undefined} disabled={disabled} />}
  <span class="pl-field__error" id={errId} data-error-for={name}>{error}</span>
</label>

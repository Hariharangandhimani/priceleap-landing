---
import Button from '@/components/ds/ui/Button.astro';
type V = 'primary'|'split'|'banner'|'minimal'|'accent-border'|'content'|'final';
interface Props { variant?: V; eyebrow?: string; title: string; accent?: string; body?: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string }; bullets?: string[]; decor?: boolean }
const { variant='primary', eyebrow, title, accent, body, primary={ label: 'Book a demo', href: '/demo' }, secondary, bullets=[], decor=true } = Astro.props;
---
{variant==='primary' && <section class="cta-p">{decor && <><div class="grid" aria-hidden="true"></div><div class="frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div><div class="glow" aria-hidden="true"></div></>}<div class="in"><h2>{title} {accent && <span class="pl-grad">{accent}</span>}</h2>{body && <p>{body}</p>}<div class="btns"><Button href={primary.href} size="lg">{primary.label}</Button>{secondary && <Button href={secondary.href} variant="secondary" size="lg">{secondary.label}</Button>}</div></div></section>}
{variant==='split' && <section class="pl-frame cta-s"><div class="l">{eyebrow && <span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">{eyebrow}</span></span>}<h2>{title} {accent && <span class="pl-grad">{accent}</span>}</h2>{body && <p>{body}</p>}<div class="btns"><Button href={primary.href}>{primary.label}</Button>{secondary && <Button href={secondary.href} variant="link">{secondary.label}</Button>}</div></div><div class="r"><slot name="visual" /></div></section>}
{variant==='banner' && <section class="cta-b"><span class="ic" aria-hidden="true">✓</span><div><strong>{title}</strong>{body && <span>{body}</span>}</div><Button href={primary.href}>{primary.label}</Button></section>}
{variant==='minimal' && <section class="pl-card cta-m"><strong>{title}</strong><Button href={primary.href} variant="link">{primary.label}</Button></section>}
{variant==='accent-border' && <section class="cta-a"><div><strong>{title}</strong>{body && <p>{body}</p>}<div class="btns"><Button href={primary.href} size="sm">{primary.label}</Button>{secondary && <Button href={secondary.href} variant="secondary" size="sm">{secondary.label}</Button>}</div></div></section>}
{variant==='content' && <aside class="pl-card cta-c"><div><span class="pl-label acc">{eyebrow ?? 'From this article'}</span><strong>{title}</strong>{body && <span>{body}</span>}</div><Button href={primary.href} size="sm">{primary.label}</Button></aside>}
{variant==='final' && <section class="pl-frame cta-f"><div><h2>{title} {accent && <span class="pl-grad">{accent}</span>}</h2><ul>{bullets.map(b => <li>{b}</li>)}</ul><div class="btns"><Button href={primary.href}>{primary.label}</Button>{secondary && <Button href={secondary.href} variant="secondary">{secondary.label}</Button>}</div></div><div class="nl"><slot name="aside" /></div></section>}
<style>
h2{margin:0;font-size:clamp(28px,4vw,48px);line-height:1.06;letter-spacing:-.035em;font-weight:500;text-wrap:balance}p{margin:0;font-size:15px;line-height:1.6;color:var(--pl-muted)}.btns{display:flex;gap:10px;flex-wrap:wrap}.acc{color:var(--pl-accent-ink)}
.cta-p{position:relative;overflow:hidden;background:#fff;border:1px solid var(--pl-line);border-radius:24px;padding:110px 32px;text-align:center}.cta-p .in{position:relative;display:flex;flex-direction:column;align-items:center;gap:28px}.grid{position:absolute;inset:0;background-image:linear-gradient(#efede8 1px,transparent 1px),linear-gradient(90deg,#efede8 1px,transparent 1px);background-size:40px 40px;background-position:center;mask-image:radial-gradient(ellipse 60% 70% at 50% 50%,#000 20%,transparent 75%)}.frame{position:absolute;left:50%;top:50%;width:min(72%,760px);height:62%;transform:translate(-50%,-50%);border:1px solid var(--pl-line);border-radius:4px}.frame i{position:absolute;width:14px;height:14px;border:0 solid var(--pl-accent)}.frame i:nth-child(1){left:-1px;top:-1px;border-width:1.5px 0 0 1.5px}.frame i:nth-child(2){right:-1px;top:-1px;border-width:1.5px 1.5px 0 0}.frame i:nth-child(3){left:-1px;bottom:-1px;border-width:0 0 1.5px 1.5px}.frame i:nth-child(4){right:-1px;bottom:-1px;border-width:0 1.5px 1.5px 0}.glow{position:absolute;left:50%;bottom:-160px;width:620px;height:320px;transform:translateX(-50%);background:radial-gradient(closest-side,rgba(24,229,99,.14),transparent)}
.cta-s{grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));border-radius:22px}.cta-s .l{padding:36px;display:flex;flex-direction:column;gap:14px}.cta-s h2{font-size:clamp(24px,3vw,34px)}.cta-s .r{background:var(--pl-surface-2)!important;padding:28px;display:flex;flex-direction:column;justify-content:center;gap:8px}
.cta-b{background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);border-radius:18px;padding:22px 26px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}.cta-b .ic{width:48px;height:48px;border-radius:13px;background:var(--pl-accent);color:var(--pl-on-accent);display:flex;align-items:center;justify-content:center;font-size:20px}.cta-b div{flex:1;min-width:240px;display:flex;flex-direction:column;gap:2px}.cta-b strong{font-size:19px}.cta-b span{font-size:14px;color:var(--pl-ink-2)}
.cta-m{padding:22px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.cta-m strong{font-size:17px;font-weight:500}
.cta-a{padding:1.5px;border-radius:18px;background:linear-gradient(135deg,#18E563,#b4f2c9 40%,#e4e2dc 70%,#18E563)}.cta-a>div{background:#fff;border-radius:16.5px;padding:22px;display:flex;flex-direction:column;gap:12px}.cta-a strong{font-size:18px}
.cta-c{padding:20px;display:flex;gap:16px;align-items:center;flex-wrap:wrap;border-left:3px solid var(--pl-accent)}.cta-c div{flex:1;min-width:200px;display:flex;flex-direction:column;gap:4px}.cta-c strong{font-size:17px}.cta-c span{font-size:13px;color:var(--pl-muted)}
.cta-f{grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));border-radius:22px}.cta-f>div{padding:32px;display:flex;flex-direction:column;gap:14px}.cta-f h2{font-size:clamp(24px,3vw,32px)}.cta-f ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;font-size:14px}.cta-f li::before{content:"✓ ";color:var(--pl-accent-ink)}.cta-f .nl{background:var(--pl-surface-2)!important;justify-content:center}
</style>

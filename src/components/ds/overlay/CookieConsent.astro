---
interface Props { policyHref?: string }
const { policyHref='/cookies' } = Astro.props;
---
<div class="cc" role="dialog" aria-label="Cookie consent" hidden data-cookie><strong>We use cookies</strong><p>To measure site performance and improve your experience. Read our <a href={policyHref}>cookie policy</a>.</p><div class="b"><button class="pl-btn pl-btn--primary pl-btn--sm" data-cc="all">Accept all</button><button class="pl-btn pl-btn--secondary pl-btn--sm" data-cc="none">Reject</button><a class="pl-btn pl-btn--secondary pl-btn--sm" href={policyHref}>Preferences</a></div></div>
<script>const cc = document.querySelector<HTMLElement>('[data-cookie]'); if (cc && !localStorage.getItem('pl-cookie')) { cc.hidden = false; cc.querySelectorAll<HTMLElement>('[data-cc]').forEach(b => b.addEventListener('click', () => { localStorage.setItem('pl-cookie', b.dataset.cc!); cc.hidden = true; })); }</script>
<style>.cc{position:fixed;left:16px;bottom:16px;z-index:95;width:min(calc(100% - 32px),400px);background:#fff;border:1px solid var(--pl-line);border-radius:16px;padding:18px;box-shadow:0 30px 60px -30px rgba(23,22,26,.45);animation:pl-pop .3s ease;display:flex;flex-direction:column;gap:12px}.cc[hidden]{display:none}p{margin:0;font-size:13px;color:var(--pl-muted);line-height:1.55}a{color:var(--pl-accent-ink)}.b{display:flex;gap:8px;flex-wrap:wrap}</style>

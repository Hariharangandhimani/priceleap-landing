---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<dialog class="pl-dialog pl-dialog--drawer dr" id={id} aria-labelledby={id + '-t'}><div class="wrap"><header><strong id={id + '-t'}>{title}</strong><button class="pl-iconbtn" data-close aria-label="Close">✕</button></header><div class="body"><slot /></div><footer><slot name="footer" /></footer></div></dialog>
<style>.wrap{display:flex;flex-direction:column;height:100%}header{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid var(--pl-line);background:#fff}header strong{font-size:16px}.body{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:14px}footer{padding:16px;border-top:1px solid var(--pl-line);background:#fff;display:grid;grid-template-columns:1fr 1fr;gap:10px}footer:empty{display:none}</style>

---
interface Props { action?: string }
const { action='/api/demo' } = Astro.props;
const steps = ['Work email','Company','Catalog','Goal'];
---
<form class="pl-frame ms" action={action} method="post" novalidate data-ms>
  <aside><span class="pl-eyebrow"><span class="pl-eyebrow__slash">//</span><span class="pl-eyebrow__label">Book a demo</span></span><strong>See PriceLeap on your catalog</strong><ol>{steps.map((s, i) => <li data-st={i}><span>0{i+1}</span>{s}</li>)}</ol></aside>
  <div class="main"><div class="bar"><i data-bar></i></div>
    <fieldset data-step="0"><legend>What's your work email?</legend><input class="pl-input" type="email" name="email" placeholder="you@company.com" required /></fieldset>
    <fieldset data-step="1" hidden><legend>Company name</legend><input class="pl-input" name="company" placeholder="Acme Retail" required minlength="2" /></fieldset>
    <fieldset data-step="2" hidden><legend>How many SKUs do you sell?</legend><div class="opts">{['< 1k','1k–10k','10k–50k','50k+'].map((o, i) => <label class="opt"><input type="radio" name="skus" value={o} checked={i===1} />{o}</label>)}</div></fieldset>
    <fieldset data-step="3" hidden><legend>Main goal</legend><div class="opts col">{['Competitor tracking','Dynamic pricing','MAP monitoring','All of the above'].map((o, i) => <label class="opt"><input type="radio" name="goal" value={o} checked={i===0} />{o}</label>)}</div></fieldset>
    <div class="done" hidden role="status"><span>✓</span><strong>Demo requested</strong><p>We'll email you within one business day.</p></div>
    <p class="err" role="alert" hidden></p>
    <div class="act"><button type="button" class="pl-btn pl-btn--secondary" data-back>← Back</button><button type="button" class="pl-btn pl-btn--primary" data-next>Continue →</button></div>
  </div>
</form>
<script>
document.querySelectorAll<HTMLFormElement>('[data-ms]').forEach(f => {
  let s = 0; const sets = [...f.querySelectorAll<HTMLFieldSetElement>('[data-step]')], next = f.querySelector<HTMLButtonElement>('[data-next]')!, err = f.querySelector<HTMLElement>('.err')!;
  const render = () => { sets.forEach((x, i) => x.hidden = i !== s); f.querySelectorAll<HTMLElement>('[data-st]').forEach((li, i) => { li.dataset.state = i < s ? 'done' : i === s ? 'active' : ''; }); f.querySelector<HTMLElement>('[data-bar]')!.style.width = (s / sets.length * 100) + '%'; next.textContent = s === sets.length - 1 ? 'Request demo →' : 'Continue →'; };
  next.addEventListener('click', async () => { const inp = sets[s].querySelector<HTMLInputElement>('input:not([type=radio])'); if (inp && !inp.checkValidity()) { err.textContent = inp.type === 'email' ? 'Enter a valid work email.' : 'Company name is required.'; err.hidden = false; inp.focus(); return; } err.hidden = true;
    if (s === sets.length - 1) { try { await fetch(f.action, { method: 'POST', body: new FormData(f) }); } catch {} sets.forEach(x => x.hidden = true); f.querySelector<HTMLElement>('.act')!.hidden = true; f.querySelector<HTMLElement>('.done')!.hidden = false; s = sets.length; render(); sets.forEach(x => x.hidden = true); return; }
    s++; render(); });
  f.querySelector('[data-back]')!.addEventListener('click', () => { s = Math.max(0, s - 1); err.hidden = true; render(); }); render();
});
</script>
<style>.ms{grid-template-columns:minmax(0,1fr) minmax(0,2fr);border-radius:20px}aside{background:var(--pl-surface-2)!important;padding:24px;display:flex;flex-direction:column;gap:16px}aside strong{font-size:22px;letter-spacing:-.02em;line-height:1.2}ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}li{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:500;color:var(--pl-faint)}li span{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--pl-line);background:#fff;font-family:var(--pl-mono);font-size:11px;display:flex;align-items:center;justify-content:center;transition:all .3s}li[data-state=active]{color:var(--pl-ink)}li[data-state=active] span{border-color:var(--pl-accent);color:var(--pl-accent-ink)}li[data-state=done]{color:var(--pl-ink)}li[data-state=done] span{background:var(--pl-accent);border-color:var(--pl-accent);color:var(--pl-on-accent);font-size:0}li[data-state=done] span::after{content:"✓";font-size:12px}.main{padding:28px;display:flex;flex-direction:column;gap:18px;min-height:340px}.bar{height:4px;border-radius:4px;background:var(--pl-line-soft)}.bar i{display:block;height:100%;border-radius:4px;background:var(--pl-accent);transition:width .4s}fieldset{border:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}legend{font-size:15px;font-weight:600;margin-bottom:10px}.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px}.col{grid-template-columns:1fr}.opt{border:1.5px solid var(--pl-line);border-radius:11px;padding:14px;font-size:15px;font-weight:500;cursor:pointer;display:flex;gap:10px;align-items:center}.opt:has(:checked){border-color:var(--pl-accent);background:var(--pl-accent-tint);color:var(--pl-accent-ink)}.opt input{accent-color:#18E563}.err{margin:0;border:1px solid var(--pl-danger-line);background:var(--pl-danger-tint);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--pl-danger-ink)}.act{margin-top:auto;display:flex;justify-content:space-between}.done{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;padding:20px 0;animation:pl-pop .35s ease}.done span{width:56px;height:56px;border-radius:16px;background:var(--pl-accent);color:var(--pl-on-accent);font-size:24px;display:flex;align-items:center;justify-content:center}.done p{margin:0;font-size:14px;color:var(--pl-muted)}[hidden]{display:none!important}@media (max-width:760px){.ms{grid-template-columns:1fr}}</style>

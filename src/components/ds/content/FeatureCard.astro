---
interface Props { title: string; body: string; icon?: 'square'|'circle'|'diamond'; n?: string; variant?: 'framed'|'numbered'|'spotlight'; href?: string }
const { title, body, icon='square', n, variant='framed', href } = Astro.props; const Tag = href ? 'a' : 'div';
---
<Tag class={'fc ' + variant + (variant==='numbered' ? ' pl-card pl-card--hover' : '')} href={href} data-spotlight={variant==='spotlight' || undefined}>
  {variant==='numbered' ? <div class="top"><span class="num">{n}</span><span aria-hidden="true" class="arr">↗</span></div> : <span class="ic"><span class={'shape ' + icon}></span></span>}
  <div><h3>{title}</h3><p>{body}</p></div><slot />
</Tag>
<script>document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach(el => el.addEventListener('pointermove', e => { const r = el.getBoundingClientRect(); el.style.setProperty('--x', ((e.clientX - r.left) / r.width * 100) + '%'); el.style.setProperty('--y', ((e.clientY - r.top) / r.height * 100) + '%'); }));</script>
<style>.fc{background:#fff;padding:26px;display:flex;flex-direction:column;gap:16px;color:var(--pl-ink);position:relative}.numbered{padding:22px}.ic{width:44px;height:44px;border-radius:12px;border:1px solid var(--pl-line-soft);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 20px -10px rgba(24,229,99,.5)}.shape{width:16px;height:16px;background:var(--pl-accent)}.square{border-radius:4px}.circle{border-radius:50%}.diamond{border-radius:2px;transform:rotate(45deg)}h3{margin:0;font-size:18px;font-weight:600;letter-spacing:-.01em}p{margin:6px 0 0;font-size:14px;line-height:1.55;color:var(--pl-muted)}.top{display:flex;justify-content:space-between}.num{width:30px;height:30px;border-radius:50%;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);color:var(--pl-accent-ink);font-family:var(--pl-mono);font-size:11px;display:flex;align-items:center;justify-content:center}.arr{color:#c9c7c0}.spotlight{border:1px solid var(--pl-line);border-radius:20px;overflow:hidden}.spotlight::before{content:"";position:absolute;inset:0;background:radial-gradient(260px circle at var(--x,50%) var(--y,50%),rgba(24,229,99,.14),transparent 60%);pointer-events:none}</style>

---
interface Props { items: { name: string; logo?: string; api?: string; connected?: boolean }[] }
const { items } = Astro.props;
---
<ul class="ig">{items.map(i => <li class={i.connected ? 'on' : ''}><span class="lg">{i.logo ? <img src={i.logo} alt="" width="22" height="22" loading="lazy" /> : i.name.slice(0,2)}</span><span><b>{i.name}</b>{i.api && <em>{i.api}</em>}{i.connected && <small>● Connected</small>}</span></li>)}</ul>
<style>.ig{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}li{display:flex;align-items:center;gap:12px;border:1px solid var(--pl-line-soft);background:#fff;border-radius:12px;padding:14px;transition:border-color .2s}li:hover,li.on{border-color:var(--pl-accent)}li.on{background:var(--pl-accent-tint)}.lg{width:40px;height:40px;border-radius:10px;border:1px solid var(--pl-line-soft);background:var(--pl-surface-2);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;flex:none}b{display:block;font-size:15px;font-weight:500}em{font-style:normal;font-family:var(--pl-mono);font-size:10px;letter-spacing:.08em;color:var(--pl-faint);border:1px solid var(--pl-line-soft);border-radius:5px;padding:1px 6px;margin-right:8px}small{font-family:var(--pl-mono);font-size:10px;color:var(--pl-accent-ink)}</style>

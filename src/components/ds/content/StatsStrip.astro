---
interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props;
---
<dl class="pl-frame st">{items.map(s => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}</dl>
<style>.st{margin:0;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));border-radius:18px}.st div{padding:24px;display:flex;flex-direction:column-reverse;gap:4px}dt{font-size:13px;color:var(--pl-muted)}dd{margin:0;font-size:34px;font-weight:600;letter-spacing:-.03em}</style>

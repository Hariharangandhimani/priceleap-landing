---
import Button from '@/components/ds/ui/Button.astro';
interface Props { variant?: 'centered'|'split'|'product'; pill?: string; title: string; accent?: string; lead?: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string }; visualLabel?: string }
const { variant='centered', pill, title, accent, lead, primary={ label: 'Book a demo', href: '/book-a-demo' }, secondary, visualLabel='product visual' } = Astro.props;
---
<section class={'hero ' + variant}>
  {variant==='centered' && <div class="dots" aria-hidden="true"></div>}
  <div class="copy">
    {pill && <span class="pill">{pill}<span aria-hidden="true">›</span></span>}
    <h1>{title} {accent && <span class="pl-grad">{accent}</span>}</h1>
    {lead && <p>{lead}</p>}
    <div class="ctas"><Button href={primary.href} size="lg">{primary.label}</Button>{secondary && <Button href={secondary.href} variant="secondary" size="lg">{secondary.label}</Button>}</div>
    <slot name="below" />
  </div>
  {variant!=='centered' && <div class="visual"><slot name="visual"><div class="pl-placeholder" style="height:100%;min-height:280px"><span>{visualLabel}</span></div></slot></div>}
</section>
<style>.hero{position:relative;padding:96px var(--pl-gutter) 72px;border-bottom:1px solid var(--pl-line);overflow:hidden}.dots{position:absolute;inset:0;background-image:radial-gradient(#d6d3cb 1px,transparent 1px);background-size:22px 22px;mask-image:radial-gradient(ellipse at 50% 40%,#000,transparent 70%);opacity:.7}.copy{position:relative;display:flex;flex-direction:column;gap:22px}.centered .copy{align-items:center;text-align:center}h1{margin:0;font-size:var(--pl-fs-display);line-height:1.02;letter-spacing:-.035em;font-weight:500;max-width:980px;text-wrap:balance}.split h1,.product h1{font-size:var(--pl-fs-h1)}p{margin:0;font-size:19px;line-height:1.6;color:#55545b;max-width:680px}.ctas{display:flex;gap:12px;flex-wrap:wrap}.pill{display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--pl-line);border-radius:999px;padding:6px 8px 6px 14px;font-size:13px}.pill span{width:20px;height:20px;border-radius:50%;background:var(--pl-accent);display:flex;align-items:center;justify-content:center;font-size:11px}.split{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:48px;align-items:center}.product .copy{align-items:center;text-align:center}.product .visual{margin-top:48px;border:1px solid var(--pl-line);border-radius:20px;overflow:hidden;box-shadow:var(--pl-shadow-lg)}</style>

---
interface T { quote: string; role: string; industry: string; initials: string; stat?: string; statLabel?: string; name?: string; photo?: string }
interface Props { items: T[]; variant?: 'selector'|'cards'|'pull' }
const { items, variant='selector' } = Astro.props;
---
{variant==='selector' && <div class="pl-frame sel" data-tsel>
  <div class="list">{items.map((t, i) => <button aria-pressed={i===0 ? 'true' : 'false'} data-i={i}><span class="av">{t.initials}</span><span><b>{t.role}</b><small>{t.industry}</small></span></button>)}</div>
  <div class="panel">{items.map((t, i) => <figure hidden={i!==0} data-p={i}><div class="top"><span class="stars" aria-label="5 out of 5">★★★★★</span><span class="pl-label">0{i+1} / 0{items.length}</span></div><blockquote>“{t.quote}”</blockquote><figcaption>{t.role} · {t.industry}</figcaption></figure>)}</div>
  {items.some(t => t.stat) && <div class="stats">{items.map((t, i) => <button aria-pressed={i===0 ? 'true' : 'false'} data-i={i}><b>{t.stat}</b><span class="pl-label">{t.statLabel}</span></button>)}</div>}
</div>}
{variant==='cards' && <div class="cards">{items.map(t => <figure class="pl-card c">{t.stat && <div class="ct"><div><b>{t.stat}</b><span class="pl-label acc">{t.statLabel}</span></div><span class="stars">★★★★★</span></div>}<blockquote>“{t.quote}”</blockquote><figcaption><span class="av">{t.initials}</span><span><b>{t.role}</b><small>{t.industry}</small></span></figcaption></figure>)}</div>}
{variant==='pull' && items[0] && <figure class="pull"><blockquote><span>“</span>{items[0].quote}<span>”</span></blockquote><figcaption>{items[0].photo ? <img src={items[0].photo} alt="" /> : <span class="ph">photo</span>}<span><b>{items[0].name ?? items[0].role}</b><small>{items[0].role}, {items[0].industry}</small></span></figcaption></figure>}
<script>document.querySelectorAll<HTMLElement>('[data-tsel]').forEach(r => r.querySelectorAll<HTMLElement>('button[data-i]').forEach(b => b.addEventListener('click', () => { const i = b.dataset.i; r.querySelectorAll('button[data-i]').forEach(x => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.i === i))); r.querySelectorAll<HTMLElement>('[data-p]').forEach(p => p.hidden = p.dataset.p !== i); })));</script>
<style>
.stars{color:var(--pl-accent);letter-spacing:2px}.av{width:42px;height:42px;flex:none;border-radius:12px;background:#fff;border:1px solid var(--pl-line);color:var(--pl-faint);font-family:var(--pl-mono);font-size:13px;display:flex;align-items:center;justify-content:center;transition:all .3s}small{display:block;font-family:var(--pl-mono);font-size:10px;letter-spacing:.1em;color:var(--pl-faint);text-transform:uppercase}blockquote{margin:0}
.sel{grid-template-columns:340px minmax(0,1fr);border-radius:22px}.list{display:flex;flex-direction:column;gap:1px;background:var(--pl-line)!important}.list button{flex:1;font:inherit;text-align:left;border:none;background:var(--pl-surface-2);padding:22px;display:flex;align-items:center;gap:14px;cursor:pointer;position:relative}.list button::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px}.list [aria-pressed=true]{background:#fff}.list [aria-pressed=true]::before{background:var(--pl-accent)}.list [aria-pressed=true] .av{background:var(--pl-accent);border-color:var(--pl-accent);color:var(--pl-on-accent)}
.panel{padding:40px 44px;min-height:360px}.panel figure{margin:0;display:flex;flex-direction:column;gap:22px;height:100%;animation:pl-fade .3s ease}.top{display:flex;justify-content:space-between}.panel blockquote{font-size:22px;line-height:1.5;font-weight:500;letter-spacing:-.01em;flex:1}figcaption{font-size:14px;color:var(--pl-muted)}
.stats{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--pl-line)!important}.stats button{font:inherit;border:none;background:#fff;padding:22px 24px;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:4px}.stats b{font-size:30px;letter-spacing:-.03em}.stats [aria-pressed=true]{background:var(--pl-accent-tint)}.stats [aria-pressed=true] b{color:var(--pl-accent-ink)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:12px}.c{margin:0;padding:24px;display:flex;flex-direction:column;gap:16px}.ct{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:16px;border-bottom:1px dashed var(--pl-line)}.ct b{display:block;font-size:28px;letter-spacing:-.03em}.acc{color:var(--pl-accent-ink)}.c blockquote{font-size:15px;line-height:1.65;color:var(--pl-ink-2);flex:1}.c figcaption{display:flex;align-items:center;gap:12px}.c .av{background:var(--pl-accent-tint);border-color:var(--pl-accent-line);color:var(--pl-accent-ink)}
.pull{margin:0;display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:40px;align-items:end}.pull blockquote{font-size:clamp(26px,3.2vw,38px);line-height:1.25;letter-spacing:-.02em;font-weight:500}.pull blockquote span{color:var(--pl-accent)}.pull figcaption{display:flex;align-items:center;gap:14px}.pull img,.ph{width:56px;height:56px;border-radius:50%}.ph{border:1px dashed #c9c7c0;display:flex;align-items:center;justify-content:center;font-family:var(--pl-mono);font-size:10px;color:var(--pl-faint-2)}
@media (max-width:900px){.sel{grid-template-columns:1fr}.panel{padding:28px 22px}.panel blockquote{font-size:18px}.pull{grid-template-columns:1fr}}@media (max-width:640px){.stats{grid-template-columns:1fr}}
</style>

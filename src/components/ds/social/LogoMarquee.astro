---
interface Props { logos: { src?: string; alt: string }[]; title?: string; body?: string; speed?: number; grayscale?: boolean }
const { logos, title, body, speed=28, grayscale=true } = Astro.props; const row = [...logos, ...logos];
---
<section class="lm" aria-label={title ?? 'Logos'}>{title && <div class="intro"><b><span class="ck">✓</span>{title}</b>{body && <span>{body}</span>}</div>}
  <div class="track"><div class="row" style={`--d:${speed}s`}>{[...row, ...row].map((l, i) => <div class="cell" aria-hidden={i >= logos.length || undefined}>{l.src ? <img src={l.src} alt={i < logos.length ? l.alt : ''} class={grayscale ? 'gs' : ''} loading="lazy" /> : <span class="wm">{l.alt}</span>}</div>)}</div></div></section>
<style>.lm{display:grid;grid-template-columns:300px minmax(0,1fr);border-bottom:1px solid var(--pl-line)}.intro{padding:22px 28px;display:flex;flex-direction:column;gap:6px;justify-content:center;border-right:1px solid var(--pl-line);background:var(--pl-surface-2)}.intro b{display:flex;gap:8px;align-items:center;font-size:15px}.intro span{font-size:13px;line-height:1.5;color:var(--pl-muted)}.ck{width:16px;height:16px;border-radius:50%;background:var(--pl-accent);color:var(--pl-on-accent);font-size:9px;display:inline-flex;align-items:center;justify-content:center}.track{overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}.row{display:flex;width:max-content;animation:pl-marquee var(--d) linear infinite}.track:hover .row{animation-play-state:paused}.cell{flex:none;width:240px;height:96px;border-right:1px solid var(--pl-line);display:flex;align-items:center;justify-content:center;background:#fff}img{max-height:44px;max-width:150px;object-fit:contain}.gs{filter:grayscale(1);opacity:.75;transition:filter .3s,opacity .3s}.cell:hover .gs{filter:none;opacity:1}.wm{font-size:17px;font-weight:600;color:var(--pl-faint)}@media (max-width:860px){.lm{grid-template-columns:1fr}.intro{border-right:none;border-bottom:1px solid var(--pl-line)}}</style>

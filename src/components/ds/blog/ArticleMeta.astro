---
interface Props { author: string; role?: string; reviewer?: { name: string; role: string }; published: string; updated?: string; readTime: string; initials?: string }
const { author, role, reviewer, published, updated, readTime, initials } = Astro.props; const ini = (n: string) => n.split(' ').map(x => x[0]).join('').slice(0,2);
---
<div class="am"><div class="p"><span class="av">{initials ?? ini(author)}</span><div><span class="pl-label">Written by</span><b>{author}</b>{role && <span class="r"> · {role}</span>}</div></div>
{reviewer && <div class="p"><span class="av">{ini(reviewer.name)}</span><div><span class="pl-label">Reviewed by</span><b>{reviewer.name}</b><span class="r"> · {reviewer.role}</span></div></div>}
<div class="m"><time datetime={published}>Published {published}</time>{updated && <time datetime={updated}>Updated {updated}</time>}<span class="rt"><span class="ring" aria-hidden="true"></span>{readTime} read</span></div></div>
<style>.am{display:flex;gap:24px;flex-wrap:wrap;align-items:center}.p{display:flex;gap:10px;align-items:center}.p div{display:flex;flex-direction:column}.av{width:38px;height:38px;border-radius:50%;background:var(--pl-accent-tint);border:1px solid var(--pl-accent-line);color:var(--pl-accent-ink);font-family:var(--pl-mono);font-size:11px;display:flex;align-items:center;justify-content:center}b{font-size:14px}.r{font-size:13px;color:var(--pl-muted)}.m{margin-left:auto;display:flex;gap:14px;flex-wrap:wrap;font-family:var(--pl-mono);font-size:11px;color:var(--pl-faint);text-transform:uppercase}.rt{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--pl-line);border-radius:999px;padding:3px 10px}.ring{width:10px;height:10px;border-radius:50%;border:1.5px solid var(--pl-accent);border-right-color:transparent}</style>

---
interface Props { name: string; role: string; bio: string; photo?: string; href?: string; linkedin?: string; label?: string }
const { name, role, bio, photo, href, linkedin, label='Written by' } = Astro.props;
---
<aside class="pl-card au" itemscope itemtype="https://schema.org/Person">{photo ? <img src={photo} alt={name} width="64" height="64" itemprop="image" /> : <span class="ph">photo</span>}<div><span class="pl-label acc">{label}</span><strong itemprop="name">{name}</strong><span class="role" itemprop="jobTitle">{role}</span><p>{bio}</p><div class="lk">{href && <a href={href}>All articles →</a>}{linkedin && <a href={linkedin} rel="me">LinkedIn</a>}</div></div></aside>
<style>.au{display:flex;gap:16px;align-items:flex-start;padding:22px}img,.ph{width:64px;height:64px;flex:none;border-radius:16px;object-fit:cover}.ph{border:1px dashed var(--pl-line-strong);background:repeating-linear-gradient(135deg,#f3f1ec 0 6px,#fbfaf8 6px 12px);display:flex;align-items:center;justify-content:center;font-family:var(--pl-mono);font-size:9px;color:var(--pl-faint)}div{display:flex;flex-direction:column;gap:4px}.acc{color:var(--pl-accent-ink)}strong{font-size:17px}.role{font-size:13px;color:var(--pl-faint)}p{margin:2px 0 0;font-size:14px;line-height:1.55;color:var(--pl-muted)}.lk{flex-direction:row;gap:12px;font-size:13px}.lk a:first-child{color:var(--pl-accent-ink);font-weight:500}</style>

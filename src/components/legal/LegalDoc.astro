---
/**
 * LegalDoc — shared renderer for /privacy-policy and /terms.
 * Sticky TOC (scroll-spy), reading progress + back-to-top ring (reuse global
 * --pl-scroll / data-scrolled-900 from ui.ts), print, smooth anchor scroll.
 */
import type { LegalDoc } from '@/data/legal';
interface Props { doc: LegalDoc }
const { doc } = Astro.props;

const words = JSON.stringify(doc.secs).split(/\s+/).length + doc.intro.join(' ').split(/\s+/).length;
const readTime = Math.max(1, Math.round(words / 230)) + ' min read';

const splitItem = (item: string) => {
  const parts = item.split(' — ');
  return parts.length > 1 ? { term: parts[0], rest: parts.slice(1).join(' — ') } : { term: '', rest: item };
};
---

<!-- Reading progress (driven by global --pl-scroll) -->
<div class="lg-progress" aria-hidden="true"><i></i></div>

<!-- Hero -->
<section class="lg-hero">
  <div class="lg-hero__grid" aria-hidden="true"></div>
  <div class="lg-wrap lg-hero__inner">
    <div>
      <span class="lg-eyebrow"><span class="lg-eyebrow__dot"></span>Legal</span>
      <h1 class="lg-h1"><span class="w4">{doc.t1} </span><b>{doc.t2}</b></h1>
      <p class="lg-lead">{doc.lead}</p>
    </div>
    <div class="lg-meta">
      <div class="lg-meta__row"><span class="lg-meta__k">Sections</span><span class="lg-meta__v">{doc.secs.length}</span></div>
      <div class="lg-meta__row"><span class="lg-meta__k">Reading time</span><span class="lg-meta__v">{readTime}</span></div>
      <div class="lg-meta__row"><span class="lg-meta__k">Updated</span><span class="lg-meta__v">{doc.updated.replace('Last updated: ', '')}</span></div>
      <div class="lg-meta__actions">
        <button type="button" class="lg-print" onclick="window.print()">Print</button>
        <a href={doc.otherHref} class="lg-other">{doc.other} →</a>
      </div>
    </div>
  </div>
</section>

<!-- Body -->
<section class="lg-body">
  <div class="lg-wrap lg-body__inner">

    <!-- TOC -->
    <nav class="lg-toc" aria-label="On this page" data-legal-toc>
      <span class="lg-toc__lbl">On this page</span>
      <ol>
        {doc.secs.map((sec, i) => (
          <li>
            <a href={`#s${i + 1}`} data-toc-link={`s${i + 1}`}>
              <span class="lg-toc__n">{String(i + 1).padStart(2, '0')}</span>
              <span>{sec.short || sec.t}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <!-- Content -->
    <article class="lg-content">
      {doc.intro.length > 0 && (
        <div class="lg-intro">
          {doc.intro.map(p => <p>{p}</p>)}
        </div>
      )}

      {doc.secs.map((sec, i) => (
        <section id={`s${i + 1}`} class="lg-sec">
          {sec.group && <div class="lg-group">{sec.group}</div>}
          <div class="lg-sec__head">
            <span class="lg-sec__lab">{sec.lab || `Section ${String(i + 1).padStart(2, '0')}`}</span>
            <h2 class="lg-h2">{sec.t}</h2>
          </div>
          {sec.b.map(block => {
            if (block.h) return <h3 class="lg-h3">{block.h}</h3>;
            if (block.list) return (
              <ul class={`lg-list${block.indent ? ' lg-list--indent' : ''}${block.ordered ? ' lg-list--ordered' : ''}`}>
                {block.list.map((item, k) => {
                  const { term, rest } = splitItem(item);
                  return (
                    <li>
                      <span class="lg-list__mk">{block.ordered ? k + 1 : '→'}</span>
                      <span>{term && <b>{term} — </b>}{rest}</span>
                    </li>
                  );
                })}
              </ul>
            );
            if (block.n) return <div class="lg-clause"><span class="lg-clause__n">{block.n}</span><p>{block.p}</p></div>;
            return <p class="lg-p">{block.p}</p>;
          })}
        </section>
      ))}
    </article>
  </div>
</section>

<!-- Back to top with progress ring -->
<button type="button" class="lg-top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">
  <svg viewBox="0 0 44 44" aria-hidden="true"><circle class="lg-top__track" cx="22" cy="22" r="21"/><circle class="lg-top__ring" cx="22" cy="22" r="21"/></svg>
  <span class="lg-top__arrow" aria-hidden="true">↑</span>
</button>

<script>
  // TOC scroll-spy only (progress + back-to-top are pure CSS via --pl-scroll / data-scrolled-900).
  const toc = document.querySelector<HTMLElement>('[data-legal-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLElement>('[data-toc-link]')];
    const byId = new Map(links.map(l => [l.dataset.tocLink!, l]));
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          links.forEach(l => l.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      });
    }, { rootMargin: '-100px 0px -70% 0px' });
    links.forEach(l => { const t = document.getElementById(l.dataset.tocLink!); if (t) io.observe(t); });
  }
</script>

<style>
.lg-wrap { max-width: var(--pl-container); margin: 0 auto; padding-left: var(--pl-gutter); padding-right: var(--pl-gutter); }

/* reading progress */
.lg-progress { position: fixed; left: 0; top: 0; right: 0; height: 3px; z-index: 90; background: transparent; pointer-events: none; }
.lg-progress i { display: block; height: 100%; width: calc(var(--pl-scroll, 0) * 100%); background: #FF3131; }

/* eyebrow / headings */
.lg-eyebrow { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border-radius: 999px; background: #fff; border: 1px solid var(--pl-line); font-family: var(--pl-mono); font-size: 11.5px; letter-spacing: .1em; text-transform: uppercase; color: #B01C1C; }
.lg-eyebrow__dot { width: 7px; height: 7px; border-radius: 50%; background: #FF3131; animation: pl-pulse 1.8s infinite; }

/* hero */
.lg-hero { position: relative; border-bottom: 1px solid var(--pl-line); overflow: hidden; }
.lg-hero__grid { position: absolute; inset: 0; background-image: linear-gradient(#EEF0EE 1px,transparent 1px),linear-gradient(90deg,#EEF0EE 1px,transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 60% 70% at 20% 30%,#000 10%,transparent 70%); mask-image: radial-gradient(ellipse 60% 70% at 20% 30%,#000 10%,transparent 70%); pointer-events: none; }
.lg-hero__inner { position: relative; display: grid; grid-template-columns: minmax(0,1fr) auto; gap: clamp(32px,5vw,64px); align-items: end; padding-top: clamp(48px,7vw,88px); padding-bottom: clamp(36px,5vw,56px); }
.lg-h1 { margin: 20px 0 0; font-family: var(--pl-font); font-size: clamp(40px,5.4vw,72px); line-height: 1; letter-spacing: -.045em; color: #0A0A0A; font-weight: 700; }
.lg-h1 .w4 { font-weight: 400; }
.lg-lead { margin: 20px 0 0; max-width: 560px; font-size: 17px; line-height: 1.6; color: #3A414C; }
.lg-meta { border: 1px solid var(--pl-line); border-radius: 18px; background: #fff; padding: 20px; min-width: 240px; }
.lg-meta__row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #EEF0EE; }
.lg-meta__k { font-size: 13px; color: #5A6373; }
.lg-meta__v { font-family: var(--pl-mono); font-size: 13px; color: #0A0A0A; }
.lg-meta__actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; }
.lg-print { height: 36px; padding: 0 16px; border: 1px solid var(--pl-line); border-radius: 10px; background: #fff; font-family: var(--pl-font); font-weight: 500; font-size: 13px; cursor: pointer; }
.lg-print:hover { border-color: #0A0A0A; }
.lg-other { font-family: var(--pl-mono); font-size: 12px; color: #B01C1C; }

/* body layout */
.lg-body { padding: clamp(40px,5vw,64px) 0 clamp(64px,8vw,104px); }
.lg-body__inner { display: grid; grid-template-columns: 260px minmax(0,1fr); gap: clamp(32px,5vw,64px); align-items: start; }

/* TOC */
.lg-toc { position: sticky; top: 90px; max-height: calc(100vh - 120px); overflow-y: auto; }
.lg-toc__lbl { display: block; font-family: var(--pl-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #5A6373; margin-bottom: 14px; }
.lg-toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
.lg-toc a { display: flex; gap: 12px; align-items: baseline; padding: 8px 10px 8px 14px; border-left: 2px solid transparent; border-radius: 0 8px 8px 0; font-size: 14px; line-height: 1.4; color: #5A6373; transition: all .2s; }
.lg-toc a:hover { color: #0A0A0A; background: #FBFBFA; }
.lg-toc__n { font-family: var(--pl-mono); font-size: 10px; color: #A3ABB8; flex: none; }
.lg-toc a[aria-current] { border-left-color: #FF3131; color: #0A0A0A; font-weight: 500; background: #F4FDF7; }
.lg-toc a[aria-current] .lg-toc__n { color: #B01C1C; }

/* content */
.lg-content { min-width: 0; max-width: 760px; }
.lg-intro { border: 1px solid var(--pl-line); border-radius: 18px; background: #FBFBFA; padding: 24px; margin-bottom: 40px; }
.lg-intro p { margin: 0 0 14px; font-size: 16px; line-height: 1.7; color: #3A414C; }
.lg-intro p:last-child { margin-bottom: 0; }
.lg-sec { padding: 28px 0; border-top: 1px solid #EEF0EE; scroll-margin-top: 100px; }
.lg-sec:first-of-type { border-top: none; padding-top: 0; }
.lg-group { font-family: var(--pl-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #B01C1C; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px dashed #FFD6C8; }
.lg-sec__lab { font-family: var(--pl-mono); font-size: 11px; letter-spacing: .08em; color: #A3ABB8; }
.lg-h2 { margin: 8px 0 18px; font-family: var(--pl-font); font-size: clamp(22px,2.6vw,28px); font-weight: 600; letter-spacing: -.02em; color: #0A0A0A; }
.lg-h3 { margin: 22px 0 12px; font-family: var(--pl-font); font-size: 17px; font-weight: 600; color: #0A0A0A; }
.lg-p { margin: 0 0 16px; font-size: 16px; line-height: 1.7; color: #3A414C; }
.lg-clause { display: grid; grid-template-columns: 44px minmax(0,1fr); gap: 12px; margin: 0 0 16px; }
.lg-clause__n { font-family: var(--pl-mono); font-size: 13px; color: #B01C1C; padding-top: 2px; }
.lg-clause p { margin: 0; font-size: 16px; line-height: 1.7; color: #3A414C; }
.lg-list { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.lg-list--indent { padding-left: 24px; }
.lg-list li { display: grid; grid-template-columns: 24px minmax(0,1fr); gap: 12px; align-items: start; font-size: 16px; line-height: 1.6; color: #3A414C; }
.lg-list__mk { width: 24px; height: 24px; flex: none; border-radius: 7px; background: #E8FCEF; border: 1px solid #FFD6C8; color: #B01C1C; font-family: var(--pl-mono); font-size: 11px; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
.lg-list--ordered .lg-list__mk { background: #F4F5F4; border-color: var(--pl-line); color: #3A414C; }
.lg-list li b { color: #0A0A0A; font-weight: 600; }

/* back to top */
.lg-top { position: fixed; right: 24px; bottom: 24px; z-index: 80; width: 48px; height: 48px; border: none; border-radius: 50%; background: #fff; box-shadow: 0 16px 36px -16px rgba(23,22,26,.4); cursor: pointer; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .25s, transform .25s, visibility .25s; }
:global(html[data-scrolled-900]) .lg-top { opacity: 1; visibility: visible; transform: none; }
.lg-top svg { position: absolute; inset: 0; width: 48px; height: 48px; transform: rotate(-90deg); }
.lg-top__track { fill: none; stroke: #EEF0EE; stroke-width: 2; }
.lg-top__ring { fill: none; stroke: #FF3131; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 131.9; stroke-dashoffset: calc(131.9 * (1 - var(--pl-scroll, 0))); }
.lg-top__arrow { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; color: #0A0A0A; }

@media (max-width: 999px) {
  .lg-hero__inner { grid-template-columns: 1fr; align-items: start; }
  .lg-meta { min-width: 0; }
  .lg-body__inner { grid-template-columns: 1fr; }
  .lg-toc { position: relative; top: 0; max-height: none; border: 1px solid var(--pl-line); border-radius: 16px; padding: 18px; background: #FBFBFA; }
}
@media print {
  .lg-progress, .lg-top, .lg-toc { display: none !important; }
  .lg-body__inner { grid-template-columns: 1fr; }
}
</style>

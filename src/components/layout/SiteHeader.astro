---
import { MEGA_MENUS } from '@/data/nav';
---

<header class="site-header sticky top-0 z-50 border-b border-[var(--pl-line)] bg-white" data-site-header>
  <a class="pl-skip-link" href="#main-content">Skip to content</a>

  <div class="pl-container relative flex min-h-[76px] items-center justify-between gap-6">
    <a class="shrink-0" href="/" aria-label="PriceLeap home">
      <img src="/assets/priceleap-logo.png" alt="PriceLeap" width="154" height="29" class="h-auto w-[154px]" fetchpriority="high" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {MEGA_MENUS.map((menu) => (
        <details class="group relative" data-menu-details>
          <summary class="flex cursor-pointer list-none items-center gap-1 rounded-lg px-4 py-2.5 text-[15px] font-medium text-[var(--pl-ink)] transition hover:bg-[var(--pl-canvas)] [&::-webkit-details-marker]:hidden">
            {menu.label}
            <span class="text-xs text-[var(--pl-muted)] transition group-open:rotate-180" aria-hidden="true">⌄</span>
          </summary>

          <div class="mega-panel absolute left-1/2 top-[calc(100%+14px)] w-[min(1110px,calc(100vw-32px))] -translate-x-1/2 overflow-y-auto rounded-[20px] border border-[var(--pl-line)] bg-white shadow-[0_28px_80px_rgba(17,17,24,0.16)]" role="region" aria-label={`${menu.label} menu`}>
            <div class="h-1 bg-[var(--pl-grad-text)]"></div>

            <div class="flex items-start justify-between gap-8 border-b border-[var(--pl-line)] px-7 py-5">
              <div>
                <p class="l-eyebrow text-[var(--pl-red)]">{menu.eyebrow}</p>
                <p class="mt-2 max-w-2xl text-[15px] leading-6 text-[var(--pl-muted)]">{menu.intro}</p>
              </div>
              <a class="hidden shrink-0 items-center gap-1 pt-1 text-sm font-semibold text-[var(--pl-red)] sm:inline-flex" href={menu.href}>
                View all {menu.label} <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="grid grid-cols-[minmax(0,1fr)_280px]">
              <div class="grid grid-cols-2 gap-x-7 gap-y-8 p-7">
                {menu.columns.map((column, columnIndex) => (
                  <section>
                    <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--pl-muted)]">{column.title}</h2>
                    <div class="mt-3 space-y-1">
                      {column.links.map((link, linkIndex) => (
                        <a class="menu-link group/link flex items-start gap-3 rounded-xl px-2.5 py-2.5 transition hover:bg-[var(--pl-canvas)]" href={link.href}>
                          <span class={`menu-icon menu-icon-${(columnIndex + linkIndex) % 4}`} aria-hidden="true">
                            <span></span><span></span><span></span><span></span>
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="flex items-center gap-2 text-sm font-semibold leading-5 text-[var(--pl-ink)]">
                              {link.label}
                              {link.tag && <span class="rounded-full bg-[#fff0eb] px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.08em] text-[var(--pl-red)]">{link.tag}</span>}
                              <span class="ml-auto translate-x-[-4px] text-[var(--pl-red)] opacity-0 transition group-hover/link:translate-x-0 group-hover/link:opacity-100" aria-hidden="true">↗</span>
                            </span>
                            {link.description && <span class="mt-0.5 block text-xs leading-5 text-[var(--pl-muted)]">{link.description}</span>}
                          </span>
                        </a>
                      ))}
                    </div>
                  </section>
                ))}
              </div>

              <aside class="border-l border-[var(--pl-line)] bg-[linear-gradient(160deg,#fff8f5_0%,#fff_52%,#fff2ed_100%)] p-6">
                <p class="l-eyebrow text-[var(--pl-red)]">{menu.featured.eyebrow}</p>
                <div class="mt-5 rounded-2xl bg-[var(--pl-ink)] p-5 text-white shadow-[0_14px_30px_rgba(17,17,24,0.16)]">
                  <div class="flex items-center justify-between gap-3">
                    <span class="menu-feature-mark" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="text-xl text-[var(--pl-orange)]" aria-hidden="true">↗</span>
                  </div>
                  <h2 class="mt-10 text-xl font-semibold leading-7 tracking-[-0.03em]">{menu.featured.title}</h2>
                  <p class="mt-3 text-sm leading-6 text-white/65">{menu.featured.body}</p>
                  <a class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-[var(--pl-orange)]" href={menu.featured.href}>
                    {menu.featured.cta} <span aria-hidden="true">→</span>
                  </a>
                </div>
                <a class="mt-5 flex items-center justify-between border-t border-[#ffd7ca] pt-4 text-sm font-semibold text-[var(--pl-ink)]" href="/book-a-demo">
                  Talk to a pricing specialist <span class="text-[var(--pl-red)]" aria-hidden="true">→</span>
                </a>
              </aside>
            </div>

            <div class="flex items-center justify-between gap-4 border-t border-[var(--pl-line)] bg-[var(--pl-canvas)] px-7 py-3 text-xs text-[var(--pl-muted)]">
              <span>Real-time intelligence for pricing, revenue, and ecommerce teams.</span>
              <a class="shrink-0 font-semibold text-[var(--pl-red)]" href={menu.href}>Explore {menu.label} →</a>
            </div>
          </div>
        </details>
      ))}

      <a class="rounded-lg px-4 py-2.5 text-[15px] font-medium text-[var(--pl-ink)] transition hover:bg-[var(--pl-canvas)]" href="/pricing">Pricing</a>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a class="text-sm font-semibold text-[var(--pl-ink)] transition hover:text-[var(--pl-red)]" href="https://app.priceleap.ai">Sign in</a>
      <a class="pl-button pl-button-primary px-5 py-3 text-sm" href="/book-a-demo">Book a demo</a>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-[var(--pl-line)] text-[var(--pl-ink)] [&::-webkit-details-marker]:hidden" aria-label="Open navigation">
        <span class="text-xl leading-none group-open:hidden" aria-hidden="true">☰</span>
        <span class="hidden text-xl leading-none group-open:inline" aria-hidden="true">×</span>
      </summary>
      <div class="absolute right-0 top-[calc(100%+12px)] max-h-[calc(100vh-92px)] w-[min(360px,calc(100vw-32px))] overflow-y-auto rounded-2xl border border-[var(--pl-line)] bg-white p-3 shadow-[0_24px_70px_rgba(17,17,24,0.14)]">
        {MEGA_MENUS.map((menu) => (
          <details class="border-b border-[var(--pl-line)] last:border-b-0">
            <summary class="flex cursor-pointer list-none items-center justify-between px-3 py-3 text-sm font-semibold text-[var(--pl-ink)] [&::-webkit-details-marker]:hidden">
              {menu.label}<span aria-hidden="true">+</span>
            </summary>
            <div class="space-y-1 px-3 pb-3">
              {menu.columns.flatMap((column) => column.links).map((link) => (
                <a class="block rounded-lg px-2 py-2 text-sm text-[var(--pl-muted)] hover:bg-[var(--pl-canvas)] hover:text-[var(--pl-ink)]" href={link.href}>{link.label}</a>
              ))}
            </div>
          </details>
        ))}
        <a class="block rounded-lg px-3 py-3 text-sm font-semibold text-[var(--pl-ink)]" href="/pricing">Pricing</a>
        <div class="mt-2 grid gap-2 border-t border-[var(--pl-line)] pt-3">
          <a class="rounded-lg px-3 py-2 text-center text-sm font-semibold text-[var(--pl-ink)]" href="https://app.priceleap.ai">Sign in</a>
          <a class="pl-button pl-button-primary justify-center text-sm" href="/book-a-demo">Book a demo</a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const menus = header?.querySelectorAll('nav > details');

  menus?.forEach((menu) => {
    menu.addEventListener('toggle', () => {
      if (menu instanceof HTMLDetailsElement && menu.open) {
        menus.forEach((other) => {
          if (other !== menu && other instanceof HTMLDetailsElement) other.open = false;
        });
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    menus?.forEach((menu) => {
      if (menu instanceof HTMLDetailsElement) menu.open = false;
    });
  });
</script>

<style>
  .mega-panel {
    max-height: min(720px, calc(100vh - 98px));
    scrollbar-width: thin;
    scrollbar-color: var(--pl-line) transparent;
  }

  .menu-icon {
    display: grid;
    flex: 0 0 28px;
    grid-template-columns: repeat(2, 4px);
    gap: 2px;
    place-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid #ffd2c5;
    border-radius: 8px;
    background: #fff7f4;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .menu-link:hover .menu-icon {
    border-color: var(--pl-red);
    background: #fff0eb;
    transform: translateY(-1px);
  }

  .menu-icon span,
  .menu-feature-mark span {
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--pl-red);
  }

  .menu-icon-1 span:nth-child(2),
  .menu-icon-1 span:nth-child(3),
  .menu-icon-2 span:nth-child(1),
  .menu-icon-2 span:nth-child(4),
  .menu-icon-3 span:nth-child(2),
  .menu-icon-3 span:nth-child(4) {
    opacity: 0.22;
  }

  .menu-feature-mark {
    display: grid;
    grid-template-columns: repeat(3, 5px);
    gap: 3px;
    width: 25px;
  }

  .menu-feature-mark span {
    width: 5px;
    height: 5px;
    background: var(--pl-orange);
  }

  .menu-feature-mark span:nth-child(2) {
    transform: translateY(5px);
  }

  @media (max-width: 1023px) {
    .site-header {
      background: #fff;
    }
  }

  @media (max-width: 1150px) {
    .mega-panel {
      width: min(1000px, calc(100vw - 32px));
    }
  }
</style>

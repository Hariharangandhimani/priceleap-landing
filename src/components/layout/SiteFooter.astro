---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--pl-line)] bg-white" aria-label="Footer">
  <div class="pl-container py-14">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_2fr]">
      <div>
        <a href="/" aria-label="PriceLeap home"><img src="/assets/priceleap-logo.png" alt="PriceLeap" width="180" height="34" class="h-auto w-[180px] object-contain" loading="lazy" /></a>
        <p class="mt-4 max-w-sm text-sm leading-6 text-[var(--pl-muted)]">Pricing intelligence software for e-commerce and marketplace teams.</p>
        <a class="mt-6 inline-flex rounded-lg bg-[var(--pl-accent)] px-4 py-2.5 text-sm font-medium text-white" href="/book-a-demo">Book a demo →</a>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        <div><h2 class="font-mono text-[10px] uppercase tracking-[.16em] text-[var(--pl-faint)]">Product</h2><div class="mt-4 grid gap-3 text-sm text-[var(--pl-muted)]"><a href="/price-intelligence-engine">Price intelligence</a><a href="/dynamic-pricing-software">Dynamic pricing</a><a href="/real-time-price-monitoring">Price monitoring</a></div></div>
        <div><h2 class="font-mono text-[10px] uppercase tracking-[.16em] text-[var(--pl-faint)]">Solutions</h2><div class="mt-4 grid gap-3 text-sm text-[var(--pl-muted)]"><a href="/for-retailers">Retailers</a><a href="/ecommerce-price-tracking">E-commerce</a><a href="/about">About PriceLeap</a></div></div>
        <div><h2 class="font-mono text-[10px] uppercase tracking-[.16em] text-[var(--pl-faint)]">Resources</h2><div class="mt-4 grid gap-3 text-sm text-[var(--pl-muted)]"><a href="/pricing">Pricing</a><a href="/contact">Contact</a><a href="/design-system">Design system</a></div></div>
        <div><h2 class="font-mono text-[10px] uppercase tracking-[.16em] text-[var(--pl-faint)]">Legal</h2><div class="mt-4 grid gap-3 text-sm text-[var(--pl-muted)]"><a href="/privacy-policy">Privacy policy</a><a href="/terms">Terms</a><a href="mailto:sales_team@priceleap.ai">Email sales</a></div></div>
      </div>
    </div>
    <div class="mt-12 flex flex-wrap justify-between gap-3 border-t border-[var(--pl-line-soft)] pt-5 font-mono text-[11px] text-[var(--pl-faint)]"><span>© {year} PriceLeap. All rights reserved.</span><span>Built for pricing teams · INR</span></div>
  </div>
</footer>

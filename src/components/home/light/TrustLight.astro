---
import { badges } from '@/data/home';
const loop = [...badges, ...badges];
const assurances = ['SSO & SAML', 'Role-based access', 'ISO 27001-aligned controls', 'GDPR compliant', 'Human-verified matches', '99.95% uptime SLA', 'REST API & webhooks'];
const assLoop = [...assurances, ...assurances];
---
<section class="ltrust" aria-label="Certifications and partners">
  <div class="container ltrust__head">
    <div data-reveal class="ltrust__copy">
      <div class="ltrust__eyebrow"><span class="ltrust__dot"></span>TRUSTED &amp; CERTIFIED</div>
      <h2>Certified, compliant and partnered with the platforms <span class="ltrust__green">enterprise teams rely on.</span></h2>
    </div>
    <div data-reveal class="ltrust__ratings">
      {['G2', 'C'].map((code, i) => (
        <div class="ltrust__rating">
          <div class="ltrust__rating-ic">{code}</div>
          <div>
            <div class="ltrust__rating-name"><b>{i === 0 ? 'G2' : 'Capterra'}</b><span class="ltrust__stars">★★★★★</span></div>
            <div class="mono ltrust__rating-score">[PLACEHOLDER]/5 · [PLACEHOLDER] reviews</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Badge marquee row 1 -->
  <div class="ltrust__marquee-wrap">
    <div class="ltrust__marquee">
      <div class="ltrust__track">
        {loop.map((b, i) => (
          <div class="ltrust__badge" aria-hidden={i >= badges.length ? 'true' : undefined}>
            <div class="ltrust__badge-img"><img src={b.src} alt={i >= badges.length ? '' : b.alt} loading="lazy" /></div>
            <div class="ltrust__badge-foot">
              <span class="ltrust__badge-label">{['ISO 27001','AWS Partner','GDPR','Google Cloud','ISO 9001','Microsoft','CMMI Level 3','Automation AA'][i % 8]}</span>
              <span class="ltrust__check" aria-hidden="true">✓</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Assurance pills row 2 -->
    <div class="ltrust__marquee ltrust__marquee--rev">
      <div class="ltrust__track ltrust__track--rev">
        {assLoop.map((t) => (
          <span class="ltrust__pill"><span class="ltrust__pill-dot"></span>{t}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ltrust { background: #FFFFFF; border-top: 1px solid #E3E6E1; border-bottom: 1px solid #E3E6E1; overflow: hidden; }
  .ltrust__head { padding-block: clamp(48px,6vw,72px) 0; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px; }
  .ltrust__copy { flex: 1 1 420px; max-width: 600px; }
  .ltrust__eyebrow { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; color: #0B8F3C; }
  .ltrust__dot { width: 7px; height: 7px; border-radius: 50%; background: #18E563; animation: pl-pulse 1.8s ease-out infinite; flex: none; }
  .ltrust__copy h2 { margin: 14px 0 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(24px,2.6vw,32px); line-height: 1.15; letter-spacing: -.025em; color: #0A0A0A; text-wrap: balance; }
  .ltrust__green { color: #0B8F3C; }
  .ltrust__ratings { flex: 1 1 440px; max-width: 540px; display: flex; flex-wrap: wrap; gap: 10px; }
  .ltrust__rating { flex: 1 1 210px; display: flex; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid #E3E6E1; border-radius: 16px; background: #FFFFFF; box-shadow: 0 1px 2px rgba(10,10,10,.04), 0 14px 30px -22px rgba(10,10,10,.2); }
  .ltrust__rating-ic { width: 44px; height: 44px; flex: none; border-radius: 12px; background: #0A0A0A; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 16px; color: #18E563; }
  .ltrust__rating-name { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .ltrust__rating-name b { font-family: var(--font-display); font-weight: 600; font-size: 15px; color: #0A0A0A; }
  .ltrust__stars { color: #0B8F3C; font-size: 13px; letter-spacing: 1px; }
  .ltrust__rating-score { margin-top: 3px; font-size: 11px; color: #5F6876; }

  .ltrust__marquee-wrap { padding-block: clamp(32px,4vw,44px) clamp(48px,6vw,72px); display: flex; flex-direction: column; gap: 12px; }
  .ltrust__marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .ltrust__track { display: flex; width: max-content; animation: pl-marquee 42s linear infinite; }
  .ltrust__track--rev { animation-direction: reverse; animation-duration: 48s; }
  .ltrust__marquee:hover .ltrust__track { animation-play-state: paused; }

  .ltrust__badge { flex: none; margin: 0 6px; width: 184px; border: 1px solid #E3E6E1; border-radius: 16px; background: #FFFFFF; overflow: hidden; box-shadow: 0 1px 2px rgba(10,10,10,.04), 0 14px 30px -24px rgba(10,10,10,.25); transition: transform .25s, border-color .25s, box-shadow .25s; }
  .ltrust__badge:hover { transform: translateY(-3px); border-color: #7FD3A0; box-shadow: 0 20px 40px -22px rgba(11,143,60,.4); }
  .ltrust__badge-img { height: 76px; padding: 14px 18px; background: #0A0A0A; display: flex; align-items: center; justify-content: center; }
  .ltrust__badge-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ltrust__badge-foot { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 9px 12px; border-top: 1px solid #ECEEEA; }
  .ltrust__badge-label { font-size: 12px; font-weight: 500; color: #3D4450; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ltrust__check { width: 16px; height: 16px; flex: none; border-radius: 50%; background: #E3F7EA; color: #0B8F3C; font-size: 9px; font-weight: 700; display: flex; align-items: center; justify-content: center; }

  .ltrust__pill { flex: none; margin: 0 5px; height: 40px; padding: 0 16px; display: flex; align-items: center; gap: 9px; border: 1px solid #E3E6E1; border-radius: 999px; background: #F5F6F3; font-size: 13.5px; color: #0A0A0A; white-space: nowrap; }
  .ltrust__pill-dot { width: 7px; height: 7px; border-radius: 50%; background: #18E563; flex: none; }
</style>

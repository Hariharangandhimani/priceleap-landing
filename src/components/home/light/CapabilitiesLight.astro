---
---
<section id="capabilities" class="container section lcaps">
  <div data-reveal>
    <div class="eyebrow-l">Core capabilities</div>
    <h2 class="h2-l" style="margin-top:16px">Everything you need to monitor, decide, and win on price.</h2>
  </div>

  <div class="lcaps__grid">
    <!-- Real-Time Tracking -->
    <article class="lcard lcap lcap--wide" data-reveal>
      <div class="lcap__head">
        <span class="licon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
        </span>
        <div><h3 class="h3-l">Real-Time Competitor Price Tracking</h3><p>Track every competitor, marketplace, and SKU with prices refreshed as often as every [PLACEHOLDER] — so you act on what's true right now, not yesterday.</p></div>
      </div>
      <div class="lcap__panel">
        {[['Marketplace A · Headphones', 80], ['Retailer B · Headphones', 40], ['D2C store C · Earbuds', 95], ['Marketplace D · Speakers', 60]].map(([n, f], i) => (
          <div class="lcap__track"><span class="lcap__track-name">{n}</span><span class="lcap__fresh"><i style={`--f:${f}%;animation-delay:${i * -1.1}s`}></i></span><span class="mono lcap__track-price">₹{[25490,24790,18990,6290][i].toLocaleString('en-IN')}</span></div>
        ))}
      </div>
    </article>

    <!-- Price Index -->
    <article class="lcard lcap" data-reveal>
      <span class="licon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/></svg></span>
      <div><h3 class="h3-l">Pricing Intelligence &amp; Price Index</h3><p>See exactly where you stand with a live price index, positioning views, and SKU-level insight across your entire catalog.</p></div>
      <div class="lcap__index">
        <div><span class="mono lcap__index-n">96.4</span><span class="mono lcap__index-delta">▼ 3.6% vs market</span></div>
        <div class="lcap__split"><span style="flex:34;background:#18E563"></span><span style="flex:51;background:#0E8F3D"></span><span style="flex:15;background:#FF5247"></span></div>
        <div class="mono lcap__legend"><span>CHEAPEST</span><span>COMPETITIVE</span><span>ABOVE</span></div>
      </div>
    </article>

    <!-- AI Matching -->
    <article class="lcard lcap" data-reveal>
      <span class="licon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 7a5 5 0 1 0 0 10"/><path d="M15 17a5 5 0 1 0 0-10"/><path d="M9.5 12.2l1.8 1.8 3.4-3.6"/></svg></span>
      <div><h3 class="h3-l">AI Product Matching + Human QC</h3><p>Our AI matches identical and similar products — even without barcodes — and every match passes human quality control. The result: [PLACEHOLDER]% verified accuracy.</p></div>
      <div class="lcap__flow">
        {['Match', 'Review', 'Verify'].map((s, i) => <span style={`animation-delay:${i * 1.1}s`}>{s}</span>)}
      </div>
    </article>

    <!-- Dynamic Pricing -->
    <article class="lcard lcap lcap--wide" data-reveal>
      <div class="lcap__head">
        <span class="licon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h10"/><path d="M18 7h2"/><path d="M4 17h4"/><path d="M12 17h8"/><path d="M16 5v4"/><path d="M10 15v4"/></svg></span>
        <div><h3 class="h3-l">Dynamic Pricing Software</h3><p>Set rules or let AI recommend the optimal price for every product, balancing competitiveness and margin automatically as the market moves.</p></div>
      </div>
      <div class="lcap__rules">
        <div class="lcap__rule">
          {[['RULE','Beat lowest rival by 1%'],['FLOOR','Margin ≥ 18%'],['CEILING','MSRP']].map(([k,v]) => <div><span class="mono lcap__rule-k">{k}</span><span>{v}</span></div>)}
        </div>
        <div class="lcap__rec">
          <div class="mono lcap__rec-label">AI RECOMMENDATION</div>
          <div class="mono lcap__rec-price"><s>₹24,990</s><b>₹24,540</b></div>
          <div class="lcap__rec-note">Competitive and inside your floor</div>
        </div>
      </div>
    </article>

    <!-- Market Intelligence -->
    <article class="lcard lcap lcap--half" data-reveal>
      <span class="licon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><path d="M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6"/></svg></span>
      <div><h3 class="h3-l">Competitor &amp; Market Intelligence</h3><p>Go beyond price. Track assortment, promotions, stock availability, and new-product launches to understand every competitor's full strategy.</p></div>
      <div class="lcap__intel-grid">
        {[['ASSORTMENT','+12 new SKUs'],['PROMOTIONS','3 active campaigns'],['STOCK','Rival out of stock'],['LAUNCHES','New model detected']].map(([k,v]) => (
          <div class="lcap__intel-cell"><div class="mono lcap__intel-k">{k}</div><div>{v}</div></div>
        ))}
      </div>
    </article>

    <!-- MAP Monitoring -->
    <article class="lcard lcap lcap--half" data-reveal>
      <span class="licon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
      <div><h3 class="h3-l">MAP &amp; Promotion Monitoring</h3><p>Protect your brand and channels with automated MAP compliance alerts and full visibility into competitor promotions.</p></div>
      <div class="lcap__alerts">
        <div class="lcap__alert lcap__alert--bad"><span>MAP violation · Seller 2841</span><span class="mono">−8.0% below MAP</span></div>
        <div class="lcap__alert"><span>Promotion detected · Marketplace</span><span class="mono lcap__promo">20% off</span></div>
      </div>
    </article>
  </div>
</section>

<style>
  .lcaps__grid { margin-top: 48px; display: flex; flex-wrap: wrap; gap: 16px; }
  .lcap { flex: 1 1 340px; min-width: 0; padding: 28px; display: flex; flex-direction: column; gap: 28px; }
  .lcap--wide { flex: 1.6 1 520px; } .lcap--half { flex: 1 1 420px; }
  .lcap p { margin-top: 8px; font-size: 15px; line-height: 1.6; color: #3D4450; max-width: 480px; }
  .lcap__head { display: flex; gap: 16px; align-items: flex-start; }
  .lcap > :last-child { margin-top: auto; }

  .lcap__panel { border: 1px solid #ECEEEA; border-radius: 14px; background: #F4F6F2; overflow: hidden; }
  .lcap__track { display: grid; grid-template-columns: minmax(0,1fr) 72px 92px; gap: 12px; align-items: center; padding: 11px 16px; font-size: 13px; } .lcap__track + .lcap__track { border-top: 1px solid #ECEEEA; }
  .lcap__track-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #3D4450; }
  .lcap__track-price { text-align: right; color: #0A0A0A; }
  .lcap__fresh { height: 4px; border-radius: 2px; background: #ECEEEA; overflow: hidden; } .lcap__fresh i { display: block; height: 100%; width: var(--f); background: #18E563; animation: fresh-l 4.4s linear infinite; }

  .lcap__index { }
  .lcap__index-n { font-size: 44px; font-weight: 500; letter-spacing: -.04em; color: #0A0A0A; margin-right: 10px; }
  .lcap__index-delta { font-size: 12px; color: #0B8F3C; }
  .lcap__split { margin-top: 14px; display: flex; height: 10px; gap: 3px; border-radius: 5px; overflow: hidden; }
  .lcap__legend { margin-top: 8px; display: flex; justify-content: space-between; font-size: 11px; color: #5F6876; }

  .lcap__flow { display: flex; gap: 8px; }
  .lcap__flow span { flex: 1; height: 40px; border-radius: 10px; font-family: var(--font-mono); font-size: 12px; display: grid; place-items: center; animation: flowstep-l 3.3s infinite; }

  .lcap__rules { display: flex; flex-wrap: wrap; gap: 12px; }
  .lcap__rule { flex: 1 1 220px; padding: 16px; border: 1px solid #ECEEEA; border-radius: 14px; background: #F4F6F2; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: #0A0A0A; }
  .lcap__rule-k { display: inline-block; width: 60px; font-size: 10px; color: #5F6876; }
  .lcap__rec { flex: 1 1 220px; padding: 16px; border: 1px solid #7FD3A0; border-radius: 14px; background: rgba(24,229,99,.05); }
  .lcap__rec-label { font-size: 10px; letter-spacing: .1em; color: #0B8F3C; }
  .lcap__rec-price { margin-top: 10px; display: flex; align-items: baseline; gap: 10px; } .lcap__rec-price s { color: #9AA2AD; } .lcap__rec-price b { font-size: 26px; font-weight: 400; color: #0A0A0A; }
  .lcap__rec-note { margin-top: 6px; font-size: 12px; color: #5F6876; }

  .lcap__intel-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; font-size: 13px; }
  .lcap__intel-cell { padding: 12px; border: 1px solid #ECEEEA; border-radius: 10px; background: #F4F6F2; color: #0A0A0A; }
  .lcap__intel-k { margin-bottom: 4px; font-size: 10px; color: #5F6876; }

  .lcap__alerts { display: flex; flex-direction: column; gap: 8px; font-size: 13px; }
  .lcap__alert { display: flex; justify-content: space-between; gap: 12px; padding: 12px 14px; border: 1px solid #ECEEEA; border-radius: 10px; background: #F4F6F2; flex-wrap: wrap; }
  .lcap__promo { color: #5F6876; }
  .lcap__alert--bad { border-color: #F5C2BC; background: #FDEEEC; color: #0A0A0A; } .lcap__alert--bad .mono { color: #C8362C; }
</style>

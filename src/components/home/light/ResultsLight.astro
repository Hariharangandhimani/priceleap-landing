---
import { results } from '@/data/home';
---
<section id="results" class="container section lres">
  <div data-reveal>
    <div class="eyebrow-l">Results</div>
    <h2 class="h2-l" style="margin-top:14px">Better data. Better pricing. Measurable results.</h2>
  </div>

  <div class="lres__grid" data-reveal>
    {results.map((r) => (
      <div class="lcard lres__card">
        <div class="mono lres__label">{r.label}</div>
        <div class:list={['lres__num', { 'lres__num--accent': r.accent }]}><b>{r.value}</b><span>{r.unit}</span></div>
        <p>{r.desc}</p>
        <div class="lres__vis">
          {r.kind === 'bars' ? (
            <><div class="lres__bars">{r.bars!.map((v, i) => <i style={`height:${v}%`} class:list={{ on: i >= 4 }}></i>)}</div><div class="mono lres__axis"><span>BEFORE</span><span class="lres__axis-green">WITH PRICELEAP</span></div></>
          ) : (
            <div class="lres__cmp mono">{r.rows!.map(([k,w,v], i) => <div><span class:list={['lres__cmp-k', { green: i === 1 }]}>{k}</span><i style={`width:${w}%`} class:list={{ on: i === 1 }}></i><span class:list={['lres__cmp-v', { dark: i === 1 }]}>{v}</span></div>)}<small>{r.caption}</small></div>
          )}
        </div>
      </div>
    ))}
  </div>
  <p class="mono lres__note">Illustrative figures — replace with verified customer results.</p>

  <figure class="lres__quote" data-reveal>
    <blockquote><span class="lres__q-mark">"</span>PriceLeap gave us competitor data we finally trust — and the pricing decisions to match. We stopped guessing and started winning on margin.<span class="lres__q-mark">"</span></blockquote>
    <figcaption>
      <span class="lres__photo mono">photo</span>
      <div><b>[Name]</b><span>Head of Pricing, [Company]</span></div>
    </figcaption>
  </figure>
</section>

<style>
  .lres__grid { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%,280px),1fr)); gap: 16px; }
  .lres__card { padding: 26px; display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .lres__label { font-size: 11px; letter-spacing: .12em; color: #5F6876; }
  .lres__num { display: flex; align-items: baseline; gap: 6px; color: #0A0A0A; }
  .lres__num b { font-family: var(--font-display); font-weight: 600; font-size: clamp(44px,5vw,64px); line-height: 1; letter-spacing: -.045em; }
  .lres__num span { font-family: var(--font-display); font-weight: 500; font-size: 22px; }
  .lres__num--accent { color: #0B8F3C; }
  .lres__card p { font-size: 15px; line-height: 1.5; color: #3D4450; }
  .lres__vis { margin-top: auto; padding-top: 18px; border-top: 1px solid #ECEEEA; }
  .lres__bars { display: flex; align-items: flex-end; gap: 6px; height: 56px; }
  .lres__bars i { flex: 1; border-radius: 4px 4px 1px 1px; background: #E3E6E1; }
  .lres__bars i.on { background: #18E563; }
  .lres__axis { margin-top: 8px; display: flex; justify-content: space-between; font-size: 10px; color: #9AA2AD; }
  .lres__axis-green { color: #0B8F3C; }
  .lres__cmp { display: flex; flex-direction: column; gap: 10px; font-size: 11px; color: #9AA2AD; }
  .lres__cmp > div { display: grid; grid-template-columns: 64px minmax(0,1fr) 44px; gap: 10px; align-items: center; }
  .lres__cmp i { height: 8px; border-radius: 4px; background: #E3E6E1; } .lres__cmp i.on { background: #18E563; }
  .lres__cmp-k { } .lres__cmp-k.green { color: #0B8F3C; }
  .lres__cmp-v { text-align: right; color: #9AA2AD; } .lres__cmp-v.dark { color: #0A0A0A; }
  .lres__cmp small { display: block; color: #9AA2AD; }
  .lres__note { margin-top: 14px; font-size: 11px; color: #9AA2AD; }
  .lres__quote { margin: 56px 0 0; display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-end; }
  blockquote { margin: 0; flex: 2 1 520px; font-family: var(--font-display); font-weight: 500; font-size: clamp(24px,2.8vw,36px); line-height: 1.28; letter-spacing: -.025em; color: #0A0A0A; text-wrap: pretty; }
  .lres__q-mark { color: #0B8F3C; }
  figcaption { flex: 1 1 240px; display: flex; align-items: center; gap: 14px; }
  figcaption b { display: block; color: #0A0A0A; font-weight: 500; }
  figcaption span:not(.lres__photo) { font-size: 14px; color: #5F6876; }
  .lres__photo { width: 52px; height: 52px; flex: none; border-radius: 50%; border: 1px dashed #E3E6E1; display: grid; place-items: center; font-size: 9px; color: #9AA2AD; }
</style>

---
import { products, agentToasts } from '@/data/home';
---
<div class="dp-wrap" data-dash>
  <div class="dp-glow" aria-hidden="true"></div>
  <div class="dp-tilt" data-tilt>
    <div class="dp" role="img" aria-label="PriceLeap Price Intelligence dashboard preview">
      <div class="dp__chrome">
        <span class="dp__lights"><i></i><i></i><i></i></span>
        <span class="dp__url mono"><span class="dot"></span>app.priceleap.ai/price-intelligence</span>
        <span style="width:46px"></span>
      </div>
      <div class="dp__body">
        <aside class="dp__side">
          <div class="dp__brand"><img src="/assets/mark.png" alt="" width="18" height="17" /><span>Price<b class="accent">Leap</b></span></div>
          <div class="dp__ws"><span class="dp__ws-av">AR</span>Acme Retail<span class="dim">▾</span></div>
          <div class="dp__nav is-active"><img src="/assets/icon-intel.png" alt="" width="13" height="13" />Price Intelligence</div>
          <div class="dp__nav"><img src="/assets/icon-reprice.png" alt="" width="13" height="13" />Decision Engine</div>
          <div class="dp__nav dp__nav--sub">Product Groups</div>
          <div class="dp__nav dp__nav--sub">Dynamic Pricing</div>
          <div class="dp__nav"><img src="/assets/icon-groups.png" alt="" width="13" height="13" />Reports</div>
          <div class="dp__sect mono">CONFIGURATION</div>
          <div class="dp__nav"><img src="/assets/icon-integrations.png" alt="" width="13" height="13" />Integrations</div>
          <div class="dp__nav"><img src="/assets/icon-workspaces.png" alt="" width="13" height="13" />Workspace</div>
          <div class="dp__plan"><span class="tag tag--green">GROWTH</span><div>12,480 of 15,000 SKUs</div><div class="dp__bar"><i style="width:83%"></i></div></div>
        </aside>
        <div class="dp__main">
          <div class="dp__top">
            <span class="dp__btn"><span class="dp__al">AL</span>All ▾</span>
            <span class="dp__title">Price Intelligence</span>
            <span class="dp__sub">Monitor competitor prices and track your market position.</span>
            <span class="dp__actions"><span class="dp__btn"><span class="dot" style="background:var(--amber)"></span>3</span><span class="dp__btn">Agent</span><span class="dp__btn dp__btn--green">+ Add products</span></span>
          </div>
          <div class="dp__kpis">
            <div class="kpi"><div class="kpi__label">CATALOG OVERVIEW</div>
              <div class="kpi__row"><div><div class="kpi__num">12,480</div><div class="kpi__cap">Active products</div></div><span class="ring" style="--p:72%;--c:var(--green)"><span class="mono"><b data-index>96.4</b><i>INDEX</i></span></span></div>
              <div class="kpi__foot">84 <small>BRANDS</small> 23 <small>CATEGORIES</small></div></div>
            <div class="kpi"><div class="kpi__head"><span class="kpi__label">PRICE VELOCITY</span><span class="kpi__tabs" data-vel>{['7d', '30d', '90d'].map((t, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-m={[1, 4.1, 11.6][i]}>{t}</button>)}</span></div>
              <div class="kpi__vel"><div><b style="color:var(--red)" data-inc>142</b><small style="color:var(--red)">INCREASED</small></div><div><b class="accent" data-dec>318</b><small class="accent">DECREASED</small></div><div><b data-mix>37</b><small>MIXED</small></div></div>
              <div class="kpi__spark" aria-hidden="true">{[34, 42, 30, 52, 46, 40, 36, 60, 48, 44, 58, 50, 66, 72, 60, 70].map((v, i) => <i style={`height:${Math.round(v / 0.8)}%;background:${i % 3 === 1 ? 'var(--red)' : 'var(--green-dark)'}`}></i>)}</div></div>
            <div class="kpi"><div class="kpi__head"><span class="kpi__label">OUT OF STOCK</span><span class="kpi__ic" style="color:var(--red)">!</span></div>
              <div class="kpi__line"><div><div class="kpi__cap">Your store</div><div><b class="kpi__md">18</b> products</div></div><span class="ring ring--sm" style="--p:4%;--c:var(--red)"><span class="mono">0.1%</span></span></div>
              <div class="kpi__line"><div><div class="kpi__cap">Competitors</div><div><b class="kpi__md" style="color:var(--amber)" data-oos>612</b> products</div></div><span class="ring ring--sm" style="--p:18%;--c:var(--amber)"><span class="mono">4.9%</span></span></div></div>
            <div class="kpi"><div class="kpi__head"><span class="kpi__label">MARKET POSITION</span><span class="kpi__ic accent">✓</span></div>
              <div class="kpi__row"><div><div class="kpi__num accent" data-cheap>4,208</div><small class="accent mono">CHEAPEST</small></div><div class="kpi__right"><div><b>11,906</b> with match</div><div><b>1,878</b> above</div></div></div>
              <div class="kpi__split"><i style="flex:34;background:var(--green)"></i><i style="flex:51;background:var(--green-dark)"></i><i style="flex:15;background:var(--red)"></i></div></div>
            <div class="kpi"><div class="kpi__head"><span class="kpi__label">FAILED FETCHES</span><span class="kpi__ic" style="color:var(--amber)">!</span></div>
              <div class="kpi__row"><div><div class="kpi__num">23</div><div class="kpi__cap">Retrying automatically</div></div><span class="ring" style="--p:3%;--c:var(--amber)"><span class="mono">0.2%</span></span></div></div>
          </div>
          <div class="dp__table">
            <div class="dp__tbar"><span>Showing all products</span><span class="mono dim dp__live"><span class="dot"></span>LIVE · <span data-clock>--:--:--</span></span>
              <span class="dp__filters">{['Stock status', 'All brands', 'All categories', 'MAP'].map((f) => <span>{f} ▾</span>)}</span></div>
            <div class="dp__scroll"><div class="dp__grid">
              <div class="dp__row dp__row--head mono"><span>PRODUCT</span><span class="r">YOUR PRICE</span><span>POSITION VS MARKET</span><span>PRICE TREND</span><span class="r">DYNAMIC PRICE ✦</span><span class="r">COMPETITORS</span><span class="r">MAP / MSRP</span></div>
              {products.map((p, i) => (
                <div class="dp__row" data-row={i}>
                  <div class="dp__prod"><span class="dp__thumb mono">{p.sku.slice(0, 2)}</span><div><div class="dp__name">{p.name}</div><div class="mono dim dp__sku">{p.sku}</div></div></div>
                  <div class="r mono white">₹{p.ours.toLocaleString('en-IN')}</div>
                  <div><div class="dp__track"><span data-pos></span></div><div class="mono dp__posl" data-posl>—</div></div>
                  <svg viewBox="0 0 80 24" width="80" height="24" aria-hidden="true"><polyline data-spark fill="none" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" points=""></polyline></svg>
                  <div class="r"><div class="mono accent" data-dyn>—</div><div class="mono dim dp__note" data-dynn></div></div>
                  <div class="r dp__comps"><span class="dp__av"><i></i><i></i><i></i></span><span class="mono">{p.comps.length}</span></div>
                  <div class="r mono dim dp__map">₹{p.map.toLocaleString('en-IN')}<br />₹{p.msrp.toLocaleString('en-IN')}</div>
                </div>
              ))}
            </div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="dp__toast" aria-live="polite" data-toast>
      <div class="dp__toast-head"><span class="dp__toast-ic"><img src="/assets/mark.png" alt="" width="14" height="13" /></span><div><div class="white" style="font-size:12.5px;font-weight:600">PriceLeap Agent</div><div class="mono accent" style="font-size:9.5px;letter-spacing:.08em" data-tkind>{agentToasts[0].kind}</div></div><span class="mono dim" style="margin-left:auto;font-size:10px">now</span></div>
      <p data-tmsg>{agentToasts[0].msg}</p>
      <div class="dp__toast-actions"><span class="dp__tbtn" data-tcta>{agentToasts[0].cta}</span><span class="dp__tbtn dp__tbtn--ghost">Dismiss</span></div>
    </div>
  </div>
</div>
<script type="application/json" id="dash-data" set:html={JSON.stringify({ products, toasts: agentToasts })}></script>

<script>
  import { inr, p90 } from '@/scripts/format';
  import { prefersReducedMotion } from '@/scripts/reveal';
  const root = document.querySelector<HTMLElement>('[data-dash]');
  const data = JSON.parse(document.getElementById('dash-data')!.textContent || '{}');
  if (root) {
    const rows = data.products.map((p: any) => ({ ...p, trend: Array.from({ length: 8 }, (_, k) => Math.min(...p.comps) * (1 + Math.sin(k * 1.3 + p.ours) * 0.02)) }));
    let inc = 142, dec = 318, mix = 37, mult = 1, oos = 612, updated = 3418220, toast = 0;
    const $ = (s: string, el: ParentNode = root) => el.querySelector<HTMLElement>(s);
    const fmtN = (n: number) => Math.round(n).toLocaleString('en-IN');

    const paintRow = (i: number) => {
      const r = rows[i], el = $(`[data-row="${i}"]`)!;
      const low = Math.min(...r.comps), high = Math.max(...r.comps);
      const lo = Math.min(low, r.ours), hi = Math.max(high, r.ours);
      const pos = hi === lo ? 50 : ((r.ours - lo) / (hi - lo)) * 100;
      const gap = (r.ours / low - 1) * 100, cheap = r.ours <= low;
      const color = cheap ? 'var(--green)' : gap < 1.5 ? 'var(--amber)' : 'var(--red)';
      const dot = $('[data-pos]', el)!; dot.style.left = Math.max(4, Math.min(96, pos)) + '%'; dot.style.borderColor = color;
      const pl = $('[data-posl]', el)!; pl.textContent = cheap ? 'Cheapest' : '+' + gap.toFixed(1) + '% vs lowest'; pl.style.color = color;
      const dyn = Math.min(r.msrp, Math.max(r.floor, r.map, p90(low * 0.99))), d = dyn - r.ours;
      $('[data-dyn]', el)!.textContent = inr(dyn);
      $('[data-dynn]', el)!.textContent = d === 0 ? 'Hold' : (d < 0 ? '▼ ' : '▲ ') + inr(Math.abs(d));
      const tmin = Math.min(...r.trend), tmax = Math.max(...r.trend);
      const sp = el.querySelector('[data-spark]')!;
      sp.setAttribute('points', r.trend.map((v: number, k: number) => (k * 80 / 7).toFixed(1) + ',' + (tmax === tmin ? 12 : 22 - ((v - tmin) / (tmax - tmin)) * 20).toFixed(1)).join(' '));
      sp.setAttribute('stroke', r.trend[7] <= r.trend[0] ? '#18E563' : '#FF5247');
      return cheap;
    };
    const paintAll = () => {
      const cheap = rows.map((_: any, i: number) => paintRow(i)).filter(Boolean).length;
      const idx = (rows.reduce((a: number, r: any) => a + r.ours / Math.min(...r.comps), 0) / rows.length) * 100;
      document.querySelectorAll('[data-index]').forEach((e) => (e.textContent = idx.toFixed(1)));
      $('[data-cheap]')!.textContent = fmtN(4206 + cheap);
      $('[data-inc]')!.textContent = fmtN(inc * mult); $('[data-dec]')!.textContent = fmtN(dec * mult); $('[data-mix]')!.textContent = fmtN(mix * mult);
      $('[data-oos]')!.textContent = String(oos);
      document.querySelectorAll('[data-updated]').forEach((e) => (e.textContent = updated.toLocaleString('en-IN')));
    };
    const tick = () => {
      const i = Math.floor(Math.random() * rows.length), r = rows[i], j = Math.floor(Math.random() * r.comps.length);
      const before = Math.min(...r.comps);
      r.comps[j] = p90(r.comps[j] * (0.965 + Math.random() * 0.06));
      const after = Math.min(...r.comps);
      r.trend = [...r.trend.slice(1), after];
      if (after > before) inc++; else if (after < before) dec++; else mix++;
      if (Math.random() < 0.3) oos++;
      updated += 900 + Math.floor(Math.random() * 700);
      const el = $(`[data-row="${i}"]`)!;
      el.dataset.flash = after < before ? 'down' : after > before ? 'up' : '';
      setTimeout(() => (el.dataset.flash = ''), 1100);
      paintAll();
    };
    root.querySelectorAll<HTMLButtonElement>('[data-vel] button').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-vel] button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true'); mult = Number(b.dataset.m); paintAll();
    }));
    const clock = $('[data-clock]')!;
    const tickClock = () => (clock.textContent = new Date().toTimeString().slice(0, 8));
    paintAll(); tickClock();
    setInterval(tickClock, 1000);
    if (!prefersReducedMotion()) {
      setInterval(tick, 2300);
      const t = $('[data-toast]')!;
      setInterval(() => {
        t.classList.add('is-hidden');
        setTimeout(() => {
          toast = (toast + 1) % data.toasts.length; const d = data.toasts[toast];
          $('[data-tkind]', t)!.textContent = d.kind; $('[data-tmsg]', t)!.textContent = d.msg; $('[data-tcta]', t)!.textContent = d.cta;
          t.classList.remove('is-hidden');
        }, 450);
      }, 5200);
      const tilt = $('[data-tilt]')!;
      const applyTilt = () => {
        if (innerWidth < 860) { tilt.style.transform = 'none'; return; }
        const p = Math.min(1, Math.max(0, scrollY / 560));
        tilt.style.transform = `perspective(2000px) rotateX(${((1 - p) * 10).toFixed(2)}deg) scale(${(0.96 + p * 0.04).toFixed(3)})`;
      };
      let raf = 0;
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; applyTilt(); }); }, { passive: true });
      addEventListener('resize', applyTilt); applyTilt();
    }
  }
</script>

<style>
  .dp-wrap { position: relative; }
  .dp-glow { position: absolute; left: 8%; right: 8%; top: 12%; bottom: -6%; background: radial-gradient(closest-side, rgba(24,229,99,.16), transparent); filter: blur(30px); pointer-events: none; }
  .dp-tilt { position: relative; transform-origin: 50% 0; will-change: transform; }
  .dp { border: 1px solid var(--line); border-radius: 18px; background: var(--surface-3); box-shadow: 0 60px 140px -40px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.05); overflow: hidden; text-align: left; }
  .white { color: var(--white); } .dim { color: var(--dim); } .r { text-align: right; justify-content: flex-end; }
  .dp__chrome { display: flex; align-items: center; gap: 14px; padding: 10px 16px; border-bottom: 1px solid var(--line-soft); background: var(--surface-4); }
  .dp__lights { display: flex; gap: 6px; } .dp__lights i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .dp__url { flex: 0 1 360px; margin: 0 auto; height: 26px; border-radius: 7px; background: var(--surface); border: 1px solid var(--line-soft); display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11px; color: var(--muted); overflow: hidden; white-space: nowrap; }
  .dp__url .dot { width: 6px; height: 6px; }
  .dp__body { display: flex; }
  .dp__side { width: 212px; flex: none; border-right: 1px solid var(--line-soft); background: var(--bg); padding: 16px 12px; display: none; flex-direction: column; gap: 4px; }
  @media (min-width: 1100px) { .dp__side { display: flex; } }
  .dp__brand { display: flex; align-items: center; gap: 8px; padding: 2px 8px 14px; font-family: var(--font-display); font-size: 15px; color: var(--white); }
  .dp__ws { display: flex; align-items: center; gap: 8px; padding: 8px; border: 1px solid var(--line-soft); border-radius: 9px; margin-bottom: 10px; font-size: 12px; color: var(--white); }
  .dp__ws .dim { margin-left: auto; font-size: 10px; }
  .dp__ws-av { width: 22px; height: 22px; border-radius: 6px; background: var(--green-deep); color: var(--green); font-size: 10px; font-weight: 600; display: grid; place-items: center; }
  .dp__nav { position: relative; display: flex; align-items: center; gap: 9px; padding: 8px 10px; border-radius: 8px; color: var(--muted); font-size: 12.5px; }
  .dp__nav img { opacity: .55; filter: grayscale(1); }
  .dp__nav.is-active { background: #161616; color: var(--white); } .dp__nav.is-active img { opacity: 1; filter: none; }
  .dp__nav.is-active::before { content: ''; position: absolute; left: -12px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--green); }
  .dp__nav--sub { padding: 6px 10px 6px 32px; font-size: 12px; }
  .dp__sect { padding: 14px 10px 6px; font-size: 9.5px; letter-spacing: .12em; color: var(--dim); }
  .dp__plan { margin-top: auto; padding: 12px; border: 1px solid var(--line-soft); border-radius: 10px; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; font-size: 11.5px; }
  .dp__bar { width: 100%; height: 4px; border-radius: 2px; background: var(--line-soft); overflow: hidden; } .dp__bar i { display: block; height: 100%; background: var(--green); }
  .dp__main { flex: 1; min-width: 0; }
  .dp__top { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--line-soft); flex-wrap: wrap; }
  .dp__btn { height: 30px; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text); }
  .dp__btn .dot { width: 6px; height: 6px; }
  .dp__btn--green { border-color: var(--green); color: var(--green); font-weight: 500; }
  .dp__al { width: 18px; height: 18px; border-radius: 5px; background: var(--green); color: var(--bg); font-size: 9px; font-weight: 700; display: grid; place-items: center; }
  .dp__title { font-size: 13px; color: var(--white); font-weight: 500; }
  .dp__sub { font-size: 11.5px; color: var(--dim); padding-left: 12px; border-left: 1px solid var(--line); display: none; }
  @media (min-width: 860px) { .dp__sub { display: inline; } }
  .dp__actions { margin-left: auto; display: flex; gap: 6px; }
  .dp__kpis { display: grid; grid-template-columns: 1fr; gap: 10px; padding: 14px 16px; }
  @media (min-width: 480px) { .dp__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 720px) { .dp__kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .dp__kpis { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .kpi { padding: 14px; border: 1px solid var(--line-soft); border-radius: 12px; background: var(--surface); display: flex; flex-direction: column; gap: 10px; font-size: 12px; color: var(--white); }
  .kpi__label { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .12em; color: var(--muted); }
  .kpi__head, .kpi__row, .kpi__line { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .kpi__line { padding-bottom: 6px; } .kpi__line + .kpi__line { padding-top: 6px; border-top: 1px solid var(--line-soft); }
  .kpi__num { font-family: var(--font-display); font-size: 26px; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .kpi__md { font-family: var(--font-display); font-size: 18px; font-weight: 600; }
  .kpi__cap { font-size: 11px; color: var(--muted); }
  .kpi__right { text-align: right; font-size: 11px; color: var(--muted); line-height: 1.5; } .kpi__right b { color: var(--white); font-weight: 500; }
  .kpi__foot { padding-top: 8px; border-top: 1px solid var(--line-soft); } .kpi__foot small, .kpi__vel small { font-family: var(--font-mono); font-size: 9px; color: var(--muted); }
  .kpi__ic { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid currentColor; font-size: 9px; font-weight: 700; display: grid; place-items: center; }
  .kpi__tabs { display: flex; gap: 3px; }
  .kpi__tabs button { height: 20px; padding: 0 6px; border-radius: 5px; border: 1px solid var(--line); background: transparent; color: var(--muted); font-family: var(--font-mono); font-size: 9.5px; cursor: pointer; }
  .kpi__tabs button[aria-pressed="true"] { border-color: var(--dim); background: var(--line-soft); color: var(--white); }
  .kpi__vel { display: flex; gap: 14px; } .kpi__vel b { display: block; font-family: var(--font-display); font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; } .kpi__vel small { display: block; letter-spacing: .08em; }
  .kpi__spark { display: flex; align-items: flex-end; gap: 3px; height: 22px; } .kpi__spark i { flex: 1; border-radius: 2px; }
  .kpi__split { display: flex; height: 6px; gap: 2px; border-radius: 3px; overflow: hidden; }
  .ring { width: 44px; height: 44px; flex: none; border-radius: 50%; background: conic-gradient(var(--c) 0 var(--p), var(--line-soft) 0); display: grid; place-items: center; }
  .ring > span { width: 34px; height: 34px; border-radius: 50%; background: var(--surface); display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 9.5px; color: var(--white); line-height: 1; }
  .ring i { font-style: normal; font-size: 7px; color: var(--green); margin-top: 2px; }
  .ring--sm { width: 32px; height: 32px; } .ring--sm > span { width: 25px; height: 25px; font-size: 8px; }
  .dp__table { margin: 0 16px 16px; border: 1px solid var(--line-soft); border-radius: 12px; background: var(--surface); overflow: hidden; }
  .dp__tbar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--line-soft); flex-wrap: wrap; font-size: 12.5px; color: var(--white); }
  .dp__live { display: flex; align-items: center; gap: 6px; font-size: 10px; } .dp__live .dot { width: 6px; height: 6px; }
  .dp__filters { margin-left: auto; display: none; gap: 6px; } .dp__filters span { height: 26px; padding: 0 10px; border: 1px solid var(--line); border-radius: 999px; display: flex; align-items: center; font-size: 11px; color: var(--text); }
  @media (min-width: 860px) { .dp__filters { display: flex; } }
  .dp__scroll { overflow-x: auto; } .dp__grid { min-width: 820px; }
  .dp__row { display: grid; grid-template-columns: minmax(0, 2.2fr) .9fr 1.3fr 1fr 1.1fr .8fr .9fr; gap: 12px; align-items: center; padding: 10px 14px; border-top: 1px solid var(--line-soft); font-size: 12.5px; transition: background .9s ease; }
  .dp__row--head { border-top: 0; font-size: 9.5px; letter-spacing: .1em; color: var(--muted); }
  .dp__row[data-flash="down"] { background: rgba(24,229,99,.07); } .dp__row[data-flash="up"] { background: rgba(255,82,71,.07); }
  .dp__prod { display: flex; align-items: center; gap: 10px; min-width: 0; }

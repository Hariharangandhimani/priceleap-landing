---
import Button from '@/components/ui/Button.astro';
import Pill from '@/components/ui/Pill.astro';
import DashboardPreview from './DashboardPreview.astro';
import { routes } from '@/data/site';
---
<section class="hero" data-screen="hero">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="bg-glow" aria-hidden="true"></div>
  <div class="container hero__copy">
    <Pill pulse>Pricing Intelligence Software for E-commerce &amp; Marketplaces</Pill>
    <h1 class="h1"><span class="light">Price with confidence on data you can </span><span class="bold accent">actually trust.</span></h1>
    <p class="lede">PriceLeap gives e-commerce and marketplace teams real-time competitor price tracking, verified data accuracy, and dynamic pricing that protects every point of margin.</p>
    <div class="hero__ctas">
      <Button href={routes.demo} size="lg">Book a demo</Button>
      <Button href="#product" variant="secondary" size="lg">See a sample of your competitor data <span class="arrow">→</span></Button>
    </div>
    <p class="hero__live"><span class="dot dot--pulse"></span><span><b class="mono" data-updated>34,18,220</b> prices refreshed today</span></p>
  </div>
  <div class="hero__stage">
    <DashboardPreview />
  </div>
</section>
<style>
  .hero { position: relative; padding: clamp(56px, 8vw, 96px) 0 clamp(64px, 8vw, 104px); }
  .hero__copy { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .h1 { margin-top: 28px; max-width: 1000px; }
  .lede { margin-top: 26px; max-width: 640px; }
  .hero__ctas { margin-top: 36px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .hero__live { margin-top: 28px; display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--muted); }
  .hero__live b { color: var(--white); font-weight: 500; font-variant-numeric: tabular-nums; }
  .hero__stage { position: relative; max-width: 1280px; margin: clamp(48px, 7vw, 80px) auto 0; padding-inline: var(--gutter); }
</style>

---
import { badges } from '@/data/home';
const loop = [...badges, ...badges];
---
<section class="trust" aria-label="Certifications and partners">
  <div class="container trust__inner">
    <p class="trust__copy"><span class="eyebrow">Trusted &amp; certified</span>Certified, compliant and partnered with the platforms enterprise teams rely on.</p>
    <div class="trust__marquee">
      <div class="trust__track">
        {loop.map((b, i) => (
          <span class:list={['trust__badge', { 'trust__badge--light': b.light }]} aria-hidden={i >= badges.length ? 'true' : undefined}>
            <img src={b.src} alt={i >= badges.length ? '' : b.alt} loading="lazy" />
          </span>
        ))}
      </div>
    </div>
    <div class="trust__ratings">
      {['G2', 'Capterra'].map((n) => (
        <div class="trust__rating"><div><b>{n}</b><span class="accent">★★★★★</span></div><small class="mono">[PLACEHOLDER]/5 · [PLACEHOLDER] reviews</small></div>
      ))}
    </div>
  </div>
</section>
<style>
  .trust { border-block: 1px solid var(--line-soft); }
  .trust__inner { padding-block: 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 28px 48px; }
  .trust__copy { flex: 1 1 220px; max-width: 280px; font-size: 14px; line-height: 1.5; color: var(--muted); }
  .trust__copy .eyebrow { display: block; font-size: 10.5px; margin-bottom: 6px; }
  .trust__marquee { flex: 10 1 480px; min-width: 0; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .trust__track { display: flex; width: max-content; animation: pl-marquee 40s linear infinite; }
  .trust__marquee:hover .trust__track { animation-play-state: paused; }
  .trust__badge { flex: none; margin: 0 6px; width: 156px; height: 64px; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); display: grid; place-items: center; transition: border-color .2s, transform .2s; }
  .trust__badge:hover { border-color: var(--green-dark); transform: translateY(-2px); }
  .trust__badge--light { background: var(--paper); border-color: var(--paper); }
  .trust__badge img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .trust__ratings { flex: 1 1 300px; display: flex; gap: 12px; }
  .trust__rating { flex: 1; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .trust__rating > div { display: flex; justify-content: space-between; align-items: center; } .trust__rating b { font-family: var(--font-display); color: var(--white); }
  .trust__rating small { display: block; margin-top: 4px; font-size: 11px; color: var(--muted); }
</style>

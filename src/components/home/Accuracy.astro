---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { accuracySteps, accuracyItems, accuracyChecks } from '@/data/home';
const first = accuracyItems[0];
---
<section id="accuracy" class="acc" data-acc>
  <div class="acc__dots" aria-hidden="true"></div>
  <div class="container acc__inner">
    <SectionHeading eyebrow="The differentiator" layout="split" lede={'Everyone claims "99% accuracy." We show you how we get there — every match passes four checks before it reaches your dashboard.'}>Real-time competitor data accuracy, <span class="accent">proven — not promised.</span></SectionHeading>

    <div class="acc__card" data-reveal>
      <div class="acc__bar"><span class="dot dot--pulse"></span><span class="mono">MATCH PIPELINE · LIVE</span><span class="mono dim" data-acc-label>ITEM 1 OF 3 · {first.sku}</span></div>
      <div class="acc__pipe">
        <div class="acc__line" aria-hidden="true"><i data-acc-fill></i><b data-acc-packet></b></div>
        <ol class="acc__steps">
          {accuracySteps.map((s, i) => (
            <li class="acc__step" data-acc-step={i}>
              <span class="acc__ic"><Icon name={s.icon} size={26} /><span class="acc__badge mono">0{i + 1}</span></span>
              <h3>{s.title}</h3><p>{s.desc}</p>
              <span class="acc__metric mono"><span class="dot"></span>{s.metric}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="acc__bottom">
        <div class="acc__insp">
          <div class="acc__insp-head"><span class="mono muted">MATCH INSPECTOR</span><span class="chip acc__status" data-acc-status><i class="spin"></i><span>AI matching</span></span></div>
          <div class="acc__pair">
            <div class="acc__prod"><small class="mono">YOUR PRODUCT</small><b data-f="ours">{first.ours}</b><span class="mono" data-f="sku">{first.sku}</span></div>
            <span class="acc__link" aria-hidden="true">⇄</span>
            <div class="acc__prod acc__cand"><small class="mono" data-f="site">{first.site}</small><b data-f="cand">{first.cand}</b><span class="mono"><span data-f="price">{first.price}</span> · <span data-f="type">{first.type}</span></span></div>
          </div>
          <div class="acc__checks">{accuracyChecks.map((c) => <div class="acc__check" data-at={c.at}><span class="acc__tick">✓</span>{c.label}<small class="mono">{c.by}</small></div>)}</div>
          <div class="acc__conf"><div class="mono"><span class="muted">MATCH CONFIDENCE</span><span data-acc-conf>72%</span></div><div class="acc__confbar"><i data-acc-confbar style="width:72%"></i></div></div>
        </div>
        <div class="acc__stats">
          <div><small class="mono">MATCHES VERIFIED</small><b class="mono" data-acc-verified>12,04,860</b></div>
          <div><small class="mono">HUMAN-REVIEWED</small><b class="mono accent">100%</b></div>
          <div><small class="mono">OUTLIERS HELD TODAY</small><b class="mono" style="color:var(--amber)" data-acc-held>312</b></div>
          <div><small class="mono">ACCURACY SLA</small><b class="mono">[PLACEHOLDER]%</b></div>
        </div>
      </div>
    </div>

    <div class="acc__sla" data-reveal>
      <div><span class="acc__sla-ic"><Icon name="shield" size={20} stroke={2.2} /></span><p>Fewer than [PLACEHOLDER] matches is a false positive — backed by our SLA.</p></div>
      <a href="/book-a-demo">Book a demo →</a>
    </div>
  </div>
</section>
<script type="application/json" id="acc-data" set:html={JSON.stringify(accuracyItems)}></script>

<script>
  import { prefersReducedMotion, whenInView } from '@/scripts/reveal';
  const root = document.querySelector<HTMLElement>('[data-acc]');
  if (root) {
    const items = JSON.parse(document.getElementById('acc-data')!.textContent || '[]');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-acc-step]')];
    const checks = [...root.querySelectorAll<HTMLElement>('.acc__check')];
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const labels = ['AI matching', 'Human QC review', 'Anomaly check', 'Verified ✓', 'Verified ✓'];
    let st = 0, item = 0, verified = 1204860, held = 312, visible = false;
    const paint = () => {
      const it = items[item];
      steps.forEach((el, i) => { el.classList.toggle('is-done', i < st); el.classList.toggle('is-active', i === st); });
      checks.forEach((el) => el.classList.toggle('is-on', st >= Number(el.dataset.at)));
      const fill = (Math.min(st, 3) / 3) * 100 + '%';
      $('[data-acc-fill]').style.width = fill; $('[data-acc-packet]').style.left = fill; $('[data-acc-packet]').style.opacity = st >= 3 ? '0' : '1';
      const done = st >= 3;
      root.classList.toggle('is-verified', done);
      $('[data-acc-status] span').textContent = labels[st];
      $('[data-acc-conf]').textContent = it.conf[st] + '%'; $('[data-acc-confbar]').style.width = it.conf[st] + '%';
      $('[data-acc-label]').textContent = `ITEM ${item + 1} OF 3 · ${it.sku}`;
      root.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => (el.textContent = it[el.dataset.f!]));
      $('[data-acc-verified]').textContent = verified.toLocaleString('en-IN'); $('[data-acc-held]').textContent = String(held);
    };
    if (prefersReducedMotion()) { st = 4; paint(); }
    else {
      paint();
      whenInView(root, (v) => (visible = v));
      setInterval(() => {
        if (!visible) return;
        if (st >= 4) { st = 0; item = (item + 1) % items.length; verified++; if (Math.random() < 0.4) held++; } else st++;
        paint();
      }, 1300);
    }
  }
</script>

<style>
  .acc { position: relative; margin-top: var(--section-y); border-block: 1px solid var(--line-soft); background: var(--surface-4); overflow: hidden; scroll-margin-top: 68px; }
  .acc__dots { position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,.07) 1px, transparent 1px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, #000 10%, transparent 75%); mask-image: radial-gradient(ellipse 60% 50% at 50% 40%, #000 10%, transparent 75%); pointer-events: none; }
  .acc__inner { position: relative; padding-block: clamp(80px, 10vw, 130px); }
  .dim { color: var(--dim); }
  .acc__card { margin-top: 56px; border: 1px solid var(--line); border-radius: 24px; background: var(--surface-3); box-shadow: 0 40px 100px -50px rgba(24,229,99,.25); overflow: hidden; }
  .acc__bar { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--line-soft); background: var(--surface-4); flex-wrap: wrap; font-size: 11px; letter-spacing: .1em; } .acc__bar .dim { margin-left: auto; letter-spacing: 0; }
  .acc__pipe { position: relative; padding: clamp(28px, 4vw, 44px) clamp(16px, 3vw, 32px) clamp(20px, 3vw, 32px); }
  .acc__line { display: none; position: absolute; left: calc(12.5% + 8px); right: calc(12.5% + 8px); top: calc(clamp(28px, 4vw, 44px) + 31px); height: 2px; background: var(--line-soft); }
  @media (min-width: 860px) { .acc__line { display: block; } }
  .acc__line i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--green-dark), var(--green)); box-shadow: 0 0 14px rgba(24,229,99,.7); transition: width 1.1s cubic-bezier(.4,0,.2,1); }
  .acc__line b { position: absolute; top: -5px; left: 0; width: 12px; height: 12px; margin-left: -6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px rgba(24,229,99,.18), 0 0 18px var(--green); transition: left 1.1s cubic-bezier(.4,0,.2,1), opacity .3s; }
  .acc__steps { position: relative; margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 28px 20px; }
  .acc__step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; }
  .acc__ic { position: relative; width: 64px; height: 64px; margin-bottom: 4px; border-radius: 18px; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--line); color: var(--dim); transition: all .45s; }
  .acc__badge { position: absolute; top: -8px; right: -8px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--surface-3); border: 1px solid var(--line); font-size: 10px; font-weight: 600; color: var(--dim); display: grid; place-items: center; transition: all .45s; }
  .acc__step h3 { font-size: 19px; font-weight: 600; color: var(--muted); transition: color .45s; }
  .acc__step p { font-size: 14.5px; line-height: 1.55; color: var(--muted); max-width: 250px; text-wrap: pretty; }
  .acc__metric { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--line-soft); background: var(--surface); font-size: 11px; } .acc__metric .dot { width: 5px; height: 5px; background: var(--dim); }
  .acc__step.is-active .acc__ic { background: rgba(24,229,99,.12); border-color: var(--green-dark); color: var(--green); box-shadow: 0 0 0 6px rgba(24,229,99,.08), 0 0 30px rgba(24,229,99,.35); }
  .acc__step.is-done .acc__ic { background: var(--green-deep); border-color: var(--green-dark); color: var(--green); }
  .acc__step.is-done .acc__badge { background: var(--green); border-color: var(--green); color: var(--bg); font-size: 0; } .acc__step.is-done .acc__badge::after { content: '✓'; font-size: 10px; }
  .acc__step.is-active .acc__badge { color: var(--green); border-color: var(--green-dark); }
  .acc__step.is-active h3, .acc__step.is-done h3 { color: var(--white); } .acc__step.is-active .acc__metric .dot { background: var(--green); }
  .acc__bottom { display: flex; flex-wrap: wrap; border-top: 1px solid var(--line-soft); }
  .acc__insp { flex: 1.5 1 460px; min-width: 0; padding: clamp(18px, 2.6vw, 28px); border-right: 1px solid var(--line-soft); }
  .acc__insp-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 10.5px; letter-spacing: .12em; }
  .acc__status { background: var(--line-soft); color: var(--text); letter-spacing: 0; }
  .spin { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid currentColor; border-top-color: transparent; animation: pl-spin .8s linear infinite; }
  .is-verified .acc__status { background: var(--green-deep); color: var(--green); } .is-verified .acc__status .spin { display: none; }
  .acc__pair { margin-top: 16px; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: center; }
  .acc__prod { padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); display: flex; flex-direction: column; gap: 4px; min-width: 0; transition: border-color .4s; }
  .acc__prod small { font-size: 9.5px; letter-spacing: .1em; color: var(--dim); } .acc__prod b { font-size: 14px; font-weight: 500; color: var(--white); line-height: 1.35; } .acc__prod .mono:last-child { font-size: 11px; color: var(--muted); }
  .acc__link { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface-3); color: var(--muted); display: grid; place-items: center; transition: all .4s; }
  .is-verified .acc__cand { border-color: var(--green-dark); } .is-verified .acc__link { border-color: var(--green-dark); color: var(--green); }
  .acc__checks { margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 8px; }
  .acc__check { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--line-soft); border-radius: 10px; background: var(--surface-2); font-size: 13px; color: var(--muted); transition: color .35s; } .acc__check small { margin-left: auto; font-size: 10px; color: var(--dim); }
  .acc__tick { width: 18px; height: 18px; flex: none; border-radius: 50%; border: 1.5px solid #3A3A3A; font-size: 10px; font-weight: 700; color: transparent; display: grid; place-items: center; transition: all .35s; }
  .acc__check.is-on { color: var(--white); } .acc__check.is-on .acc__tick { background: var(--green); border-color: var(--green); color: var(--bg); }
  .acc__conf { margin-top: 16px; } .acc__conf > .mono { display: flex; justify-content: space-between; font-size: 11px; color: var(--white); }
  .acc__confbar { margin-top: 8px; height: 6px; border-radius: 3px; background: var(--line-soft); overflow: hidden; } .acc__confbar i { display: block; height: 100%; background: linear-gradient(90deg, var(--green-dark), var(--green)); transition: width .9s var(--ease); }
  .acc__stats { flex: 1 1 300px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .acc__stats > div { padding: clamp(18px, 2.6vw, 28px); } .acc__stats > div:nth-child(-n+2) { border-bottom: 1px solid var(--line-soft); } .acc__stats > div:nth-child(odd) { border-right: 1px solid var(--line-soft); }
  .acc__stats small { font-size: 10px; letter-spacing: .1em; color: var(--muted); } .acc__stats b { display: block; margin-top: 8px; font-size: clamp(20px, 2vw, 26px); font-weight: 400; color: var(--white); font-variant-numeric: tabular-nums; }
  .acc__sla { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 26px; border: 1px solid var(--green-dark); border-radius: 16px; background: rgba(24,229,99,.05); }
  .acc__sla > div { display: flex; align-items: center; gap: 16px; } .acc__sla p { font-family: var(--font-display); font-size: 18px; font-weight: 500; color: var(--white); }
  .acc__sla-ic { width: 40px; height: 40px; flex: none; border-radius: 10px; background: var(--green); color: var(--bg); display: grid; place-items: center; }
  .acc__sla a { font-weight: 500; font-size: 15px; white-space: nowrap; }
</style>
